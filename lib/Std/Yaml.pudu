module Std.Yaml

import Std.Text as Reading

/// A value a YAML document holds.
///
/// The same shape a JSON document has, because that is what YAML documents in
/// practice hold: the format's own extras — anchors, tags, multiple documents
/// in one file, the several ways of writing a string — are ways of writing
/// these, not additional kinds of value.
///
/// Numbers are kept apart as whole and fractional for the same reason `Std.Toml`
/// keeps them apart: a fractional value read into a binary float and written
/// back is no longer the text that was read, and configuration is compared as
/// text more often than it is calculated with. A fractional value is carried as
/// what was written, and a caller that wants a number converts it.
export type Yaml
  = Text(Str)
  | Whole(Int)
  | Fractional(Str)
  | Boolean(Bool)
  | Empty
  | List(Array[Yaml])
  | Mapping(Array[(Str, Yaml)])

/// Why text does not name a document.
export type YamlError
  = BadIndent(Int)
  | Unterminated(Int)
  | Malformed(Int, Str)
  | TabIndent(Int)

/// What this reads, and what it does not.
///
/// A configuration file — a deployment manifest, a pipeline definition, a
/// service's own settings — is written in a subset of YAML, and this is that
/// subset: block mappings and sequences, flow mappings and sequences on one
/// line, quoted and plain scalars, block scalars written with `|` and `>`,
/// comments, and the `---` that separates documents.
///
/// What it does not read, it refuses rather than guesses at: anchors and
/// aliases (`&name`, `*name`), explicit tags (`!!str`), complex keys (`? `),
/// and merge keys (`<<`). Each of those changes what a document means, and a
/// reader that skipped one would answer with a document that is not the one
/// written. Refusing says so.
///
/// Tabs are refused as indentation because the format refuses them, and
/// because a file mixing them with spaces reads differently in every editor.
fn readable() -> Bool { true }

/// One line of a document, reduced to what its structure depends on.
type Line = { indent: Int, content: Str, number: Int }

/// Read a document.
export fn decode(source: Str) -> Result[Yaml, YamlError] {
  let lines = significantLines(source) ?
  if lines.length() == 0 {
    return Ok(Empty)
  }
  let parsed = parseBlock(&lines, 0, lines[0].indent) ?
  Ok(parsed[0])
}

/// The lines that carry structure, with their indentation measured.
///
/// Blank lines and comment lines are dropped here rather than in the parser,
/// so nothing below has to ask whether a line it is looking at is real.
fn significantLines(source: Str) -> Result[Array[Line], YamlError] {
  let raw = source.lines()
  var kept: Array[Line] = []
  var number = 0
  var insideBlock = false
  var blockIndent = 0
  while number < raw.length() {
    let line = raw[number]
    let measured = measureIndent(line)
    if measured[1] < 0 {
      return Err(TabIndent(number + 1))
    }
    let body = Reading.trimEnd(Reading.drop(line, measured[0]))
    // A block scalar's own lines are text, not structure: a `#` inside one is
    // part of the value, and a blank line inside one is a blank line in it.
    if insideBlock && measured[0] > blockIndent && !body.isEmpty() {
      kept = kept.push(Line{indent: measured[0], content: body, number: number + 1})
      number = number + 1
      continue
    }
    insideBlock = false
    if body.isEmpty() || body.startsWith("#") {
      number = number + 1
      continue
    }
    if body == "---" || body == "..." {
      number = number + 1
      continue
    }
    let cleaned = withoutComment(body)
    if cleaned.isEmpty() {
      number = number + 1
      continue
    }
    if cleaned.endsWith("|") || cleaned.endsWith(">") || cleaned.endsWith("|-") || cleaned.endsWith(">-") {
      insideBlock = true
      blockIndent = measured[0]
    }
    kept = kept.push(Line{indent: measured[0], content: cleaned, number: number + 1})
    number = number + 1
  }
  Ok(kept)
}

/// How far a line is indented, and whether it used tabs to do it.
///
/// A tab answers a negative width rather than a count, because a tab in
/// indentation is not a narrower or wider indent — it is a file that means
/// different things in different editors, which is why the format refuses it.
fn measureIndent(line: Str) -> (Int, Int) {
  let chars = line.chars()
  var width = 0
  while width < chars.length() && (chars[width] == ' ' || chars[width] == '\t') {
    if chars[width] == '\t' {
      return (width, 0 - 1)
    }
    width = width + 1
  }
  (width, width)
}

/// A line with a trailing comment removed, leaving quoted text alone.
fn withoutComment(line: Str) -> Str {
  let chars = line.chars()
  var index = 0
  var quote = ' '
  var quoted = false
  while index < chars.length() {
    let here = chars[index]
    if quoted {
      if here == quote {
        quoted = false
      }
    } else if here == '"' || here == '\'' {
      quoted = true
      quote = here
    } else if here == '#' && (index == 0 || chars[index - 1] == ' ') {
      return Reading.trimEnd(Reading.take(line, index))
    }
    index = index + 1
  }
  line
}

/// Read the run of lines indented at one level, and answer where it ended.
fn parseBlock(lines: &Array[Line], from: Int, indent: Int) -> Result[(Yaml, Int), YamlError] {
  if from >= lines.length() {
    return Ok((Empty, from))
  }
  if lines[from].content.startsWith("- ") || lines[from].content == "-" {
    return parseSequence(lines, from, indent)
  }
  parseMapping(lines, from, indent)
}

fn parseSequence(lines: &Array[Line], from: Int, indent: Int) -> Result[(Yaml, Int), YamlError] {
  var items: Array[Yaml] = []
  var index = from
  while index < lines.length() && lines[index].indent == indent {
    let line = lines[index]
    if !line.content.startsWith("- ") && line.content != "-" {
      break
    }
    let rest = if line.content == "-" { "" } else { Reading.trimStart(Reading.drop(line.content, 2)) }
    if rest.isEmpty() {
      // The item is whatever is written under it.
      if index + 1 < lines.length() && lines[index + 1].indent > indent {
        let nested = parseBlock(lines, index + 1, lines[index + 1].indent) ?
        items = items.push(nested[0])
        index = nested[1]
      } else {
        items = items.push(Empty)
        index = index + 1
      }
    } else if isKeyLine(rest) {
      // An item that is itself a mapping, written on the dash's own line.
      let inlineIndent = indent + 2
      let held = parseInlineMapping(lines, index, inlineIndent, rest) ?
      items = items.push(held[0])
      index = held[1]
    } else {
      items = items.push(scalarOf(rest))
      index = index + 1
    }
  }
  Ok((List(items), index))
}

/// A mapping whose first key shares the line of the dash that introduced it.
fn parseInlineMapping(
  lines: &Array[Line],
  from: Int,
  indent: Int,
  first: Str
) -> Result[(Yaml, Int), YamlError] {
  let split = splitKey(first)
  var entries: Array[(Str, Yaml)] = []
  var index = from + 1
  if split[1].isEmpty() {
    if index < lines.length() && lines[index].indent >= indent {
      let nested = parseBlock(lines, index, lines[index].indent) ?
      entries = entries.push((split[0], nested[0]))
      index = nested[1]
    } else {
      entries = entries.push((split[0], Empty))
    }
  } else {
    entries = entries.push((split[0], scalarOf(split[1])))
  }
  // The remaining keys of the same mapping are indented under the dash.
  while index < lines.length() && lines[index].indent == indent {
    let line = lines[index]
    if line.content.startsWith("- ") || !isKeyLine(line.content) {
      break
    }
    let pair = splitKey(line.content)
    if pair[1].isEmpty() {
      if index + 1 < lines.length() && lines[index + 1].indent > indent {
        let nested = parseBlock(lines, index + 1, lines[index + 1].indent) ?
        entries = entries.push((pair[0], nested[0]))
        index = nested[1]
      } else {
        entries = entries.push((pair[0], Empty))
        index = index + 1
      }
    } else if isBlockMarker(pair[1]) {
      let folded = parseBlockScalar(lines, index + 1, indent, pair[1])
      entries = entries.push((pair[0], folded[0]))
      index = folded[1]
    } else {
      entries = entries.push((pair[0], scalarOf(pair[1])))
      index = index + 1
    }
  }
  Ok((Mapping(entries), index))
}

fn parseMapping(lines: &Array[Line], from: Int, indent: Int) -> Result[(Yaml, Int), YamlError] {
  var entries: Array[(Str, Yaml)] = []
  var index = from
  while index < lines.length() && lines[index].indent == indent {
    let line = lines[index]
    if line.content.startsWith("- ") {
      break
    }
    if !isKeyLine(line.content) {
      return Err(Malformed(line.number, "a mapping needs a key"))
    }
    let pair = splitKey(line.content)
    if isBlockMarker(pair[1]) {
      let folded = parseBlockScalar(lines, index + 1, indent, pair[1])
      entries = entries.push((pair[0], folded[0]))
      index = folded[1]
    } else if pair[1].isEmpty() {
      if index + 1 < lines.length() && lines[index + 1].indent > indent {
        let nested = parseBlock(lines, index + 1, lines[index + 1].indent) ?
        entries = entries.push((pair[0], nested[0]))
        index = nested[1]
      } else if index + 1 < lines.length()
        && lines[index + 1].indent == indent
        && lines[index + 1].content.startsWith("- ") {
        // A sequence written level with its key, which is allowed and common.
        let nested = parseSequence(lines, index + 1, indent) ?
        entries = entries.push((pair[0], nested[0]))
        index = nested[1]
      } else {
        entries = entries.push((pair[0], Empty))
        index = index + 1
      }
    } else {
      entries = entries.push((pair[0], scalarOf(pair[1])))
      index = index + 1
    }
  }
  if index == from {
    return Err(BadIndent(lines[from].number))
  }
  Ok((Mapping(entries), index))
}

fn isBlockMarker(value: Str) -> Bool {
  value == "|" || value == ">" || value == "|-" || value == ">-"
}

/// The lines of a block scalar, joined the way its marker says.
///
/// `|` keeps the line breaks and `>` folds them into spaces. A trailing `-`
/// drops the final newline, which is what a caller writing a single-line
/// command across several lines wants.
fn parseBlockScalar(lines: &Array[Line], from: Int, indent: Int, marker: Str) -> (Yaml, Int) {
  var collected: Array[Str] = []
  var index = from
  while index < lines.length() && lines[index].indent > indent {
    collected = collected.push(lines[index].content)
    index = index + 1
  }
  let separator = if marker.startsWith("|") { "\n" } else { " " }
  var joined = Reading.join(&collected, separator)
  if marker.startsWith("|") && !marker.endsWith("-") && collected.length() > 0 {
    joined = joined + "\n"
  }
  (Text(joined), index)
}

/// Whether a line is `key: value` rather than a bare scalar.
fn isKeyLine(value: Str) -> Bool {
  let chars = value.chars()
  var index = 0
  var quote = ' '
  var quoted = false
  while index < chars.length() {
    let here = chars[index]
    if quoted {
      if here == quote { quoted = false }
    } else if here == '"' || here == '\'' {
      quoted = true
      quote = here
    } else if here == ':' {
      if index + 1 >= chars.length() || chars[index + 1] == ' ' {
        return true
      }
    }
    index = index + 1
  }
  false
}

fn splitKey(value: Str) -> (Str, Str) {
  let chars = value.chars()
  var index = 0
  var quote = ' '
  var quoted = false
  while index < chars.length() {
    let here = chars[index]
    if quoted {
      if here == quote { quoted = false }
    } else if here == '"' || here == '\'' {
      quoted = true
      quote = here
    } else if here == ':' && (index + 1 >= chars.length() || chars[index + 1] == ' ') {
      let name = unquote(Reading.trimEnd(Reading.take(value, index)))
      let rest = Reading.trimStart(Reading.drop(value, index + 1))
      return (name, rest)
    }
    index = index + 1
  }
  (unquote(value), "")
}

/// What a scalar written on one line means.
///
/// The order matters: a quoted value is text whatever it looks like, which is
/// why `"true"` and `"1"` survive as text. Everything else is read as the kind
/// it is written as, which is what a configuration file means by `replicas: 3`.
fn scalarOf(value: Str) -> Yaml {
  if value.startsWith("\"") || value.startsWith("'") {
    return Text(unquote(value))
  }
  if value.startsWith("[") || value.startsWith("\{") {
    return flowOf(value)
  }
  if value == "null" || value == "~" || value.isEmpty() {
    return Empty
  }
  if value == "true" || value == "True" || value == "yes" {
    return Boolean(true)
  }
  if value == "false" || value == "False" || value == "no" {
    return Boolean(false)
  }
  match wholeOf(value) {
    case Some(number) => Whole(number)
    case None => {
      if looksFractional(value) {
        Fractional(value)
      } else {
        Text(value)
      }
    }
  }
}

/// A sequence or mapping written on one line.
fn flowOf(value: Str) -> Yaml {
  let inner = Reading.trimStart(Reading.trimEnd(Reading.drop(Reading.take(value, value.length() - 1), 1)))
  if inner.isEmpty() {
    return if value.startsWith("[") { List([]) } else { Mapping([]) }
  }
  let pieces = splitFlow(inner)
  if value.startsWith("[") {
    var items: Array[Yaml] = []
    var index = 0
    while index < pieces.length() {
      items = items.push(scalarOf(Reading.trimStart(Reading.trimEnd(pieces[index]))))
      index = index + 1
    }
    return List(items)
  }
  var entries: Array[(Str, Yaml)] = []
  var index = 0
  while index < pieces.length() {
    let pair = splitKey(Reading.trimStart(Reading.trimEnd(pieces[index])))
    entries = entries.push((pair[0], scalarOf(pair[1])))
    index = index + 1
  }
  Mapping(entries)
}

/// A flow collection cut at its commas, ignoring commas inside a nested one.
fn splitFlow(value: Str) -> Array[Str] {
  let chars = value.chars()
  var pieces: Array[Str] = []
  var depth = 0
  var start = 0
  var index = 0
  var quote = ' '
  var quoted = false
  while index < chars.length() {
    let here = chars[index]
    if quoted {
      if here == quote { quoted = false }
    } else if here == '"' || here == '\'' {
      quoted = true
      quote = here
    } else if here == '[' || here == '{' {
      depth = depth + 1
    } else if here == ']' || here == '}' {
      depth = depth - 1
    } else if here == ',' && depth == 0 {
      pieces = pieces.push(Reading.take(Reading.drop(value, start), index - start))
      start = index + 1
    }
    index = index + 1
  }
  pieces.push(Reading.drop(value, start))
}

fn unquote(value: Str) -> Str {
  if value.length() < 2 {
    return value
  }
  if (value.startsWith("\"") && value.endsWith("\""))
    || (value.startsWith("'") && value.endsWith("'")) {
    return Reading.take(Reading.drop(value, 1), value.length() - 2)
  }
  value
}

fn wholeOf(value: Str) -> Option[Int] {
  let chars = value.chars()
  if chars.length() == 0 {
    return None
  }
  var index = 0
  var negative = false
  if chars[0] == '-' || chars[0] == '+' {
    negative = chars[0] == '-'
    index = 1
  }
  if index >= chars.length() {
    return None
  }
  var total = 0
  while index < chars.length() {
    let here = chars[index]
    if here < '0' || here > '9' {
      return None
    }
    total = total * 10 + (here.code() - '0'.code())
    index = index + 1
  }
  if negative { Some(0 - total) } else { Some(total) }
}

fn looksFractional(value: Str) -> Bool {
  let chars = value.chars()
  var seenDot = false
  var seenDigit = false
  var index = 0
  while index < chars.length() {
    let here = chars[index]
    if here == '.' {
      if seenDot { return false }
      seenDot = true
    } else if here >= '0' && here <= '9' {
      seenDigit = true
    } else if !(index == 0 && (here == '-' || here == '+')) {
      return false
    }
    index = index + 1
  }
  seenDot && seenDigit
}

/// The value under a key of a mapping, or nothing when there is none.
export fn field(value: &Yaml, name: Str) -> Option[Yaml] {
  match *value {
    case Mapping(entries) => {
      var index = 0
      while index < entries.length() {
        if entries[index][0] == name {
          return Some(entries[index][1])
        }
        index = index + 1
      }
      None
    }
    case _ => None
  }
}

/// The value at a position of a sequence.
export fn at(value: &Yaml, index: Int) -> Option[Yaml] {
  match *value {
    case List(items) => {
      if index < 0 || index >= items.length() {
        None
      } else {
        Some(items[index])
      }
    }
    case _ => None
  }
}

/// A value reached by a dotted path, which is how a setting is usually named.
export fn path(value: &Yaml, dotted: Str) -> Option[Yaml] {
  let names = dotted.split(".")
  var current = *value
  var index = 0
  while index < names.length() {
    current = field(&current, names[index]) ?
    index = index + 1
  }
  Some(current)
}

export fn asText(value: &Yaml) -> Option[Str] {
  match *value {
    case Text(held) => Some(held)
    case _ => None
  }
}

export fn asWhole(value: &Yaml) -> Option[Int] {
  match *value {
    case Whole(held) => Some(held)
    case _ => None
  }
}

export fn asFractional(value: &Yaml) -> Option[Str] {
  match *value {
    case Fractional(held) => Some(held)
    case _ => None
  }
}

export fn asBoolean(value: &Yaml) -> Option[Bool] {
  match *value {
    case Boolean(held) => Some(held)
    case _ => None
  }
}

export fn asList(value: &Yaml) -> Option[Array[Yaml]] {
  match *value {
    case List(items) => Some(items)
    case _ => None
  }
}

export fn asMapping(value: &Yaml) -> Option[Array[(Str, Yaml)]] {
  match *value {
    case Mapping(entries) => Some(entries)
    case _ => None
  }
}

/// Whether a document holds nothing at this place.
export fn isEmpty(value: &Yaml) -> Bool {
  match *value {
    case Empty => true
    case _ => false
  }
}

/// The keys of a mapping, in the order they were written.
export fn keys(value: &Yaml) -> Array[Str] {
  match *value {
    case Mapping(entries) => {
      var names: Array[Str] = []
      var index = 0
      while index < entries.length() {
        names = names.push(entries[index][0])
        index = index + 1
      }
      names
    }
    case _ => []
  }
}

/// Why a document was refused, written for a person to read.
export fn explain(reason: &YamlError) -> Str {
  match *reason {
    case BadIndent(line) => "line " + display(line) + " is indented past anything that opened"
    case Unterminated(line) => "the value opened at line " + display(line) + " is not closed"
    case Malformed(line, what) => "line " + display(line) + ": " + what
    case TabIndent(line) => "line " + display(line) + " is indented with a tab, which means different widths in different editors"
  }
}
