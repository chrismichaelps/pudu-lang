module Std.Db.Postgres

import Std.Db.ConnectionString as ConnectionString
import Std.Db as Db
import Std.Db.Driver as Driver
import Std.Db.Driver {NullValue, TextValue, IntegerValue, DecimalValue, RealValue, BooleanValue, BytesValue}
import Std.Db.Session as Session
import Std.Result as Result
import Std.Sync as Sync

export fn driver() -> Driver.Driver {
  Driver.Driver{name: "postgresql", schemes: ["postgres", "postgresql"],
    placeholders: Driver.DollarNumber, open: connect }
}

export fn connect(uri: Str, size: Int) -> Result[Driver.Client, Driver.Error] {
  let pool = Result.mapErr(ConnectionString.pool(uri, size), adaptError) ?
  Ok(Driver.Client {
      query: fn(sql: Str, values: Array[Driver.Value]) -> Result[Driver.Rows, Driver.Error] {
        let parameters = textParameters(&values) ?
        let rows = Result.mapErr(Db.withConnection(&pool,
            fn(stream: Session.Connection) -> (Result[Db.Rows, Session.DbError], Session.Connection) {
              match Db.run(stream, sql, &parameters) {
                case Ok(pair) => (Ok(pair[0]), pair[1])
                case Err(problem) => (Err(problem), stream)
              }
            }), adaptError) ?
        Ok(adaptRows(&rows))
      },
      execute: fn(sql: Str) -> Result[Driver.Rows, Driver.Error] {
        let rows = Result.mapErr(Db.withConnection(&pool,
            fn(stream: Session.Connection) -> (Result[Db.Rows, Session.DbError], Session.Connection) {
              match Db.simple(stream, sql) {
                case Ok(pair) => (Ok(pair[0]), pair[1])
                case Err(problem) => (Err(problem), stream)
              }
            }), adaptError) ?
        Ok(adaptRows(&rows))
      },
      transaction: fn(action: fn(Driver.Tx) -> Result[Driver.Rows, Driver.Error]) -> Result[Driver.Rows, Driver.Error] {
        // The outer result is the session's: whether a connection could be
        // taken and the transaction opened and closed. The inner one is the
        // action's own answer, kept whole so a driver failure keeps its
        // category and code rather than being flattened into a protocol error.
        let settled = Result.mapErr(Db.withConnection(&pool,
            fn(stream: Session.Connection) -> (Result[Result[Driver.Rows, Driver.Error], Session.DbError], Session.Connection) {
              match Db.begin(stream) {
                case Err(reason) => (Err(reason), stream)
                case Ok(started) => {
                  // Every call answers with the connection it used, and a
                  // closure cannot hand it to the next one, so the transaction
                  // keeps it where all of them can reach it.
                  let held = Sync.cell(started)
                  let inside = Driver.Tx {
                    query: fn(sql: Str, values: Array[Driver.Value]) -> Result[Driver.Rows, Driver.Error] {
                      let parameters = textParameters(&values) ?
                      let open = Result.mapErr(Sync.get(&held), synchronization) ?
                      match Db.run(open, sql, &parameters) {
                        case Ok(pair) => {
                          let _kept = Sync.set(&held, pair[1])
                          Ok(adaptRows(&pair[0]))
                        }
                        case Err(reason) => Err(adaptError(reason))
                      }
                    },
                    execute: fn(sql: Str) -> Result[Driver.Rows, Driver.Error] {
                      let open = Result.mapErr(Sync.get(&held), synchronization) ?
                      match Db.simple(open, sql) {
                        case Ok(pair) => {
                          let _kept = Sync.set(&held, pair[1])
                          Ok(adaptRows(&pair[0]))
                        }
                        case Err(reason) => Err(adaptError(reason))
                      }
                    }
                  }
                  let answered = action(inside)
                  match Sync.get(&held) {
                    case Err(problem) => (Err(Session.Other(show(problem))), started)
                    case Ok(current) => {
                      if Result.isErr(&answered) {
                        let undone = Db.rollback(current)
                        (Ok(answered), Result.unwrapOr(undone, current))
                      } else {
                        match Db.commit(current) {
                          case Ok(kept) => (Ok(answered), kept)
                          case Err(reason) => {
                            let undone = Db.rollback(current)
                            (Err(reason), Result.unwrapOr(undone, current))
                          }
                        }
                      }
                    }
                  }
                }
              }
            }), adaptError) ?
        settled
      },
      close: fn() -> Result[(), Driver.Error] { Result.mapErr(Db.closePool(&pool), adaptError) }
    })
}

fn textParameters(values: &Array[Driver.Value]) -> Result[Array[Option[Str]], Driver.Error] {
  var found: Array[Option[Str]] = []
  for value in values {
    let text = match value {
      case NullValue => None
      case TextValue(held) => {
        if held.contains("\0") { return Err(Driver.error("postgresql", "parameter", "text parameters cannot contain NUL")) }
        Some(held)
      }
      case IntegerValue(held) => Some(show(held))
      case DecimalValue(held) => Some(show(held))
      case RealValue(held) => Some(show(held))
      case BooleanValue(held) => Some(if held { "true" } else { "false" })
      case BytesValue(_) => { return Err(Driver.error("postgresql", "unsupported", "binary parameters are not implemented by this driver")) }
    }
    found = found.push(text)
  }
  Ok(found)
}

fn adaptRows(rows: &Db.Rows) -> Driver.Rows {
  var columns: Array[Driver.Column] = []
  for column in rows.columns {
    columns = columns.push(Driver.Column{name: column.name, nativeType: Some(show(column.oid))})
  }
  var values: Array[Array[Driver.Value]] = []
  for row in rows.rows {
    var converted: Array[Driver.Value] = []
    for value in row {
      converted = converted.push(match value {
          case None => NullValue
          case Some(text) => TextValue(text)
        })
    }
    values = values.push(converted)
  }
  Driver.Rows{columns: columns, rows: values, command: rows.tag}
}

fn synchronization(problem: Sync.SyncError) -> Driver.Error {
  Driver.error("postgresql", "operation", show(problem))
}

fn adaptError(problem: Session.DbError) -> Driver.Error {
  match problem {
    case Session.Server(_, code, message) => Driver.Error{driver: "postgresql", category: "server", code: Some(code), message: message}
    case Session.Connect(message) => Driver.error("postgresql", "connection", message)
    case Session.Auth(message) => Driver.error("postgresql", "authentication", message)
    case Session.Malformed(message) => Driver.error("postgresql", "protocol", message)
    case Session.Unsupported(message) => Driver.error("postgresql", "unsupported", message)
    case Session.Closed => Driver.error("postgresql", "closed", "database connection is closed")
    case Session.Expired => Driver.error("postgresql", "expired", "the scope that lent this connection has ended")
    case Session.Other(message) => Driver.error("postgresql", "operation", message)
  }
}
