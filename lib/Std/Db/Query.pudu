module Std.Db.Query

import Std.Db.Schema as Schema
import Std.Option as Option
import Std.Set as Set
import Std.Text as Text

/// A statement, and the values that travel beside it.
///
/// The text is built only from parts the program wrote. Everything that came
/// from outside is in `values`, and there is no call that moves one into the
/// other — which is what makes an injection unrepresentable here rather than
/// prevented by a rule someone remembers at every call site.
/// One piece of a statement: text the program wrote, or the place a value goes.
///
/// A placeholder is a part rather than text reading `$3`, and that is what
/// makes joining two statements cost nothing. Written into the text, a
/// placeholder has to be found again and renumbered whenever a statement is
/// put after another — which means scanning every character of it, on every
/// join. Kept as a part, the numbers are never written until the text is
/// asked for, and then they are written once, in order.
export type Part
  = Literal(Str)
  | Placeholder

/// The parts are held rather than one text, because a statement is built a
/// clause at a time and appending to text copies everything built so far — so
/// a statement assembled from many pieces cost the square of its length. They
/// are joined once, when the text is asked for.
export type Statement = { parts: Array[Part], values: Array[Option[Str]] }

/// Why a statement would not be built.
export type QueryError
  = BadName(Str)
  | BadOperator(Str)
  | Empty

/// The comparisons a condition may use.
///
/// A set rather than arbitrary text: an operator taken from outside is as
/// dangerous as a name taken from outside, and there are few enough that
/// naming them costs nothing.
const OPERATORS: Set[Str] = setOf(["=", "<>", "!=", "<", "<=", ">", ">=", "like", "ilike", "is distinct from"])

/// The characters a name may be made of.
const NAME_CHARACTERS: Str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

/// The characters a name may not begin with.
const DIGITS: Str = "0123456789"

/// A statement with nothing in it.
export fn empty() -> Statement { Statement{parts: [], values: []} }

/// A statement written out in full, with its values beside it.
///
/// The way out. A builder that cannot express something forces a way around
/// it, and the way around should keep values apart rather than abandoning the
/// property the builder exists for — so this takes the text and the values
/// separately, exactly as everything else here does. Anything the language can
/// say goes through here: window functions, recursive traversal, a call to a
/// function the database defines, a statement somebody tuned by hand.
///
/// The placeholders written in the text are read and held as parts, so a
/// statement written this way can still be put after another one and have its
/// numbering come out right. Written as text and left alone, `$1` in the
/// second of two statements would still say `$1` after the first had already
/// used it.
export fn raw(source: Str, values: &Array[Option[Str]]) -> Statement {
  Statement{parts: partsOf(source), values: *values}
}

/// The parts of written text: what is between the placeholders, and the
/// placeholders.
fn partsOf(source: Str) -> Array[Part] {
  var parts: Array[Part] = []
  var literal = ""
  var index = 0
  while index < source.length() {
    let character = source.slice(index, index + 1)
    if character != "$" {
      literal = literal + character
      index = index + 1
    } else {
      var ahead = index + 1
      var digits = ""
      while ahead < source.length() && DIGITS.contains(source.slice(ahead, ahead + 1)) {
        digits = digits + source.slice(ahead, ahead + 1)
        ahead = ahead + 1
      }
      if digits.isEmpty() {
        literal = literal + character
        index = index + 1
      } else {
        if !literal.isEmpty() {
          parts = parts.push(Literal(literal))
          literal = ""
        }
        parts = parts.push(Placeholder)
        index = ahead
      }
    }
  }
  if literal.isEmpty() { parts } else { parts.push(Literal(literal)) }
}

/// A statement from text the program wrote, carrying no values.
///
/// For the parts a builder does not cover. Values still travel separately —
/// there is no door here that takes them any other way.
export fn text(source: Str) -> Statement {
  Statement{parts: if source.isEmpty() { [] } else { [Literal(source)] }, values: []}
}

/// The text a statement holds, which a program may read before running it.
export fn textOf(held: &Statement) -> Str {
  var pieces: Array[Str] = []
  var placeholder = 0
  var previous = ""
  for part in held.parts {
    let piece = match part {
      case Literal(source) => source
      case Placeholder => {
        placeholder = placeholder + 1
        "$" + show(placeholder)
      }
    }
    if !piece.isEmpty() {
      if pieces.length() > 0 && spaced(previous, piece) { pieces = pieces.push(" ") }
      pieces = pieces.push(piece)
      previous = piece
    }
  }
  pieces.join("")
}

/// Whether two pieces need a space between them.
///
/// Punctuation binds to what it is beside: an opening bracket to what follows
/// it, a comma and a closing bracket to what precedes. Without this the text
/// still runs, because the database does not care — but it is read by people
/// during an incident, and `in ( $1 , $2 )` is read more slowly than
/// `in ($1, $2)`.
fn spaced(before: Str, after: Str) -> Bool {
  !before.endsWith("(") && !before.endsWith(" ") && !after.startsWith(")")
    && !after.startsWith(",") && !after.startsWith(" ")
}

/// The values that travel beside it.
export fn valuesOf(held: &Statement) -> Array[Option[Str]] { held.values }

/// How many values a statement carries.
export fn valueCount(held: &Statement) -> Int { held.values.length() }

/// Two statements one after the other, with the second's placeholders
/// renumbered to follow the first's.
/// Two statements one after the other.
///
/// Nothing is renumbered and nothing is scanned: the placeholders are parts,
/// so putting one statement after another is putting its parts after the
/// other's, and the numbers are written when the text is.
export fn then(left: &Statement, right: &Statement) -> Statement {
  Statement {
    parts: left.parts.concat(right.parts),
    values: left.values.concat(right.values)
  }
}

/// A statement with one more piece of text and one more value.
///
/// The only way a value enters a statement. The placeholder is written here
/// rather than by the caller, so a caller cannot write one that does not
/// correspond to a value they supplied.
export fn withValue(base: &Statement, fragment: Str, value: Option[Str]) -> Statement {
  Statement {
    parts: base.parts.push(Literal(fragment)).push(Placeholder),
    values: base.values.push(value)
  }
}

/// A name, admitted only when it is one.
///
/// A table or a column cannot be a parameter, which is why a name taken from
/// a request is an injection point that parameters do not close. Refused
/// rather than quoted: quoting correctly depends on the dialect, and a quoted
/// name that was wrong is an injection that looks handled.
export fn name(candidate: Str) -> Result[Str, QueryError] {
  if candidate.isEmpty() {
    Err(Empty)
  } else {
    if DIGITS.contains(candidate.slice(0, 1)) {
      Err(BadName(candidate))
    } else {
      var good = true
      var index = 0
      while index < candidate.length() && good {
        if !NAME_CHARACTERS.contains(candidate.slice(index, index + 1)) { good = false }
        index = index + 1
      }
      if good { Ok(candidate) } else { Err(BadName(candidate)) }
    }
  }
}

/// A name that may carry the table it belongs to.
///
/// Needed wherever a statement reaches more than one table: once a join is in
/// play, every condition names its column with the table, and a check that
/// admitted only a bare name would refuse every one of them. Each part is
/// checked separately rather than the whole against a looser rule, because a
/// rule loose enough to admit a dot is loose enough to admit what follows one.
export fn qualifiedName(candidate: Str) -> Result[Str, QueryError] {
  let parts = candidate.split(".")
  if parts.length() > 2 {
    Err(BadName(candidate))
  } else {
    var index = 0
    var refused = false
    while index < parts.length() && !refused {
      if let Err(_) = name(parts[index]) { refused = true }
      index = index + 1
    }
    if refused { Err(BadName(candidate)) } else { Ok(candidate) }
  }
}

/// A name chosen from a list the program wrote.
///
/// What a program uses when a name really does come from outside: the choice
/// is between things the program named, so nothing outside decides anything.
export fn oneOf(candidate: Str, permitted: &Array[Str]) -> Result[Str, QueryError] {
  if permitted.contains(candidate) { Ok(candidate) } else { Err(BadName(candidate)) }
}

/// An operator, admitted only when it is one.
export fn operator(candidate: Str) -> Result[Str, QueryError] {
  let held = candidate.trim().toLower()
  if Set.contains(&OPERATORS, held) { Ok(held) } else { Err(BadOperator(candidate)) }
}

/// Everything from a table.
export fn from(table: Str) -> Result[Statement, QueryError] {
  let checked = name(table) ?
  Ok(text("select * from " + checked))
}

/// Named columns from a table.
export fn selecting(columns: &Array[Str], table: Str) -> Result[Statement, QueryError] {
  let checkedTable = name(table) ?
  var listed = ""
  var index = 0
  while index < columns.length() {
    let checked = name(columns[index]) ?
    if index > 0 { listed = listed + ", " }
    listed = listed + checked
    index = index + 1
  }
  if listed.isEmpty() {
    Err(Empty)
  } else {
    Ok(text("select " + listed + " from " + checkedTable))
  }
}

/// How many rows a table holds.
export fn counting(table: Str) -> Result[Statement, QueryError] {
  let checked = name(table) ?
  Ok(text("select count(*) as count from " + checked))
}

/// A condition on a column, with the value travelling beside the statement.
export fn matching(
  base: &Statement,
  column: Str,
  comparison: Str,
  value: Option[Str]
) -> Result[Statement, QueryError] {
  let checkedColumn = qualifiedName(column) ?
  let checkedOperator = operator(comparison) ?
  Ok(withValue(base, "where " + checkedColumn + " " + checkedOperator, value))
}

/// A further condition that must also hold.
export fn also(
  base: &Statement,
  column: Str,
  comparison: Str,
  value: Option[Str]
) -> Result[Statement, QueryError] {
  let checkedColumn = qualifiedName(column) ?
  let checkedOperator = operator(comparison) ?
  Ok(withValue(base, "and " + checkedColumn + " " + checkedOperator, value))
}

/// A further condition where either may hold.
export fn either(
  base: &Statement,
  column: Str,
  comparison: Str,
  value: Option[Str]
) -> Result[Statement, QueryError] {
  let checkedColumn = qualifiedName(column) ?
  let checkedOperator = operator(comparison) ?
  Ok(withValue(base, "or " + checkedColumn + " " + checkedOperator, value))
}

/// A condition that a column is one of several values.
///
/// Each value is its own parameter, so a list from outside cannot become part
/// of the text however long it is.
export fn matchingOneOf(
  base: &Statement,
  column: Str,
  values: &Array[Option[Str]]
) -> Result[Statement, QueryError] {
  let checkedColumn = qualifiedName(column) ?
  if values.length() == 0 {
    // Nothing is in an empty list, and saying so is better than building a
    // statement the database refuses to parse.
    Ok(Statement{parts: base.parts.push(Literal("where false")), values: base.values})
  } else {
    var parts = base.parts.push(Literal("where " + checkedColumn + " in ("))
    var held = base.values
    var index = 0
    while index < values.length() {
      if index > 0 { parts = parts.push(Literal(",")) }
      parts = parts.push(Placeholder)
      held = held.push(values[index])
      index = index + 1
    }
    Ok(Statement{parts: parts.push(Literal(")")), values: held})
  }
}

/// A condition that a column holds nothing.
export fn matchingMissing(base: &Statement, column: Str) -> Result[Statement, QueryError] {
  let checked = qualifiedName(column) ?
  Ok(Statement{parts: base.parts.push(Literal("where " + checked + " is null")), values: base.values})
}

/// The order rows come back in.
export fn orderBy(base: &Statement, column: Str, descending: Bool) -> Result[Statement, QueryError] {
  let checked = qualifiedName(column) ?
  Ok(
    Statement {
      parts: base.parts.push(Literal("order by " + checked + if descending { " desc" } else { " asc" })),
      values: base.values
    }
  )
}

/// At most this many rows.
///
/// A number rather than a parameter, because it is written by the program and
/// a database plans better when it knows it. It is a whole number by its type,
/// so nothing else can arrive here.
export fn limit(base: &Statement, count: Int) -> Statement {
  Statement{parts: base.parts.push(Literal("limit " + show(count))), values: base.values}
}

/// Starting after this many rows.
export fn offset(base: &Statement, count: Int) -> Statement {
  Statement{parts: base.parts.push(Literal("offset " + show(count))), values: base.values}
}

/// A row added to a table, from the columns and the values that fill them.
export fn insert(
  table: Str,
  columns: &Array[Str],
  values: &Array[Option[Str]]
) -> Result[Statement, QueryError] {
  let checkedTable = name(table) ?
  if columns.length() == 0 || columns.length() != values.length() { return Err(Empty) }
  var listed: Array[Str] = []
  var index = 0
  while index < columns.length() {
    let checked = name(columns[index]) ?
    listed = listed.push(checked)
    index = index + 1
  }
  var parts: Array[Part] = [Literal("insert into " + checkedTable + " (" + listed.join(", ") + ") values (")]
  var place = 0
  while place < columns.length() {
    if place > 0 { parts = parts.push(Literal(",")) }
    parts = parts.push(Placeholder)
    place = place + 1
  }
  Ok(Statement{parts: parts.push(Literal(")")), values: *values})
}

/// Columns of a table set to new values.
///
/// The conditions that choose which rows are added afterwards, so their
/// placeholders follow the ones the assignments used.
export fn update(
  table: Str,
  columns: &Array[Str],
  values: &Array[Option[Str]]
) -> Result[Statement, QueryError] {
  let checkedTable = name(table) ?
  if columns.length() == 0 || columns.length() != values.length() { return Err(Empty) }
  var parts: Array[Part] = [Literal("update " + checkedTable + " set")]
  var index = 0
  while index < columns.length() {
    let checked = name(columns[index]) ?
    parts = parts.push(Literal(if index > 0 { ", " + checked + " =" } else { checked + " =" }))
    parts = parts.push(Placeholder)
    index = index + 1
  }
  Ok(Statement{parts: parts, values: *values})
}

/// Rows removed from a table.
export fn deleteFrom(table: Str) -> Result[Statement, QueryError] {
  let checked = name(table) ?
  Ok(text("delete from " + checked))
}

/// A statement that answers with the rows it changed.
export fn returning(base: &Statement, columns: &Array[Str]) -> Result[Statement, QueryError] {
  var listed = ""
  var index = 0
  while index < columns.length() {
    let checked = name(columns[index]) ?
    if index > 0 { listed = listed + ", " }
    listed = listed + checked
    index = index + 1
  }
  if listed.isEmpty() {
    Err(Empty)
  } else {
    Ok(Statement{parts: base.parts.push(Literal("returning " + listed)), values: base.values})
  }
}

/// What a refusal says.
export fn explain(problem: &QueryError) -> Str {
  match problem {
    case BadName(candidate) =>
    "that is not a name a statement may hold: " + candidate
    case BadOperator(candidate) => "that is not a comparison this builds: " + candidate
    case Empty => "the statement names nothing to act on"
  }
}

/// Everything from the table a column belongs to.
///
/// Taken from the column rather than written again, so the table a statement
/// reads and the columns it names cannot disagree.
export fn fromTable[T](anyColumn: &Schema.Column[T]) -> Statement {
  text("select * from " + Schema.tableOf(anyColumn))
}

/// A condition on a column, with the column and the comparison both values.
///
/// This is the form worth using. The column is a name the compiler knows, so
/// the editor offers it and writing one that does not exist is refused where
/// it is written rather than when the statement runs. The value is checked
/// against what the column holds, so comparing text to a number does not
/// compile. And nothing here takes a name or an operator as text, so there is
/// no spelling for either to arrive wrong in.
export fn on[T: Schema.Bindable](
  base: &Statement,
  column: &Schema.Column[T],
  comparison: Schema.Comparison,
  value: &T
) -> Statement {
  withValue(
    base,
    "where " + Schema.nameOf(column) + " " + Schema.comparisonText(&comparison),
    Schema.boundValue(value)
  )
}

/// A further condition that must also hold.
export fn andOn[T: Schema.Bindable](
  base: &Statement,
  column: &Schema.Column[T],
  comparison: Schema.Comparison,
  value: &T
) -> Statement {
  withValue(
    base,
    "and " + Schema.nameOf(column) + " " + Schema.comparisonText(&comparison),
    Schema.boundValue(value)
  )
}

/// A further condition where either may hold.
export fn orOn[T: Schema.Bindable](
  base: &Statement,
  column: &Schema.Column[T],
  comparison: Schema.Comparison,
  value: &T
) -> Statement {
  withValue(
    base,
    "or " + Schema.nameOf(column) + " " + Schema.comparisonText(&comparison),
    Schema.boundValue(value)
  )
}

/// A condition that a column holds nothing.
export fn missingOn[T](base: &Statement, column: &Schema.Column[T]) -> Statement {
  Statement {
    parts: base.parts.push(Literal("where " + Schema.nameOf(column) + " is null")),
    values: base.values
  }
}

/// The order rows come back in, by a column the compiler knows.
export fn orderOn[T](base: &Statement, column: &Schema.Column[T], descending: Bool) -> Statement {
  Statement {
    parts: base.parts.push(Literal(
        "order by " + Schema.nameOf(column) + if descending { " desc" } else { " asc" }
      )),
    values: base.values
  }
}

/// Two results together, with the second's values following the first's.
export fn union(left: &Statement, right: &Statement, keepingDuplicates: Bool) -> Statement {
  combined(left, right, if keepingDuplicates { "union all" } else { "union" })
}

/// The rows in both.
export fn intersect(left: &Statement, right: &Statement) -> Statement {
  combined(left, right, "intersect")
}

/// The rows in the first and not the second.
export fn except(left: &Statement, right: &Statement) -> Statement {
  combined(left, right, "except")
}

fn combined(left: &Statement, right: &Statement, word: Str) -> Statement {
  then(&then(left, &text(word)), right)
}

/// A named result the rest of a statement reads from.
export fn withQuery(
  named: Str,
  body: &Statement,
  rest: &Statement
) -> Result[Statement, QueryError] {
  let checked = name(named) ?
  Ok(
    then(
        &text("with " + checked + " as ("),
        &then(body, &then(&text(")"), rest))
    )
  )
}
