module Std.List

import Std.Num {Add, Mul, One, Zero}
import Std.Order {Ord}

/// Whether the array has no elements.
export fn isEmpty[T](items: &Array[T]) -> Bool { items.length() == 0 }

/// The number of elements.
export fn length[T](items: &Array[T]) -> Int { items.length() }

/// The first element, or `None` for an empty array.
/// Nothing in `Std` is partial: this is why there is no `head` that panics.
export fn first[T](items: &Array[T]) -> Option[T] {
  if items.length() == 0 { None } else { Some(items[0]) }
}

/// The last element, or `None` for an empty array.
export fn last[T](items: &Array[T]) -> Option[T] {
  let size = items.length()
  if size == 0 { None } else { Some(items[size - 1]) }
}

/// The elements in reverse order.
export fn reversed[T](items: &Array[T]) -> Array[T] { items.reverse() }

/// One array followed by another.
export fn concat[T](left: &Array[T], right: &Array[T]) -> Array[T] {
  left.concat(*right)
}

/// The first `wanted` elements, or every element when the array is shorter.
/// A negative count takes nothing.
export fn take[T](items: &Array[T], wanted: Int) -> Array[T] {
  items.slice(0, clampIndex(wanted, items.length()))
}

/// Every element after the first `skipped`.
export fn drop[T](items: &Array[T], skipped: Int) -> Array[T] {
  let size = items.length()
  items.slice(clampIndex(skipped, size), size)
}

/// The elements from `from` up to but not including `to`.
export fn slice[T](items: &Array[T], from: Int, to: Int) -> Array[T] {
  let size = items.length()
  items.slice(clampIndex(from, size), clampIndex(to, size))
}

/// Whether any element equals the given value.
/// Equality is structural, which is what the runtime compares; there is no
/// `Eq` bound to write until the language has one.
export fn contains[T](items: &Array[T], wanted: T) -> Bool {
  items.contains(wanted)
}

/// The position of the first element equal to the given value.
/// The runtime answers `-1` for absent; this is the form a caller can match on
/// without remembering which sentinel means absent.
export fn indexOf[T](items: &Array[T], wanted: T) -> Option[Int] {
  let found = items.indexOf(wanted)
  if found < 0 { None } else { Some(found) }
}

/// How many elements equal the given value.
export fn count[T](items: &Array[T], wanted: T) -> Int {
  var total = 0
  for item in items {
    if item == wanted { total = total + 1 }
  }
  total
}

/// The sum of every element, or `None` for an empty array.
/// Generic over any type with an additive identity and an addition, which is
/// every integer width and both floating widths.
export fn sum[T: Zero + Add](items: &Array[T]) -> Option[T] {
  if items.length() == 0 { None } else {
    var running = items[0].zero()
    for item in items { running = running.plus(&item) }
    Some(running)
  }
}

/// Every element added together, with a caller-supplied value for empty.
/// The form to reach for when nought is the right answer for nothing; `sum`
/// keeps the distinction for callers that need it.
export fn sumOr[T: Zero + Add](items: &Array[T], empty: T) -> T {
  match sum(items) {
    case Some(found) => found
    case None => empty
  }
}

/// The product of every element, or `None` for an empty array.
export fn product[T: One + Mul](items: &Array[T]) -> Option[T] {
  if items.length() == 0 { None } else {
    var running = items[0].one()
    for item in items { running = running.times(&item) }
    Some(running)
  }
}

/// Every element multiplied together, with a caller-supplied value for empty.
export fn productOr[T: One + Mul](items: &Array[T], empty: T) -> T {
  match product(items) {
    case Some(found) => found
    case None => empty
  }
}

/// The smallest element, or `None` for an empty array.
export fn minimum[T: Ord](items: &Array[T]) -> Option[T] {
  if items.length() == 0 { None } else {
    var best = items[0]
    for item in items {
      if item.before(&best) { best = item }
    }
    Some(best)
  }
}

/// The largest element, or `None` for an empty array.
export fn maximum[T: Ord](items: &Array[T]) -> Option[T] {
  if items.length() == 0 { None } else {
    var best = items[0]
    for item in items {
      if best.before(&item) { best = item }
    }
    Some(best)
  }
}

/// Every element transformed.
export fn map[A, B](items: &Array[A], transform: fn(A) -> B) -> Array[B] {
  items.map(transform)
}

/// Every element the predicate accepts.
export fn filter[T](items: &Array[T], keep: fn(T) -> Bool) -> Array[T] {
  items.filter(keep)
}

/// Combine every element into one, left to right.
export fn fold[T, A](items: &Array[T], combine: fn(A, T) -> A, start: A) -> A {
  items.reduce(combine, start)
}

/// Whether every element satisfies the predicate. True for an empty array.
export fn all[T](items: &Array[T], holds: fn(T) -> Bool) -> Bool {
  items.filter(holds).length() == items.length()
}

/// Whether any element satisfies the predicate. False for an empty array.
export fn any[T](items: &Array[T], holds: fn(T) -> Bool) -> Bool {
  items.filter(holds).length() > 0
}

/// The elements in ascending order, under the type's own ordering.
/// Merge sort: the input is halved with `slice` and rejoined with `concat`,
/// both of which the runtime does on the structure rather than by rebuilding.
export fn sorted[T: Ord](items: &Array[T]) -> Array[T] {
  sortBy(items, fn(left: T, right: T) -> Bool => left.before(&right))
}

/// Two ascending arrays interleaved into one.
/// Exported because merging already-sorted input is worth doing without sorting
/// it again, which is the whole reason a merge sort has this step.
export fn merge[T: Ord](left: &Array[T], right: &Array[T]) -> Array[T] {
  mergeBy(left, right, fn(a: T, b: T) -> Bool => a.before(&b))
}

/// Every element but the first, or an empty array when there is none.
/// Named for what it is rather than for the position it drops, because the
/// partial version other languages call `tail` is not offered here at all.
export fn rest[T](items: &Array[T]) -> Array[T] {
  items.slice(1, items.length())
}

/// Every element but the last, or an empty array when there is none.
export fn initial[T](items: &Array[T]) -> Array[T] {
  let size = items.length()
  if size == 0 { items.slice(0, 0) } else { items.slice(0, size - 1) }
}

/// The array split at a position: the first `at` elements, then the rest.
export fn splitAt[T](items: &Array[T], position: Int) -> (Array[T], Array[T]) {
  (take(items, position), drop(items, position))
}

/// The longest leading run of elements the predicate accepts.
export fn takeWhile[T](items: &Array[T], holds: fn(T) -> Bool) -> Array[T] {
  items.slice(0, prefixLength(items, holds))
}

/// Everything after the longest leading run the predicate accepts.
export fn dropWhile[T](items: &Array[T], holds: fn(T) -> Bool) -> Array[T] {
  items.slice(prefixLength(items, holds), items.length())
}

/// The longest leading run the predicate accepts, and the rest.
export fn span[T](items: &Array[T], holds: fn(T) -> Bool) -> (Array[T], Array[T]) {
  let boundary = prefixLength(items, holds)
  (items.slice(0, boundary), items.slice(boundary, items.length()))
}

/// The longest leading run the predicate *rejects*, and the rest.
/// This is `span` with the predicate negated: `span` keeps while it holds, and
/// this one keeps until it does.
export fn breakWhen[T](items: &Array[T], holds: fn(T) -> Bool) -> (Array[T], Array[T]) {
  var boundary = 0
  let size = items.length()
  while boundary < size && !holds(items[boundary]) { boundary = boundary + 1 }
  (items.slice(0, boundary), items.slice(boundary, size))
}

/// The elements the predicate accepts, and the elements it rejects.
export fn partition[T](items: &Array[T], keep: fn(T) -> Bool) -> (Array[T], Array[T]) {
  var kept = []
  var rejected = []
  for item in items {
    if keep(item) { kept = kept.push(item) } else { rejected = rejected.push(item) }
  }
  (kept, rejected)
}

/// The first element the predicate accepts, or `None`.
export fn find[T](items: &Array[T], holds: fn(T) -> Bool) -> Option[T] {
  for item in items {
    if holds(item) { return Some(item) }
  }
  None
}

/// The position of the first element the predicate accepts, or `None`.
export fn findIndex[T](items: &Array[T], holds: fn(T) -> Bool) -> Option[Int] {
  var index = 0
  let size = items.length()
  while index < size {
    if holds(items[index]) { return Some(index) }
    index = index + 1
  }
  None
}

/// Every position whose element the predicate accepts.
export fn findIndices[T](items: &Array[T], holds: fn(T) -> Bool) -> Array[Int] {
  var out = []
  var index = 0
  let size = items.length()
  while index < size {
    if holds(items[index]) { out = out.push(index) }
    index = index + 1
  }
  out
}

/// Every position holding the given value.
export fn indicesOf[T](items: &Array[T], wanted: T) -> Array[Int] {
  var out = []
  var index = 0
  let size = items.length()
  while index < size {
    if items[index] == wanted { out = out.push(index) }
    index = index + 1
  }
  out
}

/// Whether one array begins with another.
export fn isPrefixOf[T](prefix: &Array[T], items: &Array[T]) -> Bool {
  let size = prefix.length()
  if size > items.length() { false } else { items.slice(0, size) == *prefix }
}

/// Whether one array ends with another.
export fn isSuffixOf[T](suffix: &Array[T], items: &Array[T]) -> Bool {
  let size = suffix.length()
  let total = items.length()
  if size > total { false } else { items.slice(total - size, total) == *suffix }
}

/// The remainder after a prefix, or `None` when the prefix is not there.
export fn stripPrefix[T](prefix: &Array[T], items: &Array[T]) -> Option[Array[T]] {
  if isPrefixOf(prefix, items) {
    Some(items.slice(prefix.length(), items.length()))
  } else {
    None
  }
}

/// A separator placed between every pair of elements.
export fn intersperse[T](items: &Array[T], separator: T) -> Array[T] {
  var out = []
  var index = 0
  let size = items.length()
  while index < size {
    if index > 0 { out = out.push(separator) }
    out = out.push(items[index])
    index = index + 1
  }
  out
}

/// Every array joined end to end.
export fn flatten[T](groups: &Array[Array[T]]) -> Array[T] {
  var out = []
  for members in groups { out = out.concat(members) }
  out
}

/// Every array joined with a separator array between them.
export fn intercalate[T](groups: &Array[Array[T]], separator: &Array[T]) -> Array[T] {
  var out = []
  var index = 0
  let size = groups.length()
  while index < size {
    if index > 0 { out = out.concat(*separator) }
    out = out.concat(groups[index])
    index = index + 1
  }
  out
}

/// Every element transformed into an array, and those arrays joined.
export fn flatMap[A, B](items: &Array[A], transform: fn(A) -> Array[B]) -> Array[B] {
  flatten(&items.map(transform))
}

/// Runs of adjacent equal elements.
export fn group[T](items: &Array[T]) -> Array[Array[T]] {
  var out = []
  var current = []
  for item in items {
    if current.length() == 0 || current[0] == item {
      current = current.push(item)
    } else {
      out = out.push(current)
      current = [item]
    }
  }
  if current.length() > 0 { out = out.push(current) }
  out
}

/// The elements with later duplicates removed, keeping the first of each.
export fn distinct[T](items: &Array[T]) -> Array[T] {
  var out = []
  for item in items {
    if !out.contains(item) { out = out.push(item) }
  }
  out
}

/// The first occurrence of a value removed, if it is there.
export fn removeFirst[T](items: &Array[T], unwanted: T) -> Array[T] {
  let found = items.indexOf(unwanted)
  if found < 0 { items.slice(0, items.length()) } else { items.remove(found) }
}

/// Every element of the first array that is not in the second.
export fn difference[T](left: &Array[T], right: &Array[T]) -> Array[T] {
  var out = []
  for item in left {
    if !right.contains(item) { out = out.push(item) }
  }
  out
}

/// The first array followed by every element of the second it does not contain.
export fn union[T](left: &Array[T], right: &Array[T]) -> Array[T] {
  var out = distinct(left)
  for item in right {
    if !out.contains(item) { out = out.push(item) }
  }
  out
}

/// Every element of the first array that is also in the second.
export fn intersection[T](left: &Array[T], right: &Array[T]) -> Array[T] {
  var out = []
  for item in left {
    if right.contains(item) { out = out.push(item) }
  }
  out
}

/// Corresponding elements paired, stopping at the shorter array.
export fn zip[A, B](left: &Array[A], right: &Array[B]) -> Array[(A, B)] {
  var out = []
  var index = 0
  let size = if left.length() < right.length() { left.length() } else { right.length() }
  while index < size {
    out = out.push((left[index], right[index]))
    index = index + 1
  }
  out
}

/// Corresponding elements combined, stopping at the shorter array.
export fn zipWith[A, B, C](left: &Array[A], right: &Array[B], combine: fn(A, B) -> C) -> Array[C] {
  var out = []
  var index = 0
  let size = if left.length() < right.length() { left.length() } else { right.length() }
  while index < size {
    out = out.push(combine(left[index], right[index]))
    index = index + 1
  }
  out
}

/// Every element paired with its position.
export fn enumerate[T](items: &Array[T]) -> Array[(Int, T)] {
  var out = []
  var index = 0
  let size = items.length()
  while index < size {
    out = out.push((index, items[index]))
    index = index + 1
  }
  out
}

/// Pairs separated back into two arrays.
export fn unzip[A, B](pairs: &Array[(A, B)]) -> (Array[A], Array[B]) {
  var lefts = []
  var rights = []
  for pair in pairs {
    lefts = lefts.push(pair[0])
    rights = rights.push(pair[1])
  }
  (lefts, rights)
}

/// The value paired with the first matching key, or `None`.
export fn lookup[K, V](pairs: &Array[(K, V)], wanted: K) -> Option[V] {
  for pair in pairs {
    if pair[0] == wanted { return Some(pair[1]) }
  }
  None
}

/// A value repeated a number of times. A count below one produces nothing.
export fn replicate[T](times: Int, value: T) -> Array[T] {
  var out = []
  var remaining = times
  while remaining > 0 {
    out = out.push(value)
    remaining = remaining - 1
  }
  out
}

/// The whole numbers from `from` up to but not including `to`.
export fn range(from: Int, to: Int) -> Array[Int] {
  var out = []
  var current = from
  while current < to {
    out = out.push(current)
    current = current + 1
  }
  out
}

/// Repeated application of a function, starting from a seed.
/// The count is required: Pudu evaluates strictly and has no infinite arrays,
/// so a repeated application must be told when to stop.
export fn iterate[T](times: Int, seed: T, step: fn(T) -> T) -> Array[T] {
  var out = []
  var current = seed
  var remaining = times
  while remaining > 0 {
    out = out.push(current)
    current = step(current)
    remaining = remaining - 1
  }
  out
}

/// Every running total, starting from the initial value.
/// The result is one longer than the input, because the initial value is a
/// running total too.
export fn scan[T, A](items: &Array[T], combine: fn(A, T) -> A, start: A) -> Array[A] {
  var out = [start]
  var accumulated = start
  for item in items {
    accumulated = combine(accumulated, item)
    out = out.push(accumulated)
  }
  out
}

/// Combine every element into one, right to left.
export fn foldRight[T, A](items: &Array[T], combine: fn(T, A) -> A, start: A) -> A {
  var accumulated = start
  var index = items.length()
  while index > 0 {
    index = index - 1
    accumulated = combine(items[index], accumulated)
  }
  accumulated
}

/// Every prefix, shortest first, including the empty one and the whole array.
export fn prefixes[T](items: &Array[T]) -> Array[Array[T]] {
  var out = []
  var index = 0
  let size = items.length()
  while index <= size {
    out = out.push(items.slice(0, index))
    index = index + 1
  }
  out
}

/// Every suffix, longest first, including the whole array and the empty one.
export fn suffixes[T](items: &Array[T]) -> Array[Array[T]] {
  var out = []
  var index = 0
  let size = items.length()
  while index <= size {
    out = out.push(items.slice(index, size))
    index = index + 1
  }
  out
}

/// The elements ordered by a comparison the caller supplies.
/// `before` answers whether its first argument sorts before its second; a
/// comparison that is not a total order produces an unspecified order rather
/// than a failure, which is the same promise every comparison sort makes.
export fn sortBy[T](items: &Array[T], before: fn(T, T) -> Bool) -> Array[T] {
  let size = items.length()
  if size <= 1 { items.slice(0, size) } else {
    let middle = size / 2
    let front = sortBy(&items.slice(0, middle), before)
    let back = sortBy(&items.slice(middle, size), before)
    mergeBy(&front, &back, before)
  }
}

/// Two arrays ordered by the same comparison interleaved into one.
export fn mergeBy[T](left: &Array[T], right: &Array[T], before: fn(T, T) -> Bool) -> Array[T] {
  var out = []
  var leftIndex = 0
  var rightIndex = 0
  let leftCount = left.length()
  let rightCount = right.length()
  while leftIndex < leftCount && rightIndex < rightCount {
    if before(right[rightIndex], left[leftIndex]) {
      out = out.push(right[rightIndex])
      rightIndex = rightIndex + 1
    } else {
      out = out.push(left[leftIndex])
      leftIndex = leftIndex + 1
    }
  }
  out.concat(left.slice(leftIndex, leftCount)).concat(right.slice(rightIndex, rightCount))
}

/// The element a comparison ranks first, or `None` for an empty array.
export fn minimumBy[T](items: &Array[T], before: fn(T, T) -> Bool) -> Option[T] {
  if items.length() == 0 { None } else {
    var best = items[0]
    for item in items {
      if before(item, best) { best = item }
    }
    Some(best)
  }
}

/// The element a comparison ranks last, or `None` for an empty array.
export fn maximumBy[T](items: &Array[T], before: fn(T, T) -> Bool) -> Option[T] {
  if items.length() == 0 { None } else {
    var best = items[0]
    for item in items {
      if before(best, item) { best = item }
    }
    Some(best)
  }
}

/// How many elements the predicate accepts.
export fn countWhere[T](items: &Array[T], holds: fn(T) -> Bool) -> Int {
  items.filter(holds).length()
}

/// The length of the longest leading run the predicate accepts.
fn prefixLength[T](items: &Array[T], holds: fn(T) -> Bool) -> Int {
  var scanned = 0
  let size = items.length()
  while scanned < size && holds(items[scanned]) { scanned = scanned + 1 }
  scanned
}

/// Whether no element equals the given value.
export fn notContains[T](items: &Array[T], wanted: T) -> Bool {
  !items.contains(wanted)
}

/// Whether one array appears inside another as a contiguous run.
export fn isInfixOf[T](needle: &Array[T], items: &Array[T]) -> Bool {
  let small = needle.length()
  let large = items.length()
  if small == 0 { true } else {
    var start = 0
    while start + small <= large {
      if items.slice(start, start + small) == *needle { return true }
      start = start + 1
    }
    false
  }
}

/// The remainder before a suffix, or `None` when the suffix is not there.
export fn stripSuffix[T](suffix: &Array[T], items: &Array[T]) -> Option[Array[T]] {
  if isSuffixOf(suffix, items) {
    Some(items.slice(0, items.length() - suffix.length()))
  } else {
    None
  }
}

/// The array with trailing elements the predicate accepts removed.
export fn dropWhileEnd[T](items: &Array[T], holds: fn(T) -> Bool) -> Array[T] {
  var size = items.length()
  while size > 0 && holds(items[size - 1]) { size = size - 1 }
  items.slice(0, size)
}

/// The last `wanted` elements, or every element when the array is shorter.
export fn takeEnd[T](items: &Array[T], wanted: Int) -> Array[T] {
  let size = items.length()
  items.slice(clampIndex(size - wanted, size), size)
}

/// Every element but the last `skipped`.
export fn dropEnd[T](items: &Array[T], skipped: Int) -> Array[T] {
  let size = items.length()
  items.slice(0, clampIndex(size - skipped, size))
}

/// The rows and columns exchanged. Rows of unequal length contribute only the
/// positions they have, so no element is invented to fill a gap.
export fn transpose[T](rows: &Array[Array[T]]) -> Array[Array[T]] {
  var longest = 0
  for row in rows {
    if row.length() > longest { longest = row.length() }
  }
  var out = []
  var column = 0
  while column < longest {
    var gathered = []
    for row in rows {
      if column < row.length() { gathered = gathered.push(row[column]) }
    }
    out = out.push(gathered)
    column = column + 1
  }
  out
}

/// Every subsequence, including the empty one and the whole array.
/// The count doubles with each element, so this is for small inputs by nature
/// rather than by choice.
export fn subsequences[T](items: &Array[T]) -> Array[Array[T]] {
  var out = [[]]
  for item in items {
    var grown = out
    for existing in out { grown = grown.push(existing.push(item)) }
    out = grown
  }
  out
}

/// Every ordering of the elements. The count is the factorial of the length,
/// so this is for small inputs by nature rather than by choice.
export fn permutations[T](items: &Array[T]) -> Array[Array[T]] {
  let size = items.length()
  if size == 0 { [[]] } else {
    var out = []
    var index = 0
    while index < size {
      let chosen = items[index]
      let others = items.slice(0, index).concat(items.slice(index + 1, size))
      for tail in permutations(&others) {
        out = out.push([chosen].concat(tail))
      }
      index = index + 1
    }
    out
  }
}

/// An array grown from a seed until the step answers `None`.
/// The step count is bounded because a strict language cannot recover from a
/// step that never stops; exhausting the bound answers with what it had.
export fn unfold[S, T](limit: Int, seed: S, step: fn(S) -> Option[(T, S)]) -> Array[T] {
  var out = []
  var current = seed
  var remaining = limit
  while remaining > 0 {
    match step(current) {
      case Some(pair) => {
        out = out.push(pair[0])
        current = pair[1]
      }
      case None => { return out }
    }
    remaining = remaining - 1
  }
  out
}

/// The array repeated end to end a number of times.
export fn cycle[T](items: &Array[T], times: Int) -> Array[T] {
  var out = []
  var remaining = times
  while remaining > 0 {
    out = out.concat(*items)
    remaining = remaining - 1
  }
  out
}

/// The array in pieces of at most `size` elements.
export fn chunksOf[T](items: &Array[T], size: Int) -> Array[Array[T]] {
  var out = []
  if size <= 0 { out } else {
    var index = 0
    let total = items.length()
    while index < total {
      let end = if index + size > total { total } else { index + size }
      out = out.push(items.slice(index, end))
      index = index + size
    }
    out
  }
}

/// Every contiguous run of `size` elements, one position apart.
/// Nothing at all when the array is shorter than the window.
export fn windows[T](items: &Array[T], size: Int) -> Array[Array[T]] {
  var out = []
  if size <= 0 { out } else {
    var start = 0
    let total = items.length()
    while start + size <= total {
      out = out.push(items.slice(start, start + size))
      start = start + 1
    }
    out
  }
}

/// A value placed into an array that is already in ascending order, keeping it
/// in order. Placed after equal elements, so repeated insertion is stable.
export fn insertOrdered(items: &Array[Int], value: Int) -> Array[Int] {
  var position = 0
  let size = items.length()
  while position < size && items[position] <= value { position = position + 1 }
  items.insert(position, value)
}

/// A value placed into an array ordered by a comparison, keeping it in order.
export fn insertBy[T](items: &Array[T], value: T, before: fn(T, T) -> Bool) -> Array[T] {
  var position = 0
  let size = items.length()
  while position < size && !before(value, items[position]) { position = position + 1 }
  items.insert(position, value)
}

/// Runs of adjacent elements that a comparison calls equivalent.
export fn groupBy[T](items: &Array[T], same: fn(T, T) -> Bool) -> Array[Array[T]] {
  var out = []
  var current = []
  for item in items {
    if current.length() == 0 || same(current[0], item) {
      current = current.push(item)
    } else {
      out = out.push(current)
      current = [item]
    }
  }
  if current.length() > 0 { out = out.push(current) }
  out
}

/// The elements with later duplicates removed under a comparison.
export fn distinctBy[T](items: &Array[T], same: fn(T, T) -> Bool) -> Array[T] {
  var out = []
  for item in items {
    var seen = false
    for kept in out {
      if same(kept, item) { seen = true }
    }
    if !seen { out = out.push(item) }
  }
  out
}

/// The elements ordered by a key drawn from each one.
export fn sortOn[T](items: &Array[T], key: fn(T) -> Int) -> Array[T] {
  sortBy(items, fn(left: T, right: T) -> Bool => key(left) < key(right))
}

/// The element whose key is smallest, or `None` for an empty array.
export fn minimumOn[T](items: &Array[T], key: fn(T) -> Int) -> Option[T] {
  minimumBy(items, fn(left: T, right: T) -> Bool => key(left) < key(right))
}

/// The element whose key is largest, or `None` for an empty array.
export fn maximumOn[T](items: &Array[T], key: fn(T) -> Int) -> Option[T] {
  maximumBy(items, fn(left: T, right: T) -> Bool => key(left) < key(right))
}

/// Every running total, from the right.
export fn scanRight[T, A](items: &Array[T], combine: fn(T, A) -> A, start: A) -> Array[A] {
  var out = [start]
  var accumulated = start
  var index = items.length()
  while index > 0 {
    index = index - 1
    accumulated = combine(items[index], accumulated)
    out = [accumulated].concat(out)
  }
  out
}

/// A fold that also collects what each step produced, left to right.
export fn mapAccum[T, A, B](items: &Array[T], step: fn(A, T) -> (A, B), start: A) -> (A, Array[B]) {
  var accumulated = start
  var out = []
  for item in items {
    let stepped = step(accumulated, item)
    accumulated = stepped[0]
    out = out.push(stepped[1])
  }
  (accumulated, out)
}

/// Three arrays' corresponding elements gathered, stopping at the shortest.
export fn zip3[A, B, C](one: &Array[A], two: &Array[B], three: &Array[C]) -> Array[(A, B, C)] {
  var out = []
  var index = 0
  var size = one.length()
  if two.length() < size { size = two.length() }
  if three.length() < size { size = three.length() }
  while index < size {
    out = out.push((one[index], two[index], three[index]))
    index = index + 1
  }
  out
}

/// Three arrays' corresponding elements combined, stopping at the shortest.
export fn zipWith3[A, B, C, D](
  one: &Array[A],
  two: &Array[B],
  three: &Array[C],
  combine: fn(A, B, C) -> D
) -> Array[D] {
  var out = []
  var index = 0
  var size = one.length()
  if two.length() < size { size = two.length() }
  if three.length() < size { size = three.length() }
  while index < size {
    out = out.push(combine(one[index], two[index], three[index]))
    index = index + 1
  }
  out
}

/// Triples separated back into three arrays.
export fn unzip3[A, B, C](triples: &Array[(A, B, C)]) -> (Array[A], Array[B], Array[C]) {
  var firsts = []
  var seconds = []
  var thirds = []
  for triple in triples {
    firsts = firsts.push(triple[0])
    seconds = seconds.push(triple[1])
    thirds = thirds.push(triple[2])
  }
  (firsts, seconds, thirds)
}

/// Every pairing of one array's elements with the other's.
export fn cartesian[A, B](left: &Array[A], right: &Array[B]) -> Array[(A, B)] {
  var out = []
  for leftItem in left {
    for rightItem in right { out = out.push((leftItem, rightItem)) }
  }
  out
}

/// The elements at the given positions, skipping positions the array lacks.
export fn pick[T](items: &Array[T], positions: &Array[Int]) -> Array[T] {
  var out = []
  let size = items.length()
  for position in positions {
    if position >= 0 && position < size { out = out.push(items[position]) }
  }
  out
}

/// The element at a position, or `None` when there is none.
export fn get[T](items: &Array[T], position: Int) -> Option[T] {
  if position < 0 || position >= items.length() { None } else { Some(items[position]) }
}

/// The array with one position replaced, or unchanged when it has none.
export fn set[T](items: &Array[T], position: Int, value: T) -> Array[T] {
  if position < 0 || position >= items.length() { *items } else {
    items.remove(position).insert(position, value)
  }
}

/// The array with one position transformed, or unchanged when it has none.
export fn modify[T](items: &Array[T], position: Int, transform: fn(T) -> T) -> Array[T] {
  if position < 0 || position >= items.length() { *items } else {
    set(items, position, transform(items[position]))
  }
}

/// Confine an index to the array's bounds, which is what every slice needs.
fn clampIndex(index: Int, limit: Int) -> Int {
  if index < 0 { 0 } else { if index > limit { limit } else { index } }
}
