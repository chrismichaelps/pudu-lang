module Std.Http.Server

import Std.Bytes as ByteSeq
import Std.Concurrent as Concurrent
import Std.Http as Http
import Std.Http.Message as Message
import Std.Http.Server.Reply as Reply
import Std.Http.Server.Reply {text}
import Std.Http.Server.Route as Route
import Std.Http.Server.Route {dispatch}
import Std.Net as Net
import Std.Option as Option
import Std.Result as Result
import Std.Sync as Sync

export type ServerError
  = Bind(Str)
  | Accept(Str)
  | Stopped
  | Other(Str)

/// A server, ready to be given an address.
export type Server = {
  router: Route.Router,
  middleware: Array[Route.Middleware],
  headLimit: Int,
  bodyLimit: Int
}

/// A running server, and the switch that stops it.
export type Running = {
  listener: Net.Listener,
  port: Int,
  stopping: Sync.Cell[Bool]
}

/// The largest head a request may have before it is refused.
/// A limit is not a tuning choice: without one, a client that opens a
/// connection and never sends the blank line that ends the head can make the
/// server hold everything it did send, and enough such clients are the whole
/// of the attack.
const HEAD_LIMIT: Int = 65536

/// The largest body a request may carry before it is refused.
const BODY_LIMIT: Int = 8388608

/// A server over a router, with no middleware and the default limits.
export fn server(base: &Route.Router) -> Server {
  Server{router: *base, middleware: [], headLimit: HEAD_LIMIT, bodyLimit: BODY_LIMIT}
}

/// A server with one more step wrapped around its handlers.
///
/// The first added is the outermost, so a step added first sees the request
/// before every step added after it and sees the response after them. That is
/// the order a reader assumes from the order they wrote, and the reverse would
/// make logging and timing report the wrong span.
export fn using(base: &Server, step: Route.Middleware) -> Server {
  Server {
    router: base.router,
    middleware: base.middleware.push(step),
    headLimit: base.headLimit,
    bodyLimit: base.bodyLimit
  }
}

/// A server with different limits on what a request may be.
export fn withLimits(base: &Server, head: Int, payload: Int) -> Server {
  Server{router: base.router, middleware: base.middleware, headLimit: head, bodyLimit: payload}
}

/// The handler a server presents, with every step wrapped around it.
///
/// Built once rather than per request: the chain is the same for every
/// request, and rebuilding it on each one would put the whole of the server's
/// configuration inside its hot path.
export fn handlerOf(target: &Server) -> Route.Handler {
  let routed = target.router
  var next: Route.Handler = fn(request: Route.Request) -> Http.Response { dispatch(&routed, request) }
  var index = target.middleware.length() - 1
  while index >= 0 {
    let outer = target.middleware[index]
    let inner = next
    next = fn(request: Route.Request) -> Http.Response { outer(request, inner) }
    index = index - 1
  }
  next
}

/// A request built from what a connection carried, or the reason it was not
/// one. The reason is a response rather than an error, because a server that
/// was handed a malformed message is working correctly when it says so.
fn readRequest(
  connection: &Net.Connection,
  headLimit: Int,
  bodyLimit: Int
) -> Result[Route.Request, Http.Response] {
  let split = Net.receiveUntil(connection, &ByteSeq.fromText("\r\n\r\n"), headLimit)
  if let Err(_) = split { return Err(badRequest("the head did not arrive")) }
  let pair = Result.unwrapOr(split, (ByteSeq.empty(), ByteSeq.empty()))
  let head = Result.unwrapOr(ByteSeq.toText(&pair[0]), "")
  let parsed = Message.parseRequest(head + "\r\n\r\n")
  if let Err(problem) = parsed { return Err(badRequest(Message.explain(&problem))) }
  let message = Result.unwrapOr(parsed, emptyRequest())
  let needed = contentLength(&message.headers)
  if needed > bodyLimit { return Err(tooLarge()) }
  let carried = pair[1]
  var payload = carried.take(needed)
  if carried.length() < needed {
    let more = Net.receiveExactly(connection, needed - carried.length())
    if let Err(_) = more { return Err(badRequest("the body did not arrive")) }
    payload = carried.concat(Result.unwrapOr(more, ByteSeq.empty()))
  }
  let whole = Http.Request {
    method: message.method,
    target: message.target,
    headers: message.headers,
    body: Result.unwrapOr(ByteSeq.toText(&payload), "")
  }
  Ok(
    Route.Request {
      message: whole,
      path: Route.pathOf(whole.target),
      params: mapOf([]),
      query: Route.queryOf(whole.target),
      peer: Result.unwrapOr(Net.peerOf(connection), "")
    }
  )
}

/// How long a body the head says is coming, or none.
fn contentLength(headers: &Array[(Str, Str)]) -> Int {
  var found = 0
  for entry in headers {
    if entry[0].toLower() == "content-length" {
      found = Option.unwrapOr(wholeOf(entry[1].trim()), 0)
    }
  }
  found
}

fn wholeOf(digits: Str) -> Option[Int] {
  if digits.isEmpty() {
    None
  } else {
    var total = 0
    var index = 0
    var good = true
    while index < digits.length() && good {
      let digit = "0123456789".indexOf(digits.slice(index, index + 1))
      if digit < 0 { good = false } else { total = total * 10 + digit }
      index = index + 1
    }
    if good { Some(total) } else { None }
  }
}

/// Serve one connection: read a request, answer it, and say whether the
/// connection may carry another.
///
/// A connection is kept open unless something said otherwise, because opening
/// one costs a round trip and a client fetching a page makes many requests.
/// The response always states its own length, so the client knows where the
/// body ends without the connection closing to tell it.
export fn serveConnection(target: &Server, connection: &Net.Connection) -> Bool {
  let read = readRequest(connection, target.headLimit, target.bodyLimit)
  let handle = handlerOf(target)
  if let Err(refusal) = read {
    let _sent = sendResponse(connection, &withLength(&closing(&refusal)))
    false
  } else {
    let request = Result.unwrapOr(read, emptyServerRequest())
    let answer = handle(request)
    let keeping = wantsKeepAlive(&request.message)
    let finished = if keeping { withLength(&answer) } else { withLength(&closing(&answer)) }
    let sent = sendResponse(connection, &finished)
    keeping && Result.isOk(&sent)
  }
}

fn sendResponse(connection: &Net.Connection, answer: &Http.Response) -> Result[(), Net.NetError] {
  Net.sendText(connection, Message.renderResponse(answer))
}

/// Whether the client asked to keep the connection open.
/// The protocol's later versions keep it open unless the request says
/// otherwise, which is the default assumed here.
fn wantsKeepAlive(message: &Http.Request) -> Bool {
  var keeping = true
  for entry in message.headers {
    if entry[0].toLower() == "connection" {
      if entry[1].trim().toLower() == "close" { keeping = false }
    }
  }
  keeping
}

fn closing(answer: &Http.Response) -> Http.Response {
  Http.Response {
    status: answer.status,
    headers: answer.headers.push(("Connection", "close")),
    body: answer.body
  }
}

/// A response stating its own length.
///
/// Added here rather than left to a handler, because a response without it
/// leaves the client reading until the connection closes: the body arrives,
/// but only after a wait that looks like the server being slow.
fn withLength(answer: &Http.Response) -> Http.Response {
  var already = false
  for entry in answer.headers {
    if entry[0].toLower() == "content-length" { already = true }
  }
  if already {
      *answer
  } else {
    Http.Response {
      status: answer.status,
      headers: answer.headers.push(("Content-Length", show(answer.body.toBytes().length()))),
      body: answer.body
    }
  }
}

/// Start listening, and answer what is needed to stop.
export fn start(host: Str, port: Int) -> Result[Running, ServerError] {
  let opened = Net.listen(host, port)
  if let Err(problem) = opened {
    Err(Bind(show(problem)))
  } else {
    let listener = Result.unwrapOr(opened, Net.Listener{token: 0})
    let actual = Result.unwrapOr(Net.portOf(&listener), port)
    Ok(Running{listener: listener, port: actual, stopping: Sync.cell(false)})
  }
}

/// Which port a running server is on.
/// Worth asking even when a port was named, because a server started on port
/// zero was given one by the machine and this is the only way to learn it.
export fn portOf(running: &Running) -> Int { running.port }

/// Ask a server to stop.
///
/// Closing the listener is what ends the accept loop, because accepting does
/// not answer until a connection arrives and a flag alone would not be read
/// until one did. The flag is what tells the loop the failure was asked for
/// rather than a fault.
export fn stop(running: &Running) -> Result[(), ServerError] {
  let _flagged = Sync.set(&running.stopping, true)
  Result.mapErr(Net.closeListener(&running.listener), fn(problem: Net.NetError) -> ServerError {
      Other(show(problem))
    })
}

/// Accept connections and serve them, each on a thread of its own.
///
/// A connection is handled on its own thread, so one slow request does not
/// hold up every other client. That is the difference between a server and a
/// queue: without it, a handler that waits on a database stops the whole
/// program for as long as it waits.
///
/// `limit` bounds how many connections are accepted before the loop ends, so a
/// caller wanting one does not have to arrange to stop the server. A limit of
/// zero or less accepts until the server is stopped.
export fn run(target: &Server, running: &Running, limit: Int) -> Result[Int, ServerError] {
  let listener = running.listener
  let stopping = running.stopping
  let serving = *target
  var served = 0
  var workers: Array[Concurrent.Task] = []
  var failure: Option[ServerError] = None
  var going = true
  while going {
    let accepted = Net.accept(&listener)
    if let Err(problem) = accepted {
      if Result.unwrapOr(Sync.get(&stopping), false) {
        failure = None
      } else {
        failure = Some(Accept(show(problem)))
      }
      going = false
    } else {
      let connection = Result.unwrapOr(accepted, Net.Connection{token: 0})
      let started = Concurrent.start(fn() -> () {
          var keeping = true
          while keeping { keeping = serveConnection(&serving, &connection) }
          let _closed = Net.close(&connection)
          ()
        })
      if let Ok(worker) = started { workers = workers.push(worker) }
      served = served + 1
      going = limit <= 0 || served < limit
    }
  }
  // Every connection already accepted is finished before the loop answers, so
  // a caller told how many were served is told about requests that completed
  // rather than about connections that had merely arrived.
  let _joined = Concurrent.joinAll(&workers)
  if let Some(problem) = failure { Err(problem) } else { Ok(served) }
}

/// Start, serve, and stop, for a caller that wants one call.
export fn listenAndServe(
  target: &Server,
  host: Str,
  port: Int,
  limit: Int
) -> Result[Int, ServerError] {
  let running = start(host, port) ?
  let served = run(target, &running, limit)
  let _stopped = stop(&running)
  served
}

fn badRequest(reason: Str) -> Http.Response { text(400, reason) }

fn tooLarge() -> Http.Response { text(413, "the body is larger than this server accepts") }

fn emptyRequest() -> Http.Request {
  Http.Request{method: Http.Get, target: "/", headers: [], body: ""}
}

fn emptyServerRequest() -> Route.Request {
  Route.Request {
    message: emptyRequest(),
    path: "/",
    params: mapOf([]),
    query: mapOf([]),
    peer: ""
  }
}

/// A step that writes a line about every request once its answer is known.
///
/// Given as an example of the shape as much as for its own sake: it calls on,
/// times what it wrapped, and reports afterwards, which is what a step that
/// only ran before could not do.
export fn logging(write: fn(Str) -> ()) -> Route.Middleware {
  fn(request: Route.Request, next: Route.Handler) -> Http.Response {
    let started = clock()
    let answer = next(request)
    write(
      Http.methodName(&request.message.method) + " " + request.path + " -> "
        + show(answer.status.code) + " in " + show(clock() - started) + "ms"
    )
    answer
  }
}
