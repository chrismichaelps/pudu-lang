module Std.Http.Client

import Std.Bytes as ByteSeq
import Std.Http as Http
import Std.Http.Message as Message
import Std.Http.Safe as Safe
import Std.Net as Net
import Std.Option as Option
import Std.Result as Result
import Std.Set as Set
import Std.Tls as Tls
import Std.Url as Url

/// What a request may cost, and where it may go.
///
/// Bounds rather than none: an unbounded client is a way to exhaust the memory
/// of the program that made the request rather than of the one that answered.
export type Limits = {
  redirects: Int,
  bodyBytes: Int,
  permittedHosts: Array[Str],
  followRedirects: Bool
}

/// Why a request did not answer.
export type ClientError
  = BadUrl(Str)
  | Unreachable(Str)
  | NotPermitted(Str)
  | TooManyRedirects(Int)
  | TooLarge(Int)
  | Malformed(Str)

/// How many redirects a chain may have before it is refused.
const DEFAULT_REDIRECTS: Int = 5

/// How large an answer will be read.
const DEFAULT_BODY_BYTES: Int = 8388608

/// The header that must not survive a change of origin.
///
/// A caller sets it for the host they named, not for whichever host that one
/// points at. A request carrying it, redirected somewhere the caller never
/// named, sends it to whoever operates that place.
const CREDENTIAL_HEADERS: Set[Str] = setOf(["authorization", "cookie", "proxy-authorization"])

/// The redirects that turn a request which changes something into one that
/// changes nothing.
///
/// What the older codes mean and what every client does. Getting this wrong
/// repeats a change.
const METHOD_DROPPING: Set[Int] = setOf([301, 302, 303])

/// The redirects that keep the method they were answered to.
const METHOD_KEEPING: Set[Int] = setOf([307, 308])

/// The scheme that means the connection is secured.
const SECURE_SCHEME: Str = "https"

/// The bounds a request has when the caller does not say.
export fn limits() -> Limits {
  Limits {
    redirects: DEFAULT_REDIRECTS,
    bodyBytes: DEFAULT_BODY_BYTES,
    permittedHosts: [],
    followRedirects: true
  }
}

/// The same bounds, reading at most this many bytes of an answer.
export fn reading(base: &Limits, bytes: Int) -> Limits {
  Limits {
    redirects: base.redirects,
    bodyBytes: bytes,
    permittedHosts: base.permittedHosts,
    followRedirects: base.followRedirects
  }
}

/// The same bounds, following at most this many redirects.
export fn following(base: &Limits, count: Int) -> Limits {
  Limits {
    redirects: count,
    bodyBytes: base.bodyBytes,
    permittedHosts: base.permittedHosts,
    followRedirects: count > 0
  }
}

/// The same bounds, permitting an address that would otherwise be refused.
///
/// Named rather than a mode, so a service that genuinely must reach an
/// internal host says which one. A blanket permission would be worked around
/// outside this module, where nothing checks anything.
export fn reaching(base: &Limits, hosts: &Array[Str]) -> Limits {
  Limits {
    redirects: base.redirects,
    bodyBytes: base.bodyBytes,
    permittedHosts: *hosts,
    followRedirects: base.followRedirects
  }
}

/// Fetch a URL.
export fn fetch(target: Str, held: &Limits) -> Result[Http.Response, ClientError] {
  send(&Http.Request{method: Http.Get, target: target, headers: [], body: ""}, held)
}

/// Send a request and read what comes back.
///
/// Every hop is checked against the address rules as though it were the first,
/// because a redirect is a new request to a new place and treating it as a
/// continuation is how the checks get skipped.
export fn send(request: &Http.Request, held: &Limits) -> Result[Http.Response, ClientError] {
  var carrying = *request
  var hops = 0
  var answer: Option[Http.Response] = None
  var failure: Option[ClientError] = None

  while Option.isNone(&answer) && Option.isNone(&failure) {
    let reached = once(&carrying, held)
    if let Err(problem) = reached {
      failure = Some(problem)
    } else {
      let received = Result.unwrapOr(reached, emptyResponse())
      if !held.followRedirects || !isRedirect(received.status.code) {
        answer = Some(received)
      } else {
        hops = hops + 1
        if hops > held.redirects {
          failure = Some(TooManyRedirects(held.redirects))
        } else {
          let next = redirected(&carrying, &received)
          if let Err(problem) = next { failure = Some(problem) } else {
            carrying = Result.unwrapOr(next, carrying)
          }
        }
      }
    }
  }

  if let Some(problem) = failure { Err(problem) } else { Ok(Option.unwrapOr(answer, emptyResponse())) }
}

/// One request, without following anything.
fn once(request: &Http.Request, held: &Limits) -> Result[Http.Response, ClientError] {
  let parsed = Url.parse(request.target)
  if let Err(_) = parsed { return Err(BadUrl(request.target)) }
  let place = Result.unwrapOr(parsed, emptyUrl())
  // Checked here rather than once at the start, so a redirect to an internal
  // address is refused exactly as a first request to one would be.
  if let Err(problem) = Safe.outboundHost(place.host, &held.permittedHosts) {
    return Err(NotPermitted(Safe.explain(&problem)))
  }
  let port = Option.unwrapOr(Url.effectivePort(&place), if secured(&place) { 443 } else { 80 })
  let written = Message.renderRequest(&addressed(request, &place))
  if secured(&place) { overSecured(&place, port, written, held) } else { overPlain(&place, port, written, held) }
}

/// The request as it goes on the wire: the path rather than the whole URL, and
/// the host it was addressed to.
fn addressed(request: &Http.Request, place: &Url.Url) -> Http.Request {
  Http.Request {
    method: request.method,
    target: pathAndQuery(place),
    headers: withHost(&request.headers, place),
    body: request.body
  }
}

fn pathAndQuery(place: &Url.Url) -> Str {
  let path = if place.path.isEmpty() { "/" } else { place.path }
  if place.query.length() == 0 { path } else { path + "?" + Url.renderQuery(&place.query) }
}

fn withHost(headers: &Array[(Str, Str)], place: &Url.Url) -> Array[(Str, Str)] {
  var found = false
  for entry in headers { if entry[0].toLower() == "host" { found = true } }
  var built = if found { *headers } else { headers.push(("Host", place.host)) }
  var hasClose = false
  for entry in built { if entry[0].toLower() == "connection" { hasClose = true } }
  if hasClose { built } else { built.push(("Connection", "close")) }
}

fn secured(place: &Url.Url) -> Bool { place.scheme.toLower() == SECURE_SCHEME }

/// Over a connection whose contents only the two ends can read.
fn overSecured(
  place: &Url.Url,
  port: Int,
  written: Str,
  held: &Limits
) -> Result[Http.Response, ClientError] {
  let outcome = Tls.withConnection(place.host, port, fn(connection: Tls.Secured) -> Result[Bytes, Tls.TlsError] {
      Tls.sendText(&connection, written) ?
      Tls.receiveAll(&connection)
    })
  if let Err(problem) = outcome {
    Err(Unreachable(show(problem)))
  } else {
    readAnswer(&Result.unwrapOr(outcome, ByteSeq.empty()), held)
  }
}

fn overPlain(
  place: &Url.Url,
  port: Int,
  written: Str,
  held: &Limits
) -> Result[Http.Response, ClientError] {
  let outcome = Net.withConnection(place.host, port, fn(connection: Net.Connection) -> Result[Bytes, Net.NetError] {
      Net.sendText(&connection, written) ?
      Net.receiveAll(&connection)
    })
  if let Err(problem) = outcome {
    Err(Unreachable(show(problem)))
  } else {
    readAnswer(&Result.unwrapOr(outcome, ByteSeq.empty()), held)
  }
}

/// What came back, refused when it is larger than the caller will read.
///
/// Refused rather than truncated: a truncated body parses to something the
/// sender did not send, and the caller has no way to know that it did.
fn readAnswer(received: &Bytes, held: &Limits) -> Result[Http.Response, ClientError] {
  if received.length() > held.bodyBytes {
    Err(TooLarge(held.bodyBytes))
  } else {
    let text = ByteSeq.toText(received)
    if let Err(_) = text {
      Err(Malformed("the answer is not text"))
    } else {
      let parsed = Message.parseResponse(Result.unwrapOr(text, ""))
      if let Err(problem) = parsed {
        Err(Malformed(Message.explain(&problem)))
      } else {
        Ok(Result.unwrapOr(parsed, emptyResponse()))
      }
    }
  }
}

/// Whether a status says to go somewhere else.
export fn isRedirect(code: Int) -> Bool {
  Set.contains(&METHOD_DROPPING, code) || Set.contains(&METHOD_KEEPING, code)
}

/// The request that follows a redirect.
///
/// The destination is resolved against where the request went, so a relative
/// one works. Credentials are dropped when the origin changes, because the
/// caller set them for the host they named rather than for whichever host that
/// one points at.
fn redirected(request: &Http.Request, answer: &Http.Response) -> Result[Http.Request, ClientError] {
  let stated = locationOf(&answer.headers)
  if stated.isEmpty() { return Err(Malformed("a redirect with nowhere to go")) }
  let destination = resolved(request.target, stated)
  if destination.isEmpty() { return Err(BadUrl(stated)) }
  let sameOrigin = originsMatch(request.target, destination)
  Ok(
    Http.Request {
      method: methodAfter(&request.method, answer.status.code),
      target: destination,
      headers: if sameOrigin { request.headers } else { withoutCredentials(&request.headers) },
      body: if keepsBody(answer.status.code) { request.body } else { "" }
    }
  )
}

/// The method a redirect is followed with.
fn methodAfter(method: &Http.Method, code: Int) -> Http.Method {
  if Set.contains(&METHOD_KEEPING, code) { *method } else { Http.Get }
}

fn keepsBody(code: Int) -> Bool { Set.contains(&METHOD_KEEPING, code) }

fn withoutCredentials(headers: &Array[(Str, Str)]) -> Array[(Str, Str)] {
  var kept: Array[(Str, Str)] = []
  for entry in headers {
    if !Set.contains(&CREDENTIAL_HEADERS, entry[0].toLower()) { kept = kept.push(entry) }
  }
  kept
}

fn locationOf(headers: &Array[(Str, Str)]) -> Str {
  var found = ""
  for entry in headers { if entry[0].toLower() == "location" { found = entry[1].trim() } }
  found
}

/// A destination resolved against where the request went.
export fn resolved(from: Str, stated: Str) -> Str {
  if stated.startsWith("http://") || stated.startsWith("https://") {
    stated
  } else {
    if let Ok(base) = Url.parse(from) {
      let origin = base.scheme + "://" + base.host + portSuffix(&base)
      if stated.startsWith("/") { origin + stated } else { origin + "/" + stated }
    } else {
      ""
    }
  }
}

fn portSuffix(place: &Url.Url) -> Str {
  if let Some(port) = Url.effectivePort(place) {
    if Option.unwrapOr(Url.defaultPort(place.scheme.toLower()), 0) == port {
      ""
    } else {
      ":" + show(port)
    }
  } else {
    ""
  }
}

/// Whether two targets name the same origin, which is the question that
/// decides whether credentials travel.
export fn originsMatch(left: Str, right: Str) -> Bool {
  if let Ok(first) = Url.parse(left) {
    if let Ok(second) = Url.parse(right) {
      Safe.originOf(&first) == Safe.originOf(&second)
    } else {
      false
    }
  } else {
    false
  }
}

/// What a refusal says.
export fn explain(problem: &ClientError) -> Str {
  match problem {
    case BadUrl(target) => "that is not an address: " + target
    case Unreachable(reason) => "could not reach it: " + reason
    case NotPermitted(reason) => reason
    case TooManyRedirects(count) => "more than " + show(count) + " redirects"
    case TooLarge(limit) => "the answer is larger than " + show(limit) + " bytes"
    case Malformed(reason) => "the answer could not be read: " + reason
  }
}

fn emptyResponse() -> Http.Response {
  Http.Response{status: Http.Status{code: 0, reason: ""}, headers: [], body: ""}
}

fn emptyUrl() -> Url.Url {
  Url.Url{scheme: "", host: "", port: None, path: "", query: [], fragment: None}
}
