module Std.Http.Message

import Std.Bytes as ByteSeq
import Std.Http as Http
import Std.Text as Text

/// What stopped a message from being read.
export type MessageError
  = NoRequestLine
  | BadRequestLine(Str)
  | NoStatusLine
  | BadStatusLine(Str)
  | BadHeader(Str)
  | ShortBody(Int, Int)

/// A request read from the text a connection carried.
/// Line endings are accepted as `\r\n` or `\n`, because a message written by
/// hand for a test is worth reading and refusing it teaches nothing.
export fn parseRequest(source: Str) -> Result[Http.Request, MessageError] {
  let split = splitHead(source)
  let lines = headLines(split[0])
  if lines.length() == 0 { Err(NoRequestLine) } else {
    let parts = parseRequestLine(lines[0]) ?
    let headers = parseHeaders(&lines) ?
    Ok(Http.Request {
        method: Http.methodFrom(parts[0]),
        target: parts[1],
        headers: headers,
        body: split[1]
      })
  }
}

/// A request read from text where the head has already been separated from the body.
export fn parseHead(head: Str) -> Result[Http.Request, MessageError] {
  let lines = headLines(head)
  if lines.length() == 0 { Err(NoRequestLine) } else {
    let parts = parseRequestLine(lines[0]) ?
    let headers = parseHeaders(&lines) ?
    Ok(Http.Request {
        method: Http.methodFrom(parts[0]),
        target: parts[1],
        headers: headers,
        body: ""
      })
  }
}

/// A response read from the text a connection carried.
export fn parseResponse(source: Str) -> Result[Http.Response, MessageError] {
  let split = splitHead(source)
  let lines = headLines(split[0])
  if lines.length() == 0 { Err(NoStatusLine) } else {
    let status = parseStatusLine(lines[0]) ?
    let headers = parseHeaders(&lines) ?
    Ok(Http.Response{binaryBody: None, status: status, headers: headers, body: split[1]})
  }
}

/// A request written as the protocol writes it, head and body together.
export fn renderRequest(value: &Http.Request) -> Str {
  Http.renderHead(value) + value.body
}

/// A response written as the protocol writes it.
export fn renderResponse(value: &Http.Response) -> Str {
  if let Some(_) = value.binaryBody { panic("binary responses require renderResponseBytes") }
  var out = Http.renderStatusLine(&value.status) + "\r\n"
  for pair in value.headers { out = out + pair[0] + ": " + pair[1] + "\r\n" }
  out + "\r\n" + value.body
}

/// A response built from a status and a body, with the headers that describe it.
export fn respond(code: Int, mediaType: Str, body: Str) -> Http.Response {
  Http.Response {
    binaryBody: None, status: Http.status(code),
    headers: [("content-type", mediaType), ("content-length", show(body.toBytes().length()))],
    body: body
  }
}

/// A response with no body, for the statuses that carry none.
export fn respondEmpty(code: Int) -> Http.Response {
  Http.Response{binaryBody: None, status: Http.status(code), headers: [], body: ""}
}

/// A redirect to a target, with the status a caller chooses.
export fn redirect(code: Int, target: Str) -> Http.Response {
  Http.Response {
    binaryBody: None, status: Http.status(code),
    headers: [("location", target)],
    body: ""
  }
}

/// Whether a message's declared length matches the body it carried.
/// A short body is how a truncated read shows itself, and a caller reading from
/// a connection needs to tell that from a complete message.
export fn checkLength(headers: &Array[(Str, Str)], body: Str) -> Result[(), MessageError] {
  match Http.contentLength(headers) {
    case Some(declared) => {
      if body.toBytes().length() < declared { Err(ShortBody(declared, body.toBytes().length())) } else { Ok(()) }
    }
    case None => Ok(())
  }
}

/// A chunked body read back into the bytes it framed.
/// Stops at the terminating chunk, ignoring any trailer, which is what a reader
/// that only wants the body should do.
export fn decodeChunked(source: Str) -> Str {
  var out = ""
  var rest = source
  while !rest.isEmpty() {
    let lineEnd = rest.indexOf("\r\n")
    if lineEnd < 0 { return out }
    let sizeText = rest.slice(0, lineEnd).trim()
    let semicolon = sizeText.indexOf(";")
    let digits = if semicolon < 0 { sizeText } else { sizeText.slice(0, semicolon) }
    match hexOf(digits) {
      case Some(size) => {
        if size == 0 { return out }
        let from = lineEnd + 2
        let to = from + size
        if to > rest.length() { return out + rest.slice(from, rest.length()) }
        out = out + rest.slice(from, to)
        rest = rest.slice(min(to + 2, rest.length()), rest.length())
      }
      case None => { return out }
    }
  }
  out
}

/// A reader's failure explained in the terms a caller can report.
export fn explain(problem: &MessageError) -> Str {
  match problem {
    case NoRequestLine => "the message has no request line"
    case BadRequestLine(line) => "the request line is not a method, target, and version: " + line
    case NoStatusLine => "the message has no status line"
    case BadStatusLine(line) => "the status line is not a version, code, and reason: " + line
    case BadHeader(line) => "a header has no colon: " + line
    case ShortBody(declared, actual) =>
    "the body is " + show(actual) + " where " + show(declared) + " was declared"
  }
}

/// The head and the body, separated at the first blank line.
fn splitHead(source: Str) -> (Str, Str) {
  let doubled = source.indexOf("\r\n\r\n")
  if doubled >= 0 {
    (source.slice(0, doubled), source.slice(doubled + 4, source.length()))
  } else {
    let single = source.indexOf("\n\n")
    if single >= 0 {
      (source.slice(0, single), source.slice(single + 2, source.length()))
    } else { (source, "") }
  }
}

/// The head in lines, with carriage returns removed and blanks dropped.
/// Slices directly on the separator without an intermediate allocation loop.
fn headLines(head: Str) -> Array[Str] {
  let separator = if head.contains("\r\n") { "\r\n" } else { "\n" }
  let raw = head.split(separator)
  let count = raw.length()
  if count == 0 { raw } else {
    if raw[count - 1].isEmpty() { raw.slice(0, count - 1) } else { raw }
  }
}

/// A request line read into its method, target, and version.
fn parseRequestLine(line: Str) -> Result[(Str, Str, Str), MessageError] {
  let s1 = line.indexOf(" ")
  if s1 < 0 { return Err(BadRequestLine(line)) }
  let method = line.take(s1)
  let rest = line.drop(s1 + 1).trim()
  let s2 = rest.indexOf(" ")
  if s2 < 0 {
    Ok((method, rest, "HTTP/1.1"))
  } else {
    Ok((method, rest.take(s2), rest.drop(s2 + 1).trim()))
  }
}

/// A status line read into the status it names.
fn parseStatusLine(line: Str) -> Result[Http.Status, MessageError] {
  let s1 = line.indexOf(" ")
  if s1 < 0 { return Err(BadStatusLine(line)) }
  let rest = line.drop(s1 + 1).trim()
  let s2 = rest.indexOf(" ")
  let codeStr = if s2 < 0 { rest } else { rest.take(s2) }
  match Text.countOf(codeStr) {
    case Some(code) => {
      let reason = if s2 < 0 { "" } else { rest.drop(s2 + 1).trim() }
      Ok(Http.Status {
          code: code,
          reason: if reason.isEmpty() { Http.reasonFor(code) } else { reason }
        })
    }
    case None => Err(BadStatusLine(line))
  }
}

/// Header lines read into pairs, with names kept as written.
fn parseHeaders(lines: &Array[Str]) -> Result[Array[(Str, Str)], MessageError] {
  var out: Array[(Str, Str)] = []
  var index = 1
  let count = lines.length()
  while index < count {
    let line = lines[index]
    if !line.isEmpty() {
      let colon = line.indexOf(":")
      if colon < 0 { return Err(BadHeader(line)) }
      out = out.push((
          line.take(colon).trim(),
          line.drop(colon + 1).trim()
        ))
    }
    index = index + 1
  }
  Ok(out)
}

fn min(left: Int, right: Int) -> Int { if left < right { left } else { right } }

fn hexOf(text: Str) -> Option[Int] {
  if text.isEmpty() { None } else {
    var total = 0
    for character in text.toLower().chars() {
      let found = "0123456789abcdef".indexOf(character.toText())
      if found < 0 { return None }
      total = total * 16 + found
    }
    Some(total)
  }
}

/// Serialize binary payloads without a text or base64 conversion.
export fn renderResponseBytes(value: &Http.Response) -> Bytes {
  var head = Http.renderStatusLine(&value.status) + "\r\n"
  for pair in value.headers { head = head + pair[0] + ": " + pair[1] + "\r\n" }
  (head + "\r\n").toBytes().concat(Http.responseBytes(value))
}

export fn respondBytes(code: Int, mediaType: Str, payload: &Bytes) -> Http.Response {
  Http.Response{status: Http.status(code),
    headers: [("content-type", mediaType), ("content-length", show(payload.length()))],
    body: "", binaryBody: Some(*payload) }
}

/// Remove chunk framing in octets, refusing truncated or malformed data.
export fn decodeChunkedBytes(source: &Bytes, limit: Int) -> Result[Bytes, MessageError] {
  var rest = *source
  var parts: Array[Bytes] = []
  var total = 0
  loop {
    let end = rest.indexOf("\r\n".toBytes())
    if end < 0 || end > 8192 { return Err(BadHeader("invalid chunk size line")) }
    let line = match ByteSeq.toText(&rest.take(end)) {
      case Ok(value) => value
      case Err(_) => { return Err(BadHeader("invalid chunk size encoding")) }
    }
    let digits = line.split(";")[0]
    if digits.isEmpty() || digits.length() > 8 { return Err(BadHeader("invalid chunk size")) }
    let size = match hexOf(digits) {
      case Some(value) => value
      case None => { return Err(BadHeader("invalid chunk size")) }
    }
    rest = rest.drop(end + 2)
    if size == 0 {
      if rest == "\r\n".toBytes() { return Ok(ByteSeq.join(&parts)) }
      let trailerEnd = rest.indexOf("\r\n\r\n".toBytes())
      if trailerEnd < 0 || trailerEnd + 4 != rest.length() { return Err(BadHeader("incomplete chunk trailer")) }
      let trailer = match ByteSeq.toText(&rest.take(trailerEnd)) {
        case Ok(value) => value
        case Err(_) => { return Err(BadHeader("invalid chunk trailer")) }
      }
      let _headers = parseHeaders(&trailer.split("\r\n")) ?
      return Ok(ByteSeq.join(&parts))
    }
    if size > limit - total { return Err(BadHeader("chunked body exceeds limit")) }
    if size > rest.length() - 2 { return Err(ShortBody(size, rest.length())) }
    if rest.slice(size, size + 2) != "\r\n".toBytes() { return Err(BadHeader("chunk missing CRLF")) }
    parts = parts.push(rest.take(size))
    total = total + size
    rest = rest.drop(size + 2)
  }
}
