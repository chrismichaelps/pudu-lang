module Std.App.Password

import Std.Bytes as ByteSeq
import Std.Crypto as Crypto
import Std.Random as Random
import Std.Result as Result
import Std.Text as Text

/// Why a password could not be stored or checked.
export type PasswordError
  = NoEntropy
  | Unreadable(Str)
  | UnknownAlgorithm(Str)

/// What a stored form was made with.
///
/// Carried with the digest rather than held in a setting, which is the
/// decision everything else rests on: a work factor kept elsewhere cannot be
/// raised without invalidating every password already stored, so it is never
/// raised, and the number chosen at the beginning is the one still in use when
/// it is no longer enough.
export type Stored = { algorithm: Str, rounds: Int, salt: Str, digest: Str }

/// The only algorithm this writes.
///
/// Named in the stored form so a later one can be added and old passwords
/// still verify against the algorithm they were made with.
const ALGORITHM: Str = "pbkdf2-sha256"

/// How much work proving a password costs.
///
/// Raised over time as machines get faster. Because every stored form carries
/// the number it was made with, raising this does not invalidate anything: an
/// older password verifies against its own number and is remade at the next
/// successful sign-in.
const ROUNDS: Int = 210000

/// How many bytes of salt, and how many of digest.
const SALT_BYTES: Int = 16

const DIGEST_BYTES: Int = 32

/// What separates the parts of a stored form.
const SEPARATOR: Str = "$"

/// A password in the form that proves it later without holding it.
///
/// Every password gets its own salt from the machine's own entropy. A shared
/// salt means two people who chose the same password have the same digest,
/// which turns one guess into a list of accounts.
export fn store(password: Str) -> Result[Stored, PasswordError] {
  let salt = freshSalt() ?
  Ok(storeWith(password, salt, ROUNDS))
}

/// The same, with the salt and work factor given.
///
/// For a program checking that two passwords stored the same way agree, and
/// for the re-derivation that verifying is. Not for storing a password with a
/// salt somebody chose.
export fn storeWith(password: Str, salt: Str, rounds: Int) -> Stored {
  Stored {
    algorithm: ALGORITHM,
    rounds: rounds,
    salt: salt,
    digest: digestOf(password, salt, rounds)
  }
}

/// Whether a password is the one a stored form was made from.
///
/// The comparison takes the same time whatever it is given. One that returned
/// as soon as two bytes differed would take a length of time that says how
/// much of the digest was right, which is enough to find the rest a byte at a
/// time.
export fn matches(password: Str, held: &Stored) -> Bool {
  if held.algorithm != ALGORITHM {
    false
  } else {
    Crypto.secretsMatch(digestOf(password, held.salt, held.rounds), held.digest)
  }
}

/// Whether a stored form was made with weaker settings than are used now.
///
/// Asked after a password has been proved, because that is the only moment the
/// password is in hand to remake it with.
export fn needsRemaking(held: &Stored) -> Bool {
  held.algorithm != ALGORITHM || held.rounds < ROUNDS
}

/// A stored form as one piece of text, for a column or a file.
export fn render(held: &Stored) -> Str {
  [held.algorithm, show(held.rounds), held.salt, held.digest].join(SEPARATOR)
}

/// A stored form read back from that text.
///
/// A form that cannot be read is a failure rather than a form that matches
/// nothing: a password that silently never verifies looks exactly like a
/// person who forgot theirs, and the two need different answers.
export fn parse(written: Str) -> Result[Stored, PasswordError] {
  let parts = written.split(SEPARATOR)
  if parts.length() != 4 {
    Err(Unreadable(written))
  } else {
    if parts[0] != ALGORITHM {
      Err(UnknownAlgorithm(parts[0]))
    } else {
      if let Some(rounds) = Text.countOf(parts[1]) {
        if rounds == 0 || parts[2].isEmpty() || parts[3].isEmpty() {
          Err(Unreadable(written))
        } else {
          Ok(Stored{algorithm: parts[0], rounds: rounds, salt: parts[2], digest: parts[3]})
        }
      } else {
        Err(Unreadable(written))
      }
    }
  }
}

/// How much work the stored form was made with.
export fn roundsOf(held: &Stored) -> Int { held.rounds }

/// Which algorithm made it.
export fn algorithmOf(held: &Stored) -> Str { held.algorithm }

/// How much work a password stored now costs to prove.
export fn currentRounds() -> Int { ROUNDS }

/// A salt nobody can predict.
///
/// A failure to reach entropy is a failure rather than a fallback: a password
/// stored with a predictable salt is worse than one not stored at all, because
/// it looks stored.
fn freshSalt() -> Result[Str, PasswordError] {
  let drawn = Random.secureBytes(SALT_BYTES)
  if let Ok(bytes) = drawn {
    if ByteSeq.length(&bytes) == SALT_BYTES { Ok(ByteSeq.encodeBase64(&bytes)) } else { Err(NoEntropy) }
  } else {
    Err(NoEntropy)
  }
}

/// The digest a password, a salt, and a work factor produce.
fn digestOf(password: Str, salt: Str, rounds: Int) -> Str {
  let saltBytes = Result.unwrapOr(ByteSeq.decodeBase64(salt), ByteSeq.fromText(salt))
  ByteSeq.encodeBase64(&deriveKey(password.toBytes(), saltBytes, rounds, DIGEST_BYTES))
}

/// What a refusal says.
export fn explain(problem: &PasswordError) -> Str {
  match problem {
    case NoEntropy => "the machine could not supply randomness for a salt"
    case Unreadable(_written) => "that is not a stored password"
    case UnknownAlgorithm(named) => "no algorithm called " + named + " is read here"
  }
}
