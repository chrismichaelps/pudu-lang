module Std.App.Database

import Std.App as App
import Std.App.Config as Config
import Std.Db.Driver as Driver
import Std.Db.Postgres as Postgres
import Std.Db.Sqlite as Sqlite
import Std.Result as Result
import Std.Sync as Sync

/// A backend-neutral resource shared by lifecycle callbacks and handlers.
export type Database = {
  driver: Driver.Driver,
  uri: Str,
  size: Int,
  lifecycle: Sync.Mutex,
  current: Sync.Cell[Option[Driver.Client]]
}

/// Built-in connectors remain ordinary values that applications can extend.
export fn bundledDrivers() -> Array[Driver.Driver] { [Postgres.driver(), Sqlite.driver()] }

/// Select a bundled connector from the connection-string scheme.
export fn create(uri: Str, size: Int) -> Result[Database, Driver.Error] {
  withDrivers(&bundledDrivers(), uri, size)
}

/// Prepare any developer-supplied connector; sockets open during stage startup.
export fn withDriver(driver: Driver.Driver, uri: Str, size: Int) -> Result[Database, Driver.Error] {
  let selected = Driver.select(&[driver], uri) ?
  if size < 1 { return Err(Driver.error(selected.name, "configuration", "connection capacity must be positive")) }
  Ok(Database{driver: selected, uri: uri, size: size, lifecycle: Sync.mutex(), current: Sync.cell(None)})
}

/// Select a connector from an explicit set, without a process-global registry.
export fn withDrivers(drivers: &Array[Driver.Driver], uri: Str, size: Int) -> Result[Database, Driver.Error] {
  withDriver(Driver.select(drivers, uri) ?, uri, size)
}

export fn fromConfig(settings: &Config.Config, key: Str, size: Int) -> Result[Database, Driver.Error] {
  let uri = Result.mapErr(Config.require(settings, key), fn(_problem: Config.ConfigError) -> Driver.Error {
    Driver.error("", "configuration", "required database connection setting is missing or empty")
  }) ?
  create(uri, size)
}

export fn fromConfigWith(driver: Driver.Driver, settings: &Config.Config, key: Str, size: Int) -> Result[Database, Driver.Error] {
  let uri = Result.mapErr(Config.require(settings, key), fn(_problem: Config.ConfigError) -> Driver.Error {
    Driver.error(driver.name, "configuration", "required database connection setting is missing or empty")
  }) ?
  withDriver(driver, uri, size)
}

/// Add before stages that need the database; stage order determines dependency order.
export fn stage(database: &Database, name: Str) -> App.Stage {
  let resource = *database
  App.stage(name,
    fn() -> Result[(), Str] { Result.mapErr(start(&resource), describe) },
    fn() -> Result[(), Str] { Result.mapErr(stop(&resource), describe) })
}

export fn start(database: &Database) -> Result[(), Driver.Error] {
  let resource = *database
  Result.mapErr(Sync.withLock(&database.lifecycle, fn() -> Result[(), Driver.Error] {
    let current = Result.mapErr(Sync.get(&resource.current), syncError) ?
    if let Some(_) = current { return Err(Driver.error(resource.driver.name, "lifecycle", "database resource is already started")) }
    let opened = (resource.driver.open)(resource.uri, resource.size) ?
    match Sync.set(&resource.current, Some(opened)) {
      case Ok(_) => Ok(())
      case Err(problem) => {
        match Driver.close(&opened) {
          case Ok(_) => Err(syncError(problem))
          case Err(cleanup) => Err(Driver.error(resource.driver.name, "cleanup", show(problem) + "; closing client also failed: " + cleanup.message))
        }
      }
    }
  }), syncError) ?
}

/// Clear admission before closing; repeated stops are harmless.
export fn stop(database: &Database) -> Result[(), Driver.Error] {
  let resource = *database
  Result.mapErr(Sync.withLock(&database.lifecycle, fn() -> Result[(), Driver.Error] {
    let current = Result.mapErr(Sync.swap(&resource.current, None), syncError) ?
    match current {
      case None => Ok(())
      case Some(client) => Driver.close(&client)
    }
  }), syncError) ?
}

/// SQL and placeholders follow the selected driver; values are always separate.
export fn query(database: &Database, sql: Str, values: &Array[Driver.Value]) -> Result[Driver.Rows, Driver.Error] {
  let client = available(database) ?
  Driver.query(&client, sql, values)
}

export fn execute(database: &Database, sql: Str) -> Result[Driver.Rows, Driver.Error] {
  let client = available(database) ?
  Driver.execute(&client, sql)
}

fn available(database: &Database) -> Result[Driver.Client, Driver.Error] {
  let current = Result.mapErr(Sync.get(&database.current), syncError) ?
  match current {
    case None => Err(Driver.error(database.driver.name, "closed", "database resource is not started"))
    case Some(client) => Ok(client)
  }
}

fn syncError(problem: Sync.SyncError) -> Driver.Error { Driver.error("", "synchronization", show(problem)) }
fn describe(problem: Driver.Error) -> Str { problem.driver + ": " + problem.category + ": " + problem.message }
