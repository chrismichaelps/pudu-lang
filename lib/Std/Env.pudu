module Std.Env

/// The arguments the program was started with, without the program's own name.
export fn all() -> Array[Str] { arguments() }

/// The number of arguments given.
export fn count() -> Int { arguments().length() }

/// The argument at a position, or `None` when there is none.
export fn at(position: Int) -> Option[Str] {
  let given = arguments()
  if position < 0 || position >= given.length() { None } else { Some(given[position]) }
}

/// Whether an argument was given, matched exactly.
export fn hasFlag(name: Str) -> Bool { arguments().contains(name) }

/// The value given after a named argument, or `None`.
/// `--out file` and `--out=file` are both read, because both are written.
export fn option(name: Str) -> Option[Str] {
  let given = arguments()
  var index = 0
  while index < given.length() {
    let current = given[index]
    if current == name {
      if index + 1 < given.length() { return Some(given[index + 1]) } else { return None }
    }
    if current.startsWith(name + "=") {
      return Some(current.slice(name.length() + 1, current.length()))
    }
    index = index + 1
  }
  None
}

/// Every argument that is not a flag or a flag's value.
export fn positional(flagsWithValues: &Array[Str]) -> Array[Str] {
  let given = arguments()
  var out = []
  var index = 0
  var skipNext = false
  while index < given.length() {
    let current = given[index]
    if skipNext { skipNext = false } else {
      if flagsWithValues.contains(current) { skipNext = true } else {
        if !current.startsWith("-") { out = out.push(current) }
      }
    }
    index = index + 1
  }
  out
}

/// Every environment variable as a name and a value.
export fn variables() -> Array[(Str, Str)] { environment() }

/// One environment variable, or `None` when it is not set.
export fn variable(name: Str) -> Option[Str] {
  for pair in environment() {
    if pair[0] == name { return Some(pair[1]) }
  }
  None
}

/// One environment variable, or a fallback when it is not set.
export fn variableOr(name: Str, fallback: Str) -> Str {
  match variable(name) {
    case Some(found) => found
    case None => fallback
  }
}

/// Whether an environment variable is set at all, whatever its value.
export fn isSet(name: Str) -> Bool {
  match variable(name) {
    case Some(_) => true
    case None => false
  }
}

/// The program's search path, split on the separator its platform uses.
///
/// The separator is asked for rather than written down: it is a colon on one
/// family of operating system and a semicolon on the other, so a program that
/// splits on a colon reads the whole of `PATH` as a single entry everywhere
/// else.
export fn searchPath() -> Array[Str] {
  match variable("PATH") {
    case Some(found) => found.split(searchSeparator())
    case None => []
  }
}

/// The directory this machine calls the reader's own, when it has one.
///
/// Asked of the machine rather than of one variable. `HOME` is the name one
/// family of operating system uses and `USERPROFILE` is the other's, and a
/// program that asked only for the first answered `None` on a machine that has
/// a home directory and a different word for it.
export fn homeDirectory() -> Option[Str] { userHome() }

/// Where this machine says a program may put a file it does not intend to keep.
///
/// The answer is the machine's, not the program's: it honours `TMPDIR` where
/// that is set, and names the system's own directory where it is not. A program
/// that writes `/tmp` directly has stated one machine's answer as though it
/// were every machine's, and will not run where that path does not exist.
///
/// The directory is where a file may go, not a file — a caller that needs one
/// joins a name it chose onto it, and one that may run twice at once chooses a
/// name that cannot collide.
export fn temporaryDirectory() -> Str { temporaryPath() }

/// Stop the program with a status. Nought means it succeeded.
export fn stop(status: Int) -> () { exit(status) }

/// Stop the program reporting success.
export fn succeed() -> () { exit(0) }

/// Stop the program reporting failure, after writing a message.
export fn fail(message: Str) -> () {
  match printError(message) {
    case Ok(_) => {}
    case Err(_) => {}
  }
  exit(1)
}

/// Milliseconds on a clock that only moves forward.
/// Two readings may be subtracted; one alone means nothing, which is why this
/// is not called the time.
export fn elapsedMilliseconds() -> Int { clock() }
