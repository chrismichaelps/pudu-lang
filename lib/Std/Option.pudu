module Std.Option

/// Whether a value is present.
export fn isSome[T](value: &Option[T]) -> Bool {
  match value {
    case Some(_) => true
    case None => false
  }
}

/// Whether a value is absent.
export fn isNone[T](value: &Option[T]) -> Bool {
  match value {
    case Some(_) => false
    case None => true
  }
}

/// The value, or a fallback when there is none.
/// There is no `unwrap` that panics: nothing in `Std` is partial, and a caller
/// who has no fallback wants `okOr` and the failure that goes with it.
export fn unwrapOr[T](value: Option[T], fallback: T) -> T {
  match value {
    case Some(found) => found
    case None => fallback
  }
}

/// The value as an array of nought or one element, which is how a caller
/// iterates over a maybe-absent value without matching on it.
export fn toArray[T](value: Option[T]) -> Array[T] {
  match value {
    case Some(found) => [found]
    case None => []
  }
}

/// The first value if it is present, otherwise the second.
export fn orElse[T](first: Option[T], second: Option[T]) -> Option[T] {
  match first {
    case Some(found) => Some(found)
    case None => second
  }
}

/// A present value, or a declared failure when there is none.
/// This is the bridge from "might be absent" to "explains why", and it is the
/// only honest way to leave `Option` behind.
export fn okOr[T, E](value: Option[T], failure: E) -> Result[T, E] {
  match value {
    case Some(found) => Ok(found)
    case None => Err(failure)
  }
}

/// The value, or a fallback computed only when there is none.
/// The fallback is a function so it runs only when it is needed, which matters
/// when computing it is expensive or can itself fail.
export fn unwrapOrElse[T](value: Option[T], fallback: fn() -> T) -> T {
  match value {
    case Some(found) => found
    case None => fallback()
  }
}

/// The value transformed, if there is one.
export fn map[A, B](value: Option[A], transform: fn(A) -> B) -> Option[B] {
  match value {
    case Some(found) => Some(transform(found))
    case None => None
  }
}

/// The value transformed into another option, flattened.
export fn andThen[A, B](value: Option[A], transform: fn(A) -> Option[B]) -> Option[B] {
  match value {
    case Some(found) => transform(found)
    case None => None
  }
}

/// The value if it is present and the predicate accepts it.
export fn keepIf[T](value: Option[T], accept: fn(T) -> Bool) -> Option[T] {
  match value {
    case Some(found) => if accept(found) { Some(found) } else { None }
    case None => None
  }
}

/// The result of transforming the value, or a fallback when there is none.
/// The arguments are in the order a reader meets them: the value, what to do
/// with it, and what to do without it.
export fn fold[A, B](value: Option[A], transform: fn(A) -> B, fallback: B) -> B {
  match value {
    case Some(found) => transform(found)
    case None => fallback
  }
}

/// Whether the value is present and the predicate accepts it.
export fn holds[T](value: &Option[T], predicate: fn(T) -> Bool) -> Bool {
  match value {
    case Some(found) => predicate(found)
    case None => false
  }
}

/// A nested option flattened by one level.
export fn flatten[T](value: Option[Option[T]]) -> Option[T] {
  match value {
    case Some(found) => found
    case None => None
  }
}

/// Every present value, with the absent ones dropped.
export fn present[T](values: &Array[Option[T]]) -> Array[T] {
  var out = []
  for value in values {
    match value {
      case Some(found) => { out = out.push(found) }
      case None => { }
    }
  }
  out
}

/// Two options paired, present only when both are.
export fn zip[A, B](left: Option[A], right: Option[B]) -> Option[(A, B)] {
  match left {
    case Some(first) => match right {
      case Some(second) => Some((first, second))
      case None => None
    }
    case None => None
  }
}
