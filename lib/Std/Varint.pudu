module Std.Varint

/// Decoded unsigned 64-bit varint value and the number of bytes consumed.
export type VarintDecodeResult = {
  value: UInt64,
  bytesRead: Int,
}

/// Decoded signed 64-bit varint value and the number of bytes consumed.
export type SignedVarintDecodeResult = {
  value: Int,
  bytesRead: Int,
}

fn toByte(v: UInt64) -> UInt8 {
  match convertInteger[UInt8](v & 0xffu64) {
    case Some(b) => b
    case None => 0u8
  }
}

fn byteToUInt64(b: UInt8) -> UInt64 {
  match convertInteger[UInt64](b) {
    case Some(u) => u
    case None => 0u64
  }
}

/// Computes the exact number of bytes required to encode `value` in ULEB128.
export fn encodedLengthUleb128(value: UInt64) -> Int {
  if value == 0u64 {
    return 1
  }
  var len = 0
  var v = value
  while v != 0u64 {
    len = len + 1
    v = v >> 7
  }
  len
}

/// Encodes an unsigned 64-bit integer into little-endian LEB128 bytes.
export fn encodeUleb128(value: UInt64) -> Array[UInt8] {
  var out: Array[UInt8] = []
  var v = value
  var more = true
  while more {
    var byteVal = v & 0x7fu64
    v = v >> 7
    if v != 0u64 {
      byteVal = byteVal | 0x80u64
    } else {
      more = false
    }
    out = out.push(toByte(byteVal))
  }
  out
}

/// Decodes an unsigned 64-bit integer from LEB128 bytes starting at `offset`.
export fn decodeUleb128(bytes: &Array[UInt8], offset: Int) -> Option[VarintDecodeResult] {
  let len = bytes.length()
  if offset < 0 || offset >= len {
    return None
  }
  var result = 0u64
  var shift = 0
  var i = offset
  var count = 0
  var done = false
  while !done && i < len && count < 10 {
    let b = bytes[i]
    let u = byteToUInt64(b)
    let chunk = u & 0x7fu64
    if shift > 63 {
      return None
    }
    result = result | (chunk << shift)
    count = count + 1
    i = i + 1
    shift = shift + 7
    if (u & 0x80u64) == 0u64 {
      done = true
    }
  }
  if !done {
    return None
  }
  Some(VarintDecodeResult {
      value: result,
      bytesRead: count,
    })
}

/// Maps a signed 64-bit integer to an unsigned 64-bit ZigZag representation.
export fn toZigZag(value: Int) -> UInt64 {
  if value >= 0 {
    match convertInteger[UInt64](value) {
      case Some(u) => u &* 2u64
      case None => 0u64
    }
  } else {
    let posMinus1 = -(value + 1)
    match convertInteger[UInt64](posMinus1) {
      case Some(u) => (u &* 2u64) &+ 1u64
      case None => 0u64
    }
  }
}

/// Reverses a ZigZag-encoded unsigned 64-bit integer back to a signed integer.
export fn fromZigZag(value: UInt64) -> Int {
  let isOdd = (value & 1u64) == 1u64
  let half = value >> 1
  let i = match convertInteger[Int](half) {
    case Some(v) => v
    case None => 0
  }
  if isOdd {
    (-i) - 1
  } else {
    i
  }
}

/// Encodes a signed 64-bit integer using ZigZag LEB128 encoding.
export fn encodeSleb128(value: Int) -> Array[UInt8] {
  encodeUleb128(toZigZag(value))
}

/// Decodes a signed 64-bit integer from ZigZag LEB128 bytes starting at `offset`.
export fn decodeSleb128(bytes: &Array[UInt8], offset: Int) -> Option[SignedVarintDecodeResult] {
  let res = decodeUleb128(bytes, offset) ?
  Some(SignedVarintDecodeResult {
      value: fromZigZag(res.value),
      bytesRead: res.bytesRead,
    })
}
