module Std.Math

/// The smaller of two values.
export fn min(left: Int, right: Int) -> Int {
  if left < right { left } else { right }
}

/// The larger of two values.
export fn max(left: Int, right: Int) -> Int {
  if left > right { left } else { right }
}

/// The distance of a value from zero.
export fn abs(value: Int) -> Int {
  if value < 0 { 0 - value } else { value }
}

/// Confine a value to a range, inclusive at both ends.
/// A range whose lower bound exceeds its upper bound yields the lower bound,
/// which is the only answer that satisfies neither caller silently.
export fn clamp(value: Int, lower: Int, upper: Int) -> Int {
  if value < lower { lower } else { min(value, upper) }
}

/// The sign of a value: -1, 0, or 1.
export fn signum(value: Int) -> Int {
  if value > 0 { 1 } else { if value < 0 { 0 - 1 } else { 0 } }
}

/// The greatest common divisor, by Euclid's algorithm.
/// The result is never negative, so it can be used as a divisor without a
/// caller having to check its sign.
export fn gcd(left: Int, right: Int) -> Int {
  var remaining = abs(right)
  var current = abs(left)
  while remaining != 0 {
    let next = current % remaining
    current = remaining
    remaining = next
  }
  current
}

/// The least common multiple. Zero with either argument zero, since no positive
/// multiple of zero exists.
export fn lcm(left: Int, right: Int) -> Int {
  if left == 0 { 0 } else { if right == 0 { 0 } else { abs(left / gcd(left, right) * right) } }
}

/// A value raised to a non-negative power, by repeated squaring.
/// A negative exponent yields 1, matching integer exponentiation everywhere
/// else: the true answer is not an Int, and this signature promises one.
export fn pow(base: Int, exponent: Int) -> Int {
  var result = 1
  var remaining = exponent
  var factor = base
  while remaining > 0 {
    if remaining % 2 == 1 { result = result * factor } else { }
    factor = factor * factor
    remaining = remaining / 2
  }
  result
}

/// Whether a value divides another with no remainder.
export fn divides(divisor: Int, value: Int) -> Bool {
  if divisor == 0 { false } else { value % divisor == 0 }
}

/// Whether a value is even.
export fn isEven(value: Int) -> Bool { value % 2 == 0 }

/// Whether a value is odd.
export fn isOdd(value: Int) -> Bool { value % 2 != 0 }

/// The next whole number.
export fn succ(value: Int) -> Int { value + 1 }

/// The previous whole number.
export fn pred(value: Int) -> Int { value - 1 }

/// One value taken from another, with the arguments in the order a reader
/// meets them: `subtract(3, 10)` is seven.
export fn subtract(amount: Int, value: Int) -> Int { value - amount }

/// Truncating division, or `None` when the divisor is nought.
/// Nothing in `Std` is partial: the operator fails at run time, and this is the
/// form that reports the failure instead.
export fn divide(value: Int, divisor: Int) -> Option[Int] {
  if divisor == 0 { None } else { Some(value / divisor) }
}

/// The remainder of a truncating division, or `None` for a nought divisor.
export fn remainder(value: Int, divisor: Int) -> Option[Int] {
  if divisor == 0 { None } else { Some(value % divisor) }
}

/// The quotient and the remainder together, or `None` for a nought divisor.
export fn divMod(value: Int, divisor: Int) -> Option[(Int, Int)] {
  if divisor == 0 { None } else { Some((value / divisor, value % divisor)) }
}

/// A value squared.
export fn square(value: Int) -> Int { value * value }

/// A value cubed.
export fn cube(value: Int) -> Int { value * value * value }

/// The product of every whole number from one up to the value.
/// A value below one has an empty product, which is one.
export fn factorial(value: Int) -> Int {
  var total = 1
  var current = 2
  while current <= value {
    total = total * current
    current = current + 1
  }
  total
}

/// The greatest whole number whose square does not exceed the value.
/// Newton's method on whole numbers; a negative value has no square root and
/// answers with `None` rather than a number that is not one.
export fn isqrt(value: Int) -> Option[Int] {
  if value < 0 { None } else {
    if value < 2 { Some(value) } else {
      var guess = value
      var next = (value + 1) / 2
      while next < guess {
        guess = next
        next = (guess + value / guess) / 2
      }
      Some(guess)
    }
  }
}

/// Whether a value is prime. Values below two are not.
export fn isPrime(value: Int) -> Bool {
  if value < 2 { false } else {
    if value < 4 { true } else {
      if value % 2 == 0 { false } else {
        var divisor = 3
        while divisor * divisor <= value {
          if value % divisor == 0 { return false }
          divisor = divisor + 2
        }
        true
      }
    }
  }
}

/// Whether a value lies between two bounds, inclusive at both ends.
export fn between(value: Int, lower: Int, upper: Int) -> Bool {
  value >= lower && value <= upper
}

/// The smaller of two values, chosen by a comparison the caller supplies.
export fn minBy[T](left: T, right: T, before: fn(T, T) -> Bool) -> T {
  if before(right, left) { right } else { left }
}

/// The larger of two values, chosen by a comparison the caller supplies.
export fn maxBy[T](left: T, right: T, before: fn(T, T) -> Bool) -> T {
  if before(left, right) { right } else { left }
}

/// A value raised to a power, or `None` when the exponent is negative.
/// The total companion to `pow`, which answers one for a negative exponent
/// because its signature promises an `Int`.
export fn checkedPow(base: Int, exponent: Int) -> Option[Int] {
  if exponent < 0 { None } else { Some(pow(base, exponent)) }
}

/// The number of decimal digits, counting a lone nought as one and ignoring a
/// minus sign.
export fn digitCount(value: Int) -> Int {
  var remaining = abs(value)
  var total = 1
  while remaining >= 10 {
    remaining = remaining / 10
    total = total + 1
  }
  total
}
