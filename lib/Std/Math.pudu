module Std.Math

import Std.Num {Add, Div, Mul, One, Rem, Sub, Zero, small, two}
import Std.Order {Ord}

/// The smaller of two values.
export fn min[T: Ord](left: T, right: T) -> T {
  if right.before(&left) { right } else { left }
}

/// The larger of two values.
export fn max[T: Ord](left: T, right: T) -> T {
  if left.before(&right) { right } else { left }
}

/// The distance of a value from zero.
/// An unsigned type is its own distance, which is what makes this correct
/// rather than merely defined for one.
export fn abs[T: Ord + Zero + Sub](value: T) -> T {
  if value.before(&value.zero()) { value.zero().minus(&value) } else { value }
}

/// Confine a value to a range, inclusive at both ends.
/// A range whose lower bound exceeds its upper yields the lower bound, which is
/// the only answer that satisfies neither caller silently.
export fn clamp[T: Ord](value: T, lower: T, upper: T) -> T {
  if value.before(&lower) { lower } else { min(value, upper) }
}

/// Whether a value lies between two bounds, inclusive at both ends.
export fn between[T: Ord](value: T, lower: T, upper: T) -> Bool {
  !value.before(&lower) && !upper.before(&value)
}

/// The sign of a value: -1, 0, or 1, in the value's own type.
/// An unsigned type never answers -1, because it has no such value.
export fn signum[T: Ord + Zero + One + Sub](value: T) -> T {
  if value.zero().before(&value) { value.one() } else {
    if value.before(&value.zero()) { value.zero().minus(&value.one()) } else { value.zero() }
  }
}

/// The next value.
export fn succ[T: One + Add](value: T) -> T { value.plus(&value.one()) }

/// The previous value.
export fn pred[T: One + Sub](value: T) -> T { value.minus(&value.one()) }

/// One value taken from another, with the arguments in the order a reader meets
/// them: `subtract(3, 10)` is seven.
export fn subtract[T: Sub](amount: T, value: T) -> T { value.minus(&amount) }

/// Truncating division, or `None` when the divisor is nought.
/// Nothing in `Std` is partial: the operator reports at run time, and this is
/// the form that reports as a value instead.
export fn divide[T: Div](value: T, divisor: T) -> Option[T] { value.dividedBy(&divisor) }

/// The remainder of a truncating division, or `None` for a nought divisor.
export fn remainder[T: Rem](value: T, divisor: T) -> Option[T] {
  value.remainderOf(&divisor)
}

/// The quotient and the remainder together, or `None` for a nought divisor.
export fn divMod[T: Div + Rem](value: T, divisor: T) -> Option[(T, T)] {
  match value.dividedBy(&divisor) {
    case None => None
    case Some(quotient) => {
      match value.remainderOf(&divisor) {
        case Some(rest) => Some((quotient, rest))
        case None => None
      }
    }
  }
}

/// Whether a value divides another with no remainder. Nought divides nothing.
export fn divides[T: Rem + Zero + Ord](divisor: T, value: T) -> Bool {
  match value.remainderOf(&divisor) {
    case Some(rest) => !rest.before(&rest.zero()) && !rest.zero().before(&rest)
    case None => false
  }
}

/// Whether a value is even.
export fn isEven[T: Rem + Zero + One + Add + Ord](value: T) -> Bool {
  divides(two(&value), value)
}

/// Whether a value is odd.
export fn isOdd[T: Rem + Zero + One + Add + Ord](value: T) -> Bool { !isEven(value) }

/// A value squared.
export fn square[T: Mul](value: T) -> T { value.times(&value) }

/// A value cubed.
export fn cube[T: Mul](value: T) -> T { value.times(&value).times(&value) }

/// A value raised to a non-negative power, by repeated squaring.
/// A negative exponent yields one, matching integer exponentiation everywhere
/// else: the true answer is not a whole number, and this signature promises one.
/// The exponent is a plain count, because it says how many times rather than
/// naming a value of the base's type.
export fn pow[T: One + Mul](base: T, exponent: Int) -> T {
  var result = base.one()
  var remaining = exponent
  var factor = base
  while remaining > 0 {
    if remaining % 2 == 1 { result = result.times(&factor) }
    factor = factor.times(&factor)
    remaining = remaining / 2
  }
  result
}

/// A value raised to a power, or `None` when the exponent is negative.
/// The total companion to `pow`, which answers one for a negative exponent
/// because its signature promises a value of the base's type.
export fn checkedPow[T: One + Mul](base: T, exponent: Int) -> Option[T] {
  if exponent < 0 { None } else { Some(pow(base, exponent)) }
}

/// The greatest common divisor, by Euclid's algorithm.
/// The result is never negative, so it can be used as a divisor without a
/// caller having to check its sign.
export fn gcd[T: Ord + Zero + One + Add + Sub + Rem](left: T, right: T) -> T {
  var remaining = abs(right)
  var current = abs(left)
  while !isZero(&remaining) {
    match current.remainderOf(&remaining) {
      case Some(next) => {
        current = remaining
        remaining = next
      }
      case None => { return current }
    }
  }
  current
}

/// The least common multiple. Nought with either argument nought, since no
/// positive multiple of nought exists.
export fn lcm[T: Ord + Zero + One + Add + Sub + Mul + Div + Rem](left: T, right: T) -> T {
  if isZero(&left) || isZero(&right) { left.zero() } else {
    match left.dividedBy(&gcd(left, right)) {
      case Some(reduced) => abs(reduced.times(&right))
      case None => left.zero()
    }
  }
}

/// The product of every whole number from one up to the value.
/// A value below one has an empty product, which is one.
export fn factorial[T: Ord + Zero + One + Add + Mul](value: T) -> T {
  var total = value.one()
  var current = two(&value)
  while !value.before(&current) {
    total = total.times(&current)
    current = current.plus(&current.one())
  }
  total
}

/// The greatest value whose square does not exceed the given one.
/// Newton's method on whole numbers; a negative value has no square root and
/// answers `None` rather than a number that is not one.
export fn isqrt[T: Ord + Zero + One + Add + Div](value: T) -> Option[T] {
  if value.before(&value.zero()) { None } else {
    if value.before(&two(&value)) { Some(value) } else {
      var guess = value
      var next = halve(value.plus(&value.one()))
      while next.before(&guess) {
        guess = next
        match value.dividedBy(&guess) {
          case Some(quotient) => { next = halve(guess.plus(&quotient)) }
          case None => { return Some(guess) }
        }
      }
      Some(guess)
    }
  }
}

/// Whether a value is prime. Values below two are not.
export fn isPrime[T: Ord + Zero + One + Add + Mul + Rem](value: T) -> Bool {
  let one = value.one()
  let twoOf = two(&value)
  if value.before(&twoOf) { false } else {
    if value.before(&small(&value, 4)) { true } else {
      if divides(twoOf, value) { false } else {
        var divisor = small(&value, 3)
        while !value.before(&divisor.times(&divisor)) {
          if divides(divisor, value) { return false }
          divisor = divisor.plus(&twoOf)
        }
        true
      }
    }
  }
}

/// The number of decimal digits, counting a lone nought as one and ignoring a
/// sign.
export fn digitCount[T: Ord + Zero + One + Add + Sub + Div](value: T) -> Int {
  let ten = small(&value, 10)
  var remaining = abs(value)
  var total = 1
  while !remaining.before(&ten) {
    match remaining.dividedBy(&ten) {
      case Some(next) => { remaining = next }
      case None => { return total }
    }
    total = total + 1
  }
  total
}

/// The smaller of two values, chosen by a comparison the caller supplies.
export fn minBy[T](left: T, right: T, before: fn(T, T) -> Bool) -> T {
  if before(right, left) { right } else { left }
}

/// The larger of two values, chosen by a comparison the caller supplies.
export fn maxBy[T](left: T, right: T, before: fn(T, T) -> Bool) -> T {
  if before(left, right) { right } else { left }
}

/// Whether a value is nought, under its own ordering.
fn isZero[T: Ord + Zero](value: &T) -> Bool {
  !value.before(&value.zero()) && !value.zero().before(value)
}

/// A value halved, which every algorithm here needs and none of them names.
fn halve[T: Zero + One + Add + Div](value: T) -> T {
  match value.dividedBy(&two(&value)) {
    case Some(found) => found
    case None => value
  }
}
