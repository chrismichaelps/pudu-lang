module MultiMap
import Std.MultiMap as MultiMap
fn size() -> Int { 640000 }
fn u64(v: Int) -> UInt64 {
  match convertInteger[UInt64](v) {
    case Some(x) => x
    case None => 0u64
  }
}
fn main() -> Int {
  let n = size()
  var hits = 0
  var m: MultiMap.MultiMap[Int, Int] = MultiMap.empty()
  var i = 0
  while i < n {
    m = MultiMap.add(&m, i % 100, i)
    i = i + 1 }
  i = 0
  while i < n { if MultiMap.contains(&m, i % 100, i) { hits = hits + 1 }
    i = i + 1 }
  print(display(hits))
  0
}
