module Iterate
fn main() -> Int {
  var items: Array[Int] = []
  var i = 0
  while i < 200000 {
    items = items.push(i % 13)
    i = i + 1
  }
  var total = 0
  for value in items {
    if let Some(found) = Some(value) { total = total + found }
  }
  var j = 0
  while j < 200000 {
    total = total + items[j]
    j = j + 1
  }
  print(display(total))
  0
}
