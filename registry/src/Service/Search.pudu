module Service.Search

import Std.List as List
import Domain.Name as Name
import Domain.Project as Project
import Store.Files as Files
import Store.Projects as Projects

/// Results on one page of a search.
export const PAGE_SIZE: Int = 20

/// One page of results and the number of matches on every page.
export type Results = { projects: Array[Project.Project], total: Int }

/// Rank of a project for a query: 0 an exact name, 1 the handle, 2 a name
/// containing the query or one edit from it, 3 every word found in the description or keywords,
/// and -1 no match. An empty query ranks everything 3.
fn rank(project: &Project.Project, query: Str) -> Int {
  let wanted = query.trim().toLower()
  if wanted.isEmpty() { return 3 }
  let full = Name.render(&project.name)
  if wanted == full || wanted == project.name.name { return 0 }
  if wanted == "@" + project.name.handle || wanted == project.name.handle { return 1 }
  if project.name.name.contains(wanted) || Name.closeTo(project.name.name, wanted) { return 2 }
  let text = (project.description + " " + project.keywords.join(" ")).toLower()
  for word in wanted.split(" ") {
    if !word.isEmpty() && !text.contains(word) { return -1 }
  }
  3
}

/// Public, listed projects matching a query, best first, then by name.
export fn search(store: &Files.Store, query: Str, page: Int) -> Results {
  var ranked: Array[(Int, Project.Project)] = []
  for project in Projects.all(store) {
    if Project.isPublic(&project) && !project.unlisted {
      let score = rank(&project, query)
      if score >= 0 { ranked = ranked.push((score, project)) }
    }
  }
  let ordered = List.sortBy(&ranked, fn(left: (Int, Project.Project), right: (Int, Project.Project)) -> Bool {
      if left[0] != right[0] { left[0] < right[0] } else { Name.render(&left[1].name) < Name.render(&right[1].name) }
    })
  let first = (if page < 1 { 0 } else { page - 1 }) * PAGE_SIZE
  var shown: Array[Project.Project] = []
  for pair in ordered.slice(first, first + PAGE_SIZE) { shown = shown.push(pair[1]) }
  Results{projects: shown, total: ordered.length()}
}
