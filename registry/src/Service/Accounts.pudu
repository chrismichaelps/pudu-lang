module Service.Accounts

import Std.App.Password as Password
import Domain.Name as Name
import Store.Accounts as Accounts
import Store.Files as Files

/// Shortest password an account may have, in characters.
export const PASSWORD_MINIMUM: Int = 10

/// Create an account. The handle must be a valid, unreserved, unused segment.
export fn signUp(store: &Files.Store, handle: Str, password: Str, displayName: Str) -> Result[Accounts.Account, Str] {
  if !Name.validSegment(handle) { return Err("\"" + handle + "\" is not a valid handle: use lowercase letters, digits, and single hyphens") }
  if Name.reservedHandle(handle) { return Err("@" + handle + " is reserved") }
  if password.length() < PASSWORD_MINIMUM { return Err("a password needs at least " + show(PASSWORD_MINIMUM) + " characters") }
  if let Some(_) = Accounts.load(store, handle) ? { return Err("@" + handle + " is taken") }
  let stored = match Password.store(password) {
    case Ok(held) => held
    case Err(problem) => { return Err(Password.explain(&problem)) }
  }
  let account = Accounts.Account {
    handle: handle,
    displayName: if displayName.isEmpty() { handle } else { displayName },
    password: Password.render(&stored),
    totpSecret: "",
    totpLastStep: -1,
    tokens: []
  }
  Accounts.save(store, &account) ?
  Ok(account)
}

/// The account when the password is its own.
export fn signIn(store: &Files.Store, handle: Str, password: Str) -> Result[Accounts.Account, Str] {
  let refused = "the handle or password is not right"
  let Some(account) = Accounts.load(store, handle) ? else { return Err(refused) }
  match Password.parse(account.password) {
    case Ok(held) => if Password.matches(password, &held) { Ok(account) } else { Err(refused) }
    case Err(_) => Err(refused)
  }
}
