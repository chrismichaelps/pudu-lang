module Service.Auth

import Std.Crypto as Crypto
import Std.Json as Json
import Std.Option as Option
import Domain.Name as Name
import Service.Clock as Clock
import Service.GitHub as GitHub
import Store.Files as Files

/// How long the account a token belongs to is remembered, in milliseconds.
export const REMEMBER_MILLIS: Int = 300000

/// The GitHub account a request acts for, and the token it came with.
export type Viewer = { login: Str, token: Str }

fn cachePath(store: &Files.Store, token: Str) -> Str { store.root + "/cache/viewers/" + Crypto.sha256Hex(token) + ".json" }

/// The token of an `Authorization: Bearer <token>` header value.
export fn tokenOf(authorization: Option[Str]) -> Str {
  let header = Option.unwrapOr(authorization, "").trim()
  if header.startsWith("Bearer ") { header.drop(7).trim() } else { "" }
}

/// The GitHub account a token belongs to, asked of GitHub at most once every
/// `REMEMBER_MILLIS` per token. Only the digest of the token is written.
export fn viewerOf(store: &Files.Store, github: &GitHub.GitHub, authorization: Option[Str]) -> Option[Viewer] {
  let token = tokenOf(authorization)
  if token.isEmpty() { return None }
  let path = cachePath(store, token)
  if let Ok(Some(cached)) = Files.readJson(path) {
    let login = Option.unwrapOr(Option.andThen(Json.field(&cached, "login"), |held: Json.Json| Json.asText(&held)), "")
    let until = Option.unwrapOr(Option.andThen(Json.field(&cached, "until"), |held: Json.Json| Json.asInt(&held)), 0)
    if !login.isEmpty() && until > Clock.millis() { return Some(Viewer{login: login, token: token}) }
  }
  match github.user(token) {
    case Ok(profile) => {
      let _remembered = Files.writeJson(path, &Json.object(&[("login", Json.Text(profile.login)), ("until", Json.Number(Clock.millis() + REMEMBER_MILLIS))]))
      Some(Viewer{login: profile.login, token: token})
    }
    case Err(_) => None
  }
}

/// The token a viewer carries, or the empty text for none.
export fn tokenFor(viewer: &Option[Viewer]) -> Str {
  match *viewer {
    case Some(held) => held.token
    case None => ""
  }
}

/// The repository behind a package as the viewer's token sees it.
export fn repositoryFor(github: &GitHub.GitHub, viewer: &Option[Viewer], package: &Name.PackageName) -> Result[Option[GitHub.Repository], Str] {
  github.repository(tokenFor(viewer), package.handle, package.name)
}
