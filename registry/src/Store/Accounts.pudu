module Store.Accounts

import Std.Io as Io
import Std.Json as Json
import Std.Option as Option
import Store.Files as Files

/// A token as the registry keeps it: the SHA-256 of the secret, never the
/// secret, so a copy of the store lets nobody publish.
export type Token = { digest: Str, access: Str, label: Str, createdAt: Str }

/// An account. `password` is the rendered salted digest `Std.App.Password`
/// makes; `totpSecret` is empty until a second factor is set up, and
/// `totpLastStep` is the last code accepted, so a code is never accepted twice.
export type Account = {
  handle: Str,
  displayName: Str,
  password: Str,
  totpSecret: Str,
  totpLastStep: Int,
  tokens: Array[Token]
}

fn tokenJson(token: &Token) -> Json.Json {
  Json.object(&[
      ("digest", Json.Text(token.digest)),
      ("scope", Json.Text(token.access)),
      ("label", Json.Text(token.label)),
      ("createdAt", Json.Text(token.createdAt))
    ])
}

export fn toJson(account: &Account) -> Json.Json {
  Json.object(&[
      ("handle", Json.Text(account.handle)),
      ("displayName", Json.Text(account.displayName)),
      ("password", Json.Text(account.password)),
      ("totpSecret", Json.Text(account.totpSecret)),
      ("totpLastStep", Json.Number(account.totpLastStep)),
      ("tokens", Json.list(&account.tokens.map(|token: Token| tokenJson(&token))))
    ])
}

fn text(value: &Json.Json, key: Str) -> Str {
  Option.unwrapOr(Option.andThen(Json.field(value, key), |held: Json.Json| Json.asText(&held)), "")
}

fn tokenFrom(item: &Json.Json) -> Token {
  Token{digest: text(item, "digest"), access: text(item, "scope"), label: text(item, "label"), createdAt: text(item, "createdAt")}
}

fn fromJson(value: &Json.Json) -> Account {
  let listed = Option.unwrapOr(Option.andThen(Json.field(value, "tokens"), |held: Json.Json| Json.asList(&held)), [])
  var tokens: Array[Token] = []
  for item in listed { tokens = tokens.push(tokenFrom(&item)) }
  Account {
    handle: text(value, "handle"),
    displayName: text(value, "displayName"),
    password: text(value, "password"),
    totpSecret: text(value, "totpSecret"),
    totpLastStep: Option.unwrapOr(Option.andThen(Json.field(value, "totpLastStep"), |held: Json.Json| Json.asInt(&held)), -1),
    tokens: tokens
  }
}

export fn load(store: &Files.Store, handle: Str) -> Result[Option[Account], Str] {
  match Files.readJson(Files.accountPath(store, handle)) ? {
    case Some(value) => Ok(Some(fromJson(&value)))
    case None => Ok(None)
  }
}

export fn save(store: &Files.Store, account: &Account) -> Result[(), Str] {
  Files.writeJson(Files.accountPath(store, account.handle), &toJson(account))
}

/// Every handle with an account.
export fn handles(store: &Files.Store) -> Array[Str] {
  var found: Array[Str] = []
  for name in Files.children(store.root + "/accounts") {
    if name.endsWith(".json") { found = found.push(name.take(name.length() - 5)) }
  }
  found
}

/// The handle and scope a token digest belongs to, from `tokens/<digest>.json`.
export fn tokenOwner(store: &Files.Store, digest: Str) -> Result[Option[(Str, Str)], Str] {
  match Files.readJson(Files.tokenPath(store, digest)) ? {
    case Some(value) => Ok(Some((text(&value, "handle"), text(&value, "scope"))))
    case None => Ok(None)
  }
}

/// Record which account and scope a token digest belongs to.
export fn indexToken(store: &Files.Store, digest: Str, handle: Str, access: Str) -> Result[(), Str] {
  Files.writeJson(Files.tokenPath(store, digest), &Json.object(&[("handle", Json.Text(handle)), ("scope", Json.Text(access))]))
}

/// Forget a token digest.
export fn unindexToken(store: &Files.Store, digest: Str) -> Result[(), Str] {
  Io.removeIfPresent(Files.tokenPath(store, digest)) ?
  Ok(())
}
