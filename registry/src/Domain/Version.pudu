module Domain.Version

import Std.Text as Text

/// A release version: three numbers and an optional pre-release label.
export type Version = { major: Int, minor: Int, patch: Int, pre: Array[Str] }

/// Read `MAJOR.MINOR.PATCH` with an optional `-pre.release` label. Build
/// metadata is refused: two archives would share one version.
export fn parse(text: Str) -> Result[Version, Str] {
  if text.contains("+") { return Err("\"{text}\" carries build metadata, which a release version may not") }
  let dash = text.indexOf("-")
  let core = if dash >= 0 { text.take(dash) } else { text }
  let label = if dash >= 0 { text.drop(dash + 1) } else { "" }
  let parts = core.split(".")
  if parts.length() != 3 { return Err("\"{text}\" is not a version: write MAJOR.MINOR.PATCH, such as 1.4.2") }
  var numbers: Array[Int] = []
  for part in parts {
    if part.length() > 1 && part.startsWith("0") { return Err("\"{text}\" is not a version: a part may not start with 0") }
    let Some(number) = Text.wholeOf(part) else { return Err("\"{text}\" is not a version: each part is a whole number") }
    if number < 0 { return Err("\"{text}\" is not a version: a part may not be negative") }
    numbers = numbers.push(number)
  }
  var pre: Array[Str] = []
  if dash >= 0 {
    if label.isEmpty() { return Err("\"{text}\" has an empty pre-release label") }
    pre = label.split(".")
    for field in pre {
      if field.isEmpty() { return Err("\"{text}\" has an empty pre-release field") }
    }
  }
  Ok(Version{major: numbers[0], minor: numbers[1], patch: numbers[2], pre: pre})
}

export fn render(version: &Version) -> Str {
  let core = "{version.major}.{version.minor}.{version.patch}"
  if version.pre.isEmpty() { core } else { core + "-" + version.pre.join(".") }
}

/// -1, 0, or 1 as `left` precedes, equals, or follows `right`.
export fn compare(left: &Version, right: &Version) -> Int {
  if left.major != right.major { return if left.major < right.major { -1 } else { 1 } }
  if left.minor != right.minor { return if left.minor < right.minor { -1 } else { 1 } }
  if left.patch != right.patch { return if left.patch < right.patch { -1 } else { 1 } }
  comparePre(&left.pre, &right.pre)
}

fn comparePre(left: &Array[Str], right: &Array[Str]) -> Int {
  if left.isEmpty() && right.isEmpty() { return 0 }
  if left.isEmpty() { return 1 }
  if right.isEmpty() { return -1 }
  var index = 0
  while index < left.length() && index < right.length() {
    let a = left[index]
    let b = right[index]
    if a != b {
      return compareField(a, b)
    }
    index = index + 1
  }
  if left.length() == right.length() { 0 } else if left.length() < right.length() { -1 } else { 1 }
}

/// Numeric fields compare as numbers, words by text, and a number before a word.
fn compareField(a: Str, b: Str) -> Int {
  match Text.wholeOf(a) {
    case Some(x) => match Text.wholeOf(b) {
      case Some(y) => if x < y { -1 } else { 1 }
      case None => -1
    }
    case None => match Text.wholeOf(b) {
      case Some(_) => 1
      case None => if a < b { -1 } else { 1 }
    }
  }
}

export fn isPrerelease(version: &Version) -> Bool { !version.pre.isEmpty() }
