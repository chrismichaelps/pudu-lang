module Domain.Archive

import Std.Archive.Tar as Tar
import Std.Compress.Gzip as Gzip
import Std.List as List
import Std.Set as Set

/// Largest unpacked size of one archive, in bytes.
export const UNPACKED_LIMIT: Int = 67108864

/// Largest number of files in one archive.
export const FILE_LIMIT: Int = 5000

/// Longest path of one file, in bytes.
export const PATH_LIMIT: Int = 255

/// One regular file of a package, by its path relative to the package root.
export type File = { path: Str, content: Bytes }

/// Why a path may not appear in a package.
fn pathProblem(path: Str) -> Option[Str] {
  if path.isEmpty() { return Some("an entry has an empty path") }
  if path.toBytes().length() > PATH_LIMIT { return Some(path + " is longer than " + show(PATH_LIMIT) + " bytes") }
  if path.startsWith("/") { return Some(path + " is an absolute path") }
  if path.contains("\\") || path.contains("\u{0}") { return Some(path + " contains a backslash or NUL") }
  for segment in path.split("/") {
    if segment.isEmpty() || segment == "." || segment == ".." { return Some(path + " is not a plain relative path") }
  }
  None
}

/// The files of a `.tar.gz` package archive, sorted by path.
///
/// Refused: an archive that does not decompress within `UNPACKED_LIMIT`, a
/// symbolic link or any entry type other than a file or directory, a path
/// that is absolute, contains `.` or `..` segments, a backslash, or NUL, a
/// path given twice, and more than `FILE_LIMIT` files.
export fn unpack(archive: &Bytes) -> Result[Array[File], Str] {
  let tarred = match Gzip.decompressWithin(archive, UNPACKED_LIMIT) {
    case Ok(held) => held
    case Err(_) => { return Err("the archive is not gzip data or unpacks to more than " + show(UNPACKED_LIMIT) + " bytes") }
  }
  let entries = match Tar.readArchive(&tarred) {
    case Ok(held) => held
    case Err(Tar.UnsupportedType) => { return Err("the archive holds an entry that is neither a file nor a directory") }
    case Err(_) => { return Err("the archive is not a complete tar stream") }
  }
  var files: Array[File] = []
  var seen: Set[Str] = setOf([])
  for item in entries {
    match item.typeFlag {
      case Tar.Symlink => { return Err(item.path + " is a symbolic link; a package holds only files and directories") }
      case Tar.Directory => {}
      case Tar.File => {
        if let Some(problem) = pathProblem(item.path) { return Err(problem) }
        if seen.contains(item.path) { return Err(item.path + " appears twice in the archive") }
        seen = seen.insert(item.path)
        files = files.push(File{path: item.path, content: item.data})
        if files.length() > FILE_LIMIT { return Err("the archive holds more than " + show(FILE_LIMIT) + " files") }
      }
    }
  }
  Ok(List.sortBy(&files, fn(left: File, right: File) -> Bool { left.path < right.path }))
}

/// The content of one file, when the archive holds it.
export fn fileAt(files: &Array[File], path: Str) -> Option[Bytes] {
  for held in *files {
    if held.path == path { return Some(held.content) }
  }
  None
}

/// The module names of the `.pudu` files under a source directory:
/// `src/JsonSchema/Validate.pudu` under `src` is `JsonSchema.Validate`.
export fn modulesUnder(files: &Array[File], source: Str) -> Array[Str] {
  let prefix = if source.isEmpty() || source == "." { "" } else { source + "/" }
  var found: Array[Str] = []
  for held in *files {
    if held.path.startsWith(prefix) && held.path.endsWith(".pudu") {
      let relative = held.path.drop(prefix.length())
      found = found.push(relative.take(relative.length() - 5).split("/").join("."))
    }
  }
  found
}

/// The total size of the files, in bytes.
export fn totalSize(files: &Array[File]) -> Int {
  var total = 0
  for held in *files { total = total + held.content.length() }
  total
}
