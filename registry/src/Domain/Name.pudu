module Domain.Name

/// Handles no account may take: the compiler's own roots and the names a
/// reader would take for the project itself.
const RESERVED_HANDLES: Set[Str] = setOf(["std", "core", "pudu", "admin", "api", "login", "packages"])

/// A package's identity: `@handle/name`.
export type PackageName = { handle: Str, name: Str }

/// Whether a segment is lowercase ASCII letters and digits with single hyphens
/// between them, up to 39 characters.
export fn validSegment(segment: Str) -> Bool {
  if segment.isEmpty() || segment.length() > 39 { return false }
  if segment.startsWith("-") || segment.endsWith("-") || segment.contains("--") { return false }
  for character in segment.chars() {
    let allowed = (character >= 'a' && character <= 'z') || (character >= '0' && character <= '9') || character == '-'
    if !allowed { return false }
  }
  true
}

export fn reservedHandle(handle: Str) -> Bool { RESERVED_HANDLES.contains(handle) }

/// Read `@handle/name`, or say why it is not one.
export fn parse(text: Str) -> Result[PackageName, Str] {
  if !text.startsWith("@") { return Err("\"{text}\" is not a package: write @handle/name") }
  let parts = text.drop(1).split("/")
  if parts.length() != 2 { return Err("\"{text}\" is not a package: write @handle/name") }
  if !validSegment(parts[0]) { return Err("\"{parts[0]}\" is not a valid handle") }
  if !validSegment(parts[1]) { return Err("\"{parts[1]}\" is not a valid project name") }
  Ok(PackageName{handle: parts[0], name: parts[1]})
}

/// Read the two route segments `@handle` and `name`.
export fn fromRoute(handle: Str, name: Str) -> Result[PackageName, Str] { parse(handle + "/" + name) }

export fn render(package: &PackageName) -> Str { "@" + package.handle + "/" + package.name }

/// The module root a package owns when its manifest names none: `json-schema`
/// becomes `JsonSchema`.
export fn defaultRoot(name: Str) -> Str {
  var root = ""
  for part in name.split("-") {
    if !part.isEmpty() { root = root + part.take(1).toUpper() + part.drop(1) }
  }
  root
}

/// Whether a root is one module segment and not one the compiler owns.
export fn validRoot(root: Str) -> Result[Str, Str] {
  if root == "Std" || root == "Core" { return Err("{root} belongs to the compiler; a package may not own it") }
  if root.isEmpty() { return Err("a package's module root may not be empty") }
  let first = root.chars()[0]
  if !(first >= 'A' && first <= 'Z') { return Err("\"{root}\" is not a module root: start with a capital letter") }
  for character in root.chars() {
    let allowed = (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || (character >= '0' && character <= '9')
    if !allowed { return Err("\"{root}\" is not a module root: use letters and digits") }
  }
  Ok(root)
}

/// How many single-character edits separate two names, up to a limit; used
/// to refuse a new project named one edit from an established one.
export fn closeTo(left: Str, right: Str) -> Bool {
  if left == right { return false }
  let a = left.chars()
  let b = right.chars()
  if a.length() > b.length() + 1 || b.length() > a.length() + 1 { return false }
  var previous: Array[Int] = []
  for j in 0..=b.length() { previous = previous.push(j) }
  for i in 1..=a.length() {
    var current: Array[Int] = [i]
    for j in 1..=b.length() {
      let cost = if a[i - 1] == b[j - 1] { 0 } else { 1 }
      let deletion = previous[j] + 1
      let insertion = current[j - 1] + 1
      let substitution = previous[j - 1] + cost
      var best = deletion
      if insertion < best { best = insertion }
      if substitution < best { best = substitution }
      current = current.push(best)
    }
    previous = current
  }
  previous[b.length()] <= 1
}
