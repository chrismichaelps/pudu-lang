module Toolbox

import Std.Mobile.Auth as Auth
import Std.Mobile.Device as Device
import Std.Mobile.Host as Host
import Std.Mobile.Media as Media
import Std.Mobile.Notify as Notify
import Std.Mobile.Permission as Permission
import Std.Mobile.View as View

/// The tags each answer arrives under, and the reminder's id.
const BATTERY: UInt32 = 1u32
const OWNER: UInt32 = 2u32
const GREETING: UInt32 = 3u32
const PHOTO: UInt32 = 4u32
const PAGE: UInt32 = 5u32
const REMINDER: UInt32 = 1u32

/// Charges as the screen shows them.
const CHARGES: Map[Device.Charge, Str] = mapOf([(Device.Unknown, "unknown"), (Device.Unplugged, "unplugged"), (Device.Charging, "charging"), (Device.Full, "full")])

/// What each service answered so far.
type Model = { battery: Str, owner: Str, spoke: Str, motion: Str, photo: Str, tapped: Int }

fn charged(power: &Device.Power) -> Str {
  let charge = match CHARGES.get(power.charge) {
    case Some(name) => name
    case None => "unknown"
  }
  if power.level < 0 { charge } else { "{power.level}% {charge}" }
}

fn view(model: &Model) -> View.View {
  View.Column([
      View.Label("Battery: {model.battery}"),
      View.Label("Authenticated: {model.owner}"),
      View.Label("Spoke: {model.spoke}"),
      View.Label("Motion: {model.motion}"),
      View.Button("Pick a photo", PHOTO),
      View.Label("Photo: {model.photo}"),
      View.Button("Open the guide", PAGE),
      View.Label("Reminders tapped: {model.tapped}")
    ])
}

/// Asks for notifications and schedules a reminder, reads the battery, asks
/// the person to confirm they own the device, speaks a greeting, keeps the
/// screen upright and half bright, and shows the accelerometer; buttons pick
/// a photo and open a page in the in-app browser.
fn main() -> Int {
  var model = Model{battery: "unread", owner: "unasked", spoke: "pending", motion: "none", photo: "none", tapped: 0}
  let (first, built) = View.mount(&view(&model))
  var mounted = first
  Host.apply(built)
  Host.apply(Permission.request(Permission.Notifications))
  Host.apply(Device.battery(BATTERY))
  Host.apply(Auth.authenticate(OWNER, "Show your saved items"))
  Host.apply(Media.speak(GREETING, "Hello from Pudu", "", 100))
  Host.apply(Device.orientation(Device.Portrait))
  Host.apply(Device.brightness(50))
  Host.apply(Device.sense(true, 200))
  while true {
    let event = Host.wait()
    match event {
      case View.Stopped => { return 0 }
      case View.Permissioned(Permission.Notifications, state) if Permission.allows(state) => {
        Host.apply(Notify.schedule(REMINDER, 3600, "Toolbox", "Your reminder"))
      }
      case View.Powered(tag, power) if tag == BATTERY => { model = Model{..model, battery: charged(&power)} }
      case View.Authenticated(tag, confirmed) if tag == OWNER => { model = Model{..model, owner: "{confirmed}"} }
      case View.Spoke(tag, finished) if tag == GREETING => { model = Model{..model, spoke: "{finished}"} }
      case View.Sensed(motion) => { model = Model{..model, motion: "{motion.x} {motion.y} {motion.z}"} }
      case View.Tapped(tag) if tag == PHOTO => { Host.apply(Media.pickImage(PHOTO)) }
      case View.Tapped(tag) if tag == PAGE => { Host.apply(Media.browse(PAGE, "https://pudu-lang.dev")) }
      case View.ImagePicked(_tag, found) => {
        model = Model{..model, photo: match found { case Some(path) => path case None => "cancelled" }}
      }
      case View.Notified(id) if id == REMINDER => { model = Model{..model, tapped: model.tapped + 1} }
      case _ => {}
    }
    let (next, changes) = View.update(&mounted, &view(&model))
    Host.apply(changes)
    mounted = next
  }
  0
}
