module Permissions

import Std.Mobile.Host as Host
import Std.Mobile.Permission as Permission
import Std.Mobile.View as View

/// The kinds this example asks about; each is declared in pudu.toml beside it.
const ASKED: Array[Permission.Kind] = [Permission.Camera, Permission.Microphone, Permission.Contacts]

/// The name a state is shown with.
const NAMES: Map[Permission.State, Str] = mapOf([
    (Permission.NotAsked, "NotAsked"),
    (Permission.Granted, "Granted"),
    (Permission.Limited, "Limited"),
    (Permission.Provisional, "Provisional"),
    (Permission.Denied, "Denied"),
    (Permission.Blocked, "Blocked"),
    (Permission.Unavailable, "Unavailable")
  ])

fn shown(held: &Permission.Table, kind: Permission.Kind) -> Str {
  match Permission.status(held, kind) {
    case Some(state) => match NAMES.get(state) {
      case Some(name) => name
      case None => "?"
    }
    case None => "checking"
  }
}

fn view(held: &Permission.Table) -> View.View {
  View.Column([
      View.Label("Camera: {shown(held, Permission.Camera)}"),
      View.Label("Microphone: {shown(held, Permission.Microphone)}"),
      View.Label("Contacts: {shown(held, Permission.Contacts)}")
    ])
}

/// Checks every kind it shows, then asks for the camera; the table follows
/// each report, including those that arrive when the person changes a
/// permission in Settings and comes back.
fn main() -> Int {
  var held = Permission.table()
  let (first, built) = View.mount(&view(&held))
  var mounted = first
  Host.apply(built)
  Host.apply(Permission.check(&ASKED))
  Host.apply(Permission.request(Permission.Camera))
  while true {
    let event = Host.wait()
    match event {
      case View.Stopped => { return 0 }
      case View.Permissioned(kind, state) => { held = Permission.recorded(held, kind, state) }
      case _ => {}
    }
    let (next, changes) = View.update(&mounted, &view(&held))
    Host.apply(changes)
    mounted = next
  }
  0
}
