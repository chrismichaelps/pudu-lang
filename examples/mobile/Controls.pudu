module Controls

import Std.Mobile.Control as Control
import Std.Mobile.Host as Host
import Std.Mobile.View as View

/// The tags each value control's events report.
const VOLUME: UInt32 = 1u32
const COUNT: UInt32 = 2u32
const SIZE: UInt32 = 3u32
const FRUIT: UInt32 = 4u32
const MOMENT: UInt32 = 5u32
const NOTES: UInt32 = 6u32
const SEARCH: UInt32 = 7u32
const PAGE: UInt32 = 8u32
const COLOR: UInt32 = 9u32

const SIZES: Array[Str] = ["Small", "Medium", "Large"]
const FRUITS: Array[Str] = ["Apple", "Pear", "Plum"]

/// Every value the controls hold; each is shown in a label beside its control.
type Model = {
  volume: Int32,
  count: Int32,
  size: UInt32,
  fruit: UInt32,
  moment: Int64,
  notes: Str,
  search: Str,
  page: UInt32,
  color: UInt32
}

fn labelOf(labels: &Array[Str], index: UInt32) -> Str {
  match convertInteger[Int](index) {
    case Some(at) if at < labels.length() => labels[at]
    case _ => "none"
  }
}

fn view(model: &Model) -> View.View {
  View.Scroll(View.Column([
        View.Label("Volume: {model.volume}"),
        View.Control(Control.Slider(Control.Bounds{low: 0i32, high: 100i32, step: 10i32}, model.volume, VOLUME)),
        View.Label("Count: {model.count}"),
        View.Control(Control.Stepper(Control.Bounds{low: 0i32, high: 10i32, step: 1i32}, model.count, COUNT)),
        View.Label("Size: {labelOf(&SIZES, model.size)}"),
        View.Control(Control.Segments(SIZES, model.size, SIZE)),
        View.Label("Fruit: {labelOf(&FRUITS, model.fruit)}"),
        View.Control(Control.Wheel(FRUITS, model.fruit, FRUIT)),
        View.Label("Moment: {model.moment}"),
        View.Control(Control.Date(Control.DayAndTime, model.moment, MOMENT)),
        View.Label("Notes: {model.notes}"),
        View.Control(Control.TextArea(model.notes, NOTES)),
        View.Label("Search: {model.search}"),
        View.Control(Control.Search("Search", model.search, SEARCH)),
        View.Label("Page: {model.page}"),
        View.Control(Control.Pages(3u32, model.page, PAGE)),
        View.Label("Color: {model.color}"),
        View.Control(Control.Well(model.color, COLOR)),
        View.Control(Control.Symbol("star.fill"))
      ]))
}

fn update(model: &Model, event: &View.Event) -> Model {
  match *event {
    case View.Valued(tag, value) if tag == VOLUME => Model {..*model, volume: value }
    case View.Valued(tag, value) if tag == COUNT => Model {..*model, count: value }
    case View.Valued(tag, value) if tag == SIZE => Model {..*model, size: asIndex(value) }
    case View.Valued(tag, value) if tag == FRUIT => Model {..*model, fruit: asIndex(value) }
    case View.Valued(tag, value) if tag == PAGE => Model {..*model, page: asIndex(value) }
    case View.Dated(tag, seconds) if tag == MOMENT => Model {..*model, moment: seconds }
    case View.Changed(tag, text) if tag == NOTES => Model {..*model, notes: text }
    case View.Changed(tag, text) if tag == SEARCH => Model {..*model, search: text }
    case View.Colored(tag, rgba) if tag == COLOR => Model {..*model, color: rgba }
    case _ => *model
  }
}

// An index the platform reported; indexes are never negative.
fn asIndex(value: Int32) -> UInt32 {
  match convertInteger[UInt32](value) {
    case Some(found) => found
    case None => 0u32
  }
}

fn main() -> Int {
  var model = Model{volume: 40i32, count: 2i32, size: 0u32, fruit: 0u32, moment: 0i64, notes: "", search: "", page: 0u32, color: 255u32}
  let (first, built) = View.mount(&view(&model))
  var mounted = first
  Host.apply(built)
  while true {
    let event = Host.wait()
    if event == View.Stopped {
      return 0
    }
    model = update(&model, &event)
    let (next, changes) = View.update(&mounted, &view(&model))
    Host.apply(changes)
    mounted = next
  }
  0
}
