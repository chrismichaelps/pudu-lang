module View.Home

import Std.Html.Build as H
import Std.Html as Html
import Std.Url as Url
import Seo as Seo
import Service.Catalog as Catalog
import View.Dynamic as Dynamic
import View.Layout as Layout

export fn home(siteUrl: Str, catalog: &Catalog.Catalog) -> Html.Html {
  let intro = H.section().class("intro").holding([
      H.h1().says("Find the Pudu API you need."),
      H.p().says("Search every public function, type, trait, constructor, and constant by name or type."),
      exampleQueries()
    ])
  let modules = modulePanel(&catalog.modules, catalog.languageVersion)
  Layout.page(siteUrl, "Pudu language and API search", "Search every public Pudu language and standard-library declaration by name or type.", "/", true, Some(Seo.websiteSchema(siteUrl)), H.div().holding([
        intro,
        Layout.searchForm("", "home-search"),
        H.div().class("grid").holding([
            H.section().holding([
                H.h2().says("Start with a shape"),
                H.p().class("summary").says("Try Result[T, E], &mut T, Array[T] -> T, server, or json."),
                H.pre().class("signature").holding([
                    H.code().says("fn find[T](items: &Array[T], keep: fn(T) -> Bool) -> Option[T]")
                  ])
              ]),
            modules
          ]),
        H.section().class("home-section start-section").holding([
            H.div().holding([
                H.span().class("kind").says("Start here"),
                H.h2().says("Write a complete program"),
                H.p().says("A Pudu program names its module, imports what it uses, and returns a status from main."),
                H.p().class("home-actions").holding([
                    H.a().href("/guide").says("Read the language guide"),
                    H.a().href("/modules").says("Browse the complete API")
                  ])
              ]),
            H.pre().class("signature home-code").holding([
                H.code().says("module Hello\n\nimport Std.Io as Io\n\nfn main() -> Int \{\n  let _written = Io.writeLine(\"Hello from Pudu!\")\n  0\n\}")
              ])
          ]),
        H.section().class("home-section").holding([
            H.h2().says("Understand what the code promises"),
            H.p().class("section-lead").says("Pudu keeps important choices visible in function signatures and at the place where a value is used."),
            H.div().class("principles").holding([
                principle("Typed results", "Result[Value, Problem] tells the caller that work may fail. The caller handles both paths."),
                principle("Explicit references", "&T borrows a value for reading. &mut T gives one temporary place permission to change it."),
                principle("Checked patterns", "match lists the shapes a value may have, so each case can be handled directly.")
              ])
          ]),
        H.section().class("home-section haskell-note").holding([
            H.div().holding([
                H.span().class("kind").says("Compiler"),
                H.h2().says("Built on a Haskell foundation"),
                H.p().says("The first Pudu compiler is written in Haskell. Its strong types and functional style help keep compiler stages explicit and testable.")
              ]),
            H.p().holding([H.a().href("/about").says("Learn about Pudu and its author")])
          ])
      ]).html())
}

export fn results(siteUrl: Str, catalog: &Catalog.Catalog, query: Str) -> Html.Html {
  Dynamic.results(siteUrl, &catalog.entries, query)
}

fn modulePanel(modules: &Array[Str], languageVersion: Str) -> H.Node {
  var links: Array[H.Node] = []
  var index = 0
  while index < modules.length() && index < 18 {
    let name = modules[index]
    links = links.push(H.li().holding([
          H.a().href("/module/" + Url.encodeComponent(name)).says(name)
        ]))
    index = index + 1
  }
  H.aside().class("panel").holding([
      H.h2().says("Browse modules"),
      H.p().class("meta").says("Pudu " + languageVersion),
      H.ul().class("module-list").holding(links),
      H.p().holding([H.a().href("/modules").says("View all modules")])
    ])
}

fn exampleQueries() -> H.Node {
  let queries = ["checksum", "Str -> UInt32", "Result", "server"]
  var links: Array[H.Node] = [H.span().says("Try ")]
  var index = 0
  for query in queries {
    if index > 0 { links = links.push(H.span().says(", ")) }
    links = links.push(H.a().href("/search?q=" + Url.encodeComponent(query)).says(query))
    index = index + 1
  }
  H.p().class("query-examples").holding(links)
}

fn principle(title: Str, explanation: Str) -> H.Node {
  H.article().class("principle").holding([
      H.h3().says(title),
      H.p().says(explanation)
    ])
}
