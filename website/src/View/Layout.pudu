module View.Layout

import Std.Html.Build as H
import Std.Html as Html
import Std.Json as Json
import Std.Option as Option
import Constants as Constants
import Seo as Seo

export fn page(
  siteUrl: Str,
  title: Str,
  description: Str,
  path: Str,
  indexable: Bool,
  structured: Option[Json.Json],
  content: Html.Html
) -> Html.Html {
  H.html().lang("en").holding([
      H.head().holding([
          H.meta().at("charset", "utf-8"),
          H.meta().name("viewport").at("content", "width=device-width, initial-scale=1"),
          H.link().rel("icon").at("type", "image/png").href(Constants.SHORT_LOGO_PATH),
          H.link().rel("stylesheet").href("/assets/site.css?v=6")
        ].concat(Seo.head(siteUrl, title, description, path, indexable, structured))),
      H.body().holding([
          H.a().class("skip").href("#content").says("Skip to content"),
          masthead(path),
          H.main().id("content").class("shell").holds(content),
          footer()
        ])
    ]).html()
}

/// One search form, identified by the class that says which one it is.
///
/// The home and results pages carry two of these: a small one in the masthead
/// and a large one in the page. That is the design — the stylesheet gives
/// `home-search` its own width and height — but both were identified as `q`, and
/// an identifier occurs once in a document or it identifies nothing. A label
/// points at the first element carrying the identifier it names, so on those two
/// pages the second form's label named the first form's input: a reader using it
/// to reach the field was put in the other one.
///
/// The field is still named `q`, because that is the query the server reads.
/// What is made distinct is what identifies the element on the page, which the
/// class already distinguishes.
export fn searchForm(query: Str, extraClass: Str) -> H.Node {
  let field = "q-" + extraClass
  H.form().class("search " + extraClass).action("/search").method("get").holding([
      H.labelFor().at("for", field).class("skip").says("Search Pudu APIs"),
      H.input().id(field).name("q").kind("search").value(query)
        .placeholder("Search names or types, such as Array[T] -> T").required(),
      H.button().submit().says("Search")
    ])
}

fn masthead(path: Str) -> H.Node {
  H.header().class("masthead").holding([
      H.div().class("masthead-inner").holding([
          H.a().class("brand").href("/").holding([
              H.img().src(Constants.FULL_LOGO_PATH).alt("Pudu programming language")
            ]),
          navigation(path, "top-nav desktop-nav"),
          H.tag("details").class("mobile-nav").holding([
              H.tag("summary").class("menu-toggle").at("aria-label", "Navigation menu").holding([
                  H.span().class("menu-icon").at("aria-hidden", "true").says("☰"),
                  H.span().class("skip").says("Menu")
                ]),
              navigation(path, "top-nav mobile-nav-links")
            ])
        ])
    ])
}

fn navigation(path: Str, classes: Str) -> H.Node {
  H.nav().class(classes).label("Main navigation").holding([
      navigationLink("/guide", "Guide", path == "/guide"),
      navigationLink("/modules", "API", path == "/modules" || path.startsWith("/module/") || path.startsWith("/docs/")),
      navigationLink("/about", "About", path == "/about"),
      navigationLink("/donate", "Donate", path == "/donate")
    ])
}

fn navigationLink(target: Str, label: Str, current: Bool) -> H.Node {
  let linked = H.a().href(target).says(label)
  if current { linked.at("aria-current", "page") } else { linked }
}

fn footer() -> H.Node {
  H.footer().class("footer").holding([
      H.div().class("footer-inner").holding([
          H.span().class("footer-brand").holding([
              H.img().src(Constants.SHORT_LOGO_PATH).alt(""),
              H.span().says("Pudu language documentation")
            ]),
          H.small().says(Constants.COPYRIGHT),
          H.span().class("footer-links").holding([
              H.a().href("/donate").says("Donate"),
              H.a().href(Constants.REPOSITORY_URL).at("rel", "external noopener noreferrer").says("GitHub")
            ])
        ])
    ])
}
