module View.Layout

import Std.Html.Build as H
import Std.Html as Html
import Std.Json as Json
import Std.Option as Option
import Constants as Constants
import Seo as Seo

export fn page(
  siteUrl: Str,
  title: Str,
  description: Str,
  path: Str,
  indexable: Bool,
  structured: Option[Json.Json],
  content: Html.Html
) -> Html.Html {
  H.html().lang("en").holding([
      H.head().holding([
          H.meta().at("charset", "utf-8"),
          H.meta().name("viewport").at("content", "width=device-width, initial-scale=1"),
          H.link().rel("icon").at("type", "image/png").href(Constants.SHORT_LOGO_PATH),
          H.link().rel("stylesheet").href("/assets/site.css?v=5")
        ].concat(Seo.head(siteUrl, title, description, path, indexable, structured))),
      H.body().holding([
          H.a().class("skip").href("#content").says("Skip to content"),
          masthead(),
          H.main().id("content").class("shell").holds(content),
          footer()
        ])
    ]).html()
}

export fn searchForm(query: Str, extraClass: Str) -> H.Node {
  H.form().class("search " + extraClass).action("/search").method("get").holding([
      H.labelFor().at("for", "q").class("skip").says("Search Pudu APIs"),
      H.input().id("q").name("q").kind("search").value(query)
        .placeholder("Search names or types, such as Array[T] -> T").required(),
      H.button().submit().says("Search")
    ])
}

fn masthead() -> H.Node {
  H.header().class("masthead").holding([
      H.div().class("masthead-inner").holding([
          H.a().class("brand").href("/").holding([
              H.img().src(Constants.FULL_LOGO_PATH).alt("Pudu programming language")
            ]),
          searchForm("", "header-search"),
          H.nav().class("top-nav").label("Main navigation").holding([
              H.a().href("/guide").says("Guide"),
              H.a().href("/modules").says("API"),
              H.a().href("/about").says("About"),
              H.a().href("/donate").says("Donate"),
              H.a().class("github-link").href(Constants.REPOSITORY_URL).at("rel", "external noopener noreferrer").label("GitHub repository").holding([
                  githubIcon()
                ])
            ])
        ])
    ])
}

fn footer() -> H.Node {
  H.footer().class("footer").holding([
      H.div().class("footer-inner").holding([
          H.span().class("footer-brand").holding([
              H.img().src(Constants.SHORT_LOGO_PATH).alt(""),
              H.span().says("Pudu language documentation")
            ]),
          H.small().says(Constants.COPYRIGHT),
          H.span().class("footer-links").holding([
              H.a().href("/donate").says("Donate"),
              H.a().href(Constants.REPOSITORY_URL).at("rel", "external noopener noreferrer").says("GitHub")
            ])
        ])
    ])
}

fn githubIcon() -> H.Node {
  H.tag("svg").class("github-icon").at("viewBox", "0 0 24 24").at("aria-hidden", "true").holding([
      H.tag("path").at("d", "M12 .5C5.73.5.64 5.59.64 11.86c0 5.01 3.25 9.26 7.76 10.76.57.1.78-.25.78-.55v-2.17c-3.15.68-3.82-1.34-3.82-1.34-.52-1.31-1.26-1.66-1.26-1.66-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.74 2.66 1.24 3.31.95.1-.73.4-1.24.72-1.53-2.52-.29-5.17-1.26-5.17-5.59 0-1.23.44-2.24 1.17-3.03-.12-.29-.51-1.44.11-2.99 0 0 .95-.31 3.12 1.16a10.8 10.8 0 0 1 5.68 0c2.17-1.47 3.12-1.16 3.12-1.16.62 1.55.23 2.7.11 2.99.73.79 1.17 1.8 1.17 3.03 0 4.34-2.66 5.3-5.19 5.58.41.35.77 1.04.77 2.1v3.12c0 .3.21.66.78.55a11.38 11.38 0 0 0 7.75-10.76C23.36 5.59 18.27.5 12 .5Z")
    ])
}
