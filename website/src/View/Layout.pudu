module View.Layout

import Std.Html.Build as H
import Std.Html as Html
import Std.Json as Json
import Std.Option as Option
import Constants as Constants
import Seo as Seo

export fn page(
  siteUrl: Str,
  title: Str,
  description: Str,
  path: Str,
  indexable: Bool,
  structured: Option[Json.Json],
  content: Html.Html
) -> Html.Html {
  document(siteUrl, title, description, path, indexable, structured, "", [
      H.a().class("skip").href("#content").says("Skip to content"),
      masthead(path),
      H.main().id("content").class("shell").holds(content),
      footer()
    ])
}

/// A page that is a tool rather than a document: the masthead, then the tool
/// filling the rest of the window, with no footer beneath it to scroll to.
export fn workspace(
  siteUrl: Str,
  title: Str,
  description: Str,
  path: Str,
  indexable: Bool,
  structured: Option[Json.Json],
  content: Html.Html
) -> Html.Html {
  document(siteUrl, title, description, path, indexable, structured, "workspace-page", [
      H.a().class("skip").href("#content").says("Skip to content"),
      masthead(path),
      H.main().id("content").class("workspace-shell").holds(content)
    ])
}

fn document(
  siteUrl: Str,
  title: Str,
  description: Str,
  path: Str,
  indexable: Bool,
  structured: Option[Json.Json],
  bodyClass: Str,
  parts: Array[H.Node]
) -> Html.Html {
  let body = if bodyClass.isEmpty() { H.body() } else { H.body().class(bodyClass) }
  H.html().lang("en").holding([
      H.head().holding([
          H.meta().at("charset", "utf-8"),
          H.meta().name("viewport").at("content", "width=device-width, initial-scale=1"),
          H.link().rel("icon").at("type", "image/png").href(Constants.SHORT_LOGO_PATH),
          H.link().rel("stylesheet").href("/assets/site.css?v=22")
        ].concat(Seo.head(siteUrl, title, description, path, indexable, structured))),
      body.holding(parts)
    ]).html()
}

/// One search form, identified by the class that says which one it is.
///
/// The home and results pages carry two of these: a small one in the masthead
/// and a large one in the page. That is the design — the stylesheet gives
/// `home-search` its own width and height — but both were identified as `q`, and
/// an identifier occurs once in a document or it identifies nothing. A label
/// points at the first element carrying the identifier it names, so on those two
/// pages the second form's label named the first form's input: a reader using it
/// to reach the field was put in the other one.
///
/// The field is still named `q`, because that is the query the server reads.
/// What is made distinct is what identifies the element on the page, which the
/// class already distinguishes.
export fn searchForm(query: Str, extraClass: Str) -> H.Node {
  let field = "q-" + extraClass
  H.form().class("search " + extraClass).action("/search").method("get").holding([
      H.labelFor().at("for", field).class("skip").says("Search Pudu APIs"),
      H.input().id(field).name("q").kind("search").value(query)
        .placeholder("Search names or types, such as Array[T] -> T").required(),
      H.button().submit().says("Search")
    ])
}

fn masthead(path: Str) -> H.Node {
  H.header().class("masthead").holding([
      H.div().class("masthead-inner").holding([
          H.a().class("brand").href("/").holding([
              H.img().src(Constants.FULL_LOGO_PATH).alt("Pudu programming language")
            ]),
          navigation(path, "top-nav desktop-nav"),
          H.tag("details").class("mobile-nav").holding([
              H.tag("summary").class("menu-toggle").at("aria-label", "Navigation menu").holding([
                  H.span().class("menu-icon").at("aria-hidden", "true").says("☰"),
                  H.span().class("skip").says("Menu")
                ]),
              navigation(path, "top-nav mobile-nav-links")
            ])
        ])
    ])
}

fn navigation(path: Str, classes: Str) -> H.Node {
  H.nav().class(classes).label("Main navigation").holding([
      navigationLink("/docs", "Docs", isDocumentation(path)),
      navigationLink("/modules", "API", path == "/modules" || path.startsWith("/module/") || isSymbol(path)),
      navigationLink("/playground", "Playground", path == "/playground" || path.startsWith("/playground/")),
      navigationLink("/download", "Download", path == "/download"),
      navigationLink("/about", "About", path == "/about"),
      navigationLink("/donate", "Donate", path == "/donate")
    ])
}

/// Whether a path is the documentation: its index, or one page beneath it.
///
/// Documentation pages and API symbols share the `/docs/` prefix, and are told
/// apart by depth — a page is one segment below it, a symbol three.
fn isDocumentation(path: Str) -> Bool {
  path == "/docs" || path == "/guide" || (path.startsWith("/docs/") && path.split("/").length() == 3)
}

fn isSymbol(path: Str) -> Bool { path.startsWith("/docs/") && path.split("/").length() > 3 }

fn navigationLink(target: Str, label: Str, current: Bool) -> H.Node {
  let linked = H.a().href(target).says(label)
  if current { linked.at("aria-current", "page") } else { linked }
}

fn footer() -> H.Node {
  H.footer().class("footer").holding([
      H.div().class("footer-inner").holding([
          H.div().class("footer-brand-column").holding([
              H.span().class("footer-brand").holding([
                  H.img().src(Constants.SHORT_LOGO_PATH).alt(""),
                  H.span().says("Pudu")
                ]),
              H.p().class("footer-blurb").says("A statically typed language where a signature says what a function takes, what it gives back, and whether it changes what it was given.")
            ]),
          footerColumn("Learn", &[
              ("/docs", "Documentation"),
              ("/docs/introduction", "Getting started"),
              ("/modules", "Standard library"),
              ("/playground", "Playground"),
              ("/search", "Search the API")
            ]),
          footerColumn("Get Pudu", &[
              ("/download", "Download"),
              ("/releases", "Release notes")
            ]),
          footerColumn("Project", &[
              ("/about", "About"),
              ("/contributing", "Contributing"),
              ("/conduct", "Code of Conduct"),
              ("/security", "Security")
            ]),
          footerColumn("Community", &[
              ("/community", "Get involved"),
              ("https://github.com/chrismichaelps/pudu-lang/issues", "Issues"),
              ("https://github.com/chrismichaelps/pudu-lang/discussions", "Discussions"),
              ("/donate", "Donate")
            ])
        ]),
      H.div().class("footer-base").holding([
          H.small().says(Constants.COPYRIGHT),
          H.span().class("footer-base-links").holding([
              H.a().href("/privacy").says("Privacy"),
              H.a().href("/brand").says("Brand"),
              H.a().href(Constants.LICENSE_URL).at("rel", "external noopener noreferrer").says("Apache-2.0"),
              H.a().href(Constants.REPOSITORY_URL).at("rel", "external noopener noreferrer").says("GitHub"),
              H.a().href("/donate").says("Donate")
            ])
        ])
    ])
}

/// One column of the footer: a heading and the pages under it.
fn footerColumn(title: Str, links: &Array[(Str, Str)]) -> H.Node {
  var items: Array[H.Node] = []
  for link in links {
    items = items.push(H.li().holding([H.a().href(link[0]).says(link[1])]))
  }
  H.div().class("footer-column").holding([
      H.h2().class("footer-heading").says(title),
      H.ul().holding(items)
    ])
}
