module View.Dynamic

import Std.Html.Build as H
import Std.Html as Html
import Domain.Entry as Domain
import Seo as Seo
import Service.Search as Search
import View.Layout as Layout
import View.MarkdownInline as Inline
import View.Pudu as Pudu

/// Ranked search results shared by local and serverless routes.
export fn results(siteUrl: Str, search: &Search.Index, query: Str) -> Html.Html {
  let hits = Search.ranked(search, query, 200)
  var rows: Array[H.Node] = []
  for hit in hits { rows = rows.push(resultRow(&hit)) }
  let heading = if query.trim().isEmpty() { "Search Pudu" } else { "Results for “" + query + "”" }
  let body = H.div().holding([
      Layout.banner("page-banner", "API search", heading, show(hits.length()) + " matching declarations", [Layout.searchForm(query, "banner-search")]),
      H.p().class("query-help").says("Use module:Std.List, kind:fn, or is:exact. Put a Pudu type after ::."),
      H.ul().class("results").holding(rows)
    ]).html()
  Layout.page(siteUrl, heading, "Search results from the Pudu public API catalogue.", "/search", false, None, body)
}

/// The page answering a request whose input was refused: what was wrong, and
/// nothing the reader sent echoed back beyond the names of its fields.
export fn invalid(siteUrl: Str, path: Str, problems: &Array[Str]) -> Html.Html {
  Layout.page(siteUrl, "Bad request", "The request could not be answered as sent.", path, false, None, H.article().class("doc").holding([
        Pudu.around(Pudu.SHY, true, Layout.banner("page-banner", "400", "That request could not be answered.", "Something in it was longer than this site reads.", [])),
        H.ul().holding(problems.map(|problem: Str| H.li().says(problem))),
        H.p().holding([H.a().href("/").says("Return to search")])
      ]).html())
}

/// A page saying the site failed, naming nothing of how.
export fn failed(siteUrl: Str, path: Str) -> Html.Html {
  Layout.page(siteUrl, "Something went wrong", "The site could not answer this request.", path, false, None, H.article().class("doc").holding([
        Pudu.around(Pudu.SHY, true, Layout.banner("page-banner", "500", "Something went wrong.", "The site could not answer this request. Try again in a moment.", [])),
        H.p().holding([H.a().href("/").says("Return to search")])
      ]).html())
}

/// The shared dynamic fallback page.
export fn missing(siteUrl: Str, path: Str) -> Html.Html {
  Layout.page(siteUrl, "Not found", "The requested Pudu page does not exist.", path, false, None, H.article().class("doc").holding([
        Pudu.around(Pudu.SHY, true, Layout.banner("page-banner", "404", "That page is not here.", "No page matches " + path + ".", [])),
        H.p().holding([H.a().href("/").says("Return to search")])
      ]).html())
}

fn resultRow(hit: &Domain.Hit) -> H.Node {
  let entry = hit.entry
  H.li().class("result").holding([
      H.a().class("result-name").href(symbolPath(&entry)).says(Domain.qualifiedName(&entry)),
      H.code().class("signature").says(entry.signature),
      H.p().class("summary").holding(Inline.render(Domain.summary(&entry))),
      H.div().class("meta").says(entry.kind + " · " + entry.moduleName)
    ])
}

fn symbolPath(entry: &Domain.Entry) -> Str {
  Seo.symbolPath(entry)
}
