module View.Documentation

import Std.Html.Build as H
import Std.Html as Html
import Std.Url as Url
import Constants as Constants
import Domain.Entry as Domain
import Domain.Library as Library
import Seo as Seo
import Service.Catalog as Catalog
import View.Dynamic as Dynamic
import View.Layout as Layout
import View.Markdown as Markdown
import View.MarkdownInline as Inline

/// The standard library as a map: its sections, each module in a section with
/// the sentence that says what it is for, and the modules beneath it.
export fn modules(siteUrl: Str, catalog: &Catalog.Catalog) -> Html.Html {
  var jumps: Array[H.Node] = []
  var sections: Array[H.Node] = []
  for section in Library.SECTIONS {
    jumps = jumps.push(H.li().holding([H.a().href("#" + section.id).says(section.title)]))
    var rows: Array[H.Node] = []
    for name in section.modules {
      if catalog.modules.contains(name) { rows = rows.push(moduleRow(catalog, name, Library.childrenOf(name, &catalog.modules))) }
    }
    sections = sections.push(librarySection(section.id, section.title, section.lead, rows))
  }
  let remaining = Library.unplaced(&catalog.modules)
  if remaining.length() > 0 {
    var rows: Array[H.Node] = []
    for name in remaining { rows = rows.push(moduleRow(catalog, name, [])) }
    jumps = jumps.push(H.li().holding([H.a().href("#other").says("Other")]))
    sections = sections.push(librarySection("other", "Other", "Modules not yet placed in a section.", rows))
  }
  Layout.page(siteUrl, "Pudu standard library", "Every module in the Pudu standard library, grouped by what it is for.", "/modules", true, None, H.article().class("doc library").holding([
        Layout.banner("page-banner", "Reference", "Pudu standard library", "The standard library ships with the compiler. Every module lives under Std, nothing is imported implicitly, and a program imports exactly the modules it uses.", [H.dl().class("docs-meta").holding([
                H.dt().says("Author"),
                H.dd().says(Constants.AUTHOR_NAME),
                H.dt().says("Version"),
                H.dd().says(catalog.languageVersion),
                H.dt().says("Contents"),
                H.dd().says(show(catalog.modules.length()) + " modules, " + show(catalog.entries.length()) + " public declarations")
              ])]),
        H.nav().label("Library sections").holding([H.ul().class("library-jump").holding(jumps)])
      ].concat(sections)).html())
}

fn librarySection(id: Str, title: Str, lead: Str, rows: Array[H.Node]) -> H.Node {
  H.section().class("library-section").holding([
      H.h2().id(id).says(title),
      H.p().says(lead),
      H.div().class("table-wrap").holding([H.table().class("library-table").holding([H.tbody().holding(rows)])])
    ])
}

fn moduleRow(catalog: &Catalog.Catalog, name: Str, children: Array[Str]) -> H.Node {
  let count = Catalog.moduleEntries(catalog, name).length()
  let summary = match Library.SUMMARIES.get(name) {
    case Some(text) => text
    case None => ""
  }
  var described: Array[H.Node] = [H.span().holding(Inline.render(summary))]
  if children.length() > 0 {
    var links: Array[H.Node] = []
    for child in children {
      links = links.push(H.li().holding([H.a().href("/module/" + Url.encodeComponent(child)).says(child.drop(name.length() + 1))]))
    }
    described = described.push(H.ul().class("child-modules").label("Modules inside " + name).holding(links))
  }
  H.tr().holding([
      H.td().holding([
          H.a().href("/module/" + Url.encodeComponent(name)).says(name),
          H.p().class("meta").says(show(count) + " declarations")
        ]),
      H.td().holding(described)
    ])
}

export fn modulePage(siteUrl: Str, catalog: &Catalog.Catalog, moduleName: Str) -> Option[Html.Html] {
  let entries = Catalog.moduleEntries(catalog, moduleName)
  if entries.length() == 0 { None } else {
    var rows: Array[H.Node] = []
    for entry in entries {
      rows = rows.push(H.li().class("result").holding([
            H.a().class("result-name").href(symbolPath(&entry)).says(entry.name),
            H.code().class("signature").says(entry.signature),
            H.p().class("summary").holding(Inline.render(Domain.summary(&entry))),
            H.div().class("meta").says(entry.kind)
          ]))
    }
    Some(Layout.page(siteUrl, moduleName, "Public declarations in the " + moduleName + " Pudu module.", "/module/" + Url.encodeComponent(moduleName), true, None, H.article().class("doc").holding([
            Layout.banner("page-banner", "Module", moduleName, show(entries.length()) + " public declarations", []),
            H.ul().class("results").holding(rows)
          ]).html()))
  }
}

export fn symbols(siteUrl: Str, entries: &Array[Domain.Entry]) -> Html.Html {
  let primary = entries[0]
  var declarations: Array[H.Node] = []
  for entry in entries {
    let shownSignature = if entry.signature.isEmpty() { entry.name }
      else { entry.name + ": " + entry.signature }
    var content: Array[H.Node] = [
      H.h2().class("declaration-title").says(entry.kind),
      H.code().class("signature").says(shownSignature)
    ]
    let provider = providerNote(entry.kind)
    if !provider.isEmpty() { content = content.push(H.p().class("kind-explanation").says(provider)) }
    for block in Markdown.parseBody(&entry.documentation).blocks { content = content.push(block) }
    declarations = declarations.push(H.section().class("declaration").holding(content))
  }
  Layout.page(siteUrl, Domain.qualifiedName(&primary), Markdown.plainText(Domain.summary(&primary)), Seo.symbolPath(&primary), true, Some(Seo.symbolSchema(siteUrl, &primary)), H.article().class("doc").holding([
        Layout.banner("page-banner", "API reference", Domain.qualifiedName(&primary), if entries.length() == 1 { "1 declaration" } else { show(entries.length()) + " declarations with this name" }, []),
        H.div().holding(declarations),
        H.p().class("symbol-actions").holding([
            H.a().href("/module/" + Url.encodeComponent(primary.moduleName)).says("Back to " + primary.moduleName),
            H.a().href("/search?q=" + Url.encodeComponent(Domain.qualifiedName(&primary))).says("Search related declarations")
          ])
      ]).html())
}

/// Where a method comes from, for the two kinds that answer differently than
/// their own name does. Every other kind is already written in full beside the
/// signature, so it earns no sentence of its own.
fn providerNote(kind: Str) -> Str {
  if kind.startsWith("fn (trait ") { "Required by this trait. A type that implements the trait supplies the body." }
    else if kind.startsWith("fn (") { "One implementation of a trait method, for this type." }
    else { "" }
}

export fn missing(siteUrl: Str, path: Str) -> Html.Html {
  Dynamic.missing(siteUrl, path)
}

fn symbolPath(entry: &Domain.Entry) -> Str {
  Seo.symbolPath(entry)
}
