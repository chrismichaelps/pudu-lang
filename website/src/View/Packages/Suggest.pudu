module View.Packages.Suggest

import Std.Http as Http
import Std.Http.Server.Reply as Reply
import Std.Json as Json
import Std.Option as Option
import Std.Url as Url
import Domain.Entry as Domain
import Seo as Seo
import Service.PackageSearch as PackageSearch
import Service.Packages as Packages
import View.Packages.Frame as Frame
import View.Packages.Reference as Reference

export const PATH: Str = "/packages/suggest"

/// The longest query or filter matched; the rest of a longer one is ignored,
/// so one request cannot ask for unbounded matching.
const QUERY_LIMIT: Int = 200

fn text(value: Str) -> Json.Json { Json.Text(value) }

fn handle(packages: &Packages.Packages, profile: &Packages.Profile) -> Json.Json {
  let held = Some(*profile)
  Json.object(&[
      ("handle", text(profile.handle)),
      ("name", text(profile.name)),
      ("avatar", text(Frame.avatarSource(&held))),
      ("tone", Json.Number(Frame.tone(profile.handle))),
      ("href", text("/" + profile.handle)),
      ("projects", Json.Number(Packages.ofHandle(packages, profile.handle).length()))
    ])
}

fn project(packages: &Packages.Packages, held: &Packages.Project) -> Json.Json {
  let owner = Packages.profile(packages, held.handle)
  Json.object(&[
      ("name", text(held.name)),
      ("handle", text(held.handle)),
      ("project", text(held.project)),
      ("description", text(held.description)),
      ("latest", text(Option.unwrapOr(held.latest, ""))),
      ("stars", Json.Number(held.stars)),
      ("avatar", text(Frame.avatarSource(&owner))),
      ("tone", Json.Number(Frame.tone(held.handle))),
      ("href", text(Frame.projectPath(held)))
    ])
}

fn declaration(found: &PackageSearch.Found) -> Json.Json {
  Json.object(&[
      ("name", text(found.entry.name)),
      ("module", text(found.entry.moduleName)),
      ("kind", text(found.entry.kind)),
      ("mark", text(Frame.kindMark(found.entry.kind))),
      ("signature", text(found.entry.signature)),
      ("project", text(found.projectName)),
      ("version", text(found.version)),
      ("href", text("/" + found.projectName + "/docs#" + Reference.anchorOf(found.entry.moduleName, found.entry.kind, found.entry.name)))
    ])
}

fn libraryEntry(hit: &PackageSearch.LibraryHit) -> Json.Json {
  Json.object(&[
      ("name", text(hit.entry.name)),
      ("module", text(hit.entry.moduleName)),
      ("kind", text(hit.entry.kind)),
      ("mark", text(Frame.kindMark(hit.entry.kind))),
      ("signature", text(hit.entry.signature)),
      ("href", text(Seo.symbolPath(&hit.entry)))
    ])
}

/// The full results page for a query and filter.
export fn resultsPath(query: Str, filter: Str) -> Str {
  "/packages/search?q=" + Url.encodeComponent(query) + (if filter.isEmpty() { "" } else { "&filter=" + Url.encodeComponent(filter) })
}

/// The suggestions for a query and optional project filter. Standard
/// library declarations join them unless the search is inside a project.
export fn json(packages: &Packages.Packages, entries: &Array[Domain.Entry], query: Str, filter: Str) -> Json.Json {
  let found = PackageSearch.suggest(packages, query, filter)
  let library = if filter.isEmpty() { PackageSearch.library(entries, query) } else { [] }
  Json.object(&[
      ("query", text(query)),
      ("filter", text(filter)),
      ("handles", Json.list(&found.handles.map(|held: Packages.Profile| handle(packages, &held)))),
      ("projects", Json.list(&found.projects.map(|held: Packages.Project| project(packages, &held)))),
      ("declarations", Json.list(&found.declarations.map(|held: PackageSearch.Found| declaration(&held)))),
      ("library", Json.list(&library.slice(0, PackageSearch.LIBRARY_LIMIT).map(|held: PackageSearch.LibraryHit| libraryEntry(&held)))),
      ("totals", Json.object(&[("projects", Json.Number(found.projectTotal)), ("declarations", Json.Number(found.declarationTotal)), ("library", Json.Number(library.length()))])),
      ("more", text(resultsPath(query, filter))),
      ("libraryMore", text("/search?q=" + Url.encodeComponent(query)))
    ])
}

/// The suggestion response both routers serve.
export fn reply(packages: &Packages.Packages, entries: &Array[Domain.Entry], query: Str, filter: Str) -> Http.Response {
  Reply.jsonValue(200, json(packages, entries, query.take(QUERY_LIMIT), filter.take(QUERY_LIMIT)))
}
