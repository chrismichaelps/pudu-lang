module View.Packages.Project

import Std.Html.Build as H
import Std.Html as Html
import Std.Option as Option
import Std.Url as Url
import Service.Packages as Packages
import View.Markdown as Markdown
import View.Packages.Frame as Frame

/// The day part of an RFC 3339 time.
export fn day(stamp: Str) -> Str { if stamp.length() >= 10 { stamp.take(10) } else { stamp } }

fn chip(text: Str, target: Str) -> H.Node {
  if target.isEmpty() { H.span().class("package-chip").says(text) } else { H.a().class("package-chip").href(target).says(text) }
}

fn dependencyChip(packages: &Packages.Packages, name: Str, requirement: Str) -> H.Node {
  let slash = name.indexOf("/")
  let known = slash > 0 && Option.isSome(&Packages.find(packages, name.take(slash), name.drop(slash + 1)))
  H.li().holding([chip(name + " " + requirement, if known { "/" + name } else { "" })])
}

fn sideSection(title: Str, body: Array[H.Node]) -> H.Node {
  H.section().class("package-side-section").holding([H.h2().says(title)].concat(body))
}

fn sidebar(packages: &Packages.Packages, project: &Packages.Project) -> H.Node {
  var parts: Array[H.Node] = []
  if !project.keywords.isEmpty() {
    parts = parts.push(H.ul().class("package-chips").holding(project.keywords.map(|word: Str| H.li().holding([chip(word, "/packages/search?q=" + Url.encodeComponent(word))]))))
  }
  match Packages.latestRelease(project) {
    case Some(release) => {
      parts = parts.push(sideSection("Latest release", [
            H.p().holding([chip(release.version, Frame.tabPath(project, "releases")), H.span().class("package-muted").says(" " + day(release.publishedAt))]),
            H.a().href(Frame.tabPath(project, "releases")).says("All releases")
          ]))
      let dependencies = if release.dependencies.isEmpty() { [H.p().class("package-muted").says("None")] } else {
        [H.ul().class("package-chips").holding(release.dependencies.map(|pair: (Str, Str)| dependencyChip(packages, pair[0], pair[1])))]
      }
      parts = parts.push(sideSection("Dependencies", dependencies))
    }
    case None => {}
  }
  var facts: Array[H.Node] = []
  if !project.root.isEmpty() { facts = facts.concat([H.dt().says("Module root"), H.dd().holding([H.code().says(project.root)])]) }
  if !project.license.isEmpty() { facts = facts.concat([H.dt().says("License"), H.dd().says(project.license)]) }
  if !project.repository.isEmpty() {
    facts = facts.concat([H.dt().says("Repository"), H.dd().holding([H.a().href(project.repository).at("rel", "external noopener noreferrer").says(project.repository.drop(8))])])
  }
  if !facts.isEmpty() { parts = parts.push(H.dl().class("package-facts").holding(facts)) }
  H.aside().class("package-side").holding(parts)
}

fn readme(project: &Packages.Project) -> H.Node {
  if project.readme.trim().isEmpty() {
    return H.section().class("package-readme doc").holding([H.h1().says(project.name), H.p().class("package-muted").says("This project has no README.")])
  }
  let read = Markdown.parse(&project.readme.split("\n"))
  let title = if read.title.isEmpty() { [H.h1().says(project.name)] } else { [H.h1().says(read.title)] }
  H.section().class("package-readme doc").holding([H.span().class("package-label").says("README")].concat(title).concat(read.blocks))
}

/// The project's landing page: its README beside what it is and what it needs.
export fn overview(siteUrl: Str, packages: &Packages.Packages, project: &Packages.Project) -> Html.Html {
  let description = if project.description.isEmpty() { project.name + ", a Pudu package." } else { project.description }
  Frame.page(siteUrl, packages, project, "overview", project.name, description, [
      H.div().class("package-columns").holding([sidebar(packages, project), readme(project)])
    ])
}

fn commitLink(project: &Packages.Project, release: &Packages.Release) -> H.Node {
  if release.commit.isEmpty() || project.repository.isEmpty() { return H.nothing() }
  H.a().class("package-commit").href(project.repository + "/tree/" + release.commit).at("rel", "external noopener noreferrer").says(release.commit.take(7))
}

fn byline(project: &Packages.Project, release: &Packages.Release) -> H.Node {
  H.p().class("package-byline").holding([
      H.span().says(if release.publisher.isEmpty() { "" } else { "@" + release.publisher + " · " }),
      H.span().says(day(release.publishedAt) + " · "),
      commitLink(project, release)
    ])
}

/// The latest release with its notes and install command, then every earlier one.
export fn releases(siteUrl: Str, packages: &Packages.Packages, project: &Packages.Project) -> Html.Html {
  var content: Array[H.Node] = [H.h1().says("Releases"), H.p().class("section-lead").says("Every release of " + project.name + ". A release never changes; a yanked one still installs from an existing lock.")]
  match Packages.latestRelease(project) {
    case Some(latest) => {
      let notes = if latest.notes.trim().isEmpty() { [H.p().class("package-muted").says("No notes were published with this release.")] } else { Markdown.parse(&latest.notes.split("\n")).blocks }
      content = content.push(H.section().class("package-release").holding([
            H.h2().class("package-release-version").says(latest.version),
            byline(project, &latest),
            H.div().class("package-release-notes doc").holding(notes),
            H.div().class("package-release-actions").holding([
                H.code().class("install-text").says(Frame.installCommand(project, latest.version)),
                H.a().href(Frame.tabPath(project, "source")).says("Browse the source")
              ])
          ]))
    }
    case None => { content = content.push(H.p().says("No release has been published yet.")) }
  }
  let earlier = project.releases.filter(|release: Packages.Release| Some(release.version) != project.latest)
  if !earlier.isEmpty() {
    var rows: Array[H.Node] = []
    for release in earlier {
      rows = rows.push(H.tr().holding([
            H.td().holding([H.strong().says(release.version)].concat(if release.yanked { [H.span().class("package-yanked").says(" yanked")] } else { [] })),
            H.td().says(day(release.publishedAt)),
            H.td().says(if release.publisher.isEmpty() { "" } else { "@" + release.publisher }),
            H.td().holding([commitLink(project, &release)])
          ]))
    }
    content = content.concat([
        H.h2().says("Earlier releases"),
        H.table().class("package-release-table").holding([
            H.thead().holding([H.tr().holding([H.th().says("Version"), H.th().says("Published"), H.th().says("By"), H.th().says("Commit")])]),
            H.tbody().holding(rows)
          ])
      ])
  }
  Frame.page(siteUrl, packages, project, "releases", project.name + " releases", "Every release of " + project.name + ", with notes and install commands.", [H.section().class("package-body").holding(content)])
}
