module View.Syntax

import Std.Html.Build as H

/// The words the playground paints as keywords.
const KEYWORDS: Set[Str] = setOf([
    "module", "import", "export", "as", "let", "var", "const", "mut", "fn", "async", "return", "if", "else",
    "match", "case", "for", "in", "while", "loop", "break", "continue", "type", "enum", "struct", "trait",
    "impl", "where", "await", "task", "spawn", "comptime", "macro", "unsafe", "with", "scope", "dynamic",
    "foreign"
  ])

/// The words painted as literals.
const LITERALS: Set[Str] = setOf(["true", "false", "null"])

/// Operators of more than one character, longest first.
const LONG_OPERATORS: Array[Str] = ["..=", "=>", "->", "==", "!=", "<=", ">=", "&&", "||", ".."]

/// Operators of one character.
const SHORT_OPERATORS: Str = "-+*/%=<>!&|^?:."

/// A number's width suffixes, each tried before any it begins with.
const NUMBER_SUFFIXES: Array[Str] = ["i128", "u128", "i16", "i32", "i64", "u16", "u32", "u64", "i8", "u8", "f32", "f64", "d"]

/// The shell's operators, longest first.
const SHELL_OPERATORS: Array[Str] = ["&&", "||", ">>", "|", ";", ">", "<", "&"]

/// The languages painted as a shell.
const SHELLS: Set[Str] = setOf(["sh", "shell", "bash", "console"])

/// A painted block's nodes for a language it paints, or `None` to leave it plain.
export fn painted(language: Str, text: Str) -> Option[Array[H.Node]] {
  let named = language.toLower()
  if named == "pudu" { return Some(pudu(text)) }
  if SHELLS.contains(named) { return Some(shell(text)) }
  None
}

/// Pudu source painted as the playground paints it.
export fn pudu(text: Str) -> Array[H.Node] {
  let cs = text.chars()
  let count = cs.length()
  var out: Array[H.Node] = []
  var index = 0
  while index < count {
    let c = cs[index]
    let next = at(&cs, index + 1)
    var stop = index + 1
    var kind = ""
    if c == '/' && next == '/' {
      stop = lineEnd(&cs, index)
      kind = if next == '/' && at(&cs, index + 2) == '/' && at(&cs, index + 3) != '/' { "doc" } else { "comment" }
    } else if c == '/' && next == '*' {
      stop = blockCommentEnd(&cs, index)
      kind = "comment"
    } else if c == '"' {
      let found = stringFrom(text, &cs, index)
      out = out.concat(found[0])
      index = found[1]
      continue
    } else if isBlank(c) {
      while stop < count && isBlank(cs[stop]) { stop = stop + 1 }
    } else if c == '\'' && characterEnd(&cs, index) > index {
      stop = characterEnd(&cs, index)
      kind = "string"
    } else if isDigit(c) {
      stop = numberEnd(text, &cs, index)
      kind = "number"
    } else if isWordStart(c) {
      while stop < count && isWordPart(cs[stop]) { stop = stop + 1 }
      kind = wordKind(text.slice(index, stop), at(&cs, stop))
    } else if c == '@' && (isLower(next) || next == '_') {
      stop = index + 2
      while stop < count && isWordPart(cs[stop]) { stop = stop + 1 }
      kind = "label"
    } else {
      let length = operatorLength(text.drop(index), c)
      if length > 0 {
        stop = index + length
        kind = "operator"
      }
    }
    out = put(out, kind, text.slice(index, stop))
    index = stop
  }
  out
}

/// Shell commands painted: comments, quoted text, variables, options,
/// command words, and operators.
export fn shell(text: Str) -> Array[H.Node] {
  let cs = text.chars()
  let count = cs.length()
  var out: Array[H.Node] = []
  var index = 0
  var commandNext = true
  while index < count {
    let c = cs[index]
    let previous = if index == 0 { '\n' } else { cs[index - 1] }
    var stop = index + 1
    var kind = ""
    if c == '\n' {
      commandNext = true
    } else if isBlank(c) {
      while stop < count && cs[stop] != '\n' && isBlank(cs[stop]) { stop = stop + 1 }
    } else if c == '#' && isBlank(previous) {
      stop = lineEnd(&cs, index)
      kind = "comment"
    } else if c == '"' || c == '\'' {
      stop = index + 1
      while stop < count && cs[stop] != c && cs[stop] != '\n' {
        stop = if cs[stop] == '\\' && c == '"' { stop + 2 } else { stop + 1 }
      }
      stop = if stop < count && cs[stop] == c { stop + 1 } else { clamp(stop, count) }
      kind = "string"
      commandNext = false
    } else if c == '$' && at(&cs, index + 1) == '{' {
      let close = findFrom(&cs, '}', index)
      stop = if close < 0 { index + 2 } else { close + 1 }
      kind = "interpolation"
    } else if c == '$' && isWordStart(at(&cs, index + 1)) {
      stop = index + 2
      while stop < count && isWordPart(cs[stop]) { stop = stop + 1 }
      kind = "interpolation"
    } else {
      let operator = shellOperator(text.drop(index))
      if operator > 0 {
        stop = index + operator
        kind = "operator"
        commandNext = true
      } else {
        while stop < count && !isBlank(cs[stop]) && !isShellBreak(cs[stop]) { stop = stop + 1 }
        kind = if c == '-' { "type" } else if commandNext && !isDigit(c) { "function" } else { "" }
        commandNext = c == '('
      }
    }
    out = put(out, kind, text.slice(index, stop))
    index = stop
  }
  out
}

/// The nodes with one more run: a `tok-` span for a kind, text for none.
fn put(out: Array[H.Node], kind: Str, piece: Str) -> Array[H.Node] {
  if piece.isEmpty() { return out }
  out.push(if kind.isEmpty() { H.words(piece) } else { H.span().class("tok-" + kind).says(piece) })
}

/// The character at a position, or a space past the end.
fn at(cs: &Array[Char], index: Int) -> Char {
  if index < cs.length() { cs[index] } else { ' ' }
}

fn clamp(index: Int, count: Int) -> Int { if index > count { count } else { index } }

/// Whether a character is one of those a text lists.
fn holds(listed: Str, c: Char) -> Bool { listed.chars().contains(c) }

fn isBlank(c: Char) -> Bool { c == ' ' || c == '\t' || c == '\n' }

fn isDigit(c: Char) -> Bool { c >= '0' && c <= '9' }

fn isLower(c: Char) -> Bool { c >= 'a' && c <= 'z' }

fn isUpper(c: Char) -> Bool { c >= 'A' && c <= 'Z' }

fn isWordStart(c: Char) -> Bool { isLower(c) || isUpper(c) || c == '_' }

fn isWordPart(c: Char) -> Bool { isWordStart(c) || isDigit(c) }

fn isShellBreak(c: Char) -> Bool { c == '|' || c == ';' || c == '&' || c == '>' || c == '<' || c == '"' || c == '\'' }

/// Where the line holding `from` ends.
fn lineEnd(cs: &Array[Char], from: Int) -> Int {
  var index = from
  while index < cs.length() && cs[index] != '\n' { index = index + 1 }
  index
}

/// The first position of a character at or after `from`, or -1.
fn findFrom(cs: &Array[Char], wanted: Char, from: Int) -> Int {
  var index = from
  while index < cs.length() {
    if cs[index] == wanted { return index }
    index = index + 1
  }
  -1
}

/// Where a block comment ends; block comments nest.
fn blockCommentEnd(cs: &Array[Char], from: Int) -> Int {
  var depth = 0
  var index = from
  while index < cs.length() {
    if cs[index] == '/' && at(cs, index + 1) == '*' {
      depth = depth + 1
      index = index + 2
    } else if cs[index] == '*' && at(cs, index + 1) == '/' {
      depth = depth - 1
      index = index + 2
      if depth == 0 { return index }
    } else {
      index = index + 1
    }
  }
  cs.length()
}

/// Where a character literal starting at `from` ends, or `from` when it is not one.
fn characterEnd(cs: &Array[Char], from: Int) -> Int {
  let first = at(cs, from + 1)
  if first == '\\' && from + 2 < cs.length() && cs[from + 2] != '\n' && at(cs, from + 3) == '\'' { return from + 4 }
  if from + 1 < cs.length() && first != '\'' && first != '\\' && first != '\n' && at(cs, from + 2) == '\'' { return from + 3 }
  from
}

/// Where a number starting at `from` ends, with its base, separators,
/// fraction, exponent, and width suffix.
fn numberEnd(text: Str, cs: &Array[Char], from: Int) -> Int {
  let count = cs.length()
  let base = if cs[from] == '0' { at(cs, from + 1) } else { ' ' }
  var index = from + 1
  let prefixed = if base == 'x' { "0123456789abcdefABCDEF_" } else if base == 'b' { "01_" } else if base == 'o' { "01234567_" } else { "" }
  if !prefixed.isEmpty() && from + 2 < count && holds(prefixed, cs[from + 2]) {
    index = from + 2
    while index < count && holds(prefixed, cs[index]) { index = index + 1 }
  } else {
    while index < count && (isDigit(cs[index]) || cs[index] == '_') { index = index + 1 }
    if at(cs, index) == '.' && isDigit(at(cs, index + 1)) {
      index = index + 2
      while index < count && (isDigit(cs[index]) || cs[index] == '_') { index = index + 1 }
    }
    if at(cs, index) == 'e' || at(cs, index) == 'E' {
      let sign = if at(cs, index + 1) == '+' || at(cs, index + 1) == '-' { 1 } else { 0 }
      if isDigit(at(cs, index + 1 + sign)) {
        index = index + 1 + sign
        while index < count && isDigit(cs[index]) { index = index + 1 }
      }
    }
  }
  let rest = text.drop(index)
  for suffix in NUMBER_SUFFIXES {
    if rest.startsWith(suffix) { return index + suffix.length() }
  }
  index
}

/// How a word is painted, from the word and the character after it.
fn wordKind(word: Str, after: Char) -> Str {
  if KEYWORDS.contains(word) { return "keyword" }
  if LITERALS.contains(word) { return "literal" }
  let first = word.chars()[0]
  if isUpper(first) {
    let capitals = word.length() > 1 && word.spanOf("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_") == word.length()
    return if capitals { "constant" } else { "type" }
  }
  if after == '(' { "function" } else { "" }
}

/// How long the operator starting `rest` is, or 0.
fn operatorLength(rest: Str, first: Char) -> Int {
  for operator in LONG_OPERATORS {
    if rest.startsWith(operator) { return operator.length() }
  }
  if holds(SHORT_OPERATORS, first) { 1 } else { 0 }
}

/// How long the shell operator starting `rest` is, or 0.
fn shellOperator(rest: Str) -> Int {
  for operator in SHELL_OPERATORS {
    if rest.startsWith(operator) { return operator.length() }
  }
  0
}

/// A string literal's runs from its opening quote, with escapes and
/// interpolations apart, and where it ends; it never spans a line.
fn stringFrom(text: Str, cs: &Array[Char], from: Int) -> (Array[H.Node], Int) {
  let count = cs.length()
  var out: Array[H.Node] = []
  var index = from + 1
  var start = from
  while index < count && cs[index] != '\n' {
    let c = cs[index]
    if c == '\\' {
      out = put(out, "string", text.slice(start, index))
      let unicode = at(cs, index + 1) == 'u' && at(cs, index + 2) == '{'
      let close = if unicode { findFrom(cs, '}', index) } else { -1 }
      let end = clamp(if close < 0 { index + 2 } else { close + 1 }, count)
      out = put(out, "escape", text.slice(index, end))
      index = end
      start = index
    } else if c == '{' {
      out = put(out, "string", text.slice(start, index))
      let close = findFrom(cs, '}', index)
      let crosses = close >= 0 && lineEnd(cs, index) < close
      let end = if close < 0 || crosses { index + 1 } else { close + 1 }
      out = put(out, "interpolation", text.slice(index, end))
      index = end
      start = index
    } else if c == '"' {
      out = put(out, "string", text.slice(start, index + 1))
      return (out, index + 1)
    } else {
      index = index + 1
    }
  }
  (put(out, "string", text.slice(start, index)), index)
}
