module View.Download

import Std.Html.Build as H
import Std.Html as Html
import Constants as Constants
import Service.Releases as Releases
import View.Layout as Layout

export fn page(siteUrl: Str, release: &Releases.Release) -> Html.Html {
  Layout.page(
    siteUrl,
    "Download Pudu " + release.version,
    "Download Pudu " + release.version + " for macOS and Linux. Each archive carries the compiler and the standard library beside it.",
    "/download",
    true,
    None,
    H.article().class("doc download").holding([
        H.span().class("kind").says("download"),
        H.h1().says("Download Pudu"),
        H.p().holding(heading(release)),
        H.div().class("download-cards").holding(cards(&release.downloads)),
        H.h2().says("Check what you downloaded"),
        H.p().says("Every archive is published with the SHA-256 checksum of its contents. Check the archive against it before you unpack it, so a download that was truncated or altered is caught rather than installed."),
        H.pre().class("code-block").holding([H.code().says(instructions(release))]),
        H.p().says("The archive carries the standard library beside the executable, so nothing else is installed and removing the directory removes Pudu."),
        H.h2().says("All archives"),
        H.div().class("table-wrap").holding([
            H.table().class("download-table").holding([
                H.thead().holding([
                    H.tr().holding([
                        H.th().says("OS"),
                        H.th().says("Arch"),
                        H.th().says("File"),
                        H.th().says("Size"),
                        H.th().says("SHA-256")
                      ])
                  ]),
                H.tbody().holding(rows(&release.downloads))
              ])
          ]),
        H.h2().says("Other platforms"),
        H.p().says("Windows is not supported yet, and no archive is published for Linux on ARM. On a machine without an archive, build the compiler from source: the repository's README gives the steps and the versions they need."),
        H.p().holding([
            H.span().says("Release notes for every version are on the "),
            H.a().href(release.releasesUrl).at("rel", "external noopener noreferrer").says("releases page"),
            H.span().says(", and the source is on "),
            H.a().href(Constants.REPOSITORY_URL).at("rel", "external noopener noreferrer").says("GitHub"),
            H.span().says(". New to the language? Start with the "),
            H.a().href("/docs").says("documentation"),
            H.span().says(".")
          ])
      ]).html()
  )
}

/// The line under the title: which version this is, and what it promises.
fn heading(release: &Releases.Release) -> Array[H.Node] {
  let released = [
    H.strong().says("Pudu " + release.version),
    H.span().says(" was published on " + release.published + ".")
  ]
  if release.prerelease {
    released.concat([
        H.span().says(" This is a pre-release: it is for writing programs and reporting what gets in the way, and the language and its standard library may still change.")
      ])
  } else {
    released
  }
}

fn cards(downloads: &Array[Releases.Download]) -> Array[H.Node] {
  var built: Array[H.Node] = []
  for download in downloads {
    built = built.push(H.div().class("download-card").holding([
          H.h3().says(download.os),
          H.p().class("download-arch").says(download.arch + " · " + download.note),
          H.a().class("download-link").href(download.url).says("Download " + download.size),
          H.p().class("download-file").holding([H.code().says(download.file)])
        ]))
  }
  built
}

fn rows(downloads: &Array[Releases.Download]) -> Array[H.Node] {
  var built: Array[H.Node] = []
  for download in downloads {
    built = built.push(H.tr().holding([
          H.td().says(download.os),
          H.td().says(download.arch),
          H.td().holding([H.a().href(download.url).holding([H.code().says(download.file)])]),
          H.td().says(download.size),
          H.td().holding([H.code().class("download-checksum").says(download.checksum)])
        ]))
  }
  built
}

/// The commands that check an archive and put its executable on a path.
///
/// One archive is named rather than a placeholder a reader has to substitute,
/// so the block can be copied and run as it stands.
fn instructions(release: &Releases.Release) -> Str {
  let first = release.downloads[0]
  let stem = first.file.take(first.file.length() - ".tar.gz".length())
  "shasum -a 256 -c " + first.file + ".sha256\n"
    + "tar -xzf " + first.file + "\n"
    + "export PATH=\"$PWD/" + stem + "/bin:$PATH\"\n"
    + "pudu version"
}
