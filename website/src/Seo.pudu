module Seo

import Std.Html.Build as H
import Std.Json as Json
import Std.Map as Map
import Std.Option as Option
import Std.Url as Url
import Constants as Constants
import Domain.Entry as Domain
import Service.Catalog as Catalog
import Service.Docs as Docs
import Service.Packages as Packages
import Service.Playground.Examples as Examples

export fn head(
  siteUrl: Str,
  title: Str,
  description: Str,
  path: Str,
  indexable: Bool,
  structured: Option[Json.Json]
) -> Array[H.Node] {
  let canonical = siteUrl + path
  var nodes = [
    H.tag("title").says(title + " | " + Constants.SITE_NAME),
    H.meta().name("description").at("content", description),
    H.meta().name("robots").at("content", if indexable { "index,follow,max-image-preview:large" } else { "noindex,follow" }),
    H.link().rel("canonical").href(canonical),
    property("og:type", "website"),
    property("og:site_name", Constants.SITE_NAME),
    property("og:title", title + " | " + Constants.SITE_NAME),
    property("og:description", description),
    property("og:url", canonical),
    property("og:image", siteUrl + Constants.SOCIAL_IMAGE_PATH),
    property("og:image:width", "1200"),
    property("og:image:height", "630"),
    property("og:image:alt", "The Pudu logo"),
    H.meta().name("twitter:card").at("content", "summary_large_image"),
    H.meta().name("twitter:title").at("content", title + " | " + Constants.SITE_NAME),
    H.meta().name("twitter:description").at("content", description),
    H.meta().name("twitter:image").at("content", siteUrl + Constants.SOCIAL_IMAGE_PATH)
  ]
  if let Some(value) = structured {
    let safe = Json.encode(&value).replace("</", "<\\/")
    nodes = nodes.push(H.script().kind("application/ld+json").raw(safe))
  }
  nodes
}

export fn websiteSchema(siteUrl: Str) -> Json.Json {
  Json.object(&[
      ("@context", Json.Text("https://schema.org")),
      ("@type", Json.Text("WebSite")),
      ("name", Json.Text(Constants.SITE_NAME)),
      ("url", Json.Text(siteUrl)),
      ("description", Json.Text(Constants.SITE_DESCRIPTION))
    ])
}

export fn symbolSchema(siteUrl: Str, entry: &Domain.Entry) -> Json.Json {
  Json.object(&[
      ("@context", Json.Text("https://schema.org")),
      ("@type", Json.Text("TechArticle")),
      ("headline", Json.Text(Domain.qualifiedName(entry))),
      ("description", Json.Text(Domain.summary(entry))),
      ("url", Json.Text(siteUrl + symbolPath(entry))),
      ("isPartOf", Json.object(&[
            ("@type", Json.Text("WebSite")),
            ("name", Json.Text(Constants.SITE_NAME)),
            ("url", Json.Text(siteUrl))
          ]))
    ])
}

export fn aboutSchema(siteUrl: Str) -> Json.Json {
  Json.object(&[
      ("@context", Json.Text("https://schema.org")),
      ("@type", Json.Text("AboutPage")),
      ("name", Json.Text("About Pudu")),
      ("url", Json.Text(siteUrl + "/about")),
      ("about", Json.object(&[
            ("@type", Json.Text("SoftwareSourceCode")),
            ("name", Json.Text(Constants.SITE_NAME)),
            ("programmingLanguage", Json.Text(Constants.SITE_NAME)),
            ("codeRepository", Json.Text(Constants.REPOSITORY_URL))
          ])),
      ("author", Json.object(&[
            ("@type", Json.Text("Person")),
            ("name", Json.Text(Constants.AUTHOR_NAME)),
            ("sameAs", Json.List([
                  Json.Text(Constants.AUTHOR_LINKEDIN_URL),
                  Json.Text(Constants.AUTHOR_GITHUB_URL)
                ]))
          ]))
    ])
}

export fn robots(siteUrl: Str) -> Str {
  "User-agent: *\nAllow: /\nSitemap: " + siteUrl + "/sitemap.xml\n"
}

/// Every page the site has, as the paths a request arrives on.
///
/// One list rather than one per reader. The sitemap is built from it and so is
/// the prerender, and those two disagreeing is not a small thing: a page in the
/// sitemap that was not rendered is a crawler following a link to nothing, and a
/// page rendered but absent from the sitemap is one nobody is told about.
///
/// A symbol can be reached by more than one declaration sharing a name, so the
/// paths are deduplicated here: rendering one twice is work done twice, and
/// listing it twice is a sitemap a crawler reports as containing duplicates.
export fn paths(catalog: &Catalog.Catalog, docs: &Docs.Docs, examples: &Examples.Examples, packages: &Packages.Packages) -> Array[Str] {
  var found = ["/", "/docs", "/playground", "/download", "/releases", "/about", "/conduct", "/contributing", "/security", "/community", "/privacy", "/brand", "/donate", "/modules"]
  for page in docs.pages {
    found = found.push("/docs/" + Url.encodeComponent(page.slug))
  }
  // The first example is what `/playground` itself shows, so it is listed
  // once, under that address.
  var first = true
  for example in examples.entries {
    if !first { found = found.push("/playground/" + Url.encodeComponent(example.slug)) }
    first = false
  }
  for moduleName in catalog.modules {
    found = found.push("/module/" + Url.encodeComponent(moduleName))
  }
  var seen: Map[Str, Bool] = mapOf([])
  for entry in catalog.entries {
    let path = symbolPath(&entry)
    if !Map.containsKey(&seen, path) {
      seen = seen.insert(path, true)
      found = found.push(path)
    }
  }
  found = found.push("/packages")
  if Packages.present(packages) {
    var handles: Map[Str, Bool] = mapOf([])
    for project in packages.projects {
      if !Map.containsKey(&handles, project.handle) {
        handles = handles.insert(project.handle, true)
        found = found.push("/" + project.handle)
      }
      let base = "/" + project.name
      found = found.concat([base, base + "/source", base + "/docs", base + "/releases"])
      for file in project.files {
        var segments: Array[Str] = []
        for segment in file.split("/") { segments = segments.push(Url.encodeComponent(segment)) }
        found = found.push(base + "/source/" + segments.join("/"))
      }
    }
  }
  found
}

export fn sitemap(siteUrl: Str, catalog: &Catalog.Catalog, docs: &Docs.Docs, examples: &Examples.Examples, packages: &Packages.Packages) -> Str {
  var body = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n"
  for path in paths(catalog, docs, examples, packages) { body = body + "  <url><loc>" + siteUrl + path + "</loc></url>\n" }
  body + "</urlset>\n"
}

export fn symbolPath(entry: &Domain.Entry) -> Str {
  "/docs/" + Url.encodeComponent(entry.moduleName) + "/" + Url.encodeComponent(Domain.category(entry)) + "/" + Url.encodeComponent(entry.name)
}

fn property(name: Str, content: Str) -> H.Node {
  H.meta().at("property", name).at("content", content)
}
