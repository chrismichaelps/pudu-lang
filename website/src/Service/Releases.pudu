module Service.Releases

import Std.Io as Io
import Std.Json as Json
import Std.Option as Option
import Error as SiteError

/// One archive a release publishes, as a reader choosing a download sees it.
export type Download = {
  os: Str,
  arch: Str,
  note: Str,
  target: Str,
  file: Str,
  size: Str,
  url: Str,
  checksum: Str
}

/// The release the download page offers.
export type Release = {
  version: Str,
  tag: Str,
  url: Str,
  published: Str,
  prerelease: Bool,
  releasesUrl: Str,
  downloads: Array[Download]
}

/// The published release, read from the document the build writes.
///
/// The archives are read once, before any request, so the page answers from the
/// CDN without waiting on the forge and cannot be taken down by a rate limit. A
/// document that cannot be read or does not carry a download stops the site from
/// starting rather than offering a reader a page with nothing to take.
export fn load(path: Str) -> Result[Release, SiteError.SiteError] {
  let source = match Io.read(path) {
    case Ok(content) => content
    case Err(_) => { return Err(SiteError.ReleasesUnreadable(path)) }
  }
  let document = match Json.decode(source) {
    case Ok(value) => value
    case Err(_) => { return Err(SiteError.ReleasesInvalid) }
  }
  let schemaVersion = match Json.field(&document, "schemaVersion") {
    case Some(value) => Json.asInt(&value)
    case None => None
  }
  if schemaVersion != Some(1) { return Err(SiteError.ReleasesInvalid) }
  let raw = match Json.field(&document, "downloads") {
    case Some(value) => value
    case None => { return Err(SiteError.ReleasesInvalid) }
  }
  let values = match Json.asList(&raw) {
    case Some(items) => items
    case None => { return Err(SiteError.ReleasesInvalid) }
  }
  var downloads: Array[Download] = []
  for value in values {
    match readDownload(&value) {
      case Some(download) => { downloads = downloads.push(download) }
      case None => { return Err(SiteError.ReleasesInvalid) }
    }
  }
  if downloads.length() == 0 { return Err(SiteError.ReleasesEmpty) }
  Ok(Release {
      version: text(&document, "version") ?,
      tag: text(&document, "tag") ?,
      url: text(&document, "url") ?,
      published: text(&document, "published") ?,
      prerelease: Option.unwrapOr(flag(&document, "prerelease"), false),
      releasesUrl: text(&document, "releasesUrl") ?,
      downloads: downloads
    })
}

fn readDownload(value: &Json.Json) -> Option[Download] {
  Some(Download {
      os: reading(value, "os") ?,
      arch: reading(value, "arch") ?,
      note: reading(value, "note") ?,
      target: reading(value, "target") ?,
      file: reading(value, "file") ?,
      size: reading(value, "size") ?,
      url: reading(value, "url") ?,
      checksum: reading(value, "checksum") ?
    })
}

fn reading(value: &Json.Json, name: Str) -> Option[Str] {
  let found = Json.field(value, name) ?
  Json.asText(&found)
}

fn text(document: &Json.Json, name: Str) -> Result[Str, SiteError.SiteError] {
  match reading(document, name) {
    case Some(value) => Ok(value)
    case None => Err(SiteError.ReleasesInvalid)
  }
}

fn flag(document: &Json.Json, name: Str) -> Option[Bool] {
  let found = Json.field(document, name) ?
  Json.asBool(&found)
}
