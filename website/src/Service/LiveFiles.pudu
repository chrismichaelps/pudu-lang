module Service.LiveFiles

import Std.Concurrent as Concurrent
import Std.List as List
import Std.Url as Url
import Domain.Declarations as Declarations
import Domain.Entry as Domain
import Service.Catalog as Catalog
import Service.LiveJson as J
import Service.LiveRelease as Release
import Service.LiveSource as Source

const API: Str = "https://api.github.com/repos/"
/// What one release's Source tab lists and previews, as the build bounds it.
const MOST_FILES: Int = 2000
const MOST_BYTES: Int = 1048576
/// Source files read to describe a release that carries no catalogue, and
/// how many are read at once from the raw host.
const MOST_SOURCES: Int = 400
const SOURCE_WORKERS: Int = 16

/// The Source tab opens the README, then the manifest, then the first file.
export fn defaultFile(files: &Array[Str]) -> Str {
  for wanted in ["README.md", "pudu.toml"] {
    if files.contains(wanted) { return wanted }
  }
  if files.isEmpty() { "" } else { files[0] }
}

/// Whether a release file is one a package ships: nothing under a dot
/// directory or named with a leading dot, and nothing under a top-level `deps/`,
/// which holds installed dependencies rather than the package's own code.
export fn shipped(path: Str) -> Bool {
  if path.isEmpty() || path == "deps" || path.startsWith("deps/") { return false }
  for part in path.split("/") {
    if part.isEmpty() || part.startsWith(".") { return false }
  }
  true
}

/// The files at a release's commit, sorted, at most `MOST_FILES` of them and
/// none larger than `MOST_BYTES`. The tree is addressed by the commit, so what
/// it lists never changes and is remembered for as long as the cache holds it.
/// `None` when GitHub cannot list the tree.
export fn listed(source: &Source.Source, path: Str, commit: Str) -> Option[Array[Str]] {
  if path.isEmpty() || commit.isEmpty() { return None }
  let tree = J.decoded(Source.text(source, API + path + "/git/trees/" + commit + "?recursive=1", &Source.immutable())) ?
  var found: Array[Str] = []
  for item in J.list(&tree, "tree") {
    let name = J.text(&item, "path")
    if J.text(&item, "type") == "blob" && J.whole(&item, "size") <= MOST_BYTES && shipped(name) && found.length() < MOST_FILES {
      found = found.push(name)
    }
  }
  Some(List.sorted(&found))
}

/// One file's bytes at a release's commit, read from the raw host, which
/// does not spend the API's rate limit. Immutable for the same reason the tree is.
export fn body(source: &Source.Source, path: Str, commit: Str, file: Str) -> Option[Bytes] {
  if !shipped(file) { return None }
  let encoded = file.split("/").map(|part: Str| Url.encodeComponent(part)).join("/")
  match Source.read(source, Release.RAW + path + "/" + commit + "/" + encoded, &Source.immutable()) {
    case Source.Found(held) => Some(held)
    case _ => None
  }
}

/// The API catalogue `pudu release` attached to a release as `pudu-api.json`.
/// Remembered with the `changing` freshness rather than as immutable: a
/// release published without one answers 404, and a catalogue attached later,
/// by a release run again, must appear within minutes. `None` when there is
/// none, and the Docs tab then says it has no reference for the release.
export fn catalogue(source: &Source.Source, path: Str, tag: Str) -> Option[Catalog.Catalog] {
  if path.isEmpty() || tag.isEmpty() { return None }
  let text = Source.text(source, "https://github.com/" + path + "/releases/download/" + Url.encodeComponent(tag) + "/pudu-api.json", &Source.changing()) ?
  match Catalog.parse(text) {
    case Ok(found) => Some(found)
    case Err(_) => None
  }
}

/// The API reference of a release that carries no `pudu-api.json`, read from
/// its own sources at the release's commit: every `.pudu` file of the package's
/// root module and the modules under it, outside `test/` and `tests/`. Each
/// file is addressed by the commit, so it is read once and remembered as
/// immutable; files are read several at a time. A file that cannot be read is
/// left out rather than failing the page. `None` when no declaration is found.
export fn derived(source: &Source.Source, path: Str, commit: Str, root: Str) -> Option[Catalog.Catalog] {
  if root.isEmpty() { return None }
  let files = listed(source, path, commit) ?
  let wanted = List.take(&files.filter(|file: Str| ofRoot(file, root)), MOST_SOURCES)
  let shared = *source
  let readOne = fn(file: Str) -> Option[Declarations.Declared] {
    let text = Source.text(&shared, Release.RAW + path + "/" + commit + "/" + file.split("/").map(|part: Str| Url.encodeComponent(part)).join("/"), &Source.immutable()) ?
    Declarations.read(text)
  }
  let read = match Concurrent.mapBounded(&wanted, SOURCE_WORKERS, readOne) {
    case Ok(found) => found
    case Err(_) => wanted.map(readOne)
  }
  var entries: Array[Domain.Entry] = []
  for declared in read {
    if let Some(held) = declared {
      if held.moduleName == root || held.moduleName.startsWith(root + ".") { entries = entries.concat(held.entries) }
    }
  }
  Catalog.fromEntries("", entries)
}

/// Whether a release file is a source of the package's root module or one under
/// it: `…/Root.pudu` or a `.pudu` file inside a `…/Root/` directory, never a suite.
export fn ofRoot(file: Str, root: Str) -> Bool {
  if !file.endsWith(".pudu") || file.startsWith("test/") || file.startsWith("tests/") { return false }
  let rooted = root.replace(".", "/")
  file == rooted + ".pudu" || file.endsWith("/" + rooted + ".pudu") || file.startsWith(rooted + "/") || file.contains("/" + rooted + "/")
}
