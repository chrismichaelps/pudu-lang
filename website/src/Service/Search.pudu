module Service.Search

import Std.List as List
import Std.Option as Option
import Domain.Entry as Domain
import Domain.Search as Query

/// An entry with every text a query is compared against, written the way the
/// comparison reads it: lowered, and the signature normalised as a type.
///
/// A query compares each of these against every entry, so preparing them per
/// query lowered three thousand names, signatures, and documentation blocks
/// for every search, and that was nearly all a search cost.
export type Indexed = {
  entry: Domain.Entry,
  qualifiedName: Str,
  name: Str,
  moduleName: Str,
  leaf: Str,
  qualified: Str,
  signature: Str,
  typeShape: Str,
  prose: Str
}

/// The catalogue as a query reads it, prepared once before the first request,
/// in qualified-name order: the tie-break every ranking ends with.
export type Index = { entries: Array[Indexed] }

export fn index(entries: &Array[Domain.Entry]) -> Index {
  var prepared: Array[Indexed] = []
  for entry in entries {
    let qualifiedName = Domain.qualifiedName(&entry)
    prepared = prepared.push(Indexed {
        entry: entry,
        qualifiedName: qualifiedName,
        name: entry.name.toLower(),
        moduleName: entry.moduleName.toLower(),
        leaf: Query.moduleLeaf(entry.moduleName),
        qualified: qualifiedName.toLower(),
        signature: entry.signature.toLower(),
        typeShape: Query.normalizeType(entry.signature),
        // A term never holds a line break, so one text finds it in any line.
        prose: entry.documentation.join("\n").toLower()
      })
  }
  Index{entries: List.sortBy(&prepared, fn(left: Indexed, right: Indexed) -> Bool { left.qualifiedName < right.qualifiedName })}
}

/// The entries matching `query`, best first, at most `limit` of them.
///
/// A score takes one of a few values, and the index is already in the order
/// ties are broken by, so hits are taken score by score, highest first, in the
/// index's order: no hit is compared with another.
export fn ranked(prepared: &Index, query: Str, limit: Int) -> Array[Domain.Hit] {
  let wanted = Query.parse(query)
  if !Query.hasIntent(&wanted) || limit <= 0 { return [] }
  var found: Array[Domain.Hit] = []
  var distinct: Set[Int] = setOf([])
  for candidate in prepared.entries {
    let score = scoreOf(&candidate, &wanted)
    if score > 0 {
      found = found.push(Domain.Hit{entry: candidate.entry, score: score})
      distinct = distinct.insert(score)
    }
  }
  let descending = List.sortBy(&distinct.toArray(), fn(left: Int, right: Int) -> Bool { left > right })
  var hits: Array[Domain.Hit] = []
  for score in descending {
    for hit in found {
      if hits.length() >= limit { return hits }
      if hit.score == score { hits = hits.push(hit) }
    }
  }
  hits
}

/// `ranked` over entries not yet prepared, for a caller that searches once.
export fn find(entries: &Array[Domain.Entry], query: Str, limit: Int) -> Array[Domain.Hit] {
  ranked(&index(entries), query, limit)
}

fn scoreOf(entry: &Indexed, query: &Query.Query) -> Int {
  if !moduleAllowed(entry, query.moduleFilter) { return 0 }
  if !kindAllowed(&entry.entry, query.kindFilter) { return 0 }

  let termPoints = termsScore(entry, &query.terms)
  if query.terms.length() > 0 && termPoints == 0 { return 0 }
  let typeScore = typeScoreOf(entry.typeShape, query.typeShape)
  if query.typeShape != None && typeScore == 0 { return 0 }

  let written = query.terms.join(" ")
  if query.exact && query.terms.length() > 0 && entry.name != written && entry.qualified != written {
    return 0
  }
  if query.typeShape == None && query.terms.length() == 1 && entry.leaf == query.terms[0] {
    return 1400 + termPoints
  }
  if entry.qualified == written { return 1320 + typeScore }
  if entry.name == written { return 1280 + typeScore }
  if query.terms.length() == 1 && entry.name.startsWith(written) { return 1100 + typeScore }
  if termPoints > 0 { return 700 + termPoints + typeScore }
  if typeScore > 0 { return typeScore }
  if query.moduleFilter != None || query.kindFilter != None { return 200 }
  0
}

fn moduleAllowed(entry: &Indexed, filter: Option[Str]) -> Bool {
  match filter {
    case None => true
    case Some(wanted) => entry.moduleName == wanted || entry.leaf == wanted
  }
}

fn kindAllowed(entry: &Domain.Entry, filter: Option[Str]) -> Bool {
  match filter {
    case None => true
    case Some(wanted) => Domain.category(entry).toLower() == wanted
  }
}

fn termsScore(entry: &Indexed, terms: &Array[Str]) -> Int {
  var score = 0
  for term in terms {
    let matched = termScore(entry, term)
    if matched == 0 { return 0 }
    score = score + matched
  }
  score
}

fn termScore(entry: &Indexed, term: Str) -> Int {
  if entry.name == term { return 180 }
  if entry.qualified == term { return 175 }
  if entry.name.startsWith(term) { return 150 }
  if entry.name.contains(term) { return 120 }
  if entry.leaf == term { return 110 }
  if entry.moduleName.contains(term) { return 90 }
  if entry.signature.contains(term) { return 60 }
  if entry.prose.contains(term) { return 30 }
  0
}

fn typeScoreOf(available: Str, query: Option[Str]) -> Int {
  match query {
    case None => 0
    case Some(wanted) => {
      if available == wanted { 1000 }
        else if available.contains(wanted) { 850 }
        else { 0 }
    }
  }
}
