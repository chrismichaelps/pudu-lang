module Service.LivePackages

import Std.List as List
import Std.Option as Option
import Std.Sync as Sync
import Service.LiveDiscussions as Discussions
import Service.LiveIndex as Index
import Service.LiveRelease as Release
import Service.LiveSource as Source
import Service.Packages as Packages

/// Repositories whose releases are read on one rebuild, new repositories
/// first. It bounds latency and rate-limit spend however many packages change
/// at once; the rest are read by the next rebuild.
const PROBES: Int = 16

/// How long a merged index is reused before it is rebuilt from remembered answers.
const MEMO_SECONDS: Int = 30

/// The merged index and whether GitHub contributed to it. A merge built from
/// the snapshot alone is cached briefly at the edge so recovery is quick.
export type View = { packages: Packages.Packages, live: Bool }

type Memo = { at: Int, view: Option[View] }

/// One snapshot's live overlay. A `Live` belongs to one snapshot: the memo does
/// not notice a different snapshot being passed in.
export type Live = { source: Source.Source, memo: Sync.Cell[Memo] }

export fn over(source: Source.Source) -> Live { Live{source: source, memo: Sync.cell(Memo{at: 0, view: None})} }

export fn offline() -> Live { over(Source.offline()) }

/// The packages to show now: the snapshot, with what GitHub says laid over it.
export fn current(live: &Live, snapshot: &Packages.Packages) -> View {
  let moment = Source.now(&live.source)
  let memo = match Sync.get(&live.memo) {
    case Ok(held) => held
    case Err(_) => Memo{at: 0, view: None}
  }
  if let Some(view) = memo.view {
    if moment < memo.at + MEMO_SECONDS { return view }
  }
  let view = merged(&live.source, snapshot)
  let _kept = Sync.set(&live.memo, Memo{at: moment, view: Some(view)})
  view
}

/// A project from the merged index, filled with what one tab shows. While the
/// latest release is the snapshot's, its files, API, and discussions are read
/// from the snapshot's directory; the overview and releases need nothing more.
export fn detail(live: &Live, snapshot: &Packages.Packages, project: &Packages.Project, tab: Str, file: Str) -> Packages.Project {
  if tab == "overview" || tab == "releases" { return *project }
  let filled = match Packages.find(snapshot, project.handle, project.project) {
    case Some(held) => if held.latest == project.latest { Packages.detailed(snapshot, project) } else { *project }
    case None => *project
  }
  // Conversations change by the minute and belong to no release, so they are
  // read live for every package; the snapshot's stand in when GitHub cannot say.
  if tab == "tickets" {
    match Discussions.read(&live.source, filled.repository, "tickets") {
      case Some(found) => { return Packages.Project{..filled, tickets: found} }
      case None => { return filled }
    }
  }
  if tab == "contributions" {
    match Discussions.read(&live.source, filled.repository, "contributions") {
      case Some(found) => { return Packages.Project{..filled, contributions: found} }
      case None => { return filled }
    }
  }
  filled
}

/// The snapshot with the topic's repositories laid over it.
///
/// A repository the snapshot lacks enters with the releases the build would
/// admit. One the snapshot has takes GitHub's counts and, when it was pushed
/// after its latest release, any newer release. When the search was complete,
/// a snapshot project it no longer lists is hidden: it left the topic, or was
/// archived, made private, or deleted. When the search failed or was cut
/// short, nothing is hidden, and without a first page the snapshot is served.
export fn merged(source: &Source.Source, snapshot: &Packages.Packages) -> View {
  let Some(listing) = Index.search(source) else { return View{packages: *snapshot, live: false} }
  let fresh = listing.repositories.filter(|held: Index.Repository| Packages.find(snapshot, held.handle, held.project) == None)
  let known = listing.repositories.filter(|held: Index.Repository| Packages.find(snapshot, held.handle, held.project) != None)
  var projects = snapshot.projects
  var handles = snapshot.handles
  var probes = 0
  for repository in fresh {
    if probes < PROBES {
      probes = probes + 1
      if let Some(read) = Release.read(source, &repository, None) {
        if !read.releases.isEmpty() {
          projects = projects.push(introduced(source, &repository, &read))
          if handles.filter(|profile: Packages.Profile| profile.handle == repository.handle).isEmpty() { handles = handles.push(repository.owner) }
        }
      }
    }
  }
  for repository in known {
    let Some(held) = Packages.find(snapshot, repository.handle, repository.project) else { continue }
    let counted = Packages.Project{..held, stars: repository.stars, forks: repository.forks, openIssues: repository.openIssues}
    let changed = repository.pushedAt > publishedAt(&held)
    let newer = if changed && probes < PROBES {
      probes = probes + 1
      Release.read(source, &repository, held.latest)
    } else { None }
    projects = replaced(&projects, &advanced(&counted, &newer))
  }
  if listing.complete {
    var listed: Set[Str] = setOf([])
    for repository in listing.repositories { listed = listed.insert(repository.handle + "/" + repository.project) }
    projects = projects.filter(|held: Packages.Project| listed.contains(held.name))
  }
  View {
    packages: Packages.Packages{..*snapshot, projects: List.sortBy(&projects, fn(left: Packages.Project, right: Packages.Project) -> Bool { left.name < right.name }), handles: handles},
    live: true
  }
}

/// A snapshot project with releases newer than its latest put first. `files`
/// and `catalog` describe the latest release, so they are dropped with it; the
/// previous release's declarations stay searchable until the next build.
fn advanced(project: &Packages.Project, newer: &Option[Release.Releases]) -> Packages.Project {
  let Some(read) = *newer else { return *project }
  if read.releases.isEmpty() { return *project }
  Packages.Project{..*project, latest: Some(read.releases[0].version), releases: read.releases.concat(project.releases), files: [], catalog: None}
}

/// A project the snapshot does not have, from its search result, its releases,
/// and its README at the newest release's commit.
fn introduced(source: &Source.Source, repository: &Index.Repository, read: &Release.Releases) -> Packages.Project {
  let newest = read.releases[0]
  let manifest = read.manifest
  Packages.Project {
    name: repository.handle + "/" + repository.project,
    handle: repository.handle,
    project: repository.project,
    description: if manifest.description.isEmpty() { repository.description } else { manifest.description },
    keywords: if manifest.keywords.isEmpty() { repository.topics.filter(|word: Str| word != "pudu-package") } else { manifest.keywords },
    license: if manifest.license.isEmpty() { repository.license } else { manifest.license },
    root: if manifest.root.isEmpty() { rootOf(repository.project) } else { manifest.root },
    readme: Option.unwrapOr(Source.text(source, Release.RAW + repository.path + "/" + newest.commit + "/README.md", &Source.immutable()), ""),
    repository: repository.url,
    stars: repository.stars,
    forks: repository.forks,
    openIssues: repository.openIssues,
    tickets: [],
    contributions: [],
    searchEntries: [],
    latest: Some(newest.version),
    releases: read.releases,
    files: [],
    catalog: None
  }
}

/// `json-kit` is imported as `JsonKit` unless its manifest says otherwise.
fn rootOf(project: Str) -> Str {
  project.split("-").map(|part: Str| part.take(1).toUpper() + part.drop(1)).join("")
}

fn publishedAt(project: &Packages.Project) -> Str {
  match Packages.latestRelease(project) {
    case Some(release) => release.publishedAt
    case None => ""
  }
}

fn replaced(projects: &Array[Packages.Project], project: &Packages.Project) -> Array[Packages.Project] {
  projects.map(|held: Packages.Project| if held.name == project.name { *project } else { held })
}
