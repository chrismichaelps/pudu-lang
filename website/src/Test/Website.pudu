module Test.Website

import Std.Html.Build as H
import Std.Http as Http
import Std.Json as Json
import Std.Result as Result
import Std.Test as Test
import Domain.Entry as Domain
import Function as Function
import Service.Catalog as Catalog
import Service.Docs as Docs
import Service.Documents as Documents
import Service.Releases as Releases
import Service.Search as Search
import View.Markdown as Markdown
import Web.Dynamic as DynamicWeb
import Web.Routes as Web

/// The path a function would dispatch on, for an event written as text.
fn asked(event: Str) -> Str {
  Function.pathIn(&Result.unwrapOr(Json.decode(event), Json.Null))
}

fn hasHeader(response: &Http.Response, name: Str, value: Str) -> Bool {
  Http.header(&response.headers, name) == Some(value)
}

fn firstResultsBelongTo(hits: &Array[Domain.Hit], moduleName: Str, count: Int) -> Bool {
  if hits.length() < count { return false }
  var index = 0
  while index < count {
    if hits[index].entry.moduleName != moduleName { return false }
    index = index + 1
  }
  true
}

fn everyResultHasKind(hits: &Array[Domain.Hit], kind: Str) -> Bool {
  for hit in hits {
    if Domain.category(&hit.entry) != kind { return false }
  }
  true
}

/// Every archive the release publishes is offered, by name and by link.
fn downloadOffersEvery(response: &Http.Response, release: &Releases.Release) -> Bool {
  if release.downloads.length() == 0 { return false }
  for download in release.downloads {
    if !response.body.contains(download.file) { return false }
    if !response.body.contains(download.url) { return false }
  }
  true
}

/// A reader can check what they downloaded, so each checksum is on the page.
fn downloadShowsChecksums(response: &Http.Response, release: &Releases.Release) -> Bool {
  for download in release.downloads {
    if download.checksum.isEmpty() { return false }
    if !response.body.contains(download.checksum) { return false }
  }
  true
}

/// The pages a crawler is told about are the pages that were rendered.
fn sitemapHasAll(response: &Http.Response, origin: Str, paths: &Array[Str]) -> Bool {
  for path in paths {
    if !response.body.contains("<loc>" + origin + path + "</loc>") { return false }
  }
  true
}

/// Every page carries the footer, so the project pages are reachable from any of them.
fn footerLinks(response: &Http.Response) -> Bool {
  for path in ["/download", "/releases", "/contributing", "/conduct", "/security"] {
    if !response.body.contains("href=\"" + path + "\"") { return false }
  }
  true
}

fn everyEntryHasDocumentation(entries: &Array[Domain.Entry]) -> Bool {
  for entry in entries {
    if entry.documentation.length() == 0 { return false }
  }
  true
}

export fn main() -> Int {
  let loaded = Catalog.load("website/data/api.json")
  let catalog = match loaded {
    case Ok(value) => value
    case Err(_) => { return 0 }
  }
  let docs = match Docs.load("website/docs") {
    case Ok(value) => value
    case Err(_) => { return 0 }
  }
  let release = match Releases.load("website/data/releases.json", "packages/pudu/v0.1/release-notes") {
    case Ok(value) => value
    case Err(_) => { return 1 }
  }
  let documents = match Documents.load(".") {
    case Ok(value) => value
    case Err(_) => { return 1 }
  }
  let origin = "https://pudu.example"
  let docsIndex = Web.render(origin, &catalog, &docs, &release, &documents, "/docs")
  let docsPage = Web.render(origin, &catalog, &docs, &release, &documents, "/docs/errors")
  let docsMissing = Web.render(origin, &catalog, &docs, &release, &documents, "/docs/not-a-page")
  let modulesIndex = Web.render(origin, &catalog, &docs, &release, &documents, "/modules")
  let guide = Web.render(origin, &catalog, &docs, &release, &documents, "/guide")
  let written = Markdown.parse(
      &[
      "# Title",
      "",
      "A <script>alert(1)</script> line with [a link](javascript:alert(1)) and `code`.",
      "",
      "## Same",
      "## Same",
      "",
      "| left | right |",
      "| --- | --- |",
      "| 1 | 2 |"
    ]
  )
  let writtenHtml = H.render(&H.div().holding(written.blocks))
  let home = Web.render(origin, &catalog, &docs, &release, &documents, "/")
  let search = Web.render(origin, &catalog, &docs, &release, &documents, "/search?q=checksum")
  let hostile = Web.render(origin, &catalog, &docs, &release, &documents, "/search?q=%3Cscript%3Ealert(1)%3C%2Fscript%3E")
  let modulePage = Web.render(origin, &catalog, &docs, &release, &documents, "/module/Std.Adler32")
  let symbol = Web.render(origin, &catalog, &docs, &release, &documents, "/docs/Std.Adler32/fn/checksum")
  let missing = Web.render(origin, &catalog, &docs, &release, &documents, "/docs/Std.Adler32/fn/notThere")
  let robots = Web.render(origin, &catalog, &docs, &release, &documents, "/robots.txt")
  let sitemap = Web.render(origin, &catalog, &docs, &release, &documents, "/sitemap.xml")
  let health = Web.render(origin, &catalog, &docs, &release, &documents, "/health")
  let donation = Web.render(origin, &catalog, &docs, &release, &documents, "/donate")
  let about = Web.render(origin, &catalog, &docs, &release, &documents, "/about")
  let overloads = Web.render(origin, &catalog, &docs, &release, &documents, "/docs/Std.Bits/fn/width")
  let download = Web.render(origin, &catalog, &docs, &release, &documents, "/download")
  let releases = Web.render(origin, &catalog, &docs, &release, &documents, "/releases")
  let conduct = Web.render(origin, &catalog, &docs, &release, &documents, "/conduct")
  let contributing = Web.render(origin, &catalog, &docs, &release, &documents, "/contributing")
  let security = Web.render(origin, &catalog, &docs, &release, &documents, "/security")
  let hits = Search.find(&catalog.entries, "checksum", 10)
  let compact = Catalog.readSearchIndex(Catalog.searchIndex(&catalog))
  let searchCatalog = match compact {
    case Ok(value) => value
    case Err(_) => { return 0 }
  }
  let compactHits = Search.find(&searchCatalog.entries, "checksum", 10)
  let listIntent = Search.find(&catalog.entries, "List", 200)
  let listScope = Search.find(&catalog.entries, "module:Std.List", 200)
  let scopedMap = Search.find(&catalog.entries, "map module:Std.List is:exact", 10)
  let typedMap = Search.find(&catalog.entries, "map :: &Array[X] -> fn(X) -> Y -> Array[Y]", 10)
  let typeKinds = Search.find(&catalog.entries, "Listener kind:type", 20)
  let invalidFilter = Search.find(&catalog.entries, "kind:not-a-kind", 20)
  let multiTerm = Search.find(&catalog.entries, "adler checksum", 10)
  let dynamicSearch = DynamicWeb.render(origin, &searchCatalog, "/search?q=checksum")
  let dynamicMissing = DynamicWeb.render(origin, &searchCatalog, "/not-a-page")
  let vercelEvent = Json.object(&[
      ("body", Json.Text("\{\"method\":\"GET\",\"path\":\"/search?q=map\"\}")),
      ("Action", Json.Text("Invoke"))
    ])

  let suite = Test.suite("website", &[
      Test.that("download page answers", download.status.code == 200),
      Test.that("release notes answer", releases.status.code == 200),
      Test.that("release notes carry the published notes", releases.body.contains("Install") && releases.body.contains("pudu version")),
      Test.that("code of conduct answers", conduct.status.code == 200),
      Test.that("code of conduct names how to report", conduct.body.contains("chrisperezsantiago1@gmail.com")),
      Test.that("contributing answers", contributing.status.code == 200),
      Test.that("security policy answers", security.status.code == 200),
      Test.that("security policy names what is in scope", security.body.contains("in scope")),
      Test.that("every published document is in the sitemap", sitemapHasAll(&sitemap, origin, &["/download", "/releases", "/conduct", "/contributing", "/security"])),
      Test.that("the footer links the project pages", footerLinks(&about)),
      Test.that("download page offers every published archive", downloadOffersEvery(&download, &release)),
      Test.that("download page names the version", download.body.contains("Pudu " + release.version)),
      Test.that("download page publishes each checksum", downloadShowsChecksums(&download, &release)),
      Test.that("download page is in the sitemap", sitemap.body.contains(origin + "/download")),
      Test.that("download page is linked from every page", about.body.contains("href=\"/download\"")),
      Test.that("catalogue records its schema language", catalog.languageVersion == "0.1.0"),
      Test.that("catalogue has public declarations", catalog.entries.length() > 3000),
      Test.that("every public declaration has documentation", everyEntryHasDocumentation(&catalog.entries)),
      Test.that("ranked search returns a result", hits.length() > 0),
      Test.that("exact name ranks first", hits[0].entry.name == "checksum"),
      Test.that("compact catalogue keeps every searchable declaration", searchCatalog.entries.length() == catalog.entries.length()),
      Test.that("compact catalogue keeps the language version", searchCatalog.languageVersion == catalog.languageVersion),
      Test.that("compact catalogue preserves ranked results", compactHits.length() == hits.length() && compactHits[0].entry.name == hits[0].entry.name),
      Test.that("module leaf intent keeps the complete List module first", firstResultsBelongTo(&listIntent, "Std.List", 97)),
      Test.that("module-only scope returns every List declaration", listScope.length() == 97 && firstResultsBelongTo(&listScope, "Std.List", 97)),
      Test.that("module and exact filters select the intended declaration", scopedMap.length() == 1 && Domain.qualifiedName(&scopedMap[0].entry) == "Std.List.map"),
      Test.that("generic placeholder names do not change a type match", typedMap.length() > 0 && Domain.qualifiedName(&typedMap[0].entry) == "Std.List.map"),
      Test.that("kind scope excludes declarations of every other kind", typeKinds.length() > 0 && everyResultHasKind(&typeKinds, "type")),
      Test.that("unknown filters remain searchable text", invalidFilter.length() == 0),
      Test.that("every ordinary term must match", multiTerm.length() > 0 && Domain.qualifiedName(&multiTerm[0].entry) == "Std.Adler32.checksum"),
      Test.that("dynamic search uses the shared result view", dynamicSearch.status.code == 200 && dynamicSearch.body.contains("Std.Adler32.checksum")),
      Test.that("dynamic fallback is a no-index 404", dynamicMissing.status.code == 404 && hasHeader(&dynamicMissing, "X-Robots-Tag", "noindex") && dynamicMissing.body.contains("noindex,follow")),
      Test.that("home renders", home.status.code == 200),
      Test.that("home has canonical metadata", home.body.contains("<link rel=\"canonical\" href=\"https://pudu.example/\"")),
      Test.that("home has structured data", home.body.contains("application/ld+json")),
      Test.that("home uses the supplied logo", home.body.contains("pudu-lang-full-logo.png")),
      Test.that("home advertises the short logo as its icon", home.body.contains("rel=\"icon\" type=\"image/png\" href=\"/assets/pudu-lang-short.png\"")),
      Test.that("home links the repository", home.body.contains("https://github.com/chrismichaelps/pudu-lang/")),
      Test.that("home names the copyright holder", home.body.contains("© 2026 Chris M. Pérez Santiago")),
      Test.that("home has one search field", home.body.split("name=\"q\"").length() == 2),
      Test.that("header has no GitHub icon", !home.body.contains("github-icon")),
      Test.that("mobile navigation uses a labelled disclosure", home.body.contains("<details class=\"mobile-nav\"") && home.body.contains("aria-label=\"Navigation menu\"")),
      Test.that("navigation identifies the current API page", modulePage.body.contains("aria-current=\"page\">API")),
      Test.that("home teaches through a complete program", home.body.contains("Write a complete program") && home.body.contains("module Hello")),
      Test.that("home links the documentation", home.body.contains("href=\"/docs\"")),
      Test.not("home no longer squeezes modules into a side column", home.body.contains("class=\"grid\"")),

      // The documentation is Markdown read from files and rendered on the
      // server, so a page is only as good as what the renderer made of it: its
      // sections, its code, its neighbours, and what it refused to render.
      Test.that("documentation loads every page in order", docs.pages.length() == 20 && docs.pages[0].slug == "introduction" && docs.pages[1].slug == "getting-started" && docs.pages[19].slug == "tooling"),
      Test.that("documentation index lists every page", docsIndex.status.code == 200 && docsIndex.body.contains("href=\"/docs/introduction\"") && docsIndex.body.contains("href=\"/docs/tooling\"")),
      Test.that("a documentation page renders its sections", docsPage.status.code == 200 && docsPage.body.contains("<h2 id=\"the-operator\">")),
      Test.that("a documentation page renders its code", docsPage.body.contains("class=\"code-block\"") && docsPage.body.contains("language-pudu")),
      Test.that("a documentation page lists its sections", docsPage.body.contains("On this page") && docsPage.body.contains("href=\"#result\"")),
      Test.that("a documentation page links its neighbours", docsPage.body.contains("pager-previous") && docsPage.body.contains("pager-next")),
      Test.that("a documentation page marks itself in the sidebar", docsPage.body.contains("href=\"/docs/errors\" aria-current=\"page\"")),
      Test.that("navigation identifies the documentation", docsPage.body.contains("aria-current=\"page\">Docs")),
      Test.that("a documentation page names its author and version", docsPage.body.contains("<dt>Author</dt><dd>Chris M. Pérez Santiago</dd>") && docsPage.body.contains("<dt>Version</dt><dd>0.1.0</dd>")),
      Test.that("a documentation page links its own source", docsPage.body.contains("blob/dev/website/docs/09-errors.md")),
      Test.that("a documentation page labels its code by language", docsPage.body.contains("class=\"code-label\"")),
      Test.that("a narrow screen gets the page list folded away", docsPage.body.contains("<details class=\"docs-nav-mobile\">")),
      Test.that("the library is grouped into sections", modulesIndex.body.contains("id=\"collections\"") && modulesIndex.body.contains("id=\"web\"")),
      Test.that("the library says what a module is for", modulesIndex.body.contains("Ordered maps from keys to values.")),
      Test.that("the library shows modules beneath their family", modulesIndex.body.contains("href=\"/module/Std.Http.Server.Route\"")),
      Test.not("every library module has a section", modulesIndex.body.contains("id=\"other\"")),
      Test.that("home starts a new reader on the documentation", home.body.contains("href=\"/docs/introduction\"")),
      Test.that("an unknown documentation page is 404", docsMissing.status.code == 404),
      Test.that("the guide address names the documentation as canonical", guide.status.code == 200 && guide.body.contains("<link rel=\"canonical\" href=\"https://pudu.example/docs\"")),
      Test.that("markdown keeps the title out of the page body", written.title == "Title" && !writtenHtml.contains("<h1")),
      Test.not("markdown escapes markup written in prose", writtenHtml.contains("<script>")),
      Test.not("markdown refuses a script as a link target", writtenHtml.contains("href=\"javascript")),
      Test.that("markdown gives repeated headings distinct anchors", writtenHtml.contains("id=\"same\"") && writtenHtml.contains("id=\"same-2\"")),
      Test.that("markdown renders tables", writtenHtml.contains("<table>") && writtenHtml.contains("<td>2</td>")),
      Test.that("home explains references", home.body.contains("&amp;mut T asks for the exclusive right to change it")),
      Test.that("search renders matches", search.body.contains("Std.Adler32.checksum")),
      Test.that("search explains its query syntax", search.body.contains("module:Std.List") && search.body.contains("type after ::")),
      Test.that("search is not indexed", search.body.contains("noindex,follow")),
      Test.not("query markup is escaped", hostile.body.contains("<script>alert(1)</script>")),
      Test.that("module page renders", modulePage.status.code == 200),
      Test.that("symbol page renders", symbol.status.code == 200),
      Test.that("symbol has TechArticle data", symbol.body.contains("TechArticle")),
      Test.that("symbol explains its signature notation", symbol.body.contains("Read the signature") && symbol.body.contains("Read arrows from left to right") && symbol.body.contains("borrows a value")),
      Test.that("missing page is 404", missing.status.code == 404),
      Test.that("missing page is not indexed", missing.body.contains("noindex,follow")),
      Test.that("robots names the sitemap", robots.body.contains("https://pudu.example/sitemap.xml")),
      Test.that("sitemap includes canonical symbols", sitemap.body.contains("https://pudu.example/docs/Std.Adler32/fn/checksum")),
      Test.that("sitemap includes donation", sitemap.body.contains("https://pudu.example/donate")),
      Test.that("sitemap is XML", hasHeader(&sitemap, "content-type", "application/xml; charset=utf-8")),
      Test.that("health is not indexed", hasHeader(&health, "X-Robots-Tag", "noindex")),
      Test.that("donation page renders", donation.status.code == 200),
      Test.that("donation uses the requested PayPal destination", donation.body.contains("https://paypal.me/chrismperezsantiago")),
      Test.that("about page renders", about.status.code == 200),
      Test.that("about page explains Haskell's role", about.body.contains("The first Pudu compiler is written in Haskell")),
      Test.that("about page identifies the author", about.body.contains("Chris M. Pérez Santiago")),
      Test.that("about page links the author's profiles", about.body.contains("linkedin.com/in/chrisperezsantiago") && about.body.contains("github.com/chrismichaelps")),
      Test.that("about page carries structured data", about.body.contains("AboutPage")),
      Test.that("sitemap includes about", sitemap.body.contains("https://pudu.example/about")),
      Test.that("sitemap includes the documentation", sitemap.body.contains("https://pudu.example/docs</loc>") && sitemap.body.contains("https://pudu.example/docs/introduction</loc>")),
      Test.not("sitemap no longer lists the old guide address", sitemap.body.contains("https://pudu.example/guide")),
      Test.that("same-name declarations share a page", overloads.body.contains("14 declarations with this name")),
      Test.that("same-name declarations remain visible", overloads.body.contains("fn (UInt8)") && overloads.body.contains("fn (trait Bits)")),
      Test.that("method pages explain trait and concrete providers", overloads.body.contains("required by a trait") && overloads.body.contains("for one concrete type")),
      Test.that("same-name sitemap paths are unique", sitemap.body.split("https://pudu.example/docs/Std.Bits/fn/width").length() == 2),
      Test.that("type and function paths stay distinct", sitemap.body.contains("/docs/Std.App/fn/stage") && sitemap.body.contains("/docs/Std.App/type/Stage")),

      // What a platform hands the function, read into the path a route is
      // dispatched on. A reader that knew one shape would answer every request
      // with the front page, which looks like working routing rather than like
      // an event nothing understood.
      Test.that("an event naming its raw path is routed on it", asked("\{\"rawPath\":\"/modules\"\}") == "/modules"),
      Test.that("a query string is carried with the path", asked("\{\"rawPath\":\"/search\",\"rawQueryString\":\"q=map\"\}") == "/search?q=map"),
      Test.that("an event naming a plain path is routed on it", asked("\{\"path\":\"/about\"\}") == "/about"),
      Test.that("an event naming a whole url is routed on it", asked("\{\"url\":\"/donate\"\}") == "/donate"),
      Test.that("the raw path is preferred to the others", asked("\{\"rawPath\":\"/a\",\"path\":\"/b\"\}") == "/a"),
      // An event saying nothing is the front page rather than the empty path,
      // which routes to nothing and answers 404 for the one address every
      // visitor arrives at first.
      Test.that("an event naming nothing is the front page", asked("\{\}") == "/"),
      // A path that already carries its query is not given it twice, which
      // would put the search term in the page as part of another term.
      Test.that("a query already in the path is not repeated", asked("\{\"rawPath\":\"/search?q=map\",\"rawQueryString\":\"q=map\"\}") == "/search?q=map"),
      Test.that("an empty query adds no question mark", asked("\{\"rawPath\":\"/search\",\"rawQueryString\":\"\"\}") == "/search"),
      Test.that("a Vercel invocation unwraps its request body", Function.pathIn(&vercelEvent) == "/search?q=map"),

      // And what goes back. A response that arrived without its headers would
      // be served as text and indexed as a duplicate, since the pages state
      // their own content type and their own canonical address.
      Test.that("an answer carries the status the page answered", Function.answered(&home).contains("\"statusCode\":200")),
      Test.that("an answer carries the page", Function.answered(&home).contains("<title>")),
      Test.that("an answer carries the headers the page set", Function.answered(&home).contains("content-type")),
      Test.that("an answer says its body is not encoded", Function.answered(&home).contains("\"isBase64Encoded\":false")),
      Test.that("a page that was not found answers as not found", Function.answered(&missing).contains("\"statusCode\":404"))
    ])
  Test.report(&Test.run(&suite))
}
