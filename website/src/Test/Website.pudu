/// The path a function would dispatch on, for an event written as text.
fn asked(event: Str) -> Str {
  Function.pathIn(&Result.unwrapOr(Json.decode(event), Json.Null))
}

fn hasHeader(response: &Http.Response, name: Str, value: Str) -> Bool {
  Http.header(&response.headers, name) == Some(value)
}

fn firstResultsBelongTo(hits: &Array[Domain.Hit], moduleName: Str, count: Int) -> Bool {
  if hits.length() < count { return false }
  var index = 0
  while index < count {
    if hits[index].entry.moduleName != moduleName { return false }
    index = index + 1
  }
  true
}

fn everyResultHasKind(hits: &Array[Domain.Hit], kind: Str) -> Bool {
  for hit in hits {
    if Domain.category(&hit.entry) != kind { return false }
  }
  true
}

/// Every archive the release publishes is offered, by name and by link.
fn downloadOffersEvery(response: &Http.Response, release: &Releases.Release) -> Bool {
  if release.downloads.length() == 0 { return false }
  for download in release.downloads {
    if !response.body.contains(download.file) { return false }
    if !response.body.contains(download.url) { return false }
  }
  true
}

/// A reader can check what they downloaded, so each checksum is on the page.
fn downloadShowsChecksums(response: &Http.Response, release: &Releases.Release) -> Bool {
  for download in release.downloads {
    if download.checksum.isEmpty() { return false }
    if !response.body.contains(download.checksum) { return false }
  }
  true
}

/// The banner offers every archive, each button naming its target, before
/// anything else on the page.
fn downloadButtonsInHero(response: &Http.Response, release: &Releases.Release) -> Bool {
  let hero = response.body.split("class=\"hero-banner download-hero\"")
  if hero.length() < 2 { return false }
  let banner = hero[1].split("</section>")[0]
  for download in release.downloads {
    if !banner.contains("href=\"" + download.url + "\" data-platform=\"" + download.target + "\"") { return false }
  }
  true
}

/// Each archive's section names its own file in painted, copyable commands.
fn downloadStepsPerArchive(response: &Http.Response, release: &Releases.Release) -> Bool {
  for download in release.downloads {
    let section = response.body.split("id=\"install-" + download.target + "\"")
    if section.length() < 2 { return false }
    let body = section[1].split("</section>")[0]
    if !body.contains("code-copy") || !body.contains("<span class=\"tok-function\">tar</span>") || !body.contains(download.file + ".sha256") { return false }
  }
  true
}

/// The pages a crawler is told about are the pages that were rendered.
fn sitemapHasAll(response: &Http.Response, origin: Str, paths: &Array[Str]) -> Bool {
  for path in paths {
    if !response.body.contains("<loc>" + origin + path + "</loc>") { return false }
  }
  true
}

/// Every page carries the footer, so the project pages are reachable from any of them.
fn footerLinks(response: &Http.Response) -> Bool {
  for path in ["/download", "/releases", "/contributing", "/conduct", "/security"] {
    if !response.body.contains("href=\"" + path + "\"") { return false }
  }
  true
}

/// Whether a stylesheet's blocks all close, and a rule meant for every screen
/// is outside every media query.
///
/// A rule missing its closing brace swallows everything after it into the
/// block it was in, which is how the documentation lost its layout and its
/// code background on every screen wider than a phone.
fn stylesheetIsWellFormed(css: Str, topLevelRule: Str) -> Bool {
  var depth = 0
  var quoted = false
  var ruleAtTop = false
  var index = 0
  let characters = css.chars()
  let rule = topLevelRule.chars()
  while index < characters.length() {
    let character = characters[index]
    if character == '"' { quoted = !quoted }
    if !quoted {
      if character == '{' { depth = depth + 1 }
      if character == '}' {
        depth = depth - 1
        if depth < 0 { return false }
      }
      if depth == 0 && startsAt(&characters, index, &rule) { ruleAtTop = true }
    }
    index = index + 1
  }
  depth == 0 && ruleAtTop
}

fn startsAt(characters: &Array[Char], index: Int, wanted: &Array[Char]) -> Bool {
  if index + wanted.length() > characters.length() { return false }
  var offset = 0
  while offset < wanted.length() {
    if characters[index + offset] != wanted[offset] { return false }
    offset = offset + 1
  }
  true
}

/// Whether the first rule for a selector declares each of the declarations, in
/// whatever order the rule writes them.
fn ruleDeclares(css: Str, selector: Str, declarations: &Array[Str]) -> Bool {
  let pieces = css.split("\n" + selector + "\{")
  if pieces.length() < 2 { return false }
  let body = pieces[1].split("\}")[0]
  for declaration in declarations {
    if !body.contains(declaration) { return false }
  }
  true
}

fn everyEntryHasDocumentation(entries: &Array[Domain.Entry]) -> Bool {
  for entry in entries {
    if entry.documentation.length() == 0 { return false }
  }
  true
}

fn rankingAgrees(full: &Array[Domain.Entry], compact: &Array[Domain.Entry], query: Str) -> Bool {
  let left = Search.find(full, query, 20)
  let right = Search.find(compact, query, 20)
  if left.length() != right.length() { return false }
  var index = 0
  while index < left.length() {
    if Domain.qualifiedName(&left[index].entry) != Domain.qualifiedName(&right[index].entry) {
      return false
    }
    index = index + 1
  }
  true
}

export fn main() -> Int {
  let loaded = Catalog.load("website/data/api.json")
  let catalog = match loaded {
    case Ok(value) => value
    case Err(_) => { return 0 }
  }
  let docs = match Docs.load("website/docs") {
    case Ok(value) => value
    case Err(_) => { return 0 }
  }
  let release = match Releases.load("website/data/releases.json", "packages/pudu/v0.1/release-notes") {
    case Ok(value) => value
    case Err(_) => { return 1 }
  }
  let documents = match Documents.load(".") {
    case Ok(value) => value
    case Err(_) => { return 1 }
  }
  let examples = match Examples.load("website/playground/examples") {
    case Ok(value) => value
    case Err(_) => { return 1 }
  }
  let stylesheet = match Io.read("website/public/site.css") {
    case Ok(value) => value
    case Err(_) => { return 1 }
  }
  let origin = "https://pudu.example"
  let packages = match Packages.load("website/test/fixtures/packages") {
    case Ok(value) => value
    case Err(_) => { return 1 }
  }
  let brokenPackages = Packages.load("website/test/fixtures/packages-broken")
  let compactPackages = Packages.loadCompact("website/test/fixtures/packages-broken")
  let runsNothing = Playground.disabled("not in this suite")
  let site = Site.Site {
    siteUrl: origin,
    catalog: catalog,
    packages: packages,
    search: Search.index(&catalog.entries),
    docs: docs,
    release: release,
    documents: documents,
    playground: Playground.using(&runsNothing, &examples, &Play.defaultLimits()),
    gates: Playground.openGates()
  }
  let docsIndex = Web.render(&site, "/docs")
  let docsPage = Web.render(&site, "/docs/errors")
  let docsMissing = Web.render(&site, "/docs/not-a-page")
  let modulesIndex = Web.render(&site, "/modules")
  let guide = Web.render(&site, "/guide")
  let written = Markdown.parse(
      &[
      "# Title",
      "",
      "A <script>alert(1)</script> line with [a link](javascript:alert(1)) and `code`.",
      "",
      "## Same",
      "## Same",
      "",
      "| left | right |",
      "| --- | --- |",
      "| 1 | 2 |",
      "| `+\\|` | a \\| b |"
    ]
  )
  let writtenHtml = H.render(&H.div().holding(written.blocks))
  let home = Web.render(&site, "/")
  let bare = Site.Site{..site, packages: Packages.empty()}
  let emptyCatalog = Web.render(&bare, "/packages")
  let emptyPackageSearch = Web.render(&site, "/packages/search?q=not-a-real-package-zz")
  let bareHome = Web.render(&bare, "/")
  let search = Web.render(&site, "/search?q=checksum")
  let hostile = Web.render(&site, "/search?q=%3Cscript%3Ealert(1)%3C%2Fscript%3E")
  let modulePage = Web.render(&site, "/module/Std.Adler32")
  let symbol = Web.render(&site, "/docs/Std.Adler32/fn/checksum")
  let missing = Web.render(&site, "/docs/Std.Adler32/fn/notThere")
  let robots = Web.render(&site, "/robots.txt")
  let sitemap = Web.render(&site, "/sitemap.xml")
  let health = Web.render(&site, "/health")
  let donation = Web.render(&site, "/donate")
  let about = Web.render(&site, "/about")
  let overloads = Web.render(&site, "/docs/Std.Bits/fn/width")
  let prose = Web.render(&site, "/docs/Std.List/fn/any")
  let download = Web.render(&site, "/download")
  let releases = Web.render(&site, "/releases")
  let conduct = Web.render(&site, "/conduct")
  let contributing = Web.render(&site, "/contributing")
  let security = Web.render(&site, "/security")
  let community = Web.render(&site, "/community")
  let privacy = Web.render(&site, "/privacy")
  let brand = Web.render(&site, "/brand")
  let packageCatalog = Web.render(&site, "/packages")
  let githubAvatar = Packages.Profile{..packages.handles[0], avatar: "", avatarUrl: "https://avatars.githubusercontent.com/u/123"}
  let githubAvatarSite = Site.Site{..site, packages: Packages.Packages{..packages, handles: [githubAvatar]}}
  let githubAvatarCatalog = Web.render(&githubAvatarSite, "/packages")
  let localAvatar = Packages.Profile{..githubAvatar, avatar: "/packages/avatars/alice.png"}
  let localAvatarSite = Site.Site{..site, packages: Packages.Packages{..packages, handles: [localAvatar]}}
  let localAvatarCatalog = Web.render(&localAvatarSite, "/packages")
  let seedProject = packages.projects[0]
  var manyProjects: Array[Packages.Project] = []
  var projectNumber = 0
  while projectNumber < 7 {
    let name = "pkg-" + show(projectNumber)
    manyProjects = manyProjects.push(Packages.Project{..seedProject, name: "@alice/" + name, project: name, stars: projectNumber})
    projectNumber = projectNumber + 1
  }
  let manySite = Site.Site{..site, packages: Packages.Packages{..packages, projects: manyProjects}}
  let manyCatalog = Web.render(&manySite, "/packages")
  var longProjects: Array[Packages.Project] = []
  var longNumber = 0
  while longNumber < 25 {
    let name = "json-" + show(longNumber)
    longProjects = longProjects.push(Packages.Project{..seedProject, name: "@alice/" + name, project: name})
    longNumber = longNumber + 1
  }
  let longSite = Site.Site{..site, packages: Packages.Packages{..packages, projects: longProjects}}
  let longCatalog = Web.render(&longSite, "/packages")
  let longCatalogNext = Web.render(&longSite, "/packages/page/2")
  let longSitemap = Web.render(&longSite, "/sitemap.xml")
  let longProfile = Web.render(&longSite, "/@alice")
  let longProfileNext = Web.render(&longSite, "/@alice/page/2")
  let longSearch = Web.render(&longSite, "/packages/search?q=json")
  let filteredSearch = Web.render(&longSite, "/packages/search?q=json&filter=%40alice%2Fmissing")
  let knownFilterSearch = Web.render(&longSite, "/packages/search?q=json&filter=%40alice%2Fjson-0")
  let filteredDynamicSearch = DynamicWeb.render(&DynamicWeb.Dynamic{packages: longSite.packages, siteUrl: origin, catalog: catalog, search: Search.index(&catalog.entries), playground: site.playground, gates: Playground.openGates(), live: LivePackages.offline()}, "/packages/search?q=json&filter=%40alice%2Fmissing")
  let suggestRoute = Web.render(&site, "/packages/suggest?q=json")
  let suggestDynamic = DynamicWeb.render(&DynamicWeb.Dynamic{packages: packages, siteUrl: origin, catalog: catalog, search: Search.index(&catalog.entries), playground: site.playground, gates: Playground.openGates(), live: LivePackages.offline()}, "/packages/suggest?q=&filter=%40alice%2Fjson-kit")
  let shapeSearch = Web.render(&site, "/packages/search?q=Value+-%3E+Str")
  let longSearchNext = Web.render(&longSite, "/packages/search?q=json&page=2")
  let longSearchBeyond = Web.render(&longSite, "/packages/search?q=json&page=999")
  let longDynamic = DynamicWeb.Dynamic{..DynamicWeb.Dynamic{packages: packages, siteUrl: origin, catalog: catalog, search: Search.index(&catalog.entries), playground: site.playground, gates: Playground.openGates(), live: LivePackages.offline()}, packages: longSite.packages}
  let longDynamicSearchNext = DynamicWeb.render(&longDynamic, "/packages/search?q=json&page=2")
  let longDynamicSearchBeyond = DynamicWeb.render(&longDynamic, "/packages/search?q=json&page=999")
  var longTickets: Array[Packages.Discussion] = []
  var longContributions: Array[Packages.Discussion] = []
  var ticketNumber = 0
  while ticketNumber < 25 {
    longTickets = longTickets.push(Packages.Discussion{..seedProject.tickets[0], number: ticketNumber + 100, title: "Ticket " + show(ticketNumber)})
    longContributions = longContributions.push(Packages.Discussion{..seedProject.contributions[0], number: ticketNumber + 200, title: "Contribution " + show(ticketNumber)})
    ticketNumber = ticketNumber + 1
  }
  let discussionProject = Packages.Project{..seedProject, tickets: longTickets, contributions: longContributions}
  let discussionSite = Site.Site{..site, packages: Packages.Packages{..packages, projects: [discussionProject]}}
  let emptyDiscussionProject = Packages.Project{..seedProject, tickets: [], contributions: []}
  let emptyDiscussionSite = Site.Site{..site, packages: Packages.Packages{..packages, projects: [emptyDiscussionProject]}}
  let emptyTickets = Web.render(&emptyDiscussionSite, "/@alice/json-kit/tickets")
  let longTicketPage = Web.render(&discussionSite, "/@alice/json-kit/tickets")
  let longTicketNext = Web.render(&discussionSite, "/@alice/json-kit/tickets/page/2")
  let longContributionNext = Web.render(&discussionSite, "/@alice/json-kit/contributions/page/2")
  let discussionSitemap = Web.render(&discussionSite, "/sitemap.xml")
  let packageSearch = Web.render(&site, "/packages/search?q=json")
  let packageMissing = Web.render(&site, "/@alice/missing")
  let packageProfile = Web.render(&site, "/@alice")
  let packageOverview = Web.render(&site, "/@alice/json-kit")
  let packageSource = Web.render(&site, "/@alice/json-kit/source/src/JsonKit/Parse.pudu")
  let packageBinary = Web.render(&site, "/@alice/json-kit/source/assets/icon.bin")
  let packageEncoded = Web.render(&site, "/@alice/json-kit/source/src/JsonKit/Extra%20Test.pudu")
  let packageSourceMissing = Web.render(&site, "/@alice/json-kit/source/src/JsonKit/Missing.pudu")
  let packageDocs = Web.render(&site, "/@alice/json-kit/docs")
  let packageReleases = Web.render(&site, "/@alice/json-kit/releases")
  let packageTickets = Web.render(&site, "/@alice/json-kit/tickets")
  let packageTicket = Web.render(&site, "/@alice/json-kit/tickets/42")
  let packageTicketMissing = Web.render(&site, "/@alice/json-kit/tickets/999")
  let packageContributions = Web.render(&site, "/@alice/json-kit/contributions")
  let packageContribution = Web.render(&site, "/@alice/json-kit/contributions/56")
  let packageContributionMissing = Web.render(&site, "/@alice/json-kit/contributions/999")
  let hits = Search.find(&catalog.entries, "crc32", 10)
  let compact = Catalog.readSearchIndex(Catalog.searchIndex(&catalog))
  let searchCatalog = match compact {
    case Ok(value) => value
    case Err(_) => { return 0 }
  }
  let compactHits = Search.find(&searchCatalog.entries, "crc32", 10)
  let listIntent = Search.find(&catalog.entries, "List", 200)
  let listScope = Search.find(&catalog.entries, "module:Std.List", 200)
  let scopedMap = Search.find(&catalog.entries, "map module:Std.List is:exact", 10)
  let typedMap = Search.find(&catalog.entries, "map :: &Array[X] -> fn(X) -> Y -> Array[Y]", 10)
  let typeKinds = Search.find(&catalog.entries, "Listener kind:type", 20)
  let invalidFilter = Search.find(&catalog.entries, "kind:not-a-kind", 20)
  let multiTerm = Search.find(&catalog.entries, "adler checksum", 10)
  let edge = DynamicWeb.Dynamic {
    packages: packages,
    siteUrl: origin,
    catalog: searchCatalog,
    search: Search.index(&searchCatalog.entries),
    playground: site.playground,
    gates: Playground.openGates(),
    live: LivePackages.offline()
  }
  let dynamicSearch = DynamicWeb.render(&edge, "/search?q=checksum")
  let leanProjects = packages.projects.map(|project: Packages.Project| Packages.Project{..project, catalog: None})
  let leanPackages = Packages.Packages{..packages, projects: leanProjects}
  let leanEdge = DynamicWeb.Dynamic{..edge, packages: leanPackages}
  let dynamicPackageSearch = DynamicWeb.render(&leanEdge, "/packages/search?q=json")
  // A site run under `pudu run --watch` follows the files it was made from.
  let watch = LiveReload.Watch{start: "3", changed: ["/work/website/public/site.css"]}
  let following = LiveReload.middleware(&watch)
  let rendering = fn(request: Route.Request) -> Http.Response { Web.render(&site, request.message.target) }
  let watchedPage = following(requestFor("/docs/errors"), rendering)
  let watchedState = following(requestFor("/__pudu/reload"), rendering)
  let watchedStyle = following(requestFor("/assets/site.css"), rendering)
  let contentsScript = Web.render(&site, "/assets/docs/contents.js")
  let outsideScripts = Web.render(&site, "/assets/docs/../site.css")
  let dynamicMissing = DynamicWeb.render(&edge, "/not-a-page")
  let dynamicPlayground = DynamicWeb.render(&edge, "/playground/shared?code=module%20Main")
  let playgroundPage = Web.render(&site, "/playground")
  let postedEvent = Json.object(&[
      ("body", Json.Text("\{\"method\":\"POST\",\"path\":\"/api/playground/run\",\"headers\":\{\"Content-Type\":\"application/json\",\"X-Forwarded-For\":\"203.0.113.9\"\},\"encoding\":\"base64\",\"body\":\"eyJzb3VyY2UiOiIifQ==\"\}")),
      ("Action", Json.Text("Invoke"))
    ])
  let posted = Function.requestOf(&postedEvent)
  let vercelEvent = Json.object(&[
      ("body", Json.Text("\{\"method\":\"GET\",\"path\":\"/search?q=map\"\}")),
      ("Action", Json.Text("Invoke"))
    ])

  let suite = Test.suite("website", &[
      Test.that("a playground script module is served by its path", Web.isModulePath("main.js") && Web.isModulePath("lsp/completion-list.js")),
      Test.not("a path outside the script folder is not a module", Web.isModulePath("../site.css.js") || Web.isModulePath("lsp//x.js") || Web.isModulePath("Main.js") || Web.isModulePath("lsp/x.css")),
      Test.that("the stylesheet styles the playground editor", stylesheetIsWellFormed(stylesheet, ".playground-source\{")),
      Test.that("the stylesheet closes every block and styles code blocks on every screen", stylesheetIsWellFormed(stylesheet, ".code-block\{")),
      Test.that("documentation code blocks use the code background", stylesheet.contains(".code-block\{margin:1.25em 0;padding:16px 18px;border:1px solid var(--line);border-radius:10px;background:var(--code)")),
      Test.that("the playground's printed output uses the code background", ruleDeclares(stylesheet, ".playground-stream", &["background:var(--code)", "color:#222838", "font-family:"])),
      Test.that("the playground puts the editor beside its output", ruleDeclares(stylesheet, ".playground-panes", &["display:grid", "grid-template-columns:minmax(160px,var(--split,50%)) 7px minmax(160px,1fr)"])),
      Test.that("the playground renders", playgroundPage.status.code == 200 && playgroundPage.body.contains("id=\"playground-source\"")),
      Test.that("the playground is in the navigation", about.body.contains("href=\"/playground\">Playground")),
      Test.that("the playground and its examples are in the sitemap", sitemap.body.contains(origin + "/playground</loc>") && sitemap.body.contains(origin + "/playground/shapes</loc>")),
      Test.not("the opening example is listed once, as the playground", sitemap.body.contains(origin + "/playground/hello</loc>")),
      Test.that("the function serves a shared program", dynamicPlayground.status.code == 200 && dynamicPlayground.body.contains("playground-link")),
      Test.that("a platform post keeps its method", posted.message.method == Http.Post && posted.path == "/api/playground/run"),
      Test.that("a platform post keeps its headers in lower case", Http.header(&posted.message.headers, "x-forwarded-for") == Some("203.0.113.9")),
      Test.that("a platform post decodes its base64 body", posted.message.body == "\{\"source\":\"\"\}"),
      Test.that("download page answers", download.status.code == 200),
      Test.that("release notes answer", releases.status.code == 200),
      Test.that("the package catalog lists public projects", packageCatalog.status.code == 200 && packageCatalog.body.contains("@alice") && packageCatalog.body.contains("json-kit")),
      Test.that("catalogue, profile, and search serve bounded pages", longCatalog.body.split("class=\"package-row-link\"").length() == 27 && longCatalog.body.contains("href=\"/packages/page/2\"") && longCatalogNext.status.code == 200 && longCatalogNext.body.split("class=\"package-row-link\"").length() == 6 && longProfile.body.split("class=\"package-row-link\"").length() == 21 && longProfileNext.body.split("class=\"package-row-link\"").length() == 6 && longSearch.body.split("class=\"package-row-link\"").length() == 21 && longSearchNext.body.split("class=\"package-row-link\"").length() == 6 && longDynamicSearchNext.body.split("class=\"package-row-link\"").length() == 6),
      Test.that("search pages continue declaration matches", longSearch.body.split("class=\"package-symbol-row\"").length() == 21 && longSearchNext.body.split("class=\"package-symbol-row\"").length() == 21 && longSearchNext.body.contains("page=3") && longDynamicSearchNext.body.split("class=\"package-symbol-row\"").length() == 21),
      Test.that("a package filter searches inside one project and keeps the filter", filteredSearch.status.code == 200 && filteredSearch.body.split("class=\"package-symbol-row\"").length() == 1 && filteredSearch.body.split("class=\"package-row-link\"").length() == 1 && filteredSearch.body.contains("name=\"filter\" value=\"@alice/missing\"") && filteredSearch.body.contains("class=\"package-search-active-filter\" href=\"/packages/search?q=json\"") && filteredSearch.body.contains("No matching packages") && knownFilterSearch.body.split("class=\"package-symbol-row\"").length() == 4 && knownFilterSearch.body.split("class=\"package-row-link\"").length() == 1 && knownFilterSearch.body.contains(" in @alice/json-0") && filteredDynamicSearch.status.code == 200 && filteredDynamicSearch.body.split("class=\"package-symbol-row\"").length() == 1),
      Test.that("search refuses pages beyond its result count", longSearchBeyond.status.code == 404 && longDynamicSearchBeyond.status.code == 404 && Web.render(&longSite, "/packages/page/999").status.code == 404),
      Test.that("ticket and contribution histories serve bounded pages", longTicketPage.body.split("class=\"discussion-row\"").length() == 21 && longTicketPage.body.contains("href=\"/@alice/json-kit/tickets/page/2\"") && longTicketNext.status.code == 200 && longTicketNext.body.split("class=\"discussion-row\"").length() == 6 && longContributionNext.status.code == 200 && longContributionNext.body.split("class=\"discussion-row\"").length() == 6),
      Test.that("numbered list pages are in the static path graph", sitemapHasAll(&longSitemap, origin, &["/packages/page/2", "/@alice/page/2"]) && sitemapHasAll(&discussionSitemap, origin, &["/@alice/json-kit/tickets/page/2", "/@alice/json-kit/contributions/page/2"])),
      Test.that("a missing snapshot file tree fails startup", Result.isErr(&brokenPackages)),
      Test.that("the dynamic loader accepts a JSON-only package snapshot", Result.isOk(&compactPackages)),
      Test.that("package search presents focused project and declaration results", packageSearch.status.code == 200 && packageSearch.body.contains("package-search-panel") && packageSearch.body.contains("json-kit") && packageSearch.body.contains("package-symbol-row") && packageSearch.body.contains("noindex,follow")),
      Test.that("dynamic package search keeps declaration matches without API documents", dynamicPackageSearch.status.code == 200 && dynamicPackageSearch.body.contains("JsonKit.Parse.</span><span>one") && dynamicPackageSearch.body.contains("/@alice/json-kit/docs#JsonKit-Parse-fn-one")),
      Test.that("a handle shows its public projects", packageProfile.status.code == 200 && packageProfile.body.contains("Alice")),
      Test.that("a project overview shows its README and install command", packageOverview.status.code == 200 && packageOverview.body.contains("Parse and build JSON") && packageOverview.body.contains("pudu install @alice/json-kit")),
      Test.that("a source file has linkable lines", packageSource.status.code == 200 && packageSource.body.contains("id=\"L1\"")),
      Test.that("a binary release file has a source page", packageBinary.status.code == 200 && packageBinary.body.contains("no text preview")),
