module Test.LivePackages

import Std.Bytes as ByteSeq
import Std.Io as Io
import Std.Option as Option
import Std.Test as Test
import Service.LiveIndex as LiveIndex
import Service.LivePackages as LivePackages
import Service.LiveSource as LiveSource
import Service.Packages as Packages
import Test.LiveStand as Stand

fn names(packages: &Packages.Packages) -> Array[Str] { packages.projects.map(|held: Packages.Project| held.name) }

fn versions(project: &Option[Packages.Project]) -> Array[Str] {
  match project {
    case Some(held) => held.releases.map(|entry: Packages.Release| entry.version)
    case None => []
  }
}

fn release(project: &Option[Packages.Project], version: Str) -> Option[Packages.Release] {
  let held = (*project) ?
  for candidate in held.releases {
    if candidate.version == version { return Some(candidate) }
  }
  None
}

fn classified(code: Int) -> Str {
  match LiveSource.classify(code, &ByteSeq.fromText("x"), "t") {
    case LiveSource.Fetched(_, tag) => "fetched " + tag
    case LiveSource.Unchanged => "unchanged"
    case LiveSource.Missing => "missing"
    case LiveSource.Failed => "failed"
  }
}

export fn main() -> Int {
  let snapshot = match Packages.loadCompact("website/test/fixtures/packages") {
    case Ok(value) => value
    case Err(_) => { return 1 }
  }

  // GitHub answering: a new package enters, a known one is refreshed.
  let up = Stand.stand(&Stand.github())
  let live = Stand.live(&up)
  let view = LivePackages.current(&live, &snapshot)
  let fresh = Packages.find(&view.packages, "@bruno", "fresh-pkg")
  let known = Packages.find(&view.packages, "@alice", "json-kit")
  let firstCalls = Stand.calls(&up)
  let _again = LivePackages.current(&live, &snapshot)
  let memoCalls = Stand.calls(&up)
  Stand.advance(&up, 60)
  let _rebuilt = LivePackages.current(&live, &snapshot)
  let rememberedCalls = Stand.calls(&up)
  Stand.advance(&up, 120)
  let _expired = LivePackages.current(&live, &snapshot)
  let refetchCalls = Stand.calls(&up)
  let revalidated = Stand.unchanged(&up)

  // GitHub failing after it answered: the remembered answer is served, and
  // GitHub is left alone for the quiet window.
  Stand.takeDown(&up)
  Stand.advance(&up, 300)
  let staleView = LivePackages.current(&live, &snapshot)
  let failedCalls = Stand.calls(&up)
  Stand.advance(&up, 31)
  let _quiet = LivePackages.current(&live, &snapshot)
  let quietCalls = Stand.calls(&up)

  // GitHub never answering: the snapshot, unchanged.
  let outage = Stand.stand(&Stand.github())
  Stand.takeDown(&outage)
  let dark = LivePackages.current(&Stand.live(&outage), &snapshot)

  // A package leaving the topic: hidden once a complete search omits it, and
  // kept while the search is cut short.
  let leaving = Stand.stand(&Stand.github())
  let leavingLive = Stand.live(&leaving)
  let _before = LivePackages.current(&leavingLive, &snapshot)
  let remaining = Stand.listed().filter(|item: Str| !item.contains("\"json-kit\""))
  Stand.answer(&leaving, LiveIndex.SEARCH_URL, Stand.searchPage(&remaining, 4))
  Stand.advance(&leaving, 200)
  let gone = LivePackages.current(&leavingLive, &snapshot)
  Stand.answer(&leaving, LiveIndex.SEARCH_URL, Stand.searchPage(&remaining, 250))
  Stand.advance(&leaving, 200)
  let partial = LivePackages.current(&leavingLive, &snapshot)

  let suite = Test.suite("live packages", &[
      Test.that("a package published after the build is listed", view.live && names(&view.packages).contains("@bruno/fresh-pkg")),
      Test.equals("every tag whose manifest names the package is a release, newest first", &versions(&fresh), &["0.2.0", "0.1.0"]),
      Test.that("a GitHub release gives its publication date, author, and notes", match release(&fresh, "0.2.0") {
          case Some(held) => held.publishedAt == "2026-09-25T09:30:00Z" && held.publisher == "bruno" && held.notes == "Second release." && held.commit == "c2" && held.dependencies == [("@alice/json-kit", "^2.0.0")]
          case None => false
        }),
      Test.that("a tag without a GitHub release is dated by its commit", match release(&fresh, "0.1.0") {
          case Some(held) => held.publishedAt == "2026-09-20T12:00:00Z" && held.publisher.isEmpty()
          case None => false
        }),
      Test.that("its manifest, README, and search result describe it", match fresh {
          case Some(held) => held.latest == Some("0.2.0") && held.description == "Fresh things" && held.keywords == ["fresh"] && held.license == "MIT" && held.root == "FreshPkg" && held.readme.contains("Published after the build")
          case None => false
        }),
      Test.that("its new owner gains a profile", Packages.profile(&view.packages, "@bruno") != None),
      Test.that("a known package takes GitHub's counts and only its newer release", match known {
          case Some(held) => held.stars == 2000 && held.latest == Some("2.1.0") && versions(&known) == ["2.1.0", "2.0.0", "1.1.0", "1.0.0"] && held.files.isEmpty()
          case None => false
        }),
      Test.that("the newer release is dated by its GitHub release", Option.map(release(&known, "2.1.0"), |held: Packages.Release| held.publishedAt) == Some("2026-09-23T08:00:00Z")),
      Test.equals("a manifest naming another package, an archived repository, and a name the build refuses stay out", &names(&view.packages), &["@alice/json-kit", "@bruno/fresh-pkg"]),
      Test.equals("the merged index is reused within its window", &memoCalls, &firstCalls),
      Test.equals("a rebuild inside the listing's freshness asks GitHub nothing", &rememberedCalls, &firstCalls),
      Test.equals("an expired listing is asked for once, and fresh release answers are reused", &refetchCalls, &(firstCalls + 1)),
      Test.equals("an expired listing is revalidated by its entity tag", &revalidated, &1),
      Test.that("a failing GitHub leaves the remembered index served", staleView.live && names(&staleView.packages).contains("@bruno/fresh-pkg")),
      Test.equals("a failure makes GitHub quiet for a window rather than asked per request", &quietCalls, &failedCalls),
      Test.that("GitHub unavailable from the start serves the snapshot", !dark.live && names(&dark.packages) == names(&snapshot)),
      Test.that("a complete search hides a snapshot package it no longer lists", gone.live && !names(&gone.packages).contains("@alice/json-kit") && names(&gone.packages).contains("@bruno/fresh-pkg")),
      Test.that("a search cut short hides nothing", names(&partial.packages).contains("@alice/json-kit")),
      Test.equals("200, 304, and 404 speak for a repository; nothing else does", &[classified(200), classified(304), classified(404), classified(403), classified(429), classified(502)], &["fetched t", "unchanged", "missing", "failed", "failed", "failed"]),
      Test.that("slugs are lower-case words joined by single hyphens", LiveIndex.slug("fresh-pkg") && !LiveIndex.slug("Bad_Name") && !LiveIndex.slug("-x") && !LiveIndex.slug("a--b") && !LiveIndex.slug(""))
    ])
  let report = Test.run(&suite)
  for failure in report.failures { let _shown = Io.writeErrorLine(failure) }
  Test.report(&report)
}
