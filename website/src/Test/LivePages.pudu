module Test.LivePages

import Std.Http as Http
import Std.Io as Io
import Std.Option as Option
import Std.Test as Test
import Prerender as Prerender
import Service.LiveDiscussions as LiveDiscussions
import Service.LiveFiles as LiveFiles
import Service.LivePackages as LivePackages
import Service.Packages as Packages
import Test.LiveStand as Stand
import Web.Dynamic as DynamicWeb

fn cacheOf(response: &Http.Response) -> Str { Option.unwrapOr(Http.header(&response.headers, "cache-control"), "") }

export fn main() -> Int {
  let snapshot = match Packages.loadCompact("website/test/fixtures/packages") {
    case Ok(value) => value
    case Err(_) => { return 1 }
  }
  let routed = Stand.edge(&snapshot, &Stand.live(&Stand.stand(&Stand.github())))
  let page = DynamicWeb.render(&routed, "/@bruno/fresh-pkg")
  let releasesPage = DynamicWeb.render(&routed, "/@bruno/fresh-pkg/releases")
  let listing = DynamicWeb.render(&routed, "/packages")
  let owner = DynamicWeb.render(&routed, "/@bruno")
  let unknown = DynamicWeb.render(&routed, "/@bruno/not-published")
  let impostor = DynamicWeb.render(&routed, "/@carol/impostor")
  let notHandle = DynamicWeb.render(&routed, "/bruno/fresh-pkg")
  let offline = Stand.edge(&snapshot, &LivePackages.offline())
  let offlineListing = DynamicWeb.render(&offline, "/packages")
  let offlinePage = DynamicWeb.render(&offline, "/@bruno/fresh-pkg")
  let snapshotSource = DynamicWeb.render(&offline, "/@alice/json-kit/source/src/JsonKit/Parse.pudu")
  let snapshotDocs = DynamicWeb.render(&offline, "/@alice/json-kit/docs")
  let snapshotTickets = DynamicWeb.render(&offline, "/@alice/json-kit/tickets")
  let snapshotMissingFile = DynamicWeb.render(&offline, "/@alice/json-kit/source/nothing.pudu")
  // Conversations are read live for every package, known ones included.
  let talking = Stand.stand(&Stand.github())
  let repos = "https://api.github.com/repos/alice/json-kit/"
  let listed = "?state=all&sort=updated&direction=desc&per_page=100"
  Stand.answer(&talking, repos + "issues" + listed, "[\{\"number\":7,\"title\":\"Live ticket\",\"body\":\"Opened today.\",\"state\":\"open\",\"user\":\{\"login\":\"dana\"\},\"labels\":[\{\"name\":\"bug\"\}],\"comments\":2,\"created_at\":\"2026-09-25T10:00:00Z\",\"updated_at\":\"2026-09-25T11:00:00Z\"\},\{\"number\":8,\"title\":\"A pull, not a ticket\",\"state\":\"open\",\"pull_request\":\{\"url\":\"x\"\},\"user\":\{\"login\":\"eve\"\}\}]")
  Stand.answer(&talking, repos + "pulls" + listed, "[\{\"number\":9,\"title\":\"Merged work\",\"state\":\"closed\",\"merged_at\":\"2026-09-25T12:00:00Z\",\"draft\":false,\"user\":\{\"login\":\"eve\"\},\"created_at\":\"2026-09-24T09:00:00Z\",\"updated_at\":\"2026-09-25T12:00:00Z\"\}]")
  let talked = Stand.edge(&snapshot, &Stand.live(&talking))
  // A release the build never saw has its files read at its commit.
  let reading = Stand.stand(&Stand.github())
  Stand.answer(&reading, "https://api.github.com/repos/bruno/fresh-pkg/git/trees/c2?recursive=1", "\{\"tree\":[\{\"path\":\"src\",\"type\":\"tree\"\},\{\"path\":\"src/FreshPkg.pudu\",\"type\":\"blob\",\"size\":48\},\{\"path\":\"pudu.toml\",\"type\":\"blob\",\"size\":90\},\{\"path\":\".github/ci.yml\",\"type\":\"blob\",\"size\":10\},\{\"path\":\"deps/x/Y.pudu\",\"type\":\"blob\",\"size\":10\}]\}")
  Stand.answer(&reading, "https://raw.githubusercontent.com/bruno/fresh-pkg/c2/src/FreshPkg.pudu", "module FreshPkg\n\nexport fn freshness() -> Int \{ 1 \}\n")
  let read = Stand.edge(&snapshot, &Stand.live(&reading))
  let liveFile = DynamicWeb.render(&read, "/@bruno/fresh-pkg/source/src/FreshPkg.pudu")
  let liveSource = DynamicWeb.render(&read, "/@bruno/fresh-pkg/source")
  let liveHidden = DynamicWeb.render(&read, "/@bruno/fresh-pkg/source/.github/ci.yml")
  // A release's API reference is the catalogue `pudu release` attached to it.
  let documented = Stand.stand(&Stand.github())
  Stand.answer(&documented, "https://github.com/bruno/fresh-pkg/releases/download/v0.2.0/pudu-api.json", "\{\"schemaVersion\":1,\"languageVersion\":\"0.1.2\",\"entries\":[\{\"module\":\"FreshPkg\",\"kind\":\"fn\",\"name\":\"freshness\",\"signature\":\"() -> Int\",\"doc\":[\"How fresh it is.\"]\}]\}")
  let liveDocs = DynamicWeb.render(&Stand.edge(&snapshot, &Stand.live(&documented)), "/@bruno/fresh-pkg/docs")
  let undocumented = DynamicWeb.render(&Stand.edge(&snapshot, &Stand.live(&Stand.stand(&Stand.github()))), "/@bruno/fresh-pkg/docs")
  let liveTickets = DynamicWeb.render(&talked, "/@alice/json-kit/tickets")
  let liveTicket = DynamicWeb.render(&talked, "/@alice/json-kit/tickets/7")
  let liveContributions = DynamicWeb.render(&talked, "/@alice/json-kit/contributions")

  let suite = Test.suite("live package pages", &[
      Test.that("the function renders a new package's page, cached at the edge", page.status.code == 200 && page.body.contains("fresh-pkg") && page.body.contains("Fresh Package") && cacheOf(&page) == DynamicWeb.LIVE_CACHE),
      Test.that("the function renders a new package's releases with their dates", releasesPage.status.code == 200 && releasesPage.body.contains("0.2.0") && releasesPage.body.contains("0.1.0") && releasesPage.body.contains("2026-09-20")),
      Test.that("the listing includes the new package", listing.status.code == 200 && listing.body.contains("/@bruno/fresh-pkg") && listing.body.contains("/@alice/json-kit") && cacheOf(&listing) == DynamicWeb.LIVE_CACHE),
      Test.that("the new owner's profile answers", owner.status.code == 200 && owner.body.contains("/@bruno/fresh-pkg")),
      Test.that("an unlisted package is missing, briefly cached, and not indexed", unknown.status.code == 404 && cacheOf(&unknown) == DynamicWeb.MISSING_CACHE && Http.header(&unknown.headers, "X-Robots-Tag") == Some("noindex")),
      Test.equals("an impostor has no page", &impostor.status.code, &404),
      Test.equals("a path without a handle is no package", &notHandle.status.code, &404),
      Test.that("without GitHub the listing is the snapshot, cached briefly", offlineListing.status.code == 200 && !offlineListing.body.contains("fresh-pkg") && cacheOf(&offlineListing) == DynamicWeb.SNAPSHOT_CACHE),
      Test.equals("without GitHub a new package waits for it", &offlinePage.status.code, &404),
      Test.that("the function serves a snapshot release's source from the snapshot's files", snapshotSource.status.code == 200 && snapshotSource.body.contains("Parse.pudu") && cacheOf(&snapshotSource) == DynamicWeb.SNAPSHOT_CACHE),
      Test.that("the function serves a snapshot release's API from its catalogue", snapshotDocs.status.code == 200 && snapshotDocs.body.contains("textOf")),
      Test.equals("the function serves a snapshot project's discussions", &snapshotTickets.status.code, &200),
      Test.that("a known package's tickets are GitHub's current ones, pull requests left out", liveTickets.status.code == 200 && liveTickets.body.contains("Live ticket") && !liveTickets.body.contains("A pull, not a ticket")),
      Test.that("a live ticket has its own page", liveTicket.status.code == 200 && liveTicket.body.contains("Opened today.") && liveTicket.body.contains("dana")),
      Test.that("a merged pull request is a merged contribution", liveContributions.status.code == 200 && liveContributions.body.contains("Merged work") && liveContributions.body.contains("erged")),
      Test.that("a new release's file is read at its commit", liveFile.status.code == 200 && liveFile.body.contains("freshness") && liveFile.body.contains("src/FreshPkg.pudu")),
      Test.that("a new release's file list leaves out dot paths and installed dependencies", liveSource.status.code == 200 && liveSource.body.contains("pudu.toml") && !liveSource.body.contains(".github/ci.yml") && !liveSource.body.contains("deps/x")),
      Test.equals("a dot path is not one of its files", &liveHidden.status.code, &404),
      Test.that("a new release's API reference is the catalogue attached to it", liveDocs.status.code == 200 && liveDocs.body.contains("freshness") && liveDocs.body.contains("How fresh it is.")),
      Test.that("a release published without a catalogue says so rather than missing", undocumented.status.code == 200 && undocumented.body.contains("No API reference has been generated")),
      Test.that("only a package's own files are shipped", LiveFiles.shipped("src/A.pudu") && !LiveFiles.shipped(".env") && !LiveFiles.shipped("src/.cache/a") && !LiveFiles.shipped("deps/a/B.pudu") && !LiveFiles.shipped("")),
      Test.equals("a repository address reads as its owner and name", &LiveDiscussions.pathOf("https://github.com/alice/json-kit"), &"alice/json-kit"),
      Test.equals("an address outside GitHub has no path", &LiveDiscussions.pathOf("https://example.com/a/b"), &""),
      Test.that("a file the release lacks is missing and briefly cached", snapshotMissingFile.status.code == 404 && cacheOf(&snapshotMissingFile) == DynamicWeb.MISSING_CACHE),
      Test.that("package pages and the listing are answered by the function, not written", Prerender.answeredLive("/@alice/json-kit/source") && Prerender.answeredLive("/@alice") && Prerender.answeredLive("/packages") && Prerender.answeredLive("/packages/page/2") && !Prerender.answeredLive("/packages/avatars/a.png") && !Prerender.answeredLive("/docs"))
    ])
  let report = Test.run(&suite)
  for failure in report.failures { let _shown = Io.writeErrorLine(failure) }
  Test.report(&report)
}
