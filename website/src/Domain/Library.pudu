/// The modules shown beneath a section's module: every module whose name
/// continues it and that no section lists on its own.
export fn childrenOf(parent: Str, modules: &Array[Str]) -> Array[Str] {
  var found: Array[Str] = []
  for name in *modules {
    if name.startsWith(parent + ".") && !listed(name) { found = found.push(name) }
  }
  found
}

/// The modules no section reaches, so a module added to the library is still
/// shown somewhere before it is given a place.
export fn unplaced(modules: &Array[Str]) -> Array[Str] {
  var found: Array[Str] = []
  for name in *modules {
    if !listed(name) && !underListed(name) { found = found.push(name) }
  }
  found
}

fn listed(name: Str) -> Bool {
  for section in SECTIONS {
    if section.modules.contains(name) { return true }
  }
  false
}

fn underListed(name: Str) -> Bool {
  for section in SECTIONS {
    for parent in section.modules {
      if name.startsWith(parent + ".") { return true }
    }
  }
  false
}
