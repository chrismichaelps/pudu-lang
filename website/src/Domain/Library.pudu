module Domain.Library

/// A part of the standard library a reader looks for by what it is for.
///
/// `modules` lists the modules a section opens with. A module whose name
/// continues one of those, such as `Std.Http.Server.Route` under `Std.Http`, is
/// shown beneath it rather than as a row of its own, so the page reads as a
/// map of families instead of a list of every file.
export type Section = { id: Str, title: Str, lead: Str, modules: Array[Str] }

export const SECTIONS: Array[Section] = [
  Section{id: "core", title: "Core values", lead: "The types every program uses: optional values, results, characters, comparisons, and the traits behind them.", modules: [
      "Std.Option", "Std.Result", "Std.Bool", "Std.Char", "Std.Tuple", "Std.Function", "Std.Order", "Std.Show", "Std.Num", "Std.Mappable"
    ] },
  Section{id: "text", title: "Text", lead: "Searching, building, parsing, and formatting text.", modules: [
      "Std.Text", "Std.Fmt", "Std.Regex", "Std.Glob", "Std.Diff", "Std.Intern", "Std.Semver", "Std.Uuid", "Std.Validate", "Std.Human"
    ] },
  Section{id: "numbers", title: "Numbers", lead: "Arithmetic past the operators: exact decimals, bit manipulation, randomness, and numeric columns.", modules: [
      "Std.Math", "Std.Decimal", "Std.Bits", "Std.Random", "Std.Column", "Std.Stats"
    ] },
  Section{id: "collections", title: "Collections", lead: "Arrays, maps, sets, and the specialised structures for when the ordinary ones are not the right shape. Collections never change in place: every operation answers a new value.", modules: [
      "Std.List", "Std.Map", "Std.Set", "Std.Iter", "Std.NonEmpty", "Std.Deque", "Std.Heap", "Std.HashMap", "Std.SortedMap", "Std.LinkedMap", "Std.FlatMap", "Std.IntMap", "Std.IntSet", "Std.EnumMap", "Std.BiMap", "Std.MultiMap", "Std.MultiKeyMap", "Std.Tree", "Std.PrefixTrie", "Std.Graph", "Std.DisjointSet", "Std.FenwickTree", "Std.IntervalTree", "Std.RingBuffer", "Std.LruCache", "Std.BitSet", "Std.BitVector", "Std.BloomFilter", "Std.RadixSort"
    ] },
  Section{id: "system", title: "Files, processes, and time", lead: "Everything that talks to the machine a program runs on.", modules: [
      "Std.Io", "Std.Fs", "Std.Path", "Std.Env", "Std.Args", "Std.Process", "Std.Signal", "Std.Time", "Std.Log", "Std.Out", "Std.Term", "Std.Cron"
    ] },
  Section{id: "formats", title: "Data formats", lead: "Reading and writing the formats programs exchange.", modules: [
      "Std.Json", "Std.Csv", "Std.Toml", "Std.Yaml", "Std.Xml", "Std.Mime", "Std.Dotenv"
    ] },
  Section{id: "bytes", title: "Bytes, hashing, and compression", lead: "Binary data, encodings, non-cryptographic hashes, and archives.", modules: [
      "Std.Bytes", "Std.Buffer", "Std.ByteOrder", "Std.Hex", "Std.Varint", "Std.Adler32", "Std.Murmur3", "Std.SipHash", "Std.Checksum", "Std.Compress.Gzip", "Std.Archive.Tar", "Std.Archive.Zip"
    ] },
  Section{id: "web", title: "Networking and the web", lead: "Sockets, TLS, HTTP clients and servers, HTML, and mail.", modules: [
      "Std.Net", "Std.Tls", "Std.Url", "Std.Http", "Std.Html", "Std.Site", "Std.Ip", "Std.Mail"
    ] },
  Section{id: "applications", title: "Applications and databases", lead: "The pieces a service is assembled from: configuration, health, sessions, jobs, and SQL databases.", modules: [
      "Std.App", "Std.Db", "Std.Crypto", "Std.RateLimiter"
    ] },
  Section{id: "concurrency", title: "Concurrency", lead: "Parallel workers, the channels between them, and the state they share.", modules: [
      "Std.Concurrent", "Std.Channel", "Std.Sync"
    ] },
  Section{id: "media", title: "Interfaces, audio, and video", lead: "Drawing, layout, desktop windows, and exact audio and video timing, written in Pudu itself.", modules: [
      "Std.Ui", "Std.Audio", "Std.Video"
    ] },
  Section{id: "testing", title: "Testing and measuring", lead: "Suites that `pudu test` runs, generated properties, and benchmarks.", modules: [
      "Std.Test", "Std.Bench"
    ] }
]

