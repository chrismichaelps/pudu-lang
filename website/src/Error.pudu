module Error

export type SiteError
  = BadSetting(Str)
  | CatalogueUnreadable(Str)
  | CatalogueInvalid
  | CatalogueEmpty
  | DocsUnreadable(Str)
  | DocumentUnreadable(Str)
  | ReleasesUnreadable(Str)
  | ReleaseNotesUnreadable(Str)
  | ReleasesInvalid
  | ReleasesEmpty
  | ExamplesUnreadable(Str)
  | PlaygroundMisconfigured(Str)
  | ListenFailed

export fn explain(problem: &SiteError) -> Str {
  match problem {
    case BadSetting(name) => "invalid website setting: " + name
    case CatalogueUnreadable(path) => "the API catalogue could not be read at " + path
    case CatalogueInvalid => "the API catalogue is not valid generated documentation"
    case CatalogueEmpty => "the API catalogue contains no public declarations"
    case DocsUnreadable(path) => "the documentation pages could not be read at " + path
    case DocumentUnreadable(path) => "a published document could not be read at " + path
    case ReleasesUnreadable(path) => "the published releases could not be read at " + path
    case ReleaseNotesUnreadable(version) => "the release notes for " + version + " could not be read"
    case ReleasesInvalid => "the published releases are not a valid release document"
    case ReleasesEmpty => "the published releases carry no archive to download"
    case ExamplesUnreadable(path) => "the playground examples could not be read at " + path
    case PlaygroundMisconfigured(reason) => "the playground is misconfigured: " + reason
    case ListenFailed => "the website listener could not start"
  }
}
