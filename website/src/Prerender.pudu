module Prerender

import Std.Env as Env
import Std.Http as Http
import Std.Io as Io
import Std.Option as Option
import Std.Site as Build
import Config as Config
import Error as SiteError
import Seo as Seo
import Site as Site
import Web.Routes as Web

/// Every page the site has, written to disk.
///
/// The pages a crawler and a first visitor see are static files on a CDN rather
/// than a function invocation, which is what makes them arrive in one round trip
/// and what keeps them arriving when nothing is running.
///
/// Rendering them is a function call. `Web.render` answers a response for a
/// path, so producing three thousand pages is three thousand calls and no
/// server, no port, and no requests a program makes to itself. The Node script
/// this replaces started the site, waited for it to say it was listening,
/// fetched every route over a socket with twelve workers, and killed it — all to
/// reach a function it could not call.
///
/// What is rendered comes from `Seo.paths`, which is the same list the sitemap
/// is built from. Those two disagreeing is the failure worth preventing: a page
/// in the sitemap that was never rendered is a crawler following a link to
/// nothing, and a page rendered but missing from the sitemap is one nobody is
/// told about.
fn main() -> Int {
  let into = Option.unwrapOr(Env.at(0), "")
  if into.isEmpty() {
    let _said = Io.writeErrorLine("usage: prerender <Build Output directory>")
    return 1
  }
  let settings = match Config.load() {
    case Ok(loaded) => loaded
    case Err(problem) => { return failed(&problem) }
  }
  let site = match Site.load(&settings) {
    case Ok(loaded) => loaded
    case Err(problem) => { return failed(&problem) }
  }
  // The pages, and the two files that are not pages: a crawler asks for both
  // before it asks for anything else, and neither belongs in the sitemap that
  // one of them points at.
  var routes = Seo.paths(&site.catalog, &site.docs, &site.playground.examples, &site.packages)
  routes = routes.push("/robots.txt")
  routes = routes.push("/sitemap.xml")

  // Rendered on every core through the one build step any Pudu site uses.
  // Files whose bytes are already there are left alone, so a rebuild writes,
  // and a deployment uploads, only what changed.
  // The routes a request takes before a page is looked for. Everything else
  // — the pages, the directories they live in, and the function that answers
  // what no page does — is derived by the build from what it wrote.
  let revalidated = "public, max-age=0, must-revalidate"
  let layout = Build.Options {
    output: into,
    publicDirectory: "",
    workers: 8,
    target: Build.Vercel,
    fallback: Some("dynamic"),
    routes: [
      Build.Redirect{pattern: "/guide", location: "/docs", permanent: true},
      Build.Header{pattern: "/assets/playground/*", name: "cache-control", value: revalidated},
      Build.Header{pattern: "/assets/docs/*", name: "cache-control", value: revalidated},
      Build.Header{pattern: "/assets/download/*", name: "cache-control", value: revalidated},
      Build.Header{pattern: "/assets/pudu/*", name: "cache-control", value: revalidated},
      Build.Header{pattern: "/packages/avatars/*", name: "cache-control", value: "public, max-age=86400, stale-while-revalidate=604800"},
      Build.ToFunction{pattern: "/playground", methods: ["POST"]},
      Build.ToFunction{pattern: "/api/playground/run", methods: []},
      Build.ToFunction{pattern: "/api/playground/assist", methods: []},
      Build.ToFunction{pattern: "/packages/search", methods: []},
      Build.ToFunction{pattern: "/packages/suggest", methods: []},
      Build.ToFunction{pattern: "/playground/shared", methods: []},
      Build.ToFunction{pattern: "/search", methods: []}
    ]
  }
  let report = match Build.build(&layout, &routes, |route: Str| Web.render(&site, route)) {
    case Ok(done) => done
    case Err(problem) => {
      let _said = Io.writeErrorLine("prerender: " + Build.explain(&problem))
      return 1
    }
  }
  // A route that does not answer is reported rather than written. Written, it
  // would be a page serving whatever the error rendered as, which reads as a
  // working page with wrong content — and the sitemap would point a crawler
  // at it.
  for refusal in report.refused {
    let _said = Io.writeErrorLine("prerender: " + refusal.path + " " + refusal.reason)
  }
  let _reported = Io.writeLine("prerendered into " + into + ": " + Build.summary(&report))
  if Build.succeeded(&report) { 0 } else { 1 }
}

fn failed(problem: &SiteError.SiteError) -> Int {
  let _said = Io.writeErrorLine(SiteError.explain(problem))
  1
}
