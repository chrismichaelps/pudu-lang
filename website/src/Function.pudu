module Function

import Std.Bytes as ByteSeq
import Std.Http as Http
import Std.Http.Server.Lambda as Lambda
import Std.Http.Server.Route as Route
import Std.Io as Io
import Std.Json as Json
import Std.Option as Option
import Config as Config
import Error as SiteError
import Service.Catalog as Catalog
import Service.Playground.Examples as Examples
import Service.Playground as Playground
import Service.Search as Search
import Web.Dynamic as Web

const SEARCH_INDEX_PATH: Str = "website/data/search-index.pudu-data"

/// The site, served to a platform that invokes it rather than connects to it.
///
/// Every page this answers is rendered by `Web.Routes` from `View`, which is the
/// same code `Main.pudu` serves over a socket and the same code `Test.Website`
/// checks. There is no second description of a page anywhere: what a platform
/// changes is how a request arrives, and that is all this module is.
///
/// The catalogue and the playground's examples are read once, before the first
/// invocation is taken, because a platform freezes the process between
/// requests rather than ending it — so work done here is done once per cold
/// start and work done per request is done every time. Reading three thousand
/// declarations per request is the difference between a page and a timeout.
fn main() -> Int {
  match Config.loadServing() {
    case Err(problem) => couldNotStart(&problem)
    case Ok(serving) => {
      let settings = serving[0]
      if let Some(problem) = serving[1] {
        let _reported = Io.writeErrorLine("playground switched off: " + SiteError.explain(&problem))
      }
      let catalog = match Catalog.loadSearch(SEARCH_INDEX_PATH) {
        case Ok(loaded) => loaded
        case Err(problem) => { return couldNotStart(&problem) }
      }
      let examples = match Examples.load(settings.playground.examplesPath) {
        case Ok(loaded) => loaded
        case Err(problem) => { return couldNotStart(&problem) }
      }
      // A function holds the platform's credentials in its environment and
      // files. It runs a program itself only confined: the program is given an
      // emptied environment, and the runtime refuses it files, programs,
      // connections, and foreign calls. Any other isolation it cannot provide,
      // so told to use one it serves the playground switched off and says why.
      let local = settings.playground.runner == Config.RUNNER_LOCAL
      let playground = if local && settings.playground.isolation != Config.ISOLATION_CONFINED {
        let _reported = Io.writeErrorLine("playground switched off: a serverless function runs programs only with PUDU_PLAYGROUND_ISOLATION=confined, or through a runner's URL")
        Config.switchedOff()
      } else {
        settings.playground
      }
      let edge = Web.Dynamic {
        siteUrl: settings.siteUrl,
        catalog: catalog,
        search: Search.index(&catalog.entries),
        playground: Playground.configured(&playground, &examples),
        gates: Playground.gatesFor(&playground)
      }
      let served = Lambda.serveEnvironment(fn(event: Json.Json) -> Result[Str, Str] {
          Ok(answered(&Web.answer(&edge, requestOf(&event))))
        })
      match served {
        case Ok(_) => 0
        case Err(problem) => {
          let _said = Io.writeLine(Lambda.explain(&problem))
          1
        }
      }
    }
  }
}

/// The request an invocation carries, as the routes read one.
///
/// The method, headers, and body are read from the request document as well
/// as the path: the playground is posted to, and a function that knew only
/// paths would answer every post as though it were a page being asked for.
export fn requestOf(event: &Json.Json) -> Route.Request {
  let request = requestIn(event)
  let target = pathIn(event)
  let method = firstText(&request, &["method", "httpMethod"])
  let stated = if method.isEmpty() { nestedMethod(&request) } else { method }
  let headers = headersIn(&request)
  let raw = Option.unwrapOr(textAt(&request, "body"), "")
  let encoded = Option.unwrapOr(textAt(&request, "encoding"), "") == "base64"
    || Option.unwrapOr(flagAt(&request, "isBase64Encoded"), false)
  let message = if encoded {
    match ByteSeq.decodeBase64(raw) {
      case Ok(bytes) => {
        match ByteSeq.toText(&bytes) {
          case Ok(text) => Http.Request{method: Http.methodFrom(upper(stated)), target: target, headers: headers, body: text, binaryBody: None}
          case Err(_) => Http.Request{method: Http.methodFrom(upper(stated)), target: target, headers: headers, body: "", binaryBody: Some(bytes)}
        }
      }
      case Err(_) => Http.Request{method: Http.methodFrom(upper(stated)), target: target, headers: headers, body: "", binaryBody: None}
    }
  } else {
    Http.Request{method: Http.methodFrom(upper(stated)), target: target, headers: headers, body: raw, binaryBody: None}
  }
  Route.Request {
    message: message,
    path: Route.pathOf(target),
    params: mapOf([]),
    query: Route.queryOf(target),
    peer: "platform"
  }
}

fn upper(method: Str) -> Str { if method.isEmpty() { "GET" } else { method.toUpper() } }

/// The method in the shape an HTTP API gateway nests it.
fn nestedMethod(request: &Json.Json) -> Str {
  match Json.path(request, &["requestContext", "http", "method"]) {
    case Some(found) => Option.unwrapOr(Json.asText(&found), "")
    case None => ""
  }
}

/// The request's headers, with their names in lower case.
///
/// A platform may send a header as text or as a list of texts; a list is
/// joined the way HTTP joins repeated headers.
fn headersIn(request: &Json.Json) -> Array[(Str, Str)] {
  let held = match Json.field(request, "headers") {
    case Some(value) => value
    case None => { return [] }
  }
  var found: Array[(Str, Str)] = []
  for entry in Option.unwrapOr(Json.asObject(&held), []) {
    let name = entry[0].toLower()
    match Json.asText(&entry[1]) {
      case Some(value) => { found = found.push((name, value)) }
      case None => {
        var joined: Array[Str] = []
        for member in Option.unwrapOr(Json.asList(&entry[1]), []) {
          if let Some(value) = Json.asText(&member) { joined = joined.push(value) }
        }
        if joined.length() > 0 { found = found.push((name, joined.join(", "))) }
      }
    }
  }
  found
}

fn flagAt(event: &Json.Json, name: Str) -> Option[Bool] {
  let held = Json.field(event, name) ?
  Json.asBool(&held)
}

/// The path and query an invocation is asking for.
///
/// Read from the shapes a platform actually sends rather than from one of them.
/// A request URL arrives as `rawPath` with `rawQueryString` beside it, or as
/// `path`, or as a whole `url` — and a reader that knew one shape would answer
/// every request with the site's front page, which looks like a working
/// deployment with broken routing rather than like a reader that did not
/// understand the event.
export fn pathIn(event: &Json.Json) -> Str {
  let request = requestIn(event)
  let whole = firstText(&request, &["rawPath", "path", "url"])
  let query = Option.unwrapOr(textAt(&request, "rawQueryString"), "")
  let target = if whole.isEmpty() { "/" } else { whole }
  if query.isEmpty() || target.contains("?") { target } else { target + "?" + query }
}

/// The HTTP request carried by a platform invocation.
///
/// AWS-compatible gateway events expose their path directly. Vercel's provided
/// runtime carries its request document as JSON text in `body` and marks the
/// outer event as `Action: Invoke`.
fn requestIn(event: &Json.Json) -> Json.Json {
  if Option.unwrapOr(textAt(event, "Action"), "") != "Invoke" { return *event }
  let body = Option.unwrapOr(textAt(event, "body"), "")
  match Json.decode(body) {
    case Ok(request) => request
    case Err(_) => *event
  }
}

fn firstText(event: &Json.Json, names: &Array[Str]) -> Str {
  var found = ""
  for name in names {
    if found.isEmpty() { found = Option.unwrapOr(textAt(event, name), "") }
  }
  found
}

fn textAt(event: &Json.Json, name: Str) -> Option[Str] {
  let held = Json.field(event, name) ?
  Json.asText(&held)
}

/// One answer, in the shape a platform reads a response from.
///
/// Headers are carried as an object rather than dropped: the pages state their
/// own content type, their caching, and their canonical address, and a response
/// that arrived without them would be served as text and indexed as a duplicate.
export fn answered(response: &Http.Response) -> Str {
  var headers: Array[(Str, Json.Json)] = []
  for header in response.headers {
    headers = headers.push((header[0], Json.Text(header[1])))
  }
  Json.encode(&Json.object(&[
        ("statusCode", Json.Number(response.status.code)),
        ("headers", Json.object(&headers)),
        ("body", Json.Text(response.body)),
        ("isBase64Encoded", Json.Boolean(false))
      ]))
}

/// Say the function could not start, rather than answering every request with
/// the same failure.
///
/// A platform told a function never started stops sending it work and reports
/// a deployment that failed. A function that starts and then fails every
/// request reports a service that is up and broken, which is read as a fault in
/// the application rather than in what it was given.
fn couldNotStart(problem: &SiteError.SiteError) -> Int {
  let reason = SiteError.explain(problem)
  let _said = Io.writeLine(reason)
  // Told to the platform when there is one. Run outside a platform this is a
  // program that failed to start and said so, which is the same thing.
  if let Some(runtime) = Lambda.fromEnvironment() {
    let _told = Lambda.failedToStart(&runtime, reason)
    ()
  }
  1
}
