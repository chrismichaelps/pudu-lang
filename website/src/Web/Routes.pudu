module Web.Routes

import Std.Http as Http
import Std.Http.Server.Reply as Reply
import Std.Http.Server.Route as Route
import Std.Io as Io
import Std.Option as Option
import Constants as Constants
import Seo as Seo
import Service.Catalog as Catalog
import Service.Docs as Docs
import Service.Documents as Documents
import Service.Releases as Releases
import View.About as About
import View.Docs as DocsView
import View.Document as Document
import View.Documentation as Documentation
import View.Donation as Donation
import View.Download as Download
import View.Home as Home
import View.Releases as ReleasesView

export fn routes(siteUrl: Str, catalog: &Catalog.Catalog, docs: &Docs.Docs, release: &Releases.Release, documents: &Documents.Documents) -> Route.Router {
  Route.withFallback(&Route.routing(&[
        Route.get("/", fn(_request: Route.Request) -> Http.Response {
            Reply.page(200, Home.home(siteUrl, catalog, release))
          }),
        Route.get("/search", fn(asked: Route.Request) -> Http.Response {
            Reply.page(200, Home.results(siteUrl, catalog, Option.unwrapOr(Route.queryParam(&asked, "q"), "")))
          }),
        Route.get("/modules", fn(_request: Route.Request) -> Http.Response {
            Reply.page(200, Documentation.modules(siteUrl, catalog))
          }),
        Route.get("/module/:module", fn(asked: Route.Request) -> Http.Response {
            let name = Option.unwrapOr(Route.param(&asked, "module"), "")
            match Documentation.modulePage(siteUrl, catalog, name) {
              case Some(page) => Reply.page(200, page)
              case None => Reply.page(404, Documentation.missing(siteUrl, asked.path))
            }
          }),
        Route.get("/docs/:module/:kind/:name", fn(asked: Route.Request) -> Http.Response {
            let moduleName = Option.unwrapOr(Route.param(&asked, "module"), "")
            let kind = Option.unwrapOr(Route.param(&asked, "kind"), "")
            let name = Option.unwrapOr(Route.param(&asked, "name"), "")
            let entries = Catalog.findAll(catalog, moduleName, kind, name)
            if entries.length() == 0 {
              Reply.page(404, Documentation.missing(siteUrl, asked.path))
            } else {
              Reply.page(200, Documentation.symbols(siteUrl, &entries))
            }
          }),
        Route.get("/docs", fn(_request: Route.Request) -> Http.Response {
            Reply.page(200, DocsView.index(siteUrl, docs, catalog.languageVersion))
          }),
        Route.get("/docs/:page", fn(asked: Route.Request) -> Http.Response {
            let slug = Option.unwrapOr(Route.param(&asked, "page"), "")
            match DocsView.page(siteUrl, docs, slug, catalog.languageVersion) {
              case Some(page) => Reply.page(200, page)
              case None => Reply.page(404, Documentation.missing(siteUrl, asked.path))
            }
          }),
        // The guide became the documentation. The old address still answers,
        // with the documentation's own canonical address, so a link to it keeps
        // working and a crawler is told which address to keep.
        Route.get("/guide", fn(_request: Route.Request) -> Http.Response {
            Reply.page(200, DocsView.index(siteUrl, docs, catalog.languageVersion))
          }),
        Route.get("/download", fn(_request: Route.Request) -> Http.Response {
            Reply.page(200, Download.page(siteUrl, release))
          }),
        Route.get("/releases", fn(_request: Route.Request) -> Http.Response {
            Reply.page(200, ReleasesView.page(siteUrl, release))
          }),
        Route.get("/conduct", fn(asked: Route.Request) -> Http.Response {
            published(siteUrl, documents, "conduct", &asked)
          }),
        Route.get("/contributing", fn(asked: Route.Request) -> Http.Response {
            published(siteUrl, documents, "contributing", &asked)
          }),
        Route.get("/security", fn(asked: Route.Request) -> Http.Response {
            published(siteUrl, documents, "security", &asked)
          }),
        Route.get("/community", fn(asked: Route.Request) -> Http.Response {
            published(siteUrl, documents, "community", &asked)
          }),
        Route.get("/privacy", fn(asked: Route.Request) -> Http.Response {
            published(siteUrl, documents, "privacy", &asked)
          }),
        Route.get("/brand", fn(asked: Route.Request) -> Http.Response {
            published(siteUrl, documents, "brand", &asked)
          }),
        Route.get("/about", fn(_request: Route.Request) -> Http.Response {
            Reply.page(200, About.page(siteUrl))
          }),
        Route.get("/donate", fn(_request: Route.Request) -> Http.Response {
            Reply.page(200, Donation.page(siteUrl))
          }),
        Route.get("/health", fn(_request: Route.Request) -> Http.Response { noIndex(Reply.text(200, "ok")) }),
        Route.get("/robots.txt", fn(_request: Route.Request) -> Http.Response {
            cached(Reply.text(200, Seo.robots(siteUrl)), "text/plain; charset=utf-8")
          }),
        Route.get("/sitemap.xml", fn(_request: Route.Request) -> Http.Response {
            cached(Reply.text(200, Seo.sitemap(siteUrl, catalog, docs)), "application/xml; charset=utf-8")
          }),
        Route.get("/assets/site.css", fn(_request: Route.Request) -> Http.Response {
            stylesheet()
          }),
        Route.get("/assets/pudu-lang-full-logo.png", fn(_request: Route.Request) -> Http.Response {
            binary("website/public/assets/pudu-lang-full-logo.png", "image/png")
          }),
        Route.get("/assets/pudu-lang-short.png", fn(_request: Route.Request) -> Http.Response {
            binary("website/public/assets/pudu-lang-short.png", "image/png")
          }),
        Route.get("/fonts/Nunito-Book.ttf", fn(_request: Route.Request) -> Http.Response {
            binary("website/public/fonts/Nunito-Book.ttf", "font/ttf")
          }),
        Route.get("/fonts/Nunito-Bold.ttf", fn(_request: Route.Request) -> Http.Response {
            binary("website/public/fonts/Nunito-Bold.ttf", "font/ttf")
          }),
        Route.get("/fonts/Nunito-BookItalic.ttf", fn(_request: Route.Request) -> Http.Response {
            binary("website/public/fonts/Nunito-BookItalic.ttf", "font/ttf")
          }),
        Route.get("/fonts/Nunito-BoldItalic.ttf", fn(_request: Route.Request) -> Http.Response {
            binary("website/public/fonts/Nunito-BoldItalic.ttf", "font/ttf")
          })
      ]), fn(asked: Route.Request) -> Http.Response {
      Reply.page(404, Documentation.missing(siteUrl, asked.path))
    })
}

export fn requestFor(target: Str) -> Route.Request {
  Route.Request {
    message: Http.Request{method: Http.Get, target: target, headers: [], body: "", binaryBody: None},
    path: Route.pathOf(target),
    params: mapOf([]),
    query: Route.queryOf(target),
    peer: "platform"
  }
}

export fn render(siteUrl: Str, catalog: &Catalog.Catalog, docs: &Docs.Docs, release: &Releases.Release, documents: &Documents.Documents, target: Str) -> Http.Response {
  Route.dispatch(&routes(siteUrl, catalog, docs, release, documents), requestFor(target))
}

/// A document the repository keeps, or the missing page when there is none.
fn published(siteUrl: Str, documents: &Documents.Documents, slug: Str, asked: &Route.Request) -> Http.Response {
  match Document.page(siteUrl, documents, slug) {
    case Some(page) => Reply.page(200, page)
    case None => Reply.page(404, Documentation.missing(siteUrl, asked.path))
  }
}

fn binary(path: Str, mediaType: Str) -> Http.Response {
  match Io.readAllBytes(path) {
    case Ok(bytes) => cached(Reply.bytes(200, mediaType, &bytes), mediaType)
    case Err(_) => Reply.text(404, "asset not found")
  }
}

fn stylesheet() -> Http.Response {
  match Io.read(Constants.STYLESHEET_PATH) {
    case Ok(content) => cached(Reply.text(200, content), "text/css; charset=utf-8")
    case Err(_) => Reply.text(404, "asset not found")
  }
}

fn cached(response: Http.Response, mediaType: Str) -> Http.Response {
  Http.Response {
    status: response.status,
    headers: [("content-type", mediaType), ("cache-control", "public, max-age=3600")],
    body: response.body,
    binaryBody: response.binaryBody
  }
}

fn noIndex(response: Http.Response) -> Http.Response {
  Http.Response {
    status: response.status,
    headers: response.headers.push(("X-Robots-Tag", "noindex")),
    body: response.body,
    binaryBody: response.binaryBody
  }
}
