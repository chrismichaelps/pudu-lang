module Web.Routes

import Std.Char as Chars
import Std.Html as Html
import Std.Http as Http
import Std.Http.Server.Reply as Reply
import Std.Http.Server.Route as Route
import Std.Io as Io
import Std.Json as Json
import Std.Option as Option
import Std.Text as Text
import App.Messages as Messages
import App.Static as StaticApp
import Constants as Constants
import PuduLangMediator.Mediator as Mediator
import PuduLangMediator as Messaging
import Seo as Seo
import Service.Packages as Packages
import Service.Playground.Admission as Admission
import View.Documentation as Documentation
import View.Packages.Catalog as PackageCatalog
import View.Packages.Suggest as PackageSuggest
import Web.Access as Access
import Web.Answers as Answers
import Web.PackagePages as PackagePages
import Web.Playground as PlaygroundWeb

/// Every route of the complete site.
///
/// Every page is a message sent to the application's mediator, so validation,
/// logging, and failure handling apply to each the same way; assets are read
/// here. The playground's routes are its own module's, served here with the
/// peer of each connection as the reader: this router is reached directly or
/// through a proxy this program cannot vouch for, so no forwarded address is
/// believed.
export fn routes(app: &StaticApp.App) -> Route.Router {
  let held = *app
  let siteUrl = held.site.siteUrl
  let packages = held.site.packages
  let playground = PlaygroundWeb.Serving {
    siteUrl: siteUrl,
    playground: held.site.playground,
    reader: Admission.peerReader,
    mediator: held.mediator,
    kinds: held.kinds,
    missing: fn(path: Str) -> Http.Response { missing(siteUrl, path) }
  }
  Route.withFallback(&Route.routing(&PlaygroundWeb.routes(&playground).concat([
          Route.get("/", fn(asked: Route.Request) -> Http.Response { screen(&held, Messages.Home, asked.path) }),
          Route.get("/search", fn(asked: Route.Request) -> Http.Response {
              page(&held, asked.path, &Mediator.send(&held.mediator, &held.kinds.search, Messages.SearchQuery{query: queryOf(&asked, "q")}))
            }),
          Route.get("/modules", fn(asked: Route.Request) -> Http.Response { screen(&held, Messages.Modules, asked.path) }),
          Route.get("/module/:module", fn(asked: Route.Request) -> Http.Response {
              page(&held, asked.path, &Mediator.send(&held.mediator, &held.kinds.reference, Messages.ModuleQuery{name: paramOf(&asked, "module")}))
            }),
          Route.get("/docs/:module/:kind/:name", fn(asked: Route.Request) -> Http.Response {
              let symbol = Messages.SymbolQuery{moduleName: paramOf(&asked, "module"), kind: paramOf(&asked, "kind"), name: paramOf(&asked, "name")}
              page(&held, asked.path, &Mediator.send(&held.mediator, &held.kinds.symbol, symbol))
            }),
          Route.get("/docs", fn(asked: Route.Request) -> Http.Response { screen(&held, Messages.DocsIndex, asked.path) }),
          Route.get("/docs/:page", fn(asked: Route.Request) -> Http.Response {
              page(&held, asked.path, &Mediator.send(&held.mediator, &held.kinds.doc, Messages.SlugQuery{slug: paramOf(&asked, "page")}))
            }),
          // The guide became the documentation. The old address still answers,
          // with the documentation's own canonical address, so a link to it keeps
          // working and a crawler is told which address to keep.
          Route.get("/guide", fn(asked: Route.Request) -> Http.Response { screen(&held, Messages.DocsIndex, asked.path) }),
          Route.get("/download", fn(asked: Route.Request) -> Http.Response { screen(&held, Messages.Download, asked.path) }),
          Route.get("/releases", fn(asked: Route.Request) -> Http.Response { screen(&held, Messages.Releases, asked.path) }),
          Route.get("/packages", fn(asked: Route.Request) -> Http.Response { listing(&held, asked.path, 1) }),
          Route.get("/packages/search", fn(asked: Route.Request) -> Http.Response {
              let query = Messages.PackageQuery{query: queryOf(&asked, "q"), filter: queryOf(&asked, "filter"), page: pageOf(Option.unwrapOr(Route.queryParam(&asked, "page"), "1"))}
              page(&held, asked.path, &shownPage(Mediator.send(&held.mediator, &held.kinds.packages, query)))
            }),
          Route.get(PackageSuggest.PATH, fn(asked: Route.Request) -> Http.Response {
              let suggested = Mediator.send(&held.mediator, &held.kinds.suggest, Messages.SuggestQuery{query: queryOf(&asked, "q"), filter: queryOf(&asked, "filter")})
              Answers.json(&askedFor(siteUrl, asked.path), &suggestions(suggested))
            }),
          Route.get("/packages/page/:page", fn(asked: Route.Request) -> Http.Response {
              let number = pageOf(paramOf(&asked, "page"))
              if number < 2 { missing(siteUrl, asked.path) } else { listing(&held, asked.path, number) }
            }),
          Route.get("/packages/avatars/:login", fn(asked: Route.Request) -> Http.Response {
              let login = paramOf(&asked, "login")
              match Packages.avatarBytes(&packages, login) {
                case Some(bytes) => {
                  let mediaType = if login.endsWith(".jpg") { "image/jpeg" } else if login.endsWith(".webp") { "image/webp" } else if login.endsWith(".gif") { "image/gif" } else { "image/png" }
                  cached(Reply.bytes(200, mediaType, &bytes), mediaType)
                }
                case None => Reply.text(404, "asset not found")
              }
            }),
          Route.get("/conduct", fn(asked: Route.Request) -> Http.Response { published(&held, "conduct", asked.path) }),
          Route.get("/contributing", fn(asked: Route.Request) -> Http.Response { published(&held, "contributing", asked.path) }),
          Route.get("/security", fn(asked: Route.Request) -> Http.Response { published(&held, "security", asked.path) }),
          Route.get("/community", fn(asked: Route.Request) -> Http.Response { published(&held, "community", asked.path) }),
          Route.get("/privacy", fn(asked: Route.Request) -> Http.Response { published(&held, "privacy", asked.path) }),
          Route.get("/brand", fn(asked: Route.Request) -> Http.Response { published(&held, "brand", asked.path) }),
          Route.get("/about", fn(asked: Route.Request) -> Http.Response { screen(&held, Messages.About, asked.path) }),
          Route.get("/donate", fn(asked: Route.Request) -> Http.Response { screen(&held, Messages.Donate, asked.path) }),
          Route.get("/health", fn(_request: Route.Request) -> Http.Response { noIndex(Reply.text(200, "ok")) }),
          Route.get("/robots.txt", fn(_request: Route.Request) -> Http.Response {
              cached(Reply.text(200, Seo.robots(siteUrl)), "text/plain; charset=utf-8")
            }),
          Route.get("/sitemap.xml", fn(_request: Route.Request) -> Http.Response {
              cached(Reply.text(200, Seo.sitemap(siteUrl, &held.site.catalog, &held.site.docs, &held.site.playground.examples, &packages)), "application/xml; charset=utf-8")
            }),
          Route.get("/assets/site.css", fn(_request: Route.Request) -> Http.Response {
              asset(Constants.STYLESHEET_PATH, "text/css; charset=utf-8")
            }),
          Route.get("/assets/playground/*module", fn(asked: Route.Request) -> Http.Response {
              scriptModule(Constants.PLAYGROUND_SCRIPTS_DIRECTORY, Option.unwrapOr(Route.param(&asked, "module"), ""))
            }),
          Route.get("/assets/docs/*module", fn(asked: Route.Request) -> Http.Response {
              scriptModule(Constants.DOCS_SCRIPTS_DIRECTORY, Option.unwrapOr(Route.param(&asked, "module"), ""))
            }),
          Route.get("/assets/download/*module", fn(asked: Route.Request) -> Http.Response {
              scriptModule(Constants.DOWNLOAD_SCRIPTS_DIRECTORY, Option.unwrapOr(Route.param(&asked, "module"), ""))
            }),
          Route.get("/assets/pudu/*module", fn(asked: Route.Request) -> Http.Response {
              scriptModule(Constants.PUDU_SCRIPTS_DIRECTORY, Option.unwrapOr(Route.param(&asked, "module"), ""))
            }),
          Route.get("/assets/packages/files/:icon", fn(asked: Route.Request) -> Http.Response {
              let icon = Option.unwrapOr(Route.param(&asked, "icon"), "")
              if !["pudu.png", "markdown.svg", "toml.svg", "json.svg", "yaml.svg", "js.svg", "css.svg", "html.svg", "text.svg"].contains(icon) { return Reply.text(404, "asset not found") }
              binary("website/public/assets/packages/files/" + icon, if icon.endsWith(".png") { "image/png" } else { "image/svg+xml" })
            }),
          Route.get("/assets/packages/*module", fn(asked: Route.Request) -> Http.Response {
              scriptModule(Constants.PACKAGES_SCRIPTS_DIRECTORY, Option.unwrapOr(Route.param(&asked, "module"), ""))
            }),
          Route.get("/assets/pudu-lang-full-logo.png", fn(_request: Route.Request) -> Http.Response {
              binary("website/public/assets/pudu-lang-full-logo.png", "image/png")
            }),
          Route.get("/assets/pudu-lang-short.png", fn(_request: Route.Request) -> Http.Response {
              binary("website/public/assets/pudu-lang-short.png", "image/png")
            }),
          Route.get("/assets/pudu-lang-logo.webp", fn(_request: Route.Request) -> Http.Response {
              binary("website/public/assets/pudu-lang-logo.webp", "image/webp")
            }),
          Route.get("/assets/pudu-lang-mark.webp", fn(_request: Route.Request) -> Http.Response {
              binary("website/public/assets/pudu-lang-mark.webp", "image/webp")
            }),
          Route.get("/favicon.ico", fn(_request: Route.Request) -> Http.Response {
              binary("website/public/favicon.ico", "image/x-icon")
            }),
          Route.get("/site.webmanifest", fn(_request: Route.Request) -> Http.Response {
              asset("website/public/site.webmanifest", "application/manifest+json")
            }),
          Route.get("/assets/pudu-lang-icon-48.png", fn(_request: Route.Request) -> Http.Response {
              binary("website/public/assets/pudu-lang-icon-48.png", "image/png")
            }),
          Route.get("/assets/pudu-lang-icon-96.png", fn(_request: Route.Request) -> Http.Response {
              binary("website/public/assets/pudu-lang-icon-96.png", "image/png")
            }),
          Route.get("/assets/pudu-lang-icon-192.png", fn(_request: Route.Request) -> Http.Response {
              binary("website/public/assets/pudu-lang-icon-192.png", "image/png")
            }),
          Route.get("/assets/pudu-lang-icon-512.png", fn(_request: Route.Request) -> Http.Response {
              binary("website/public/assets/pudu-lang-icon-512.png", "image/png")
            }),
          Route.get("/assets/apple-touch-icon.png", fn(_request: Route.Request) -> Http.Response {
              binary("website/public/assets/apple-touch-icon.png", "image/png")
            }),
          Route.get("/assets/pudu-lang-social.png", fn(_request: Route.Request) -> Http.Response {
              binary("website/public/assets/pudu-lang-social.png", "image/png")
            }),
          Route.get("/fonts/Nunito-Book.woff2", fn(_request: Route.Request) -> Http.Response {
              binary("website/public/fonts/Nunito-Book.woff2", "font/woff2")
            }),
          Route.get("/fonts/Nunito-Bold.woff2", fn(_request: Route.Request) -> Http.Response {
              binary("website/public/fonts/Nunito-Bold.woff2", "font/woff2")
            }),
          Route.get("/fonts/Nunito-BookItalic.woff2", fn(_request: Route.Request) -> Http.Response {
              binary("website/public/fonts/Nunito-BookItalic.woff2", "font/woff2")
            }),
          Route.get("/fonts/Nunito-BoldItalic.woff2", fn(_request: Route.Request) -> Http.Response {
              binary("website/public/fonts/Nunito-BoldItalic.woff2", "font/woff2")
            })
        ].concat(PackagePages.routes(&PackagePages.Pages{siteUrl: siteUrl, packages: packages, detail: fn(project: Packages.Project, _tab: Str, _file: Str) -> Packages.Project { project }, missing: fn(path: Str) -> Http.Response { missing(siteUrl, path) }})))), fn(asked: Route.Request) -> Http.Response {
      missing(siteUrl, asked.path)
    })
}

/// A page with nothing to fill in, as the mediator answers it.
fn screen(app: &StaticApp.App, shown: Messages.Screen, path: Str) -> Http.Response {
  page(app, path, &Mediator.send(&app.mediator, &app.kinds.screen, shown))
}

/// A page outcome as this router answers it.
fn page(app: &StaticApp.App, path: Str, outcome: &Messaging.Outcome[Html.Html, Messages.Problem]) -> Http.Response {
  Answers.page(&askedFor(app.site.siteUrl, path), outcome)
}

/// One page of the package listing.
fn listing(app: &StaticApp.App, path: Str, number: Int) -> Http.Response {
  page(app, path, &shownPage(Mediator.send(&app.mediator, &app.kinds.listing, Messages.ListingQuery{page: number})))
}

/// A document the repository keeps, or the missing page when there is none.
fn published(app: &StaticApp.App, slug: Str, path: Str) -> Http.Response {
  page(app, path, &Mediator.send(&app.mediator, &app.kinds.document, Messages.SlugQuery{slug: slug}))
}

/// The page a shown outcome holds; this router serves every page as fixed.
fn shownPage(outcome: Messaging.Outcome[Messages.Shown, Messages.Problem]) -> Messaging.Outcome[Html.Html, Messages.Problem] {
  Ok(outcome ?.page)
}

/// The JSON a suggestions outcome holds.
fn suggestions(outcome: Messaging.Outcome[Messages.Suggested, Messages.Problem]) -> Messaging.Outcome[Json.Json, Messages.Problem] {
  Ok(outcome ?.body)
}

/// How this router answers a failure at `path`.
fn askedFor(siteUrl: Str, path: Str) -> Answers.Asked {
  Answers.Asked{siteUrl: siteUrl, path: path, missing: fn(missed: Str) -> Http.Response { missing(siteUrl, missed) }}
}

/// The complete site's missing page.
fn missing(siteUrl: Str, path: Str) -> Http.Response { Reply.page(404, Documentation.missing(siteUrl, path)) }

/// A query parameter, or empty text when the request has none.
fn queryOf(asked: &Route.Request, name: Str) -> Str { Option.unwrapOr(Route.queryParam(asked, name), "") }

/// A path parameter, or empty text when the route has none.
fn paramOf(asked: &Route.Request, name: Str) -> Str { Option.unwrapOr(Route.param(asked, name), "") }

fn pageOf(raw: Str) -> Int { Option.unwrapOr(Text.wholeOf(raw), 0) }

/// A request for a page, as a platform or a test asks for one: a `GET` with no
/// headers and nothing in its body.
export fn requestFor(target: Str) -> Route.Request {
  Route.Request {
    message: Http.Request{method: Http.Get, target: target, headers: [], body: "", binaryBody: None},
    path: Route.pathOf(target),
    params: mapOf([]),
    query: Route.queryOf(target),
    peer: "platform"
  }
}

/// The site's answer to a request for a page.
export fn render(app: &StaticApp.App, target: Str) -> Http.Response {
  answer(app, requestFor(target))
}

/// The site's answer to any request, with its access event written.
export fn answer(app: &StaticApp.App, request: Route.Request) -> Http.Response {
  let router = routes(app)
  Access.around(&app.logs.requests, request, fn(passed: Route.Request) -> Http.Response { Route.dispatch(&router, passed) })
}

fn binary(path: Str, mediaType: Str) -> Http.Response {
  match Io.readAllBytes(path) {
    case Ok(bytes) => cached(Reply.bytes(200, mediaType, &bytes), mediaType)
    case Err(_) => Reply.text(404, "asset not found")
  }
}

/// One of the script modules in `directory`, by its path below it.
///
/// Only lower-case names of letters and dashes, in folders named the same way
/// and ending in `.js`, are served: nothing else in the folder and nothing
/// outside it. The modules import one another by relative address, which
/// carries no version, so each is checked again on every load rather than kept
/// for an hour, and a deployment that changes one is seen at once.
fn scriptModule(directory: Str, path: Str) -> Http.Response {
  if !isModulePath(path) { return Reply.text(404, "asset not found") }
  match Io.read(directory + "/" + path) {
    case Ok(content) => {
      Http.Response {
        ..Reply.text(200, content),
        headers: [("content-type", "text/javascript; charset=utf-8"), ("cache-control", "no-cache")]
      }
    }
    case Err(_) => Reply.text(404, "asset not found")
  }
}

/// Whether a path names a script module the way the folder names them.
export fn isModulePath(path: Str) -> Bool {
  if !path.endsWith(".js") { return false }
  for segment in path.take(path.length() - ".js".length()).split("/") {
    if segment.isEmpty() { return false }
    for character in segment.chars() {
      if !(Chars.isLower(character) || character == '-') { return false }
    }
  }
  true
}

fn asset(path: Str, mediaType: Str) -> Http.Response {
  match Io.read(path) {
    case Ok(content) => cached(Reply.text(200, content), mediaType)
    case Err(_) => Reply.text(404, "asset not found")
  }
}

fn cached(response: Http.Response, mediaType: Str) -> Http.Response {
  Http.Response {
    status: response.status,
    headers: [("content-type", mediaType), ("cache-control", "public, max-age=3600")],
    body: response.body,
    binaryBody: response.binaryBody
  }
}

fn noIndex(response: Http.Response) -> Http.Response {
  Http.Response {
    status: response.status,
    headers: response.headers.push(("X-Robots-Tag", "noindex")),
    body: response.body,
    binaryBody: response.binaryBody
  }
}
