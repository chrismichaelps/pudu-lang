module Web.Dynamic

import Std.Html as Html
import Std.Http as Http
import Std.Http.Server.Reply as Reply
import Std.Http.Server.Route as Route
import Std.Json as Json
import Std.Option as Option
import Std.Text as Text
import App.Dynamic as DynamicApp
import App.Messages as Messages
import PuduLangMediator.Mediator as Mediator
import PuduLangMediator as Messaging
import Service.LivePackages as LivePackages
import Service.Packages as Packages
import Service.Playground.Admission as Admission
import View.Dynamic as DynamicView
import View.Packages.Suggest as PackageSuggest
import Web.Access as Access
import Web.Answers as Answers
import Web.PackagePages as PackagePages
import Web.Playground as PlaygroundWeb

/// The function's routes: search, the playground's dynamic addresses, the
/// package listing, every package page, and a no-index answer for everything else.
///
/// Every answer except a package page is a message sent to the function's
/// mediator. The platform stands in front of the function and states the
/// reader's address in `x-forwarded-for`, so that is who a run is counted against.
export fn routes(app: &DynamicApp.App) -> Route.Router {
  let held = *app
  let siteUrl = held.edge.siteUrl
  let playground = PlaygroundWeb.Serving {
    siteUrl: siteUrl,
    playground: held.edge.playground,
    reader: Admission.forwardedReader,
    mediator: held.mediator,
    kinds: held.kinds,
    missing: fn(path: Str) -> Http.Response { missing(siteUrl, path) }
  }
  let search = Route.get("/search", fn(asked: Route.Request) -> Http.Response {
      let query = Messages.SearchQuery{query: Option.unwrapOr(Route.queryParam(&asked, "q"), "")}
      Answers.page(&askedFor(siteUrl, asked.path), &Mediator.send(&held.mediator, &held.kinds.search, query))
    })
  let packageSearch = Route.get("/packages/search", fn(asked: Route.Request) -> Http.Response {
      let query = Messages.PackageQuery {
        query: Option.unwrapOr(Route.queryParam(&asked, "q"), ""),
        filter: Option.unwrapOr(Route.queryParam(&asked, "filter"), ""),
        page: Option.unwrapOr(Text.wholeOf(Option.unwrapOr(Route.queryParam(&asked, "page"), "1")), 0)
      }
      shown(siteUrl, asked.path, Mediator.send(&held.mediator, &held.kinds.packages, query))
    })
  let packageSuggest = Route.get(PackageSuggest.PATH, fn(asked: Route.Request) -> Http.Response {
      let query = Messages.SuggestQuery{query: Option.unwrapOr(Route.queryParam(&asked, "q"), ""), filter: Option.unwrapOr(Route.queryParam(&asked, "filter"), "")}
      match Mediator.send(&held.mediator, &held.kinds.suggest, query) {
        case Ok(suggested) => fresh(&suggested.freshness, Reply.jsonValue(200, suggested.body))
        case Err(failure) => Answers.failed(&askedFor(siteUrl, asked.path), &failure)
      }
    })
  let listing = Route.get("/packages", fn(asked: Route.Request) -> Http.Response { listed(&held, asked.path, 1) })
  let listingPage = Route.get("/packages/page/:page", fn(asked: Route.Request) -> Http.Response {
      let page = Option.unwrapOr(Text.wholeOf(Option.unwrapOr(Route.param(&asked, "page"), "")), 0)
      if page < 2 { return missing(siteUrl, asked.path) }
      listed(&held, asked.path, page)
    })
  Route.withFallback(&Route.routing(&PlaygroundWeb.routes(&playground).concat([search, packageSearch, packageSuggest, listing, listingPage])), fn(asked: Route.Request) -> Http.Response {
      if asked.path.startsWith("/@") { return packagePage(&held, asked) }
      missing(siteUrl, asked.path)
    })
}

/// The function's answer to a request, with its access event written.
export fn answer(app: &DynamicApp.App, request: Route.Request) -> Http.Response {
  let router = routes(app)
  Access.around(&app.logs.requests, request, fn(passed: Route.Request) -> Http.Response { Route.dispatch(&router, passed) })
}

/// The function's answer to a request for a page.
export fn render(app: &DynamicApp.App, target: Str) -> Http.Response {
  answer(app, Route.Request {
      message: Http.Request{method: Http.Get, target: target, headers: [], body: "", binaryBody: None},
      path: Route.pathOf(target),
      params: mapOf([]),
      query: Route.queryOf(target),
      peer: "platform"
    })
}

/// The listing as it stands now. The static listing is never served: the
/// platform sends `/packages` here so it includes packages published since the build.
fn listed(app: &DynamicApp.App, path: Str, page: Int) -> Http.Response {
  shown(app.edge.siteUrl, path, Mediator.send(&app.mediator, &app.kinds.listing, Messages.ListingQuery{page: page}))
}

/// A package page outcome: the page with its edge cache policy, a package that
/// may be listed in a minute as the short-lived missing page, or the failure's answer.
fn shown(siteUrl: Str, path: Str, outcome: Messaging.Outcome[Messages.Shown, Messages.Problem]) -> Http.Response {
  match outcome {
    case Ok(found) => fresh(&found.freshness, Reply.page(200, found.page))
    case Err(Messaging.Raised(Messages.NotYetListed)) => packageMissing(siteUrl, path)
    case Err(failure) => Answers.failed(&askedFor(siteUrl, path), &failure)
  }
}

/// How this router answers a failure at `path`.
fn askedFor(siteUrl: Str, path: Str) -> Answers.Asked {
  Answers.Asked{siteUrl: siteUrl, path: path, missing: fn(missed: Str) -> Http.Response { missing(siteUrl, missed) }}
}

/// The response with the edge cache policy its freshness calls for.
fn fresh(freshness: &Messages.Freshness, response: Http.Response) -> Http.Response {
  match freshness {
    case Messages.Live => Http.Response{..response, headers: response.headers.push(("cache-control", LIVE_CACHE))}
    case Messages.Snapshot => Http.Response{..response, headers: response.headers.push(("cache-control", SNAPSHOT_CACHE))}
    case Messages.Fixed => response
  }
}

/// Every page under `/@owner`. The platform sends all of them here rather
/// than serving files written at build time, so a page shows the package as
/// the merged index has it now. The index is consulted only once a request is
/// known to be a package page, and an arbitrary `@owner/repo` never causes
/// GitHub requests of its own: only a project the index lists has a page.
fn packagePage(app: &DynamicApp.App, asked: Route.Request) -> Http.Response {
  let view = LivePackages.current(&app.edge.live, &app.edge.packages)
  let held = app.edge
  let pages = PackagePages.Pages {
    siteUrl: held.siteUrl,
    packages: view.packages,
    detail: fn(project: Packages.Project, tab: Str, file: Str) -> Packages.Project { LivePackages.detail(&held.live, &held.packages, &project, tab, file) },
    missing: fn(path: Str) -> Http.Response { packageMissing(held.siteUrl, path) }
  }
  let answered = Route.dispatch(&Route.withFallback(&Route.routing(&PackagePages.routes(&pages)), fn(other: Route.Request) -> Http.Response { packageMissing(held.siteUrl, other.path) }), asked)
  if answered.status.code == 200 { fresh(&DynamicApp.freshnessOf(&view), answered) } else { answered }
}

/// The CDN keeps a package answer and refreshes it in the background, so
/// readers are answered from the edge while the function asks GitHub at most
/// once per window. An answer made without GitHub is kept briefly so the edge
/// recovers soon after GitHub does.
export const LIVE_CACHE: Str = "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
export const SNAPSHOT_CACHE: Str = "public, max-age=0, s-maxage=60, stale-while-revalidate=600"
export const MISSING_CACHE: Str = "public, max-age=0, s-maxage=60"

/// A package page that does not exist yet may exist in a minute.
fn packageMissing(siteUrl: Str, path: Str) -> Http.Response {
  let response = missing(siteUrl, path)
  Http.Response{..response, headers: response.headers.push(("cache-control", MISSING_CACHE))}
}

fn missing(siteUrl: Str, path: Str) -> Http.Response {
  noIndex(Reply.page(404, DynamicView.missing(siteUrl, path)))
}

fn noIndex(response: Http.Response) -> Http.Response {
  Http.Response {
    status: response.status,
    headers: response.headers.push(("X-Robots-Tag", "noindex")),
    body: response.body,
    binaryBody: response.binaryBody
  }
}
