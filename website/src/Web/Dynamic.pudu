module Web.Dynamic

import Std.Http as Http
import Std.Http.Server.Reply as Reply
import Std.Http.Server.Route as Route
import Std.Option as Option
import Service.Catalog as Catalog
import Service.Playground.Admission as Admission
import Service.Playground as Playground
import View.Dynamic as DynamicView
import Web.Playground as PlaygroundWeb

/// What the serverless function serves: the requests that are not static
/// files at the edge.
export type Dynamic = {
  siteUrl: Str,
  catalog: Catalog.Catalog,
  playground: Playground.Playground,
  gates: Playground.Gates
}

/// The function's routes: search, the playground's dynamic addresses, and a
/// no-index answer for everything else.
///
/// The platform stands in front of the function and states the reader's
/// address in `x-forwarded-for`, so that is who a run is counted against.
export fn routes(edge: &Dynamic) -> Route.Router {
  let held = *edge
  let playground = PlaygroundWeb.Serving {
    siteUrl: held.siteUrl,
    playground: held.playground,
    reader: Admission.forwardedReader,
    gates: held.gates,
    missing: fn(path: Str) -> Http.Response { missing(held.siteUrl, path) }
  }
  let search = Route.get("/search", fn(asked: Route.Request) -> Http.Response {
      Reply.page(200, DynamicView.results(held.siteUrl, &held.catalog.entries, Option.unwrapOr(Route.queryParam(&asked, "q"), "")))
    })
  Route.withFallback(&Route.routing(&PlaygroundWeb.routes(&playground).push(search)), fn(asked: Route.Request) -> Http.Response {
      missing(held.siteUrl, asked.path)
    })
}

/// The function's answer to a request.
export fn answer(edge: &Dynamic, request: Route.Request) -> Http.Response {
  Route.dispatch(&routes(edge), request)
}

/// The function's answer to a request for a page.
export fn render(edge: &Dynamic, target: Str) -> Http.Response {
  answer(edge, Route.Request {
      message: Http.Request{method: Http.Get, target: target, headers: [], body: "", binaryBody: None},
      path: Route.pathOf(target),
      params: mapOf([]),
      query: Route.queryOf(target),
      peer: "platform"
    })
}

fn missing(siteUrl: Str, path: Str) -> Http.Response {
  noIndex(Reply.page(404, DynamicView.missing(siteUrl, path)))
}

fn noIndex(response: Http.Response) -> Http.Response {
  Http.Response {
    status: response.status,
    headers: response.headers.push(("X-Robots-Tag", "noindex")),
    body: response.body,
    binaryBody: response.binaryBody
  }
}
