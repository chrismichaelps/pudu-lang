module Main

import Std.Http.Server as Server
import Std.Io as Io
import Config as Config
import Error as SiteError
import Site as Site
import Web.Routes as Web

fn main() -> Int {
  match Config.load() {
    case Err(problem) => fail(&problem)
    case Ok(settings) => {
      match Site.load(&settings) {
        case Err(problem) => fail(&problem)
        case Ok(site) => serve(&settings, &site)
      }
    }
  }
}

fn serve(settings: &Config.Config, site: &Site.Site) -> Int {
  match Server.start(settings.host, settings.port) {
    case Err(_) => fail(&SiteError.ListenFailed)
    case Ok(live) => {
      let _announced = Io.writeLine("Pudu docs listening on http://" + settings.host + ":" + show(Server.portOf(&live)))
      if site.playground.enabled {
        let _playground = Io.writeLine("Playground runs programs with runner " + settings.playground.runner)
      }
      let served = Server.server(&Web.routes(site)).withLimits(65536, settings.playground.sourceBytes * 4 + 65536)
      let result = Server.run(&served, &live, settings.connections)
      let _stopped = Server.stop(&live)
      match result {
        case Ok(_) => 0
        case Err(_) => 1
      }
    }
  }
}

fn fail(problem: &SiteError.SiteError) -> Int {
  let _written = Io.writeErrorLine(SiteError.explain(problem))
  1
}
