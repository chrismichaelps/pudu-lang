{
  "name": "pudu",
  "displayName": "Pudu",
  "description": "Language support for Pudu: diagnostics, hover, go to definition across modules, references, rename, semantic tokens, inlay hints, signature help, outline, workspace symbols, completion of members, imports, match arms and record fields, code actions, and formatting.",
  "version": "0.5.0",
  "publisher": "pudu-lang",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:pudu"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pudu",
        "aliases": [
          "Pudu"
        ],
        "extensions": [
          ".pudu"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/pudu-file.png",
          "dark": "./icons/pudu-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "pudu",
        "scopeName": "source.pudu",
        "path": "./syntaxes/pudu.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Pudu",
      "properties": {
        "pudu.serverPath": {
          "type": "string",
          "default": "pudu",
          "description": "Path to the pudu executable. The extension runs `<path> lsp`."
        },
        "pudu.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Log the messages between the editor and `pudu lsp` to the Pudu output channel."
        }
      }
    },
    "commands": [
      {
        "command": "pudu.restartServer",
        "title": "Restart Language Server",
        "category": "Pudu"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
