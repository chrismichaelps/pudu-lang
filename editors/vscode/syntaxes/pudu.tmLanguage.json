{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pudu",
  "scopeName": "source.pudu",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#derives"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#foreign"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#types"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.pudu",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.pudu",
          "match": "//.*$"
        },
        {
          "name": "comment.block.pudu",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pudu",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pudu",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.pudu",
              "begin": "\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.pudu"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.pudu"
                }
              },
              "contentName": "source.pudu.embedded",
              "patterns": [
                {
                  "include": "#interpolationBraces"
                },
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.pudu",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.pudu",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.pudu",
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?(d|f32|f64|[iu](8|16|32|64|128)?)?\\b"
        },
        {
          "name": "constant.numeric.pudu",
          "match": "\\b0[box][0-9a-fA-F_]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pudu",
          "match": "\\b(module|import|export|as|let|var|const|mut|fn|async|return|if|else|match|case|for|in|while|loop|break|continue|type|enum|struct|trait|impl|where|await|task|spawn|comptime|macro|unsafe|with|scope|dynamic)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.pudu",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "\\b(break|continue)\\s+(@[a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pudu"
            },
            "2": {
              "name": "entity.name.label.pudu"
            }
          }
        },
        {
          "name": "entity.name.label.pudu",
          "match": "@[a-z_][A-Za-z0-9_]*(?=\\s*(?:loop|while|for)\\b)"
        },
        {
          "name": "entity.name.function.decorator.pudu",
          "match": "@[a-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.pudu",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pudu"
            },
            "2": {
              "name": "entity.name.function.pudu"
            }
          }
        },
        {
          "match": "\\b(type|trait|enum|struct)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pudu"
            },
            "2": {
              "name": "entity.name.type.pudu"
            }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Z_][A-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pudu"
            },
            "2": {
              "name": "variable.other.constant.pudu"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.wrapping.pudu",
          "match": "&[+\\-*]"
        },
        {
          "name": "keyword.operator.saturating.pudu",
          "match": "[+\\-*]\\|"
        },
        {
          "name": "keyword.operator.propagate.pudu",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.arrow.pudu",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.range.pudu",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.comparison.pudu",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.pudu",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.pudu",
          "match": "<<|>>|\\^|~|&|\\|"
        },
        {
          "name": "keyword.operator.assignment.pudu",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.pudu",
          "match": "[+\\-*/%]"
        }
      ]
    },
    "foreign": {
      "patterns": [
        {
          "name": "meta.declaration.foreign.pudu",
          "begin": "^\\s*(?:(export)\\s+)?(foreign)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.pudu"
            },
            "2": {
              "name": "keyword.control.foreign.pudu"
            }
          },
          "end": "(?<=\\})",
          "patterns": [
            {
              "name": "keyword.other.foreign.pudu",
              "match": "\\b(version|owned|by)\\b"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#types"
            },
            {
              "include": "#numbers"
            }
          ]
        }
      ]
    },
    "interpolationBraces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#interpolationBraces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "derives": {
      "patterns": [
        {
          "match": "^\\s*(?:(export)\\s+)?(derive)\\s+(impl)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.pudu"
            },
            "2": {
              "name": "keyword.control.derive.pudu"
            },
            "3": {
              "name": "keyword.control.pudu"
            }
          }
        },
        {
          "match": "^\\s*(?:(export)\\s+)?(derive)\\s+([A-Z][A-Za-z0-9_.]*)",
          "captures": {
            "1": {
              "name": "keyword.control.pudu"
            },
            "2": {
              "name": "keyword.control.derive.pudu"
            },
            "3": {
              "name": "entity.name.type.pudu"
            }
          }
        },
        {
          "match": "\\b(derives)\\b(?=\\s+[A-Z])",
          "captures": {
            "1": {
              "name": "keyword.control.derive.pudu"
            }
          }
        }
      ]
    }
  }
}
