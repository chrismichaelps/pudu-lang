  c-sources:        cbits/pudu_ffi.c
                   cbits/pudu_sqlite.c
  extra-libraries:  ffi
  build-depends:
    base >=4.20 && <4.23,
    template-haskell >=2.22 && <2.25,
    bytestring >=0.11 && <0.13,
    containers >=0.6 && <0.9,
    directory >=1.3 && <1.4,
    entropy >=0.4.1 && <0.5,
    filepath >=1.4 && <1.6,
    haskeline >=0.8 && <0.9,
    network >=3.1 && <3.3,
    tls >=1.9 && <2.2,
    zlib >=0.7.1 && <0.8,
    crypton-x509-system >=1.6 && <1.7,
    crypton >=0.34 && <2,
    memory >=0.18 && <0.19,
    data-default-class >=0.1 && <0.3,
    stm >=2.5 && <2.6,
    process >=1.6 && <1.7,
    text >=2.1 && <2.2,
    time >=1.12 && <1.15
  if !os(windows)
    build-depends:  unix >=2.8 && <2.9
    cpp-options:    -DPUDU_POSIX_SIGNALS
  if os(osx)
    c-sources:      cbits/pudu_desktop.m
                    cbits/pudu_desktop_access.m
                    cbits/pudu_desktop_menu.m
                    cbits/pudu_audio.c
                    cbits/pudu_audio_stream.c
    cc-options:     -fobjc-arc
    cpp-options:    -DPUDU_DARWIN_DESKTOP -DPUDU_DARWIN_AUDIO
    frameworks:     AppKit AudioToolbox CoreGraphics

executable pudu
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  ghc-options:      -threaded -rtsopts
  build-depends:
    base >=4.20 && <4.23,
    containers >=0.6 && <0.8,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    process >=1.6 && <1.7,
    pudu,
    temporary >=1.3 && <1.4,
    text >=2.1 && <2.2,
    time >=1.12 && <1.15
