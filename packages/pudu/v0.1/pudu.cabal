cabal-version:      3.12
name:               pudu
version:            0.1.2
synopsis:           Pudu language compiler and tools
description:        A statically typed native systems language compiler with explicit safety and performance semantics.
category:           Language
maintainer:         chrismichaelps
license:            Apache-2.0 WITH LLVM-exception
license-file:       LICENSE
author:             Chris M. Perez Santiago
copyright:          (c) 2026 Chris M. Perez Santiago
homepage:           https://github.com/chrismichaelps/pudu-lang
bug-reports:        https://github.com/chrismichaelps/pudu-lang/issues
build-type:         Simple
extra-source-files: cbits/pudu_desktop.h
                    cbits/pudu_desktop_host.h
                    cbits/pudu_audio.h
                    cbits/pudu_audio_stream.h
data-files:         lib/Std/*.pudu
                    lib/Std/App/*.pudu
                    lib/Std/Audio/*.pudu
                    lib/Std/Archive/*.pudu
                    lib/Std/Bytes/*.pudu
                    lib/Std/Compress/*.pudu
                    lib/Std/Db/*.pudu
                    lib/Std/Db/Query/*.pudu
                    lib/Std/Html/*.pudu
                    lib/Std/Http/*.pudu
                    lib/Std/Http/Server/*.pudu
                    lib/Std/Mail/*.pudu
                    lib/Std/Math/*.pudu
                    lib/Std/Net/*.pudu
                    lib/Std/Test/*.pudu
                    lib/Std/Text/*.pudu
                    lib/Std/Time/*.pudu
                    lib/Std/Time/Format/*.pudu
                    lib/Std/Toml/*.pudu
                    lib/Std/Ui/*.pudu

source-repository head
  type:             git
  location:         https://github.com/chrismichaelps/pudu-lang.git

common warnings
  default-language: GHC2024
  default-extensions:
    NamedFieldPuns
    OverloadedStrings
    StrictData
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns

library
  import:           warnings
  hs-source-dirs:   src
  autogen-modules:   Paths_pudu
  other-modules:     Paths_pudu
  exposed-modules:
