module Std.Archive.Tar

import Std.Bytes as ByteSeq
import Std.Option as Option

/// Classification of a filesystem entry stored in a tar archive.
export type TarType
  = File
  | Directory
  | Symlink

/// A single file, directory, or link stored within a USTAR archive.
export type TarEntry = {
  path: Str,
  mode: Int,
  size: Int,
  mtime: Int,
  typeFlag: TarType,
  linkName: Str,
  data: Bytes
}

/// Structured failure conditions encountered while reading a tar stream.
export type TarError
  = CorruptHeader
  | InvalidChecksum
  | UnexpectedEof
  | UnsupportedType

/// Convenience constructor for a regular file entry.
export fn entry(path: Str, data: Bytes) -> TarEntry {
  TarEntry {
    path: path,
    mode: 420,
    size: data.length(),
    mtime: 1700000000,
    typeFlag: File,
    linkName: "",
    data: data
  }
}

/// Convenience constructor for a directory entry.
export fn directory(path: Str) -> TarEntry {
  let dirPath = if path.endsWith("/") { path } else { path + "/" }
  TarEntry {
    path: dirPath,
    mode: 493,
    size: 0,
    mtime: 1700000000,
    typeFlag: Directory,
    linkName: "",
    data: ByteSeq.empty()
  }
}

/// One byte as a whole number.
///
/// A byte always fits in `Int`, so the widening cannot fail and the fallback
/// is unreachable; it is written because the conversion answers an `Option`
/// for the narrowing direction, where it can.
fn byteValue(value: UInt8) -> Int {
  match convertInteger[Int](value) {
    case Some(widened) => widened
    case None => 0
  }
}

/// `count` zero bytes.
fn zeros(count: Int) -> Array[UInt8] {
  var out: Array[UInt8] = []
  var index = 0
  while index < count {
    out = out.push(0u8)
    index = index + 1
  }
  out
}

/// The text of a header field up to its first NUL, or nothing when it is not UTF-8.
fn fieldText(header: &Bytes, start: Int, width: Int) -> Option[Str] {
  let field = header.slice(start, start + width)
  let end = field.indexOf(bytesOf([0u8]))
  match ByteSeq.toText(&(if end < 0 { field } else { field.take(end) })) {
    case Ok(txt) => Some(txt)
    case Err(_) => None
  }
}

/// An octal number field, read the way `parseOctal` reads one.
fn octalField(header: &Bytes, start: Int, width: Int) -> Option[Int] {
  let text = fieldText(header, start, width) ?
  var result = 0
  var started = false
  for character in text.chars() {
    if character == ' ' {
      if started { return Some(result) }
    } else if character >= '0' && character <= '7' {
      started = true
      result = result * 8 + (character.code() - 48)
    } else {
      return None
    }
  }
  Some(result)
}

/// The unsigned sum of a header's bytes with the checksum field counted as spaces.
fn headerChecksum(header: &Bytes) -> Int {
  var sum = 0
  for octet in header.slice(0, 148).concat(header.slice(156, 512)).toArray() { sum = sum + byteValue(octet) }
  sum + 256
}

/// The value of one record of a pax extended header, whose records are
/// `<length> <key>=<value>` lines.
fn paxRecord(payload: &Bytes, key: Str) -> Option[Str] {
  let text = match ByteSeq.toText(payload) {
    case Ok(held) => held
    case Err(_) => { return None }
  }
  var found: Option[Str] = None
  for line in text.split("\n") {
    let space = line.indexOf(" ")
    if space > 0 {
      let record = line.drop(space + 1)
      if record.startsWith(key + "=") { found = Some(record.drop(key.length() + 1)) }
    }
  }
  found
}

/// A path as the USTAR `prefix` and `name` fields: unchanged when it fits in
/// 100 bytes, otherwise split at the last `/` that leaves a name of at most
/// 100 bytes and a prefix of at most 155.
fn splitPath(path: Str) -> (Str, Str) {
  let bytes = path.toBytes()
  if bytes.length() <= 100 { return ("", path) }
  let parts = path.split("/")
  var index = parts.length() - 1
  while index > 0 {
    let prefix = parts.slice(0, index).join("/")
    let name = parts.slice(index, parts.length()).join("/")
    if name.toBytes().length() <= 100 && prefix.toBytes().length() <= 155 { return (prefix, name) }
    index = index - 1
  }
  ("", path)
}

/// A number as an octal field: `width - 1` digits with leading zeros, then NUL.
fn octalBytes(value: Int, width: Int) -> Bytes {
  var digits = ""
  var rest = value
  var count = 0
  while count < width - 1 {
    digits = show(rest % 8) + digits
    rest = rest / 8
    count = count + 1
  }
  (digits + "\u{0}").toBytes()
}

/// The unsigned sum of some bytes.
fn byteSum(bytes: &Bytes) -> Int {
  var sum = 0
  for octet in bytes.toArray() { sum = sum + byteValue(octet) }
  sum
}

/// Bytes cut or padded with NUL to exactly `width`.
fn padded(bytes: &Bytes, width: Int, zero: &Bytes) -> Bytes {
  if bytes.length() >= width { bytes.take(width) } else { bytes.concat(zero.take(width - bytes.length())) }
}

/// The 512-byte USTAR header of an entry. The checksum is the sum of the
/// bytes written, since every other byte of the header is NUL.
fn headerBytes(item: &TarEntry, zero: &Bytes) -> Bytes {
  let split = splitPath(item.path)
  let name = padded(&split[1].toBytes(), 100, zero)
  let prefix = padded(&split[0].toBytes(), 155, zero)
  let link = padded(&item.linkName.toBytes(), 100, zero)
  let numbers = octalBytes(item.mode, 8).concat(octalBytes(0, 8)).concat(octalBytes(0, 8)).concat(octalBytes(item.size, 12)).concat(octalBytes(item.mtime, 12))
  let kind = match item.typeFlag {
    case File => "0"
    case Directory => "5"
    case Symlink => "2"
  }
  let magic = "ustar\u{0}00".toBytes()
  let sum = byteSum(&name) + byteSum(&numbers) + 256 + byteSum(&kind.toBytes()) + byteSum(&link) + byteSum(&magic) + byteSum(&prefix)
  ByteSeq.join(&[
      name,
      numbers,
      octalBytes(sum, 7),
      " ".toBytes(),
      kind.toBytes(),
      link,
      magic,
      zero.take(80),
      prefix,
      zero.take(12)
    ])
}

/// Encodes an array of tar entries into a complete POSIX USTAR byte archive.
export fn writeArchive(entries: Array[TarEntry]) -> Bytes {
  let zero = bytesOf(zeros(512))
  var pieces: Array[Bytes] = []
  for item in entries {
    pieces = pieces.push(headerBytes(&item, &zero))
    pieces = pieces.push(item.data)
    let rest = item.data.length() % 512
    if rest != 0 { pieces = pieces.push(zero.take(512 - rest)) }
  }
  pieces = pieces.push(zero).push(zero)
  ByteSeq.join(&pieces)
}

/// Decodes all TarEntries from a POSIX USTAR archive byte stream.
export fn readArchive(archive: &Bytes) -> Result[Array[TarEntry], TarError] {
  var entries: Array[TarEntry] = []
  var offset = 0
  var reachedEnd = false
  var pendingPath: Option[Str] = None
  let totalLen = archive.length()
  let zeroBlock = bytesOf(zeros(512))

  while offset + 512 <= totalLen {
    let header = archive.slice(offset, offset + 512)
    if header == zeroBlock {
      reachedEnd = true
      break
    }

    let recordedChecksum = match octalField(&header, 148, 8) {
      case Some(sum) => sum
      case None => { return Err(InvalidChecksum) }
    }
    if recordedChecksum != headerChecksum(&header) {
      return Err(InvalidChecksum)
    }

    let namePart = match fieldText(&header, 0, 100) {
      case Some(txt) => txt
      case None => { return Err(CorruptHeader) }
    }
    let prefixPart = match fieldText(&header, 345, 155) {
      case Some(txt) => if header.slice(257, 262) == "ustar".toBytes() { txt } else { "" }
      case None => { return Err(CorruptHeader) }
    }
    let entryPath = if prefixPart.isEmpty() { namePart } else { prefixPart + "/" + namePart }

    let modeVal = Option.unwrapOr(octalField(&header, 100, 8), 420)

    let sizeVal = match octalField(&header, 124, 12) {
      case Some(s) => s
      case None => { return Err(CorruptHeader) }
    }

    let mtimeVal = Option.unwrapOr(octalField(&header, 136, 12), 0)

    let typeCode = byteValue(Option.unwrapOr(header.at(156), 0u8))
    let extended = typeCode == 120
    let global = typeCode == 103
    let entryType = if typeCode == 53 {
      Directory
    } else if typeCode == 50 {
      Symlink
    } else if typeCode == 48 || typeCode == 0 || extended || global {
      File
    } else {
      return Err(UnsupportedType)
    }

    let linkStr = Option.unwrapOr(fieldText(&header, 157, 100), "")

    let dataStart = offset + 512
    if dataStart + sizeVal > totalLen {
      return Err(UnexpectedEof)
    }
    let payload = archive.slice(dataStart, dataStart + sizeVal)

    if extended {
      pendingPath = paxRecord(&payload, "path")
    } else if !global {
      entries = entries.push(TarEntry {
          path: Option.unwrapOr(pendingPath, entryPath),
          mode: modeVal,
          size: sizeVal,
          mtime: mtimeVal,
          typeFlag: entryType,
          linkName: linkStr,
          data: payload
        })
      pendingPath = None
    }

    let padBytes = if sizeVal % 512 != 0 {
      512 - (sizeVal % 512)
    } else {
      0
    }
    offset = dataStart + sizeVal + padBytes
  }

  // A stream that stopped before its terminator is truncated, and reading it as
  // though it had simply held fewer entries is the failure that matters: the
  // caller cannot tell a short archive from a complete one, so a transfer cut
  // in half restores as a smaller archive rather than as an error. The two zero
  // blocks are what say the writer finished.
  if reachedEnd {
    Ok(entries)
  } else {
    Err(UnexpectedEof)
  }
}

/// Searches entries for a regular file matching the exact relative path.
export fn extractFile(entries: &Array[TarEntry], targetPath: Str) -> Option[Bytes] {
  var i = 0
  while i < entries.length() {
    let item = &entries[i]
    if item.path == targetPath {
      return Some(item.data)
    }
    i = i + 1
  }
  None
}
