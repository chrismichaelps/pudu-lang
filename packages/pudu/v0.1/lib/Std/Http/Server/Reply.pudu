module Std.Http.Server.Reply

import Std.Crypto as Crypto
import Std.Html as Html
import Std.Html.Ssr as Ssr
import Std.Http as Http
import Std.Http.Message as Message
import Std.Json as Json
import Std.Option as Option

/// The answers a handler gives, apart from the routing that chose it and the
/// connection that carries it.
///
/// Separated because a reply is the one part of serving that a program builds
/// without a request in hand: a test naming an expected response, a middleware
/// refusing one, and a handler answering one all want these and none of them
/// wants a server.

/// A response carrying text.
export fn text(code: Int, content: Str) -> Http.Response {
  Message.respond(code, "text/plain; charset=utf-8", content)
}

/// A response carrying HTML.
export fn html(code: Int, content: Str) -> Http.Response {
  Message.respond(code, "text/html; charset=utf-8", content)
}

/// The media types a resource accepts for a request that carries its terms in
/// its body, as the header that advertises them.
///
/// Sent with the refusal a resource gives a body it cannot read, so a client
/// told its request was unreadable is also told what would be readable. A
/// refusal that only said no would leave the client guessing.
export fn acceptQuery(types: &Array[Str]) -> (Str, Str) {
  var listed = ""
  var index = 0
  while index < types.length() {
    if index > 0 { listed = listed + ", " }
    listed = listed + types[index]
    index = index + 1
  }
  ("Accept-Query", listed)
}

/// The refusal a body in a type the resource cannot read receives.
export fn unsupportedMediaType(accepted: &Array[Str]) -> Http.Response {
  let answer = text(415, "this resource does not read that media type")
  Http.Response {
    binaryBody: answer.binaryBody, status: answer.status,
    headers: answer.headers.push(acceptQuery(accepted)),
    body: answer.body
  }
}

/// The refusal a body the resource could read but could not act on receives.
/// Distinct from a body it could not read at all: one says the type was wrong,
/// the other says the content was, and a client can act on the difference.
export fn unprocessable(reason: Str) -> Http.Response { text(422, reason) }

/// A response carrying JSON, already encoded.
export fn json(code: Int, content: Str) -> Http.Response {
  Message.respond(code, "application/json", content)
}

/// A response with a status and nothing else.
export fn empty(code: Int) -> Http.Response { Message.respondEmpty(code) }

/// Render a typed fragment using the standard HTML escaping rules.
export fn view(code: Int, content: Html.Html) -> Http.Response {
  html(code, Html.render(&content))
}

/// Render a complete HTML document, including its doctype.
export fn page(code: Int, content: Html.Html) -> Http.Response {
  html(code, Html.document(&content))
}

/// Encode the standard JSON model at the response boundary.
export fn jsonValue(code: Int, content: Json.Json) -> Http.Response {
  json(code, Json.encode(&content))
}

/// Reuse server-rendered output and its UTF-8 length without rendering again.
export fn rendered(code: Int, content: Ssr.Rendered) -> Http.Response {
  Http.Response {
    binaryBody: None, status: Http.status(code),
    headers: [("content-type", "text/html; charset=utf-8"), ("content-length", show(content.byteLength))],
    body: content.body
  }
}

/// Attaches an ETag entity tag validator header to a response.
export fn withEtag(response: &Http.Response, etag: Str) -> Http.Response {
  var headers = response.headers
  headers = headers.push(("ETag", "\"" + etag + "\""))
  Http.Response {
    binaryBody: response.binaryBody, status: response.status,
    headers: headers,
    body: response.body
  }
}

/// A 304 Not Modified response with an ETag and empty body.
export fn notModified(etag: Str) -> Http.Response {
  Http.Response {
    binaryBody: None, status: Http.status(304),
    headers: [("ETag", "\"" + etag + "\"")],
    body: ""
  }
}

/// Evaluates If-None-Match in the request; answers 304 Not Modified on match or attaches ETag on miss.
export fn conditional(requestHeaders: &Array[(Str, Str)], response: &Http.Response, etag: Str) -> Http.Response {
  var ifNoneMatch: Option[Str] = None
  for pair in requestHeaders {
    if pair[0].toLower() == "if-none-match" {
      ifNoneMatch = Some(pair[1])
    }
  }
  if let Some(clientTag) = ifNoneMatch {
    let cleanClient = clientTag.trim()
    let quoted = "\"" + etag + "\""
    if cleanClient == quoted || cleanClient == etag || cleanClient == "*" {
      return notModified(etag)
    }
  }
  withEtag(response, etag)
}

/// Computes a fast hex ETag hash from body content.
export fn computeEtag(body: Str) -> Str {
  Crypto.sha256Hex(body).slice(0, 16)
}

/// A 429 Too Many Requests response with a Retry-After directive in seconds.
export fn tooManyRequests(retryAfterSeconds: Int) -> Http.Response {
  Http.Response {
    binaryBody: None, status: Http.status(429),
    headers: [
      ("content-type", "text/plain; charset=utf-8"),
      ("Retry-After", show(retryAfterSeconds))
    ],
    body: "too many requests; please retry after " + show(retryAfterSeconds) + " seconds"
  }
}

/// A 503 Service Unavailable response with a Retry-After directive in seconds.
export fn serviceUnavailable(retryAfterSeconds: Int) -> Http.Response {
  Http.Response {
    binaryBody: None, status: Http.status(503),
    headers: [
      ("content-type", "text/plain; charset=utf-8"),
      ("Retry-After", show(retryAfterSeconds))
    ],
    body: "service temporarily unavailable; please retry after " + show(retryAfterSeconds) + " seconds"
  }
}

/// A 504 Gateway Timeout response.
export fn gatewayTimeout(reason: Str) -> Http.Response {
  let message = if reason.length() > 0 { reason } else { "gateway timeout" }
  text(504, message)
}

/// A response carrying arbitrary bytes with an explicit media type.
export fn bytes(code: Int, mediaType: Str, payload: &Bytes) -> Http.Response {
  Message.respondBytes(code, mediaType, payload)
}
