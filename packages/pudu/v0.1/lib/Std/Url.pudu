module Std.Url

import Std.Option as Option
import Std.Text as Text
/// The parts of a URL, each already decoded.
export type Url = {
  scheme: Str,
  host: Str,
  port: Option[Int],
  path: Str,
  query: Array[(Str, Str)],
  fragment: Option[Str]
}

/// What stopped a URL from being read.
export type UrlError = NoScheme | NoHost | BadPort(Str)

/// A URL read from text, or what stopped the reader.
export fn parse(source: Str) -> Result[Url, UrlError] {
  let schemeEnd = source.indexOf("://")
  if schemeEnd < 0 { Err(NoScheme) } else {
    let scheme = source.slice(0, schemeEnd).toLower()
    let rest = source.slice(schemeEnd + 3, source.length())
    let authorityEnd = firstOf(rest, "/?#")
    let authority = rest.slice(0, authorityEnd)
    let remainder = rest.slice(authorityEnd, rest.length())
    if authority.isEmpty() { Err(NoHost) } else {
      let hostAndPort = splitPort(authority) ?
      let afterPath = firstOf(remainder, "?#")
      let path = remainder.slice(0, afterPath)
      let tail = remainder.slice(afterPath, remainder.length())
      let fragmentAt = tail.indexOf("#")
      let queryText = if fragmentAt < 0 { tail } else { tail.slice(0, fragmentAt) }
      let fragment =
      if fragmentAt < 0 { None } else {
        Some(decodeComponent(tail.slice(fragmentAt + 1, tail.length())))
      }
      Ok(Url {
          scheme: scheme,
          host: hostAndPort[0],
          port: hostAndPort[1],
          path: if path.isEmpty() { "/" } else { decodeComponent(path) },
          query: parseQuery(queryText),
          fragment: fragment
        })
    }
  }
}

/// A URL written back as text, with every part encoded again.
export fn render(value: &Url) -> Str {
  var out = value.scheme + "://" + value.host
  match value.port {
    case Some(number) => { out = out + ":" + show(number) }
    case None => {}
  }
  out = out + encodePath(value.path)
  if value.query.length() > 0 { out = out + "?" + renderQuery(&value.query) }
  match value.fragment {
    case Some(found) => { out = out + "#" + encodeComponent(found) }
    case None => {}
  }
  out
}

/// The first value given for a query key, or `None`.
export fn queryValue(value: &Url, key: Str) -> Option[Str] {
  for pair in value.query {
    if pair[0] == key { return Some(pair[1]) }
  }
  None
}

/// Every value given for a query key, in order.
export fn queryValues(value: &Url, key: Str) -> Array[Str] {
  var out = []
  for pair in value.query {
    if pair[0] == key { out = out.push(pair[1]) }
  }
  out
}

/// The URL with a query key added, keeping any values it already had.
export fn addQuery(value: &Url, key: Str, held: Str) -> Url {
  Url {
    scheme: value.scheme,
    host: value.host,
    port: value.port,
    path: value.path,
    query: value.query.push((key, held)),
    fragment: value.fragment
  }
}

/// The URL with every value for a key removed.
export fn removeQuery(value: &Url, key: Str) -> Url {
  var kept = []
  for pair in value.query {
    if pair[0] != key { kept = kept.push(pair) }
  }
  Url {
    scheme: value.scheme,
    host: value.host,
    port: value.port,
    path: value.path,
    query: kept,
    fragment: value.fragment
  }
}

/// The URL with a different path.
export fn withPath(value: &Url, path: Str) -> Url {
  Url {
    scheme: value.scheme,
    host: value.host,
    port: value.port,
    path: path,
    query: value.query,
    fragment: value.fragment
  }
}

/// The path in pieces, with empty pieces dropped.
export fn segments(value: &Url) -> Array[Str] {
  var out = []
  for piece in value.path.split("/") {
    if !piece.isEmpty() { out = out.push(piece) }
  }
  out
}

/// The port a URL uses, falling back to the one its scheme implies.
export fn effectivePort(value: &Url) -> Option[Int] {
  match value.port {
    case Some(number) => Some(number)
    case None => defaultPort(value.scheme)
  }
}

/// The port a scheme implies, for the schemes that imply one.
const SCHEME_PORTS: Map[Str, Int] = mapOf([
    ("http", 80),
    ("https", 443),
    ("ws", 80),
    ("wss", 443),
    ("ftp", 21)
  ])

/// The port a scheme uses when none is written.
export fn defaultPort(scheme: Str) -> Option[Int] { SCHEME_PORTS.get(scheme) }

/// Text with the characters a URL cannot carry replaced by percent escapes.
/// Unreserved characters are left alone, which keeps a readable URL readable.
export fn encodeComponent(value: Str) -> Str {
  var pieces: Array[Str] = []
  for octet in value.toBytes().toArray() { pieces = pieces.push(COMPONENT_BYTES[octetValue(octet)]) }
  pieces.join("")
}

/// Text with its percent escapes read back.
/// Escapes name UTF-8 bytes, so `%C3%A9` reads back as one `é`. An escape that
/// is not two hex digits is left as written, and text whose escapes do not
/// spell UTF-8 is returned unchanged, because a caller showing the result is
/// better served by the original than by a guess.
export fn decodeComponent(value: Str) -> Str {
  let octets = value.toBytes().toArray()
  let size = octets.length()
  var decoded: Array[UInt8] = []
  var index = 0
  while index < size {
    let octet = octets[index]
    let high = if index + 2 < size { HEX_OF_BYTE[octetValue(octets[index + 1])] } else { -1 }
    let low = if index + 2 < size { HEX_OF_BYTE[octetValue(octets[index + 2])] } else { -1 }
    if octet == 37u8 && high >= 0 && low >= 0 {
      decoded = decoded.push(Option.unwrapOr(convertInteger[UInt8](high * 16 + low), 0u8))
      index = index + 3
    } else {
      decoded = decoded.push(if octet == 43u8 { 32u8 } else { octet })
      index = index + 1
    }
  }
  Option.unwrapOr(bytesOf(decoded).toText(), value)
}

/// Query pairs written back as text.
export fn renderQuery(pairs: &Array[(Str, Str)]) -> Str {
  var out = ""
  var index = 0
  while index < pairs.length() {
    if index > 0 { out = out + "&" }
    out = out + encodeComponent(pairs[index][0]) + "=" + encodeComponent(pairs[index][1])
    index = index + 1
  }
  out
}

/// A query string read into pairs. A key with no `=` carries empty text.
export fn parseQuery(source: Str) -> Array[(Str, Str)] {
  var out = []
  let body = if source.startsWith("?") { source.slice(1, source.length()) } else { source }
  if body.isEmpty() { out } else {
    for piece in body.split("&") {
      if !piece.isEmpty() {
        let equals = piece.indexOf("=")
        if equals < 0 { out = out.push((decodeComponent(piece), "")) }
          else {
          out = out.push((
              decodeComponent(piece.slice(0, equals)),
              decodeComponent(piece.slice(equals + 1, piece.length()))
            ))
        }
      }
    }
    out
  }
}

/// The host and its port, or a report that the port is not a number.
fn splitPort(authority: Str) -> Result[(Str, Option[Int]), UrlError] {
  let colon = authority.indexOf(":")
  if colon < 0 { Ok((authority.toLower(), None)) } else {
    let written = authority.slice(colon + 1, authority.length())
    match Text.countOf(written) {
      case Some(number) => Ok((authority.slice(0, colon).toLower(), Some(number)))
      case None => Err(BadPort(written))
    }
  }
}

/// The position of the first character from a set, or the whole length.
fn firstOf(value: Str, characters: Str) -> Int {
  var index = 0
  let size = value.length()
  while index < size {
    if characters.contains(value.charAt(index).toText()) { return index }
    index = index + 1
  }
  size
}

/// A path with each segment encoded, keeping the separators.
fn encodePath(path: Str) -> Str {
  var out = ""
  var first = true
  for piece in path.split("/") {
    if !first { out = out + "/" }
    out = out + encodeComponent(piece)
    first = false
  }
  out
}

/// Whether a character may appear in a URL without an escape.
fn isUnreserved(value: Char) -> Bool {
  (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') ||
  (value >= '0' && value <= '9') ||
  value == '-' || value == '_' || value == '.' || value == '~'
}

/// What each UTF-8 byte of a component is written as, indexed by the byte: an
/// unreserved ASCII character as itself, every other byte as its escape.
const COMPONENT_BYTES: Array[Str] = componentBytes()

fn componentBytes() -> Array[Str] {
  let digits = "0123456789ABCDEF"
  var table: Array[Str] = []
  var value = 0
  while value < 256 {
    var written = "%" + digits.charAt(value / 16).toText() + digits.charAt(value % 16).toText()
    if value < 128 {
      if let Some(character) = charFromCode(value) {
        if isUnreserved(character) { written = character.toText() }
      }
    }
    table = table.push(written)
    value = value + 1
  }
  table
}

/// The value of each byte as a hexadecimal digit of either case, or -1 for a
/// byte that is not one, indexed by the byte.
const HEX_OF_BYTE: Array[Int] = hexOfByte()

fn hexOfByte() -> Array[Int] {
  let digits = "0123456789abcdef"
  var table: Array[Int] = []
  var value = 0
  while value < 256 {
    var found = -1
    if value < 128 {
      if let Some(character) = charFromCode(value) {
        found = digits.indexOf(character.toText().toLower())
      }
    }
    table = table.push(found)
    value = value + 1
  }
  table
}

fn octetValue(octet: UInt8) -> Int {
  Option.unwrapOr(convertInteger[Int](octet), 0)
}
