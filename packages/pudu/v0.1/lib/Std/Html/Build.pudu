module Std.Html.Build

import Std.Html as Html

/// Builds HTML by naming a tag as a function and its attributes as methods.
///
/// ```
/// button().class("send").submit().says("Post")
/// ```
///
/// renders `<button class="send" type="submit">Post</button>`.
///
/// A node holds a tag name, its attributes in the order they were given, and
/// its children. Every method answers a new node, so a partly built node may
/// be kept and finished more than once.
export type Node = { name: Str, attributes: Array[(Str, Str)], children: Array[Html.Html] }

/// The attributes and content a node accepts.
///
/// Common attributes have a method of their own; `at` sets any other.
export trait Building {
  /// Sets an attribute to a value.
  fn at(self: &Self, name: Str, value: Str) -> Self

  /// Sets an attribute whose value is its own name, such as `required`.
  fn flag(self: &Self, name: Str) -> Self

  fn class(self: &Self, value: Str) -> Self
  fn id(self: &Self, value: Str) -> Self
  fn href(self: &Self, value: Str) -> Self
  fn src(self: &Self, value: Str) -> Self
  fn alt(self: &Self, value: Str) -> Self
  fn name(self: &Self, value: Str) -> Self
  fn value(self: &Self, value: Str) -> Self
  fn placeholder(self: &Self, value: Str) -> Self
  fn action(self: &Self, value: Str) -> Self
  fn method(self: &Self, value: Str) -> Self
  fn rel(self: &Self, value: Str) -> Self
  fn lang(self: &Self, value: Str) -> Self
  fn title(self: &Self, value: Str) -> Self
  fn target(self: &Self, value: Str) -> Self
  fn role(self: &Self, value: Str) -> Self
  fn rows(self: &Self, value: Int) -> Self
  fn cols(self: &Self, value: Int) -> Self

  /// Sets the `type` attribute. Named `kind` because `type` is a keyword.
  fn kind(self: &Self, value: Str) -> Self

  /// Sets `type="submit"`.
  fn submit(self: &Self) -> Self

  fn required(self: &Self) -> Self
  fn disabled(self: &Self) -> Self
  fn checked(self: &Self) -> Self

  /// Sets `aria-label`, the name assistive software reads.
  fn label(self: &Self, value: Str) -> Self

  /// Sets a `data-` attribute. The name is given without the prefix.
  fn data(self: &Self, name: Str, value: Str) -> Self

  /// Appends text as a child. The text is escaped.
  fn says(self: &Self, content: Str) -> Self

  /// Appends markup as a child without escaping it.
  ///
  /// Only for markup the program produced. Text that came from a request or a
  /// database belongs in `says`.
  fn raw(self: &Self, markup: Str) -> Self

  /// Appends nodes as children, in the order given.
  fn holding(self: &Self, children: Array[Node]) -> Self

  /// Appends an already-rendered view as a child.
  fn holds(self: &Self, view: Html.Html) -> Self

  /// Appends a child only when the condition holds.
  fn when(self: &Self, condition: Bool, child: Node) -> Self

  /// The view this node describes.
  fn html(self: &Self) -> Html.Html
}

impl Building for Node {
  fn at(self: &Self, name: Str, value: Str) -> Self {
    Node{name: self.name, attributes: self.attributes.push((name, value)), children: self.children}
  }

  fn flag(self: &Self, name: Str) -> Self { self.at(name, name) }

  fn class(self: &Self, value: Str) -> Self { self.at("class", value) }

  fn id(self: &Self, value: Str) -> Self { self.at("id", value) }

  fn href(self: &Self, value: Str) -> Self { self.at("href", value) }

  fn src(self: &Self, value: Str) -> Self { self.at("src", value) }

  fn alt(self: &Self, value: Str) -> Self { self.at("alt", value) }

  fn name(self: &Self, value: Str) -> Self { self.at("name", value) }

  fn value(self: &Self, value: Str) -> Self { self.at("value", value) }

  fn placeholder(self: &Self, value: Str) -> Self { self.at("placeholder", value) }

  fn action(self: &Self, value: Str) -> Self { self.at("action", value) }

  fn method(self: &Self, value: Str) -> Self { self.at("method", value) }

  fn rel(self: &Self, value: Str) -> Self { self.at("rel", value) }

  fn lang(self: &Self, value: Str) -> Self { self.at("lang", value) }

  fn title(self: &Self, value: Str) -> Self { self.at("title", value) }

  fn target(self: &Self, value: Str) -> Self { self.at("target", value) }

  fn role(self: &Self, value: Str) -> Self { self.at("role", value) }

  fn rows(self: &Self, value: Int) -> Self { self.at("rows", show(value)) }

  fn cols(self: &Self, value: Int) -> Self { self.at("cols", show(value)) }

  fn kind(self: &Self, value: Str) -> Self { self.at("type", value) }

  fn submit(self: &Self) -> Self { self.at("type", "submit") }

  fn required(self: &Self) -> Self { self.flag("required") }

  fn disabled(self: &Self) -> Self { self.flag("disabled") }

  fn checked(self: &Self) -> Self { self.flag("checked") }

  fn label(self: &Self, value: Str) -> Self { self.at("aria-label", value) }

  fn data(self: &Self, name: Str, value: Str) -> Self { self.at("data-" + name, value) }

  fn says(self: &Self, content: Str) -> Self { self.holds(Html.text(content)) }

  fn raw(self: &Self, markup: Str) -> Self { self.holds(Html.trusted(markup)) }

  fn holds(self: &Self, view: Html.Html) -> Self {
    Node{name: self.name, attributes: self.attributes, children: self.children.push(view)}
  }

  fn holding(self: &Self, children: Array[Node]) -> Self {
    var built = self.children
    for child in children {
      built = built.push(child.html())
    }
    Node{name: self.name, attributes: self.attributes, children: built}
  }

  fn when(self: &Self, condition: Bool, child: Node) -> Self {
    if condition { self.holds(child.html()) } else { *self }
  }

  /// A node with no tag name renders as its children alone, with no element
  /// around them. That is what `words` and `nothing` produce.
  fn html(self: &Self) -> Html.Html {
    if self.name.isEmpty() {
      Html.fragment(&self.children)
    } else {
      Html.element(self.name, &self.attributes, &self.children)
    }
  }
}

/// An element with the given tag name, for tags without a function here.
export fn tag(name: Str) -> Node { Node{name: name, attributes: [], children: []} }

/// Text as a node, so it can appear in a list beside elements. Escaped.
export fn words(content: Str) -> Node {
  Node{name: "", attributes: [], children: [Html.text(content)]}
}

/// A node that renders nothing.
export fn nothing() -> Node { Node{name: "", attributes: [], children: []} }

// One function per tag. Each answers an empty node with that tag name;
// attributes and children are added by the methods above.

export fn html() -> Node { tag("html") }

export fn head() -> Node { tag("head") }

export fn body() -> Node { tag("body") }

export fn meta() -> Node { tag("meta") }

export fn link() -> Node { tag("link") }

export fn style() -> Node { tag("style") }

export fn script() -> Node { tag("script") }

export fn main() -> Node { tag("main") }

export fn header() -> Node { tag("header") }

export fn footer() -> Node { tag("footer") }

export fn nav() -> Node { tag("nav") }

export fn section() -> Node { tag("section") }

export fn article() -> Node { tag("article") }

export fn aside() -> Node { tag("aside") }

export fn div() -> Node { tag("div") }

export fn span() -> Node { tag("span") }

export fn p() -> Node { tag("p") }

export fn h1() -> Node { tag("h1") }

export fn h2() -> Node { tag("h2") }

export fn h3() -> Node { tag("h3") }

export fn h4() -> Node { tag("h4") }

export fn h5() -> Node { tag("h5") }

export fn h6() -> Node { tag("h6") }

export fn ul() -> Node { tag("ul") }

export fn ol() -> Node { tag("ol") }

export fn li() -> Node { tag("li") }

export fn dl() -> Node { tag("dl") }

export fn dt() -> Node { tag("dt") }

export fn dd() -> Node { tag("dd") }

export fn table() -> Node { tag("table") }

export fn thead() -> Node { tag("thead") }

export fn tbody() -> Node { tag("tbody") }

export fn tfoot() -> Node { tag("tfoot") }

export fn tr() -> Node { tag("tr") }

export fn th() -> Node { tag("th") }

export fn td() -> Node { tag("td") }

export fn form() -> Node { tag("form") }

export fn fieldset() -> Node { tag("fieldset") }

export fn legend() -> Node { tag("legend") }

export fn labelFor() -> Node { tag("label") }

export fn input() -> Node { tag("input") }

export fn textarea() -> Node { tag("textarea") }

export fn select() -> Node { tag("select") }

export fn option() -> Node { tag("option") }

export fn button() -> Node { tag("button") }

export fn a() -> Node { tag("a") }

export fn img() -> Node { tag("img") }

export fn figure() -> Node { tag("figure") }

export fn figcaption() -> Node { tag("figcaption") }

export fn br() -> Node { tag("br") }

export fn hr() -> Node { tag("hr") }

export fn pre() -> Node { tag("pre") }

export fn code() -> Node { tag("code") }

export fn blockquote() -> Node { tag("blockquote") }

export fn strong() -> Node { tag("strong") }

export fn em() -> Node { tag("em") }

export fn small() -> Node { tag("small") }

export fn time() -> Node { tag("time") }

export fn details() -> Node { tag("details") }

export fn summary() -> Node { tag("summary") }

export fn dialog() -> Node { tag("dialog") }

export fn progress() -> Node { tag("progress") }

/// Renders a node as a whole document, prefixed with `<!DOCTYPE html>`.
export fn document(root: &Node) -> Str { "<!DOCTYPE html>" + Html.render(&root.html()) }

/// Renders a node on its own, without a doctype.
export fn render(node: &Node) -> Str { Html.render(&node.html()) }
