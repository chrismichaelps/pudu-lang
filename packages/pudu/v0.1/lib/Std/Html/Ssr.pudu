module Std.Html.Ssr

import Std.Html.Buffer as Buffer
import Std.Html as Html

/// Part of a page: either fixed markup or a named hole.
export type Piece = Fixed(Html.Html) | Slot(Str)
/// A typed reusable HTML tree whose dynamic positions are complete child fragments.
export type Shell
  = ShellFixed(Html.Html)
  | ShellSlot(Str)
  | ShellElement(Str, Array[(Str, Str)], Array[Shell])
  | ShellFragment(Array[Shell])
/// A piece after preparing: rendered text, or the hole still to fill.
export type Prepared = Markup(Array[Str]) | Hole(Str)
/// A page prepared once, ready to be filled and rendered many times.
export type Plan = { parts: Array[Prepared] }
/// Why a prepared page could not be rendered.
export type RenderError = MissingSlot(Str) | InvalidLimit(Int) | TooLarge(Int)
/// A rendered page and its length in bytes.
export type Rendered = { body: Str, byteLength: Int }
/// A reusable SSR plan retaining encoded static bytes and exact lengths.
export type EncodedPlan = { bytes: Buffer.CompactBytePlan }
/// Encoded response parts and their exact combined byte length.
export type EncodedSegments = { parts: Array[Bytes], byteLength: Int }
/// One contiguous encoded response and its exact byte length.
export type EncodedResponse = { body: Bytes, byteLength: Int }

/// Render static sections once; the plan never stores request-specific slots.
export fn prepare(pieces: &Array[Piece]) -> Plan {
  var parts: Array[Prepared] = []
  for piece in pieces {
    match piece {
      case Fixed(view) => { parts = parts.push(Markup(Html.renderChunks(&view))) }
      case Slot(name) => { parts = parts.push(Hole(name)) }
    }
  }
  Plan{parts: parts}
}

/// Render and join each adjacent static run once without crossing a slot.
export fn prepareCompact(pieces: &Array[Piece]) -> Plan {
  var parts: Array[Prepared] = []
  var pending: Array[Str] = []
  for piece in pieces {
    match piece {
      case Fixed(view) => {
        for renderedPart in Html.renderChunks(&view) {
          if !renderedPart.isEmpty() { pending = pending.push(renderedPart) }
        }
      }
      case Slot(name) => {
        parts = flushStatic(parts, pending)
        pending = []
        parts = parts.push(Hole(name))
      }
    }
  }
  Plan{parts: flushStatic(parts, pending)}
}

fn flushStatic(parts: Array[Prepared], pending: Array[Str]) -> Array[Prepared] {
  if pending.isEmpty() { parts } else { parts.push(Markup([pending.join("")])) }
}

/// Render and encode static sections once without retaining request values.
export fn prepareBytes(pieces: &Array[Piece]) -> EncodedPlan {
  var rawParts: Array[Buffer.RawChunk] = []
  var pending: Array[Str] = []
  for piece in pieces {
    match piece {
      case Fixed(view) => {
        for renderedPart in Html.renderChunks(&view) {
          if !renderedPart.isEmpty() { pending = pending.push(renderedPart) }
        }
      }
      case Slot(name) => {
        rawParts = flushEncodedStatic(rawParts, pending)
        pending = []
        rawParts = rawParts.push(Buffer.Dynamic(name))
      }
    }
  }
  rawParts = flushEncodedStatic(rawParts, pending)
  EncodedPlan{bytes: Buffer.compileCompact(&rawParts)}
}

fn flushEncodedStatic(
  parts: Array[Buffer.RawChunk],
  pending: Array[Str]
) -> Array[Buffer.RawChunk] {
  if pending.isEmpty() { parts } else { parts.push(Buffer.Static(pending.join("").toBytes())) }
}

type ShellWriting
  = ResumeShell(Array[Shell], Int)
  | CloseShell(Str, Array[Shell], Int)

/// Compile a typed nested shell without placing request values in the reusable plan.
export fn prepareShell(shell: &Shell) -> Plan {
  var parts: Array[Prepared] = []
  var current: Array[Shell] = [*shell]
  var index = 0
  var pending: Array[ShellWriting] = []

  while index < current.length() || pending.length() > 0 {
    if index >= current.length() {
      let step = pending[pending.length() - 1]
      pending = pending.pop()
      match step {
        case ResumeShell(parent, next) => {
          current = parent
          index = next
        }
        case CloseShell(closing, parent, next) => {
          parts = parts.push(Markup([closing]))
          current = parent
          index = next
        }
      }
    } else {
      let node = current[index]
      index = index + 1
      match node {
        case ShellFixed(view) => { parts = parts.push(Markup(Html.renderChunks(&view))) }
        case ShellSlot(name) => { parts = parts.push(Hole(name)) }
        case ShellFragment(children) => {
          if children.length() > 0 {
            pending = pending.push(ResumeShell(current, index))
            current = children
            index = 0
          }
        }
        case ShellElement(name, attributes, children) => {
          let shallow = Html.element(name, &attributes, &[Html.trusted("")])
          let boundary = Html.renderChunks(&shallow)
          let split = boundary.length() >= 2 && boundary[boundary.length() - 2].isEmpty()
          if split {
            var opening: Array[Str] = []
            var at = 0
            while at < boundary.length() - 2 {
              opening = opening.push(boundary[at])
              at = at + 1
            }
            parts = parts.push(Markup(opening))
            let closing = boundary[boundary.length() - 1]
            if children.length() == 0 {
              parts = parts.push(Markup([closing]))
            } else {
              pending = pending.push(CloseShell(closing, current, index))
              current = children
              index = 0
            }
          } else {
            parts = parts.push(Markup(boundary))
          }
        }
      }
    }
  }
  Plan{parts: parts}
}

/// The page as its pieces, in order, so a caller may write them as they come.
export fn chunks(plan: &Plan, values: &Map[Str, Html.Html]) -> Result[Array[Str], RenderError] {
  assemble(plan, values, None)
}

/// The page as one piece of text.
export fn render(plan: &Plan, values: &Map[Str, Html.Html]) -> Result[Str, RenderError] {
  let output = chunks(plan, values) ?
  Ok(output.join(""))
}

/// The page with its length in bytes, which is what a response header needs.
export fn finish(plan: &Plan, values: &Map[Str, Html.Html]) -> Result[Rendered, RenderError] {
  Ok(completed(render(plan, values) ?))
}

/// The page, refused if it would exceed the given number of bytes.
export fn renderWithin(plan: &Plan, values: &Map[Str, Html.Html], maxBytes: Int) -> Result[Rendered, RenderError] {
  if maxBytes < 0 { return Err(InvalidLimit(maxBytes)) }
  let output = assemble(plan, values, Some(maxBytes)) ?
  Ok(completed(output.join("")))
}

/// A view rendered with its length, without a plan.
export fn fragment(view: &Html.Html) -> Rendered { completed(Html.render(view)) }
/// A whole view rendered with its length, without a plan.
export fn document(view: &Html.Html) -> Rendered { completed(Html.document(view)) }

fn encodeValues(
  plan: &EncodedPlan,
  values: &Map[Str, Html.Html]
) -> Result[Map[Str, Bytes], Buffer.AssembleError] {
  var encoded: Map[Str, Bytes] = mapOf([])
  for part in plan.bytes.parts {
    match part {
      case Buffer.StaticBlock(_, _) => {}
      case Buffer.DynamicBlock(name) => {
        if let None = encoded.get(name) {
          let view = match values.get(name) {
            case None => { return Err(Buffer.MissingSlot(name)) }
            case Some(held) => held
          }
          encoded = encoded.insert(name, Html.render(&view).toBytes())
        }
      }
    }
  }
  Ok(encoded)
}

/// Render each used slot once and retain segmented encoded output with its exact length.
export fn byteSegments(
  plan: &EncodedPlan,
  values: &Map[Str, Html.Html]
) -> Result[EncodedSegments, Buffer.AssembleError] {
  let encoded = encodeValues(plan, values) ?
  let segments = Buffer.segmentsCompactChecked(&plan.bytes, &encoded) ?
  Ok(EncodedSegments{parts: segments.parts, byteLength: segments.byteLength})
}

/// Render encoded output into one exact-size checked byte buffer.
export fn finishBytes(
  plan: &EncodedPlan,
  values: &Map[Str, Html.Html]
) -> Result[EncodedResponse, Buffer.AssembleError] {
  let encoded = encodeValues(plan, values) ?
  let body = Buffer.renderCompactChecked(&plan.bytes, &encoded) ?
  Ok(EncodedResponse{body: body, byteLength: body.length()})
}

fn completed(body: Str) -> Rendered {
  Rendered{body: body, byteLength: body.toBytes().length()}
}

fn assemble(plan: &Plan, values: &Map[Str, Html.Html], limit: Option[Int]) -> Result[Array[Str], RenderError] {
  var cached: Map[Str, Array[Str]] = mapOf([])
  var output: Array[Str] = []
  var total = 0
  for part in plan.parts {
    let fragments = match part {
      case Markup(held) => held
      case Hole(name) => {
        match cached.get(name) {
          case Some(held) => held
          case None => {
            let view = match values.get(name) {
              case Some(held) => held
              case None => { return Err(MissingSlot(name)) }
            }
            let held = Html.renderChunks(&view)
            cached = cached.insert(name, held)
            held
          }
        }
      }
    }
    for piece in fragments {
      if let Some(maximum) = limit {
        let size = piece.toBytes().length()
        if size > maximum - total { return Err(TooLarge(maximum)) }
        total = total + size
      }
      output = output.push(piece)
    }
  }
  Ok(output)
}
