module Std.Html.Buffer

import Std.Buffer as Buffer
import Std.Bytes as ByteSeq
import Std.Option as Option

/// A chunk of an HTML template: either pre-baked static bytes or a named dynamic slot.
export type RawChunk
  = Static(Bytes)
  | Dynamic(Str)

/// A pre-compiled immutable byte plan with static size metadata.
export type BytePlan = {
  parts: Array[RawChunk],
  totalStaticBytes: Int
}

/// A compact template part with retained static length metadata.
export type PreparedChunk
  = StaticBlock(Bytes, Int)
  | DynamicBlock(Str)

/// A byte plan whose adjacent static runs were joined during compilation.
export type CompactBytePlan = {
  parts: Array[PreparedChunk],
  totalStaticBytes: Int
}

/// A checked byte-plan assembly failure.
export type AssembleError
  = MissingSlot(Str)
  | InvalidStaticSize(Int, Int)
  | SizeOverflow(Int, Int)
  | CopyFailed(Int, Int)
  | LengthMismatch(Int, Int)

/// Why application-output coalescing could not begin.
export type CoalesceError = { maximum: Int }

/// Validated byte parts and their exact combined length.
export type Segments = {
  parts: Array[Bytes],
  byteLength: Int
}

const INT_MAX: Int = 9223372036854775807

/// Pre-compiles a list of chunks, aggregating static byte metrics.
export fn compile(chunks: &Array[RawChunk]) -> BytePlan {
  var staticBytes = 0
  for chunk in chunks {
    match chunk {
      case Static(bytes) => { staticBytes = staticBytes + bytes.length() }
      case Dynamic(_) => {}
    }
  }
  BytePlan{parts: *chunks, totalStaticBytes: staticBytes}
}

/// Joins adjacent static chunks once and preserves every dynamic boundary.
export fn compileCompact(chunks: &Array[RawChunk]) -> CompactBytePlan {
  var parts: Array[PreparedChunk] = []
  var pending: Array[Bytes] = []
  var pendingBytes = 0
  var staticBytes = 0
  for chunk in chunks {
    match chunk {
      case Static(bytes) => {
        let size = bytes.length()
        if size > 0 {
          pending = pending.push(bytes)
          pendingBytes = pendingBytes + size
          staticBytes = staticBytes + size
        }
      }
      case Dynamic(name) => {
        if pendingBytes > 0 {
          parts = parts.push(StaticBlock(ByteSeq.join(&pending), pendingBytes))
          pending = []
          pendingBytes = 0
        }
        parts = parts.push(DynamicBlock(name))
      }
    }
  }
  if pendingBytes > 0 {
    parts = parts.push(StaticBlock(ByteSeq.join(&pending), pendingBytes))
  }
  CompactBytePlan{parts: parts, totalStaticBytes: staticBytes}
}

/// Assembles the byte plan and runtime slot values directly into a contiguous unboxed buffer.
///
/// Pre-computes exact capacity to perform a single contiguous allocation followed by
/// vectorized memory block copies (`Buffer.copy`), avoiding string reallocations.
export fn renderToBytes(plan: &BytePlan, values: &Map[Str, Bytes]) -> Bytes {
  var totalLength = plan.totalStaticBytes
  for part in plan.parts {
    match part {
      case Static(_) => {}
      case Dynamic(name) => {
        if let Some(held) = values.get(name) {
          totalLength = totalLength + held.length()
        }
      }
    }
  }

  if totalLength <= 0 { return ByteSeq.empty() }

  var dst = Buffer.alloc(totalLength)
  var cursor = 0

  for part in plan.parts {
    match part {
      case Static(bytes) => {
        let len = bytes.length()
        if len > 0 {
          let src = Buffer.fromBytes(bytes)
          dst = Option.unwrapOr(Buffer.copy(&src, 0, &dst, cursor, len), dst)
          cursor = cursor + len
        }
      }
      case Dynamic(name) => {
        if let Some(held) = values.get(name) {
          let len = held.length()
          if len > 0 {
            let src = Buffer.fromBytes(held)
            dst = Option.unwrapOr(Buffer.copy(&src, 0, &dst, cursor, len), dst)
            cursor = cursor + len
          }
        }
      }
    }
  }

  Buffer.toBytes(&dst)
}

/// Assembles a compact plan using the static lengths retained at compilation.
export fn renderCompactToBytes(plan: &CompactBytePlan, values: &Map[Str, Bytes]) -> Bytes {
  var totalLength = plan.totalStaticBytes
  for part in plan.parts {
    match part {
      case StaticBlock(_, _) => {}
      case DynamicBlock(name) => {
        if let Some(held) = values.get(name) {
          totalLength = totalLength + held.length()
        }
      }
    }
  }

  if totalLength <= 0 { return ByteSeq.empty() }

  var dst = Buffer.alloc(totalLength)
  var cursor = 0
  for part in plan.parts {
    match part {
      case StaticBlock(bytes, len) => {
        if len > 0 {
          let src = Buffer.fromBytes(bytes)
          dst = Option.unwrapOr(Buffer.copy(&src, 0, &dst, cursor, len), dst)
          cursor = cursor + len
        }
      }
      case DynamicBlock(name) => {
        if let Some(held) = values.get(name) {
          let len = held.length()
          if len > 0 {
            let src = Buffer.fromBytes(held)
            dst = Option.unwrapOr(Buffer.copy(&src, 0, &dst, cursor, len), dst)
            cursor = cursor + len
          }
        }
      }
    }
  }
  Buffer.toBytes(&dst)
}

fn checkedLength(total: Int, added: Int) -> Result[Int, AssembleError] {
  if total < 0 || added < 0 || added > INT_MAX - total {
    Err(SizeOverflow(total, added))
  } else {
    Ok(total + added)
  }
}

fn resolve(plan: &BytePlan, values: &Map[Str, Bytes]) -> Result[Segments, AssembleError] {
  if plan.totalStaticBytes < 0 {
    return Err(InvalidStaticSize(plan.totalStaticBytes, 0))
  }

  var parts: Array[Bytes] = []
  var cached: Map[Str, Bytes] = mapOf([])
  var totalLength = plan.totalStaticBytes
  var actualStaticBytes = 0

  for part in plan.parts {
    match part {
      case Static(bytes) => {
        actualStaticBytes = checkedLength(actualStaticBytes, bytes.length()) ?
        parts = parts.push(bytes)
      }
      case Dynamic(name) => {
        let held = match cached.get(name) {
          case Some(found) => found
          case None => {
            match values.get(name) {
              case None => { return Err(MissingSlot(name)) }
              case Some(found) => {
                cached = cached.insert(name, found)
                found
              }
            }
          }
        }
        totalLength = checkedLength(totalLength, held.length()) ?
        parts = parts.push(held)
      }
    }
  }

  if actualStaticBytes != plan.totalStaticBytes {
    return Err(InvalidStaticSize(plan.totalStaticBytes, actualStaticBytes))
  }
  Ok(Segments{parts: parts, byteLength: totalLength})
}

fn resolveCompact(
  plan: &CompactBytePlan,
  values: &Map[Str, Bytes]
) -> Result[Segments, AssembleError] {
  if plan.totalStaticBytes < 0 {
    return Err(InvalidStaticSize(plan.totalStaticBytes, 0))
  }

  var parts: Array[Bytes] = []
  var cached: Map[Str, Bytes] = mapOf([])
  var totalLength = plan.totalStaticBytes
  var actualStaticBytes = 0

  for part in plan.parts {
    match part {
      case StaticBlock(bytes, declaredLength) => {
        let actualLength = bytes.length()
        if declaredLength != actualLength {
          return Err(InvalidStaticSize(declaredLength, actualLength))
        }
        actualStaticBytes = checkedLength(actualStaticBytes, actualLength) ?
        parts = parts.push(bytes)
      }
      case DynamicBlock(name) => {
        let held = match cached.get(name) {
          case Some(found) => found
          case None => {
            match values.get(name) {
              case None => { return Err(MissingSlot(name)) }
              case Some(found) => {
                cached = cached.insert(name, found)
                found
              }
            }
          }
        }
        totalLength = checkedLength(totalLength, held.length()) ?
        parts = parts.push(held)
      }
    }
  }

  if actualStaticBytes != plan.totalStaticBytes {
    return Err(InvalidStaticSize(plan.totalStaticBytes, actualStaticBytes))
  }
  Ok(Segments{parts: parts, byteLength: totalLength})
}

fn writeResolved(plan: Segments) -> Result[Bytes, AssembleError] {
  if plan.byteLength == 0 { return Ok(ByteSeq.empty()) }

  var dst = Buffer.alloc(plan.byteLength)
  var cursor = 0
  for bytes in plan.parts {
    let length = bytes.length()
    if length > 0 {
      let src = Buffer.fromBytes(bytes)
      match Buffer.copy(&src, 0, &dst, cursor, length) {
        case None => { return Err(CopyFailed(cursor, length)) }
        case Some(next) => { dst = next }
      }
      cursor = cursor + length
    }
  }

  if cursor != plan.byteLength {
    return Err(LengthMismatch(plan.byteLength, cursor))
  }
  Ok(Buffer.toBytes(&dst))
}

/// Resolves a byte plan into validated segments without joining them.
export fn segmentsChecked(
  plan: &BytePlan,
  values: &Map[Str, Bytes]
) -> Result[Segments, AssembleError] {
  resolve(plan, values)
}

/// Resolves a compact byte plan into validated segments without joining them.
export fn segmentsCompactChecked(
  plan: &CompactBytePlan,
  values: &Map[Str, Bytes]
) -> Result[Segments, AssembleError] {
  resolveCompact(plan, values)
}

/// Assembles a byte plan while reporting missing slots and invalid public metadata.
export fn renderChecked(
  plan: &BytePlan,
  values: &Map[Str, Bytes]
) -> Result[Bytes, AssembleError] {
  let resolved = segmentsChecked(plan, values) ?
  writeResolved(resolved)
}

/// Assembles a compact plan while validating every retained static length.
export fn renderCompactChecked(
  plan: &CompactBytePlan,
  values: &Map[Str, Bytes]
) -> Result[Bytes, AssembleError] {
  let resolved = segmentsCompactChecked(plan, values) ?
  writeResolved(resolved)
}

/// Converts an integer nibble (0-15) into its ASCII lowercase hex byte.
fn hexDigit(nibble: Int) -> UInt8 {
  if nibble < 10 {
    Option.unwrapOr(convertInteger[UInt8](48 + nibble), 48u8)
  } else {
    Option.unwrapOr(convertInteger[UInt8](97 + (nibble - 10)), 97u8)
  }
}

/// Formats an HTTP/1.1 chunk length into a hex frame header `<hex>\r\n` without string heap allocation.
export fn formatHexChunkHeader(len: Int) -> Bytes {
  if len <= 0 { return bytesOf([48u8, 13u8, 10u8]) }

  var octets: Array[UInt8] = []
  var remaining = len
  while remaining > 0 {
    let nibble = remaining % 16
    octets = octets.push(hexDigit(nibble))
    remaining = remaining / 16
  }

  // Reverse nibbles to big-endian order
  var reversed: Array[UInt8] = []
  var idx = octets.length() - 1
  while idx >= 0 {
    reversed = reversed.push(octets[idx])
    idx = idx - 1
  }

  // Append CRLF
  reversed = reversed.push(13u8)
  reversed = reversed.push(10u8)
  bytesOf(reversed)
}

/// Frames a byte payload as an HTTP/1.1 chunk: `<hex-length>\r\n<payload>\r\n`.
export fn frameChunk(chunk: &Bytes) -> Bytes {
  let len = chunk.length()
  if len == 0 { return ByteSeq.empty() }
  let header = formatHexChunkHeader(len)
  let crlf = bytesOf([13u8, 10u8])
  ByteSeq.join(&[header, *chunk, crlf])
}

/// Legacy best-effort batching retained for compatibility.
///
/// An input larger than `maxMss` remains larger than that value. Use
/// `coalesceBounded` when every returned application-output chunk needs a hard
/// byte limit.
export fn coalesceToMss(chunks: &Array[Bytes], maxMss: Int) -> Array[Bytes] {
  if maxMss <= 0 { return *chunks }
  var coalesced: Array[Bytes] = []
  var currentBatch: Array[Bytes] = []
  var currentBytes = 0

  for chunk in chunks {
    let len = chunk.length()
    if len > 0 {
      if currentBytes + len > maxMss && currentBytes > 0 {
        coalesced = coalesced.push(ByteSeq.join(&currentBatch))
        currentBatch = [chunk]
        currentBytes = len
      } else {
        currentBatch = currentBatch.push(chunk)
        currentBytes = currentBytes + len
      }
    }
  }

  if currentBytes > 0 {
    coalesced = coalesced.push(ByteSeq.join(&currentBatch))
  }

  coalesced
}

/// Coalesces application-output bytes without returning a chunk over `maxBytes`.
///
/// Slices share storage with oversized inputs. Joining a batch copies only when
/// the batch contains more than one piece. The bound describes the returned
/// byte arrays, not packets or frames chosen by a transport.
export fn coalesceBounded(
  chunks: &Array[Bytes],
  maxBytes: Int
) -> Result[Array[Bytes], CoalesceError] {
  if maxBytes <= 0 { return Err(CoalesceError{maximum: maxBytes}) }

  var output: Array[Bytes] = []
  var batch: Array[Bytes] = []
  var batchBytes = 0

  for chunk in chunks {
    var offset = 0
    let length = chunk.length()
    while offset < length {
      let room = maxBytes - batchBytes
      let remaining = length - offset
      let amount = if remaining < room { remaining } else { room }
      batch = batch.push(ByteSeq.slice(&chunk, offset, offset + amount))
      batchBytes = batchBytes + amount
      offset = offset + amount

      if batchBytes == maxBytes {
        output = output.push(ByteSeq.join(&batch))
        batch = []
        batchBytes = 0
      }
    }
  }

  if batchBytes > 0 { output = output.push(ByteSeq.join(&batch)) }
  Ok(output)
}
