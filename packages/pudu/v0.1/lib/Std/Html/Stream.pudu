module Std.Html.Stream

import Std.Bytes as ByteSeq
import Std.Html as Html

/// Stylesheet source the caller has explicitly accepted as markup-adjacent code.
export type TrustedCss = { written: Str }

/// Reusable bytes for an early document head.
export type PreparedHead = { bytes: Bytes }

/// Why a suspense boundary identifier was refused.
export type BoundaryError = { boundaryId: Str }

const BOUNDARY_CHARACTERS: Str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

/// Marks reviewed stylesheet source for safe head preparation.
export fn trustedCss(written: Str) -> TrustedCss { TrustedCss{written: written} }

/// Prepares a reusable head from typed destinations, escaped text, and explicit CSS.
export fn prepareHead(
  title: Str,
  meta: &Array[(Str, Str)],
  criticalCss: &TrustedCss,
  preloads: &Array[Html.Destination]
) -> PreparedHead {
  var children: Array[Html.Html] = [
    Html.empty("meta", &[("charset", "utf-8")]),
    Html.empty("meta", &[
        ("name", "viewport"),
        ("content", "width=device-width, initial-scale=1")
      ]),
    Html.title(title)
  ]
  for pair in meta {
    children = children.push(Html.empty("meta", &[("name", pair[0]), ("content", pair[1])]))
  }
  for preload in preloads {
    children = children.push(Html.empty("link", &[
          ("rel", "preload"),
          ("href", Html.destinationText(&preload)),
          ("as", "style")
        ]))
  }
  if !criticalCss.written.isEmpty() {
    children = children.push(Html.element(
        "style",
          &[],
          &[Html.trusted(criticalCss.written)]
      ))
  }
  let head = Html.element("head", &[], &children)
  PreparedHead {
    bytes: ("<!DOCTYPE html><html lang=\"en\">" + Html.render(&head) + "<body>").toBytes()
  }
}

/// The immutable bytes retained by a prepared head.
export fn headBytes(prepared: &PreparedHead) -> Bytes { prepared.bytes }

/// Generates the early flush HTML document head strictly bounded for 1-RTT delivery.
export fn documentHead(
  title: Str,
  meta: &Array[(Str, Str)],
  criticalCss: Str,
  preloads: &Array[Str]
) -> Bytes {
  var markup = "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>" + title + "</title>"

  for pair in meta {
    markup = markup + "<meta name=\"" + pair[0] + "\" content=\"" + pair[1] + "\">"
  }

  for href in preloads {
    markup = markup + "<link rel=\"preload\" href=\"" + href + "\" as=\"style\">"
  }

  if criticalCss.length() > 0 {
    markup = markup + "<style>" + criticalCss + "</style>"
  }

  markup = markup + "</head><body>"
  markup.toBytes()
}

/// Generates closing markup for the document stream.
export fn documentTail() -> Bytes {
  "</body></html>".toBytes()
}

/// Generates the initial placeholder container for a Suspense boundary.
export fn suspensePlaceholder(boundaryId: Str, fallback: &Bytes) -> Bytes {
  let open = ("<div id=\"pudu-s-" + boundaryId + "\">").toBytes()
  let close = "</div>".toBytes()
  ByteSeq.join(&[open, *fallback, close])
}

/// Generates the out-of-order replacement template and inline resolution script.
///
/// Executes immediately upon stream receipt in the browser, swapping the placeholder
/// contents synchronously without an external client framework runtime.
export fn suspenseReplacement(boundaryId: Str, content: &Bytes) -> Bytes {
  let tOpen = ("<template id=\"pudu-t-" + boundaryId + "\">").toBytes()
  let tClose = ("</template><script>(function()\{var t=document.getElementById(\"pudu-t-" + boundaryId + "\");var s=document.getElementById(\"pudu-s-" + boundaryId + "\");if(t&&s)\{s.replaceChildren(t.content.cloneNode(true));t.remove();\}\})();</script>").toBytes()
  ByteSeq.join(&[tOpen, *content, tClose])
}

/// Generates the out-of-order error template and inline resolution script.
///
/// Replaces the placeholder contents with the error fallback without crashing the HTTP stream.
export fn suspenseError(boundaryId: Str, errorFallback: &Bytes) -> Bytes {
  let tOpen = ("<template id=\"pudu-e-" + boundaryId + "\">").toBytes()
  let tClose = ("</template><script>(function()\{var t=document.getElementById(\"pudu-e-" + boundaryId + "\");var s=document.getElementById(\"pudu-s-" + boundaryId + "\");if(t&&s)\{s.replaceChildren(t.content.cloneNode(true));s.setAttribute(\"data-pudu-error\",\"true\");t.remove();\}\})();</script>").toBytes()
  ByteSeq.join(&[tOpen, *errorFallback, tClose])
}

/// Paired helper generating both initial fallback and deferred replacement chunks.
export fn renderSuspended(
  boundaryId: Str,
  fallback: &Bytes,
  content: &Bytes
) -> (Bytes, Bytes) {
  (suspensePlaceholder(boundaryId, fallback), suspenseReplacement(boundaryId, content))
}

/// A typed fallback inside a validated suspense boundary.
export fn placeholder(boundaryId: Str, fallback: &Html.Html) -> Result[Bytes, BoundaryError] {
  let _checked = checkBoundary(boundaryId) ?
  let rendered = Html.render(fallback).toBytes()
  Ok(suspensePlaceholder(boundaryId, &rendered))
}

/// Typed resolved content for a validated suspense boundary.
export fn replacement(boundaryId: Str, content: &Html.Html) -> Result[Bytes, BoundaryError] {
  let _checked = checkBoundary(boundaryId) ?
  let rendered = Html.render(content).toBytes()
  Ok(suspenseReplacement(boundaryId, &rendered))
}

/// A typed error fallback for a validated suspense boundary.
export fn errorReplacement(
  boundaryId: Str,
  fallback: &Html.Html
) -> Result[Bytes, BoundaryError] {
  let _checked = checkBoundary(boundaryId) ?
  let rendered = Html.render(fallback).toBytes()
  Ok(suspenseError(boundaryId, &rendered))
}

/// The initial and resolved chunks for one validated typed boundary.
export fn suspended(
  boundaryId: Str,
  fallback: &Html.Html,
  content: &Html.Html
) -> Result[(Bytes, Bytes), BoundaryError] {
  let first = placeholder(boundaryId, fallback) ?
  let second = replacement(boundaryId, content) ?
  Ok((first, second))
}

fn checkBoundary(boundaryId: Str) -> Result[(), BoundaryError] {
  if boundaryId.isEmpty() { return Err(BoundaryError{boundaryId: boundaryId}) }
  var index = 0
  while index < boundaryId.length() {
    let character = boundaryId.slice(index, index + 1)
    if !BOUNDARY_CHARACTERS.contains(character) {
      return Err(BoundaryError{boundaryId: boundaryId})
    }
    index = index + 1
  }
  Ok(())
}
