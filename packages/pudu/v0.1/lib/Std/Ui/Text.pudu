  15218750u64,
  8888000806u64,
  18400877u64,
  18400580u64,
  18405034u64,
  18157905u64,
  18398254u64,
  32575775u64,
  2286162050u64,
  4433514628u64,
  8728416392u64,
  9078784u64
]

/// The hollow box drawn for a character outside the table.
const MISSING_GLYPH: UInt64 = 33874822719u64

/// A face at a whole-number scale from 1 to 64.
export fn face(scale: Int) -> Result[Face, TextError] {
  if scale < 1 || scale > MAX_SCALE { Err(InvalidScale(scale)) } else { Ok(Face{scale: scale}) }
}

/// The measures of a face.
export fn metrics(target: &Face) -> Metrics {
  Metrics {
    advance: ADVANCE_UNITS * target.scale,
    ascent: GLYPH_ROWS * target.scale,
    lineHeight: LINE_UNITS * target.scale
  }
}

/// Whether a character has its own glyph rather than the missing-glyph box.
export fn hasGlyph(character: Char) -> Bool {
  character.code() >= 32 && character.code() < 127
}

/// The size text occupies, with each newline starting a line.
///
/// The width is the widest line without the space after its last glyph; the
/// height runs from the top of the first line to the bottom of the last.
export fn measure(target: &Face, text: Str) -> Result[Canvas.Size, TextError] {
  let characters = admitted(text) ?
  var widest = 0
  var current = 0
  var lineCount = 1
  for character in characters {
    if character == '\n' {
      lineCount = lineCount + 1
      current = 0
    } else {
      current = current + 1
      if current > widest { widest = current }
    }
  }
  Ok(Canvas.size(lineWidth(target, widest), textHeight(target, lineCount)))
}

/// Text broken into lines no wider than a width.
///
/// Newlines always break. Words are separated by spaces and placed greedily;
/// the space where a line breaks is dropped. A word wider than the width is
/// broken between characters, and at least one character is placed per line
/// so a width narrower than one glyph still makes progress.
export fn wrapped(target: &Face, text: Str, width: Int) -> Result[Array[Str], TextError] {
  admitted(text) ?
  if width < 0 {
    Err(NegativeWidth(width))
  } else {
    let unit = ADVANCE_UNITS * target.scale
    let fitting = (width + target.scale) / unit
    let capacity = if fitting < 1 { 1 } else { fitting }
    var lines: Array[Str] = []
    for paragraph in text.split("\n") {
      var current = ""
      var used = 0
      for word in paragraph.split(" ") {
        var rest = word
        var restLength = rest.length()
        let needed = if used == 0 { restLength } else { used + 1 + restLength }
        if needed <= capacity {
          current = if used == 0 { rest } else { current + " " + rest }
          used = needed
        } else {
          if used > 0 {
            lines = lines.push(current)
            current = ""
            used = 0
          }
          while restLength > capacity {
            lines = lines.push(rest.slice(0, capacity))
            rest = rest.slice(capacity, restLength)
            restLength = restLength - capacity
          }
          current = rest
          used = restLength
        }
      }
      lines = lines.push(current)
    }
    Ok(lines)
  }
}

/// A canvas with text drawn from an origin at the top left of its first line.
///
/// Each glyph becomes the fewest rectangles its bitmap allows: lit columns in
/// a row join into one run, and a run repeated in the rows below it joins into
/// one taller rectangle, so a stem is one command rather than seven.
export fn draw(
  target: &Face,
  onto: &Canvas.Canvas,
  origin: Canvas.Point,
  text: Str,
  color: Canvas.Color
) -> Result[Canvas.Canvas, TextError] {
  drawn(target, onto, origin, text, color, None)
}

/// Text drawn as `draw` draws it, with every glyph rectangle cut to a window.
///
/// Rectangles wholly outside the window add no command, so text scrolled out of
/// view costs nothing to render.
export fn drawWithin(
  target: &Face,
  onto: &Canvas.Canvas,
  origin: Canvas.Point,
  text: Str,
  color: Canvas.Color,
  window: Canvas.Rect
) -> Result[Canvas.Canvas, TextError] {
  drawn(target, onto, origin, text, color, Some(window))
}

fn drawn(
  target: &Face,
  onto: &Canvas.Canvas,
  origin: Canvas.Point,
  text: Str,
  color: Canvas.Color,
  window: Option[Canvas.Rect]
) -> Result[Canvas.Canvas, TextError] {
  let characters = admitted(text) ?
  var held = *onto
  var column = 0
  var line = 0
  for character in characters {
    if character == '\n' {
      line = line + 1
      column = 0
    } else {
      let x = origin.x + column * ADVANCE_UNITS * target.scale
      let y = origin.y + line * LINE_UNITS * target.scale
      held = glyphDrawn(target, &held, glyphOf(character), x, y, color, window) ?
      column = column + 1
    }
  }
  Ok(held)
}

fn admitted(text: Str) -> Result[Array[Char], TextError] {
  let characters = text.chars()
  if characters.length() > MAX_CHARACTERS {
    Err(TextTooLong(characters.length()))
  } else {
    Ok(characters)
  }
}

fn lineWidth(target: &Face, characters: Int) -> Int {
  if characters == 0 { 0 } else { (characters * ADVANCE_UNITS - 1) * target.scale }
}

fn textHeight(target: &Face, lines: Int) -> Int {
  ((lines - 1) * LINE_UNITS + GLYPH_ROWS) * target.scale
}

fn glyphOf(character: Char) -> UInt64 {
  if hasGlyph(character) { GLYPHS[character.code() - 32] } else { MISSING_GLYPH }
}

fn glyphDrawn(
  target: &Face,
  onto: &Canvas.Canvas,
  glyph: UInt64,
  x: Int,
  y: Int,
  color: Canvas.Color,
  window: Option[Canvas.Rect]
) -> Result[Canvas.Canvas, TextError] {
  var held = *onto
  var row = 0
  while row < GLYPH_ROWS {
    var start = 0
    while start < GLYPH_COLUMNS {
      if lit(glyph, row, start) {
        var end = start + 1
        while end < GLYPH_COLUMNS && lit(glyph, row, end) { end = end + 1 }
        if !(row > 0 && isRun(glyph, row - 1, start, end)) {
          var rows = 1
          while row + rows < GLYPH_ROWS && isRun(glyph, row + rows, start, end) { rows = rows + 1 }
          let area = within(
            Canvas.rect(
              x + start * target.scale,
              y + row * target.scale,
              (end - start) * target.scale,
              rows * target.scale
            ),
            window
          )
          held = match Canvas.fill(&held, area, color) {
            case Ok(next) => next
            case Err(reason) => { return Err(Drawing(reason)) }
          }
        }
        start = end
      } else {
        start = start + 1
      }
    }
    row = row + 1
  }
  Ok(held)
}

fn within(area: Canvas.Rect, window: Option[Canvas.Rect]) -> Canvas.Rect {
  if let Some(bounds) = window {
    let left = if area.x > bounds.x { area.x } else { bounds.x }
    let top = if area.y > bounds.y { area.y } else { bounds.y }
    let areaRight = area.x + area.width
    let boundsRight = bounds.x + bounds.width
    let areaBottom = area.y + area.height
    let boundsBottom = bounds.y + bounds.height
    let right = if areaRight < boundsRight { areaRight } else { boundsRight }
    let bottom = if areaBottom < boundsBottom { areaBottom } else { boundsBottom }
    Canvas.rect(
      left,
      top,
      if right > left { right - left } else { 0 },
      if bottom > top { bottom - top } else { 0 }
    )
  } else {
    area
  }
}

fn lit(glyph: UInt64, row: Int, column: Int) -> Bool {
  let shift = GLYPH_ROWS * GLYPH_COLUMNS - 1 - (row * GLYPH_COLUMNS + column)
  ((glyph >> shift) & 1u64) == 1u64
}

/// Whether a row's lit columns from `start` up to `end` form exactly one
/// maximal run, which is when a rectangle from the row above may continue.
fn isRun(glyph: UInt64, row: Int, start: Int, end: Int) -> Bool {
  var column = start
  var all = true
  while column < end && all {
    all = lit(glyph, row, column)
    column = column + 1
  }
  all && (start == 0 || !lit(glyph, row, start - 1)) &&
  (end == GLYPH_COLUMNS || !lit(glyph, row, end))
}
