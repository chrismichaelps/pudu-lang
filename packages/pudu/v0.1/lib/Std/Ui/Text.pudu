module Std.Ui.Text

import Std.Option as Option
import Std.Ui.Canvas as Canvas

/// A bitmap type face drawn by whole-number scaling.
///
/// Every glyph occupies five columns by seven rows of design units, followed by
/// one unit of space, and lines are nine units apart. Whole-number scaling keeps
/// every edge on a pixel, so text is as exact as the rectangles around it.
export type Face = { scale: Int }

/// Vertical and horizontal measures of a face, in pixels.
export type Metrics = { advance: Int, ascent: Int, lineHeight: Int }

/// Why text could not be measured, wrapped, or drawn.
export type TextError
  = InvalidScale(Int)
  | NegativeWidth(Int)
  | TextTooLong(Int)
  | Drawing(Canvas.CanvasError)

/// The largest scale a face may use.
const MAX_SCALE: Int = 64

/// The most characters one call measures, wraps, or draws.
const MAX_CHARACTERS: Int = 1048576

const GLYPH_COLUMNS: Int = 5

const GLYPH_ROWS: Int = 7

const ADVANCE_UNITS: Int = 6

const LINE_UNITS: Int = 9

/// Glyph bitmaps for the printable ASCII range from space to tilde, indexed by
/// code minus 32. Each packs seven rows of five columns, top row and leftmost
/// column in the highest bits.
const GLYPHS: Array[UInt64] = [
  0u64,
  4433514500u64,
  11072962560u64,
  11788430314u64,
  4819720132u64,
  26610901603u64,
  13510137421u64,
  4429185024u64,
  2290360450u64,
  8726317192u64,
