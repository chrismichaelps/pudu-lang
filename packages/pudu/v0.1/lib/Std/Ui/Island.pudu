module Std.Ui.Island

import Std.Html as Html

/// Wraps a server-rendered component in an isolated progressive island element.
export type Hydration = Eager | Visible | Idle

/// Wrap server-rendered content as an island, hydrated on arrival.
export fn island(name: Str, propsJson: Str, fallback: Html.Html) -> Html.Html {
  islandWithHydration(name, propsJson, fallback, Eager)
}

/// Wrap server-rendered content as an island, hydrated as the mode says.
export fn islandWithHydration(name: Str, propsJson: Str, fallback: Html.Html, hydration: Hydration) -> Html.Html {
  let mode = match hydration {
    case Eager => "eager"
    case Visible => "visible"
    case Idle => "idle"
  }
  Html.element("pudu-island",
      &[("data-name", name), ("data-props", propsJson), ("data-hydrate", mode)],
      &[fallback])
}

/// Builds an accessible HTML form with automatic CSRF token protection.
///
export fn serverActionForm(
  actionUrl: Str,
  csrfToken: Str,
  fields: &Array[Html.Html]
) -> Html.Html {
  let csrfInput = Html.element(
    "input",
      &[("type", "hidden"), ("name", "_csrf"), ("value", csrfToken)],
      &[]
  )
  var children = [csrfInput]
  for field in fields {
    children = children.push(field)
  }

  Html.element(
    "form",
      &[("method", "POST"), ("action", actionUrl)],
      &children
  )
}

/// The script that mounts islands, allowed by the given nonce.
export fn microRuntime(nonce: Str) -> Html.Html {
  let scriptBody = "(function()\{if(window.PuduIslands)return;const mounts=new Map();const visible=typeof IntersectionObserver==='function'?new IntersectionObserver(entries=>\{for(const entry of entries)if(entry.isIntersecting)\{visible.unobserve(entry.target);entry.target.waiting=false;entry.target.mount();\}\}):null;function report(node,error)\{node.dispatchEvent(new CustomEvent('pudu:island-error',\{detail:error,bubbles:true\}));\}class Island extends HTMLElement\{connectedCallback()\{this.schedule();\}schedule()\{if(this.active||this.waiting||!this.isConnected||!mounts.has(this.dataset.name))return;if(this.dataset.hydrate==='visible'&&visible)\{this.waiting=true;visible.observe(this);return;\}if(this.dataset.hydrate==='idle')\{this.waiting=true;const run=()=>\{this.cancelScheduled=null;this.waiting=false;this.mount();\};if(typeof requestIdleCallback==='function')\{const id=requestIdleCallback(run,\{timeout:2000\});this.cancelScheduled=()=>cancelIdleCallback(id);\}else\{const id=setTimeout(run,0);this.cancelScheduled=()=>clearTimeout(id);\}return;\}this.mount();\}disconnectedCallback()\{if(this.controller)this.controller.abort();this.controller=null;if(visible)visible.unobserve(this);if(this.cancelScheduled)this.cancelScheduled();this.cancelScheduled=null;this.waiting=false;this.generation=(this.generation||0)+1;const cleanup=this.cleanup;this.cleanup=null;this.active=false;if(typeof cleanup==='function')\{try\{cleanup();\}catch(error)\{report(this,error);\}\}\}mount()\{if(visible)visible.unobserve(this);if(this.cancelScheduled)this.cancelScheduled();this.cancelScheduled=null;this.waiting=false;const mount=mounts.get(this.dataset.name);if(this.active||!this.isConnected||!mount)return;let props;try\{props=JSON.parse(this.dataset.props||'\{\}');\}catch(error)\{report(this,error);return;\}this.active=true;this.controller=new AbortController();const signal=this.controller.signal;const generation=this.generation=(this.generation||0)+1;Promise.resolve().then(()=>\{if(this.isConnected&&this.generation===generation)return mount(this,props,signal);\}).then(cleanup=>\{if(!this.isConnected||this.generation!==generation)\{if(typeof cleanup==='function')cleanup();return;\}this.cleanup=cleanup;this.dispatchEvent(new CustomEvent('pudu:island-ready',\{bubbles:true\}));\}).catch(error=>\{if(this.generation===generation)this.active=false;report(this,error);\});\}\}function register(name,mount)\{if(typeof name!=='string'||!name||typeof mount!=='function')throw new TypeError('Invalid island registration');if(mounts.has(name))throw new Error('Island already registered: '+name);mounts.set(name,mount);for(const node of document.querySelectorAll('pudu-island'))if(node.dataset.name===name)node.schedule();\}function registerLazy(name,load)\{if(typeof load!=='function')throw new TypeError('Island loader must be a function');let pending;register(name,async(node,props,signal)=>\{if(!pending)pending=Promise.resolve().then(load).then(loaded=>\{const mount=typeof loaded==='function'?loaded:loaded&&loaded.mount;if(typeof mount!=='function')throw new TypeError('Island loader must return a mount function or a module exporting mount');return mount;\}).catch(error=>\{pending=null;throw error;\});const mount=await pending;if(signal.aborted||!node.isConnected)return;return mount(node,props,signal);\});\}window.PuduIslands=Object.freeze(\{register,registerLazy\});if(!customElements.get('pudu-island'))customElements.define('pudu-island',Island);\})();"
  Html.element("script", &[("nonce", nonce)], &[Html.trusted(scriptBody)])
}
