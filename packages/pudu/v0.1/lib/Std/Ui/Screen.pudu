module Std.Ui.Screen

import Std.Option as Option
import Std.Ui.Canvas as Canvas
import Std.Ui.Layout as Layout

/// A key a screen answers without text entry.
///
/// Named by what it does rather than by the keycap, so a platform presenter
/// maps its own keys once and the screen never sees a keyboard layout.
export type Key
  = Next
  | Previous
  | Activate
  | Dismiss
  | Erase

/// Something a person did.
export type Input
  = Pressed(Canvas.Point)
  | KeyPressed(Key)
  | TypedText(Str)
  | Scrolled(Canvas.Point, Int)

/// What an update is told happened.
///
/// A control is named by its tag, the identity placement already requires to
/// be unique among controls, so an event cannot be ambiguous about its source.
export type Event
  = Activated(Str)
  | Dismissed
  | Typed(Str, Str)
  | Erased(Str)
  | ScrolledTo(Str, Int)

/// Why a screen could not be shown.
export type ScreenError
  = Placement(Layout.LayoutError)
  | Drawing(Canvas.CanvasError)

/// A running screen: what is known, how it is shown and changed, and the frame
/// it last produced.
///
/// The frame is held as a value: the view it was placed from, its layout, its
/// pixels, the regions that changed to produce them, the tag holding focus, and
/// the color of the ring that shows where focus is.
export type Screen[S] = {
  state: S,
  view: fn(S) -> Layout.View,
  update: fn(S, Event) -> S,
  background: Canvas.Color,
  ring: Canvas.Color,
  shown: Layout.View,
  layout: Layout.Layout,
  surface: Canvas.Surface,
  focus: Option[Str],
  damaged: Array[Canvas.Rect]
}

/// The color a focus ring is drawn in until `focusRing` changes it.
const DEFAULT_RING: Canvas.Color = Canvas.Color{red: 0u8, green: 90u8, blue: 200u8, alpha: 255u8}

/// A screen showing its first frame.
///
/// The whole viewport is damaged, because nothing was shown before it.
export fn start[S](
  state: S,
  view: fn(S) -> Layout.View,
  update: fn(S, Event) -> S,
  viewport: Canvas.Size,
  background: Canvas.Color
) -> Result[Screen[S], ScreenError] {
  let shown = view(state)
  let placed = placedView(&shown, viewport) ?
  let painted = composed(&placed, background, None, DEFAULT_RING) ?
  let surface = match Canvas.render(&painted) {
    case Ok(value) => value
    case Err(reason) => { return Err(Drawing(reason)) }
  }
  Ok(Screen {
      state: state,
      view: view,
      update: update,
      background: background,
      ring: DEFAULT_RING,
      shown: shown,
      layout: placed,
      surface: surface,
      focus: None,
      damaged: [Canvas.rect(0, 0, viewport.width, viewport.height)]
    })
}

/// The screen after one input.
///
/// A press activates the frontmost control under it and moves focus there; a
/// press on anything else changes nothing. `Next` and `Previous` move focus
/// through the controls in reading order and wrap. `Activate` activates the
/// focused control. An input that changes neither state nor focus returns the
/// same frame with no damage.
export fn handle[S](target: &Screen[S], input: Input) -> Result[Screen[S], ScreenError] {
  match input {
    case Pressed(location) => pressed(target, location)
    case KeyPressed(Next) => refocused(target, stepped(target, 1))
    case KeyPressed(Previous) => refocused(target, stepped(target, -1))
    case KeyPressed(Activate) => activated(target)
    case KeyPressed(Dismiss) => updated(target, Dismissed, target.focus)
    case KeyPressed(Erase) => edited(target, fn(tag: Str) -> Event { Erased(tag) })
    case Scrolled(location, delta) => wheeled(target, location, delta)
    case TypedText(text) =>
    if text.isEmpty() {
      Ok(Screen{..*target, damaged: []})
    } else {
      edited(target, fn(tag: Str) -> Event { Typed(tag, text) })
    }
  }
}

/// The screen showing `state`, for a change that did not come from an input:
/// a shortcut, a timer, or a finished background task.
///
/// Focus is kept when the new frame still holds the focused control, and
/// only changed regions are damaged.
export fn restated[S](target: &Screen[S], state: S) -> Result[Screen[S], ScreenError] {
  rendered(target, state, target.focus)
}

/// The screen after several inputs, in order.
///
/// The damage is every region any of the inputs changed, in order.
export fn handleAll[S](
  target: &Screen[S],
  inputs: &Array[Input]
) -> Result[Screen[S], ScreenError] {
  var held = Screen{..*target, damaged: []}
  var damaged: Array[Canvas.Rect] = []
  for input in inputs {
    held = handle(&held, input) ?
    for region in held.damaged { damaged = damaged.push(region) }
  }
  Ok(Screen{..held, damaged: damaged})
}

/// The screen drawing its focus ring in another color.
///
/// Only the ring around the focused control is damaged; with nothing focused
/// the frame is unchanged.
export fn focusRing[S](target: &Screen[S], color: Canvas.Color) -> Result[Screen[S], ScreenError] {
  let painted = composed(&target.layout, target.background, target.focus, color) ?
  let regions = ringRegions(&target.layout, target.focus, [])
  let surface = repainted(&painted, &target.surface, &regions) ?
  Ok(Screen{..*target, ring: color, surface: surface, damaged: regions})
}

/// The color focus rings are drawn in when a screen starts.
export fn defaultRing() -> Canvas.Color { DEFAULT_RING }

/// What the screen currently knows.
export fn stateOf[S](target: &Screen[S]) -> S { target.state }

/// The pixels of the current frame.
export fn surfaceOf[S](target: &Screen[S]) -> Canvas.Surface { target.surface }

/// The placement of the current frame.
export fn layoutOf[S](target: &Screen[S]) -> Layout.Layout { target.layout }

/// The regions that changed to produce the current frame.
export fn damagedOf[S](target: &Screen[S]) -> Array[Canvas.Rect] { target.damaged }

/// The tag of the focused control, if any.
export fn focusOf[S](target: &Screen[S]) -> Option[Str] { target.focus }

fn pressed[S](target: &Screen[S], location: Canvas.Point) -> Result[Screen[S], ScreenError] {
  if let Some(node) = Layout.hitTest(&target.layout, location) {
    if Layout.isControlAt(&target.layout, node) {
      if let Some(tag) = Layout.tagOf(&target.layout, node) {
        return updated(target, Activated(tag), Some(tag))
      }
    }
  }
  Ok(Screen{..*target, damaged: []})
}

/// An edit delivered to the focused field, or nothing when focus is elsewhere.
///
/// Text goes only to a control that means `Field`, so typing while a button
/// holds focus cannot reach state through a control that does not accept text.
fn edited[S](target: &Screen[S], event: fn(Str) -> Event) -> Result[Screen[S], ScreenError] {
  if let Some(tag) = target.focus {
    if let Some(node) = Layout.nodeTagged(&target.layout, tag) {
      if target.layout.nodes[node].role == Layout.Field {
        return updated(target, event(tag), target.focus)
      }
    }
  }
  Ok(Screen{..*target, damaged: []})
}

/// A scroll delivered to the frontmost tagged scrolling node under a point.
///
/// The new offset is clamped to the node's range before the update sees it, so
/// state never holds a position the layout would not show; a scroll that
/// cannot move, or lands on no tagged scrolling node, changes nothing.
fn wheeled[S](
  target: &Screen[S],
  location: Canvas.Point,
  delta: Int
) -> Result[Screen[S], ScreenError] {
  var index = target.layout.nodes.length() - 1
  while index >= 0 {
    let placed = target.layout.nodes[index]
    if placed.scrolls && !placed.tag.isEmpty() && inside(&placed.frame, &location) &&
    inside(&placed.clip, &location)
    {
      let wanted = placed.offset + delta
      let clamped = if wanted < 0 { 0 } else if wanted > placed.range { placed.range } else { wanted }
      if clamped == placed.offset {
        return Ok(Screen{..*target, damaged: []})
      }
      return updated(target, ScrolledTo(placed.tag, clamped), target.focus)
    }
    index = index - 1
  }
  Ok(Screen{..*target, damaged: []})
}

fn inside(area: &Canvas.Rect, location: &Canvas.Point) -> Bool {
  location.x >= area.x && location.y >= area.y &&
  location.x < area.x + area.width && location.y < area.y + area.height
}

fn activated[S](target: &Screen[S]) -> Result[Screen[S], ScreenError] {
  if let Some(tag) = target.focus {
    updated(target, Activated(tag), target.focus)
  } else {
    Ok(Screen{..*target, damaged: []})
  }
}

fn stepped[S](target: &Screen[S], direction: Int) -> Option[Str] {
  let order = Layout.focusOrder(&target.layout)
  let count = order.length()
  if count == 0 {
    None
  } else {
    var current = -1
    if let Some(tag) = target.focus {
      var index = 0
      while index < count {
        if Layout.tagOf(&target.layout, order[index]) == Some(tag) { current = index }
        index = index + 1
      }
    }
    let next = if current < 0 {
      if direction > 0 { 0 } else { count - 1 }
    } else {
      (current + direction + count) % count
    }
    Layout.tagOf(&target.layout, order[next])
  }
}

/// The screen with focus moved, damaging the ring it left and the ring it
/// reached.
fn refocused[S](target: &Screen[S], focus: Option[Str]) -> Result[Screen[S], ScreenError] {
  if focus == target.focus {
    Ok(Screen{..*target, damaged: []})
  } else {
    let painted = composed(&target.layout, target.background, focus, target.ring) ?
    let regions = ringRegions(&target.layout, focus, ringRegions(&target.layout, target.focus, []))
    let surface = repainted(&painted, &target.surface, &regions) ?
    Ok(Screen{..*target, surface: surface, focus: focus, damaged: regions})
  }
}

fn updated[S](
  target: &Screen[S],
  event: Event,
  focus: Option[Str]
) -> Result[Screen[S], ScreenError] {
  rendered(target, (target.update)(target.state, event), focus)
}

fn rendered[S](
  target: &Screen[S],
  state: S,
  focus: Option[Str]
) -> Result[Screen[S], ScreenError] {
  let shown = (target.view)(state)
  if shown == target.shown && focus == target.focus {
    return Ok(Screen{..*target, state: state, damaged: []})
  }
  let placed = placedView(&shown, target.layout.viewport) ?
  let kept = if let Some(tag) = focus {
    if Option.isSome(&Layout.nodeTagged(&placed, tag)) { focus } else { None }
  } else {
    None
  }
  let painted = composed(&placed, target.background, kept, target.ring) ?
  var regions: Array[Canvas.Rect] = []
  for region in Layout.damage(&target.layout, &placed) { regions = withRegion(regions, region) }
  regions = ringRegions(&target.layout, target.focus, regions)
  regions = ringRegions(&placed, kept, regions)
  let surface = repainted(&painted, &target.surface, &regions) ?
  Ok(Screen {
      ..*target,
      state: state,
      shown: shown,
      layout: placed,
      surface: surface,
      focus: kept,
      damaged: regions
    })
}

fn placedView(shown: &Layout.View, viewport: Canvas.Size) -> Result[Layout.Layout, ScreenError] {
  match Layout.place(shown, viewport) {
    case Ok(value) => Ok(value)
    case Err(reason) => Err(Placement(reason))
  }
}

/// The display list of a frame: the layout's fills and text, then the focus
/// ring over them so no control can hide it.
fn composed(
  placed: &Layout.Layout,
  background: Canvas.Color,
  focus: Option[Str],
  ring: Canvas.Color
) -> Result[Canvas.Canvas, ScreenError] {
  let blank = match Canvas.canvas(placed.viewport.width, placed.viewport.height, background) {
    case Ok(value) => value
    case Err(reason) => { return Err(Drawing(reason)) }
  }
  var held = match Layout.paint(placed, &blank) {
    case Ok(value) => value
    case Err(Layout.Drawing(reason)) => { return Err(Drawing(reason)) }
    case Err(reason) => { return Err(Placement(reason)) }
  }
  if let Some(area) = focusFrame(placed, focus) {
    for edge in ringEdges(&area) {
      held = match Canvas.fill(&held, edge, ring) {
        case Ok(next) => next
        case Err(reason) => { return Err(Drawing(reason)) }
      }
    }
  }
  Ok(held)
}

fn repainted(
  painted: &Canvas.Canvas,
  previous: &Canvas.Surface,
  regions: &Array[Canvas.Rect]
) -> Result[Canvas.Surface, ScreenError] {
  match Canvas.repaint(painted, previous, regions) {
    case Ok(value) => Ok(value)
    case Err(reason) => Err(Drawing(reason))
  }
}

fn focusFrame(placed: &Layout.Layout, focus: Option[Str]) -> Option[Canvas.Rect] {
  if let Some(tag) = focus {
    if let Some(node) = Layout.nodeTagged(placed, tag) { return Layout.frameOf(placed, node) }
  }
  None
}

/// The four one-pixel edges just outside a frame.
fn ringEdges(area: &Canvas.Rect) -> Array[Canvas.Rect] {
  [
    Canvas.rect(area.x - 1, area.y - 1, area.width + 2, 1),
    Canvas.rect(area.x - 1, area.y + area.height, area.width + 2, 1),
    Canvas.rect(area.x - 1, area.y, 1, area.height),
    Canvas.rect(area.x + area.width, area.y, 1, area.height)
  ]
}

/// The visible region a focus ring occupies, added once.
fn ringRegions(
  placed: &Layout.Layout,
  focus: Option[Str],
  found: Array[Canvas.Rect]
) -> Array[Canvas.Rect] {
  if let Some(area) = focusFrame(placed, focus) {
    let left = if area.x - 1 < 0 { 0 } else { area.x - 1 }
    let top = if area.y - 1 < 0 { 0 } else { area.y - 1 }
    let rawRight = area.x + area.width + 1
    let rawBottom = area.y + area.height + 1
    let right = if rawRight > placed.viewport.width { placed.viewport.width } else { rawRight }
    let bottom = if rawBottom > placed.viewport.height { placed.viewport.height } else { rawBottom }
    if left >= right || top >= bottom {
      found
    } else {
      withRegion(found, Canvas.rect(left, top, right - left, bottom - top))
    }
  } else {
    found
  }
}

fn withRegion(found: Array[Canvas.Rect], region: Canvas.Rect) -> Array[Canvas.Rect] {
  if found.contains(region) { found } else { found.push(region) }
}
