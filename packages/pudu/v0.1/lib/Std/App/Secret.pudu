module Std.App.Secret

import Std.Crypto as Crypto

/// A sensitive string wrapped in an opaque container to prevent accidental disclosure.
export type Secret = { raw: Str }

/// Wraps a plain string as a protected secret.
export fn secret(value: Str) -> Secret {
  Secret{raw: value}
}

/// Unveils the inner sensitive string for authorized operations.
export fn reveal(s: &Secret) -> Str {
  s.raw
}

/// Returns a redacted placeholder for safe inclusion in logs, traces, and errors.
export fn redact(_s: &Secret) -> Str {
  "[REDACTED]"
}

/// Partially masks a secret key for audit trails, revealing at most `visibleSuffix` characters.
export fn redactKey(s: &Secret, visibleSuffix: Int) -> Str {
  let len = s.raw.length()
  if len <= visibleSuffix || visibleSuffix <= 0 {
    "••••••••"
  } else {
    let suffix = s.raw.slice(len - visibleSuffix, len)
    "••••••••" + suffix
  }
}

/// Compares two secrets in constant time to prevent side-channel timing attacks.
export fn constantTimeEquals(a: &Secret, b: &Secret) -> Bool {
  Crypto.secretsMatch(a.raw, b.raw)
}
