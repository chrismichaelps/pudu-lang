module Std.App.Jwt

import Std.Bytes as ByteSeq
import Std.Crypto as Crypto
import Std.Json as Json
import Std.Result as Result

/// Standard claims contained within an RFC 7519 JSON Web Token.
export type JwtClaims = {
  subject: Option[Str],
  issuer: Option[Str],
  audience: Option[Str],
  expiresAt: Option[Int],
  notBefore: Option[Int],
  issuedAt: Option[Int],
  tokenId: Option[Str],
  custom: Array[(Str, Str)],
}

/// Validation parameters applied during JWT signature and claims checking.
export type JwtValidation = {
  expectedIssuer: Option[Str],
  expectedAudience: Option[Str],
  leewaySeconds: Int,
}

/// Structured failure conditions encountered while decoding or validating a JWT.
export type JwtError
  = MalformedToken
  | InvalidSignature
  | UnsupportedAlgorithm
  | ExpiredToken
  | TokenNotYetValid
  | IssuerMismatch
  | AudienceMismatch
  | InvalidClaimsJson

/// Constructs an empty set of JWT claims.
export fn claims() -> JwtClaims {
  JwtClaims {
    subject: None,
    issuer: None,
    audience: None,
    expiresAt: None,
    notBefore: None,
    issuedAt: None,
    tokenId: None,
    custom: [],
  }
}

/// Claims with one field set, each answering the claims rather than taking
/// them apart.
///
/// Methods, so a token's claims are written down the page in the order they
/// are decided. As functions taking the claims first, a token setting five of
/// them had five calls wrapped in one another and the claims a reader looks
/// for first ended up furthest in.
export trait Claiming {
  fn withSubject(self: &Self, sub: Str) -> Self
  fn withIssuer(self: &Self, iss: Str) -> Self
  fn withAudience(self: &Self, aud: Str) -> Self
  fn withExpiresAt(self: &Self, exp: Int) -> Self
  fn withNotBefore(self: &Self, nbf: Int) -> Self
  fn withIssuedAt(self: &Self, iat: Int) -> Self
  fn withTokenId(self: &Self, jti: Str) -> Self
  fn withClaim(self: &Self, key: Str, value: Str) -> Self
  fn expiresIn(self: &Self, durationSeconds: Int, nowSeconds: Int) -> Self
}

impl Claiming for JwtClaims {
  /// Who the token is about.
  fn withSubject(self: &Self, sub: Str) -> Self {
    JwtClaims{..*self, subject: Some(sub)}
  }

  /// Who issued the token.
  fn withIssuer(self: &Self, iss: Str) -> Self {
    JwtClaims{..*self, issuer: Some(iss)}
  }

  /// Who the token is for.
  fn withAudience(self: &Self, aud: Str) -> Self {
    JwtClaims{..*self, audience: Some(aud)}
  }

  /// The second after which the token is no longer good.
  fn withExpiresAt(self: &Self, exp: Int) -> Self {
    JwtClaims{..*self, expiresAt: Some(exp)}
  }

  /// The second before which the token is not yet good.
  fn withNotBefore(self: &Self, nbf: Int) -> Self {
    JwtClaims{..*self, notBefore: Some(nbf)}
  }

  /// The second the token was made.
  fn withIssuedAt(self: &Self, iat: Int) -> Self {
    JwtClaims{..*self, issuedAt: Some(iat)}
  }

  /// The token's own identifier, for a holder that revokes one.
  fn withTokenId(self: &Self, jti: Str) -> Self {
    JwtClaims{..*self, tokenId: Some(jti)}
  }

  /// One claim of the caller's own, replacing any claim already under that
  /// name so a token cannot carry two answers for one question.
  fn withClaim(self: &Self, key: Str, value: Str) -> Self {
    var updated: Array[(Str, Str)] = []
    for pair in self.custom {
      if pair[0] != key { updated = updated.push(pair) }
    }
    JwtClaims{..*self, custom: updated.push((key, value))}
  }

  /// The second the token stops being good, counted from a second the caller
  /// supplies rather than from a clock this reaches for itself.
  fn expiresIn(self: &Self, durationSeconds: Int, nowSeconds: Int) -> Self {
    JwtClaims{..*self, expiresAt: Some(nowSeconds + durationSeconds)}
  }
}

/// Checks whether claims indicate the token has expired relative to a timestamp and leeway.
export fn hasExpired(c: &JwtClaims, nowSeconds: Int, leewaySeconds: Int) -> Bool {
  match c.expiresAt {
    case Some(exp) => nowSeconds >= exp + leewaySeconds
    case None => false
  }
}

/// Checks whether claims are active and valid (neither premature nor expired).
export fn isValidAt(c: &JwtClaims, nowSeconds: Int, leewaySeconds: Int) -> Bool {
  if hasExpired(c, nowSeconds, leewaySeconds) { return false }
  match c.notBefore {
    case Some(nbf) => nowSeconds + leewaySeconds >= nbf
    case None => true
  }
}

/// Constructs default validation rules with zero leeway and no mandatory issuer or audience.
export fn validation() -> JwtValidation {
  JwtValidation {
    expectedIssuer: None,
    expectedAudience: None,
    leewaySeconds: 0,
  }
}

/// Retrieves a claim by name from registered or custom claims.
export fn getClaim(c: &JwtClaims, key: Str) -> Option[Str] {
  if key == "sub" { return c.subject }
  if key == "iss" { return c.issuer }
  if key == "aud" { return c.audience }
  if key == "jti" { return c.tokenId }
  for pair in c.custom {
    if pair[0] == key {
      return Some(pair[1])
    }
  }
  None
}

/// A check with one expectation set, each answering the check rather than
/// taking it apart.
export trait Checking {
  fn requireIssuer(self: &Self, iss: Str) -> Self
  fn requireAudience(self: &Self, aud: Str) -> Self
  fn withLeeway(self: &Self, seconds: Int) -> Self
}

impl Checking for JwtValidation {
  /// The issuer a token must name.
  fn requireIssuer(self: &Self, iss: Str) -> Self {
    JwtValidation{..*self, expectedIssuer: Some(iss)}
  }

  /// The audience a token must name.
  fn requireAudience(self: &Self, aud: Str) -> Self {
    JwtValidation{..*self, expectedAudience: Some(aud)}
  }

  /// How far apart two clocks may be before a token is refused for the time
  /// rather than for what it says.
  fn withLeeway(self: &Self, seconds: Int) -> Self {
    JwtValidation{..*self, leewaySeconds: seconds}
  }
}

/// Serializes and signs claims into an RFC 7519 HS256 compact JSON Web Token.
export fn encode(claimsPayload: &JwtClaims, secret: &Bytes) -> Str {
  let header = Json.object(&[("alg", Json.Text("HS256")), ("typ", Json.Text("JWT"))])
  let headerB64 = ByteSeq.encodeBase64Url(&Json.encode(&header).toBytes())

  var entries: Array[(Str, Json.Json)] = []
  entries = appendTextClaim(entries, "sub", claimsPayload.subject)
  entries = appendTextClaim(entries, "iss", claimsPayload.issuer)
  entries = appendTextClaim(entries, "aud", claimsPayload.audience)
  entries = appendIntClaim(entries, "exp", claimsPayload.expiresAt)
  entries = appendIntClaim(entries, "nbf", claimsPayload.notBefore)
  entries = appendIntClaim(entries, "iat", claimsPayload.issuedAt)
  entries = appendTextClaim(entries, "jti", claimsPayload.tokenId)
  for pair in claimsPayload.custom {
    if isCustomKey(pair[0]) { entries = entries.push((pair[0], Json.Text(pair[1]))) }
  }

  let payload = Json.object(&entries)
  let payloadB64 = ByteSeq.encodeBase64Url(&Json.encode(&payload).toBytes())

  let signingInput = headerB64 + "." + payloadB64
  let signatureBytes = hmacSha256Of(*secret, signingInput.toBytes())
  let signatureB64 = ByteSeq.encodeBase64Url(&signatureBytes)

  signingInput + "." + signatureB64
}

/// Decodes and cryptographically verifies an RFC 7519 compact JWT against secret and validation rules.
export fn decode(token: Str, secret: &Bytes, rule: &JwtValidation, nowSeconds: Int) -> Result[JwtClaims, JwtError] {
  if token.length() > 65536 || rule.leewaySeconds < 0 { return Err(MalformedToken) }
  let parts = token.split(".")
  if parts.length() != 3 {
    return Err(MalformedToken)
  }

  let headerB64 = parts[0]
  let payloadB64 = parts[1]
  let signatureB64 = parts[2]

  let _sigVerified = verifySignature(headerB64, payloadB64, signatureB64, secret) ?
  let _hdrVerified = verifyHeader(headerB64) ?

  let parsedClaims = decodePayloadClaims(payloadB64) ?
  match checkBounds(&parsedClaims, rule, nowSeconds) {
    case Some(err) => { return Err(err) }
    case None => {}
  }

  Ok(parsedClaims)
}

/// Decodes claims without cryptographic signature verification.
export fn decodeUnverified(token: Str) -> Result[JwtClaims, JwtError] {
  let parts = token.split(".")
  if parts.length() != 3 {
    return Err(MalformedToken)
  }
  decodePayloadClaims(parts[1])
}

/// A public key an identity provider publishes, and the algorithm it signs with.
///
/// A provider publishes its keys as numbers rather than as a file: a JWKS
/// carries an RSA key as a modulus and an exponent, and a curve key as the two
/// coordinates of a point, each base64url. So that is what this takes.
///
/// A key is named by `kid` because a provider holds several and rotates them;
/// a token says in its header which one signed it, and checking the wrong one
/// fails in a way that looks exactly like a forgery.
export type PublicKey
/// RSASSA-PKCS1-v1_5 over SHA-256 — `RS256`, what nearly every provider issues.
  = RsaKey(Str, Bytes, Bytes)
/// ECDSA on P-256 over SHA-256 — `ES256`.
  | EcdsaKey(Str, Bytes, Bytes)

/// The identifier a provider gave this key.
export fn keyId(key: &PublicKey) -> Str {
  match *key {
    case RsaKey(id, _, _) => id
    case EcdsaKey(id, _, _) => id
  }
}

/// The algorithm name that appears in a token's header for this key.
export fn keyAlgorithm(key: &PublicKey) -> Str {
  match *key {
    case RsaKey(_, _, _) => "RS256"
    case EcdsaKey(_, _, _) => "ES256"
  }
}

/// Verify a token signed with a provider's private key, and read its claims.
///
/// This is the direction a service that trusts an identity provider needs, and
/// the only one it needs: the provider signs, the service checks. Nothing here
/// can produce a token, which is the point of using a key pair rather than a
/// shared secret — a service that could sign could impersonate the provider.
///
/// The algorithm is taken from the key rather than from the token. A token
/// naming its own algorithm and being checked with it is the oldest hole in
/// this format: an attacker changes `RS256` to `HS256`, signs with the public
/// key as though it were a shared secret, and the token verifies. Here a
/// header that does not name the key's own algorithm is refused before
/// anything is computed.
export fn decodeWithKey(
  token: Str,
  key: &PublicKey,
  rule: &JwtValidation,
  nowSeconds: Int
) -> Result[JwtClaims, JwtError] {
  if token.length() > 65536 || rule.leewaySeconds < 0 { return Err(MalformedToken) }
  let parts = token.split(".")
  if parts.length() != 3 {
    return Err(MalformedToken)
  }
  let headerB64 = parts[0]
  let payloadB64 = parts[1]
  let signatureB64 = parts[2]

  let _hdrVerified = verifyAsymmetricHeader(headerB64, key) ?
  let signature = match ByteSeq.decodeBase64Url(signatureB64) {
    case Ok(raw) => raw
    case Err(_) => { return Err(MalformedToken) }
  }
  let signingInput = (headerB64 + "." + payloadB64).toBytes()
  let genuine = match *key {
    case RsaKey(_, modulus, exponent) =>
    verifyRsaSha256(modulus, exponent, signingInput, signature)
    case EcdsaKey(_, x, y) => verifyEcdsaSha256(x, y, signingInput, signature)
  }
  if !genuine {
    return Err(InvalidSignature)
  }

  let parsedClaims = decodePayloadClaims(payloadB64) ?
  match checkBounds(&parsedClaims, rule, nowSeconds) {
    case Some(err) => { return Err(err) }
    case None => {}
  }
  Ok(parsedClaims)
}

/// Which of a provider's keys a token says signed it.
///
/// Read before verifying, so a caller holding several keys picks the one to
/// check against. A token that names no key answers nothing, and a caller must
/// then decide for itself rather than being given a guess.
export fn tokenKeyId(token: Str) -> Option[Str] {
  let parts = token.split(".")
  if parts.length() != 3 {
    return None
  }
  match parseJsonSegment(parts[0]) {
    case Ok(header) => fieldText(&header, "kid")
    case Err(_) => None
  }
}

/// Pick the key a token names, out of the set a provider published.
export fn keyFor(keys: &Array[PublicKey], token: Str) -> Option[PublicKey] {
  let named = tokenKeyId(token) ?
  var index = 0
  while index < keys.length() {
    let candidate = keys[index]
    if keyId(&candidate) == named {
      return Some(candidate)
    }
    index = index + 1
  }
  None
}

fn verifyAsymmetricHeader(headerB64: Str, key: &PublicKey) -> Result[Bool, JwtError] {
  let headerJson = parseJsonSegment(headerB64) ?
  let fields = match Json.asObject(&headerJson) {
    case Some(entries) => entries
    case None => { return Err(MalformedToken) }
  }
  var seen: Set[Str] = setOf([])
  for field in fields {
    if seen.contains(field[0]) { return Err(MalformedToken) }
    seen = seen.insert(field[0])
    if field[0] == "crit" || field[0] == "b64" { return Err(UnsupportedAlgorithm) }
  }
  if fieldText(&headerJson, "alg") != Some(keyAlgorithm(key)) {
    return Err(UnsupportedAlgorithm)
  }
  Ok(true)
}

fn asMalformed[T](_err: T) -> JwtError {
  MalformedToken
}

fn asInvalidClaims[T](_err: T) -> JwtError {
  InvalidClaimsJson
}

fn verifySignature(headerB64: Str, payloadB64: Str, signatureB64: Str, secret: &Bytes) -> Result[Bool, JwtError] {
  let signingInput = headerB64 + "." + payloadB64
  let expectedSigBytes = hmacSha256Of(*secret, signingInput.toBytes())
  let expectedSigB64 = ByteSeq.encodeBase64Url(&expectedSigBytes)
  if !Crypto.secretsMatch(signatureB64, expectedSigB64) {
    return Err(InvalidSignature)
  }
  Ok(true)
}

fn verifyHeader(headerB64: Str) -> Result[Bool, JwtError] {
  let headerJson = parseJsonSegment(headerB64) ?
  let fields = match Json.asObject(&headerJson) {
    case Some(entries) => entries
    case None => { return Err(MalformedToken) }
  }
  var seen: Set[Str] = setOf([])
  for field in fields {
    if seen.contains(field[0]) { return Err(MalformedToken) }
    seen = seen.insert(field[0])
    if field[0] == "crit" || field[0] == "b64" { return Err(UnsupportedAlgorithm) }
  }
  if fieldText(&headerJson, "alg") != Some("HS256") {
    return Err(UnsupportedAlgorithm)
  }
  Ok(true)
}

fn decodePayloadClaims(payloadB64: Str) -> Result[JwtClaims, JwtError] {
  let payloadJson = parseJsonSegment(payloadB64) ?
  let subject = fieldText(&payloadJson, "sub")
  let issuer = fieldText(&payloadJson, "iss")
  let audience = fieldText(&payloadJson, "aud")
  let expiresAt = fieldInt(&payloadJson, "exp")
  let notBefore = fieldInt(&payloadJson, "nbf")
  let issuedAt = fieldInt(&payloadJson, "iat")
  let tokenId = fieldText(&payloadJson, "jti")

  var customEntries: Array[(Str, Str)] = []
  let entries = match Json.asObject(&payloadJson) {
    case Some(items) => items
    case None => { return Err(InvalidClaimsJson) }
  }

  var seen: Set[Str] = setOf([])
  for entry in entries {
    let key = entry[0]
    if seen.contains(key) { return Err(InvalidClaimsJson) }
    seen = seen.insert(key)
    if key == "exp" || key == "nbf" || key == "iat" {
      if let None = Json.asInt(&entry[1]) { return Err(InvalidClaimsJson) }
    }
    if key == "sub" || key == "iss" || key == "aud" || key == "jti" {
      if let None = Json.asText(&entry[1]) { return Err(InvalidClaimsJson) }
    }
    if isCustomKey(key) {
      match Json.asText(&entry[1]) {
        case Some(val) => { customEntries = customEntries.push((key, val)) }
        case None => {}
      }
    }
  }

  Ok(JwtClaims {
      subject: subject,
      issuer: issuer,
      audience: audience,
      expiresAt: expiresAt,
      notBefore: notBefore,
      issuedAt: issuedAt,
      tokenId: tokenId,
      custom: customEntries,
    })
}

fn parseJsonSegment(segmentB64: Str) -> Result[Json.Json, JwtError] {
  if segmentB64.isEmpty() { return Err(MalformedToken) }
  let bytes = Result.mapErr(ByteSeq.decodeBase64Url(segmentB64), asMalformed) ?
  if ByteSeq.encodeBase64Url(&bytes) != segmentB64 { return Err(MalformedToken) }
  let text = Result.mapErr(ByteSeq.toText(&bytes), asMalformed) ?
  Result.mapErr(Json.decode(text), asInvalidClaims)
}

fn checkBounds(c: &JwtClaims, rule: &JwtValidation, nowSeconds: Int) -> Option[JwtError] {
  if hasExpired(c, nowSeconds, rule.leewaySeconds) {
    return Some(ExpiredToken)
  }

  match c.notBefore {
    case Some(nbf) => {
      if nowSeconds + rule.leewaySeconds < nbf {
        return Some(TokenNotYetValid)
      }
    }
    case None => {}
  }

  match rule.expectedIssuer {
    case Some(expected) => {
      if c.issuer != Some(expected) {
        return Some(IssuerMismatch)
      }
    }
    case None => {}
  }

  match rule.expectedAudience {
    case Some(expected) => {
      if c.audience != Some(expected) {
        return Some(AudienceMismatch)
      }
    }
    case None => {}
  }

  None
}

fn fieldText(json: &Json.Json, key: Str) -> Option[Str] {
  let f = Json.field(json, key) ?
  Json.asText(&f)
}

fn fieldInt(json: &Json.Json, key: Str) -> Option[Int] {
  let f = Json.field(json, key) ?
  Json.asInt(&f)
}

fn isCustomKey(key: Str) -> Bool {
  key != "sub" && key != "iss" && key != "aud" && key != "exp" && key != "nbf" && key != "iat" && key != "jti"
}

fn appendTextClaim(entries: Array[(Str, Json.Json)], key: Str, value: Option[Str]) -> Array[(Str, Json.Json)] {
  match value {
    case Some(text) => entries.push((key, Json.Text(text)))
    case None => entries
  }
}

fn appendIntClaim(entries: Array[(Str, Json.Json)], key: Str, value: Option[Int]) -> Array[(Str, Json.Json)] {
  match value {
    case Some(num) => entries.push((key, Json.Number(num)))
    case None => entries
  }
}
