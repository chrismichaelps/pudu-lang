module Std.Test

import Std.Io as Io
import Std.Order {Eq}

/// Checks a suite has made, and the names of those that did not hold.
///
/// A suite counts what held and keeps the name of what did not, because a
/// count alone says a suite is wrong without saying where: "eleven of twelve"
/// sends a reader through the whole file, and "the empty target is refused"
/// sends them to a line.
export type Suite = { held: Int, failed: Array[Str] }

/// A suite that has checked nothing yet.
export fn suite() -> Suite { Suite{held: 0, failed: []} }

/// Record whether one thing held.
///
/// The name is given whether or not it holds, so the suite reads as a list of
/// what is being claimed rather than as a list of what went wrong.
export fn check(state: Suite, name: Str, holds: Bool) -> Suite {
  if holds {
    Suite{held: state.held + 1, failed: state.failed}
  } else {
    Suite{held: state.held, failed: state.failed.push(name)}
  }
}

/// Record that two values are the same, saying both when they are not.
///
/// What a reader needs from a check that did not hold is the pair, and a
/// comparison that reports only its own name makes them run the program again
/// to learn what it answered.
export fn same[T: Eq](state: Suite, name: Str, found: T, wanted: T) -> Suite {
  if found == wanted {
    check(state, name, true)
  } else {
    check(state, name + " (answered " + display(found) + ", wanted " + display(wanted) + ")", false)
  }
}

/// How many checks the suite has made, held or not.
export fn checked(state: &Suite) -> Int { state.held + state.failed.length() }

/// Whether every check held.
export fn passed(state: &Suite) -> Bool { state.failed.length() == 0 }

/// Close a suite and answer what `pudu test` reads.
///
/// A suite where everything held answers how many things did, and one where
/// something did not answers the negative of how many did not. The sign is
/// what carries the verdict: a count cannot say a suite failed, because the
/// number a failing suite reaches is a number a passing suite could also
/// reach, and a runner given only that has nothing to compare it against.
///
/// Names of checks that did not hold are written out before the number, since
/// the runner reports a verdict and the suite is the only place that knows
/// what was being claimed.
export fn done(state: &Suite) -> Int {
  if state.failed.length() == 0 {
    return state.held
  }
  for name in state.failed {
    match Io.writeLine("    did not hold: " + name) {
      case Ok(_) => {}
      case Err(_) => {}
    }
  }
  0 - state.failed.length()
}
