module Std.List

import Std.Num {Add, Mul, One, Zero}
import Std.Order {Ord}

/// Whether the array has no elements.
///
/// Asks the question directly instead of comparing `length` against nought. It
/// stops as soon as it knows, and it says at the call site what is being tested,
/// which a numeric comparison buried in a larger condition does not.
///
/// ## Examples
///
/// ```
/// List.isEmpty(&[])         // true
/// List.isEmpty(&[1, 2, 3])  // false
/// ```
///
/// ## See also
///
/// - `length` — how many elements, when the count itself is wanted.
export fn isEmpty[T](items: &Array[T]) -> Bool { items.length() == 0 }

/// The number of elements.
///
/// Counts the top level only. An array of arrays reports how many inner arrays it
/// holds, not how many values they contain between them; `flatten` first when the
/// total is what you are after.
///
/// ## Examples
///
/// ```
/// List.length(&[1, 2, 3])           // 3
/// List.length(&[[1, 2], [3]])       // 2
/// List.length(&List.flatten(&[[1, 2], [3]]))  // 3
/// ```
export fn length[T](items: &Array[T]) -> Int { items.length() }

/// The first element, or `None` for an empty array.
///
/// Nothing in `Std` is partial: this is why there is no `head` that panics. An
/// empty array is an ordinary value, not a mistake, so the caller decides what it
/// means rather than the library deciding by failing.
///
/// ## Examples
///
/// ```
/// List.first(&[10, 20, 30])  // Some(10)
/// List.first(&[])            // None
/// ```
///
/// ## See also
///
/// - `last` — the element at the other end.
/// - `rest` — everything `first` did not take.
export fn first[T](items: &Array[T]) -> Option[T] {
  if items.length() == 0 { None } else { Some(items[0]) }
}

/// The last element, or `None` for an empty array.
///
/// The mirror of `first`, and total for the same reason. A one-element array
/// answers the same value for both, which is worth remembering when the two are
/// used together to decide whether an array has been fully consumed.
///
/// ## Examples
///
/// ```
/// List.last(&[10, 20, 30])  // Some(30)
/// List.last(&[7])           // Some(7), and first answers Some(7) too
/// List.last(&[])            // None
/// ```
export fn last[T](items: &Array[T]) -> Option[T] {
  let size = items.length()
  if size == 0 { None } else { Some(items[size - 1]) }
}

/// The elements in reverse order.
///
/// The argument is borrowed and left as it was; the result is a new array.
/// Reversing twice gives back an array equal to the original, which makes this
/// safe to use as a temporary step inside a larger transformation.
///
/// ## Examples
///
/// ```
/// List.reversed(&[1, 2, 3])              // [3, 2, 1]
/// List.reversed(&List.reversed(&[1, 2]))  // [1, 2]
/// ```
export fn reversed[T](items: &Array[T]) -> Array[T] { items.reverse() }

/// One array followed by another.
///
/// Neither argument is changed. Joining many arrays one pair at a time copies the
/// growing left side on every round, so when you already hold all the pieces,
/// `flatten` does the same job in one pass.
///
/// ## Examples
///
/// ```
/// List.concat(&[1, 2], &[3])   // [1, 2, 3]
/// List.concat(&[], &[3])       // [3]
/// List.flatten(&[[1, 2], [3]])  // [1, 2, 3], preferred for many pieces
/// ```
export fn concat[T](left: &Array[T], right: &Array[T]) -> Array[T] {
  left.concat(*right)
}

/// The first `wanted` elements, or every element when the array is shorter.
///
/// Counts outside the array are pulled inside it: a negative count takes nothing
/// and a count past the end takes everything. That is deliberate, so a caller
/// slicing a page off a result never has to check the length first.
///
/// ## Examples
///
/// ```
/// List.take(&[1, 2, 3, 4], 2)   // [1, 2]
/// List.take(&[1, 2], 99)        // [1, 2]
/// List.take(&[1, 2], -1)        // []
/// ```
///
/// ## See also
///
/// - `drop` — the elements `take` left behind.
/// - `splitAt` — both halves at once.
export fn take[T](items: &Array[T], wanted: Int) -> Array[T] {
  items.slice(0, clampIndex(wanted, items.length()))
}

/// Every element after the first `skipped`.
///
/// The complement of `take` at the same position, with the same forgiving
/// treatment of counts outside the array: skipping more than it holds leaves it
/// empty, and a negative count skips nothing.
///
/// ## Examples
///
/// ```
/// List.drop(&[1, 2, 3, 4], 2)  // [3, 4]
/// List.drop(&[1, 2], 99)       // []
/// List.drop(&[1, 2], -1)       // [1, 2]
/// ```
export fn drop[T](items: &Array[T], skipped: Int) -> Array[T] {
  let size = items.length()
  items.slice(clampIndex(skipped, size), size)
}

/// The elements from `from` up to but not including `to`.
///
/// Both ends are pulled inside the array's bounds, so a range running past the end
/// is trimmed rather than refused. Excluding the upper end means neighbouring
/// slices laid end to end neither repeat nor skip an element.
///
/// ## Examples
///
/// ```
/// List.slice(&[1, 2, 3, 4], 1, 3)   // [2, 3]
/// List.slice(&[1, 2, 3, 4], 2, 99)  // [3, 4]
/// List.slice(&[1, 2, 3, 4], 3, 1)   // [], from is past to
/// ```
export fn slice[T](items: &Array[T], from: Int, to: Int) -> Array[T] {
  let size = items.length()
  items.slice(clampIndex(from, size), clampIndex(to, size))
}

/// Whether any element equals the given value.
///
/// Equality is structural, which is what the runtime compares; there is no `Eq`
/// bound to write until the language has one. Stops at the first match, so a hit
/// near the front costs little on a long array.
///
/// ## Examples
///
/// ```
/// List.contains(&[1, 2, 3], 2)  // true
/// List.contains(&[1, 2, 3], 9)  // false
/// ```
///
/// ## See also
///
/// - `indexOf` — where the match is, rather than whether there is one.
/// - `notContains` — the same test, negated for readability.
export fn contains[T](items: &Array[T], wanted: T) -> Bool {
  items.contains(wanted)
}

/// The position of the first element equal to the given value.
///
/// The runtime answers `-1` for absent; this is the form a caller can match on
/// without remembering which sentinel means absent. The position is valid against
/// the array that was asked, since any later change may move the element.
///
/// ## Examples
///
/// ```
/// List.indexOf(&[10, 20, 30], 20)  // Some(1)
/// List.indexOf(&[10, 20, 30], 99)  // None
/// ```
///
/// ## See also
///
/// - `indicesOf` — every position, not just the first.
/// - `findIndex` — the same question asked with a predicate.
export fn indexOf[T](items: &Array[T], wanted: T) -> Option[Int] {
  let found = items.indexOf(wanted)
  if found < 0 { None } else { Some(found) }
}

/// How many elements equal the given value.
///
/// Walks the whole array, since any element could match. This is the length that
/// `indicesOf` would report for the same value, without building the array of
/// positions.
///
/// ## Examples
///
/// ```
/// List.count(&[1, 2, 1, 3, 1], 1)  // 3
/// List.count(&[1, 2, 3], 9)        // 0
/// ```
///
/// ## See also
///
/// - `countWhere` — the same question asked with a predicate.
export fn count[T](items: &Array[T], wanted: T) -> Int {
  var total = 0
  for item in items {
    if item == wanted { total = total + 1 }
  }
  total
}

/// The sum of every element, or `None` for an empty array.
///
/// Generic over any type with an additive identity and an addition, which is every
/// integer width and both floating widths. Elements are added left to right, so a
/// floating-point total follows that order and is reproducible for a given array.
///
/// The `None` marks a genuine absence rather than claiming nought was the total.
/// Reach for `sumOr` when nought is the right answer for nothing.
///
/// ## Examples
///
/// ```
/// List.sum(&[1, 2, 3])  // Some(6)
/// List.sum(&[])         // None
/// ```
export fn sum[T: Zero + Add](items: &Array[T]) -> Option[T] {
  if items.length() == 0 { None } else {
    var running = items[0].zero()
    for item in items { running = running.plus(&item) }
    Some(running)
  }
}

/// Every element added together, with a caller-supplied value for empty.
///
/// The form to reach for when nought is the right answer for nothing; `sum` keeps
/// the distinction for callers that need it. Passing the type's own nought makes
/// this behave the way a running total usually should.
///
/// ## Examples
///
/// ```
/// List.sumOr(&[1, 2, 3], 0)  // 6
/// List.sumOr(&[], 0)         // 0
/// ```
export fn sumOr[T: Zero + Add](items: &Array[T], empty: T) -> T {
  match sum(items) {
    case Some(found) => found
    case None => empty
  }
}

/// The product of every element, or `None` for an empty array.
///
/// Multiplies left to right starting from the type's multiplicative identity. A
/// single nought anywhere in the array carries through to the result, and integer
/// widths wrap according to their own rules rather than widening.
///
/// ## Examples
///
/// ```
/// List.product(&[2, 3, 4])  // Some(24)
/// List.product(&[2, 0, 4])  // Some(0)
/// List.product(&[])         // None
/// ```
export fn product[T: One + Mul](items: &Array[T]) -> Option[T] {
  if items.length() == 0 { None } else {
    var running = items[0].one()
    for item in items { running = running.times(&item) }
    Some(running)
  }
}

/// Every element multiplied together, with a caller-supplied value for empty.
///
/// One is the usual value to pass, since multiplying by it later leaves the result
/// unchanged — the same reasoning that makes nought the usual value for `sumOr`.
///
/// ## Examples
///
/// ```
/// List.productOr(&[2, 3], 1)  // 6
/// List.productOr(&[], 1)      // 1
/// ```
export fn productOr[T: One + Mul](items: &Array[T], empty: T) -> T {
  match product(items) {
    case Some(found) => found
    case None => empty
  }
}

/// The smallest element, or `None` for an empty array.
///
/// Uses the type's own ordering. Among equal smallest elements the earliest is
/// kept, which matters when the elements carry more than the part being compared
/// and you need to know which one you got.
///
/// ## Examples
///
/// ```
/// List.minimum(&[3, 1, 2])  // Some(1)
/// List.minimum(&[])         // None
/// ```
///
/// ## See also
///
/// - `minimumBy` — an ordering the type does not supply itself.
/// - `minimumOn` — ordering by a key drawn from each element.
export fn minimum[T: Ord](items: &Array[T]) -> Option[T] {
  if items.length() == 0 { None } else {
    var best = items[0]
    for item in items {
      if item.before(&best) { best = item }
    }
    Some(best)
  }
}

/// The largest element, or `None` for an empty array.
///
/// Among equal largest elements the earliest is kept, matching `minimum`, so
/// sorting by the same ordering puts the two answers at the two ends of the
/// result.
///
/// ## Examples
///
/// ```
/// List.maximum(&[3, 1, 2])  // Some(3)
/// List.maximum(&[])         // None
/// ```
export fn maximum[T: Ord](items: &Array[T]) -> Option[T] {
  if items.length() == 0 { None } else {
    var best = items[0]
    for item in items {
      if best.before(&item) { best = item }
    }
    Some(best)
  }
}

/// Every element transformed.
///
/// The result has the same length and the same order as the input, and the
/// transform runs exactly once per element. The input is borrowed and left as it
/// was, so the original remains available to the caller.
///
/// When the transform needs to drop or expand elements rather than replace them
/// one for one, `filter` and `flatMap` are the functions that can.
///
/// ## Examples
///
/// ```
/// List.map(&[1, 2, 3], fn(n: Int) -> Int => n * 2)   // [2, 4, 6]
/// List.map(&[1, 2], fn(n: Int) -> Str => show(n))    // ["1", "2"]
/// ```
export fn map[A, B](items: &Array[A], transform: fn(A) -> B) -> Array[B] {
  items.map(transform)
}

/// Every element the predicate accepts.
///
/// Order is preserved, and an array that accepts nothing gives an empty array
/// rather than `None` — filtering is not a search, so finding nothing is an
/// ordinary result.
///
/// ## Examples
///
/// ```
/// List.filter(&[1, 2, 3, 4], fn(n: Int) -> Bool => n % 2 == 0)  // [2, 4]
/// List.filter(&[1, 3], fn(n: Int) -> Bool => n % 2 == 0)        // []
/// ```
///
/// ## See also
///
/// - `partition` — the accepted and the rejected elements together.
/// - `find` — the first acceptable element rather than all of them.
export fn filter[T](items: &Array[T], keep: fn(T) -> Bool) -> Array[T] {
  items.filter(keep)
}

/// Combine every element into one, left to right.
///
/// `start` is both the answer for an empty array and the left argument of the
/// first step, which is what lets a fold over a joined array equal the fold of one
/// part continued into the other.
///
/// ## Examples
///
/// ```
/// List.fold(&[1, 2, 3], fn(total: Int, n: Int) -> Int => total + n, 0)  // 6
/// List.fold(&[], fn(total: Int, n: Int) -> Int => total + n, 0)         // 0
/// ```
///
/// ## See also
///
/// - `foldRight` — the same combination walked from the other end.
/// - `scan` — every running value, not only the last.
/// - `mapAccum` — a fold that also collects an output per step.
export fn fold[T, A](items: &Array[T], combine: fn(A, T) -> A, start: A) -> A {
  items.reduce(combine, start)
}

/// Whether every element satisfies the predicate. True for an empty array.
///
/// True for nothing is what makes `all` compose: joining two arrays answers true
/// exactly when both parts do, and that would fail if the empty array answered
/// false.
///
/// ## Examples
///
/// ```
/// List.all(&[2, 4], fn(n: Int) -> Bool => n % 2 == 0)  // true
/// List.all(&[2, 3], fn(n: Int) -> Bool => n % 2 == 0)  // false
/// List.all(&[], fn(n: Int) -> Bool => n % 2 == 0)      // true
/// ```
export fn all[T](items: &Array[T], holds: fn(T) -> Bool) -> Bool {
  items.filter(holds).length() == items.length()
}

/// Whether any element satisfies the predicate. False for an empty array.
///
/// The complement of `all` under a negated predicate. False for nothing is the
/// matching choice: joining two arrays answers true exactly when either part does,
/// which only holds if nothing answers false.
///
/// ## Examples
///
/// ```
/// List.any(&[1, 2, 3], fn(n: Int) -> Bool => n > 2)  // true
/// List.any(&[1, 2], fn(n: Int) -> Bool => n > 2)     // false
/// List.any(&[], fn(n: Int) -> Bool => n > 2)         // false
/// ```
///
/// ## See also
///
/// - `find` — the matching element itself rather than whether one exists.
/// - `countWhere` — how many match.
export fn any[T](items: &Array[T], holds: fn(T) -> Bool) -> Bool {
  items.filter(holds).length() > 0
}

/// The elements in ascending order, under the type's own ordering.
///
/// Merge sort: the input is halved with `slice` and rejoined with `concat`, both
/// of which the runtime does on the structure rather than by rebuilding.
///
/// The sort is stable — equal elements keep their original order — which is what
/// lets a compound ordering be built by sorting on the least significant key first
/// and the most significant key last.
///
/// ## Examples
///
/// ```
/// List.sorted(&[3, 1, 2])  // [1, 2, 3]
///
/// // Stable, so this orders by name within each age.
/// let byName = List.sortOn(&people, fn(p: Person) -> Str => p.name)
/// let byAge = List.sortOn(&byName, fn(p: Person) -> Int => p.age)
/// ```
///
/// ## See also
///
/// - `sortBy` — an ordering the type does not supply itself.
/// - `sortOn` — ordering by a key drawn from each element.
/// - `merge` — joining two already-sorted arrays without sorting again.
export fn sorted[T: Ord](items: &Array[T]) -> Array[T] {
  sortBy(items, fn(left: T, right: T) -> Bool => left.before(&right))
}

/// Two ascending arrays interleaved into one.
///
/// Exported because merging already-sorted input is worth doing without sorting it
/// again, which is the whole reason a merge sort has this step. When elements are
/// equal the left array's comes first, which keeps the operation stable.
///
/// Both inputs must already be ascending for the result to be; this does not check
/// and does not sort.
///
/// ## Examples
///
/// ```
/// List.merge(&[1, 3, 5], &[2, 4])  // [1, 2, 3, 4, 5]
/// List.merge(&[], &[2, 4])         // [2, 4]
/// ```
export fn merge[T: Ord](left: &Array[T], right: &Array[T]) -> Array[T] {
  mergeBy(left, right, fn(a: T, b: T) -> Bool => a.before(&b))
}

/// Every element but the first, or an empty array when there is none.
/// Named for what it is rather than for the position it drops, because the partial
/// version other languages call `tail` is not offered here at all.
export fn rest[T](items: &Array[T]) -> Array[T] {
  items.slice(1, items.length())
}

/// Every element but the last, or an empty array when there is none.
/// The mirror of `rest`. Pairing it with `last` walks an array from the end the way
/// `first` and `rest` walk it from the start.
export fn initial[T](items: &Array[T]) -> Array[T] {
  let size = items.length()
  if size == 0 { items.slice(0, 0) } else { items.slice(0, size - 1) }
}

/// The array split at a position: the first `at` elements, then the rest.
/// The two parts always rejoin to the original. A position outside the array puts
/// everything in one side and leaves the other empty.
export fn splitAt[T](items: &Array[T], position: Int) -> (Array[T], Array[T]) {
  (take(items, position), drop(items, position))
}

/// The longest leading run of elements the predicate accepts.
/// Stops at the first element it rejects and ignores everything after, so a later
/// accepted element is not collected. `filter` is the function that does collect it.
export fn takeWhile[T](items: &Array[T], holds: fn(T) -> Bool) -> Array[T] {
  items.slice(0, prefixLength(items, holds))
}

/// Everything after the longest leading run the predicate accepts.
/// Stops discarding at the first rejected element, so the result begins with that
/// element even if later ones would also be accepted.
export fn dropWhile[T](items: &Array[T], holds: fn(T) -> Bool) -> Array[T] {
  items.slice(prefixLength(items, holds), items.length())
}

/// The longest leading run the predicate accepts, and the rest.
/// `takeWhile` and `dropWhile` in one pass, which is worth having when the predicate
/// is expensive or the boundary is wanted along with both sides.
export fn span[T](items: &Array[T], holds: fn(T) -> Bool) -> (Array[T], Array[T]) {
  let boundary = prefixLength(items, holds)
  (items.slice(0, boundary), items.slice(boundary, items.length()))
}

/// The longest leading run the predicate *rejects*, and the rest.
/// This is `span` with the predicate negated: `span` keeps while it holds, and this
/// one keeps until it does. Useful for cutting at the first delimiter.
export fn breakWhen[T](items: &Array[T], holds: fn(T) -> Bool) -> (Array[T], Array[T]) {
  var boundary = 0
  let size = items.length()
  while boundary < size && !holds(items[boundary]) { boundary = boundary + 1 }
  (items.slice(0, boundary), items.slice(boundary, size))
}

/// The elements the predicate accepts, and the elements it rejects.
/// Every element lands in exactly one side and the original order is kept in both, so
/// rejoining the two sides recovers a permutation of the input.
export fn partition[T](items: &Array[T], keep: fn(T) -> Bool) -> (Array[T], Array[T]) {
  var kept = []
  var rejected = []
  for item in items {
    if keep(item) { kept = kept.push(item) } else { rejected = rejected.push(item) }
  }
  (kept, rejected)
}

/// The first element the predicate accepts, or `None`.
/// Stops at the first match. When the position matters rather than the value, ask
/// `findIndex` instead of searching the result again.
export fn find[T](items: &Array[T], holds: fn(T) -> Bool) -> Option[T] {
  for item in items {
    if holds(item) { return Some(item) }
  }
  None
}

/// The position of the first element the predicate accepts, or `None`.
/// Stops at the first match. The position stays valid only against the array it was
/// asked about, since any change may move the element.
export fn findIndex[T](items: &Array[T], holds: fn(T) -> Bool) -> Option[Int] {
  var index = 0
  let size = items.length()
  while index < size {
    if holds(items[index]) { return Some(index) }
    index = index + 1
  }
  None
}

/// Every position whose element the predicate accepts.
/// Walks the whole array and returns the positions in ascending order. An empty result
/// means nothing matched.
export fn findIndices[T](items: &Array[T], holds: fn(T) -> Bool) -> Array[Int] {
  var out = []
  var index = 0
  let size = items.length()
  while index < size {
    if holds(items[index]) { out = out.push(index) }
    index = index + 1
  }
  out
}

/// Every position holding the given value.
/// The plural of `indexOf`, in ascending order. Its length is what `count` reports for
/// the same value.
export fn indicesOf[T](items: &Array[T], wanted: T) -> Array[Int] {
  var out = []
  var index = 0
  let size = items.length()
  while index < size {
    if items[index] == wanted { out = out.push(index) }
    index = index + 1
  }
  out
}

/// Whether one array begins with another.
/// An empty prefix is a prefix of everything, and a prefix longer than the array is a
/// prefix of nothing.
export fn isPrefixOf[T](prefix: &Array[T], items: &Array[T]) -> Bool {
  let size = prefix.length()
  if size > items.length() { false } else { items.slice(0, size) == *prefix }
}

/// Whether one array ends with another.
/// The mirror of `isPrefixOf`, with the same answers for the empty and over-long cases.
export fn isSuffixOf[T](suffix: &Array[T], items: &Array[T]) -> Bool {
  let size = suffix.length()
  let total = items.length()
  if size > total { false } else { items.slice(total - size, total) == *suffix }
}

/// The remainder after a prefix, or `None` when the prefix is not there.
/// The `None` separates "the prefix was absent" from "the remainder was empty", which
/// a length check alone cannot tell apart.
export fn stripPrefix[T](prefix: &Array[T], items: &Array[T]) -> Option[Array[T]] {
  if isPrefixOf(prefix, items) {
    Some(items.slice(prefix.length(), items.length()))
  } else {
    None
  }
}

/// A separator placed between every pair of elements.
/// Nothing is added before the first element or after the last, so an array of one is
/// returned unchanged and an empty array stays empty.
export fn intersperse[T](items: &Array[T], separator: T) -> Array[T] {
  var out = []
  var index = 0
  let size = items.length()
  while index < size {
    if index > 0 { out = out.push(separator) }
    out = out.push(items[index])
    index = index + 1
  }
  out
}

/// Every array joined end to end.
/// Removes one level of nesting only. An array of arrays of arrays comes back as an
/// array of arrays.
export fn flatten[T](groups: &Array[Array[T]]) -> Array[T] {
  var out = []
  for members in groups { out = out.concat(members) }
  out
}

/// Every array joined with a separator array between them.
/// `intersperse` for whole arrays rather than single elements, and the operation behind
/// joining text with a delimiter.
export fn intercalate[T](groups: &Array[Array[T]], separator: &Array[T]) -> Array[T] {
  var out = []
  var index = 0
  let size = groups.length()
  while index < size {
    if index > 0 { out = out.concat(*separator) }
    out = out.concat(groups[index])
    index = index + 1
  }
  out
}

/// Every element transformed into an array, and those arrays joined.
/// The transform may answer an empty array to drop an element or a longer one to expand
/// it, which is what `map` on its own cannot do.
export fn flatMap[A, B](items: &Array[A], transform: fn(A) -> Array[B]) -> Array[B] {
  flatten(&items.map(transform))
}

/// Runs of adjacent equal elements.
/// Adjacent, not equal overall: an unsorted array gives several runs of the same value.
/// Sort first when the intent is to gather every occurrence together.
export fn group[T](items: &Array[T]) -> Array[Array[T]] {
  var out = []
  var current = []
  for item in items {
    if current.length() == 0 || current[0] == item {
      current = current.push(item)
    } else {
      out = out.push(current)
      current = [item]
    }
  }
  if current.length() > 0 { out = out.push(current) }
  out
}

/// The elements with later duplicates removed, keeping the first of each.
/// Order is the order of first appearance, not sorted order. Each element is compared
/// against the ones already kept.
export fn distinct[T](items: &Array[T]) -> Array[T] {
  var out = []
  for item in items {
    if !out.contains(item) { out = out.push(item) }
  }
  out
}

/// The array with the first element equal to the given value removed.
/// Only the first. An array that does not hold the value comes back unchanged rather
/// than reporting that nothing was removed.
export fn removeFirst[T](items: &Array[T], unwanted: T) -> Array[T] {
  let found = items.indexOf(unwanted)
  if found < 0 { items.slice(0, items.length()) } else { items.remove(found) }
}

/// Every element of the first array that is not in the second.
/// Duplicates in the first array are each kept or each dropped together, since
/// membership is decided per value rather than per occurrence.
export fn difference[T](left: &Array[T], right: &Array[T]) -> Array[T] {
  var out = []
  for item in left {
    if !right.contains(item) { out = out.push(item) }
  }
  out
}

/// The first array followed by the elements of the second it does not already hold.
/// Duplicates already inside the first array are left as they are; only the elements
/// contributed by the second are filtered.
export fn union[T](left: &Array[T], right: &Array[T]) -> Array[T] {
  var out = distinct(left)
  for item in right {
    if !out.contains(item) { out = out.push(item) }
  }
  out
}

/// Every element of the first array that is also in the second.
/// Order and duplicates follow the first array. The second array is consulted for
/// membership only.
export fn intersection[T](left: &Array[T], right: &Array[T]) -> Array[T] {
  var out = []
  for item in left {
    if right.contains(item) { out = out.push(item) }
  }
  out
}

/// Two arrays' corresponding elements paired, stopping at the shorter.
/// Stopping rather than padding means no value has to be invented for the missing side,
/// so the result is as long as the shorter input.
export fn zip[A, B](left: &Array[A], right: &Array[B]) -> Array[(A, B)] {
  var out = []
  var index = 0
  let size = if left.length() < right.length() { left.length() } else { right.length() }
  while index < size {
    out = out.push((left[index], right[index]))
    index = index + 1
  }
  out
}

/// Two arrays' corresponding elements combined, stopping at the shorter.
/// `zip` followed by `map` without building the pairs in between, which also lets the
/// combine step name its two arguments.
export fn zipWith[A, B, C](left: &Array[A], right: &Array[B], combine: fn(A, B) -> C) -> Array[C] {
  var out = []
  var index = 0
  let size = if left.length() < right.length() { left.length() } else { right.length() }
  while index < size {
    out = out.push(combine(left[index], right[index]))
    index = index + 1
  }
  out
}

/// Every element paired with its position.
/// Positions count from nought and match the array being enumerated, so they stay valid
/// for `get` and `set` against that same array.
export fn enumerate[T](items: &Array[T]) -> Array[(Int, T)] {
  var out = []
  var index = 0
  let size = items.length()
  while index < size {
    out = out.push((index, items[index]))
    index = index + 1
  }
  out
}

/// Pairs separated back into two arrays.
/// The inverse of `zip` for input that `zip` could have produced; both results have the
/// length of the input.
export fn unzip[A, B](pairs: &Array[(A, B)]) -> (Array[A], Array[B]) {
  var lefts = []
  var rights = []
  for pair in pairs {
    lefts = lefts.push(pair[0])
    rights = rights.push(pair[1])
  }
  (lefts, rights)
}

/// The value paired with the first matching key, or `None`.
/// An array of pairs searched left to right, which is worth using for a handful of
/// entries. A `Map` is the structure to reach for once the list grows.
export fn lookup[K, V](pairs: &Array[(K, V)], wanted: K) -> Option[V] {
  for pair in pairs {
    if pair[0] == wanted { return Some(pair[1]) }
  }
  None
}

/// One value repeated a number of times.
/// A count of nought or less gives an empty array. The same value is repeated, not
/// copied per position.
export fn replicate[T](times: Int, value: T) -> Array[T] {
  var out = []
  var remaining = times
  while remaining > 0 {
    out = out.push(value)
    remaining = remaining - 1
  }
  out
}

/// The whole numbers from `from` up to but not including `to`.
/// Excluding the upper end means the result's length is the difference between them,
/// and that ranges laid end to end do not repeat a number. A `to` at or below `from`
/// gives an empty array.
export fn range(from: Int, to: Int) -> Array[Int] {
  var out = []
  var current = from
  while current < to {
    out = out.push(current)
    current = current + 1
  }
  out
}

/// Repeated application of a function, starting from a seed.
/// The seed is the first element, so a count of one gives just the seed. The count is
/// required because a strict language cannot hold an endless sequence.
export fn iterate[T](times: Int, seed: T, step: fn(T) -> T) -> Array[T] {
  var out = []
  var current = seed
  var remaining = times
  while remaining > 0 {
    out = out.push(current)
    current = step(current)
    remaining = remaining - 1
  }
  out
}

/// Every running total, left to right, starting from `start`.
/// The result begins with `start` and ends with what `fold` would have answered, so it
/// is one longer than the input.
export fn scan[T, A](items: &Array[T], combine: fn(A, T) -> A, start: A) -> Array[A] {
  var out = [start]
  var accumulated = start
  for item in items {
    accumulated = combine(accumulated, item)
    out = out.push(accumulated)
  }
  out
}

/// Combine every element into one, right to left.
/// The direction matters for any step that is not associative: building a list by
/// prepending, or dividing, gives a different answer than `fold`.
export fn foldRight[T, A](items: &Array[T], combine: fn(T, A) -> A, start: A) -> A {
  var accumulated = start
  var index = items.length()
  while index > 0 {
    index = index - 1
    accumulated = combine(items[index], accumulated)
  }
  accumulated
}

/// Every prefix, shortest first, including the empty one and the whole array.
/// There are one more prefixes than elements, because both ends count.
export fn prefixes[T](items: &Array[T]) -> Array[Array[T]] {
  var out = []
  var index = 0
  let size = items.length()
  while index <= size {
    out = out.push(items.slice(0, index))
    index = index + 1
  }
  out
}

/// Every suffix, longest first, including the whole array and the empty one.
/// The mirror of `prefixes`, and the same count for the same reason.
export fn suffixes[T](items: &Array[T]) -> Array[Array[T]] {
  var out = []
  var index = 0
  let size = items.length()
  while index <= size {
    out = out.push(items.slice(index, size))
    index = index + 1
  }
  out
}

/// The elements ordered by a comparison, which answers whether the left one
/// belongs first. A comparison that is not a strict order gives an unspecified order
/// rather than a failure, which is the same promise every comparison sort makes.
/// Equal elements keep their original order.
export fn sortBy[T](items: &Array[T], before: fn(T, T) -> Bool) -> Array[T] {
  let size = items.length()
  if size <= 1 { items.slice(0, size) } else {
    let middle = size / 2
    let front = sortBy(&items.slice(0, middle), before)
    let back = sortBy(&items.slice(middle, size), before)
    mergeBy(&front, &back, before)
  }
}

/// Two arrays ordered by the same comparison interleaved into one.
/// Both inputs must already be in that order for the result to be. When elements
/// compare equal the left array's comes first.
export fn mergeBy[T](left: &Array[T], right: &Array[T], before: fn(T, T) -> Bool) -> Array[T] {
  var out = []
  var leftIndex = 0
  var rightIndex = 0
  let leftCount = left.length()
  let rightCount = right.length()
  while leftIndex < leftCount && rightIndex < rightCount {
    if before(right[rightIndex], left[leftIndex]) {
      out = out.push(right[rightIndex])
      rightIndex = rightIndex + 1
    } else {
      out = out.push(left[leftIndex])
      leftIndex = leftIndex + 1
    }
  }
  out.concat(left.slice(leftIndex, leftCount)).concat(right.slice(rightIndex, rightCount))
}

/// The element a comparison ranks first, or `None` for an empty array.
/// Among elements the comparison calls equal the earliest is kept, matching `minimum`.
export fn minimumBy[T](items: &Array[T], before: fn(T, T) -> Bool) -> Option[T] {
  if items.length() == 0 { None } else {
    var best = items[0]
    for item in items {
      if before(item, best) { best = item }
    }
    Some(best)
  }
}

/// The element a comparison ranks last, or `None` for an empty array.
/// Among elements the comparison calls equal the earliest is kept, matching `maximum`.
export fn maximumBy[T](items: &Array[T], before: fn(T, T) -> Bool) -> Option[T] {
  if items.length() == 0 { None } else {
    var best = items[0]
    for item in items {
      if before(best, item) { best = item }
    }
    Some(best)
  }
}

/// How many elements the predicate accepts.
/// The length `filter` would have produced, without building the filtered array.
export fn countWhere[T](items: &Array[T], holds: fn(T) -> Bool) -> Int {
  items.filter(holds).length()
}

/// The length of the longest leading run the predicate accepts.
fn prefixLength[T](items: &Array[T], holds: fn(T) -> Bool) -> Int {
  var scanned = 0
  let size = items.length()
  while scanned < size && holds(items[scanned]) { scanned = scanned + 1 }
  scanned
}

/// Whether no element equals the given value.
/// `contains` negated, written out because a negated call reads poorly inside a larger
/// condition.
export fn notContains[T](items: &Array[T], wanted: T) -> Bool {
  !items.contains(wanted)
}

/// Whether one array appears inside another as a contiguous run.
/// Contiguous: the elements must sit next to each other and in order. An empty needle
/// is inside everything.
export fn isInfixOf[T](needle: &Array[T], items: &Array[T]) -> Bool {
  let small = needle.length()
  let large = items.length()
  if small == 0 { true } else {
    var start = 0
    while start + small <= large {
      if items.slice(start, start + small) == *needle { return true }
      start = start + 1
    }
    false
  }
}

/// The remainder before a suffix, or `None` when the suffix is not there.
/// The mirror of `stripPrefix`, and `None` for the same reason: an absent suffix and an
/// empty remainder are different answers.
export fn stripSuffix[T](suffix: &Array[T], items: &Array[T]) -> Option[Array[T]] {
  if isSuffixOf(suffix, items) {
    Some(items.slice(0, items.length() - suffix.length()))
  } else {
    None
  }
}

/// The array with trailing elements the predicate accepts removed.
/// Works from the end and stops at the first rejected element, which is what trimming
/// trailing whitespace from a sequence needs.
export fn dropWhileEnd[T](items: &Array[T], holds: fn(T) -> Bool) -> Array[T] {
  var size = items.length()
  while size > 0 && holds(items[size - 1]) { size = size - 1 }
  items.slice(0, size)
}

/// The last `wanted` elements, or every element when the array is shorter.
/// `take` measured from the other end, with the same forgiving treatment of counts
/// outside the array.
export fn takeEnd[T](items: &Array[T], wanted: Int) -> Array[T] {
  let size = items.length()
  items.slice(clampIndex(size - wanted, size), size)
}

/// Every element but the last `skipped`.
/// `drop` measured from the other end. Skipping more than the array holds leaves it
/// empty.
export fn dropEnd[T](items: &Array[T], skipped: Int) -> Array[T] {
  let size = items.length()
  items.slice(0, clampIndex(size - skipped, size))
}

/// The rows and columns exchanged. Rows of unequal length contribute only the
/// positions they have, so no element is invented to fill a gap. Applying it twice to
/// ragged input does not always give back the original.
export fn transpose[T](rows: &Array[Array[T]]) -> Array[Array[T]] {
  var longest = 0
  for row in rows {
    if row.length() > longest { longest = row.length() }
  }
  var out = []
  var column = 0
  while column < longest {
    var gathered = []
    for row in rows {
      if column < row.length() { gathered = gathered.push(row[column]) }
    }
    out = out.push(gathered)
    column = column + 1
  }
  out
}

/// Every subsequence, including the empty one and the whole array.
/// The count doubles with each element, so this is for small inputs by nature rather
/// than by choice. Elements keep their relative order in every result.
export fn subsequences[T](items: &Array[T]) -> Array[Array[T]] {
  var out = [[]]
  for item in items {
    var grown = out
    for existing in out { grown = grown.push(existing.push(item)) }
    out = grown
  }
  out
}

/// Every ordering of the elements. The count is the factorial of the length,
/// so this is for small inputs by nature rather than by choice. Repeated elements
/// produce repeated orderings, since positions are permuted rather than values.
export fn permutations[T](items: &Array[T]) -> Array[Array[T]] {
  let size = items.length()
  if size == 0 { [[]] } else {
    var out = []
    var index = 0
    while index < size {
      let chosen = items[index]
      let others = items.slice(0, index).concat(items.slice(index + 1, size))
      for tail in permutations(&others) {
        out = out.push([chosen].concat(tail))
      }
      index = index + 1
    }
    out
  }
}

/// An array grown from a seed until the step answers `None`.
/// The step count is bounded because a strict language cannot recover from a step that
/// never stops; exhausting the bound answers with what it had. The opposite direction
/// from `fold`: one value in, many out.
export fn unfold[S, T](limit: Int, seed: S, step: fn(S) -> Option[(T, S)]) -> Array[T] {
  var out = []
  var current = seed
  var remaining = limit
  while remaining > 0 {
    match step(current) {
      case Some(pair) => {
        out = out.push(pair[0])
        current = pair[1]
      }
      case None => { return out }
    }
    remaining = remaining - 1
  }
  out
}

/// The array repeated end to end a number of times.
/// A count of nought or less gives an empty array, and repeating an empty array gives
/// an empty array whatever the count.
export fn cycle[T](items: &Array[T], times: Int) -> Array[T] {
  var out = []
  var remaining = times
  while remaining > 0 {
    out = out.concat(*items)
    remaining = remaining - 1
  }
  out
}

/// The array in pieces of at most `size` elements.
/// Only the final piece may be shorter. A size of nought or less gives no pieces rather
/// than an endless supply of empty ones.
export fn chunksOf[T](items: &Array[T], size: Int) -> Array[Array[T]] {
  var out = []
  if size <= 0 { out } else {
    var index = 0
    let total = items.length()
    while index < total {
      let end = if index + size > total { total } else { index + size }
      out = out.push(items.slice(index, end))
      index = index + size
    }
    out
  }
}

/// Every contiguous run of `size` elements, one position apart.
/// Nothing at all when the array is shorter than the window. Neighbouring windows
/// overlap, which is what comparing each element with the next needs.
export fn windows[T](items: &Array[T], size: Int) -> Array[Array[T]] {
  var out = []
  if size <= 0 { out } else {
    var start = 0
    let total = items.length()
    while start + size <= total {
      out = out.push(items.slice(start, start + size))
      start = start + 1
    }
    out
  }
}

/// A value placed into an array that is already in ascending order, keeping it
/// in order. Placed after equal elements, so repeated insertion is stable. An array
/// that was not in order to begin with is not put in order by this.
export fn insertOrdered[T: Ord](items: &Array[T], value: T) -> Array[T] {
  insertBy(items, value, fn(left: T, right: T) -> Bool => left.before(&right))
}

/// A value placed into an array ordered by a comparison, keeping it in order.
/// `insertOrdered` for an ordering the type does not supply itself, with the same
/// placement after equal elements.
export fn insertBy[T](items: &Array[T], value: T, before: fn(T, T) -> Bool) -> Array[T] {
  var position = 0
  let size = items.length()
  while position < size && !before(value, items[position]) { position = position + 1 }
  items.insert(position, value)
}

/// Runs of adjacent elements that a comparison calls equivalent.
/// Each element is compared against the first of the current run, so a comparison that
/// is not transitive gives runs that depend on where they started.
export fn groupBy[T](items: &Array[T], same: fn(T, T) -> Bool) -> Array[Array[T]] {
  var out = []
  var current = []
  for item in items {
    if current.length() == 0 || same(current[0], item) {
      current = current.push(item)
    } else {
      out = out.push(current)
      current = [item]
    }
  }
  if current.length() > 0 { out = out.push(current) }
  out
}

/// The elements with later duplicates removed under a comparison.
/// `distinct` for a notion of sameness the type does not supply itself, keeping the
/// first of each group in order of first appearance.
export fn distinctBy[T](items: &Array[T], same: fn(T, T) -> Bool) -> Array[T] {
  var out = []
  for item in items {
    var seen = false
    for kept in out {
      if same(kept, item) { seen = true }
    }
    if !seen { out = out.push(item) }
  }
  out
}

/// The elements ordered by a key drawn from each one.
/// The key may be of any ordered type, not only a number: sorting people by name is the
/// same operation as sorting them by age. Elements with equal keys keep their original
/// order.
export fn sortOn[T, K: Ord](items: &Array[T], key: fn(T) -> K) -> Array[T] {
  sortBy(items, fn(left: T, right: T) -> Bool => key(left).before(&key(right)))
}

/// The element whose key is smallest, or `None` for an empty array.
/// The element is returned, not the key. Among equal keys the earliest element wins.
export fn minimumOn[T, K: Ord](items: &Array[T], key: fn(T) -> K) -> Option[T] {
  minimumBy(items, fn(left: T, right: T) -> Bool => key(left).before(&key(right)))
}

/// The element whose key is largest, or `None` for an empty array.
/// The element is returned, not the key. Among equal keys the earliest element wins.
export fn maximumOn[T, K: Ord](items: &Array[T], key: fn(T) -> K) -> Option[T] {
  maximumBy(items, fn(left: T, right: T) -> Bool => key(left).before(&key(right)))
}

/// Every running total, from the right.
/// `scan` walked the other way, and one longer than the input for the same reason: both
/// ends are included.
export fn scanRight[T, A](items: &Array[T], combine: fn(T, A) -> A, start: A) -> Array[A] {
  var out = [start]
  var accumulated = start
  var index = items.length()
  while index > 0 {
    index = index - 1
    accumulated = combine(items[index], accumulated)
    out = [accumulated].concat(out)
  }
  out
}

/// A fold that also collects what each step produced, left to right.
/// Each step receives the running value and an element, and answers the next running
/// value together with one output. The final running value and every output are
/// returned.
export fn mapAccum[T, A, B](items: &Array[T], step: fn(A, T) -> (A, B), start: A) -> (A, Array[B]) {
  var accumulated = start
  var out = []
  for item in items {
    let stepped = step(accumulated, item)
    accumulated = stepped[0]
    out = out.push(stepped[1])
  }
  (accumulated, out)
}

/// Three arrays' corresponding elements gathered, stopping at the shortest.
/// Stopping rather than padding, the same choice `zip` makes for two.
export fn zip3[A, B, C](one: &Array[A], two: &Array[B], three: &Array[C]) -> Array[(A, B, C)] {
  var out = []
  var index = 0
  var size = one.length()
  if two.length() < size { size = two.length() }
  if three.length() < size { size = three.length() }
  while index < size {
    out = out.push((one[index], two[index], three[index]))
    index = index + 1
  }
  out
}

/// Three arrays' corresponding elements combined, stopping at the shortest.
/// `zip3` followed by `map` without building the triples in between.
export fn zipWith3[A, B, C, D](
  one: &Array[A],
  two: &Array[B],
  three: &Array[C],
  combine: fn(A, B, C) -> D
) -> Array[D] {
  var out = []
  var index = 0
  var size = one.length()
  if two.length() < size { size = two.length() }
  if three.length() < size { size = three.length() }
  while index < size {
    out = out.push(combine(one[index], two[index], three[index]))
    index = index + 1
  }
  out
}

/// Triples separated back into three arrays.
/// The inverse of `zip3` for input that `zip3` could have produced; all three results
/// have the length of the input.
export fn unzip3[A, B, C](triples: &Array[(A, B, C)]) -> (Array[A], Array[B], Array[C]) {
  var firsts = []
  var seconds = []
  var thirds = []
  for triple in triples {
    firsts = firsts.push(triple[0])
    seconds = seconds.push(triple[1])
    thirds = thirds.push(triple[2])
  }
  (firsts, seconds, thirds)
}

/// Every pairing of one array's elements with the other's.
/// The result's length is the two lengths multiplied. Ordered by the left array first,
/// so all pairs sharing a left element sit together.
export fn cartesian[A, B](left: &Array[A], right: &Array[B]) -> Array[(A, B)] {
  var out = []
  for leftItem in left {
    for rightItem in right { out = out.push((leftItem, rightItem)) }
  }
  out
}

/// The elements at the given positions, skipping positions the array lacks.
/// Positions may repeat and may be in any order; the result follows the positions given
/// rather than the array's own order.
export fn pick[T](items: &Array[T], positions: &Array[Int]) -> Array[T] {
  var out = []
  let size = items.length()
  for position in positions {
    if position >= 0 && position < size { out = out.push(items[position]) }
  }
  out
}

/// The element at a position, or `None` when there is none.
/// The bounds-checked read. Negative positions and positions past the end both answer
/// `None` rather than failing.
export fn get[T](items: &Array[T], position: Int) -> Option[T] {
  if position < 0 || position >= items.length() { None } else { Some(items[position]) }
}

/// The array with one position replaced, or unchanged when it has none.
/// A new array is returned and the original is left as it was. A position outside the
/// array is not an error and adds nothing.
export fn set[T](items: &Array[T], position: Int, value: T) -> Array[T] {
  if position < 0 || position >= items.length() { *items } else {
    items.remove(position).insert(position, value)
  }
}

/// The array with one position transformed, or unchanged when it has none.
/// `get` and `set` in one step, without the caller unwrapping the `Option` in between.
/// The transform does not run at all when the position is absent.
export fn modify[T](items: &Array[T], position: Int, transform: fn(T) -> T) -> Array[T] {
  if position < 0 || position >= items.length() { *items } else {
    set(items, position, transform(items[position]))
  }
}

/// Confine an index to the array's bounds, which is what every slice needs.
fn clampIndex(index: Int, limit: Int) -> Int {
  if index < 0 { 0 } else { if index > limit { limit } else { index } }
}
