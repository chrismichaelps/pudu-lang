/// A value with no bits set, of the same type as the example given.
///
/// The example fixes the type; its value is not used. That is how a generic caller
/// names a constant of a type it only has a value of.
///
/// ## Examples
///
/// ```
/// Bits.zero(&anyU8)  // 0u8
/// ```
export fn zero[T: Bits](example: &T) -> T { example.noBits() }

/// A value with every bit set, of the same type as the example given.
///
/// The complement of `zero`, and the full-width mask.
///
/// ## Examples
///
/// ```
/// Bits.ones(&anyU8)  // 255u8
/// ```
export fn ones[T: Bits](example: &T) -> T { example.noBits().bitNot() }

/// The bits moved toward the high end, with the ones that leave reappearing at the
/// low end.
///
/// Rotation is over the type's own width, so nothing is lost: rotating by the full
/// width gives back the original. That is the difference from `shiftLeft`.
///
/// ## Examples
///
/// ```
/// Bits.rotateLeft(&0b1000_0001u8, 1)  // 0b0000_0011
/// ```
export fn rotateLeft[T: Bits](value: &T, places: Int) -> T {
  let size = value.width()
  let shift = ((places % size) + size) % size
  if shift == 0 { *value } else {
    value.shiftedLeft(shift).bitOr(&value.shiftedRight(size - shift).bitAnd(&lowMask(value, shift)))
  }
}

/// The bits moved toward the low end, with the ones that leave reappearing at the
/// high end.
///
/// The mirror of `rotateLeft`, and equally lossless.
///
/// ## Examples
///
/// ```
/// Bits.rotateRight(&0b0000_0011u8, 1)  // 0b1000_0001
/// ```
export fn rotateRight[T: Bits](value: &T, places: Int) -> T {
  let size = value.width()
  rotateLeft(value, size - (((places % size) + size) % size))
}

/// The value with its low `keep` bits kept and the rest cleared.
///
/// The operation behind reading a field packed into the low end of a word. A count
/// at or past the width keeps everything.
///
/// ## Examples
///
/// ```
/// Bits.mask(&0b1111, 2)  // 0b0011
/// ```
export fn mask[T: Bits](value: &T, keep: Int) -> T {
  if keep <= 0 { value.noBits() } else {
    if keep >= value.width() { *value } else { value.bitAnd(&lowMask(value, keep)) }
  }
}

/// The bits at positions `from` up to but not including `to`, moved down.
///
/// A shift and a mask in one step, which is how a field packed anywhere in a word is
/// read. Excluding the upper position makes the field's width the difference
/// between the two bounds.
///
/// ## Examples
///
/// ```
/// Bits.extract(&0b1101_0000, 4, 8)  // 0b1101
/// ```
export fn extract[T: Bits](value: &T, from: Int, to: Int) -> T {
  if to <= from { value.noBits() } else { mask(&value.shiftedRight(from), to - from) }
}

/// Whether a value has exactly one bit set, which is what a power of two is.
/// Nought has none; a negative value has its sign bit, so it never has one.
export fn isSingleBit[T: Bits](value: &T) -> Bool { popCount(value) == 1 }

/// The smallest power of two that is not below the value.
/// A value at or below one answers with one, the smallest power of two there
/// is. A value whose next power does not fit the type answers with the largest
/// power that does, because there is no other value it could name.
export fn nextPowerOfTwo[T: Bits](value: &T) -> T {
  match highestSetBit(value) {
    case None => value.lowBit()
    case Some(top) => {
      if isSingleBit(value) { *value } else {
        if top + 1 >= value.width() { value.lowBit().shiftedLeft(value.width() - 1) }
          else { value.lowBit().shiftedLeft(top + 1) }
      }
    }
  }
}

/// A value with its low `count` bits set, of the same type as the example.
fn lowMask[T: Bits](example: &T, count: Int) -> T {
  var out = example.noBits()
  var position = 0
  while position < count && position < example.width() {
    out = out.bitOr(&example.lowBit().shiftedLeft(position))
    position = position + 1
  }
  out
}
