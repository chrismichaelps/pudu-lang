module Std.Bits

/// A type whose values are bit patterns.
///
/// `width` comes from the type rather than being assumed. This module used to
/// say "the low sixty-four positions" while taking an `Int`, whose width is the
/// target's; a value now answers for its own. `BigInt` has no implementation,
/// because it has no width and every operation here needs one.
export trait Bits {
  fn width(self: &Self) -> Int
  fn noBits(self: &Self) -> Self
  fn lowBit(self: &Self) -> Self
  fn bitAnd(self: &Self, other: &Self) -> Self
  fn bitOr(self: &Self, other: &Self) -> Self
  fn bitXor(self: &Self, other: &Self) -> Self
  fn bitNot(self: &Self) -> Self
  fn shiftedLeft(self: &Self, places: Int) -> Self
  fn shiftedRight(self: &Self, places: Int) -> Self
}

/// Both values' bits, kept where both are set.
export fn and[T: Bits](left: &T, right: &T) -> T { left.bitAnd(right) }

/// Both values' bits, kept where either is set.
export fn or[T: Bits](left: &T, right: &T) -> T { left.bitOr(right) }

/// Both values' bits, kept where exactly one is set.
export fn xor[T: Bits](left: &T, right: &T) -> T { left.bitXor(right) }

/// Every bit inverted, over the type's own width.
export fn complement[T: Bits](value: &T) -> T { value.bitNot() }

/// The bits moved toward the high end, filling with noughts.
/// A count that is negative or not below the width has no defined answer and is
/// refused by the operator itself.
export fn shiftLeft[T: Bits](value: &T, places: Int) -> T { value.shiftedLeft(places) }

/// The bits moved toward the low end. A signed type keeps its sign; an unsigned
/// one brings in noughts.
export fn shiftRight[T: Bits](value: &T, places: Int) -> T { value.shiftedRight(places) }

/// How many bits a value's type has.
export fn width[T: Bits](value: &T) -> Int { value.width() }

/// A value with only the bit at a position set, or nought when the position is
/// outside the type.
export fn bit[T: Bits](example: &T, position: Int) -> T {
  if position < 0 || position >= example.width() { example.noBits() }
    else { example.lowBit().shiftedLeft(position) }
}

/// Whether the bit at a position is set. A position outside the type is not.
export fn testBit[T: Bits](value: &T, position: Int) -> Bool {
  if position < 0 || position >= value.width() { false }
    else { value.shiftedRight(position).bitAnd(&value.lowBit()) == value.lowBit() }
}

/// The value with one bit set.
export fn setBit[T: Bits](value: &T, position: Int) -> T {
  value.bitOr(&bit(value, position))
}

/// The value with one bit cleared.
export fn clearBit[T: Bits](value: &T, position: Int) -> T {
  if position < 0 || position >= value.width() { *value }
    else { value.bitAnd(&bit(value, position).bitNot()) }
}

/// The value with one bit inverted.
export fn flipBit[T: Bits](value: &T, position: Int) -> T {
  value.bitXor(&bit(value, position))
}

/// How many bits are set, counted over the type's own width.
export fn popCount[T: Bits](value: &T) -> Int {
  var total = 0
  var position = 0
  let size = value.width()
  while position < size {
    if testBit(value, position) { total = total + 1 }
    position = position + 1
  }
  total
}

/// The position of the lowest set bit, or `None` when no bit is set.
export fn lowestSetBit[T: Bits](value: &T) -> Option[Int] {
  var position = 0
  let size = value.width()
  while position < size {
    if testBit(value, position) { return Some(position) }
    position = position + 1
  }
  None
}

/// The position of the highest set bit, or `None` when no bit is set.
export fn highestSetBit[T: Bits](value: &T) -> Option[Int] {
  var position = value.width() - 1
  while position >= 0 {
    if testBit(value, position) { return Some(position) }
    position = position - 1
  }
  None
}

/// How many high positions are clear before the first set bit. A value with no
/// bits set has the whole width.
export fn countLeadingZeros[T: Bits](value: &T) -> Int {
  match highestSetBit(value) {
    case Some(position) => value.width() - 1 - position
    case None => value.width()
  }
}

/// How many low positions are clear before the first set bit.
export fn countTrailingZeros[T: Bits](value: &T) -> Int {
  match lowestSetBit(value) {
    case Some(position) => position
    case None => value.width()
  }
}

/// The bits of a value, lowest position first, over the type's own width.
export fn bits[T: Bits](value: &T) -> Array[Bool] {
  var out = []
  var position = 0
  let size = value.width()
  while position < size {
    out = out.push(testBit(value, position))
    position = position + 1
  }
  out
}

/// The value written in binary, without a sign or a prefix, over the type's own
/// width. Nought is a single nought rather than empty text.
export fn toBinary[T: Bits](value: &T) -> Str {
  match highestSetBit(value) {
    case None => "0"
    case Some(top) => {
      var out = ""
      var position = top
      while position >= 0 {
        if testBit(value, position) { out = out + "1" } else { out = out + "0" }
        position = position - 1
      }
      out
    }
  }
}

/// The value written in lower-case hexadecimal, without a prefix.
export fn toHex[T: Bits](value: &T) -> Str {
  let digits = "0123456789abcdef"
  match highestSetBit(value) {
    case None => "0"
    case Some(top) => {
      var out = ""
      var position = (top / 4) * 4
      while position >= 0 {
        var nibble = 0
        var offset = 3
        while offset >= 0 {
          nibble = nibble * 2
          if testBit(value, position + offset) { nibble = nibble + 1 }
          offset = offset - 1
        }
        out = out + digits.slice(nibble, nibble + 1)
        position = position - 4
      }
      out
    }
  }
}

/// One implementation per integer width, each reporting its own. `Int` and
/// `UInt` report the target's pointer width, which is the one place the target
/// shows through into the library.

impl Bits for Int {
  fn width(self: &Self) -> Int { 64 }
  fn noBits(self: &Self) -> Self { 0 }
  fn lowBit(self: &Self) -> Self { 1 }
  fn bitAnd(self: &Self, other: &Self) -> Self { (*self) & (*other) }
  fn bitOr(self: &Self, other: &Self) -> Self { (*self) | (*other) }
  fn bitXor(self: &Self, other: &Self) -> Self { (*self) ^ (*other) }
  fn bitNot(self: &Self) -> Self { ~(*self) }
  fn shiftedLeft(self: &Self, places: Int) -> Self { (*self) << places }
  fn shiftedRight(self: &Self, places: Int) -> Self { (*self) >> places }
}

impl Bits for Int8 {
  fn width(self: &Self) -> Int { 8 }
  fn noBits(self: &Self) -> Self { 0i8 }
  fn lowBit(self: &Self) -> Self { 1i8 }
  fn bitAnd(self: &Self, other: &Self) -> Self { (*self) & (*other) }
  fn bitOr(self: &Self, other: &Self) -> Self { (*self) | (*other) }
  fn bitXor(self: &Self, other: &Self) -> Self { (*self) ^ (*other) }
  fn bitNot(self: &Self) -> Self { ~(*self) }
  fn shiftedLeft(self: &Self, places: Int) -> Self { (*self) << places }
  fn shiftedRight(self: &Self, places: Int) -> Self { (*self) >> places }
}

