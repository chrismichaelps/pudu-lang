module Std.Math.Float

/// The mathematical constant pi (ratio of a circle's circumference to diameter).
export fn pi() -> Float {
  3.141592653589793
}

/// The circle constant tau (2 * pi, full turn in radians).
export fn tau() -> Float {
  6.283185307179586
}

/// Euler's number e (base of natural logarithms).
export fn e() -> Float {
  2.718281828459045
}

/// Natural logarithm of 2.
export fn ln2() -> Float {
  0.6931471805599453
}

/// Natural logarithm of 10.
export fn ln10() -> Float {
  2.302585092994046
}

/// Square root of 2.
export fn sqrt2() -> Float {
  1.4142135623730951
}

/// Machine epsilon for 64-bit IEEE-754 floating point (2^-52).
export fn epsilon() -> Float {
  0.0000000000000002220446049250313
}

/// The absolute value of a float.
export fn abs(x: Float) -> Float {
  if x < 0.0 { -x } else { x }
}

/// Confines a floating-point value to [lower, upper].
export fn clamp(value: Float, lower: Float, upper: Float) -> Float {
  if value < lower { lower } else if value > upper { upper } else { value }
}

/// Linearly interpolates between a and b by amount t.
export fn lerp(a: Float, b: Float, t: Float) -> Float {
  a + t * (b - a)
}

/// Converts an angle in degrees to radians.
export fn radians(deg: Float) -> Float {
  deg * (pi() / 180.0)
}

/// Converts an angle in radians to degrees.
export fn degrees(rad: Float) -> Float {
  rad * (180.0 / pi())
}

/// Produces a value with the magnitude of first argument and sign of second.
export fn copysign(magnitude: Float, sign: Float) -> Float {
  let m = abs(magnitude)
  if sign < 0.0 { -m } else { m }
}

/// Whether the value is IEEE-754 NaN.
export fn isNan(x: Float) -> Bool {
  x != x
}

/// Whether the value is positive or negative infinity.
export fn isInfinite(x: Float) -> Bool {
  x > 1.7976931348623157e308 || x < -1.7976931348623157e308
}

/// Whether the value is a valid finite real number (neither NaN nor infinite).
export fn isFinite(x: Float) -> Bool {
  !isNan(x) && !isInfinite(x)
}

/// Truncates the fractional part, rounding toward zero. Exact on every platform.
export fn trunc(x: Float) -> Float {
  floatTrunc(x)
}

/// Returns the fractional part of a float (x - trunc(x)).
export fn fract(x: Float) -> Float {
  x - floatTrunc(x)
}

/// The greatest integer float not greater than x. Exact on every platform.
export fn floor(x: Float) -> Float {
  floatFloor(x)
}

/// The smallest integer float not less than x. Exact on every platform.
export fn ceil(x: Float) -> Float {
  floatCeil(x)
}

/// Rounds half away from zero to nearest integer float. Exact on every platform.
export fn round(x: Float) -> Float {
  floatRound(x)
}

/// Correctly rounded square root; None for negative or NaN inputs. Keeps the sign of zero.
export fn sqrt(x: Float) -> Option[Float] {
  if x < 0.0 || isNan(x) { return None }
  Some(floatSqrt(x))
}

/// Correctly rounded fused multiply-add x * y + z, rounded once. Exact on every platform.
export fn fma(x: Float, y: Float, z: Float) -> Float {
  floatFma(x, y, z)
}

/// The binary64 encoding of x as an unsigned word; no numeric conversion occurs.
export fn toBits(x: Float) -> UInt64 {
  floatToBits(x)
}

/// The binary64 value an unsigned word encodes; the inverse of `toBits`.
export fn fromBits(bits: UInt64) -> Float {
  floatFromBits(bits)
}

/// The nearest Float64 to an integer, ties to even; exact when |value| <= 2^53.
export fn fromInt(value: Int) -> Float {
  floatFromInt(value)
}

/// The integer part of x, truncated toward zero; None for NaN, infinities or a value outside Int.
export fn toInt(x: Float) -> Option[Int] {
  floatToInt(x)
}

/// Cube root. Preserves negative sign.
export fn cbrt(x: Float) -> Float {
  floatCbrt(x)
}

/// Euclidean distance sqrt(x^2 + y^2) without intermediate overflow or underflow.
export fn hypot(x: Float, y: Float) -> Float {
  floatHypot(x, y)
}

/// Computes sine in radians.
export fn sin(x: Float) -> Float {
  floatSin(x)
}

/// Computes cosine in radians.
export fn cos(x: Float) -> Float {
  floatCos(x)
}

/// Computes tangent in radians.
export fn tan(x: Float) -> Float {
  floatTan(x)
}

/// Computes arc tangent in radians across (-pi/2, pi/2).
export fn atan(x: Float) -> Float {
  floatAtan(x)
}

/// Computes 4-quadrant arc tangent atan2(y, x).
export fn atan2(y: Float, x: Float) -> Float {
  floatAtan2(y, x)
}

/// Computes arc sine in radians. Returns None if |x| > 1.
export fn asin(x: Float) -> Option[Float] {
  if x < -1.0 || x > 1.0 || isNan(x) { return None }
  Some(floatAsin(x))
}

/// Computes arc cosine in radians. Returns None if |x| > 1.
export fn acos(x: Float) -> Option[Float] {
  if x < -1.0 || x > 1.0 || isNan(x) { return None }
  Some(floatAcos(x))
}

/// Computes e^x.
export fn exp(x: Float) -> Float {
  floatExp(x)
}

/// Natural logarithm ln(x). Returns None if x <= 0.
export fn ln(x: Float) -> Option[Float] {
  if x <= 0.0 || isNan(x) { return None }
  Some(floatLn(x))
}

/// Base-2 logarithm log2(x). Returns None if x <= 0.
export fn log2(x: Float) -> Option[Float] {
  if x <= 0.0 || isNan(x) { return None }
  Some(floatLog2(x))
}

/// Base-10 logarithm log10(x). Returns None if x <= 0.
export fn log10(x: Float) -> Option[Float] {
  if x <= 0.0 || isNan(x) { return None }
  Some(floatLog10(x))
}

/// Floating power base^exponent. Returns None for a NaN operand, a zero base with a
/// negative exponent, or a negative base with a non-integer exponent.
export fn powf(base: Float, exponent: Float) -> Option[Float] {
  if isNan(base) || isNan(exponent) { return None }
  if exponent == 0.0 { return Some(1.0) }
  if base == 0.0 && exponent < 0.0 { return None }
  if base < 0.0 && floatTrunc(exponent) != exponent { return None }
  Some(floatPow(base, exponent))
}

/// Hyperbolic sine (e^x - e^-x) / 2.
export fn sinh(x: Float) -> Float {
  floatSinh(x)
}

/// Hyperbolic cosine (e^x + e^-x) / 2.
export fn cosh(x: Float) -> Float {
  floatCosh(x)
}

/// Hyperbolic tangent (e^2x - 1) / (e^2x + 1).
export fn tanh(x: Float) -> Float {
  floatTanh(x)
}
