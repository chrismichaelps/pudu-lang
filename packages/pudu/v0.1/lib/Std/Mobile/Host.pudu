module Std.Mobile.Host

import Std.Mobile.View as View

/// The platform adapter: it applies one commit's instructions, waits for the
/// next event while running the platform's main loop, and holds the text of
/// the field whose change it last reported.
foreign "c" {
  fn applyStream symbol "pudu_ui_apply" (stream: Bytes, length: UInt64) -> ()
  fn waitEvent symbol "pudu_ui_wait" () -> UInt64
  fn eventText symbol "pudu_ui_event_text" () -> Str
}

/// Applies a nonempty commit in one platform call.
export fn apply(stream: Bytes) -> () {
  let length = match convertInteger[UInt64](stream.length()) {
    case Some(count) => count
    case None => 0u64
  }
  if length > 0u64 {
    unsafe(foreign) {
      applyStream(stream, length)
    }
  }
}

/// The next platform event; the platform's main loop runs until there is one.
export fn wait() -> View.Event {
  var raw = 0u64
  var text = ""
  unsafe(foreign) {
    raw = waitEvent()
    if View.carriesText(raw) {
      text = eventText()
    }
  }
  View.event(raw, text)
}
