module Std.Mobile.Host

import Std.Mobile.Decode as Decode
import Std.Mobile.View as View

/// The platform adapter: it applies one commit's instructions, waits for the
/// next event while running the platform's main loop, and holds the text and
/// detail word of the event it last reported.
foreign "c" {
  fn applyStream symbol "pudu_ui_apply" (stream: Bytes, length: UInt64) -> ()
  fn waitEvent symbol "pudu_ui_wait" () -> UInt64
  fn eventDetail symbol "pudu_ui_event_detail" () -> UInt32
  fn eventWordCount symbol "pudu_ui_event_word_count" () -> UInt32
  fn eventWord symbol "pudu_ui_event_word" (index: UInt32) -> UInt32
  fn eventText symbol "pudu_ui_event_text" () -> Str
}

/// Applies a nonempty commit in one platform call.
export fn apply(stream: Bytes) -> () {
  let length = match convertInteger[UInt64](stream.length()) {
    case Some(count) => count
    case None => 0u64
  }
  if length > 0u64 {
    unsafe(foreign) {
      applyStream(stream, length)
    }
  }
}

/// The next platform event; the platform's main loop runs until there is one.
export fn wait() -> View.Event {
  var raw = 0u64
  var text = ""
  var detail = 0u32
  var values: Array[Int32] = []
  unsafe(foreign) {
    raw = waitEvent()
    if Decode.carriesText(raw) {
      text = eventText()
    }
    if Decode.carriesDetail(raw) {
      detail = eventDetail()
    }
    if Decode.carriesWords(raw) {
      var index = 0u32
      let total = eventWordCount()
      while index < total {
        values = values.push(Decode.signed(eventWord(index)))
        index = index + 1u32
      }
    }
  }
  Decode.eventWithWords(raw, text, detail, values)
}
