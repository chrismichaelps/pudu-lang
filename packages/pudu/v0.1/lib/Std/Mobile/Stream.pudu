module Std.Mobile.Stream

import Std.ByteOrder {writeU32LE}

/// The kind a CREATE names for a label.
export const LABEL: UInt32 = 1u32

/// The kind a CREATE names for a button.
export const BUTTON: UInt32 = 2u32

/// The kind a CREATE names for a column; a keyed list is a column too.
export const COLUMN: UInt32 = 3u32

/// The kind a CREATE names for a row.
export const ROW: UInt32 = 4u32

/// The kind a CREATE names for a text field.
export const FIELD: UInt32 = 5u32

/// The kind a CREATE names for a toggle.
export const TOGGLE: UInt32 = 6u32

/// Instruction codes of the view stream; each is followed by its words.
const CREATE: UInt32 = 1u32
const TEXT: UInt32 = 2u32
const APPEND: UInt32 = 3u32
const ROOT: UInt32 = 4u32
const TAG: UInt32 = 5u32
const STATE: UInt32 = 7u32
const HINT: UInt32 = 8u32
const NAME: UInt32 = 9u32
const INSERT: UInt32 = 10u32
const REMOVE: UInt32 = 11u32
const MOVE: UInt32 = 12u32

/// Creates node `node` as a control of `kind`.
export fn create(out: Array[UInt8], node: UInt32, kind: UInt32) -> Array[UInt8] { words(out, [CREATE, node, kind]) }

/// Sets the text a node shows: a label's text, a button's title, a field's
/// text or a toggle's title.
export fn text(out: Array[UInt8], node: UInt32, value: Str) -> Array[UInt8] { texted(out, TEXT, node, value) }

/// Sets a field's placeholder.
export fn hint(out: Array[UInt8], node: UInt32, value: Str) -> Array[UInt8] { texted(out, HINT, node, value) }

/// Sets a control's accessible name.
export fn name(out: Array[UInt8], node: UInt32, value: Str) -> Array[UInt8] { texted(out, NAME, node, value) }

/// Sets the tag a control's events report.
export fn tag(out: Array[UInt8], node: UInt32, value: UInt32) -> Array[UInt8] { words(out, [TAG, node, value]) }

/// Sets a toggle's state.
export fn state(out: Array[UInt8], node: UInt32, on: Bool) -> Array[UInt8] {
  words(out, [STATE, node, if on { 1u32 } else { 0u32 }])
}

/// Adds `child` after a group's last child.
export fn append(out: Array[UInt8], parent: UInt32, child: UInt32) -> Array[UInt8] { words(out, [APPEND, parent, child]) }

/// Adds `child` to a group at `index`.
export fn insert(out: Array[UInt8], parent: UInt32, child: UInt32, index: UInt32) -> Array[UInt8] {
  words(out, [INSERT, parent, child, index])
}

/// Moves a group's `child` to `index`.
export fn move(out: Array[UInt8], parent: UInt32, child: UInt32, index: UInt32) -> Array[UInt8] {
  words(out, [MOVE, parent, child, index])
}

/// Detaches `node` and forgets every node of its subtree, listed in `ids`.
export fn remove(out: Array[UInt8], node: UInt32, ids: &Array[UInt32]) -> Array[UInt8] {
  let count = match convertInteger[UInt32](ids.length()) {
    case Some(found) => found
    case None => 0u32
  }
  words(words(out, [REMOVE, node, count]), *ids)
}

/// Shows `node` as the screen's content.
export fn root(out: Array[UInt8], node: UInt32) -> Array[UInt8] { words(out, [ROOT, node]) }

// A text-carrying instruction: the code, the node, the byte length, then the
// UTF-8 bytes.
fn texted(out: Array[UInt8], code: UInt32, node: UInt32, value: Str) -> Array[UInt8] {
  let raw = value.toBytes().toArray()
  let length = match convertInteger[UInt32](raw.length()) {
    case Some(count) => count
    case None => 0u32
  }
  var bytes = words(out, [code, node, length])
  for octet in raw {
    bytes = bytes.push(octet)
  }
  bytes
}

// Little-endian words appended to the stream.
fn words(out: Array[UInt8], values: Array[UInt32]) -> Array[UInt8] {
  var bytes = out
  for value in values {
    for octet in writeU32LE(value) {
      bytes = bytes.push(octet)
    }
  }
  bytes
}
