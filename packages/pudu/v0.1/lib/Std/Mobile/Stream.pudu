module Std.Mobile.Stream

import Std.ByteOrder {writeU32LE}

/// The kind a CREATE names for a label.
export const LABEL: UInt32 = 1u32

/// The kind a CREATE names for a button.
export const BUTTON: UInt32 = 2u32

/// The kind a CREATE names for a column; a keyed list is a column too.
export const COLUMN: UInt32 = 3u32

/// The kind a CREATE names for a row.
export const ROW: UInt32 = 4u32

/// The kind a CREATE names for a text field.
export const FIELD: UInt32 = 5u32

/// The kind a CREATE names for a toggle.
export const TOGGLE: UInt32 = 6u32

/// The kind a CREATE names for a vertical scroll viewport.
export const SCROLL: UInt32 = 7u32

/// The kind a CREATE names for a recycling list or grid.
export const LIST: UInt32 = 8u32

/// The kind a CREATE names for a material surface holding one child.
export const MATERIAL: UInt32 = 9u32

/// The kind a CREATE names for a determinate progress bar.
export const PROGRESS: UInt32 = 10u32

/// The kind a CREATE names for an activity indicator.
export const ACTIVITY: UInt32 = 11u32

/// The kind a CREATE names for a slider over integer values.
export const SLIDER: UInt32 = 12u32

/// The kind a CREATE names for a stepper.
export const STEPPER: UInt32 = 13u32

/// The kind a CREATE names for a segmented control.
export const SEGMENTS: UInt32 = 14u32

/// The kind a CREATE names for a wheel of one column.
export const WHEEL: UInt32 = 15u32

/// The kind a CREATE names for a date picker.
export const DATE: UInt32 = 16u32

/// The kind a CREATE names for a text area of several lines.
export const TEXT_AREA: UInt32 = 17u32

/// The kind a CREATE names for a search field.
export const SEARCH: UInt32 = 18u32

/// The kind a CREATE names for a system symbol.
export const SYMBOL: UInt32 = 19u32

/// The kind a CREATE names for a page control.
export const PAGES: UInt32 = 20u32

/// The kind a CREATE names for a color well.
export const WELL: UInt32 = 21u32

/// Instruction codes of the view stream; each is followed by its words.
const CREATE: UInt32 = 1u32
const TEXT: UInt32 = 2u32
const APPEND: UInt32 = 3u32
const ROOT: UInt32 = 4u32
const TAG: UInt32 = 5u32
const STATE: UInt32 = 7u32
const HINT: UInt32 = 8u32
const NAME: UInt32 = 9u32
const INSERT: UInt32 = 10u32
const REMOVE: UInt32 = 11u32
const MOVE: UInt32 = 12u32
const THEME: UInt32 = 20u32
const APPEARANCE: UInt32 = 21u32
const STYLE: UInt32 = 22u32
const COLOR: UInt32 = 23u32
const RANGE: UInt32 = 24u32
const COLUMNS: UInt32 = 25u32
const SURFACE: UInt32 = 26u32
const GESTURES: UInt32 = 27u32
const ALERT: UInt32 = 28u32
const VALUE: UInt32 = 29u32
const HAPTIC: UInt32 = 30u32
const TRAITS: UInt32 = 31u32
const ACCESS_HINT: UInt32 = 32u32
const ACCESS_VALUE: UInt32 = 33u32
const MENU: UInt32 = 34u32
const ANIMATE: UInt32 = 35u32
const BOUNDS: UInt32 = 36u32
const OPTIONS: UInt32 = 37u32
const COUNT: UInt32 = 38u32
const MOMENT: UInt32 = 39u32

/// Creates node `node` as a control of `kind`.
export fn create(out: Array[UInt8], node: UInt32, kind: UInt32) -> Array[UInt8] { words(out, [CREATE, node, kind]) }

/// Sets the text a node shows: a label's text, a button's title, a field's
/// text or a toggle's title.
export fn text(out: Array[UInt8], node: UInt32, value: Str) -> Array[UInt8] { texted(out, TEXT, node, value) }

/// Sets a field's placeholder.
export fn hint(out: Array[UInt8], node: UInt32, value: Str) -> Array[UInt8] { texted(out, HINT, node, value) }

/// Sets a control's accessible name.
export fn name(out: Array[UInt8], node: UInt32, value: Str) -> Array[UInt8] { texted(out, NAME, node, value) }

/// Sets the tag a control's events report.
export fn tag(out: Array[UInt8], node: UInt32, value: UInt32) -> Array[UInt8] { words(out, [TAG, node, value]) }

/// Sets a toggle's state.
export fn state(out: Array[UInt8], node: UInt32, on: Bool) -> Array[UInt8] {
  words(out, [STATE, node, if on { 1u32 } else { 0u32 }])
}

/// Adds `child` after a group's last child.
export fn append(out: Array[UInt8], parent: UInt32, child: UInt32) -> Array[UInt8] { words(out, [APPEND, parent, child]) }

/// Adds `child` to a group at `index`.
export fn insert(out: Array[UInt8], parent: UInt32, child: UInt32, index: UInt32) -> Array[UInt8] {
  words(out, [INSERT, parent, child, index])
}

/// Moves a group's `child` to `index`.
export fn move(out: Array[UInt8], parent: UInt32, child: UInt32, index: UInt32) -> Array[UInt8] {
  words(out, [MOVE, parent, child, index])
}

/// Detaches `node` and forgets every node of its subtree, listed in `ids`.
export fn remove(out: Array[UInt8], node: UInt32, ids: &Array[UInt32]) -> Array[UInt8] {
  words(words(out, [REMOVE, node, count(ids.length())]), *ids)
}

/// Sets every role's tone, in role order, as a kind and two packed colors.
export fn theme(out: Array[UInt8], tones: &Array[(UInt32, UInt32, UInt32)]) -> Array[UInt8] {
  var bytes = words(out, [THEME, count(tones.length())])
  for tone in *tones {
    bytes = words(bytes, [tone[0], tone[1], tone[2]])
  }
  bytes
}

/// Sets the appearance the application asks for.
export fn appearance(out: Array[UInt8], code: UInt32) -> Array[UInt8] { words(out, [APPEARANCE, code]) }

/// Sets the text style of a control that shows text.
export fn style(out: Array[UInt8], node: UInt32, code: UInt32) -> Array[UInt8] { words(out, [STYLE, node, code]) }

/// Sets the color role of a control that shows text.
export fn color(out: Array[UInt8], node: UInt32, code: UInt32) -> Array[UInt8] { words(out, [COLOR, node, code]) }

/// Sets how many items a list shows and the item its first window row is.
export fn range(out: Array[UInt8], node: UInt32, total: UInt32, first: UInt32) -> Array[UInt8] {
  words(out, [RANGE, node, total, first])
}

/// Sets how many equal columns a list lays its items in.
export fn columns(out: Array[UInt8], node: UInt32, across: UInt32) -> Array[UInt8] { words(out, [COLUMNS, node, across]) }

/// Sets the system material behind a material surface.
export fn material(out: Array[UInt8], node: UInt32, code: UInt32) -> Array[UInt8] { words(out, [SURFACE, node, code]) }

/// Attaches the recognizers in `mask` to a control; their events report `tag`.
export fn gestures(out: Array[UInt8], node: UInt32, reported: UInt32, mask: UInt32) -> Array[UInt8] {
  words(out, [GESTURES, node, reported, mask])
}

/// Shows an alert: its tag, style, title, message, then each choice's role
/// and label.
export fn alert(out: Array[UInt8], reported: UInt32, form: UInt32, title: Str, message: Str, choices: &Array[(UInt32, Str)]) -> Array[UInt8] {
  chosen(field(field(words(out, [ALERT, reported, form]), title), message), choices)
}

/// Sets a progress bar's completion in thousandths.
export fn progress(out: Array[UInt8], node: UInt32, permille: UInt32) -> Array[UInt8] { number(out, node, permille) }

/// Sets the number a control holds: a progress bar's thousandths, a slider's
/// or stepper's value bits, a selected index, a current page, or a packed color.
export fn number(out: Array[UInt8], node: UInt32, word: UInt32) -> Array[UInt8] { words(out, [VALUE, node, word]) }

/// Sets a slider's or stepper's least value, greatest value and step, as the
/// bits of signed values.
export fn bounds(out: Array[UInt8], node: UInt32, low: UInt32, high: UInt32, step: UInt32) -> Array[UInt8] {
  words(out, [BOUNDS, node, low, high, step])
}

/// Replaces a segmented control's or wheel's labels.
export fn options(out: Array[UInt8], node: UInt32, labels: &Array[Str]) -> Array[UInt8] {
  var bytes = words(out, [OPTIONS, node, count(labels.length())])
  for label in *labels {
    bytes = field(bytes, label)
  }
  bytes
}

/// Sets how many pages a page control shows.
export fn pages(out: Array[UInt8], node: UInt32, total: UInt32) -> Array[UInt8] { words(out, [COUNT, node, total]) }

/// Sets what a date picker picks and the moment it shows, in whole seconds
/// since the epoch carried as the high word then the low word.
export fn moment(out: Array[UInt8], node: UInt32, mode: UInt32, seconds: Int64) -> Array[UInt8] {
  let low = seconds & 0xffffffffi64
  words(out, [MOMENT, node, mode, wordOf(seconds >> 32), wordOf(low)])
}

// A value known to fit 32 bits, as a word; the high half of a seconds count
// arrives sign-extended and is folded to its two's complement bits.
fn wordOf(part: Int64) -> UInt32 {
  let folded = if part < 0i64 { part + 4294967296i64 } else { part }
  match convertInteger[UInt32](folded) {
    case Some(found) => found
    case None => 0u32
  }
}

/// Plays a haptic.
export fn haptic(out: Array[UInt8], code: UInt32) -> Array[UInt8] { words(out, [HAPTIC, code]) }

/// Sets the accessibility traits of a control.
export fn traits(out: Array[UInt8], node: UInt32, mask: UInt32) -> Array[UInt8] { words(out, [TRAITS, node, mask]) }

/// Sets the accessibility hint of a control.
export fn accessHint(out: Array[UInt8], node: UInt32, hinted: Str) -> Array[UInt8] { texted(out, ACCESS_HINT, node, hinted) }

/// Sets the accessibility value of a control.
export fn accessValue(out: Array[UInt8], node: UInt32, current: Str) -> Array[UInt8] { texted(out, ACCESS_VALUE, node, current) }

/// Attaches a context menu to a control: its tag, then each choice's role
/// and label.
export fn menu(out: Array[UInt8], node: UInt32, reported: UInt32, choices: &Array[(UInt32, Str)]) -> Array[UInt8] {
  chosen(words(out, [MENU, node, reported]), choices)
}

/// Makes a group's placements animate, or stop animating.
export fn animate(out: Array[UInt8], node: UInt32, on: Bool) -> Array[UInt8] {
  words(out, [ANIMATE, node, if on { 1u32 } else { 0u32 }])
}

/// Shows `node` as the screen's content.
export fn root(out: Array[UInt8], node: UInt32) -> Array[UInt8] { words(out, [ROOT, node]) }

// A text-carrying instruction: the code, the node, the byte length, then the
// UTF-8 bytes.
fn texted(out: Array[UInt8], code: UInt32, node: UInt32, value: Str) -> Array[UInt8] {
  let raw = value.toBytes().toArray()
  var bytes = words(out, [code, node, count(raw.length())])
  for octet in raw {
    bytes = bytes.push(octet)
  }
  bytes
}

// A length-prefixed UTF-8 field inside an instruction.
fn field(out: Array[UInt8], content: Str) -> Array[UInt8] {
  let raw = content.toBytes().toArray()
  var bytes = words(out, [count(raw.length())])
  for octet in raw {
    bytes = bytes.push(octet)
  }
  bytes
}

// A count of choices, then each choice's role and label.
fn chosen(out: Array[UInt8], choices: &Array[(UInt32, Str)]) -> Array[UInt8] {
  var bytes = words(out, [count(choices.length())])
  for choice in *choices {
    bytes = field(words(bytes, [choice[0]]), choice[1])
  }
  bytes
}

// Little-endian words appended to the stream.
fn words(out: Array[UInt8], values: Array[UInt32]) -> Array[UInt8] {
  var bytes = out
  for value in values {
    for octet in writeU32LE(value) {
      bytes = bytes.push(octet)
    }
  }
  bytes
}

// A length as a word.
fn count(length: Int) -> UInt32 {
  match convertInteger[UInt32](length) {
    case Some(found) => found
    case None => 0u32
  }
}
