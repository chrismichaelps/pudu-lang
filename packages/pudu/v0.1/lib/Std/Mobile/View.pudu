module Std.Mobile.View

import Std.Mobile.Access as Access
import Std.Mobile.Control as Controls
import Std.Mobile.Feedback as Feedback
import Std.Mobile.Gesture as Gesture
import Std.Mobile.Scene as Scene
import Std.Mobile.Stream as Stream
import Std.Mobile.Theme as Theme

/// One platform control and what it shows. `Named` gives the control it
/// wraps an accessible name and adds no node. `Keyed` is a column whose rows
/// carry keys, so rows are matched by key rather than by position.
/// `Styled` and `Painted` set the text style or color role of the control
/// they wrap and add no node either. `Refreshing` gives the scroll or list it
/// wraps pull to refresh: the tag a pull reports and whether the program is
/// refreshing, which the platform indicator follows. `Memo` renders its view
/// only when it is built or its key changes; an unchanged key reuses what is
/// shown with no render, comparison or instruction. Std.Mobile.Memo builds it.
/// `Control` is a value control, which Std.Mobile.Control writes and updates.
export type View
  = Label(Str)
  | Button(Str, UInt32)
  | Column(Array[View])
  | Row(Array[View])
  | Field(Str, Str, UInt32)
  | Toggle(Str, Bool, UInt32)
  | Named(Str, View)
  | Keyed(Array[(Str, View)])
  | Scroll(View)
  | Styled(Theme.TextStyle, View)
  | Painted(Theme.Role, View)
  | Recycled(Window)
  | Surfaced(Theme.Material, View)
  | Progress(UInt32)
  | Activity(Bool)
  | Recognizing(UInt32, Array[Gesture.Kind], View)
  | Accessible(Access.Access, View)
  | Menu(UInt32, Array[Feedback.Choice], View)
  | Animated(View)
  | Refreshing(UInt32, Bool, View)
  | Memo(Str, fn() -> View)
  | Control(Controls.Control)

/// A recycling list of `total` items in `columns` equal columns. `rows` are
/// the keyed views of items `first`, `first + 1` and onward: the window the
/// program supplies. The platform reuses cells; items outside the window
/// have no row.
export type Window = { tag: UInt32, total: UInt32, first: UInt32, columns: UInt32, rows: Array[(Str, View)] }

/// What the platform reported: a button's tag was tapped, a field's text
/// changed, a toggle was switched, a list's visible range neared the edge of
/// its window (its tag and first visible item), the user popped the
/// navigation from a top route to a destination route below it, the user
/// dismissed a sheet, the user pulled a refresh control with a tag, the
/// screen's safe-area insets changed, a request generation answered (its
/// status, body and Retry-After delay), a requested wake time arrived, the
/// platform ran short of memory, a value control's value, index or page was
/// set by the person, a color well's color or a date picker's moment was
/// chosen, an image's source loaded or failed, or the host asked the program
/// to stop. Std.Mobile.Events decodes
/// them from the host's words.
export type Event
  = Tapped(UInt32)
  | Changed(UInt32, Str)
  | Toggled(UInt32, Bool)
  | Reached(UInt32, UInt32)
  | Gestured(UInt32, Gesture.Gesture)
  | Chose(UInt32, UInt32)
  | Resized(Scene.Size)
  | Lifecycle(Scene.Phase)
  | Picked(UInt32, UInt32)
  | Popped(UInt32, UInt32)
  | Dismissed(UInt32)
  | Refreshed(UInt32)
  | SafeArea(Scene.Insets)
  | Fetched(UInt32, Int, Str, Int)
  | Woke
  | MemoryLow
  | Valued(UInt32, Int32)
  | Colored(UInt32, UInt32)
  | Dated(UInt32, Int64)
  | Imaged(UInt32, Bool)
  | Stopped

/// A node the platform shows: its id, the view it shows, and the nodes of
/// its children in order.
export type Shown = { id: UInt32, view: View, children: Array[Shown] }

/// The tree the platform shows, the next id never handed out, and the ids of
/// removed nodes, handed out again first.
export type Mounted = { root: Shown, next: UInt32, free: Array[UInt32] }

/// What one update did: the nodes it compared, the memos it rendered, and
/// the memos whose unchanged key let it skip their subtree.
export type Stats = { compared: Int, rendered: Int, reused: Int }

// Ids handed out so far, the stream written so far, and the update's counts.
type Work = { next: UInt32, free: Array[UInt32], out: Array[UInt8], compared: Int, rendered: Int, reused: Int }

// A node updated in place, or a node its parent must replace.
type Outcome = Kept(Work, Shown) | Replaced

/// The first item of a window of `size` items that places `visible` a
/// quarter of the window from its start, clamped to the end of the list.
export fn windowStart(visible: UInt32, total: UInt32, size: UInt32) -> UInt32 {
  let lead = size / 4u32
  let start = if visible > lead { visible - lead } else { 0u32 }
  let last = if total > size { total - size } else { 0u32 }
  if start > last { last } else { start }
}

/// The tree for `view`, and the stream that builds it and shows it.
export fn mount(view: &View) -> (Mounted, Bytes) {
  let (made, out) = body([], 0u32, [], view)
  (made, bytesOf(Stream.root(out, made.root.id)))
}

/// The tree for `view` with ids handed out from `next` and `free`, and `out`
/// followed by the words that build it. Nothing is shown as the screen's
/// root: a navigation page shows the body instead.
export fn body(out: Array[UInt8], next: UInt32, free: Array[UInt32], view: &View) -> (Mounted, Array[UInt8]) {
  let (work, shown) = built(started(out, next, free), view)
  (Mounted{root: shown, next: work.next, free: work.free}, work.out)
}

/// The body for `next` and `out` followed by the words that turn `mounted`
/// into it. A root that changed kind or tag is built anew, then the old
/// subtree is removed; no ROOT is written, so the caller reads the new root
/// id from the result.
export fn rebody(out: Array[UInt8], mounted: &Mounted, next: &View) -> (Mounted, Array[UInt8]) {
  let start = started(out, mounted.next, mounted.free)
  match reconciled(start, &mounted.root, next) {
    case Kept(work, shown) => (Mounted{root: shown, next: work.next, free: work.free}, work.out)
    case Replaced => {
      let (made, shown) = built(start, next)
      let work = removed(made, &mounted.root)
      (Mounted{root: shown, next: work.next, free: work.free}, work.out)
    }
  }
}

/// The free ids of `mounted` with its whole tree's ids added, and `out`
/// followed by the words that detach the tree and forget its nodes.
export fn unmount(out: Array[UInt8], mounted: &Mounted) -> (Array[UInt32], Array[UInt8]) {
  let work = removed(started(out, mounted.next, mounted.free), &mounted.root)
  (work.free, work.out)
}

/// The tree for `next`, and the stream that turns what `mounted` shows into
/// it: in-place changes where a node keeps its kind and tag, keyed rows
/// matched by key, and replacement only for nodes that changed kind or tag.
export fn update(mounted: &Mounted, next: &View) -> (Mounted, Bytes) {
  let (made, stream, _) = measured(mounted, next)
  (made, stream)
}

/// `update`, with what it did: how many nodes it compared, memos it rendered
/// and memos it reused. The instruction count is the stream's length.
export fn measured(mounted: &Mounted, next: &View) -> (Mounted, Bytes, Stats) {
  let start = started([], mounted.next, mounted.free)
  match reconciled(start, &mounted.root, next) {
    case Kept(done, shown) => (Mounted{root: shown, next: done.next, free: done.free}, bytesOf(done.out), counted(&done))
    case Replaced => {
      let (made, shown) = built(start, next)
      let replaced = removed(Work{..made, out: Stream.root(made.out, shown.id)}, &mounted.root)
      (Mounted{root: shown, next: replaced.next, free: replaced.free}, bytesOf(replaced.out), counted(&replaced))
    }
  }
}

// Builds `view` with fresh ids and answers the work and its shown node.
fn built(work: Work, view: &View) -> (Work, Shown) {
  let (taken, id) = allocated(work)
  match *view {
    case Label(text) => (written(taken, Stream.text(Stream.create(taken.out, id, Stream.LABEL), id, text)), leaf(id, view))
    case Button(title, tag) => {
      let out = Stream.text(Stream.tag(Stream.create(taken.out, id, Stream.BUTTON), id, tag), id, title)
      (written(taken, out), leaf(id, view))
    }
    case Field(hint, text, tag) => {
      let out = Stream.text(Stream.hint(Stream.tag(Stream.create(taken.out, id, Stream.FIELD), id, tag), id, hint), id, text)
      (written(taken, out), leaf(id, view))
    }
    case Toggle(title, on, tag) => {
      let out = Stream.state(Stream.text(Stream.tag(Stream.create(taken.out, id, Stream.TOGGLE), id, tag), id, title), id, on)
      (written(taken, out), leaf(id, view))
    }
    case Column(children) => grouped(written(taken, Stream.create(taken.out, id, Stream.COLUMN)), id, view, &children)
    case Row(children) => grouped(written(taken, Stream.create(taken.out, id, Stream.ROW)), id, view, &children)
    case Keyed(rows) => grouped(written(taken, Stream.create(taken.out, id, Stream.COLUMN)), id, view, &rows.map(|row: (Str, View)| row[1]))
    case Scroll(child) => grouped(written(taken, Stream.create(taken.out, id, Stream.SCROLL)), id, view, &[child])
    case Surfaced(material, child) => {
      let made = Stream.material(Stream.create(taken.out, id, Stream.MATERIAL), id, Theme.materialCode(material))
      grouped(written(taken, made), id, view, &[child])
    }
    case Progress(permille) => (written(taken, Stream.progress(Stream.create(taken.out, id, Stream.PROGRESS), id, permille)), leaf(id, view))
    case Activity(on) => (written(taken, Stream.state(Stream.create(taken.out, id, Stream.ACTIVITY), id, on)), leaf(id, view))
    case Control(control) => (written(taken, Controls.built(taken.out, id, &control)), leaf(id, view))
    case Recognizing(tag, kinds, inner) =>
    marked(work, view, &inner, |out: Array[UInt8], node: UInt32| Stream.gestures(out, node, tag, Gesture.mask(&kinds)))
    case Accessible(access, inner) => marked(work, view, &inner, |out: Array[UInt8], node: UInt32| described(out, node, &access))
    case Menu(tag, choices, inner) =>
    marked(work, view, &inner, |out: Array[UInt8], node: UInt32| Stream.menu(out, node, tag, &Feedback.choices(&choices)))
    case Animated(inner) => marked(work, view, &inner, |out: Array[UInt8], node: UInt32| Stream.animate(out, node, true))
    case Refreshing(tag, on, inner) => marked(work, view, &inner, |out: Array[UInt8], node: UInt32| Stream.refresh(out, node, tag, on))
    case Memo(key, render) => {
      let inner = render()
      let (made, shown) = built(Work{..work, rendered: work.rendered + 1}, &inner)
      (made, Shown{..shown, view: Memo(key, || inner)})
    }
    case Recycled(window) => {
      let made = Stream.create(taken.out, id, Stream.LIST)
      let shaped = Stream.range(Stream.columns(Stream.tag(made, id, window.tag), id, window.columns), id, window.total, window.first)
      grouped(written(taken, shaped), id, view, &window.rows.map(|row: (Str, View)| row[1]))
    }
    case Named(label, inner) => marked(work, view, &inner, |out: Array[UInt8], node: UInt32| Stream.name(out, node, label))
    case Styled(style, inner) => marked(work, view, &inner, |out: Array[UInt8], node: UInt32| Stream.style(out, node, Theme.styleCode(style)))
    case Painted(role, inner) => marked(work, view, &inner, |out: Array[UInt8], node: UInt32| Stream.color(out, node, Theme.roleCode(role)))
  }
}

// A wrapper: its inner control built, then `mark` written for that control's id.
fn marked(work: Work, view: &View, inner: &View, mark: fn(Array[UInt8], UInt32) -> Array[UInt8]) -> (Work, Shown) {
  let (made, shown) = built(work, inner)
  (written(made, mark(made.out, shown.id)), Shown{..shown, view: *view})
}

// A group's children built and appended in order.
fn grouped(work: Work, id: UInt32, view: &View, children: &Array[View]) -> (Work, Shown) {
  var out = work
  var shown: Array[Shown] = []
  for child in *children {
    let (made, node) = built(out, &child)
    out = written(made, Stream.append(made.out, id, node.id))
    shown = shown.push(node)
  }
  (out, Shown{id: id, view: *view, children: shown})
}

// `shown` updated toward `next`, or Replaced when its kind or tag changed.
fn reconciled(given: Work, shown: &Shown, next: &View) -> Outcome {
  let id = shown.id
  let work = Work{..given, compared: given.compared + 1}
  match (shown.view, *next) {
    // An unchanged key keeps the shown subtree and its cached view whole.
    case (Memo(beforeKey, cached), Memo(afterKey, render)) => {
      if beforeKey == afterKey {
        Kept(Work{..work, reused: work.reused + 1}, *shown)
      } else {
        let inner = render()
        match reconciled(Work{..work, rendered: work.rendered + 1}, &Shown{..*shown, view: cached()}, &inner) {
          case Kept(made, node) => Kept(made, Shown{..node, view: Memo(afterKey, || inner)})
          case Replaced => Replaced
        }
      }
    }
    case (Label(before), Label(after)) => kept(work, retexted(work.out, id, before, after), shown, next)
    case (Button(before, beforeTag), Button(after, afterTag)) if beforeTag == afterTag =>
    kept(work, retexted(work.out, id, before, after), shown, next)
    case (Field(beforeHint, before, beforeTag), Field(afterHint, after, afterTag)) if beforeTag == afterTag => {
      let hinted = if beforeHint == afterHint { work.out } else { Stream.hint(work.out, id, afterHint) }
      kept(work, retexted(hinted, id, before, after), shown, next)
    }
    case (Toggle(before, beforeOn, beforeTag), Toggle(after, afterOn, afterTag)) if beforeTag == afterTag => {
      let titled = retexted(work.out, id, before, after)
      kept(work, if beforeOn == afterOn { titled } else { Stream.state(titled, id, afterOn) }, shown, next)
    }
    case (Column(before), Column(after)) => regrouped(positional(work, shown, &before, &after), shown, next)
    case (Row(before), Row(after)) => regrouped(positional(work, shown, &before, &after), shown, next)
    case (Keyed(before), Keyed(after)) => regrouped(keyed(work, shown, &before, &after), shown, next)
    case (Recycled(before), Recycled(after)) if before.tag == after.tag => {
      let (made, rows) = keyed(work, shown, &before.rows, &after.rows)
      let laid = if before.columns == after.columns { made.out } else { Stream.columns(made.out, id, after.columns) }
      let ranged = if before.total == after.total && before.first == after.first { laid } else { Stream.range(laid, id, after.total, after.first) }
      regrouped((written(made, ranged), rows), shown, next)
    }
    case (Progress(before), Progress(after)) =>
    kept(work, if before == after { work.out } else { Stream.progress(work.out, id, after) }, shown, next)
    case (Activity(before), Activity(after)) =>
    kept(work, if before == after { work.out } else { Stream.state(work.out, id, after) }, shown, next)
    case (Control(before), Control(after)) => {
      match Controls.changed(work.out, id, &before, &after) {
        case Some(out) => kept(work, out, shown, next)
        case None => Replaced
      }
    }
    case (Recognizing(beforeTag, beforeKinds, beforeInner), Recognizing(afterTag, afterKinds, afterInner)) => {
      let same = beforeTag == afterTag && Gesture.mask(&beforeKinds) == Gesture.mask(&afterKinds)
      rewrapped(work, shown, &beforeInner, &afterInner, next, same, |out: Array[UInt8]| Stream.gestures(out, id, afterTag, Gesture.mask(&afterKinds)))
    }
    case (Accessible(before, beforeInner), Accessible(after, afterInner)) =>
    rewrapped(work, shown, &beforeInner, &afterInner, next, false, |out: Array[UInt8]| redescribed(out, id, &before, &after))
    case (Menu(beforeTag, beforeChoices, beforeInner), Menu(afterTag, afterChoices, afterInner)) => {
      let same = beforeTag == afterTag && Feedback.choices(&beforeChoices) == Feedback.choices(&afterChoices)
      rewrapped(work, shown, &beforeInner, &afterInner, next, same, |out: Array[UInt8]| Stream.menu(out, id, afterTag, &Feedback.choices(&afterChoices)))
    }
    case (Animated(beforeInner), Animated(afterInner)) =>
    rewrapped(work, shown, &beforeInner, &afterInner, next, true, |out: Array[UInt8]| out)
    case (Refreshing(beforeTag, beforeOn, beforeInner), Refreshing(afterTag, afterOn, afterInner)) =>
    rewrapped(work, shown, &beforeInner, &afterInner, next, beforeTag == afterTag && beforeOn == afterOn, |out: Array[UInt8]| Stream.refresh(out, id, afterTag, afterOn))
    case (Surfaced(before, _), Surfaced(after, child)) => {
      let (made, node) = settled(work, id, &shown.children[0], &child, 0)
      let out = if before == after { made.out } else { Stream.material(made.out, id, Theme.materialCode(after)) }
      regrouped((written(made, out), [node]), shown, next)
    }
    case (Scroll(_), Scroll(child)) => {
      let (made, node) = settled(work, id, &shown.children[0], &child, 0)
      regrouped((made, [node]), shown, next)
    }
    case (Named(beforeName, beforeInner), Named(afterName, afterInner)) =>
    rewrapped(work, shown, &beforeInner, &afterInner, next, beforeName == afterName, |out: Array[UInt8]| Stream.name(out, id, afterName))
    case (Styled(beforeStyle, beforeInner), Styled(afterStyle, afterInner)) =>
    rewrapped(work, shown, &beforeInner, &afterInner, next, beforeStyle == afterStyle, |out: Array[UInt8]| Stream.style(out, id, Theme.styleCode(afterStyle)))
    case (Painted(beforeRole, beforeInner), Painted(afterRole, afterInner)) =>
    rewrapped(work, shown, &beforeInner, &afterInner, next, beforeRole == afterRole, |out: Array[UInt8]| Stream.color(out, id, Theme.roleCode(afterRole)))
    case _ => Replaced
  }
}

// A wrapper kept on both sides: its inner control reconciled, then `mark`
// written only when the wrapper's own value changed.
fn rewrapped(
  work: Work,
  shown: &Shown,
  before: &View,
  after: &View,
  next: &View,
  same: Bool,
  mark: fn(Array[UInt8]) -> Array[UInt8]
) -> Outcome {
  match reconciled(work, &Shown{..*shown, view: *before}, after) {
    case Kept(made, inner) => Kept(written(made, if same { made.out } else { mark(made.out) }), Shown{..inner, view: *next})
    case Replaced => Replaced
  }
}

// Children matched by position: the common part updated pairwise, extra
// children appended, children no longer present removed.
fn positional(work: Work, parent: &Shown, before: &Array[View], after: &Array[View]) -> (Work, Array[Shown]) {
  var out = work
  var shown: Array[Shown] = []
  let common = if before.length() < after.length() { before.length() } else { after.length() }
  for index in 0..common {
    let (made, node) = settled(out, parent.id, &parent.children[index], &after[index], index)
    out = made
    shown = shown.push(node)
  }
  for index in common..after.length() {
    let (made, node) = built(out, &after[index])
    out = written(made, Stream.append(made.out, parent.id, node.id))
    shown = shown.push(node)
  }
  for index in common..before.length() {
    out = removed(out, &parent.children[index])
  }
  (out, shown)
}

// Rows matched by key: rows whose key is gone are removed, then each wanted
// row is updated, moved to its index, or built and inserted there. `current`
// is the platform's order of the parent's rows at every step.
fn keyed(work: Work, parent: &Shown, before: &Array[(Str, View)], after: &Array[(Str, View)]) -> (Work, Array[Shown]) {
  let wanted = setOf(after.map(|row: (Str, View)| row[0]))
  var out = work
  var current: Array[(Str, Shown)] = []
  for index in 0..before.length() {
    if wanted.contains(before[index][0]) {
      current = current.push((before[index][0], parent.children[index]))
    } else {
      out = removed(out, &parent.children[index])
    }
  }
  var placed: Array[Shown] = []
  var seen: Set[Str] = setOf([])
  for index in 0..after.length() {
    let (key, view) = after[index]
    let at = positionOf(&current, key, index)
    match at {
      case Some(from) if !seen.contains(key) => {
        let (made, node) = settled(out, parent.id, &current[from][1], &view, from)
        out = if from == index { made } else { written(made, Stream.move(made.out, parent.id, node.id, word(index))) }
        current = current.remove(from).insert(index, (key, node))
        placed = placed.push(node)
      }
      case _ => {
        let (made, node) = built(out, &view)
        out = written(made, Stream.insert(made.out, parent.id, node.id, word(index)))
        current = current.insert(index, (key, node))
        placed = placed.push(node)
      }
    }
    seen = seen.insert(key)
  }
  // Unclaimed old duplicates remain after the prefix placed in new order.
  for index in placed.length()..current.length() {
    out = removed(out, &current[index][1])
  }
  (out, placed)
}

// A child updated in place, or replaced at `index`: the new subtree is
// inserted before the old one, which is then removed.
fn settled(work: Work, parent: UInt32, child: &Shown, next: &View, index: Int) -> (Work, Shown) {
  match reconciled(work, child, next) {
    case Kept(made, node) => (made, node)
    case Replaced => {
      let (made, node) = built(work, next)
      (removed(written(made, Stream.insert(made.out, parent, node.id, word(index))), child), node)
    }
  }
}

// Every accessibility field of a control.
fn described(out: Array[UInt8], node: UInt32, access: &Access.Access) -> Array[UInt8] {
  Stream.accessValue(Stream.accessHint(Stream.traits(out, node, Access.mask(&access.traits)), node, access.hint), node, access.value)
}

// Only the accessibility fields that changed.
fn redescribed(out: Array[UInt8], node: UInt32, before: &Access.Access, after: &Access.Access) -> Array[UInt8] {
  let mask = Access.mask(&after.traits)
  let traited = if Access.mask(&before.traits) == mask { out } else { Stream.traits(out, node, mask) }
  let hinted = if before.hint == after.hint { traited } else { Stream.accessHint(traited, node, after.hint) }
  if before.value == after.value { hinted } else { Stream.accessValue(hinted, node, after.value) }
}

// The first row at or after `from` whose key is `key`.
fn positionOf(rows: &Array[(Str, Shown)], key: Str, from: Int) -> Option[Int] {
  for index in from..rows.length() {
    if rows[index][0] == key {
      return Some(index)
    }
  }
  None
}

// The subtree of `node` detached and every one of its ids freed.
fn removed(work: Work, node: &Shown) -> Work {
  let ids = idsOf(node)
  var free = work.free
  for id in ids {
    free = free.push(id)
  }
  Work{..work, free: free, out: Stream.remove(work.out, node.id, &ids)}
}

// Every id of a subtree, the root first.
fn idsOf(node: &Shown) -> Array[UInt32] {
  var ids = [node.id]
  for child in node.children {
    for id in idsOf(&child) {
      ids = ids.push(id)
    }
  }
  ids
}

// A freed id when there is one, otherwise the next new one.
fn allocated(work: Work) -> (Work, UInt32) {
  let count = work.free.length()
  if count == 0 {
    (Work{..work, next: work.next + 1u32}, work.next)
  } else {
    (Work{..work, free: work.free.slice(0, count - 1)}, work.free[count - 1])
  }
}

fn kept(work: Work, out: Array[UInt8], shown: &Shown, next: &View) -> Outcome { Kept(written(work, out), Shown{..*shown, view: *next}) }

fn regrouped(result: (Work, Array[Shown]), shown: &Shown, next: &View) -> Outcome {
  let (work, children) = result
  Kept(work, Shown{id: shown.id, view: *next, children: children})
}

fn retexted(out: Array[UInt8], id: UInt32, before: Str, after: Str) -> Array[UInt8] {
  if before == after { out } else { Stream.text(out, id, after) }
}

fn leaf(id: UInt32, view: &View) -> Shown { Shown{id: id, view: *view, children: []} }

fn written(work: Work, out: Array[UInt8]) -> Work { Work{..work, out: out} }

fn started(out: Array[UInt8], next: UInt32, free: Array[UInt32]) -> Work {
  Work{next: next, free: free, out: out, compared: 0, rendered: 0, reused: 0}
}

fn counted(work: &Work) -> Stats { Stats{compared: work.compared, rendered: work.rendered, reused: work.reused} }

fn word(index: Int) -> UInt32 {
  match convertInteger[UInt32](index) {
    case Some(value) => value
    case None => 0u32
  }
}
