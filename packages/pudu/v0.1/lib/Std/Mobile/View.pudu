module Std.Mobile.View

import Std.Mobile.Stream as Stream
import Std.Mobile.Theme as Theme

/// One platform control and what it shows. `Named` gives the control it
/// wraps an accessible name and adds no node. `Keyed` is a column whose rows
/// carry keys, so rows are matched by key rather than by position.
/// `Styled` and `Painted` set the text style or color role of the control
/// they wrap and add no node either.
export type View
  = Label(Str)
  | Button(Str, UInt32)
  | Column(Array[View])
  | Row(Array[View])
  | Field(Str, Str, UInt32)
  | Toggle(Str, Bool, UInt32)
  | Named(Str, View)
  | Keyed(Array[(Str, View)])
  | Scroll(View)
  | Styled(Theme.TextStyle, View)
  | Painted(Theme.Role, View)

/// What the platform reported: a button's tag was tapped, a field's text
/// changed, a toggle was switched, or the host asked the program to stop.
export type Event
  = Tapped(UInt32)
  | Changed(UInt32, Str)
  | Toggled(UInt32, Bool)
  | Stopped

/// A node the platform shows: its id, the view it shows, and the nodes of
/// its children in order.
export type Shown = { id: UInt32, view: View, children: Array[Shown] }

/// The tree the platform shows, the next id never handed out, and the ids of
/// removed nodes, handed out again first.
export type Mounted = { root: Shown, next: UInt32, free: Array[UInt32] }

// Ids handed out so far and the stream written so far.
type Work = { next: UInt32, free: Array[UInt32], out: Array[UInt8] }

// A node updated in place, or a node its parent must replace.
type Outcome = Kept(Work, Shown) | Replaced

/// Event kinds in the high word of a host event.
const TAPPED: UInt64 = 1u64
const CHANGED: UInt64 = 3u64
const SWITCHED_ON: UInt64 = 4u64
const SWITCHED_OFF: UInt64 = 5u64

/// Each event kind's constructor, given the tag and the text the host holds.
const EVENTS: Map[UInt64, fn(UInt32, Str) -> Event] = mapOf([
    (TAPPED, |tag: UInt32, _text: Str| Tapped(tag)),
    (CHANGED, |tag: UInt32, text: Str| Changed(tag, text)),
    (SWITCHED_ON, |tag: UInt32, _text: Str| Toggled(tag, true)),
    (SWITCHED_OFF, |tag: UInt32, _text: Str| Toggled(tag, false))
  ])

/// Whether a host event's kind carries text the host holds for it.
export fn carriesText(raw: UInt64) -> Bool { raw >> 32 == CHANGED }

/// A host event read from its two words, the kind above and the tag below,
/// with the text the host holds for a changed field. A kind the table does
/// not know stops the program.
export fn event(raw: UInt64, text: Str) -> Event {
  match (EVENTS.get(raw >> 32), convertInteger[UInt32](raw & 0xffffffffu64)) {
    case (Some(made), Some(tag)) => made(tag, text)
    case _ => Stopped
  }
}

/// The tree for `view`, and the stream that builds it and shows it.
export fn mount(view: &View) -> (Mounted, Bytes) {
  let (work, shown) = built(Work{next: 0u32, free: [], out: []}, view)
  (Mounted{root: shown, next: work.next, free: work.free}, bytesOf(Stream.root(work.out, shown.id)))
}

/// The tree for `next`, and the stream that turns what `mounted` shows into
/// it: in-place changes where a node keeps its kind and tag, keyed rows
/// matched by key, and replacement only for nodes that changed kind or tag.
export fn update(mounted: &Mounted, next: &View) -> (Mounted, Bytes) {
  let start = Work{next: mounted.next, free: mounted.free, out: []}
  match reconciled(start, &mounted.root, next) {
    case Kept(work, shown) => (Mounted{root: shown, next: work.next, free: work.free}, bytesOf(work.out))
    case Replaced => {
      let (made, shown) = built(start, next)
      let work = removed(Work{..made, out: Stream.root(made.out, shown.id)}, &mounted.root)
      (Mounted{root: shown, next: work.next, free: work.free}, bytesOf(work.out))
    }
  }
}

// Builds `view` with fresh ids and answers the work and its shown node.
fn built(work: Work, view: &View) -> (Work, Shown) {
  let (taken, id) = allocated(work)
  match *view {
    case Label(text) => (written(taken, Stream.text(Stream.create(taken.out, id, Stream.LABEL), id, text)), leaf(id, view))
    case Button(title, tag) => {
      let out = Stream.text(Stream.tag(Stream.create(taken.out, id, Stream.BUTTON), id, tag), id, title)
      (written(taken, out), leaf(id, view))
    }
    case Field(hint, text, tag) => {
      let out = Stream.text(Stream.hint(Stream.tag(Stream.create(taken.out, id, Stream.FIELD), id, tag), id, hint), id, text)
      (written(taken, out), leaf(id, view))
    }
    case Toggle(title, on, tag) => {
      let out = Stream.state(Stream.text(Stream.tag(Stream.create(taken.out, id, Stream.TOGGLE), id, tag), id, title), id, on)
      (written(taken, out), leaf(id, view))
    }
    case Column(children) => grouped(written(taken, Stream.create(taken.out, id, Stream.COLUMN)), id, view, &children)
    case Row(children) => grouped(written(taken, Stream.create(taken.out, id, Stream.ROW)), id, view, &children)
    case Keyed(rows) => grouped(written(taken, Stream.create(taken.out, id, Stream.COLUMN)), id, view, &rows.map(|row: (Str, View)| row[1]))
    case Scroll(child) => grouped(written(taken, Stream.create(taken.out, id, Stream.SCROLL)), id, view, &[child])
    case Named(label, inner) => marked(work, view, &inner, |out: Array[UInt8], node: UInt32| Stream.name(out, node, label))
    case Styled(style, inner) => marked(work, view, &inner, |out: Array[UInt8], node: UInt32| Stream.style(out, node, Theme.styleCode(style)))
    case Painted(role, inner) => marked(work, view, &inner, |out: Array[UInt8], node: UInt32| Stream.color(out, node, Theme.roleCode(role)))
  }
}

// A wrapper: its inner control built, then `mark` written for that control's id.
fn marked(work: Work, view: &View, inner: &View, mark: fn(Array[UInt8], UInt32) -> Array[UInt8]) -> (Work, Shown) {
  let (made, shown) = built(work, inner)
  (written(made, mark(made.out, shown.id)), Shown{..shown, view: *view})
}

// A group's children built and appended in order.
fn grouped(work: Work, id: UInt32, view: &View, children: &Array[View]) -> (Work, Shown) {
  var out = work
  var shown: Array[Shown] = []
  for child in *children {
    let (made, node) = built(out, &child)
    out = written(made, Stream.append(made.out, id, node.id))
    shown = shown.push(node)
  }
  (out, Shown{id: id, view: *view, children: shown})
}

// `shown` updated toward `next`, or Replaced when its kind or tag changed.
fn reconciled(work: Work, shown: &Shown, next: &View) -> Outcome {
  let id = shown.id
  match (shown.view, *next) {
    case (Label(before), Label(after)) => kept(work, retexted(work.out, id, before, after), shown, next)
    case (Button(before, beforeTag), Button(after, afterTag)) if beforeTag == afterTag =>
    kept(work, retexted(work.out, id, before, after), shown, next)
    case (Field(beforeHint, before, beforeTag), Field(afterHint, after, afterTag)) if beforeTag == afterTag => {
      let hinted = if beforeHint == afterHint { work.out } else { Stream.hint(work.out, id, afterHint) }
      kept(work, retexted(hinted, id, before, after), shown, next)
    }
    case (Toggle(before, beforeOn, beforeTag), Toggle(after, afterOn, afterTag)) if beforeTag == afterTag => {
      let titled = retexted(work.out, id, before, after)
      kept(work, if beforeOn == afterOn { titled } else { Stream.state(titled, id, afterOn) }, shown, next)
    }
    case (Column(before), Column(after)) => regrouped(positional(work, shown, &before, &after), shown, next)
    case (Row(before), Row(after)) => regrouped(positional(work, shown, &before, &after), shown, next)
    case (Keyed(before), Keyed(after)) => regrouped(keyed(work, shown, &before, &after), shown, next)
    case (Scroll(_), Scroll(child)) => {
      let (made, node) = settled(work, id, &shown.children[0], &child, 0)
      regrouped((made, [node]), shown, next)
    }
    case (Named(beforeName, beforeInner), Named(afterName, afterInner)) =>
    rewrapped(work, shown, &beforeInner, &afterInner, next, beforeName == afterName, |out: Array[UInt8]| Stream.name(out, id, afterName))
    case (Styled(beforeStyle, beforeInner), Styled(afterStyle, afterInner)) =>
    rewrapped(work, shown, &beforeInner, &afterInner, next, beforeStyle == afterStyle, |out: Array[UInt8]| Stream.style(out, id, Theme.styleCode(afterStyle)))
    case (Painted(beforeRole, beforeInner), Painted(afterRole, afterInner)) =>
    rewrapped(work, shown, &beforeInner, &afterInner, next, beforeRole == afterRole, |out: Array[UInt8]| Stream.color(out, id, Theme.roleCode(afterRole)))
    case _ => Replaced
  }
}

// A wrapper kept on both sides: its inner control reconciled, then `mark`
// written only when the wrapper's own value changed.
fn rewrapped(
  work: Work,
  shown: &Shown,
  before: &View,
  after: &View,
  next: &View,
  same: Bool,
  mark: fn(Array[UInt8]) -> Array[UInt8]
) -> Outcome {
  match reconciled(work, &Shown{..*shown, view: *before}, after) {
    case Kept(made, inner) => Kept(written(made, if same { made.out } else { mark(made.out) }), Shown{..inner, view: *next})
    case Replaced => Replaced
  }
}

// Children matched by position: the common part updated pairwise, extra
// children appended, children no longer present removed.
fn positional(work: Work, parent: &Shown, before: &Array[View], after: &Array[View]) -> (Work, Array[Shown]) {
  var out = work
  var shown: Array[Shown] = []
  let common = if before.length() < after.length() { before.length() } else { after.length() }
  for index in 0..common {
    let (made, node) = settled(out, parent.id, &parent.children[index], &after[index], index)
    out = made
    shown = shown.push(node)
  }
  for index in common..after.length() {
    let (made, node) = built(out, &after[index])
    out = written(made, Stream.append(made.out, parent.id, node.id))
    shown = shown.push(node)
  }
  for index in common..before.length() {
    out = removed(out, &parent.children[index])
  }
  (out, shown)
}

// Rows matched by key: rows whose key is gone are removed, then each wanted
// row is updated, moved to its index, or built and inserted there. `current`
// is the platform's order of the parent's rows at every step.
fn keyed(work: Work, parent: &Shown, before: &Array[(Str, View)], after: &Array[(Str, View)]) -> (Work, Array[Shown]) {
  let wanted = setOf(after.map(|row: (Str, View)| row[0]))
  var out = work
  var current: Array[(Str, Shown)] = []
  for index in 0..before.length() {
    if wanted.contains(before[index][0]) {
      current = current.push((before[index][0], parent.children[index]))
    } else {
      out = removed(out, &parent.children[index])
    }
  }
  var placed: Array[Shown] = []
  var seen: Set[Str] = setOf([])
  for index in 0..after.length() {
    let (key, view) = after[index]
    let at = positionOf(&current, key, index)
    match at {
      case Some(from) if !seen.contains(key) => {
        let (made, node) = settled(out, parent.id, &current[from][1], &view, from)
        out = if from == index { made } else { written(made, Stream.move(made.out, parent.id, node.id, word(index))) }
        current = current.remove(from).insert(index, (key, node))
        placed = placed.push(node)
      }
      case _ => {
        let (made, node) = built(out, &view)
        out = written(made, Stream.insert(made.out, parent.id, node.id, word(index)))
        current = current.insert(index, (key, node))
        placed = placed.push(node)
      }
    }
    seen = seen.insert(key)
  }
  // Unclaimed old duplicates remain after the prefix placed in new order.
  for index in placed.length()..current.length() {
    out = removed(out, &current[index][1])
  }
  (out, placed)
}

// A child updated in place, or replaced at `index`: the new subtree is
// inserted before the old one, which is then removed.
fn settled(work: Work, parent: UInt32, child: &Shown, next: &View, index: Int) -> (Work, Shown) {
  match reconciled(work, child, next) {
    case Kept(made, node) => (made, node)
    case Replaced => {
      let (made, node) = built(work, next)
      (removed(written(made, Stream.insert(made.out, parent, node.id, word(index))), child), node)
    }
  }
}

// The first row at or after `from` whose key is `key`.
fn positionOf(rows: &Array[(Str, Shown)], key: Str, from: Int) -> Option[Int] {
  for index in from..rows.length() {
    if rows[index][0] == key {
      return Some(index)
    }
  }
  None
}

// The subtree of `node` detached and every one of its ids freed.
fn removed(work: Work, node: &Shown) -> Work {
  let ids = idsOf(node)
  var free = work.free
  for id in ids {
    free = free.push(id)
  }
  Work{..work, free: free, out: Stream.remove(work.out, node.id, &ids)}
}

// Every id of a subtree, the root first.
fn idsOf(node: &Shown) -> Array[UInt32] {
  var ids = [node.id]
  for child in node.children {
    for id in idsOf(&child) {
      ids = ids.push(id)
    }
  }
  ids
}

// A freed id when there is one, otherwise the next new one.
fn allocated(work: Work) -> (Work, UInt32) {
  let count = work.free.length()
  if count == 0 {
    (Work{..work, next: work.next + 1u32}, work.next)
  } else {
    (Work{..work, free: work.free.slice(0, count - 1)}, work.free[count - 1])
  }
}

fn kept(work: Work, out: Array[UInt8], shown: &Shown, next: &View) -> Outcome { Kept(written(work, out), Shown{..*shown, view: *next}) }

fn regrouped(result: (Work, Array[Shown]), shown: &Shown, next: &View) -> Outcome {
  let (work, children) = result
  Kept(work, Shown{id: shown.id, view: *next, children: children})
}

fn retexted(out: Array[UInt8], id: UInt32, before: Str, after: Str) -> Array[UInt8] {
  if before == after { out } else { Stream.text(out, id, after) }
}

fn leaf(id: UInt32, view: &View) -> Shown { Shown{id: id, view: *view, children: []} }

fn written(work: Work, out: Array[UInt8]) -> Work { Work{..work, out: out} }

fn word(index: Int) -> UInt32 {
  match convertInteger[UInt32](index) {
    case Some(value) => value
    case None => 0u32
  }
}
