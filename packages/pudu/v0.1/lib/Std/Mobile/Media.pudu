module Std.Mobile.Media

import Std.Mobile.Request as Request

/// A commit showing `url` in a browser inside the application;
/// `Browsed(tag)` arrives when the person closes it.
export fn browse(tag: UInt32, url: Str) -> Bytes { bytesOf(Request.browse([], tag, url)) }

/// A commit speaking `text` in `language`, a BCP 47 tag or empty for the
/// device's, at `rate` percent of the normal pace. `Spoke(tag, true)` arrives
/// when it ends, or `Spoke(tag, false)` when it was stopped. Utterances queue
/// in order.
export fn speak(tag: UInt32, text: Str, language: Str, rate: Int) -> Bytes {
  let percent = match convertInteger[UInt32](rate) {
    case Some(found) => found
    case None => 100u32
  }
  bytesOf(Request.speak([], tag, percent, language, text))
}

/// A commit stopping speech; every queued utterance answers as stopped.
export fn hush() -> Bytes { bytesOf(Request.hush([])) }

/// A commit showing the platform's photo picker for one image.
/// `ImagePicked(tag, Some(path))` names a copy of the picked image in the
/// application's temporary directory, which the platform may clear;
/// `ImagePicked(tag, None)` arrives when the person cancelled.
export fn pickImage(tag: UInt32) -> Bytes { bytesOf(Request.pickImage([], tag)) }

/// A commit playing the sound at `source` under `tag`, replacing any sound
/// playing under it: a URL with an http or https scheme, or the name of a
/// bundled asset. `Ended(tag)` arrives when it finishes without looping.
export fn play(tag: UInt32, source: Str, looping: Bool) -> Bytes { bytesOf(Request.audio([], tag, 1u32, if looping { 1u32 } else { 0u32 }, source)) }

/// A commit stopping the sound playing under `tag`; it reports nothing.
export fn stop(tag: UInt32) -> Bytes { bytesOf(Request.audio([], tag, 0u32, 0u32, "")) }
