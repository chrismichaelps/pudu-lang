module Std.Mobile.Events

import Std.Mobile.Device as Device
import Std.Mobile.Gesture as Gesture
import Std.Mobile.Location as Location
import Std.Mobile.Permission as Permission
import Std.Mobile.Pick as Pick
import Std.Mobile.Scene as Scene
import Std.Mobile.View as View

/// Event kinds in the high word of a host event; 2 is the host's stop.
const TAPPED: UInt64 = 1u64
const CHANGED: UInt64 = 3u64
const SWITCHED_ON: UInt64 = 4u64
const SWITCHED_OFF: UInt64 = 5u64
const REACHED: UInt64 = 8u64
const GESTURED: UInt64 = 9u64
const CHOSE: UInt64 = 10u64
const RESIZED: UInt64 = 11u64
const LIFECYCLE: UInt64 = 12u64
const PICKED: UInt64 = 13u64
const POPPED: UInt64 = 14u64
const DISMISSED: UInt64 = 15u64
const REFRESHED: UInt64 = 16u64
const INSETS: UInt64 = 17u64
const FETCHED: UInt64 = 18u64
const WOKE: UInt64 = 19u64
const MEMORY: UInt64 = 20u64
const VALUED: UInt64 = 21u64
const COLORED: UInt64 = 22u64
const DATED: UInt64 = 23u64
const IMAGED: UInt64 = 24u64
const OPENED: UInt64 = 25u64
const SHARED: UInt64 = 26u64
const PASTED: UInt64 = 27u64
const PERMISSIONED: UInt64 = 28u64
const SELECTED: UInt64 = 29u64
const LINKED: UInt64 = 30u64
const STORED: UInt64 = 31u64
const DESCRIBED: UInt64 = 32u64
const NETWORKED: UInt64 = 33u64
const LOCATED: UInt64 = 34u64
const NOTIFIED: UInt64 = 35u64
const AUTHENTICATED: UInt64 = 36u64
const BROWSED: UInt64 = 37u64
const SPOKE: UInt64 = 38u64
const POWERED: UInt64 = 39u64
const SENSED: UInt64 = 40u64
const IMAGE_PICKED: UInt64 = 41u64
const LOADED: UInt64 = 42u64
const ENDED: UInt64 = 43u64
const BACKED: UInt64 = 44u64
const CONTACT_PICKED: UInt64 = 45u64
const FILED: UInt64 = 46u64
const COMPLETED: UInt64 = 47u64

/// Each event kind's constructor, given the tag and the text the host holds.
const EVENTS: Map[UInt64, fn(UInt32, Str) -> View.Event] = mapOf([
    (TAPPED, |tag: UInt32, _text: Str| View.Tapped(tag)),
    (CHANGED, |tag: UInt32, text: Str| View.Changed(tag, text)),
    (SWITCHED_ON, |tag: UInt32, _text: Str| View.Toggled(tag, true)),
    (SWITCHED_OFF, |tag: UInt32, _text: Str| View.Toggled(tag, false)),
    (DISMISSED, |sheet: UInt32, _text: Str| View.Dismissed(sheet)),
    (REFRESHED, |tag: UInt32, _text: Str| View.Refreshed(tag)),
    (WOKE, |_tag: UInt32, _text: Str| View.Woke),
    (MEMORY, |_tag: UInt32, _text: Str| View.MemoryLow),
    (SELECTED, |tab: UInt32, _text: Str| View.Selected(tab)),
    (LINKED, |_tag: UInt32, url: Str| View.Linked(url)),
    (PASTED, |tag: UInt32, text: Str| View.Pasted(tag, text)),
    (NOTIFIED, |id: UInt32, _text: Str| View.Notified(id)),
    (BROWSED, |tag: UInt32, _text: Str| View.Browsed(tag)),
    (ENDED, |tag: UInt32, _text: Str| View.Ended(tag)),
    (BACKED, |_tag: UInt32, _text: Str| View.Backed)
  ])

/// Each detailed event kind's constructor, given the tag and the detail word.
/// A pop's tag is the route that was on top and its detail the destination.
const DETAILED: Map[UInt64, fn(UInt32, UInt32) -> Option[View.Event]] = mapOf([
    (REACHED, |reported: UInt32, first: UInt32| Some(View.Reached(reported, first))),
    (CHOSE, |reported: UInt32, index: UInt32| Some(View.Chose(reported, index))),
    (LIFECYCLE, |_reported: UInt32, code: UInt32| lifecycle(Scene.phase(code))),
    (PICKED, |reported: UInt32, index: UInt32| Some(View.Picked(reported, index))),
    (POPPED, |top: UInt32, destination: UInt32| Some(View.Popped(top, destination))),
    (VALUED, |reported: UInt32, bits: UInt32| Some(View.Valued(reported, signed(bits)))),
    (COLORED, |reported: UInt32, rgba: UInt32| Some(View.Colored(reported, rgba))),
    (IMAGED, |reported: UInt32, loaded: UInt32| flagged(loaded, |done: Bool| View.Imaged(reported, done))),
    (OPENED, |reported: UInt32, opened: UInt32| flagged(opened, |done: Bool| View.Opened(reported, done))),
    (SHARED, |reported: UInt32, shared: UInt32| flagged(shared, |done: Bool| View.Shared(reported, done))),
    (PERMISSIONED, |kind: UInt32, state: UInt32| permissioned(Permission.kindOf(kind), Permission.stateOf(state))),
    (NETWORKED, |_reported: UInt32, code: UInt32| networked(Device.linkOf(code))),
    (AUTHENTICATED, |reported: UInt32, confirmed: UInt32| flagged(confirmed, |done: Bool| View.Authenticated(reported, done))),
    (SPOKE, |reported: UInt32, finished: UInt32| flagged(finished, |done: Bool| View.Spoke(reported, done))),
    (LOADED, |reported: UInt32, loaded: UInt32| flagged(loaded, |done: Bool| View.Loaded(reported, done))),
    (COMPLETED, |reported: UInt32, finished: UInt32| flagged(finished, |done: Bool| View.Completed(reported, done)))
  ])

/// Each measured event kind's constructor, given the tag, the detail word and
/// the signed words the host holds for it.
const MEASURED: Map[UInt64, fn(UInt32, UInt32, Array[Int32]) -> Option[View.Event]] = mapOf([
    (GESTURED, |reported: UInt32, bit: UInt32, values: Array[Int32]| gestured(reported, Gesture.decoded(bit, &values))),
    (RESIZED, |_reported: UInt32, _bit: UInt32, values: Array[Int32]| resized(Scene.sized(&values))),
    (INSETS, |_reported: UInt32, _bit: UInt32, values: Array[Int32]| inset(Scene.insets(&values))),
    (DATED, |reported: UInt32, _bit: UInt32, values: Array[Int32]| dated(reported, &values)),
    (LOCATED, |reported: UInt32, found: UInt32, values: Array[Int32]| located(reported, Location.position(found, &values))),
    (POWERED, |reported: UInt32, state: UInt32, values: Array[Int32]| powered(reported, Device.power(state, &values))),
    (SENSED, |_reported: UInt32, _bit: UInt32, values: Array[Int32]| sensed(Device.motion(&values)))
  ])

/// Whether a host event's kind carries text the host holds for it.
export fn carriesText(raw: UInt64) -> Bool { raw >> 32 == CHANGED || raw >> 32 == FETCHED || raw >> 32 == PASTED || raw >> 32 == LINKED || raw >> 32 == STORED || raw >> 32 == DESCRIBED || raw >> 32 == IMAGE_PICKED || raw >> 32 == CONTACT_PICKED || raw >> 32 == FILED }

/// Whether a host event's kind carries a detail word the host holds for it.
export fn carriesDetail(raw: UInt64) -> Bool {
  DETAILED.containsKey(raw >> 32) || MEASURED.containsKey(raw >> 32) || raw >> 32 == FETCHED || raw >> 32 == STORED || raw >> 32 == DESCRIBED || raw >> 32 == IMAGE_PICKED || raw >> 32 == CONTACT_PICKED
    || raw >> 32 == FILED
}

/// Whether a host event's kind carries signed words the host holds for it.
export fn carriesWords(raw: UInt64) -> Bool { MEASURED.containsKey(raw >> 32) || raw >> 32 == FETCHED }

/// A host event read from its two words, the kind above and the tag below,
/// with the text the host holds for a changed field. A kind the table does
/// not know stops the program.
export fn event(raw: UInt64, text: Str) -> View.Event {
  match (EVENTS.get(raw >> 32), convertInteger[UInt32](raw & 0xffffffffu64)) {
    case (Some(made), Some(tag)) => made(tag, text)
    case _ => View.Stopped
  }
}

/// A host event read with its text and detail word.
export fn eventWithDetail(raw: UInt64, text: Str, detail: UInt32) -> View.Event { eventWithWords(raw, text, detail, []) }

/// A host event read with its text, detail word and words: measured kinds
/// decode through `MEASURED`, detailed kinds through `DETAILED`, every other
/// kind through `event`. Words the host never writes read as `Stopped`.
export fn eventWithWords(raw: UInt64, text: Str, detail: UInt32, values: Array[Int32]) -> View.Event {
  match convertInteger[UInt32](raw & 0xffffffffu64) {
    case Some(reported) if raw >> 32 == FETCHED => fetched(reported, detail, text, &values)
    case Some(reported) if raw >> 32 == STORED => stored(reported, detail, text)
    case Some(reported) if raw >> 32 == DESCRIBED => described(reported, Device.facts(text, detail))
    case Some(reported) if raw >> 32 == IMAGE_PICKED => picked(reported, detail, text)
    case Some(reported) if raw >> 32 == FILED => filed(reported, detail, text)
    case Some(reported) if raw >> 32 == CONTACT_PICKED => chosen(reported, detail, text)
    case Some(reported) => {
      match (MEASURED.get(raw >> 32), DETAILED.get(raw >> 32)) {
        case (Some(made), _) => orStopped(made(reported, detail, values))
        case (_, Some(made)) => orStopped(made(reported, detail))
        case _ => event(raw, text)
      }
    }
    case None => View.Stopped
  }
}

/// A host word read as a signed value: the two's complement of its bits.
export fn signed(bits: UInt32) -> Int32 {
  let wide = match convertInteger[Int64](bits) {
    case Some(value) => value
    case None => 0i64
  }
  let folded = if wide >= 2147483648i64 { wide - 4294967296i64 } else { wide }
  match convertInteger[Int32](folded) {
    case Some(value) => value
    case None => 0i32
  }
}

// An event the host wrote, or Stopped for words it never writes.
fn orStopped(found: Option[View.Event]) -> View.Event {
  match found {
    case Some(made) => made
    case None => View.Stopped
  }
}

fn gestured(reported: UInt32, found: Option[Gesture.Gesture]) -> Option[View.Event] {
  let gesture = found ?
  Some(View.Gestured(reported, gesture))
}

fn resized(found: Option[Scene.Size]) -> Option[View.Event] {
  let size = found ?
  Some(View.Resized(size))
}

// A response for request generation `generation`: the status in the detail
// word (0 when nothing arrived), the body as text, and the Retry-After delay
// in milliseconds as the first word, or -1.
fn fetched(generation: UInt32, status: UInt32, body: Str, values: &Array[Int32]) -> View.Event {
  let code = match convertInteger[Int](status) {
    case Some(found) => found
    case None => 0
  }
  let wait = if values.length() > 0 {
    match convertInteger[Int](values[0]) {
      case Some(found) => found
      case None => -1
    }
  } else {
    -1
  }
  View.Fetched(generation, code, body, wait)
}

// A permission report; codes no host writes read as Stopped.
fn permissioned(kind: Option[Permission.Kind], state: Option[Permission.State]) -> Option[View.Event] {
  match (kind, state) {
    case (Some(named), Some(stood)) => Some(View.Permissioned(named, stood))
    case _ => None
  }
}

// A store's answer: its value as text when the detail word is 1, nothing when
// it is 0; any other word is never written.
fn stored(reported: UInt32, present: UInt32, value: Str) -> View.Event {
  if present == 1u32 { View.Stored(reported, Some(value)) } else if present == 0u32 { View.Stored(reported, None) } else { View.Stopped }
}

// The device's facts, or Stopped for text no host writes.
fn described(reported: UInt32, found: Option[Device.Facts]) -> View.Event {
  match found {
    case Some(facts) => View.Described(reported, facts)
    case None => View.Stopped
  }
}

fn powered(reported: UInt32, found: Option[Device.Power]) -> Option[View.Event] {
  let power = found ?
  Some(View.Powered(reported, power))
}

fn sensed(found: Option[Device.Motion]) -> Option[View.Event] {
  let motion = found ?
  Some(View.Sensed(motion))
}

// A picked image's copy when the detail word is 1, a cancellation when it is
// 0 with no text; any other shape is never written.
fn picked(reported: UInt32, kept: UInt32, path: Str) -> View.Event {
  if kept == 1u32 && path.length() > 0 {
    View.ImagePicked(reported, Some(path))
  } else if kept == 0u32 && path.length() == 0 {
    View.ImagePicked(reported, None)
  } else {
    View.Stopped
  }
}

// A file's path when the detail word is 1, nothing when it is 0 with no text.
fn filed(reported: UInt32, done: UInt32, path: Str) -> View.Event {
  match picked(reported, done, path) {
    case View.ImagePicked(tag, found) => View.Filed(tag, found)
    case other => other
  }
}

// A shared contact when the detail word is 1, a cancellation when it is 0.
fn chosen(reported: UInt32, done: UInt32, text: Str) -> View.Event {
  if done == 0u32 && text.length() == 0 {
    return View.ContactPicked(reported, None)
  }
  match Pick.contact(text) {
    case Some(found) if done == 1u32 => View.ContactPicked(reported, Some(found))
    case _ => View.Stopped
  }
}

fn located(reported: UInt32, found: Option[Option[Location.Position]]) -> Option[View.Event] {
  let position = found ?
  Some(View.Located(reported, position))
}

fn networked(found: Option[Device.Link]) -> Option[View.Event] {
  let link = found ?
  Some(View.Networked(link))
}

// An event whose detail word is 1 or 0; any other word is never written.
fn flagged(word: UInt32, made: fn(Bool) -> View.Event) -> Option[View.Event] {
  if word > 1u32 { None } else { Some(made(word == 1u32)) }
}

// A chosen moment from its two words, the high signed and the low unsigned;
// any other count is a word the host never writes.
fn dated(reported: UInt32, values: &Array[Int32]) -> Option[View.Event] {
  if values.length() != 2 {
    return None
  }
  let high = convertInteger[Int64](values[0]) ?
  let raw = convertInteger[Int64](values[1]) ?
  let low = if raw < 0i64 { raw + 4294967296i64 } else { raw }
  Some(View.Dated(reported, high * 4294967296i64 + low))
}

fn inset(found: Option[Scene.Insets]) -> Option[View.Event] {
  let insets = found ?
  Some(View.SafeArea(insets))
}

fn lifecycle(found: Option[Scene.Phase]) -> Option[View.Event] {
  let phase = found ?
  Some(View.Lifecycle(phase))
}
