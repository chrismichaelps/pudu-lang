module Std.Db.Row

import Std.Db.Driver as Driver
import Std.Meta

/// Why a value could not be read out of a result set.
export type RowError
  = MissingColumn(Str)
  | AmbiguousColumn(Str)
  | MissingRow(Int)
  | MissingPosition(Int)
  | WrongWidth(Int, Int, Int)
  | NullColumn(Str)
  | WrongKind(Str, Str)
  | NoRows
  | TooManyRows(Int)

/// Turns one row into a value, or says why it could not.
export type Mapper[T] = fn(Driver.Rows, Int) -> Result[T, RowError]

/// Named access refuses duplicate labels, which require aliases or indexed access.
export fn indexOf(result: &Driver.Rows, name: Str) -> Result[Int, RowError] {
  var position = -1
  var index = 0
  for column in result.columns {
    if column.name == name {
      if position >= 0 { return Err(AmbiguousColumn(name)) }
      position = index
    }
    index = index + 1
  }
  if position < 0 { Err(MissingColumn(name)) } else { Ok(position) }
}

/// The value at a row and column, both counted from zero.
export fn at(result: &Driver.Rows, row: Int, column: Int) -> Result[Driver.Value, RowError] {
  if row < 0 || row >= result.rows.length() { return Err(MissingRow(row)) }
  if column < 0 || column >= result.columns.length() { return Err(MissingPosition(column)) }
  let held = result.rows[row]
  if held.length() != result.columns.length() {
    return Err(WrongWidth(row, result.columns.length(), held.length()))
  }
  Ok(held[column])
}

/// The value in a named column of a row, whatever its kind.
export fn value(result: &Driver.Rows, row: Int, name: Str) -> Result[Driver.Value, RowError] {
  at(result, row, indexOf(result, name) ?)
}

/// None means a present SQL NULL, never a missing column or malformed row.
export fn nullable(result: &Driver.Rows, row: Int, name: Str) -> Result[Option[Driver.Value], RowError] {
  match value(result, row, name) ? {
    case Driver.NullValue => Ok(None)
    case held => Ok(Some(held))
  }
}

fn required(result: &Driver.Rows, row: Int, name: Str) -> Result[Driver.Value, RowError] {
  match value(result, row, name) ? {
    case Driver.NullValue => Err(NullColumn(name))
    case held => Ok(held)
  }
}

/// A named column read as text. A null is an error, not an empty string.
export fn text(result: &Driver.Rows, row: Int, name: Str) -> Result[Str, RowError] {
  match required(result, row, name) ? {
    case Driver.TextValue(held) => Ok(held)
    case _ => Err(WrongKind(name, "text"))
  }
}

/// A named column read as a whole number.
export fn integer(result: &Driver.Rows, row: Int, name: Str) -> Result[Int64, RowError] {
  match required(result, row, name) ? {
    case Driver.IntegerValue(held) => Ok(held)
    case _ => Err(WrongKind(name, "Int64"))
  }
}

/// A named column read as an exact decimal.
export fn decimal(result: &Driver.Rows, row: Int, name: Str) -> Result[Decimal, RowError] {
  match required(result, row, name) ? {
    case Driver.DecimalValue(held) => Ok(held)
    case _ => Err(WrongKind(name, "Decimal"))
  }
}

/// A named column read as a binary floating number.
export fn real(result: &Driver.Rows, row: Int, name: Str) -> Result[Float64, RowError] {
  match required(result, row, name) ? {
    case Driver.RealValue(held) => Ok(held)
    case _ => Err(WrongKind(name, "Float64"))
  }
}

/// A named column read as a truth value.
export fn truth(result: &Driver.Rows, row: Int, name: Str) -> Result[Bool, RowError] {
  match required(result, row, name) ? {
    case Driver.BooleanValue(held) => Ok(held)
    case _ => Err(WrongKind(name, "Bool"))
  }
}

/// A named column read as raw bytes.
export fn bytes(result: &Driver.Rows, row: Int, name: Str) -> Result[Bytes, RowError] {
  match required(result, row, name) ? {
    case Driver.BytesValue(held) => Ok(held)
    case _ => Err(WrongKind(name, "Bytes"))
  }
}

/// Mapping order follows the result; the first mapper failure stops consumption.
export fn map[T](result: &Driver.Rows, mapper: Mapper[T]) -> Result[Array[T], RowError] {
  var mapped: Array[T] = []
  var index = 0
  while index < result.rows.length() {
    mapped = mapped.push(mapper(*result, index) ?)
    index = index + 1
  }
  Ok(mapped)
}

/// The single row a query answered, or an error when it answered none or several.
export fn one[T](result: &Driver.Rows, mapper: Mapper[T]) -> Result[T, RowError] {
  let count = result.rows.length()
  if count == 0 { return Err(NoRows) }
  if count > 1 { return Err(TooManyRows(count)) }
  mapper(*result, 0)
}

/// The one row a query answered, or nothing. Several rows is an error.
export fn optional[T](result: &Driver.Rows, mapper: Mapper[T]) -> Result[Option[T], RowError] {
  let count = result.rows.length()
  if count == 0 { return Ok(None) }
  if count > 1 { return Err(TooManyRows(count)) }
  Ok(Some(mapper(*result, 0) ?))
}

/// A type one named column of a row reads as, through the strict readers
/// above: a null is refused unless the type is an `Option`.
export trait Column {
  /// The named column of a row read as this type.
  fn fromColumn(rows: &Driver.Rows, row: Int, name: Str) -> Result[Self, RowError]
}

impl Column for Str {
  fn fromColumn(rows: &Driver.Rows, row: Int, name: Str) -> Result[Self, RowError] { text(rows, row, name) }
}

impl Column for Int64 {
  fn fromColumn(rows: &Driver.Rows, row: Int, name: Str) -> Result[Self, RowError] { integer(rows, row, name) }
}

/// A platform integer reads a whole-number column it can hold.
impl Column for Int {
  fn fromColumn(rows: &Driver.Rows, row: Int, name: Str) -> Result[Self, RowError] {
    match convertInteger[Int](integer(rows, row, name) ?) {
      case Some(held) => Ok(held)
      case None => Err(WrongKind(name, "Int"))
    }
  }
}

impl Column for Decimal {
  fn fromColumn(rows: &Driver.Rows, row: Int, name: Str) -> Result[Self, RowError] { decimal(rows, row, name) }
}

impl Column for Float64 {
  fn fromColumn(rows: &Driver.Rows, row: Int, name: Str) -> Result[Self, RowError] { real(rows, row, name) }
}

impl Column for Bool {
  fn fromColumn(rows: &Driver.Rows, row: Int, name: Str) -> Result[Self, RowError] { truth(rows, row, name) }
}

impl Column for Bytes {
  fn fromColumn(rows: &Driver.Rows, row: Int, name: Str) -> Result[Self, RowError] { bytes(rows, row, name) }
}

/// A null column is `None`; anything else must read as the content.
impl [A: Column] Column for Option[A] {
  fn fromColumn(rows: &Driver.Rows, row: Int, name: Str) -> Result[Self, RowError] {
    match nullable(rows, row, name) ? {
      case None => Ok(None)
      case Some(_) => Ok(Some(A.fromColumn(rows, row, name) ?))
    }
  }
}

/// A type one row of a result set reads as.
///
/// ## Examples
///
/// ```
/// type User = { id: Int64, @column("display_name") name: Str } derives Row
/// User.fromRow(&rows, 0)
/// ```
export trait Row {
  /// The row at a position read as this type.
  fn fromRow(rows: &Driver.Rows, row: Int) -> Result[Self, RowError]
}

/// A record reads each field from the column of its name, or of the name
/// `@column("name")` gives; the first column that does not read stops it.
export derive Row for T: Record {
  fn fromRow(rows: &Driver.Rows, row: Int) -> Result[T, RowError] {
    Meta.build[T](fn(field: Meta.Field[T, F]) -> Result[F, RowError] where F: Column {
        F.fromColumn(rows, row, field.attributeOr("column", field.name))
      })
  }
}
