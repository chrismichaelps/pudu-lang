module Std.Db.Sqlite

import Std.Bytes as ByteSeq
import Std.Db.Driver as Driver
import Std.Db.Sqlite.Native as Native
import Std.Option as Option
import Std.Result as Result
import Std.Sync as Sync
import Std.Text as Text

/// Default finite wait for admission to the local Database client.
export const DEFAULT_WAIT_MILLISECONDS: Int = 10000

/// How long a statement waits for another connection's lock on the same file
/// before it is refused as busy.
///
/// A connection writing to the file holds its lock for the length of its
/// transaction. Without a busy wait, SQLite refuses every other writer at that
/// moment at once, so two processes sharing one file fail whichever request
/// lands second. Waiting a bounded time for the lock is what lets them share.
export const DEFAULT_BUSY_MILLISECONDS: Int = 5000

/// How many prepared statements a connection keeps by default.
export const DEFAULT_STATEMENT_CACHE: Int = 64

/// How a transaction takes the database's lock: when it first reads or
/// writes, at once for writing, or at once for everything.
export type Begin = Deferred | Immediate | Exclusive

/// How the database journals its writes: as the file already says, or with a
/// write-ahead log, which lets readers proceed while one connection writes.
export type Journal = KeepJournal | WriteAheadLog

/// Everything a connection is opened with.
export type Options = {
  readOnly: Bool,
  create: Bool,
  /// Whether the path may be a `file:` URI with query parameters.
  uri: Bool,
  journal: Journal,
  begin: Begin,
  busyMillis: Int,
  admissionMillis: Int,
  statementCache: Int
}

/// Where one blob lives: its table, its column and its row.
export type Locator = { table: Str, column: Str, row: Int }

/// A connection with every capability SQLite has beyond the driver's own:
/// the driver client, interrupting a running statement, the library's
/// version, the connection's change count, online backup and restore, named
/// parameters, expanded SQL, and reading and writing part of a blob.
export type Database = {
  client: Driver.Client,
  interrupt: fn() -> (),
  version: fn() -> Result[Str, Driver.Error],
  totalChanges: fn() -> Result[Int, Driver.Error],
  backupTo: fn(Str) -> Result[(), Driver.Error],
  restoreFrom: fn(Str) -> Result[(), Driver.Error],
  queryNamed: fn(Str, Array[(Str, Driver.Value)]) -> Result[Driver.Rows, Driver.Error],
  expand: fn(Str, Array[Driver.Value]) -> Result[Str, Driver.Error],
  blobSize: fn(Locator) -> Result[Int, Driver.Error],
  readBlob: fn(Locator, Int, Int) -> Result[Bytes, Driver.Error],
  writeBlob: fn(Locator, Int, Bytes) -> Result[(), Driver.Error]
}

/// A writable file, created when missing, journaled as it already is, with
/// deferred transactions, the default waits and a statement cache.
export fn options() -> Options {
  Options {
    readOnly: false, create: true, uri: false, journal: KeepJournal, begin: Deferred,
    busyMillis: DEFAULT_BUSY_MILLISECONDS, admissionMillis: DEFAULT_WAIT_MILLISECONDS,
    statementCache: DEFAULT_STATEMENT_CACHE
  }
}

/// The local Database driver with the default admission wait.
export fn driver() -> Driver.Driver { driverWithWait(DEFAULT_WAIT_MILLISECONDS) }

/// Override client admission; invalid waits are refused before opening.
export fn driverWithWait(millis: Int) -> Driver.Driver {
  Driver.Driver{name: "sqlite", engine: Driver.Sqlite, schemes: ["sqlite"], placeholders: Driver.QuestionMark,
    capabilities: Driver.plainCapabilities(), open: fn(uri: Str, capacity: Int) -> Result[Driver.Client, Driver.Error] { connectWithWait(uri, capacity, millis) } }
}

/// One serialized connection preserves one local Database with finite admission.
export fn connect(uri: Str, capacity: Int) -> Result[Driver.Client, Driver.Error] {
  connectWithWait(uri, capacity, DEFAULT_WAIT_MILLISECONDS)
}

/// Bound client admission, retaining ownership through complete transaction settlement.
export fn connectWithWait(uri: Str, capacity: Int, millis: Int) -> Result[Driver.Client, Driver.Error] {
  if capacity < 1 { return Err(Native.problem("configuration", "connection capacity must be positive")) }
  Result.map(open(uri, &Options{..options(), admissionMillis: millis}), fn(database: Database) -> Driver.Client { database.client })
}

/// Open a connection with these options. The URI is `sqlite:` followed by a
/// filename or `:memory:`, or by a `file:` URI when the options allow one.
export fn open(uri: Str, chosen: &Options) -> Result[Database, Driver.Error] {
  let path = pathOf(uri, chosen) ?
  if chosen.admissionMillis < 0 || chosen.admissionMillis > Sync.MAX_WAIT_MILLISECONDS {
    return Err(Native.problem("configuration", "client admission wait must be from zero through 3600000 milliseconds"))
  }
  if chosen.busyMillis < 0 { return Err(Native.problem("configuration", "busy wait must not be negative")) }
  if chosen.statementCache < 0 { return Err(Native.problem("configuration", "statement cache size must not be negative")) }
  let session = Native.open(path, flagsOf(chosen), chosen.statementCache) ?
  match prepareSession(&session, chosen) {
    case Ok(_) => Ok(databaseOf(session, chosen))
    case Err(reason) => {
      Native.close(&session)
      Err(reason)
    }
  }
}

fn pathOf(uri: Str, chosen: &Options) -> Result[Str, Driver.Error] {
  if uri.take(7).toLower() != "sqlite:" { return Err(Native.problem("configuration", "expected a sqlite connection string")) }
  let path = uri.drop(7)
  if path.isEmpty() || path.contains("\0") { return Err(Native.problem("configuration", "expected a SQLite filename")) }
  if path.startsWith("file:") {
    if chosen.uri { return Ok(path) }
    return Err(Native.problem("configuration", "a file: URI needs the uri option"))
  }
  if path.contains("?") || path.contains("#") {
    return Err(Native.problem("configuration", "expected a literal SQLite filename or :memory:"))
  }
  if path.startsWith(":") && path != ":memory:" {
    return Err(Native.problem("configuration", "unsupported special SQLite filename"))
  }
  Ok(path)
}

fn flagsOf(chosen: &Options) -> Int32 {
  let access = if chosen.readOnly { Native.OPEN_READONLY } else { Native.OPEN_READWRITE }
  let creating = if chosen.create && !chosen.readOnly { Native.OPEN_CREATE } else { 0i32 }
  let naming = if chosen.uri { Native.OPEN_URI } else { 0i32 }
  access | creating | naming
}

fn prepareSession(session: &Native.Session, chosen: &Options) -> Result[(), Driver.Error] {
  Native.waitWhenBusy(session, chosen.busyMillis) ?
  match chosen.journal {
    case KeepJournal => Ok(())
    case WriteAheadLog => {
      let _mode = Native.perform(session, "PRAGMA journal_mode = WAL", &[]) ?
      Ok(())
    }
  }
}

fn beginOf(chosen: &Options) -> Str {
  match chosen.begin {
    case Deferred => "BEGIN"
    case Immediate => "BEGIN IMMEDIATE"
    case Exclusive => "BEGIN EXCLUSIVE"
  }
}

fn databaseOf(session: Native.Session, chosen: &Options) -> Database {
  let millis = chosen.admissionMillis
  let begin = beginOf(chosen)
  let lock = Sync.mutex()
  let current: Sync.Cell[Option[Native.Session]] = Sync.cell(Some(session))
  Database {
    client: Driver.Client {
      query: fn(sql: Str, values: Array[Driver.Value]) -> Result[Driver.Rows, Driver.Error] {
        withSession(&lock, &current, millis, fn(live: Native.Session) -> Result[Driver.Rows, Driver.Error] { Native.perform(&live, sql, &values) })
      },
      transaction: fn(action: fn(Driver.Tx) -> Result[Driver.Rows, Driver.Error]) -> Result[Driver.Rows, Driver.Error] {
        // The lock is held for the whole action, so nothing else reaches this
        // database between the begin and the commit.
        withSession(&lock, &current, millis, fn(live: Native.Session) -> Result[Driver.Rows, Driver.Error] { transact(&live, &current, begin, action) })
      },
      execute: fn(sql: Str) -> Result[Driver.Rows, Driver.Error] {
        withSession(&lock, &current, millis, fn(live: Native.Session) -> Result[Driver.Rows, Driver.Error] { Native.perform(&live, sql, &[]) })
      },
      close: fn() -> Result[(), Driver.Error] {
        admit(&lock, millis, fn() -> Result[(), Driver.Error] {
            let taken = Result.mapErr(Sync.swap(&current, None), synchronization) ?
            if let Some(live) = taken { Native.close(&live) }
            Ok(())
          })
      }
    },
    // Interrupting is asked of a statement another thread is running, so it
    // does not wait for the lock that statement holds.
    interrupt: fn() -> () {
      match Sync.get(&current) {
        case Ok(Some(live)) => unsafe(foreign) { Native.interrupt(live.database) }
        case _ => ()
      }
    },
    version: fn() -> Result[Str, Driver.Error] {
      withSession(&lock, &current, millis, fn(live: Native.Session) -> Result[Str, Driver.Error] { Native.textOf(live.database, 2i32) })
    },
    totalChanges: fn() -> Result[Int, Driver.Error] {
      withSession(&lock, &current, millis, fn(live: Native.Session) -> Result[Int, Driver.Error] {
          unsafe(foreign) { Ok(Option.unwrapOr(convertInteger[Int](Native.totalChanges(live.database)), 0)) }
        })
    },
    backupTo: fn(path: Str) -> Result[(), Driver.Error] {
      withSession(&lock, &current, millis, fn(live: Native.Session) -> Result[(), Driver.Error] { copy(&live, path, 0i32) })
    },
    restoreFrom: fn(path: Str) -> Result[(), Driver.Error] {
      withSession(&lock, &current, millis, fn(live: Native.Session) -> Result[(), Driver.Error] { copy(&live, path, 1i32) })
    },
    queryNamed: fn(sql: Str, values: Array[(Str, Driver.Value)]) -> Result[Driver.Rows, Driver.Error] {
      withSession(&lock, &current, millis, fn(live: Native.Session) -> Result[Driver.Rows, Driver.Error] { Native.performNamed(&live, sql, &values) })
    },
    expand: fn(sql: Str, values: Array[Driver.Value]) -> Result[Str, Driver.Error] {
      withSession(&lock, &current, millis, fn(live: Native.Session) -> Result[Str, Driver.Error] { Native.expand(&live, sql, &values) })
    },
    blobSize: fn(place: Locator) -> Result[Int, Driver.Error] {
      withSession(&lock, &current, millis, fn(live: Native.Session) -> Result[Int, Driver.Error] {
          withBlob(&live, &place, false, fn(blob: Native.BlobHandle) -> Result[Int, Driver.Error] {
              unsafe(foreign) { Ok(Option.unwrapOr(convertInteger[Int](Native.blobSize(blob)), 0)) }
            })
        })
    },
    readBlob: fn(place: Locator, offset: Int, count: Int) -> Result[Bytes, Driver.Error] {
      withSession(&lock, &current, millis, fn(live: Native.Session) -> Result[Bytes, Driver.Error] { readPart(&live, &place, offset, count) })
    },
    writeBlob: fn(place: Locator, offset: Int, bytes: Bytes) -> Result[(), Driver.Error] {
      withSession(&lock, &current, millis, fn(live: Native.Session) -> Result[(), Driver.Error] { writePart(&live, &place, offset, &bytes) })
    }
  }
}

fn transact(session: &Native.Session, current: &Sync.Cell[Option[Native.Session]], begin: Str, action: fn(Driver.Tx) -> Result[Driver.Rows, Driver.Error]) -> Result[Driver.Rows, Driver.Error] {
  let _begun = Native.perform(session, begin, &[]) ?
  let opened = *session
  let inside = Driver.Tx {
    query: fn(sql: Str, values: Array[Driver.Value]) -> Result[Driver.Rows, Driver.Error] { Native.perform(&opened, sql, &values) },
    execute: fn(sql: Str) -> Result[Driver.Rows, Driver.Error] { Native.perform(&opened, sql, &[]) }
  }
  match Driver.scoped(&inside, action) {
    case Ok(rows) => {
      match Native.perform(session, "COMMIT", &[]) {
        case Ok(_) => Ok(rows)
        case Err(reason) => recoverTransaction(session, current, reason)
      }
    }
    case Err(reason) => recoverTransaction(session, current, reason)
  }
}

fn recoverTransaction(session: &Native.Session, current: &Sync.Cell[Option[Native.Session]], reason: Driver.Error) -> Result[Driver.Rows, Driver.Error] {
  unsafe(foreign) {
    if Native.autocommit(session.database) != 0i32 { return Err(reason) }
  }
  match Native.perform(session, "ROLLBACK", &[]) {
    case Ok(_) => Err(reason)
    case Err(cleanup) => {
      let taken = Result.mapErr(Sync.swap(current, None), synchronization) ?
      if let Some(live) = taken { Native.close(&live) }
      Err(Driver.Error {
          driver: reason.driver,
          category: "transaction",
          code: reason.code,
          message: reason.message + "; rollback failed and the connection was closed: " + cleanup.message
        })
    }
  }
}

/// Run an action inside a savepoint of a transaction: its work is kept when
/// it succeeds and undone when it fails, leaving the transaction around it
/// open either way. Savepoints nest.
export fn savepoint[T](held: &Driver.Tx, name: Str, action: fn() -> Result[T, Driver.Error]) -> Result[T, Driver.Error] {
  if !identifier(name) { return Err(Native.problem("statement", "a savepoint name is a letter or underscore followed by letters, digits or underscores")) }
  let _opened = Driver.run(held, "SAVEPOINT " + name) ?
  match action() {
    case Ok(value) => {
      let _released = Driver.run(held, "RELEASE " + name) ?
      Ok(value)
    }
    case Err(reason) => {
      let _undone = Driver.run(held, "ROLLBACK TO " + name) ?
      let _released = Driver.run(held, "RELEASE " + name) ?
      Err(reason)
    }
  }
}

fn identifier(name: Str) -> Bool {
  if name.isEmpty() || name.length() > 64 { return false }
  var first = true
  for character in name.chars() {
    let allowed = character == '_' || (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z')
      || (!first && character >= '0' && character <= '9')
    if !allowed { return false }
    first = false
  }
  true
}

/// How many rows a write changed, read from its command. Zero for a
/// statement that only read.
export fn affected(rows: &Driver.Rows) -> Int {
  let pieces = rows.command.split(" ")
  if pieces.length() < 3 { 0 } else { Option.unwrapOr(Text.countOf(pieces[2]), 0) }
}

/// The connection's last inserted rowid after a write, as SQLite keeps it:
/// the rowid of the most recent successful insert on this connection.
export fn lastInsertRowid(rows: &Driver.Rows) -> Option[Int] {
  let pieces = rows.command.split(" ")
  if pieces.length() < 3 { None } else { Text.countOf(pieces[1]) }
}

fn copy(session: &Native.Session, path: Str, direction: Int32) -> Result[(), Driver.Error] {
  if path.isEmpty() || path.contains("\0") { return Err(Native.problem("configuration", "expected a SQLite filename")) }
  unsafe(foreign) {
    let status = Native.backup(session.database, path, direction)
    if status != 0i32 { Err(Native.failureOf(session.database, status)) } else { Ok(()) }
  }
}

fn withBlob[T](session: &Native.Session, place: &Locator, writable: Bool, work: fn(Native.BlobHandle) -> Result[T, Driver.Error]) -> Result[T, Driver.Error] {
  if place.table.contains("\0") || place.column.contains("\0") { return Err(Native.problem("parameter", "a blob's table and column cannot contain NUL")) }
  unsafe(foreign) {
    let opened = Native.blobOpen(session.database, place.table, place.column, toInt64(place.row), if writable { 1i32 } else { 0i32 })
    if opened[0] != 0i32 {
      if let Some(blob) = opened[1] { Native.releaseBlob(blob) }
      return Err(Native.failureOf(session.database, opened[0]))
    }
    match opened[1] {
      case None => Err(Native.problem("protocol", "SQLite opened no blob"))
      case Some(blob) => {
        let outcome = work(blob)
        Native.releaseBlob(blob)
        outcome
      }
    }
  }
}

fn readPart(session: &Native.Session, place: &Locator, offset: Int, count: Int) -> Result[Bytes, Driver.Error] {
  let start = bounded(offset, "a blob offset") ?
  let length = bounded(count, "a blob read") ?
  withBlob(session, place, false, fn(blob: Native.BlobHandle) -> Result[Bytes, Driver.Error] {
      unsafe(foreign) {
        let read = Native.blobRead(blob, start, length)
        if read[0] != 0i32 { return Err(Native.failureOf(session.database, read[0])) }
        match read[1] {
          case None => Err(Native.problem("protocol", "SQLite blob bytes were not returned"))
          case Some(text) => Result.mapErr(ByteSeq.decodeHex(text), fn(_problem: ByteSeq.BytesError) -> Driver.Error {
              Native.problem("decode", "SQLite returned an invalid byte encoding")
            })
        }
      }
    })
}

fn writePart(session: &Native.Session, place: &Locator, offset: Int, bytes: &Bytes) -> Result[(), Driver.Error] {
  let start = bounded(offset, "a blob offset") ?
  let length = bounded(bytes.length(), "a blob write") ?
  withBlob(session, place, true, fn(blob: Native.BlobHandle) -> Result[(), Driver.Error] {
      unsafe(foreign) {
        let status = Native.blobWrite(blob, *bytes, length, start)
        if status != 0i32 { Err(Native.failureOf(session.database, status)) } else { Ok(()) }
      }
    })
}

fn bounded(value: Int, what: Str) -> Result[Int32, Driver.Error] {
  match convertInteger[Int32](value) {
    case Some(held) => if held < 0i32 { Err(Native.problem("parameter", what + " must not be negative")) } else { Ok(held) }
    case None => Err(Native.problem("parameter", what + " exceeds SQLite limits"))
  }
}

fn toInt64(value: Int) -> Int64 { Option.unwrapOr(convertInteger[Int64](value), 0i64) }

/// Take the lock, then find the session still open.
fn withSession[T](lock: &Sync.Mutex, current: &Sync.Cell[Option[Native.Session]], millis: Int, work: fn(Native.Session) -> Result[T, Driver.Error]) -> Result[T, Driver.Error] {
  admit(lock, millis, fn() -> Result[T, Driver.Error] {
      match Result.mapErr(Sync.get(current), synchronization) ? {
        case None => Err(Native.problem("closed", "SQLite client is closed"))
        case Some(live) => work(live)
      }
    })
}

fn synchronization(reason: Sync.SyncError) -> Driver.Error { Driver.error("sqlite", "synchronization", show(reason)) }

fn admit[T](target: &Sync.Mutex, millis: Int, action: fn() -> Result[T, Driver.Error]) -> Result[T, Driver.Error] {
  match Result.mapErr(Sync.withLockWithin(target, millis, action), synchronization) ? {
    case Sync.Acquired(outcome) => outcome
    case Sync.LockExpired => Err(Native.problem("admission-timeout", "client admission wait expired"))
  }
}
