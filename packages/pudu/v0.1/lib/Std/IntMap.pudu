module Std.IntMap

/// A map from whole-number keys to values.
///
/// It is held in the runtime's own ordered map, so a lookup, an insertion, and
/// a removal run natively rather than as a tree walked in Pudu, and keys come
/// back in ascending order.
export type IntMap[V] = { held: Map[Int, V] }

/// A key-value pairing retrieved from an IntMap.
export type IntMapEntry[V] = {
  key: Int,
  value: V
}

/// Constructs an empty integer map.
export fn empty[V]() -> IntMap[V] { IntMap{held: mapOf([])} }

/// Constructs an integer map with a single key-value pairing.
export fn singleton[V](key: Int, value: V) -> IntMap[V] { IntMap{held: mapOf([(key, value)])} }

/// Whether the map contains no entries.
export fn isEmpty[V](map: &IntMap[V]) -> Bool { map.held.isEmpty() }

/// The number of entries contained in the map.
export fn size[V](map: &IntMap[V]) -> Int { map.held.size() }

/// Looks up the value associated with a key.
export fn get[V](map: &IntMap[V], key: Int) -> Option[V] { map.held.get(key) }

/// Looks up the value associated with a key, or the fallback when it is absent.
export fn getOr[V](map: &IntMap[V], key: Int, fallback: V) -> V {
  match map.held.get(key) {
    case Some(found) => found
    case None => fallback
  }
}

/// Whether the map holds a key.
export fn member[V](map: &IntMap[V], key: Int) -> Bool { map.held.containsKey(key) }

/// Inserts a key-value pairing, replacing any value already held under the key.
export fn insert[V](map: &IntMap[V], key: Int, value: V) -> IntMap[V] {
  IntMap{held: map.held.insert(key, value)}
}

/// Removes a key and its value, if present.
export fn delete[V](map: &IntMap[V], key: Int) -> IntMap[V] { IntMap{held: map.held.remove(key)} }

/// Updates the value at key if present using function f.
export fn adjust[V](map: &IntMap[V], key: Int, f: fn(V) -> V) -> IntMap[V] {
  match map.held.get(key) {
    case Some(found) => IntMap{held: map.held.insert(key, f(found))}
    case None => *map
  }
}

/// Computes the union of two maps, preferring values in left on duplicate keys.
export fn union[V](left: &IntMap[V], right: &IntMap[V]) -> IntMap[V] {
  // The runtime's merge keeps the second map's value, so the left map goes second.
  IntMap{held: right.held.merge(left.held)}
}

/// Computes the intersection of two maps, keeping values from the left map.
export fn intersection[V](left: &IntMap[V], right: &IntMap[V]) -> IntMap[V] {
  // Walk the smaller map and ask the other, so the work follows the smaller size.
  var kept: Map[Int, V] = mapOf([])
  if left.held.size() <= right.held.size() {
    for pair in left.held.entries() {
      if right.held.containsKey(pair[0]) { kept = kept.insert(pair[0], pair[1]) }
    }
  } else {
    for key in right.held.keys() {
      if let Some(found) = left.held.get(key) { kept = kept.insert(key, found) }
    }
  }
  IntMap{held: kept}
}

/// Computes the difference of two maps (entries in left whose keys are not in right).
export fn difference[V](left: &IntMap[V], right: &IntMap[V]) -> IntMap[V] {
  // Removing the right map's keys costs its size; filtering the left costs the
  // left's. Whichever is smaller is the walk taken.
  if right.held.size() <= left.held.size() {
    var remaining = left.held
    for key in right.held.keys() { remaining = remaining.remove(key) }
    IntMap{held: remaining}
  } else {
    var kept: Map[Int, V] = mapOf([])
    for pair in left.held.entries() {
      if !right.held.containsKey(pair[0]) { kept = kept.insert(pair[0], pair[1]) }
    }
    IntMap{held: kept}
  }
}

/// Transforms all values in the map using function f.
export fn mapValues[A, B](map: &IntMap[A], f: fn(A) -> B) -> IntMap[B] {
  var changed: Map[Int, B] = mapOf([])
  for pair in map.held.entries() { changed = changed.insert(pair[0], f(pair[1])) }
  IntMap{held: changed}
}

/// Returns an array of all keys in ascending order.
export fn keys[V](map: &IntMap[V]) -> Array[Int] { map.held.keys() }

/// Returns an array of all values in key order.
export fn values[V](map: &IntMap[V]) -> Array[V] { map.held.values() }

/// Returns an array of all key-value entries in key order.
export fn entries[V](map: &IntMap[V]) -> Array[IntMapEntry[V]] {
  map.held.entries().map(fn(pair: (Int, V)) -> IntMapEntry[V] => IntMapEntry{key: pair[0], value: pair[1]})
}

/// Returns the smallest key present in the map, or None if empty.
export fn minKey[V](map: &IntMap[V]) -> Option[Int] {
  let ordered = map.held.keys()
  if ordered.length() == 0 { None } else { Some(ordered[0]) }
}

/// Returns the largest key present in the map, or None if empty.
export fn maxKey[V](map: &IntMap[V]) -> Option[Int] {
  let ordered = map.held.keys()
  if ordered.length() == 0 { None } else { Some(ordered[ordered.length() - 1]) }
}
