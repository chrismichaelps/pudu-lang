module Std.Desktop.Bundle.Binary

import Std.Bytes as Bytes

/// One file or directory in a cpio archive.
export type CpioEntry = { name: Str, mode: Int, mtime: Int, data: Bytes }

fn octet(value: Int) -> UInt8 {
  match convertInteger[UInt8](((value % 256) + 256) % 256) {
    case Some(found) => found
    case None => 0u8
  }
}

fn bigEndian(value: Int, width: Int) -> Bytes {
  var octets: Array[UInt8] = []
  var shift = (width - 1) * 8
  while shift >= 0 {
    octets = octets.push(octet(value >> shift))
    shift = shift - 8
  }
  bytesOf(octets)
}

/// Two bytes, big-endian.
export fn u16(value: Int) -> Bytes { bigEndian(value, 2) }

/// Four bytes, big-endian.
export fn u32(value: Int) -> Bytes { bigEndian(value, 4) }

/// Eight bytes, big-endian.
export fn u64(value: Int) -> Bytes { bigEndian(value, 8) }

/// `count` zero bytes.
export fn zeros(count: Int) -> Bytes { Bytes.repeat(&bytesOf([0u8]), if count < 0 { 0 } else { count }) }

/// Text padded with zeros, or cut, to exactly `width` bytes.
export fn padded(text: Str, width: Int) -> Bytes {
  let bytes = text.toBytes().take(width)
  bytes.concat(zeros(width - bytes.length()))
}

/// Zeros that bring `length` up to a multiple of `alignment`.
export fn alignTo(length: Int, alignment: Int) -> Bytes { zeros((alignment - length % alignment) % alignment) }

fn spaced(text: Str, width: Int) -> Str { text + " ".repeat(width - text.length()) }

/// A Unix `ar` archive of named members.
export fn ar(members: &Array[(Str, Bytes)]) -> Bytes {
  var parts = ["!<arch>\n".toBytes()]
  for (name, data) in *members {
    let header = spaced(name, 16) + spaced("0", 12) + spaced("0", 6) + spaced("0", 6) + spaced("100644", 8) + spaced("{data.length()}", 10) + "`\n"
    parts = parts.push(header.toBytes()).push(data)
    if data.length() % 2 == 1 { parts = parts.push("\n".toBytes()) }
  }
  Bytes.join(&parts)
}

/// Eight lowercase hexadecimal digits.
export fn hex8(value: Int) -> Str {
  let digits = "0123456789abcdef"
  var out = ""
  var shift = 28
  while shift >= 0 {
    let nibble = (value >> shift) % 16
    out = out + digits.slice(nibble, nibble + 1)
    shift = shift - 4
  }
  out
}

/// A `newc` cpio archive of `entries`, ending with the trailer.
export fn cpio(entries: &Array[CpioEntry]) -> Bytes {
  var parts: Array[Bytes] = []
  var inode = 1
  for entry in entries.push(CpioEntry{name: "TRAILER!!!", mode: 0, mtime: 0, data: bytesOf([])}) {
    let name = entry.name.toBytes()
    let isTrailer = entry.name == "TRAILER!!!"
    let fields = [
      if isTrailer { 0 } else { inode },
      entry.mode,
      0,
      0,
      1,
      entry.mtime,
      entry.data.length(),
      0,
      0,
      0,
      0,
      name.length() + 1,
      0
    ]
    let header = "070701" + fields.map(fn(field: Int) -> Str { hex8(field) }).join("")
    let head = header.toBytes().concat(name).concat(bytesOf([0u8]))
    parts = parts.push(head).push(alignTo(head.length(), 4)).push(entry.data).push(alignTo(entry.data.length(), 4))
    inode = inode + 1
  }
  Bytes.join(&parts)
}
