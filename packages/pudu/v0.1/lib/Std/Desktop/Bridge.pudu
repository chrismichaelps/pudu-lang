module Std.Desktop.Bridge

import Std.Json as Json

// Generated by scripts/desktop-bridge.mjs from tools/pudu-js; edit those sources.

const BRIDGE_LINES: Array[Str] = [
  "// The page side of a Pudu Desktop application, injected before any page",
  "// script runs. The program appends the call with this view's configuration;",
  "// the invoke key stays inside this closure and is never reachable from the page.",
  "(function (config) \{",
  "  'use strict';",
  "  if (window.__pudu) return;",
  "",
  "  const IPC = 'pudu://app/.pudu/ipc/';",
  "  // The origin of the document this bridge was injected into, fixed now so a",
  "  // call still in flight when the view navigates cannot be credited to the next page.",
  "  const ORIGIN = location.protocol + '//' + location.host;",
  "  const listeners = new Map();",
  "  const channels = new Map();",
  "  let nextChannel = 1;",
  "",
  "  class PuduError extends Error \{",
  "    constructor(envelope) \{",
  "      super(envelope.message);",
  "      this.name = 'PuduError';",
  "      this.kind = envelope.kind;",
  "      this.command = envelope.command;",
  "      this.path = envelope.path || '';",
  "    \}",
  "  \}",
  "",
  "  class Channel \{",
  "    constructor(onmessage) \{",
  "      this.id = nextChannel++;",
  "      this.onmessage = onmessage || null;",
  "      this.onclose = null;",
  "      channels.set(this.id, this);",
  "    \}",
  "    close() \{",
  "      channels.delete(this.id);",
  "    \}",
  "  \}",
  "",
  "  function encode(args) \{",
  "    if (args instanceof ArrayBuffer || ArrayBuffer.isView(args)) \{",
  "      return [args, 'application/octet-stream'];",
  "    \}",
  "    return [JSON.stringify(args === undefined ? null : args), 'application/json'];",
  "  \}",
  "",
  "  async function failure(response, command) \{",
  "    try \{",
  "      return new PuduError(await response.json());",
  "    \} catch (_) \{",
  "      return new PuduError(\{ kind: 'internal', message: response.statusText || String(response.status), command \});",
  "    \}",
  "  \}",
  "",
  "  async function invoke(command, args, options) \{",
  "    const [body, type] = encode(args);",
  "    const headers = \{ 'Content-Type': type, 'Pudu-Invoke-Key': config.key, 'Pudu-Origin': ORIGIN \};",
  "    if (options && options.channel) headers['Pudu-Channel'] = String(options.channel.id);",
  "    let response;",
  "    try \{",
  "      response = await fetch(IPC + encodeURIComponent(command), \{ method: 'POST', body, headers \});",
  "    \} catch (cause) \{",
  "      throw new PuduError(\{ kind: 'transport', message: String(cause), command \});",
  "    \}",
  "    if (!response.ok) throw await failure(response, command);",
  "    const kind = response.headers.get('Content-Type') || '';",
  "    if (kind.startsWith('application/octet-stream')) return response.arrayBuffer();",
  "    const text = await response.text();",
  "    return text.length === 0 ? null : JSON.parse(text);",
  "  \}",
  "",
  "  function listen(event, handler) \{",
  "    if (!listeners.has(event)) listeners.set(event, new Set());",
  "    listeners.get(event).add(handler);",
  "    return () => listeners.get(event).delete(handler);",
  "  \}",
  "",
  "  function once(event, handler) \{",
  "    const stop = listen(event, (message) => \{",
  "      stop();",
  "      handler(message);",
  "    \});",
  "    return stop;",
  "  \}",
  "",
  "  function emit(event, payload) \{",
  "    return invoke('pudu:emit', \{ event, payload: payload === undefined ? null : payload \});",
  "  \}",
  "",
  "  function deliverEvent(event, payload) \{",
  "    for (const handler of Array.from(listeners.get(event) || [])) \{",
  "      try \{",
  "        handler(\{ event, payload \});",
  "      \} catch (problem) \{",
  "        console.error(problem);",
  "      \}",
  "    \}",
  "  \}",
  "",
  "  function deliverChannel(id, payload) \{",
  "    const channel = channels.get(id);",
  "    if (channel && channel.onmessage) channel.onmessage(payload);",
  "  \}",
  "",
  "  function closeChannel(id) \{",
  "    const channel = channels.get(id);",
  "    channels.delete(id);",
  "    if (channel && channel.onclose) channel.onclose();",
  "  \}",
  "",
  "  function reloadStyles() \{",
  "    const stamp = String(Date.now());",
  "    for (const link of Array.from(document.querySelectorAll('link[rel=\"stylesheet\"]'))) \{",
  "      const url = new URL(link.href);",
  "      url.searchParams.set('pudu-reload', stamp);",
  "      link.href = url.toString();",
  "    \}",
  "  \}",
  "",
  "  // Native window interaction uses the platform message channel. The adapter",
  "  // checks authority and any required physical input state.",
  "  function native(message) \{",
  "    const handlers = window.webkit && window.webkit.messageHandlers;",
  "    if (handlers && handlers.puduWindowAuthorized) handlers.puduWindowAuthorized.postMessage(JSON.stringify(\{ action: message, key: config.key, origin: ORIGIN \}));",
  "    else if (handlers && handlers.puduWindow) handlers.puduWindow.postMessage(message);",
  "    else if (window.chrome && window.chrome.webview) window.chrome.webview.postMessage('pudu:' + message);",
  "  \}",
  "",
  "  document.addEventListener(",
  "    'mousedown',",
  "    (event) => \{",
  "      if (event.button !== 0 || !event.target || !event.target.closest) return;",
  "      if (!event.target.closest('[data-pudu-drag-region]')) return;",
  "      if (event.target.closest('a, button, input, select, textarea, [contenteditable], [data-pudu-no-drag]')) return;",
  "      event.preventDefault();",
  "      native(event.detail === 2 ? 'toggle-maximize' : 'drag');",
  "    \},",
  "    true,",
  "  );",
  "",
  "  function control(action, ...values) \{",
  "    return invoke('pudu:window', \{ action, values: values.map(String) \});",
  "  \}",
  "",
  "  const windowApi = Object.freeze(\{",
  "    minimize: () => control('minimize'),",
  "    unminimize: () => control('unminimize'),",
  "    maximize: () => control('maximize'),",
  "    unmaximize: () => control('unmaximize'),",
  "    toggleMaximize: () => control('toggle-maximize'),",
  "    show: () => control('show'),",
  "    hide: () => control('hide'),",
  "    focus: () => control('focus'),",
  "    center: () => control('center'),",
  "    close: () => control('close'),",
  "    setTitle: (title) => control('title', title),",
  "    setSize: (width, height) => control('size', width, height),",
  "    setMinSize: (width, height) => control('min-size', width, height),",
  "    setMaxSize: (width, height) => control('max-size', width, height),",
  "    setPosition: (x, y) => control('position', x, y),",
  "    setFullscreen: (wanted) => control('fullscreen', wanted),",
  "    setAlwaysOnTop: (wanted) => control('always-on-top', wanted),",
  "    setDecorations: (wanted) => control('decorations', wanted),",
  "    setResizable: (wanted) => control('resizable', wanted),",
  "    setClosable: (wanted) => control('closable', wanted),",
  "    setMinimizable: (wanted) => control('minimizable', wanted),",
  "    setMaximizable: (wanted) => control('maximizable', wanted),",
  "    setContentProtected: (wanted) => control('content-protected', wanted),",
  "    setTitleBar: (style) => control('titlebar', style),",
  "    requestAttention: (critical) => control('attention', Boolean(critical)),",
  "    setBadge: (label) => control('badge', label == null ? '' : label),",
  "    state: () => control('state'),",
  "  \});",
  "",
  "  function report(level, message, source, line, column, stack) \{",
  "    invoke('pudu:console', \{",
  "      level,",
  "      message: String(message),",
  "      source: source || '',",
  "      line: line || 0,",
  "      column: column || 0,",
  "      stack: stack || '',",
  "    \}).catch(() => \{\});",
  "  \}",
  "",
  "  if (config.dev) \{",
  "    window.addEventListener(",
  "      'keydown',",
  "      (event) => \{",
  "        const inspect =",
  "          event.key === 'F12' ||",
  "          (event.metaKey && event.altKey && event.code === 'KeyI') ||",
  "          (event.ctrlKey && event.shiftKey && event.code === 'KeyI');",
  "        if (!inspect) return;",
  "        event.preventDefault();",
  "        invoke('pudu:devtools', null).catch(() => \{\});",
  "      \},",
  "      true,",
  "    );",
  "    for (const level of ['error', 'warn']) \{",
  "      const original = console[level].bind(console);",
  "      console[level] = (...parts) => \{",
  "        original(...parts);",
  "        report(level, parts.map((part) => (part instanceof Error ? part.stack || part.message : String(part))).join(' '));",
  "      \};",
  "    \}",
  "    window.addEventListener('error', (event) => \{",
  "      report('error', event.message, event.filename, event.lineno, event.colno, event.error && event.error.stack);",
  "    \});",
  "    window.addEventListener('unhandledrejection', (event) => \{",
  "      const reason = event.reason;",
  "      report('error', reason instanceof Error ? reason.message : String(reason), '', 0, 0, reason && reason.stack);",
  "    \});",
  "  \}",
  "",
  "  Object.defineProperty(window, '__pudu', \{",
  "    value: Object.freeze(\{",
  "      invoke,",
  "      listen,",
  "      once,",
  "      emit,",
  "      Channel,",
  "      PuduError,",
  "      label: config.label,",
  "      window: windowApi,",
  "      __event: deliverEvent,",
  "      __channel: deliverChannel,",
  "      __close: closeChannel,",
  "      __reloadStyles: reloadStyles,",
  "    \}),",
  "    writable: false,",
  "    configurable: false,",
  "  \});",
  "\})",
]

const DECLARATION_LINES: Array[Str] = [
  "/** How a call to the program failed. */",
  "export type PuduErrorKind = 'unknown-command' | 'denied' | 'invalid-arguments' | 'failed' | 'internal' | 'transport';",
  "",
  "/** A failed call, carrying the program's own explanation. */",
  "export interface PuduError extends Error \{",
  "  readonly kind: PuduErrorKind;",
  "  readonly command: string;",
  "  /** Where in the arguments decoding stopped, such as `.items[2].name`. */",
  "  readonly path: string;",
  "\}",
  "",
  "/** Ordered messages the program sends for one call. */",
  "export interface Channel<T> \{",
  "  readonly id: number;",
  "  onmessage: ((message: T) => void) | null;",
  "  onclose: (() => void) | null;",
  "  close(): void;",
  "\}",
  "",
  "/** One event the program emitted. */",
  "export interface PuduEvent<T> \{",
  "  readonly event: string;",
  "  readonly payload: T;",
  "\}",
  "",
  "/** What a window is doing, as `window.state()` answers and `pudu:window-state` events carry. */",
  "export interface PuduWindowState \{",
  "  readonly minimized: boolean;",
  "  readonly maximized: boolean;",
  "  readonly fullscreen: boolean;",
  "  readonly visible: boolean;",
  "  readonly focused: boolean;",
  "  /** Device pixels per point, in thousandths. */",
  "  readonly scale: number;",
  "  readonly theme: 'light' | 'dark';",
  "\}",
  "",
  "/** The page's own window. Each action needs a capability granting `window:<action>`. */",
  "export interface PuduWindow \{",
  "  minimize(): Promise<null>;",
  "  unminimize(): Promise<null>;",
  "  maximize(): Promise<null>;",
  "  unmaximize(): Promise<null>;",
  "  toggleMaximize(): Promise<null>;",
  "  show(): Promise<null>;",
  "  hide(): Promise<null>;",
  "  focus(): Promise<null>;",
  "  center(): Promise<null>;",
  "  close(): Promise<null>;",
  "  setTitle(title: string): Promise<null>;",
  "  setSize(width: number, height: number): Promise<null>;",
  "  setMinSize(width: number, height: number): Promise<null>;",
  "  setMaxSize(width: number, height: number): Promise<null>;",
  "  setPosition(x: number, y: number): Promise<null>;",
  "  setFullscreen(wanted: boolean): Promise<null>;",
  "  setAlwaysOnTop(wanted: boolean): Promise<null>;",
  "  setDecorations(wanted: boolean): Promise<null>;",
  "  setResizable(wanted: boolean): Promise<null>;",
  "  setClosable(wanted: boolean): Promise<null>;",
  "  setMinimizable(wanted: boolean): Promise<null>;",
  "  setMaximizable(wanted: boolean): Promise<null>;",
  "  setContentProtected(wanted: boolean): Promise<null>;",
  "  setTitleBar(style: 'visible' | 'transparent' | 'overlay'): Promise<null>;",
  "  requestAttention(critical?: boolean): Promise<null>;",
  "  setBadge(label: string | null): Promise<null>;",
  "  /** The last observed backend snapshot; also requests a native state refresh. */",
  "  state(): Promise<PuduWindowState>;",
  "\}",
  "",
  "/** A file drop onto the page, as `pudu:drop` events carry. */",
  "export interface PuduDrop \{",
  "  readonly phase: 'enter' | 'over' | 'drop' | 'leave';",
  "  readonly x: number;",
  "  readonly y: number;",
  "  readonly paths: string[];",
  "\}",
  "",
  "export interface PuduBridge \{",
  "  invoke<T>(command: string, args?: unknown, options?: \{ channel?: \{ readonly id: number \} \}): Promise<T>;",
  "  listen<T>(event: string, handler: (message: PuduEvent<T>) => void): () => void;",
  "  once<T>(event: string, handler: (message: PuduEvent<T>) => void): () => void;",
  "  emit(event: string, payload?: unknown): Promise<null>;",
  "  readonly Channel: new <T>(onmessage?: (message: T) => void) => Channel<T>;",
  "  readonly PuduError: new (envelope: \{ kind: PuduErrorKind; message: string; command: string; path?: string \}) => PuduError;",
  "  /** The label of the view this page runs in. */",
  "  readonly label: string;",
  "  /** The window this page runs in. */",
  "  readonly window: PuduWindow;",
  "\}",
  "",
  "declare global \{",
  "  interface Window \{",
  "    readonly __pudu: PuduBridge;",
  "  \}",
  "\}",
]

/// The bridge script for one view: the injected source applied to its configuration.
///
/// The invoke key stays inside the script's closure; the page sees only the
/// functions the bridge exposes.
export fn script(key: Str, label: Str, dev: Bool) -> Str {
  let config = Json.object(&[("key", Json.Text(key)), ("label", Json.Text(label)), ("dev", Json.Boolean(dev))])
  BRIDGE_LINES.join("\n") + "(" + Json.encode(&config) + ");"
}

/// The TypeScript declarations of the bridge every generated module imports.
export fn declarations() -> Str { DECLARATION_LINES.join("\n") }
