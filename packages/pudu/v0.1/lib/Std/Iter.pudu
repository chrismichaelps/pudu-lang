module Std.Iter

import Std.Num {Add, Integer, One}
import Std.Order {Ord}

/// A value that produces a sequence of items.
///
/// `S` is the state the walk carries and `T` is what it yields. `begin` answers
/// the state to start from; `advance` answers the next item and the state after
/// it, or `None` when the sequence is finished.
///
/// The state is passed rather than mutated, so a sequence is an ordinary value:
/// it can be held, copied, and started again without anything having changed
/// underneath. Two walks of the same value see the same items.
///
/// `for item in value` uses this. A type implementing it is iterable with no
/// further ceremony, and a type that is not says so at the `for` rather than
/// part way through one.
///
/// Implementing `begin` and `advance` is all a type needs: the adapters
/// (`map`, `filter`, `take`, ...) and terminals (`toArray`, `fold`, `find`, ...)
/// are default members, so a pipeline reads in the order it runs,
/// `source.map(f).filter(g).take(3).toArray()`. A stage takes any function: a
/// named one, an `fn` literal, or a bar literal.
///
/// ```
/// fn square(n: Int) -> Int { n * n }
///
/// Iter.range(1, 4).map(square).toArray()                       // [1, 4, 9]
/// Iter.range(1, 4).map(fn(n: Int) -> Int => n * n).toArray()   // [1, 4, 9]
/// Iter.range(1, 4).map(|n| n * n).toArray()                    // [1, 4, 9]
/// ```
///
/// ## Examples
///
/// ```
/// type Countdown = { from: Int }
///
/// impl Sequence[Int, Int] for Countdown {
///   fn begin(self: &Self) -> Int { self.from }
///   fn advance(self: &Self, state: Int) -> Option[(Int, Int)] {
///     if state > 0 { Some((state - 1, state)) } else { None }
///   }
/// }
///
/// let launch = Countdown{from: 3}
/// for n in launch { print(n.toText()) }  // 3, 2, 1
/// ```
export trait Sequence[S, T] {
  fn begin(self: &Self) -> S
  fn advance(self: &Self, state: S) -> Option[(S, T)]

  /// Transform each item as it is produced.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.range(1, 4).map(|n| n * n).toArray()  // [1, 4, 9]
  /// ```
  fn map[B](self: &Self, transform: fn(T) -> B) -> Mapped[Self, T, B] {
    Mapped{source: *self, transform: transform}
  }

  /// Keep only the items `keep` accepts.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.range(0, 10).filter(|n| n % 3 == 0).toArray()  // [0, 3, 6, 9]
  /// ```
  fn filter(self: &Self, keep: fn(T) -> Bool) -> Filtered[Self, T] {
    Filtered{source: *self, keep: keep}
  }

  /// At most the first `limit` items.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.range(0, 100).take(3).toArray()  // [0, 1, 2]
  /// ```
  fn take(self: &Self, limit: Int) -> Taken[Self, T] {
    Taken{source: *self, limit: limit}
  }

  /// Every item after the first `skip`.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.range(0, 5).drop(3).toArray()  // [3, 4]
  /// ```
  fn drop(self: &Self, skip: Int) -> Dropped[Self, T] {
    Dropped{source: *self, skip: skip}
  }

  /// The leading items `keep` accepts, ending at the first it refuses.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.items([1, 2, 7, 3]).takeWhile(|n| n < 5).toArray()  // [1, 2]
  /// ```
  fn takeWhile(self: &Self, keep: fn(T) -> Bool) -> TakenWhile[Self, T] {
    TakenWhile{source: *self, keep: keep}
  }

  /// Every item from the first one `skip` refuses onward.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.items([1, 2, 7, 3]).dropWhile(|n| n < 5).toArray()  // [7, 3]
  /// ```
  fn dropWhile(self: &Self, skip: fn(T) -> Bool) -> DroppedWhile[Self, T] {
    DroppedWhile{source: *self, skip: skip}
  }

  /// The first item and then every `step`th after it. A `step` below 1 is 1.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.range(0, 10).stride(4).toArray()  // [0, 4, 8]
  /// ```
  fn stride(self: &Self, step: Int) -> Strided[Self, T] {
    Strided{source: *self, step: step}
  }

  /// This sequence's items, then `next`'s.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.range(0, 2).chain(Iter.items([7, 8])).toArray()  // [0, 1, 7, 8]
  /// ```
  fn chain[Q](self: &Self, next: Q) -> Chained[Self, Q, T] {
    Chained{first: *self, second: next}
  }

  /// Each item paired with its position, counting from nought.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.items(["a", "b"]).enumerate().toArray()  // [(0, "a"), (1, "b")]
  /// ```
  fn enumerate(self: &Self) -> Enumerated[Self, T] {
    Enumerated{source: *self}
  }

  /// Items of this sequence and `other` in pairs, ending with the shorter.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.range(0, 9).zip(Iter.items(["a", "b"])).toArray()  // [(0, "a"), (1, "b")]
  /// ```
  fn zip[Q, B](self: &Self, other: Q) -> Zipped[Self, Q, T, B] {
    Zipped{left: *self, right: other}
  }

  /// Every item, in order, in an array. Do not call it on a sequence that never
  /// ends.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.range(1, 4).toArray()  // [1, 2, 3]
  /// ```
  fn toArray(self: &Self) -> Array[T] {
    var out = []
    for item in *self { out = out.push(item) }
    out
  }

  /// How many items the sequence yields. It is walked to its end; nothing is
  /// kept.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.range(0, 10).filter(|n| n % 3 == 0).count()  // 4
  /// ```
  fn count(self: &Self) -> Int {
    var total = 0
    for _ in *self { total = total + 1 }
    total
  }

  /// Whether the sequence yields nothing. At most one item is produced.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.range(3, 3).isEmpty()  // true
  /// ```
  fn isEmpty(self: &Self) -> Bool {
    match self.advance(self.begin()) {
      case Some(_) => false
      case None => true
    }
  }

  /// Combine the items left to right, starting from `initial`.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.range(1, 5).fold(0, |total, n| total + n)  // 10
  /// ```
  fn fold[A](self: &Self, initial: A, step: fn(A, T) -> A) -> A {
    var held = initial
    for item in *self { held = step(held, item) }
    held
  }

  /// Whether some item satisfies `test`. Stops at the first that does.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.range(0, 5).any(|n| n > 3)  // true
  /// ```
  fn any(self: &Self, test: fn(T) -> Bool) -> Bool {
    match self.find(test) {
      case Some(_) => true
      case None => false
    }
  }

  /// Whether every item satisfies `test`. Stops at the first that does not; an
  /// empty sequence answers `true`.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.range(0, 5).all(|n| n < 5)  // true
  /// ```
  fn all(self: &Self, test: fn(T) -> Bool) -> Bool {
    for item in *self {
      if !test(item) { return false }
    }
    true
  }

  /// The first item satisfying `test`. Stops there.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.range(0, 10).find(|n| n * n > 20)  // Some(5)
  /// ```
  fn find(self: &Self, test: fn(T) -> Bool) -> Option[T] {
    for item in *self {
      if test(item) { return Some(item) }
    }
    None
  }

  /// The first item. At most one item is produced.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.range(4, 9).first()  // Some(4)
  /// ```
  fn first(self: &Self) -> Option[T] {
    let pair = self.advance(self.begin()) ?
    Some(pair[1])
  }

  /// The last item. The sequence is walked to its end.
  ///
  /// ## Examples
  ///
  /// ```
  /// Iter.range(4, 9).last()  // Some(8)
  /// ```
  fn last(self: &Self) -> Option[T] {
    var held = None
    for item in *self { held = Some(item) }
    held
  }
}

/// A half-open range of whole numbers, from `first` up to but not including
/// `last`.
///
/// The language writes a range `first..last`, and that is the spelling to reach
/// for: it needs no import, it is understood by slicing and by `for`, and it
/// answers its own questions. This type is what remains for the case that one
/// cannot serve — it is generic over the integer family, so a caller counting
/// in `UInt8` indices does not have to leave that width to count, where the
/// written range counts in `Int`.
///
/// ## Examples
///
/// ```
/// let small = Iter.range(0u8, 3u8)
/// Iter.toArray(&small)  // [0u8, 1u8, 2u8]
/// ```
export type Range[N] = { first: N, last: N }

/// The numbers from `first` up to but not including `last`.
///
/// A range whose `last` is not after its `first` yields nothing, rather than
/// counting down.
///
/// ## Examples
///
/// ```
/// Iter.toArray(&Iter.range(2, 5))  // [2, 3, 4]
/// Iter.count(&Iter.range(5, 2))    // 0
/// ```
export fn range[N](first: N, last: N) -> Range[N] {
  Range{first: first, last: last}
}

impl [N: Integer + Ord + Add + One] Sequence[N, N] for Range[N] {
  fn begin(self: &Self) -> N { self.first }
  fn advance(self: &Self, state: N) -> Option[(N, N)] {
    if state.before(&self.last) {
      Some((state.plus(&state.one()), state))
    } else {
      None
    }
  }
}

/// A walk over an array's items.
///
/// The element type is the array's own. Fixing it to one type would make the
/// whole module useless for every array that is not of that type, which is the
/// mistake this type exists to avoid.
///
/// ## Examples
///
/// ```
/// Iter.count(&Iter.items(["a", "b"]))  // 2
/// ```
export type Items[T] = { values: Array[T] }

/// Walk an array's items.
///
/// The starting point for building a lazy pipeline over data already in an
/// array. The array is held, not copied.
///
/// ## Examples
///
/// ```
/// Iter.toArray(&Iter.items([1, 2, 3]))  // [1, 2, 3]
/// ```
export fn items[T](values: Array[T]) -> Items[T] { Items{values: values} }

impl [T] Sequence[Int, T] for Items[T] {
  fn begin(self: &Self) -> Int { 0 }
  fn advance(self: &Self, state: Int) -> Option[(Int, T)] {
    if state < self.values.length() {
      Some((state + 1, self.values[state]))
    } else {
      None
    }
  }
}

/// A walk over an array's items paired with their positions.
///
/// Each item is a `(position, value)` pair, counting from nought.
///
/// ## Examples
///
/// ```
/// Iter.toArray(&Iter.indexed(["a", "b"]))  // [(0, "a"), (1, "b")]
/// ```
export type Indexed[T] = { values: Array[T] }

/// Pair each of an array's items with its position.
///
/// ## Examples
///
/// ```
/// for pair in Iter.indexed(["x", "y"]) { print(pair[0].toText() + " " + pair[1]) }  // 0 x, 1 y
/// ```
export fn indexed[T](values: Array[T]) -> Indexed[T] { Indexed{values: values} }

impl [T] Sequence[Int, (Int, T)] for Indexed[T] {
  fn begin(self: &Self) -> Int { 0 }
  fn advance(self: &Self, state: Int) -> Option[(Int, (Int, T))] {
    if state < self.values.length() {
      Some((state + 1, (state, self.values[state])))
    } else {
      None
    }
  }
}

/// A walk that yields the same item a fixed number of times.
///
/// ## Examples
///
/// ```
/// Iter.count(&Iter.repeat("-", 4))  // 4
/// ```
export type Repeated[T] = { item: T, times: Int }

/// The same value, `times` times.
///
/// A count of nought or less yields nothing.
///
/// ## Examples
///
/// ```
/// Iter.toArray(&Iter.repeat("ab", 3))  // ["ab", "ab", "ab"]
/// Iter.count(&Iter.repeat(1, -2))        // 0
/// ```
export fn repeat[T](item: T, times: Int) -> Repeated[T] {
  Repeated{item: item, times: times}
}

impl [T] Sequence[Int, T] for Repeated[T] {
  fn begin(self: &Self) -> Int { 0 }
  fn advance(self: &Self, state: Int) -> Option[(Int, T)] {
    if state < self.times { Some((state + 1, self.item)) } else { None }
  }
}

/// A walk that yields nothing.
///
/// ## Examples
///
/// ```
/// Iter.isEmpty(&Iter.empty[Int]())  // true
/// ```
export type Empty[T] = { unused: () }

/// The sequence with no items.
///
/// Useful as the neutral case for a function that returns a sequence: a caller
/// iterates it like any other and simply sees no items.
///
/// ## Examples
///
/// ```
/// Iter.count(&Iter.empty[Str]())  // 0
/// ```
export fn empty[T]() -> Empty[T] { Empty{unused: ()} }

impl [T] Sequence[Int, T] for Empty[T] {
  fn begin(self: &Self) -> Int { 0 }
  fn advance(self: &Self, state: Int) -> Option[(Int, T)] { None }
}

/// Collect a sequence into an array.
///
/// Bounded by `Sequence` rather than written for one type, so it works for any
/// sequence a program declares as well as for the ones here.
///
/// This is where a lazy pipeline does its work: every item is produced now, in
/// order, and kept. Do not call it on a sequence that never ends.
///
/// ## Examples
///
/// ```
/// Iter.toArray(&Iter.range(1, 4))  // [1, 2, 3]
/// ```
export fn toArray[S, T, Q: Sequence[S, T]](source: &Q) -> Array[T] { source.toArray() }

/// How many items a sequence yields.
///
/// The sequence is walked to its end to count it; nothing is kept.
///
/// ## Examples
///
/// ```
/// Iter.count(&Iter.filter(Iter.range(0, 10), fn(n: Int) -> Bool => n % 3 == 0))  // 4
/// ```
export fn count[S, T, Q: Sequence[S, T]](source: &Q) -> Int { source.count() }

/// Whether a sequence yields nothing.
///
/// Asks for one item at most, so it is cheap even for a long sequence.
///
/// ## Examples
///
/// ```
/// Iter.isEmpty(&Iter.range(3, 3))  // true
/// Iter.isEmpty(&Iter.range(0, 9))  // false
/// ```
export fn isEmpty[S, T, Q: Sequence[S, T]](source: &Q) -> Bool { source.isEmpty() }

/// The sum of a sequence's items, or `None` when it has no first value.
///
/// `None` rather than nought for an empty sequence, because the item type need not
/// have a nought: anything that can be added can be summed.
///
/// ## Examples
///
/// ```
/// Iter.sum(&Iter.range(1, 5))   // Some(10)
/// Iter.sum(&Iter.range(1, 1))   // None
/// ```
export fn sum[S, N: Add, Q: Sequence[S, N]](source: &Q) -> Option[N] {
  var state = Sequence.begin(source)
  let first = Sequence.advance(source, state) ?
  state = first[0]
  var total = first[1]
  loop {
    match Sequence.advance(source, state) {
      case Some(pair) => {
        state = pair[0]
        total = total.plus(&pair[1])
      }
      case None => { break }
    }
  }
  Some(total)
}

/// A sequence whose items are another's, transformed.
///
/// Nothing is computed until the walk asks for it: `advance` transforms one
/// item and returns. Building a `Mapped` over a sequence of a million does no
/// work at all, which is what "lazy" has to mean to be worth having.
///
/// ## Examples
///
/// ```
/// let squares = Iter.map(Iter.range(1, 4), fn(n: Int) -> Int => n * n)
/// Iter.toArray(&squares)  // [1, 4, 9]
/// ```
export type Mapped[Q, A, B] = { source: Q, transform: fn(A) -> B }

/// Transform each item of a sequence as it is produced.
///
/// ## Examples
///
/// ```
/// Iter.toArray(&Iter.map(Iter.items(["a", "bc"]), fn(s: Str) -> Int => s.length()))  // [1, 2]
/// ```
export fn map[Q, A, B](source: Q, transform: fn(A) -> B) -> Mapped[Q, A, B] {
  Mapped{source: source, transform: transform}
}

impl [S, A, B, Q: Sequence[S, A]] Sequence[S, B] for Mapped[Q, A, B] {
  fn begin(self: &Self) -> S { self.source.begin() }
  fn advance(self: &Self, state: S) -> Option[(S, B)] {
    let transform = self.transform
    let (next, item) = self.source.advance(state) ?
    Some((next, transform(item)))
  }
}

/// A sequence of another's items that satisfy a test.
///
/// ## Examples
///
/// ```
/// let evens = Iter.filter(Iter.range(0, 7), fn(n: Int) -> Bool => n % 2 == 0)
/// Iter.toArray(&evens)  // [0, 2, 4, 6]
/// ```
export type Filtered[Q, T] = { source: Q, keep: fn(T) -> Bool }

/// Keep only the items a test accepts.
///
/// Items keep their order. The test runs once per item, as the walk reaches it.
///
/// ## Examples
///
/// ```
/// Iter.toArray(&Iter.filter(Iter.items(["", "a", ""]), fn(s: Str) -> Bool => !s.isEmpty()))  // ["a"]
/// ```
export fn filter[Q, T](source: Q, keep: fn(T) -> Bool) -> Filtered[Q, T] {
  Filtered{source: source, keep: keep}
}

impl [S, T, Q: Sequence[S, T]] Sequence[S, T] for Filtered[Q, T] {
  fn begin(self: &Self) -> S { self.source.begin() }
  /// Walks the source until an item is accepted, so a rejected item costs one
  /// step and no allocation.
  fn advance(self: &Self, state: S) -> Option[(S, T)] {
    let keep = self.keep
    var current = state
    loop {
      match self.source.advance(current) {
        case Some((next, item)) => {
          if keep(item) { break Some((next, item)) }
          current = next
        }
        case None => { break None }
      }
    }
  }
}

/// A sequence of at most the first `limit` items of another.
///
/// ## Examples
///
/// ```
/// Iter.toArray(&Iter.take(Iter.range(0, 100), 3))  // [0, 1, 2]
/// ```
export type Taken[Q, T] = { source: Q, limit: Int }

/// The first `limit` items, or all of them if there are fewer.
///
/// The source is never asked for an item past the limit, so taking from a
/// sequence that would run for a long time, or forever, still ends. A limit of
/// nought or less yields nothing.
///
/// ## Examples
///
/// ```
/// Iter.toArray(&Iter.take(Iter.repeat("x", 1000000), 2))  // ["x", "x"]
/// Iter.toArray(&Iter.take(Iter.range(0, 2), 5))            // [0, 1]
/// ```
export fn take[Q, T](source: Q, limit: Int) -> Taken[Q, T] {
  Taken{source: source, limit: limit}
}

impl [S, T, Q: Sequence[S, T]] Sequence[(S, Int), T] for Taken[Q, T] {
  fn begin(self: &Self) -> (S, Int) { (self.source.begin(), 0) }
  fn advance(self: &Self, state: (S, Int)) -> Option[((S, Int), T)] {
    let (at, taken) = state
    if taken >= self.limit {
      None
    } else {
      let (next, item) = self.source.advance(at) ?
      Some(((next, taken + 1), item))
    }
  }
}

/// A sequence of another's items past the first `skip`.
///
/// ## Examples
///
/// ```
/// Iter.toArray(&Iter.drop(Iter.range(0, 5), 3))  // [3, 4]
/// ```
export type Dropped[Q, T] = { source: Q, skip: Int }

/// Everything after the first `skip` items.
///
/// Dropping more items than there are leaves an empty sequence.
///
/// ## Examples
///
/// ```
/// Iter.toArray(&Iter.drop(Iter.items(["a", "b", "c"]), 1))  // ["b", "c"]
/// Iter.count(&Iter.drop(Iter.range(0, 2), 5))                // 0
/// ```
export fn drop[Q, T](source: Q, skip: Int) -> Dropped[Q, T] {
  Dropped{source: source, skip: skip}
}

impl [S, T, Q: Sequence[S, T]] Sequence[S, T] for Dropped[Q, T] {
  /// The skipping happens once, when the walk begins, rather than on every
  /// item.
  fn begin(self: &Self) -> S {
    var current = self.source.begin()
    var skipped = 0
    while skipped < self.skip {
      match self.source.advance(current) {
        case Some((next, _)) => {
          current = next
          skipped = skipped + 1
        }
        case None => { return current }
      }
    }
    current
  }
  fn advance(self: &Self, state: S) -> Option[(S, T)] { self.source.advance(state) }
}

/// A sequence pairing two others item by item.
///
/// ## Examples
///
/// ```
/// Iter.toArray(&Iter.zip(Iter.range(1, 3), Iter.items(["a", "b"])))  // [(1, "a"), (2, "b")]
/// ```
export type Zipped[P, Q, A, B] = { left: P, right: Q }

/// Pair two sequences, ending when either does.
///
/// Items beyond the shorter sequence's end are never asked for.
///
/// ## Examples
///
/// ```
/// Iter.count(&Iter.zip(Iter.range(0, 100), Iter.items(["a", "b"])))  // 2
/// ```
export fn zip[P, Q, A, B](left: P, right: Q) -> Zipped[P, Q, A, B] {
  Zipped{left: left, right: right}
}

impl [S, U, A, B, P: Sequence[S, A], Q: Sequence[U, B]] Sequence[(S, U), (A, B)] for Zipped[P, Q, A, B] {
  fn begin(self: &Self) -> (S, U) { (self.left.begin(), self.right.begin()) }
  fn advance(self: &Self, state: (S, U)) -> Option[((S, U), (A, B))] {
    let (leftAt, rightAt) = state
    let (leftNext, leftItem) = self.left.advance(leftAt) ?
    let (rightNext, rightItem) = self.right.advance(rightAt) ?
    Some(((leftNext, rightNext), (leftItem, rightItem)))
  }
}

/// The leading items of a sequence that a test accepts.
///
/// The walk ends at the first refused item; nothing after it is produced.
///
/// ## Examples
///
/// ```
/// Iter.items([2, 4, 5, 6]).takeWhile(|n| n % 2 == 0).toArray()  // [2, 4]
/// ```
export type TakenWhile[Q, T] = { source: Q, keep: fn(T) -> Bool }

impl [S, T, Q: Sequence[S, T]] Sequence[S, T] for TakenWhile[Q, T] {
  fn begin(self: &Self) -> S { self.source.begin() }
  fn advance(self: &Self, state: S) -> Option[(S, T)] {
    let keep = self.keep
    let pair = self.source.advance(state) ?
    if keep(pair[1]) { Some(pair) } else { None }
  }
}

/// A sequence with its leading items that a test accepts left out.
///
/// The state carries whether items are still being dropped, so each source item
/// is produced once even when producing it has effects.
///
/// ## Examples
///
/// ```
/// Iter.items([2, 4, 5, 6]).dropWhile(|n| n % 2 == 0).toArray()  // [5, 6]
/// ```
export type DroppedWhile[Q, T] = { source: Q, skip: fn(T) -> Bool }

impl [S, T, Q: Sequence[S, T]] Sequence[(S, Bool), T] for DroppedWhile[Q, T] {
  fn begin(self: &Self) -> (S, Bool) { (self.source.begin(), true) }
  fn advance(self: &Self, state: (S, Bool)) -> Option[((S, Bool), T)] {
    let skip = self.skip
    var current = state[0]
    var dropping = state[1]
    loop {
      match self.source.advance(current) {
        case Some((next, item)) => {
          current = next
          if !dropping || !skip(item) { break Some(((current, false), item)) }
        }
        case None => { break None }
      }
    }
  }
}

/// The first item of a sequence and every `step`th item after it.
///
/// The state is `None` once the source has ended, so the source is never asked
/// for an item past its end.
///
/// ## Examples
///
/// ```
/// Iter.range(1, 10).stride(3).toArray()  // [1, 4, 7]
/// ```
export type Strided[Q, T] = { source: Q, step: Int }

impl [S, T, Q: Sequence[S, T]] Sequence[Option[S], T] for Strided[Q, T] {
  fn begin(self: &Self) -> Option[S] { Some(self.source.begin()) }
  fn advance(self: &Self, state: Option[S]) -> Option[(Option[S], T)] {
    let start = state ?
    let pair = self.source.advance(start) ?
    var at = pair[0]
    var ended = false
    var skipped = 1
    while !ended && skipped < self.step {
      match self.source.advance(at) {
        case Some((next, _)) => { at = next }
        case None => { ended = true }
      }
      skipped = skipped + 1
    }
    Some((if ended { None } else { Some(at) }, pair[1]))
  }
}

/// Where a chained walk is: in the first sequence or in the second.
export type ChainState[S, U] = InFirst(S) | InSecond(U)

/// The items of one sequence followed by those of another of the same item type.
///
/// ## Examples
///
/// ```
/// Iter.items(["a"]).chain(Iter.repeat("b", 2)).toArray()  // ["a", "b", "b"]
/// ```
export type Chained[P, Q, T] = { first: P, second: Q }

impl [S, U, T, P: Sequence[S, T], Q: Sequence[U, T]] Sequence[ChainState[S, U], T] for Chained[P, Q, T] {
  fn begin(self: &Self) -> ChainState[S, U] { InFirst(self.first.begin()) }
  fn advance(self: &Self, state: ChainState[S, U]) -> Option[(ChainState[S, U], T)] {
    match state {
      case InFirst(at) => match self.first.advance(at) {
        case Some((next, item)) => Some((InFirst(next), item))
        case None => self.advance(InSecond(self.second.begin()))
      }
      case InSecond(at) => {
        let pair = self.second.advance(at) ?
        Some((InSecond(pair[0]), pair[1]))
      }
    }
  }
}

/// A sequence's items, each paired with its position counting from nought.
///
/// ## Examples
///
/// ```
/// Iter.range(5, 7).enumerate().toArray()  // [(0, 5), (1, 6)]
/// ```
export type Enumerated[Q, T] = { source: Q }

impl [S, T, Q: Sequence[S, T]] Sequence[(S, Int), (Int, T)] for Enumerated[Q, T] {
  fn begin(self: &Self) -> (S, Int) { (self.source.begin(), 0) }
  fn advance(self: &Self, state: (S, Int)) -> Option[((S, Int), (Int, T))] {
    let pair = self.source.advance(state[0]) ?
    Some(((pair[0], state[1] + 1), (state[1], pair[1])))
  }
}
