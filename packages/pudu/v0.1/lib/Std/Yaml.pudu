module Std.Yaml

import Std.Text as Reading
import Std.Yaml.Block as Block
import Std.Yaml.Quoted as Quoted

/// A value a YAML document holds.
///
/// The same shape a JSON document has, because that is what YAML documents in
/// practice hold: the format's own extras — anchors, tags, multiple documents
/// in one file, the several ways of writing a string — are ways of writing
/// these, not additional kinds of value.
///
/// Numbers are kept apart as whole and fractional for the same reason `Std.Toml`
/// keeps them apart: a fractional value read into a binary float and written
/// back is no longer the text that was read, and configuration is compared as
/// text more often than it is calculated with. A fractional value is carried as
/// what was written, and a caller that wants a number converts it.
export type Yaml
  = Text(Str)
  | Whole(Int)
  | Fractional(Str)
  | Boolean(Bool)
  | Empty
  | List(Array[Yaml])
  | Mapping(Array[(Str, Yaml)])

/// Why text does not name a document.
export type YamlError
  = BadIndent(Int)
  | Unterminated(Int)
  | Malformed(Int, Str)
  | TabIndent(Int)
  | TooDeep(Int)

/// The most blocks one document may nest.
///
/// Reading recurses once per indented block, and the evaluator bounds how deep
/// calls may go, so a document nested past that bound would stop the whole
/// program rather than answer an error. This bound refuses it as `TooDeep`, at
/// the line that opened the block too deep, well inside the evaluator's limit.
const MAX_DEPTH: Int = 512

/// What this reads, and what it does not.
///
/// A configuration file — a deployment manifest, a pipeline definition, a
/// service's own settings — is written in a subset of YAML, and this is that
/// subset: block mappings and sequences, flow mappings and sequences on one
/// line, quoted and plain scalars, block scalars written with `|` and `>`,
/// comments, and the `---` that separates documents.
///
/// What it does not read, it refuses rather than guesses at: anchors and
/// aliases (`&name`, `*name`), explicit tags (`!!str`), complex keys (`? `),
/// and merge keys (`<<`). Each of those changes what a document means, and a
/// reader that skipped one would answer with a document that is not the one
/// written. Refusing says so.
///
/// Tabs are refused as indentation because the format refuses them, and
/// because a file mixing them with spaces reads differently in every editor.
fn readable() -> Bool { true }

type Line = Block.Line

/// Read a document.
export fn decode(source: Str) -> Result[Yaml, YamlError] {
  let lines = significantLines(source) ?
  if lines.length() == 0 {
    return Ok(Empty)
  }
  let parsed = parseBlock(&lines, 0, lines[0].indent, 1) ?
  Ok(parsed[0])
}

fn significantLines(source: Str) -> Result[Array[Line], YamlError] {
  match Block.lines(source) {
    case Ok(lines) => Ok(lines)
    case Err(problem) => match problem {
      case Block.TabIndent(line) => Err(TabIndent(line))
      case Block.BadIndent(line) => Err(BadIndent(line))
    }
  }
}

/// Read the run of lines indented at one level, and answer where it ended.
///
/// `depth` counts this block among the blocks open around it.
fn parseBlock(
  lines: &Array[Line],
  from: Int,
  indent: Int,
  depth: Int
) -> Result[(Yaml, Int), YamlError] {
  if from >= lines.length() {
    return Ok((Empty, from))
  }
  if depth > MAX_DEPTH {
    return Err(TooDeep(lines[from].number))
  }
  if lines[from].content.startsWith("- ") || lines[from].content == "-" {
    return parseSequence(lines, from, indent, depth)
  }
  parseMapping(lines, from, indent, depth)
}

fn parseSequence(
  lines: &Array[Line],
  from: Int,
  indent: Int,
  depth: Int
) -> Result[(Yaml, Int), YamlError] {
  var items: Array[Yaml] = []
  var index = from
  while index < lines.length() && lines[index].indent == indent {
    let line = lines[index]
    if !line.content.startsWith("- ") && line.content != "-" {
      break
    }
    let rest = if line.content == "-" { "" } else { Reading.trimStart(Reading.drop(line.content, 2)) }
    if rest.isEmpty() {
      // The item is whatever is written under it.
      if index + 1 < lines.length() && lines[index + 1].indent > indent {
        let nested = parseBlock(lines, index + 1, lines[index + 1].indent, depth + 1) ?
        items = items.push(nested[0])
        index = nested[1]
      } else {
        items = items.push(Empty)
        index = index + 1
      }
    } else if isBlockMarker(rest) {
      let held = parseBlockScalar(lines, index + 1, rest)
      items = items.push(held[0])
      index = held[1]
    } else if isKeyLine(rest) {
      // An item that is itself a mapping, written on the dash's own line.
      let inlineIndent = indent + 2
      let held = parseInlineMapping(lines, index, inlineIndent, rest, depth) ?
      items = items.push(held[0])
      index = held[1]
    } else {
      items = items.push(scalarOf(rest, line.number) ?)
      index = index + 1
    }
  }
  Ok((List(items), index))
}

/// A mapping whose first key shares the line of the dash that introduced it.
fn parseInlineMapping(
  lines: &Array[Line],
  from: Int,
  indent: Int,
  first: Str,
  depth: Int
) -> Result[(Yaml, Int), YamlError] {
  let split = splitKey(first, lines[from].number) ?
  var entries: Array[(Str, Yaml)] = []
  var index = from + 1
  if isBlockMarker(split[1]) {
    let held = parseBlockScalar(lines, index, split[1])
    entries = entries.push((split[0], held[0]))
    index = held[1]
  } else if split[1].isEmpty() {
    if index < lines.length() && lines[index].indent >= indent {
      let nested = parseBlock(lines, index, lines[index].indent, depth + 1) ?
      entries = entries.push((split[0], nested[0]))
      index = nested[1]
    } else {
      entries = entries.push((split[0], Empty))
    }
  } else {
    entries = entries.push((split[0], scalarOf(split[1], lines[from].number) ?))
  }
  // The remaining keys of the same mapping are indented under the dash.
  while index < lines.length() && lines[index].indent == indent {
    let line = lines[index]
    if line.content.startsWith("- ") || !isKeyLine(line.content) {
      break
    }
    let pair = splitKey(line.content, line.number) ?
    if pair[1].isEmpty() {
      if index + 1 < lines.length() && lines[index + 1].indent > indent {
        let nested = parseBlock(lines, index + 1, lines[index + 1].indent, depth + 1) ?
        entries = entries.push((pair[0], nested[0]))
        index = nested[1]
      } else if index + 1 < lines.length()
        && lines[index + 1].indent == indent
        && (lines[index + 1].content.startsWith("- ") || lines[index + 1].content == "-") {
        let nested = parseBlock(lines, index + 1, indent, depth + 1) ?
        entries = entries.push((pair[0], nested[0]))
        index = nested[1]
      } else {
        entries = entries.push((pair[0], Empty))
        index = index + 1
      }
    } else if isBlockMarker(pair[1]) {
      let folded = parseBlockScalar(lines, index + 1, pair[1])
      entries = entries.push((pair[0], folded[0]))
      index = folded[1]
    } else {
      entries = entries.push((pair[0], scalarOf(pair[1], line.number) ?))
      index = index + 1
    }
  }
  Ok((Mapping(entries), index))
}

fn parseMapping(
  lines: &Array[Line],
  from: Int,
  indent: Int,
  depth: Int
) -> Result[(Yaml, Int), YamlError] {
  var entries: Array[(Str, Yaml)] = []
  var index = from
  while index < lines.length() && lines[index].indent == indent {
    let line = lines[index]
    if line.content.startsWith("- ") {
      break
    }
    if !isKeyLine(line.content) {
      return Err(Malformed(line.number, "a mapping needs a key"))
    }
    let pair = splitKey(line.content, line.number) ?
    if isBlockMarker(pair[1]) {
      let folded = parseBlockScalar(lines, index + 1, pair[1])
      entries = entries.push((pair[0], folded[0]))
      index = folded[1]
    } else if pair[1].isEmpty() {
      if index + 1 < lines.length() && lines[index + 1].indent > indent {
        let nested = parseBlock(lines, index + 1, lines[index + 1].indent, depth + 1) ?
        entries = entries.push((pair[0], nested[0]))
        index = nested[1]
      } else if index + 1 < lines.length()
        && lines[index + 1].indent == indent
        && lines[index + 1].content.startsWith("- ") {
        // A sequence written level with its key, which is allowed and common.
        let nested = parseSequence(lines, index + 1, indent, depth + 1) ?
        entries = entries.push((pair[0], nested[0]))
        index = nested[1]
      } else {
        entries = entries.push((pair[0], Empty))
        index = index + 1
      }
    } else {
      entries = entries.push((pair[0], scalarOf(pair[1], line.number) ?))
      index = index + 1
    }
  }
  if index == from {
    return Err(BadIndent(lines[from].number))
  }
  Ok((Mapping(entries), index))
}

fn isBlockMarker(value: Str) -> Bool { Block.marker(value) }

fn parseBlockScalar(lines: &Array[Line], from: Int, marker: Str) -> (Yaml, Int) {
  let held = Block.scalar(lines, from, marker)
  (Text(held[0]), held[1])
}

/// Whether a line is `key: value` rather than a bare scalar.
///
/// Only a quote can hide a colon, so a line without one is decided by native
/// searches and the walk below is left to the lines that quote something.
fn isKeyLine(value: Str) -> Bool { Quoted.colon(value) >= 0 }

fn splitKey(value: Str, line: Int) -> Result[(Str, Str), YamlError] {
  let colon = Quoted.colon(value)
  if colon < 0 { return Ok((quotedText(value, line) ?, "")) }
  let name = quotedText(Reading.trimEnd(value.take(colon)), line) ?
  Ok((name, Reading.trimStart(value.drop(colon + 1))))
}

fn quotedText(value: Str, line: Int) -> Result[Str, YamlError] {
  match Quoted.decode(value) {
    case Ok(text) => Ok(text)
    case Err(problem) => match problem {
      case Quoted.Unterminated => Err(Unterminated(line))
      case Quoted.Invalid(what) => Err(Malformed(line, what))
    }
  }
}

/// What a scalar written on one line means.
///
/// The order matters: a quoted value is text whatever it looks like, which is
/// why `"true"` and `"1"` survive as text. Everything else is read as the kind
/// it is written as, which is what a configuration file means by `replicas: 3`.
fn scalarOf(value: Str, line: Int) -> Result[Yaml, YamlError] {
  if value.startsWith("\"") || value.startsWith("'") {
    return Ok(Text(quotedText(value, line) ?))
  }
  if value.startsWith("[") || value.startsWith("\{") { return flowOf(value, line) }
  if value == "null" || value == "~" || value.isEmpty() { return Ok(Empty) }
  if value == "true" || value == "True" || value == "yes" { return Ok(Boolean(true)) }
  if value == "false" || value == "False" || value == "no" { return Ok(Boolean(false)) }
  Ok(match wholeOf(value) {
      case Some(number) => Whole(number)
      case None => if looksFractional(value) { Fractional(value) } else { Text(value) }
    })
}

/// A sequence or mapping written on one line.
fn flowOf(value: Str, line: Int) -> Result[Yaml, YamlError] {
  if !(value.startsWith("[") && value.endsWith("]")) && !(value.startsWith("\{") && value.endsWith("\}")) { return Err(Unterminated(line)) }
  let inner = Reading.trimStart(Reading.trimEnd(Reading.drop(Reading.take(value, value.length() - 1), 1)))
  if inner.isEmpty() {
    return Ok(if value.startsWith("[") { List([]) } else { Mapping([]) })
  }
  let pieces = splitFlow(inner)
  if value.startsWith("[") {
    var items: Array[Yaml] = []
    var index = 0
    while index < pieces.length() {
      items = items.push(scalarOf(Reading.trimStart(Reading.trimEnd(pieces[index])), line) ?)
      index = index + 1
    }
    return Ok(List(items))
  }
  var entries: Array[(Str, Yaml)] = []
  var index = 0
  while index < pieces.length() {
    let pair = splitKey(Reading.trimStart(Reading.trimEnd(pieces[index])), line) ?
    entries = entries.push((pair[0], scalarOf(pair[1], line) ?))
    index = index + 1
  }
  Ok(Mapping(entries))
}

/// A flow collection cut at its commas, ignoring commas inside a nested one.
fn splitFlow(value: Str) -> Array[Str] { Quoted.pieces(value) }

/// A whole number written as one, with an optional sign.
///
/// Read by `Std.Text`, which answers nothing for digits past what an `Int`
/// holds, so `replicas: 99999999999999999999` is text rather than a stopped
/// program. A scalar reaches here already trimmed, so its trimming changes
/// nothing.
fn wholeOf(value: Str) -> Option[Int] { Reading.wholeOf(value) }

fn looksFractional(value: Str) -> Bool {
  let chars = value.chars()
  var seenDot = false
  var seenDigit = false
  var index = 0
  while index < chars.length() {
    let here = chars[index]
    if here == '.' {
      if seenDot { return false }
      seenDot = true
    } else if here >= '0' && here <= '9' {
      seenDigit = true
    } else if !(index == 0 && (here == '-' || here == '+')) {
      return false
    }
    index = index + 1
  }
  seenDot && seenDigit
}

/// The value under a key of a mapping, or nothing when there is none.
export fn field(value: &Yaml, name: Str) -> Option[Yaml] {
  match *value {
    case Mapping(entries) => {
      var index = 0
      while index < entries.length() {
        if entries[index][0] == name {
          return Some(entries[index][1])
        }
        index = index + 1
      }
      None
    }
    case _ => None
  }
}

/// The value at a position of a sequence.
export fn at(value: &Yaml, index: Int) -> Option[Yaml] {
  match *value {
    case List(items) => {
      if index < 0 || index >= items.length() {
        None
      } else {
        Some(items[index])
      }
    }
    case _ => None
  }
}

/// A value reached by a dotted path, which is how a setting is usually named.
export fn path(value: &Yaml, dotted: Str) -> Option[Yaml] {
  let names = dotted.split(".")
  var current = *value
  var index = 0
  while index < names.length() {
    current = field(&current, names[index]) ?
    index = index + 1
  }
  Some(current)
}

/// The value as text, or nothing when it is not text.
export fn asText(value: &Yaml) -> Option[Str] {
  match *value {
    case Text(held) => Some(held)
    case _ => None
  }
}

/// The value as a whole number, or nothing when it is not one.
export fn asWhole(value: &Yaml) -> Option[Int] {
  match *value {
    case Whole(held) => Some(held)
    case _ => None
  }
}

/// The value as a fractional number written out, or nothing.
export fn asFractional(value: &Yaml) -> Option[Str] {
  match *value {
    case Fractional(held) => Some(held)
    case _ => None
  }
}

/// The value as a truth value, or nothing when it is not one.
export fn asBoolean(value: &Yaml) -> Option[Bool] {
  match *value {
    case Boolean(held) => Some(held)
    case _ => None
  }
}

/// The value as a list, or nothing when it is not one.
export fn asList(value: &Yaml) -> Option[Array[Yaml]] {
  match *value {
    case List(items) => Some(items)
    case _ => None
  }
}

/// The value as named entries, or nothing when it is not a mapping.
export fn asMapping(value: &Yaml) -> Option[Array[(Str, Yaml)]] {
  match *value {
    case Mapping(entries) => Some(entries)
    case _ => None
  }
}

/// Whether a document holds nothing at this place.
export fn isEmpty(value: &Yaml) -> Bool {
  match *value {
    case Empty => true
    case _ => false
  }
}

/// The keys of a mapping, in the order they were written.
export fn keys(value: &Yaml) -> Array[Str] {
  match *value {
    case Mapping(entries) => {
      var names: Array[Str] = []
      var index = 0
      while index < entries.length() {
        names = names.push(entries[index][0])
        index = index + 1
      }
      names
    }
    case _ => []
  }
}

/// Why a document was refused, written for a person to read.
export fn explain(reason: &YamlError) -> Str {
  match *reason {
    case BadIndent(line) => "line " + display(line) + " is indented past anything that opened"
    case Unterminated(line) => "the value opened at line " + display(line) + " is not closed"
    case Malformed(line, what) => "line " + display(line) + ": " + what
    case TabIndent(line) => "line " + display(line) + " is indented with a tab, which means different widths in different editors"
    case TooDeep(line) => "line " + display(line) + " opens a block nested deeper than " + display(MAX_DEPTH) + " levels"
  }
}
