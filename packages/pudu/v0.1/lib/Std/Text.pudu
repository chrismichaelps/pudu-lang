module Std.Text

/// Whether text contains only whitespace, or nothing at all.
///
/// Empty text is blank, which is the answer that makes a validity check read the
/// way it is meant: a field the user left alone and a field they filled with spaces
/// are both unfilled.
///
/// ## Examples
///
/// ```
/// Text.isBlank("")     // true
/// Text.isBlank("  ")   // true
/// Text.isBlank(" a ")  // false
/// ```
export fn isBlank(value: Str) -> Bool { value.trim().isEmpty() }

/// The position of the first occurrence, or `None` when there is none.
///
/// The built-in `indexOf` answers `-1`; this is the form a caller can match on
/// without remembering which sentinel means absent. An empty needle is found at the
/// start.
///
/// ## Examples
///
/// ```
/// Text.find("hello", "ll")  // Some(2)
/// Text.find("hello", "z")   // None
/// ```
export fn find(haystack: Str, needle: Str) -> Option[Int] {
  let found = haystack.indexOf(needle)
  if found < 0 { None } else { Some(found) }
}

/// Text with a prefix removed, or unchanged when it is not there.
///
/// Unchanged rather than absent, so it can be applied without checking first. When
/// the difference matters, ask `startsWith` before calling.
///
/// ## Examples
///
/// ```
/// Text.stripPrefix("unhappy", "un")  // "happy"
/// Text.stripPrefix("happy", "un")    // "happy"
/// ```
export fn stripPrefix(value: Str, prefix: Str) -> Str {
  if value.startsWith(prefix) { value.slice(prefix.length(), value.length()) } else { value }
}

/// Text with a suffix removed, or unchanged when it is not there.
///
/// The mirror of `stripPrefix`, with the same forgiving behaviour for a miss.
///
/// ## Examples
///
/// ```
/// Text.stripSuffix("report.txt", ".txt")  // "report"
/// Text.stripSuffix("report", ".txt")      // "report"
/// ```
export fn stripSuffix(value: Str, suffix: Str) -> Str {
  if value.endsWith(suffix) { value.slice(0, value.length() - suffix.length()) } else { value }
}

/// The first `wanted` characters, or the whole text when it is shorter.
///
/// Counts outside the text are pulled inside it, so truncating for display never
/// needs a length check first.
///
/// ## Examples
///
/// ```
/// Text.take("hello", 2)   // "he"
/// Text.take("hi", 99)     // "hi"
/// Text.take("hi", -1)     // ""
/// ```
export fn take(value: Str, wanted: Int) -> Str {
  if wanted <= 0 { "" } else {
    if wanted >= value.length() { value } else { value.slice(0, wanted) }
  }
}

/// Every character after the first `skipped`.
///
/// The complement of `take` at the same count, with the same treatment of counts
/// outside the text.
///
/// ## Examples
///
/// ```
/// Text.drop("hello", 2)  // "llo"
/// Text.drop("hi", 99)    // ""
/// ```
export fn drop(value: Str, skipped: Int) -> Str {
  if skipped <= 0 { value } else {
    if skipped >= value.length() { "" } else { value.slice(skipped, value.length()) }
  }
}

/// Text padded on the left to at least `width` characters.
///
/// Text already at or past the width is returned unchanged rather than truncated,
/// so padding never loses anything. Right-aligning a column is the usual reason to
/// reach for it.
///
/// ## Examples
///
/// ```
/// Text.padLeft("7", 3, "0")     // "007"
/// Text.padLeft("1234", 3, "0")  // "1234"
/// ```
export fn padLeft(value: Str, width: Int, filler: Str) -> Str {
  var out = value
  while out.length() < width { out = filler + out }
  out
}

/// Text padded on the right to at least `width` characters.
///
/// The mirror of `padLeft`, and what left-aligning a column needs. Equally
/// non-truncating.
///
/// ## Examples
///
/// ```
/// Text.padRight("ab", 4, ".")  // "ab.."
/// ```
export fn padRight(value: Str, width: Int, filler: Str) -> Str {
  var out = value
  while out.length() < width { out = out + filler }
  out
}

/// Every piece joined with a separator between them.
///
/// The separator appears only between pieces, so a single piece comes back
/// unchanged and an empty array gives empty text. The inverse of splitting.
///
/// ## Examples
///
/// ```
/// Text.join(&["a", "b", "c"], ", ")  // "a, b, c"
/// Text.join(&["a"], ", ")            // "a"
/// Text.join(&[], ", ")               // ""
/// ```
export fn join(pieces: &Array[Str], separator: Str) -> Str { pieces.join(separator) }

/// The pieces of text separated by a separator, with empty pieces removed.
///
/// The built-in `split` keeps them, because "a,,b" has three fields; this is the
/// form for splitting on whitespace runs and similar, where a run of separators
/// means one boundary rather than several empty values.
///
/// ## Examples
///
/// ```
/// Text.splitNonEmpty("a,,b", ",")   // ["a", "b"]
/// "a,,b".split(",")                 // ["a", "", "b"]
/// ```
export fn splitNonEmpty(value: Str, separator: Str) -> Array[Str] {
  let pieces = value.split(separator)
  var out = []
  for piece in pieces {
    if piece.isEmpty() {} else { out = out.push(piece) }
  }
  out
}

/// Every word, splitting on single spaces and discarding empty pieces.
///
/// Leading and trailing whitespace is trimmed first, and runs of spaces collapse to
/// one boundary, so ordinary prose splits the way a reader expects.
///
/// ## Examples
///
/// ```
/// Text.words("  a  b ")  // ["a", "b"]
/// Text.words("")         // []
/// ```
export fn words(value: Str) -> Array[Str] { splitNonEmpty(value.trim(), " ") }

/// How many times a needle occurs, without overlapping.
///
/// Non-overlapping: after a match the search resumes past it, so "aaa" holds one
/// "aa" rather than two. That is the count a replace would make.
///
/// ## Examples
///
/// ```
/// Text.countOccurrences("banana", "na")  // 2
/// Text.countOccurrences("aaa", "aa")     // 1
/// ```
export fn countOccurrences(haystack: Str, needle: Str) -> Int {
  if needle.isEmpty() { 0 } else {
    var total = 0
    var remaining = haystack
    while remaining.contains(needle) {
      let found = remaining.indexOf(needle)
      total = total + 1
      remaining = remaining.slice(found + needle.length(), remaining.length())
    }
    total
  }
}

/// Text with its first character in upper case and the rest unchanged.
///
/// Only the first character is touched, so an acronym or a mid-word capital
/// survives. `toTitle` is the form that treats every word.
///
/// ## Examples
///
/// ```
/// Text.capitalize("hello world")  // "Hello world"
/// Text.capitalize("iOS")          // "IOS"
/// ```
export fn capitalize(value: Str) -> Str {
  if value.isEmpty() { value } else {
    value.slice(0, 1).toUpper() + value.slice(1, value.length())
  }
}

/// Whether two texts are equal ignoring case.
///
/// Case is folded on both sides before comparing. Use it for identifiers that are
/// case-insensitive by rule, such as header names, rather than for user-facing
/// text where locale rules matter.
///
/// ## Examples
///
/// ```
/// Text.equalsIgnoreCase("Content-Type", "content-type")  // true
/// ```
export fn equalsIgnoreCase(left: Str, right: Str) -> Bool {
  left.toLower() == right.toLower()
}

/// Text of exactly one character.
///
/// The bridge from a `Char` to a `Str`, for the places where text is wanted and a
/// character is what you have.
///
/// ## Examples
///
/// ```
/// Text.singleton('a')  // "a"
/// ```
export fn singleton(value: Char) -> Str { "" + textOf(value) }

/// A character placed before some text.
///
/// Building text from the front, which is what an unfold or a recursive walk
/// produces. `uncons` takes it apart again.
///
/// ## Examples
///
/// ```
/// Text.cons('h', "ello")  // "hello"
/// ```
export fn cons(front: Char, tail: Str) -> Str { textOf(front) + tail }

/// A character placed after some text.
///
/// The mirror of `cons`, for building text from the back.
///
/// ## Examples
///
/// ```
/// Text.snoc("hell", 'o')  // "hello"
/// ```
export fn snoc(front: Str, tail: Char) -> Str { front + textOf(tail) }

/// The first character and the rest, or `None` for empty text.
///
/// The total way to walk text one character at a time: the `None` ends the walk
/// without a length check. The inverse of `cons`.
///
/// ## Examples
///
/// ```
/// Text.uncons("hi")  // Some(('h', "i"))
/// Text.uncons("")    // None
/// ```
export fn uncons(value: Str) -> Option[(Char, Str)] {
  if value.isEmpty() { None } else {
    Some((value.charAt(0), value.slice(1, value.length())))
  }
}

/// Everything but the last character and that character, or `None` when empty.
///
/// The mirror of `uncons`, and the inverse of `snoc`.
///
/// ## Examples
///
/// ```
/// Text.unsnoc("hi")  // Some(("h", 'i'))
/// Text.unsnoc("")    // None
/// ```
export fn unsnoc(value: Str) -> Option[(Str, Char)] {
  let size = value.length()
  if size == 0 { None } else {
    Some((value.slice(0, size - 1), value.charAt(size - 1)))
  }
}

/// The character at a position, or `None` when there is none.
///
/// The built-in `charAt` fails outside the text; this is the total form. Negative
/// positions and positions past the end both answer `None`.
///
/// ## Examples
///
/// ```
/// Text.at("hi", 1)   // Some('i')
/// Text.at("hi", 9)   // None
/// ```
export fn at(value: Str, index: Int) -> Option[Char] {
  if index < 0 || index >= value.length() { None } else { Some(value.charAt(index)) }
}

/// The first character, or `None` for empty text.
///
/// `at` at position nought, named for what it is. Use `uncons` when the rest of the
/// text is wanted as well.
///
/// ## Examples
///
/// ```
/// Text.head("hi")  // Some('h')
/// Text.head("")    // None
/// ```
export fn head(value: Str) -> Option[Char] { at(value, 0) }

/// The last character, or `None` for empty text.
///
/// The mirror of `head`.
///
/// ## Examples
///
/// ```
/// Text.last("hi")  // Some('i')
/// ```
export fn last(value: Str) -> Option[Char] { at(value, value.length() - 1) }

/// Everything but the first character. Empty text answers empty text.
///
/// Total, so repeated use drains text safely rather than failing at the end.
///
/// ## Examples
///
/// ```
/// Text.rest("hi")  // "i"
/// Text.rest("")    // ""
/// ```
export fn rest(value: Str) -> Str { value.slice(1, value.length()) }

/// Everything but the last character.
///
/// The mirror of `rest`, and equally total on empty text.
///
/// ## Examples
///
/// ```
/// Text.initial("hi")  // "h"
/// Text.initial("")    // ""
/// ```
export fn initial(value: Str) -> Str {
  let size = value.length()
  if size == 0 { value } else { value.slice(0, size - 1) }
}

/// Every character transformed.
///
/// The result has the same number of characters as the input, since each one is
/// replaced rather than expanded. `flatMapChars` is the form that can change the
/// length.
///
/// ## Examples
///
/// ```
/// Text.mapChars("abc", fn(c: Char) -> Char => Char.toUpper(c))  // "ABC"
/// ```
export fn mapChars(value: Str, transform: fn(Char) -> Char) -> Str {
  var out = ""
  for character in value.chars() { out = out + textOf(transform(character)) }
  out
}

/// Only the characters the predicate accepts.
///
/// Order is preserved. The usual way to strip a class of characters — punctuation,
/// non-digits — without writing a replace for each one.
///
/// ## Examples
///
/// ```
/// Text.filterChars("a1b2", fn(c: Char) -> Bool => Char.isDigit(c))  // "12"
/// ```
export fn filterChars(value: Str, keep: fn(Char) -> Bool) -> Str {
  var out = ""
  for character in value.chars() {
    if keep(character) { out = out + textOf(character) }
  }
  out
}

/// The longest leading run of characters the predicate accepts.
///
/// Stops at the first rejected character and ignores the rest, which is what
/// reading a token off the front of text needs.
///
/// ## Examples
///
/// ```
/// Text.takeWhile("123abc", fn(c: Char) -> Bool => Char.isDigit(c))  // "123"
/// ```
export fn takeWhile(value: Str, holds: fn(Char) -> Bool) -> Str {
  value.slice(0, prefixLength(value, holds))
}

/// Everything after the longest leading run the predicate accepts.
///
/// The remainder `takeWhile` left, so the two joined give back the original.
///
/// ## Examples
///
/// ```
/// Text.dropWhile("123abc", fn(c: Char) -> Bool => Char.isDigit(c))  // "abc"
/// ```
export fn dropWhile(value: Str, holds: fn(Char) -> Bool) -> Str {
  value.slice(prefixLength(value, holds), value.length())
}

/// The longest leading run the predicate accepts, and the rest.
///
/// `takeWhile` and `dropWhile` in one pass, which is what a hand-written scanner
/// wants: the token and what is left to read.
///
/// ## Examples
///
/// ```
/// Text.span("123abc", fn(c: Char) -> Bool => Char.isDigit(c))  // ("123", "abc")
/// ```
export fn span(value: Str, holds: fn(Char) -> Bool) -> (Str, Str) {
  let cut = prefixLength(value, holds)
  (value.slice(0, cut), value.slice(cut, value.length()))
}

/// The text before the first occurrence of a needle, and the rest including it.
///
/// A miss answers with the whole text and empty text, so a caller that concatenates
/// the two halves always gets back what it started with. The needle stays on the
/// second half, which is what lets a loop consume it deliberately.
///
/// ## Examples
///
/// ```
/// Text.breakOn("key=value", "=")  // ("key", "=value")
/// Text.breakOn("key", "=")        // ("key", "")
/// ```
export fn breakOn(value: Str, needle: Str) -> (Str, Str) {
  let found = value.indexOf(needle)
  if found < 0 { (value, "") } else {
    (value.slice(0, found), value.slice(found, value.length()))
  }
}

/// The text split at a position.
///
/// The two parts always rejoin to the original, and a position outside the text
/// puts everything in one side rather than failing.
///
/// ## Examples
///
/// ```
/// Text.splitAt("hello", 2)  // ("he", "llo")
/// ```
export fn splitAt(value: Str, position: Int) -> (Str, Str) {
  let size = value.length()
  let boundary = clampIndex(position, size)
  (value.slice(0, boundary), value.slice(boundary, size))
}

/// The characters the predicate accepts, and the characters it rejects.
///
/// Every character lands in exactly one side and order is kept in both, so the two
/// sides together hold the whole text.
///
/// ## Examples
///
/// ```
/// Text.partition("a1b2", fn(c: Char) -> Bool => Char.isDigit(c))  // ("12", "ab")
/// ```
export fn partition(value: Str, keep: fn(Char) -> Bool) -> (Str, Str) {
  var kept = ""
  var rejected = ""
  for character in value.chars() {
    if keep(character) { kept = kept + textOf(character) }
      else { rejected = rejected + textOf(character) }
  }
  (kept, rejected)
}

/// Whitespace removed from the start.
///
/// The same ASCII whitespace set the rest of this module uses. Text that is all
/// whitespace becomes empty.
///
/// ## Examples
///
/// ```
/// Text.trimStart("  hi  ")  // "hi  "
/// ```
export fn trimStart(value: Str) -> Str { dropWhile(value, isSpace) }

/// Whitespace removed from the end.
///
/// The mirror of `trimStart`; the built-in `trim` does both.
///
/// ## Examples
///
/// ```
/// Text.trimEnd("  hi  ")  // "  hi"
/// ```
export fn trimEnd(value: Str) -> Str {
  var size = value.length()
  while size > 0 && isSpace(value.charAt(size - 1)) { size = size - 1 }
  value.slice(0, size)
}

/// Text padded on both sides to at least `width` characters.
///
/// An odd amount of padding is not split evenly; the text is never truncated, as
/// with the other padding functions.
///
/// ## Examples
///
/// ```
/// Text.center("ab", 6, "-")  // "--ab--"
/// ```
export fn center(value: Str, width: Int, filler: Str) -> Str {
  var out = value
  var left = true
  while out.length() < width {
    if left { out = filler + out } else { out = out + filler }
    left = !left
  }
  out
}

/// The text in pieces of at most `size` characters.
///
/// Only the final piece may be shorter. A size of nought or less gives no pieces
/// rather than an endless supply of empty ones.
///
/// ## Examples
///
/// ```
/// Text.chunksOf("abcde", 2)  // ["ab", "cd", "e"]
/// ```
export fn chunksOf(value: Str, size: Int) -> Array[Str] {
  var out = []
  if size <= 0 { out } else {
    var index = 0
    let total = value.length()
    while index < total {
      let end = if index + size > total { total } else { index + size }
      out = out.push(value.slice(index, end))
      index = index + size
    }
    out
  }
}

/// Every character, as an array.
///
/// The bridge into the array functions, for the operations `Std.Text` does not name
/// directly. `fromChars` brings the result back.
///
/// ## Examples
///
/// ```
/// Text.toChars("abc")  // ['a', 'b', 'c']
/// ```
export fn toChars(value: Str) -> Array[Char] { value.chars() }

/// Text rebuilt from characters.
///
/// The inverse of `toChars`, so a round trip through the array functions returns
/// the text it started with.
///
/// ## Examples
///
/// ```
/// Text.fromChars(&['a', 'b'])  // "ab"
/// ```
export fn fromChars(characters: &Array[Char]) -> Str {
  var out = ""
  for character in characters { out = out + textOf(character) }
  out
}

/// The longest text both begin with, and what remains of each after it.
///
/// All three parts at once, because a caller that wants the shared prefix almost
/// always wants the point where the two diverge. The prefix joined to either
/// remainder gives back that input.
///
/// ## Examples
///
/// ```
/// Text.commonPrefix("testing", "tested")  // ("test", "ing", "ed")
/// Text.commonPrefix("a", "b")             // ("", "a", "b")
/// ```
export fn commonPrefix(left: Str, right: Str) -> (Str, Str, Str) {
  var shared = 0
  let limit = if left.length() < right.length() { left.length() } else { right.length() }
  while shared < limit && left.charAt(shared) == right.charAt(shared) { shared = shared + 1 }
  (left.slice(0, shared)
    , left.slice(shared, left.length())
    , right.slice(shared, right.length())
  )
}

/// Whether every character satisfies the predicate. True for empty text.
///
/// True for nothing is what makes the answer compose across a join: the whole holds
/// exactly when both parts do.
///
/// ## Examples
///
/// ```
/// Text.allChars("123", fn(c: Char) -> Bool => Char.isDigit(c))  // true
/// Text.allChars("", fn(c: Char) -> Bool => Char.isDigit(c))     // true
/// ```
export fn allChars(value: Str, holds: fn(Char) -> Bool) -> Bool {
  for character in value.chars() {
    if !holds(character) { return false }
  }
  true
}

/// Whether any character satisfies the predicate. False for empty text.
///
/// The complement of `allChars` under a negated predicate, and false for nothing
/// for the matching reason.
///
/// ## Examples
///
/// ```
/// Text.anyChar("a1", fn(c: Char) -> Bool => Char.isDigit(c))  // true
/// ```
export fn anyChar(value: Str, holds: fn(Char) -> Bool) -> Bool {
  for character in value.chars() {
    if holds(character) { return true }
  }
  false
}

/// How many characters satisfy the predicate.
///
/// The length `filterChars` would have produced, without building the filtered
/// text.
///
/// ## Examples
///
/// ```
/// Text.countChars("a1b2", fn(c: Char) -> Bool => Char.isDigit(c))  // 2
/// ```
export fn countChars(value: Str, holds: fn(Char) -> Bool) -> Int {
  var total = 0
  for character in value.chars() {
    if holds(character) { total = total + 1 }
  }
  total
}

/// The position of the first character the predicate accepts, or `None`.
///
/// Stops at the first match. The position is valid against the text it was asked
/// about.
///
/// ## Examples
///
/// ```
/// Text.findIndex("ab1", fn(c: Char) -> Bool => Char.isDigit(c))  // Some(2)
/// ```
export fn findIndex(value: Str, holds: fn(Char) -> Bool) -> Option[Int] {
  var index = 0
  let size = value.length()
  while index < size {
    if holds(value.charAt(index)) { return Some(index) }
    index = index + 1
  }
  None
}

/// The first character the predicate accepts, or `None`.
///
/// The character rather than its position, for callers that want the value itself.
///
/// ## Examples
///
/// ```
/// Text.findChar("ab1", fn(c: Char) -> Bool => Char.isDigit(c))  // Some('1')
/// ```
export fn findChar(value: Str, holds: fn(Char) -> Bool) -> Option[Char] {
  for character in value.chars() {
    if holds(character) { return Some(character) }
  }
  None
}

/// Whether text is a space, tab, carriage return, or newline.
/// Repeated here rather than imported so `Std.Text` stands on its own; the same
/// ASCII set `Std.Char` uses.
fn isSpace(value: Char) -> Bool {
  value == ' ' || value == '\t' || value == '\r' || value == '\n'
}

/// One character as text, which is the conversion the language provides.
fn textOf(value: Char) -> Str { value.toText() }

/// The length of the longest leading run the predicate accepts.
fn prefixLength(value: Str, holds: fn(Char) -> Bool) -> Int {
  var cut = 0
  let size = value.length()
  while cut < size && holds(value.charAt(cut)) { cut = cut + 1 }
  cut
}

/// Confine an index to the text's bounds.
fn clampIndex(index: Int, limit: Int) -> Int {
  if index < 0 { 0 } else { if index > limit { limit } else { index } }
}

/// Every character folded into one value, left to right.
///
/// `start` is the answer for empty text and the left argument of the first step,
/// which is what lets a fold over joined text equal the fold of one part continued
/// into the other.
///
/// ## Examples
///
/// ```
/// Text.foldChars("abc", fn(n: Int, c: Char) -> Int => n + 1, 0)  // 3
/// ```
export fn foldChars[A](value: Str, combine: fn(A, Char) -> A, start: A) -> A {
  var accumulated = start
  for character in value.chars() { accumulated = combine(accumulated, character) }
  accumulated
}

/// Every character folded into one value, right to left.
///
/// The direction matters for any step that is not associative, exactly as it does
/// for arrays.
///
/// ## Examples
///
/// ```
/// Text.foldCharsRight("abc", fn(c: Char, acc: Str) -> Str => acc + Text.singleton(c), "")
/// // "cba"
/// ```
export fn foldCharsRight[A](value: Str, combine: fn(Char, A) -> A, start: A) -> A {
  var accumulated = start
  var index = value.length()
  while index > 0 {
    index = index - 1
    accumulated = combine(value.charAt(index), accumulated)
  }
  accumulated
}

/// Every character transformed into text, and that text joined.
///
/// The form that can change the length: a character may become nothing, one
/// character, or several. Escaping is the usual reason to reach for it.
///
/// ## Examples
///
/// ```
/// Text.flatMapChars("a<b", fn(c: Char) -> Str =>
///   if c == '<' { "&lt;" } else { Text.singleton(c) })  // "a&lt;b"
/// ```
export fn flatMapChars(value: Str, transform: fn(Char) -> Str) -> Str {
  var out = ""
  for character in value.chars() { out = out + transform(character) }
  out
}

/// Every running result of folding the characters.
///
/// The array begins with `start` and ends with what `foldChars` would have
/// answered, so it is one longer than the text.
///
/// ## Examples
///
/// ```
/// Text.scanChars("ab", fn(n: Int, c: Char) -> Int => n + 1, 0)  // [0, 1, 2]
/// ```
export fn scanChars[A](value: Str, combine: fn(A, Char) -> A, start: A) -> Array[A] {
  var out = [start]
  var accumulated = start
  for character in value.chars() {
    accumulated = combine(accumulated, character)
    out = out.push(accumulated)
  }
  out
}

/// Runs of adjacent equal characters, as text.
///
/// Adjacent, not equal overall, so unsorted text yields several runs of the same
/// character. Run-length encoding is the usual reason to reach for it.
///
/// ## Examples
///
/// ```
/// Text.groupChars("aabba")  // ["aa", "bb", "a"]
/// ```
export fn groupChars(value: Str) -> Array[Str] {
  var out = []
  var current = ""
  for character in value.chars() {
    if current.isEmpty() || current.charAt(0) == character {
      current = current + textOf(character)
    } else {
      out = out.push(current)
      current = textOf(character)
    }
  }
  if !current.isEmpty() { out = out.push(current) }
  out
}

/// Every prefix, shortest first.
///
/// Includes the empty prefix and the whole text, so there is one more prefix than
/// there are characters.
///
/// ## Examples
///
/// ```
/// Text.prefixes("ab")  // ["", "a", "ab"]
/// ```
export fn prefixes(value: Str) -> Array[Str] {
  var out = []
  var index = 0
  let size = value.length()
  while index <= size {
    out = out.push(value.slice(0, index))
    index = index + 1
  }
  out
}

/// Every suffix, longest first.
///
/// The mirror of `prefixes`, and one longer than the text for the same reason.
///
/// ## Examples
///
/// ```
/// Text.suffixes("ab")  // ["ab", "b", ""]
/// ```
export fn suffixes(value: Str) -> Array[Str] {
  var out = []
  var index = 0
  let size = value.length()
  while index <= size {
    out = out.push(value.slice(index, size))
    index = index + 1
  }
  out
}

/// The text after the last occurrence of a needle, and everything before it.
///
/// Empty text and the whole text when the needle is absent, so a caller that joins
/// the two halves always gets back what it started with. Splitting a path from its
/// final segment is the usual reason to reach for it.
///
/// ## Examples
///
/// ```
/// Text.breakOnEnd("a/b/c", "/")  // ("a/b/", "c")
/// ```
export fn breakOnEnd(value: Str, needle: Str) -> (Str, Str) {
  var found = 0 - 1
  var index = 0
  let size = value.length()
  let width = needle.length()
  if width == 0 { (value, "") } else {
    while index + width <= size {
      if value.slice(index, index + width) == needle { found = index }
      index = index + 1
    }
    if found < 0 { ("", value) } else {
      (value.slice(0, found + width), value.slice(found + width, size))
    }
  }
}

/// The last `wanted` characters, or the whole text when it is shorter.
///
/// `take` measured from the other end, with the same treatment of counts outside
/// the text.
///
/// ## Examples
///
/// ```
/// Text.takeEnd("hello", 2)  // "lo"
/// ```
export fn takeEnd(value: Str, wanted: Int) -> Str {
  let size = value.length()
  value.slice(clampIndex(size - wanted, size), size)
}

/// Every character but the last `skipped`.
///
/// `drop` measured from the other end.
///
/// ## Examples
///
/// ```
/// Text.dropEnd("hello", 2)  // "hel"
/// ```
export fn dropEnd(value: Str, skipped: Int) -> Str {
  let size = value.length()
  value.slice(0, clampIndex(size - skipped, size))
}

/// Trailing characters the predicate accepts removed.
///
/// Works from the end and stops at the first rejected character, which is what
/// trimming a specific trailing class needs when `trimEnd` is too narrow.
///
/// ## Examples
///
/// ```
/// Text.dropWhileEnd("1.500", fn(c: Char) -> Bool => c == '0')  // "1.5"
/// ```
export fn dropWhileEnd(value: Str, holds: fn(Char) -> Bool) -> Str {
  var size = value.length()
  while size > 0 && holds(value.charAt(size - 1)) { size = size - 1 }
  value.slice(0, size)
}

/// Leading and trailing characters the predicate accepts removed.
///
/// `dropWhile` and `dropWhileEnd` together, and the general form of `trim` for a
/// class the caller names.
///
/// ## Examples
///
/// ```
/// Text.dropAround("__hi__", fn(c: Char) -> Bool => c == '_')  // "hi"
/// ```
export fn dropAround(value: Str, holds: fn(Char) -> Bool) -> Str {
  dropWhileEnd(dropWhile(value, holds), holds)
}

/// The characters of two texts paired, stopping at the shorter.
///
/// Stopping rather than padding, so no character has to be invented for the missing
/// side. Comparing two texts position by position is the usual reason to reach for
/// it.
///
/// ## Examples
///
/// ```
/// Text.zipChars("abc", "xy")  // [('a', 'x'), ('b', 'y')]
/// ```
export fn zipChars(left: Str, right: Str) -> Array[(Char, Char)] {
  var out = []
  var index = 0
  let size = if left.length() < right.length() { left.length() } else { right.length() }
  while index < size {
    out = out.push((left.charAt(index), right.charAt(index)))
    index = index + 1
  }
  out
}

/// Text grown from a seed until the step answers `None`.
///
/// The step count is bounded because a strict language cannot recover from a step
/// that never stops; exhausting the bound answers with what it had.
///
/// ## Examples
///
/// ```
/// Text.unfold(5, 0, fn(n: Int) -> Option[(Char, Int)] =>
///   if n > 2 { None } else { Some(('a', n + 1)) })  // "aaa"
/// ```
export fn unfold[S](limit: Int, seed: S, step: fn(S) -> Option[(Char, S)]) -> Str {
  var out = ""
  var current = seed
  var remaining = limit
  while remaining > 0 {
    match step(current) {
      case Some(pair) => {
        out = out + textOf(pair[0])
        current = pair[1]
      }
      case None => { return out }
    }
    remaining = remaining - 1
  }
  out
}

/// Two texts compared without materialising the comparison as a number.
///
/// Answers -1, 0, or 1, which is what a sort needs. The ordering is by character
/// value, not by any locale's collation rules.
///
/// ## Examples
///
/// ```
/// Text.compare("a", "b")  // -1
/// Text.compare("b", "b")  // 0
/// ```
export fn compare(left: Str, right: Str) -> Int {
  var index = 0
  let shorter = if left.length() < right.length() { left.length() } else { right.length() }
  while index < shorter {
    let a = left.charAt(index).code()
    let b = right.charAt(index).code()
    if a < b { return 0 - 1 }
    if a > b { return 1 }
    index = index + 1
  }
  if left.length() < right.length() { 0 - 1 } else {
    if left.length() > right.length() { 1 } else { 0 }
  }
}

/// Whether one text sorts before another.
///
/// The form a sort takes directly, built on `compare` so there is one definition of
/// the ordering rather than two that must agree.
///
/// ## Examples
///
/// ```
/// Text.before("a", "b")  // true
/// Text.before("b", "b")  // false
/// ```
export fn before(left: Str, right: Str) -> Bool { compare(left, right) < 0 }

/// The title-case form: the first character of each word in upper case.
///
/// Every word is treated, which is the difference from `capitalize`. The rest of
/// each word is left as written, so an acronym inside a phrase survives.
///
/// ## Examples
///
/// ```
/// Text.toTitle("hello world")  // "Hello World"
/// ```
export fn toTitle(value: Str) -> Str {
  var out = ""
  var atWordStart = true
  for character in value.chars() {
    if isSpace(character) {
      out = out + textOf(character)
      atWordStart = true
    } else {
      if atWordStart { out = out + textOf(character).toUpper() }
        else { out = out + textOf(character).toLower() }
      atWordStart = false
    }
  }
  out
}

/// Every line, with a trailing newline producing no final empty line.
export fn toLines(value: Str) -> Array[Str] { value.lines() }

/// Lines joined with newlines between them.
export fn fromLines(lines: &Array[Str]) -> Str { join(lines, "\n") }

/// Words joined with single spaces between them.
export fn fromWords(pieces: &Array[Str]) -> Str { join(pieces, " ") }

/// The whole number this text spells, or nothing.
///
/// A leading sign is admitted, because a temperature, a balance, and an offset
/// are all legitimately below nothing. Surrounding space is ignored; anything
/// else in the text means the text does not spell a number, and answering
/// nothing is the honest reading — a reader that stopped at the first
/// character it did not recognise would read "12a" as twelve.
export fn wholeOf(value: Str) -> Option[Int] {
  let trimmed = value.trim()
  let negative = trimmed.startsWith("-")
  let body = if negative || trimmed.startsWith("+") { trimmed.drop(1) } else { trimmed }
  let total = digitsOf(body) ?
  Some(if negative { 0 - total } else { total })
}

/// The count this text spells, or nothing.
///
/// A count is never below nothing, so a sign is not admitted rather than
/// admitted and then rejected somewhere later. This is the reading a length, a
/// port, a quantity, or an index wants: `-1` is not a short length, it is not a
/// length, and the difference is worth having in the type of the answer rather
/// than in a check every caller remembers.
export fn countOf(value: Str) -> Option[Int] { digitsOf(value.trim()) }

/// The digits of text that is nothing but digits.
fn digitsOf(body: Str) -> Option[Int] {
  if body.isEmpty() {
    None
  } else {
    var total = 0
    var index = 0
    var good = true
    while index < body.length() && good {
      let digit = "0123456789".indexOf(body.slice(index, index + 1))
      if digit < 0 { good = false } else { total = total * 10 + digit }
      index = index + 1
    }
    if good { Some(total) } else { None }
  }
}
