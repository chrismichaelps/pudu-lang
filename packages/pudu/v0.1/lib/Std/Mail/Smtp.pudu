module Std.Mail.Smtp

import Std.Bytes as ByteSeq
import Std.Mail as Mail
import Std.Net as Net
import Std.Option as Option
import Std.Result as Result
import Std.Text.Parse as Parse
import Std.Tls as Tls

/// Authentication mechanism variants supported by the SMTP transport.
export type SmtpAuth
  = Login(Str, Str)
  | Plain(Str, Str)

/// How a connection to the server is protected.
export type SmtpSecurity = Plaintext | ImplicitTls | StartTlsRequired

type Transport = Tcp(Net.Connection) | Secure(Tls.Secured)

/// Configuration parameters for connecting to an SMTP submission or relay host.
export type SmtpClient = {
  host: Str,
  port: Int,
  domain: Str,
  credentials: Option[SmtpAuth],
  timeoutMs: Int,
  security: SmtpSecurity,
}

/// A parsed RFC 5321 server reply containing a status code and message lines.
export type SmtpReply = {
  code: Int,
  lines: Array[Str],
}

/// Structured failure conditions encountered during SMTP transmission.
export type SmtpError
  = ConnectionFailed(Str)
  | HandshakeFailed(Int, Str)
  | AuthFailed(Int, Str)
  | RecipientRejected(Str, Int, Str)
  | DataRejected(Int, Str)
  | CommandFailed(Str, Int, Str)
  | TimedOut
  | EmptyEnvelope

/// Configure the relay destination and the application-supplied EHLO identity.
export fn client(host: Str, port: Int, domain: Str) -> SmtpClient {
  SmtpClient {
    host: host,
    port: port,
    domain: domain,
    credentials: None,
    timeoutMs: 10000,
    security: if port == 465 { ImplicitTls } else { StartTlsRequired },
  }
}

/// Who the client says it is, how it proves it, how long it waits, and how the
/// connection is protected.
///
/// A submission host usually needs three of these said at once, and as methods
/// they read down the page in the order a connection makes them: the name sent
/// first, then the proof, then the limits the socket is held to.
export trait Configuring {
  fn identifiedAs(self: &Self, domain: Str) -> Self
  fn loggingIn(self: &Self, user: Str, secret: Str) -> Self
  fn loggingInPlainly(self: &Self, user: Str, secret: Str) -> Self
  fn within(self: &Self, millis: Int) -> Self
  fn protectedBy(self: &Self, security: SmtpSecurity) -> Self
}

impl Configuring for SmtpClient {
  /// The client naming a different domain in its `EHLO`.
  ///
  /// This is what the server logs the message as coming from, so a relay that
  /// checks it against the connecting address refuses a name that is not the
  /// sending host's.
  fn identifiedAs(self: &Self, domain: Str) -> Self {
    SmtpClient{..*self, domain: domain}
  }

  /// The client proving itself with `AUTH LOGIN`.
  fn loggingIn(self: &Self, user: Str, secret: Str) -> Self {
    SmtpClient{..*self, credentials: Some(Login(user, secret))}
  }

  /// The client proving itself with `AUTH PLAIN`.
  ///
  /// The other mechanism, for a server that offers only this one. Neither
  /// hides the secret from anything reading the connection — that is what the
  /// protection is for, which is why both are refused over a plaintext one.
  fn loggingInPlainly(self: &Self, user: Str, secret: Str) -> Self {
    SmtpClient{..*self, credentials: Some(Plain(user, secret))}
  }

  /// The client giving up on a socket that has not answered in this many
  /// milliseconds.
  fn within(self: &Self, millis: Int) -> Self {
    SmtpClient{..*self, timeoutMs: millis}
  }

  /// The client connecting with the given protection.
  ///
  /// Said last because it is the one a caller is most likely to be changing
  /// from what the port implied, and what it is changed to decides whether the
  /// secret above it ever goes out in the clear.
  fn protectedBy(self: &Self, security: SmtpSecurity) -> Self {
    SmtpClient{..*self, security: security}
  }
}

/// Generates the canonical `EHLO` command line.
export fn ehloCommand(domain: Str) -> Str {
  "EHLO " + domain + "\r\n"
}

/// Generates the canonical `MAIL FROM` envelope command.
export fn mailFromCommand(sender: Str) -> Str {
  "MAIL FROM:<" + sender + ">\r\n"
}

/// Generates the canonical `RCPT TO` recipient command.
export fn rcptToCommand(recipient: Str) -> Str {
  "RCPT TO:<" + recipient + ">\r\n"
}

/// Generates the canonical `DATA` command.
export fn dataCommand() -> Str {
  "DATA\r\n"
}

/// Generates the canonical `QUIT` command.
export fn quitCommand() -> Str {
  "QUIT\r\n"
}

/// Formats the username challenge response for `AUTH LOGIN`.
export fn authLoginUsername(user: Str) -> Str {
  ByteSeq.encodeBase64(&user.toBytes()) + "\r\n"
}

/// Formats the password challenge response for `AUTH LOGIN`.
export fn authLoginPassword(pass: Str) -> Str {
  ByteSeq.encodeBase64(&pass.toBytes()) + "\r\n"
}

/// Formats the single-line payload for `AUTH PLAIN`.
export fn authPlainPayload(user: Str, pass: Str) -> Str {
  let raw = "\u{0000}" + user + "\u{0000}" + pass
  "AUTH PLAIN " + ByteSeq.encodeBase64(&raw.toBytes()) + "\r\n"
}

/// Parses an RFC 5321 server response string into a structured status code and message lines.
export fn parseReply(raw: Str) -> Result[SmtpReply, SmtpError] {
  if !raw.endsWith("\r\n") { return Err(HandshakeFailed(0, "incomplete reply line")) }
  let source = raw.take(raw.length() - 2).split("\r\n")
  var lines: Array[Str] = []
  var code = 0
  var index = 0
  for line in source {
    if line.length() < 3 || line.toBytes().length() > 510 {
      return Err(HandshakeFailed(0, "invalid reply line length"))
    }
    if line.contains("\r") || line.contains("\n") { return Err(HandshakeFailed(0, "invalid reply line ending")) }
    let digits = line.take(3)
    for digit in digits.chars() {
      if digit < '0' || digit > '9' { return Err(HandshakeFailed(0, "invalid reply status")) }
    }
    let parsed = match Parse.run(Parse.integer(), digits) {
      case Ok(value) => value
      case Err(_) => { return Err(HandshakeFailed(0, "invalid reply status")) }
    }
    if parsed < 200 || parsed > 599 { return Err(HandshakeFailed(0, "invalid reply status")) }
    if index == 0 { code = parsed }
    if parsed != code { return Err(HandshakeFailed(0, "inconsistent multiline status")) }
    let final = index == source.length() - 1
    if line.length() == 3 {
      if !final { return Err(HandshakeFailed(0, "reply ended before continuation")) }
      lines = lines.push("")
    } else {
      let separator = line.slice(3, 4)
      if final && separator != " " { return Err(HandshakeFailed(0, "unterminated multiline reply")) }
      if !final && separator != "-" { return Err(HandshakeFailed(0, "unexpected reply after final line")) }
      lines = lines.push(line.drop(4))
    }
    index = index + 1
  }
  Ok(SmtpReply{code: code, lines: lines})
}

/// Delivers a message to the target SMTP relay and returns the count of accepted envelope recipients.
export fn deliver(c: &SmtpClient, msg: &Mail.Message) -> Result[Int, SmtpError] {
  let _valid = Result.mapErr(Mail.sendable(msg), fn(problem: Mail.MailError) -> SmtpError { ConnectionFailed(Mail.explain(&problem)) }) ?
  if c.host.trim().isEmpty() || c.port < 1 || c.port > 65535 { return Err(ConnectionFailed("invalid SMTP destination")) }
  if c.timeoutMs < 1 { return Err(ConnectionFailed("timeout must be positive")) }
  if c.domain.isEmpty() { return Err(ConnectionFailed("EHLO domain is empty")) }
  for character in c.domain.chars() {
    if character.code() <= 32 || character.code() >= 127 { return Err(ConnectionFailed("invalid EHLO domain; use an ASCII hostname or address literal")) }
  }
  if c.timeoutMs > 86400000 { return Err(ConnectionFailed("timeout exceeds one day")) }
  if c.domain.toBytes().length() > 255 { return Err(ConnectionFailed("EHLO domain is too long")) }
  if c.security == Plaintext && Option.isSome(&c.credentials) {
    return Err(ConnectionFailed("plaintext authentication is refused"))
  }
  if let Some(auth) = c.credentials {
    let pair = match auth {
      case Login(user, pass) => (user, pass)
      case Plain(user, pass) => (user, pass)
    }
    if pair[0].contains("\0") || pair[1].contains("\0") {
      return Err(AuthFailed(0, "credentials contain a NUL separator"))
    }
    if pair[0].toBytes().length() + pair[1].toBytes().length() > 360 {
      return Err(AuthFailed(0, "credentials exceed the supported AUTH line budget"))
    }
  }
  if Mail.envelope(msg).isEmpty() { return Err(EmptyEnvelope) }
  let opened = openTransport(c) ?
  let negotiated = negotiate(c, &opened)
  if let Err(problem) = negotiated {
    let _closed = closeTransport(&opened, c.timeoutMs)
    return Err(problem)
  }
  let pair = negotiated ?
  let conn = pair[0]
  let outcome = deliverConnected(c, msg, &conn, &pair[1])
  let closed = closeTransport(&conn, c.timeoutMs)
  if let Err(problem) = outcome { return Err(problem) }
  closed ?
  outcome
}

fn openTransport(c: &SmtpClient) -> Result[Transport, SmtpError] {
  if c.security == ImplicitTls {
    return Result.map(Result.mapErr(Tls.connectWithin(c.host, c.port, c.timeoutMs), tlsError),
      fn(connection: Tls.Secured) -> Transport { Secure(connection) })
  }
  Result.map(Result.mapErr(Net.connectWithin(c.host, c.port, c.timeoutMs), netError),
    fn(connection: Net.Connection) -> Transport { Tcp(connection) })
}

fn negotiate(c: &SmtpClient, conn: &Transport) -> Result[(Transport, SmtpReply), SmtpError] {
  let greeting = readReply(conn, c.timeoutMs) ?
  if greeting.code != 220 { return Err(HandshakeFailed(greeting.code, summaryReply(&greeting))) }
  let hello = execCommand(conn, ehloCommand(c.domain), c.timeoutMs) ?
  if hello.code != 250 { return Err(CommandFailed("EHLO", hello.code, summaryReply(&hello))) }
  if c.security != StartTlsRequired { return Ok((*conn, hello)) }
  if !advertises(&hello, "STARTTLS") { return Err(HandshakeFailed(0, "server does not advertise required STARTTLS")) }
  let ready = execCommand(conn, "STARTTLS\r\n", c.timeoutMs) ?
  if ready.code != 220 { return Err(HandshakeFailed(ready.code, "server refused required STARTTLS")) }
  let upgraded = match conn {
    case Tcp(plain) => Result.mapErr(Tls.upgradeWithin(&plain, c.host, c.timeoutMs), tlsError) ?
    case Secure(_) => { return Err(ConnectionFailed("connection is already secured")) }
  }
  let secured = Secure(upgraded)
  let refreshed = execCommand(&secured, ehloCommand(c.domain), c.timeoutMs)
  if let Ok(reply) = refreshed {
    if reply.code == 250 { return Ok((secured, reply)) }
  }
  let _closed = closeTransport(&secured, c.timeoutMs)
  Err(HandshakeFailed(0, "EHLO failed after TLS upgrade"))
}

fn advertises(reply: &SmtpReply, capability: Str) -> Bool {
  for line in reply.lines.slice(1, reply.lines.length()) {
    let tokens = line.toUpper().split(" ")
    if !tokens.isEmpty() && tokens[0] == capability { return true }
  }
  false
}

fn supportsAuth(reply: &SmtpReply, auth: &SmtpAuth) -> Bool {
  let wanted = match auth {
    case Login(_, _) => "LOGIN"
    case Plain(_, _) => "PLAIN"
  }
  for line in reply.lines.slice(1, reply.lines.length()) {
    let tokens = line.toUpper().split(" ")
    if !tokens.isEmpty() && tokens[0] == "AUTH" {
      for token in tokens.slice(1, tokens.length()) { if token == wanted { return true } }
    }
  }
  false
}

fn deliverConnected(c: &SmtpClient, msg: &Mail.Message, conn: &Transport, capabilities: &SmtpReply) -> Result[Int, SmtpError] {
  let recipients = Mail.envelope(msg)
  match c.credentials {
    case Some(auth) => {
      if !supportsAuth(capabilities, &auth) { return Err(AuthFailed(0, "authentication mechanism is not advertised")) }
      let _authOk = executeAuth(conn, &auth, c.timeoutMs) ?
    }
    case None => {}
  }

  let mailReply = execCommand(conn, mailFromCommand(msg.from.written), c.timeoutMs) ?
  if mailReply.code != 250 {
    return Err(CommandFailed("MAIL FROM", mailReply.code, summaryReply(&mailReply)))
  }

  var accepted = 0
  for rcpt in recipients {
    let rcptReply = execCommand(conn, rcptToCommand(rcpt.written), c.timeoutMs) ?
    if rcptReply.code != 250 && rcptReply.code != 251 {
      return Err(RecipientRejected(rcpt.written, rcptReply.code, summaryReply(&rcptReply)))
    }
    accepted = accepted + 1
  }

  let dataReply = execCommand(conn, dataCommand(), c.timeoutMs) ?
  if dataReply.code != 354 {
    return Err(DataRejected(dataReply.code, summaryReply(&dataReply)))
  }

  let payload = Mail.render(msg) + "\r\n.\r\n"
  let sendReply = execCommand(conn, payload, c.timeoutMs) ?
  if sendReply.code != 250 {
    return Err(DataRejected(sendReply.code, summaryReply(&sendReply)))
  }

  let _quitReply = execCommand(conn, quitCommand(), c.timeoutMs)

  Ok(accepted)
}

fn executeAuth(conn: &Transport, auth: &SmtpAuth, timeoutMs: Int) -> Result[Bool, SmtpError] {
  match auth {
    case Login(user, pass) => {
      let authStart = execCommand(conn, "AUTH LOGIN\r\n", timeoutMs) ?
      if authStart.code != 334 {
        return Err(AuthFailed(authStart.code, summaryReply(&authStart)))
      }

      let userReply = execCommand(conn, authLoginUsername(user), timeoutMs) ?
      if userReply.code != 334 {
        return Err(AuthFailed(userReply.code, summaryReply(&userReply)))
      }

      let passReply = execCommand(conn, authLoginPassword(pass), timeoutMs) ?
      if passReply.code != 235 {
        return Err(AuthFailed(passReply.code, summaryReply(&passReply)))
      }
      Ok(true)
    }
    case Plain(user, pass) => {
      let plainReply = execCommand(conn, authPlainPayload(user, pass), timeoutMs) ?
      if plainReply.code != 235 {
        return Err(AuthFailed(plainReply.code, summaryReply(&plainReply)))
      }
      Ok(true)
    }
  }
}

fn execCommand(conn: &Transport, cmd: Str, timeoutMs: Int) -> Result[SmtpReply, SmtpError] {
  if timeoutMs <= 0 { return Err(TimedOut) }
  let expires = clock() + timeoutMs
  sendText(conn, cmd, timeoutMs) ?
  let remaining = expires - clock()
  if remaining <= 0 { return Err(TimedOut) }
  readReply(conn, remaining)
}

fn readReply(conn: &Transport, timeoutMs: Int) -> Result[SmtpReply, SmtpError] {
  let expires = clock() + timeoutMs
  var buffer = ByteSeq.empty()
  loop {
    let remaining = expires - clock()
    if remaining <= 0 { return Err(TimedOut) }
    let capacity = 65536 - buffer.length()
    if capacity <= 0 { return Err(HandshakeFailed(0, "reply exceeds 65536 bytes")) }
    let maybeChunk = match receive(conn, capacity, remaining) {
      case Ok(c) => c
      case Err(TimedOut) => { return Err(TimedOut) }
      case Err(err) => { return Err(err) }
    }
    let chunk = match maybeChunk {
      case Some(bytes) => bytes
      case None => { return Err(ConnectionFailed("connection closed by mail server")) }
    }
    if chunk.length() > capacity { return Err(HandshakeFailed(0, "reply exceeds 65536 bytes")) }
    if chunk.isEmpty() { return Err(ConnectionFailed("empty reply read")) }
    buffer = buffer.concat(chunk)
    if buffer.endsWith("\r\n".toBytes()) {
      let text = match ByteSeq.toText(&buffer) {
        case Ok(value) => value
        case Err(_) => { return Err(ConnectionFailed("mail server returned non-utf8 data")) }
      }
      let lines = text.take(text.length() - 2).split("\r\n")
      let last = lines[lines.length() - 1]
      if last.length() <= 3 || last.slice(3, 4) != "-" { return parseReply(text) }
    }
  }
}

fn summaryReply(reply: &SmtpReply) -> Str {
  if reply.lines.isEmpty() {
    show(reply.code)
  } else {
    reply.lines.join("; ")
  }
}

fn explainNet(err: &Net.NetError) -> Str {
  match err {
    case Net.Refused(msg) => "connection refused: " + msg
    case Net.Unresolved(msg) => "unresolved host: " + msg
    case Net.Closed => "connection closed"
    case Net.AddressInUse(port) => "address in use: " + show(port)
    case Net.NetOperationTimedOut => "operation timed out"
    case Net.NotText => "data is not text"
    case Net.Other(msg) => msg
  }
}

fn netError(problem: Net.NetError) -> SmtpError {
  match problem {
    case Net.NetOperationTimedOut => TimedOut
    case _ => ConnectionFailed(explainNet(&problem))
  }
}

fn tlsError(problem: Tls.TlsError) -> SmtpError {
  match problem {
    case Tls.TlsOperationTimedOut => TimedOut
    case _ => ConnectionFailed(show(problem))
  }
}

fn sendText(conn: &Transport, payload: Str, millis: Int) -> Result[(), SmtpError] {
  match conn {
    case Tcp(plain) => Result.mapErr(Net.sendTextWithin(&plain, payload, millis), netError)
    case Secure(secured) => Result.mapErr(Tls.sendTextWithin(&secured, payload, millis), tlsError)
  }
}

fn receive(conn: &Transport, count: Int, millis: Int) -> Result[Option[Bytes], SmtpError] {
  match conn {
    case Tcp(plain) => Result.mapErr(Net.receiveWithin(&plain, count, millis), netError)
    case Secure(secured) => Result.mapErr(Tls.receiveWithin(&secured, count, millis), tlsError)
  }
}

fn closeTransport(conn: &Transport, millis: Int) -> Result[(), SmtpError] {
  match conn {
    case Tcp(plain) => Result.mapErr(Net.close(&plain), netError)
    case Secure(secured) => Result.mapErr(Tls.closeWithin(&secured, millis), tlsError)
  }
}
