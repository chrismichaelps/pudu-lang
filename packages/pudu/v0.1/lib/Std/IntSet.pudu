module Std.IntSet

/// A set of whole numbers.
///
/// It is held in the runtime's own ordered set, so membership, insertion,
/// removal, union, intersection, and difference run natively rather than as a
/// tree walked in Pudu, and members come back in ascending order.
export type IntSet = { held: Set[Int] }

/// Constructs an empty integer set.
export fn empty() -> IntSet { IntSet{held: setOf([])} }

/// Constructs a set with a single element.
export fn singleton(value: Int) -> IntSet { IntSet{held: setOf([value])} }

/// Whether the set contains no elements.
export fn isEmpty(set: &IntSet) -> Bool { set.held.isEmpty() }

/// The number of elements contained in the set.
export fn size(set: &IntSet) -> Int { set.held.size() }

/// Tests whether element is present in the set.
export fn member(set: &IntSet, value: Int) -> Bool { set.held.contains(value) }

/// Inserts an integer element into the set.
export fn insert(set: &IntSet, value: Int) -> IntSet { IntSet{held: set.held.insert(value)} }

/// Deletes an integer element from the set if present.
export fn delete(set: &IntSet, value: Int) -> IntSet { IntSet{held: set.held.remove(value)} }

/// Computes the union of two integer sets.
export fn union(left: &IntSet, right: &IntSet) -> IntSet { IntSet{held: left.held.union(right.held)} }

/// Computes the intersection of two integer sets.
export fn intersection(left: &IntSet, right: &IntSet) -> IntSet {
  IntSet{held: left.held.intersect(right.held)}
}

/// Computes the set difference (elements in left not present in right).
export fn difference(left: &IntSet, right: &IntSet) -> IntSet {
  IntSet{held: left.held.difference(right.held)}
}

/// Computes the symmetric difference of two sets.
export fn symmetricDifference(left: &IntSet, right: &IntSet) -> IntSet {
  IntSet{held: left.held.difference(right.held).union(right.held.difference(left.held))}
}

/// Tests whether every element of subset is in superset.
export fn isSubsetOf(subset: &IntSet, superset: &IntSet) -> Bool {
  subset.held.difference(superset.held).isEmpty()
}

/// Tests whether the two sets share no common elements.
export fn disjoint(left: &IntSet, right: &IntSet) -> Bool { left.held.intersect(right.held).isEmpty() }

/// Returns an array of all elements in ascending order.
export fn toArray(set: &IntSet) -> Array[Int] { set.held.toArray() }

/// Constructs a set from an array of integers.
export fn fromArray(values: &Array[Int]) -> IntSet { IntSet{held: setOf(*values)} }

/// Returns the minimum element present in the set, or None if empty.
export fn findMin(set: &IntSet) -> Option[Int] {
  let ordered = set.held.toArray()
  if ordered.length() == 0 { None } else { Some(ordered[0]) }
}

/// Returns the maximum element present in the set, or None if empty.
export fn findMax(set: &IntSet) -> Option[Int] {
  let ordered = set.held.toArray()
  if ordered.length() == 0 { None } else { Some(ordered[ordered.length() - 1]) }
}

/// Deletes the minimum element from the set.
export fn deleteMin(set: &IntSet) -> IntSet {
  match findMin(set) {
    case Some(least) => delete(set, least)
    case None => *set
  }
}

/// Deletes the maximum element from the set.
export fn deleteMax(set: &IntSet) -> IntSet {
  match findMax(set) {
    case Some(greatest) => delete(set, greatest)
    case None => *set
  }
}

/// Partitions elements into strictly smaller and strictly greater than pivot.
export fn split(set: &IntSet, pivot: Int) -> (IntSet, IntSet) {
  var lesser: Array[Int] = []
  var greater: Array[Int] = []
  for x in set.held.toArray() {
    if x < pivot {
      lesser = lesser.push(x)
    } else if x > pivot {
      greater = greater.push(x)
    }
  }
  (IntSet{held: setOf(lesser)}, IntSet{held: setOf(greater)})
}

/// Partitions into strictly smaller, presence boolean, and strictly greater.
export fn splitMember(set: &IntSet, pivot: Int) -> (IntSet, Bool, IntSet) {
  let pair = split(set, pivot)
  (pair[0], member(set, pivot), pair[1])
}

/// Filters the set, retaining only elements satisfying the predicate.
export fn filter(set: &IntSet, predicate: fn(Int) -> Bool) -> IntSet {
  IntSet{held: setOf(set.held.toArray().filter(predicate))}
}
