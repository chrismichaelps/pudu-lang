/// Two, built from the identity rather than written, so it has whatever type
/// the caller is working in.
export fn two[T: One + Add](example: &T) -> T { example.one().plus(&example.one()) }

/// A whole number of the caller's type, built by repeated addition.
/// Only for the small constants an algorithm needs — ten for digits, two for
/// halving. Building a large one this way would be a loop a caller can see.
export fn small[T: Zero + One + Add](example: &T, count: Int) -> T {
  var out = example.zero()
  var remaining = count
  while remaining > 0 {
    out = out.plus(&example.one())
    remaining = remaining - 1
  }
  out
}

impl Rem for Int {
  fn remainderOf(self: &Self, other: &Self) -> Option[Self] {
    if (*other) == 0 { None } else { Some((*self) % (*other)) }
  }
}
impl Rem for Int8 {
  fn remainderOf(self: &Self, other: &Self) -> Option[Self] {
    if (*other) == 0i8 { None } else { Some((*self) % (*other)) }
  }
}
