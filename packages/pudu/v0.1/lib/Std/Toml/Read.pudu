module Std.Toml.Read

import Std.Option as Option
import Std.Toml {Boolean, Fractional, List, Malformed, Moment, Table, Text, Toml, TomlError, TooDeep, Unexpected, Unterminated, Whole}
import Std.Toml as Document
import Std.Toml.Scan as Scan

/// The most lists and inline tables one value may nest.
///
/// Reading recurses once per level, and the evaluator bounds how deep calls
/// may go, so a value nested past that bound would stop the whole program
/// rather than answer an error. This bound refuses it as `TooDeep` well inside
/// the evaluator's own limit.
const MAX_DEPTH: Int = 512

/// A configuration read from text.
///
/// The document is built as it is read rather than collected and assembled
/// afterwards, because a section header changes where every later key belongs:
/// a reader that gathered keys first would have to remember which header each
/// arrived under, which is the same bookkeeping done less directly.
///
/// Tables under construction are drafts held side by side and named by
/// position, each keeping its keys in written order and a map from key to where
/// it points. Placing a key is one map lookup per segment of its path, so the
/// work does not grow with how many keys the table already holds. The drafts
/// become the finished value once, when the text has been read.
export fn read(source: Str) -> Result[Toml, TomlError] {
  var drafts = [emptyDraft()]
  var section: Array[Str] = []
  var current = 0
  var index = 0
  var failure: Option[TomlError] = None

  while index < source.length() && Option.isNone(&failure) {
    index = Scan.skipBlank(source, index)
    if index >= source.length() {
      index = source.length()
    } else {
      let character = source.slice(index, index + 1)
      if character == "[" {
        let header = readHeader(source, index)
        if let Ok(found) = header {
          section = found[0]
          index = found[2]
          // A repeated section starts a new table at the end of a list; a plain
          // one names a table that may already exist and is not replaced, so
          // keys written under it after another section still land in it.
          let opened = if found[1] { appendTable(drafts, &section) } else { openTable(drafts, &section) }
          match opened {
            case Ok(next) => {
              drafts = next[0]
              current = next[1]
            }
            case Err(reason) => { failure = Some(reason) }
          }
        } else {
          failure = failureOf(header, index)
        }
      } else {
        let pairing = readPair(source, index, 0)
        if let Ok(found) = pairing {
          match placeValue(drafts, current, &section, &found[0], found[1]) {
            case Ok(next) => { drafts = next }
            case Err(reason) => { failure = Some(reason) }
          }
          index = found[2]
        } else {
          failure = failureOf(pairing, index)
        }
      }
    }
  }

  if let Some(reason) = failure { Err(reason) } else { Ok(finished(&drafts, 0)) }
}

/// The failure a step reported, or a general one when it reported none.
fn failureOf[T](outcome: Result[T, TomlError], index: Int) -> Option[TomlError] {
  if let Err(reason) = outcome {
    Some(reason)
  } else {
    Some(Malformed(index, "the document could not be read"))
  }
}

/// A section header, whether it repeats, and where it ended.
fn readHeader(source: Str, start: Int) -> Result[(Array[Str], Bool, Int), TomlError] {
  let repeated = source.slice(start, start + 2) == "[["
  var index = if repeated { start + 2 } else { start + 1 }
  let named = readKeyPath(source, index) ?
  index = Scan.skipInline(source, named[1])
  let closing = if repeated { "]]" } else { "]" }
  if source.slice(index, index + closing.length()) != closing {
    Err(Unexpected(index, "a section header that was not closed"))
  } else {
    Ok((named[0], repeated, index + closing.length()))
  }
}

/// A key and its value, and where the line ended.
fn readPair(source: Str, start: Int, depth: Int) -> Result[(Array[Str], Toml, Int), TomlError] {
  let named = readKeyPath(source, start) ?
  var index = Scan.skipInline(source, named[1])
  if source.slice(index, index + 1) != "=" {
    Err(Unexpected(index, "a key with no value"))
  } else {
    index = Scan.skipInline(source, index + 1)
    let valued = valueAt(source, index, depth) ?
    Ok((named[0], valued[0], valued[1]))
  }
}

/// A dotted key, and where it ended.
fn readKeyPath(source: Str, start: Int) -> Result[(Array[Str], Int), TomlError] {
  var pieces: Array[Str] = []
  var index = Scan.skipInline(source, start)
  var going = true
  var failure: Option[TomlError] = None
  while going && Option.isNone(&failure) {
    let piece = Scan.readKey(source, index)
    if let Ok(found) = piece {
      pieces = pieces.push(found[0])
      index = Scan.skipInline(source, found[1])
      if source.slice(index, index + 1) == "." {
        index = Scan.skipInline(source, index + 1)
      } else {
        going = false
      }
    } else {
      failure = Some(Unexpected(index, "a key that could not be read"))
    }
  }
  if let Some(reason) = failure { Err(reason) } else { Ok((pieces, index)) }
}

/// A value, and where it ended.
export fn readValue(source: Str, start: Int) -> Result[(Toml, Int), TomlError] {
  valueAt(source, start, 0)
}

/// A value inside `depth` open lists and inline tables, and where it ended.
fn valueAt(source: Str, start: Int, depth: Int) -> Result[(Toml, Int), TomlError] {
  let index = Scan.skipInline(source, start)
  let character = source.slice(index, index + 1)
  if character == "\"" || character == "'" {
    let quoted = Scan.readQuoted(source, index) ?
    Ok((Text(quoted[0]), quoted[1]))
  } else if (character == "[" || character == "\{") && depth >= MAX_DEPTH {
    Err(TooDeep(index))
  } else if character == "[" {
    readList(source, index, depth + 1)
  } else if character == "\{" {
    readInline(source, index, depth + 1)
  } else {
    readBare(source, index)
  }
}

/// A list of values, which may run over several lines and end with a comma.
fn readList(source: Str, start: Int, depth: Int) -> Result[(Toml, Int), TomlError] {
  var items: Array[Toml] = []
  var index = Scan.skipBlank(source, start + 1)
  var closed = false
  var failure: Option[TomlError] = None
  while !closed && Option.isNone(&failure) {
    if index >= source.length() {
      failure = Some(Unterminated(start))
    } else {
      if source.slice(index, index + 1) == "]" {
        closed = true
        index = index + 1
      } else {
        let valued = valueAt(source, index, depth)
        if let Ok(found) = valued {
          items = items.push(found[0])
          index = Scan.skipBlank(source, found[1])
          if source.slice(index, index + 1) == "," { index = Scan.skipBlank(source, index + 1) }
        } else {
          failure = failureOf(valued, index)
        }
      }
    }
  }
  if let Some(reason) = failure { Err(reason) } else { Ok((List(items), index)) }
}

/// A table written between braces on one line.
fn readInline(source: Str, start: Int, depth: Int) -> Result[(Toml, Int), TomlError] {
  var drafts = [emptyDraft()]
  var index = Scan.skipInline(source, start + 1)
  var closed = false
  var failure: Option[TomlError] = None
  while !closed && Option.isNone(&failure) {
    if index >= source.length() {
      failure = Some(Unterminated(start))
    } else {
      if source.slice(index, index + 1) == "\}" {
        closed = true
        index = index + 1
      } else {
        let pairing = readPair(source, index, depth)
        if let Ok(found) = pairing {
          match placeValue(drafts, 0, &[], &found[0], found[1]) {
            case Ok(next) => { drafts = next }
            case Err(reason) => { failure = Some(reason) }
          }
          index = Scan.skipInline(source, found[2])
          if source.slice(index, index + 1) == "," { index = Scan.skipInline(source, index + 1) }
        } else {
          failure = failureOf(pairing, index)
        }
      }
    }
  }
  if let Some(reason) = failure { Err(reason) } else { Ok((finished(&drafts, 0), index)) }
}

/// A value written without quotes: a truth, a number, or a moment.
fn readBare(source: Str, start: Int) -> Result[(Toml, Int), TomlError] {
  var index = start
  while index < source.length() && !"\n\r,]\}#".contains(source.slice(index, index + 1)) {
    index = index + 1
  }
  let word = source.slice(start, index).trim()
  if word.isEmpty() {
    Err(Unexpected(start, "a value that is not there"))
  } else {
    Ok((Scan.valueOf(word), index))
  }
}

/// A section path joined with a key path.
fn joinPath(section: &Array[Str], key: &Array[Str]) -> Array[Str] {
  var whole: Array[Str] = []
  for piece in section { whole = whole.push(piece) }
  for piece in key { whole = whole.push(piece) }
  whole
}

fn dotted(pieces: &Array[Str]) -> Str {
  var out = ""
  var index = 0
  while index < pieces.length() {
    if index > 0 { out = out + "." }
    out = out + pieces[index]
    index = index + 1
  }
  out
}

// -- Building the document ---------------------------------------------------

/// Where a key of a table under construction points: a value, a table, or the
/// tables of a repeated section in the order they were opened.
type Slot
  = Value(Toml)
  | Nested(Int)
  | Repeated(Array[Int])

/// A table under construction: its keys in the order they were written, and
/// where each one points.
type Draft = { order: Array[Str], slots: Map[Str, Slot] }

fn emptyDraft() -> Draft { Draft{order: [], slots: mapOf([])} }

/// The drafts with a key of one of them pointed somewhere, keeping the order
/// the key was first written in.
fn withSlot(drafts: Array[Draft], position: Int, name: Str, slot: Slot) -> Array[Draft] {
  let draft = drafts[position]
  let order = if Option.isSome(&draft.slots.get(name)) { draft.order } else { draft.order.push(name) }
  drafts.remove(position).insert(position, Draft{order: order, slots: draft.slots.insert(name, slot)})
}

/// The table a path names below another, opening the tables not written yet.
///
/// A step through a repeated section lands in its newest table, because a key
/// written under one belongs there rather than to the list. A step through a
/// value is refused with the path that reached it: a value is not a table to
/// write into, and turning it into one would silently discard it.
fn openPath(drafts: Array[Draft], from: Int, pieces: &Array[Str]) -> Result[(Array[Draft], Int), Str] {
  var built = drafts
  var current = from
  var walked: Array[Str] = []
  for piece in pieces {
    walked = walked.push(piece)
    match built[current].slots.get(piece) {
      case Some(Nested(inner)) => { current = inner }
      case Some(Repeated(tables)) => { current = tables[tables.length() - 1] }
      case Some(Value(_)) => { return Err(dotted(&walked)) }
      case None => {
        let created = built.length()
        built = withSlot(built.push(emptyDraft()), current, piece, Nested(created))
        current = created
      }
    }
  }
  Ok((built, current))
}

/// The table a plain section header names.
fn openTable(drafts: Array[Draft], pieces: &Array[Str]) -> Result[(Array[Draft], Int), TomlError] {
  match openPath(drafts, 0, pieces) {
    case Ok(opened) => Ok(opened)
    case Err(path) => Err(Document.Duplicate(path))
  }
}

/// A new table at the end of a repeated section, which is what a doubled
/// header does. A key already holding anything else is refused.
fn appendTable(drafts: Array[Draft], pieces: &Array[Str]) -> Result[(Array[Draft], Int), TomlError] {
  let name = pieces[pieces.length() - 1]
  let opened = openTable(drafts, &pieces.slice(0, pieces.length() - 1)) ?
  let created = opened[0].length()
  let built = opened[0].push(emptyDraft())
  match built[opened[1]].slots.get(name) {
    case None => Ok((withSlot(built, opened[1], name, Repeated([created])), created))
    case Some(Repeated(tables)) => Ok((withSlot(built, opened[1], name, Repeated(tables.push(created))), created))
    case Some(_) => Err(Document.Duplicate(dotted(pieces)))
  }
}

/// The drafts with a value placed at a key path below a table, refusing a key
/// already given and a path through a value.
fn placeValue(
  drafts: Array[Draft],
  table: Int,
  section: &Array[Str],
  key: &Array[Str],
  value: Toml
) -> Result[Array[Draft], TomlError] {
  let name = key[key.length() - 1]
  match openPath(drafts, table, &key.slice(0, key.length() - 1)) {
    case Err(_) => Err(Document.Duplicate(dotted(&joinPath(section, key))))
    case Ok(opened) => {
      if Option.isSome(&opened[0][opened[1]].slots.get(name)) {
        Err(Document.Duplicate(dotted(&joinPath(section, key))))
      } else {
        Ok(withSlot(opened[0], opened[1], name, Value(value)))
      }
    }
  }
}

/// The finished value of a draft and every table below it.
fn finished(drafts: &Array[Draft], position: Int) -> Toml {
  let draft = drafts[position]
  var entries: Array[(Str, Toml)] = []
  for name in draft.order {
    if let Some(slot) = draft.slots.get(name) {
      let held = match slot {
        case Value(value) => value
        case Nested(inner) => finished(drafts, inner)
        case Repeated(tables) => {
          var items: Array[Toml] = []
          for inner in tables { items = items.push(finished(drafts, inner)) }
          List(items)
        }
      }
      entries = entries.push((name, held))
    }
  }
  Table(entries)
}
