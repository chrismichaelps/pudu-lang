/// Gradient noise at a point in the plane, in about [-1, 1]; zero at every lattice point.
export fn perlin2(x: Float64, y: Float64) -> Float64 {
  let fx = Float.floor(x)
  let fy = Float.floor(y)
  let xi = lattice(fx)
  let yi = lattice(fy)
  let dx = x - fx
  let dy = y - fy
  let u = fade(dx)
  let v = fade(dy)
  let a = PERMUTATION[xi] + yi
  let b = PERMUTATION[xi + 1] + yi
  mix(
    v,
    mix(u, grad2(PERMUTATION[a], dx, dy), grad2(PERMUTATION[b], dx - 1.0, dy)),
    mix(u, grad2(PERMUTATION[a + 1], dx, dy - 1.0), grad2(PERMUTATION[b + 1], dx - 1.0, dy - 1.0)),
  )
}

/// Gradient noise at a point in space, in about [-1, 1]; zero at every lattice point.
export fn perlin3(x: Float64, y: Float64, z: Float64) -> Float64 {
  let fx = Float.floor(x)
  let fy = Float.floor(y)
  let fz = Float.floor(z)
  let xi = lattice(fx)
  let yi = lattice(fy)
  let zi = lattice(fz)
  let dx = x - fx
  let dy = y - fy
  let dz = z - fz
  let u = fade(dx)
  let v = fade(dy)
  let w = fade(dz)
  let a = PERMUTATION[xi] + yi
  let aa = PERMUTATION[a] + zi
  let ab = PERMUTATION[a + 1] + zi
  let b = PERMUTATION[xi + 1] + yi
  let ba = PERMUTATION[b] + zi
  let bb = PERMUTATION[b + 1] + zi
  mix(
    w,
    mix(
      v,
      mix(u, grad3(PERMUTATION[aa], dx, dy, dz), grad3(PERMUTATION[ba], dx - 1.0, dy, dz)),
      mix(u, grad3(PERMUTATION[ab], dx, dy - 1.0, dz), grad3(PERMUTATION[bb], dx - 1.0, dy - 1.0, dz)),
    ),
    mix(
      v,
      mix(u, grad3(PERMUTATION[aa + 1], dx, dy, dz - 1.0), grad3(PERMUTATION[ba + 1], dx - 1.0, dy, dz - 1.0)),
      mix(
        u,
        grad3(PERMUTATION[ab + 1], dx, dy - 1.0, dz - 1.0),
        grad3(PERMUTATION[bb + 1], dx - 1.0, dy - 1.0, dz - 1.0),
      ),
    ),
  )
}

/// Octaves of spatial noise, each `lacunarity` times the frequency and `gain` times the amplitude
/// of the last, normalized by the total amplitude; zero octaves answer zero.
export fn fbm3(x: Float64, y: Float64, z: Float64, octaves: Int, lacunarity: Float64, gain: Float64) -> Float64 {
  var total = 0.0
  var weight = 0.0
  var amplitude = 1.0
  var frequency = 1.0
  var remaining = octaves
  while remaining > 0 {
    total = total + amplitude * perlin3(x * frequency, y * frequency, z * frequency)
    weight = weight + amplitude
    amplitude = amplitude * gain
    frequency = frequency * lacunarity
    remaining = remaining - 1
  }
  if weight == 0.0 { 0.0 } else { total / weight }
}

fn lattice(floored: Float64) -> Int {
  match Float.toInt(floored) {
    case Some(cell) => cell & 255
    case None => 0
  }
}

fn fade(t: Float64) -> Float64 {
  t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
}

fn mix(t: Float64, a: Float64, b: Float64) -> Float64 {
  a + t * (b - a)
}

fn grad2(hash: Int, x: Float64, y: Float64) -> Float64 {
  let h = hash & 7
  let u = if h < 4 { x } else { y }
  let v = if h < 4 { y } else { x }
  (if (h & 1) == 0 { u } else { -u }) + (if (h & 2) == 0 { v } else { -v })
}

fn grad3(hash: Int, x: Float64, y: Float64, z: Float64) -> Float64 {
  let h = hash & 15
  let u = if h < 8 { x } else { y }
  let v = if h < 4 { y } else if h == 12 || h == 14 { x } else { z }
  (if (h & 1) == 0 { u } else { -u }) + (if (h & 2) == 0 { v } else { -v })
}
