module Main

/// A record whose fields are records, and one whose fields cannot cross.
///
/// Both are refused where they are written rather than where they are called,
/// which is the whole reason the crossable set is stated rather than inferred.
type Point = { x: Float64, y: Float64 }

type Camera = { offset: Point, zoom: Float64 }

type Held = { name: Str, values: Array[Int32] }

foreign "c" {
  fn nested symbol "pudu_ffi_cpp_anchor" (camera: Camera) -> Int32
  fn uncrossable symbol "pudu_ffi_cpp_anchor" (held: Held) -> Int32
}

export fn main() -> Int { 0 }
