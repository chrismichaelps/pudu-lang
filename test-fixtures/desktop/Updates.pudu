module Updates

import Std.Archive.Tar as Tar
import Std.Compress.Gzip as Gzip
import Std.Concurrent as Concurrent
import Std.Crypto.Sign as Sign
import Std.Desktop.Delta as Delta
import Std.Desktop.Update as Update
import Std.Env as Env
import Std.Hex as Hex
import Std.Io as Io
import Std.Json as Json

fn archive(version: Str) -> Bytes {
  Tar.writeArchive([Tar.directory("bin"), Tar.entry("bin/app", "binary {version}".toBytes()), Tar.entry("VERSION", version.toBytes()), Tar.entry("big.txt", "x".repeat(20000).toBytes())])
}

fn say(text: Str) -> () { let _ = print(text) }

fn main() -> Result[(), Str] {
  let base = Env.variableOr("PROBE_DIR", ".")
  let port = Env.variableOr("PROBE_PORT", "8765")
  let pair = match Sign.generate() { case Ok(found) => found case Err(why) => { return Err(Sign.explain(&why)) } }
  let v1 = archive("1.0.0")
  let v2 = archive("1.1.0")
  let packed = Gzip.compress(&v2, &Gzip.config())
  let _ = Io.writeAllBytes(base + "/serve/app-1.1.0.tar.gz", &packed)
  let patch = Delta.diff(&v1, &v2)
  let _ = Io.writeAllBytes(base + "/serve/app-1.0.0-1.1.0.patch", &patch)
  let patchEntry = Update.Patch {
    from: "1.0.0",
    url: "http://127.0.0.1:{port}/app-1.0.0-1.1.0.patch",
    size: patch.length(),
    sha256: Hex.encode(&sha256Of(patch).toArray()),
    signature: Sign.encodeSignature(&pair.public, &Sign.sign(&pair, &patch))
  }
  let entry = Update.manifestEntry(&pair, "http://127.0.0.1:{port}/app-1.1.0.tar.gz", &packed, &[patchEntry])
  Io.write(base + "/serve/latest.json", Update.manifest("1.1.0", "notes", "2026-11-05T00:00:00Z", &Update.Beta, &[("darwin-aarch64", entry)])) ?
  let root = base + "/install/App"
  Io.makeDirectory(root) ?
  Io.write(root + "/VERSION", "1.0.0") ?
  let config = Update.Config {
    endpoints: ["http://127.0.0.1:{port}/missing.json", "http://127.0.0.1:{port}/latest.json?t=\{\{target\}\}"],
    publicKeys: [pair.public],
    track: Update.Stable,
    current: "1.0.0",
    target: "darwin",
    arch: "aarch64",
    root: root,
    maxBytes: 10000000
  }
  match Update.check(&config) { case Ok(found) => say("stable sees beta release: {found != None}") case Err(why) => say("check failed {Update.explain(&why)}") }
  let beta = Update.Config{..config, track: Update.Beta}
  let release = match Update.check(&beta) {
    case Ok(Some(found)) => found
    case Ok(None) => { return Err("no release") }
    case Err(why) => { return Err(Update.explain(&why)) }
  }
  say("found {release.version} with {release.artifact.patches.length()} patch")
  let full = match Update.fetchArchive(&beta, &release) { case Ok(found) => found case Err(why) => { return Err(Update.explain(&why)) } }
  say("full archive matches {full == v2}")
  let _ = Io.writeAllBytes(root + ".pudu-cache.tar", &v1)
  let viaPatch = match Update.fetchArchive(&beta, &release) { case Ok(found) => found case Err(why) => { return Err(Update.explain(&why)) } }
  say("patched archive matches {viaPatch == v2}")
  let forged = Update.Config{..beta, publicKeys: [match Sign.generate() { case Ok(other) => other.public case Err(_) => bytesOf([]) }]}
  let _ = Io.remove(root + ".pudu-cache.tar")
  match Update.fetchArchive(&forged, &release) { case Ok(_) => say("untrusted key accepted") case Err(why) => say("untrusted: {Update.explain(&why)}") }
  let watcher = match Update.background(&beta) { case Ok(found) => found case Err(why) => { return Err(Update.explain(&why)) } }
  var reports: Array[Str] = []
  var waited = 0
  while waited < 600 && !reports.contains("ready") && !reports.contains("failed") {
    match Update.poll(&watcher) {
      case Some(Update.Found(found)) => { reports = reports.push("found " + found.version) }
      case Some(Update.Ready(found, bytes)) => { reports = reports.push(if bytes == v2 { "ready" } else { "ready with other bytes" }) }
      case Some(Update.UpToDate) => { reports = reports.push("up to date") }
      case Some(Update.Failed(why)) => { reports = reports.push("failed " + why) }
      case None => {
        let _ = Concurrent.sleep(50)
        waited = waited + 1
      }
    }
  }
  say("background " + reports.join(", "))
  match Update.install(&beta, &full, release.version) { case Ok(_) => say("installed") case Err(why) => { return Err(Update.explain(&why)) } }
  let now = Io.read(root + "/VERSION")
  say("version now {now}")
  let first = Update.startup(&beta)
  say("first start {first}")
  let second = Update.startup(&beta)
  say("second start {second}")
  let after = Io.read(root + "/VERSION")
  say("version after rollback {after}")
  Ok(())
}
