module LaneCollections

import Std.Lanes as Lanes

/// Four hundred lane kernel calls, each writing a fresh 3.2 MB buffer.
export fn main() -> Int {
  let Some(base) = Lanes.ramp(400000, 1.0, 1.0) else { panic("ramp") }
  var current = base
  var round = 0
  while round < 200 {
    current = Lanes.sqrt(&Lanes.addScalar(&current, 1.0))
    round = round + 1
  }
  print(show(Lanes.sum(&current) > 0.0))
  0
}
