module Slices

/// Indexing by a range, which is the same question indexing by a number asks.
///
/// Each end may be left off, and an absent end is answered by the value being
/// sliced rather than by the writer measuring it first. A slice of an array
/// shares the array's own storage rather than copying it, which is what makes
/// reading a stretch of a large one affordable.

export fn main() -> Int {
  let values = [10, 20, 30, 40, 50]

  let middle = values[1..3]
  let inclusiveMiddle = values[1..=3]
  let tail = values[3..]
  let front = values[..2]
  let whole = values[..]
  let empty = values[2..2]

  let text = "hello world"
  let greeting = text[0..5]
  let rest = text[6..]

  let start = 1
  let stop = 4
  let computed = values[start..stop]

  middle.length() + inclusiveMiddle.length() + tail.length()
    + front.length() + whole.length() + empty.length()
    + greeting.length() + rest.length()
    + computed.length()
    + middle[0] + tail[1] + whole[4]
}
