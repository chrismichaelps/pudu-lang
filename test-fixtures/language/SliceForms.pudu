module SliceForms

/// Indexing by a range, over every value a slice applies to.
///
/// A stretch of an array is an array, of text is text, of bytes is bytes. Every
/// end may be written, left off, or computed, and the value being sliced
/// supplies whatever is missing.

import Std.Bytes as Bytes

export fn main() -> Int {
  let values = [10, 20, 30, 40, 50]

  let middle = values[1..3]
  let inclusiveMiddle = values[1..=3]
  let tail = values[3..]
  let front = values[..2]
  let frontInclusive = values[..=2]
  let whole = values[..]
  let everything = values[0..values.length()]
  let nothing = values[2..2]
  let lastOnly = values[4..]
  let firstOnly = values[..1]

  // A slice of a slice, and an index into one.
  let nested = values[1..4][1..]
  let reached = values[1..4][0]

  // Ends the program computed rather than wrote.
  let from = 1
  let until = 4
  let computed = values[from..until]
  let shifted = values[from + 1..until]

  let text = "hello world"
  let greeting = text[0..5]
  let rest = text[6..]
  let head = text[..1]
  let everyChar = text[..]
  let emptyText = text[3..3]

  let bytes = Bytes.fromText("abcdef")
  let someBytes = bytes[1..3]
  let tailBytes = bytes[4..]
  let allBytes = bytes[..]

  // An empty value still slices, as long as the range stays inside it.
  let none: Array[Int] = []
  let noneSliced = none[..]
  let noneEmpty = none[0..0]

  middle.length() + inclusiveMiddle.length() + tail.length()
    + front.length() + frontInclusive.length() + whole.length()
    + everything.length() + nothing.length() + lastOnly.length() + firstOnly.length()
    + nested.length() + reached
    + computed.length() + shifted.length()
    + middle[0] + tail[1] + whole[4] + nested[0]
    + greeting.length() + rest.length() + head.length()
    + everyChar.length() + emptyText.length()
    + Bytes.length(&someBytes) + Bytes.length(&tailBytes) + Bytes.length(&allBytes)
    + noneSliced.length() + noneEmpty.length()
}
