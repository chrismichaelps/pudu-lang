module UsesArkTextured

import Std.Lanes as Lanes
import Std.Math.Float as Float
import Ark.Assets.Import as Import
import Ark.Assets.Server as Server
import Ark.Assets.Texture as Texture
import Ark.Math.Camera as Camera
import Ark.Math.Color as Color
import Ark.Math.Matrix as M
import Ark.Math as V
import Ark.Platform.Vfs as Vfs
import Ark.Render.Device as Device
import Ark.Render.Mesh as Mesh
import Ark.Render.Pipeline as Pipeline

fn require(condition: Bool, name: Str) {
  if !condition { panic(name) }
}

fn pixel(surface: &Device.Target, x: Int, y: Int) -> (UInt8, UInt8, UInt8, UInt8) {
  let at = (y * surface.width + x) * 4
  let Some(r) = surface.color.at(at) else { panic("r") }
  let Some(g) = surface.color.at(at + 1) else { panic("g") }
  let Some(b) = surface.color.at(at + 2) else { panic("b") }
  let Some(a) = surface.color.at(at + 3) else { panic("a") }
  (r, g, b, a)
}

fn quadrants() -> Texture.Texture {
  let pixels = bytesOf([255, 0, 0, 255, 0, 255, 0, 255, 0, 0, 255, 255, 255, 255, 255, 255])
  let Some(texture) = Texture.rgba8(2, 2, pixels, "linear") else { panic("texture") }
  texture
}

fn frontBatch(mesh: &Mesh.Mesh) -> Device.ScreenBatch {
  let Some(view) = Camera.lookAt(V.vec3(0.0, 0.0, 3.0), V.vec3(0.0, 0.0, 0.0), V.vec3(0.0, 1.0, 0.0)) else { panic("view") }
  let Some(projection) = Camera.perspective(Float.pi() / 3.0, 1.0, 0.1, 100.0) else { panic("projection") }
  let Some(sun) = Pipeline.light(V.vec3(0.0, 0.0, 1.0), Color.opaque(1.0, 1.0, 1.0), 0.2) else { panic("light") }
  let Some(batch) = Pipeline.project(mesh, &M.identity4(), &M.multiply4(projection, view), &sun, 64, 64) else { panic("project") }
  batch
}

fn coordinates() {
  let plane = Mesh.plane(Color.opaque(1.0, 1.0, 1.0))
  require(Lanes.toArray(&plane.u) == [0.0, 1.0, 1.0, 0.0, 1.0, 0.0], "plane u")
  require(Lanes.toArray(&plane.v) == [1.0, 1.0, 0.0, 1.0, 0.0, 0.0], "plane v")
  let cube = Mesh.cube(Color.opaque(1.0, 1.0, 1.0))
  require(Lanes.count(&cube.u) == 36 && Lanes.count(&cube.v) == 36, "cube coordinates per vertex")
  let sphere = Mesh.sphere(Color.opaque(1.0, 1.0, 1.0))
  require(Lanes.smallest(&sphere.v) == Some(0.0) && Lanes.largest(&sphere.v) == Some(1.0), "sphere latitude spans the texture")
  let Some(custom) = Mesh.fromTriangles(&[V.vec3(0.0, 0.0, 0.0), V.vec3(1.0, 0.0, 0.0), V.vec3(0.0, 1.0, 0.0)], Color.opaque(1.0, 1.0, 1.0)) else { panic("custom") }
  require(Lanes.toArray(&custom.u) == [0.0, 0.0, 0.0], "authored triangles default to zero coordinates")
  let Some(mapped) = Mesh.withCoordinates(custom, Lanes.fromArray(&[0.0, 1.0, 0.0]), Lanes.fromArray(&[1.0, 1.0, 0.0])) else { panic("mapped") }
  require(Lanes.toArray(&mapped.v) == [1.0, 1.0, 0.0], "replaced coordinates")
  require(Mesh.withCoordinates(custom, Lanes.fromArray(&[0.0]), Lanes.fromArray(&[0.0, 1.0, 0.0])) == None, "coordinate count refused")
  require(Mesh.triangleCount(&Mesh.merge(&plane, &cube)) == 14 && Lanes.count(&Mesh.merge(&plane, &cube).u) == 42, "merge keeps coordinates")
}

fn textured() {
  let Some(target) = Device.target(64, 64) else { panic("target") }
  let batch = frontBatch(&Mesh.cube(Color.opaque(1.0, 1.0, 1.0)))
  let texture = quadrants()
  let Some(drawn) = Device.drawTextured(target, &batch, Device.CullBack, &texture, "nearest") else { panic("textured draw") }
  require(pixel(&drawn, 27, 27) == (255u8, 0u8, 0u8, 255u8), "top-left texel upright")
  require(pixel(&drawn, 37, 27) == (0u8, 255u8, 0u8, 255u8), "top-right texel")
  require(pixel(&drawn, 27, 37) == (0u8, 0u8, 255u8, 255u8), "bottom-left texel")
  require(pixel(&drawn, 37, 37) == (255u8, 255u8, 255u8, 255u8), "bottom-right texel")
  require(pixel(&drawn, 1, 1) == (0u8, 0u8, 0u8, 0u8), "background untouched")
  let Some(filtered) = Device.drawTextured(target, &batch, Device.CullBack, &texture, "bilinear") else { panic("bilinear draw") }
  let (r, g, _, _) = pixel(&filtered, 32, 27)
  require(r > 0u8 && g > 0u8, "bilinear blends across the vertical seam")
  require(Device.drawTextured(target, &batch, Device.CullBack, &texture, "trilinear") == None, "unknown filter")
  require(Device.drawTextured(target, &batch, Device.CullBack, &Texture.Texture{..texture, space: "unknown"}, "nearest") == None, "unknown space")
  require(Device.drawTextured(target, &Device.ScreenBatch{..batch, us: Lanes.fromArray(&[0.0])}, Device.CullBack, &texture, "nearest") == None, "coordinate lane mismatch")
  let Some(untextured) = Device.draw(target, &batch, Device.CullBack) else { panic("untextured draw") }
  require(pixel(&untextured, 27, 27) == (255u8, 255u8, 255u8, 255u8), "vertex color path unchanged")
}

fn material() {
  let Some(white) = Texture.rgba8(1, 1, bytesOf([255, 255, 255, 255]), "srgb") else { panic("white") }
  let Some(cooked) = Import.cookTexture(&white) else { panic("cook") }
  let files = mapOf([("white.arkt", cooked), ("orange.mat", bytesOf([255, 128, 0, 255]))])
  let Ok(vfs) = Vfs.mountMemory(Vfs.empty(), "game", &files) else { panic("mount") }
  let sources = [
    Server.Source{id: "white", path: "game:/white.arkt", importer: "texture", dependencies: []},
    Server.Source{id: "orange", path: "game:/orange.mat", importer: "material", dependencies: ["white"]},
  ]
  let Ok(server) = Server.open(vfs, &sources) else { panic("assets") }
  let Some(issued) = Server.handle(&server, "orange") else { panic("handle") }
  let Some(Import.Surface(orange)) = Server.payload(&server, issued) else { panic("material") }
  let Some(target) = Device.target(64, 64) else { panic("target") }
  let Some(drawn) = Device.drawMaterial(target, &frontBatch(&Mesh.cube(Color.opaque(1.0, 1.0, 1.0))), Device.CullBack, &orange, "bilinear") else { panic("material draw") }
  require(pixel(&drawn, 32, 32) == (255u8, 128u8, 0u8, 255u8), "tint multiplies the lit albedo")
}

export fn main() -> Int {
  coordinates()
  textured()
  material()
  print("ark textured: ok")
  0
}
