module Main

trait Tag { fn tag(self: &Self) -> Str }

@json("order") type Order = {
  @skip cache: Option[Str],
  id: Int
} derives Tag

type Shape = @round Circle{radius: Int} | Square{side: Int} derives Tag

derive Tag for T: Record {
  fn tag(self: &T) -> Str {
    var out = "tag"
    comptime for x: Int in [1, 2] {
      out = out + "r"
    }
    out
  }
}

derive impl Tag for Line

type Line = { sku: Str }

derive Tag for T: Sum {
  fn tag(self: &T) -> Str { "sum" }
}

export fn main() -> Str {
  let order = Order{cache: None, id: 1}
  let line = Line{sku: "x"}
  let shape = Shape.Circle{radius: 2}
  order.tag() + line.tag() + shape.tag()
}
