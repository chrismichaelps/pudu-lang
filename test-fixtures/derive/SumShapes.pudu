module SumShapes

import Std.Meta

trait Tag { fn tag(self: &Self) -> Str }

type Shape = @round Circle{radius: Int} | Square{side: Int} derives Tag

type Other = Ready | Done
type Meters = Other derives Tag

derive Tag for T: Sum {
  fn tag(self: &T) -> Str { Meta.nameOf[T]() + ":sum" }
}

export fn main() -> Str {
  let shape = Shape.Circle{radius: 2}
  let meters: Meters = Other.Ready
  shape.tag() + meters.tag()
}
