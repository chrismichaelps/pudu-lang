module UsesCryptoSurface

import Std.Bytes as ByteSeq
import Std.Crypto as Crypto
import Std.Option as Option

fn keyOf(fill: UInt8) -> Bytes {
  var made: Array[UInt8] = []
  var i = 0
  while i < Crypto.keyLength() {
    made = made.push(fill)
    i = i + 1
  }
  ByteSeq.fromArray(&made)
}

fn nonceOf(fill: UInt8) -> Bytes {
  var made: Array[UInt8] = []
  var i = 0
  while i < Crypto.nonceLength() {
    made = made.push(fill)
    i = i + 1
  }
  ByteSeq.fromArray(&made)
}

fn main() -> Int {
  var held = 0
  let key = keyOf(7u8)
  let nonce = nonceOf(1u8)
  let message = "the terms of the agreement".toBytes()
  let context = "invoice-42".toBytes()

  // 1. RFC 4231 test case 2: the keyed digest of a published vector
  let mac = Crypto.hmacSha256Text("Jefe", "what do ya want for nothing?")
  if ByteSeq.encodeHex(&mac) == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843" {
    held = held + 1
  }

  // 2. The keyed digest changes with the key, which is the whole point
  let other = Crypto.hmacSha256Text("Jefo", "what do ya want for nothing?")
  if ByteSeq.encodeHex(&other) != ByteSeq.encodeHex(&mac) {
    held = held + 1
  }

  // 3. SHA-512 of the empty message, against its published value
  let emptyDigest = Crypto.sha512(&ByteSeq.empty())
  if ByteSeq.encodeHex(&emptyDigest).take(32) == "cf83e1357eefb8bdf1542850d66d8007" {
    held = held + 1
  }

  // 4. A SHA-512 digest is sixty-four bytes
  if emptyDigest.length() == 64 {
    held = held + 1
  }

  // 5. A derived key has the length that was asked for
  let derived = Crypto.derive(&"password".toBytes(), &"salt".toBytes(), 100, 24)
  if derived.length() == 24 {
    held = held + 1
  }

  // 6. Deriving is deterministic, or nothing could check a password twice
  let again = Crypto.derive(&"password".toBytes(), &"salt".toBytes(), 100, 24)
  if ByteSeq.encodeHex(&derived) == ByteSeq.encodeHex(&again) {
    held = held + 1
  }

  // 7. A sealed message opens back to what was sealed
  let sealed = Option.unwrapOr(Crypto.seal(&key, &nonce, &message, &context), ByteSeq.empty())
  let opened = Option.unwrapOr(Crypto.open(&key, &nonce, &sealed, &context), ByteSeq.empty())
  if ByteSeq.toText(&opened) == Ok("the terms of the agreement") {
    held = held + 1
  }

  // 8. Sealing hides the message rather than merely moving it
  if ByteSeq.encodeHex(&sealed) != ByteSeq.encodeHex(&message) {
    held = held + 1
  }

  // 9. The tag makes a sealed message longer than what went in
  if sealed.length() == message.length() + 16 {
    held = held + 1
  }

  // 10. The wrong key opens nothing
  match Crypto.open(&keyOf(8u8), &nonce, &sealed, &context) {
    case Some(_) => {}
    case None => { held = held + 1 }
  }

  // 11. A changed byte is detected rather than decrypted
  var damagedBytes = sealed.toArray()
  damagedBytes = damagedBytes.remove(0).insert(0, 255u8)
  let damaged = ByteSeq.fromArray(&damagedBytes)
  match Crypto.open(&key, &nonce, &damaged, &context) {
    case Some(_) => {}
    case None => { held = held + 1 }
  }

  // 12. Context that travels in the clear is still protected from being swapped
  match Crypto.open(&key, &nonce, &sealed, &"invoice-43".toBytes()) {
    case Some(_) => {}
    case None => { held = held + 1 }
  }

  // 13. A key of the wrong length is refused rather than padded
  match Crypto.seal(&"short".toBytes(), &nonce, &message, &context) {
    case Some(_) => {}
    case None => { held = held + 1 }
  }

  // 14. A different nonce seals the same message differently
  let elsewhere = Option.unwrapOr(Crypto.seal(&key, &nonceOf(2u8), &message, &context), ByteSeq.empty())
  if ByteSeq.encodeHex(&elsewhere) != ByteSeq.encodeHex(&sealed) {
    held = held + 1
  }

  held
}
