module UsesQuery

import Std.Db.Query {BadName, BadOperator, Empty}
import Std.Db.Query as Query
import Std.Result as Result

/// What a statement builder promises.
///
/// The claim under test is that a value cannot become part of what runs, and
/// that the one place a parameter cannot help — a name — is refused rather
/// than quoted.
export fn main() -> Int {
  var held = 0

  // A value travels beside the statement, never inside it.
  let byName = orEmpty(Query.matching(&orEmpty(Query.from("users")), "name", "=", Some("ada")))
  if Query.textOf(&byName) == "select * from users where name = $1" { held = held + 1 }
  if Query.valuesOf(&byName) == [Some("ada")] { held = held + 1 }
  if Query.valueCount(&byName) == 1 { held = held + 1 }

  // A value that is a whole statement is still just a value. This is the
  // check the module exists for: there is no call that would have put it in
  // the text, so nothing had to remember to escape it.
  let hostile = orEmpty(
    Query.matching(&orEmpty(Query.from("users")), "name", "=", Some("'; drop table users; --"))
  )
  if !Query.textOf(&hostile).contains("drop table") { held = held + 1 }
  if Query.textOf(&hostile) == "select * from users where name = $1" { held = held + 1 }
  if Query.valuesOf(&hostile) == [Some("'; drop table users; --")] { held = held + 1 }

  // Placeholders are numbered as values are added, so two conditions do not
  // both claim the first.
  let two = orEmpty(Query.also(&byName, "age", ">", Some("18")))
  if Query.textOf(&two) == "select * from users where name = $1 and age > $2" { held = held + 1 }
  if Query.valueCount(&two) == 2 { held = held + 1 }
  let three = orEmpty(Query.either(&two, "role", "=", Some("admin")))
  if Query.textOf(&three).contains("or role = $3") { held = held + 1 }

  // A name is refused rather than quoted, because quoting correctly depends
  // on the dialect and a quoted name that was wrong is an injection that
  // looks handled.
  if let Err(BadName(_)) = Query.name("users; drop table users") { held = held + 1 }
  if let Err(BadName(_)) = Query.name("name\"") { held = held + 1 }
  if let Err(BadName(_)) = Query.name("a b") { held = held + 1 }
  if let Err(BadName(_)) = Query.name("1st") { held = held + 1 }
  if let Err(Empty) = Query.name("") { held = held + 1 }
  if Result.unwrapOr(Query.name("user_name"), "") == "user_name" { held = held + 1 }
  if Result.unwrapOr(Query.name("Users2"), "") == "Users2" { held = held + 1 }

  // A statement whose table came from outside is refused before it is built.
  if let Err(_) = Query.from("users; drop table users") { held = held + 1 }
  if let Err(_) = Query.matching(&byName, "name); drop table users; --", "=", Some("x")) {
    held = held + 1
  }

  // A name that really does come from outside is chosen from a list the
  // program wrote, so nothing outside decides anything.
  if Result.unwrapOr(Query.oneOf("name", &["name", "age"]), "") == "name" { held = held + 1 }
  if let Err(_) = Query.oneOf("password", &["name", "age"]) { held = held + 1 }

  // An operator comes from a stated set, because one from outside is as
  // dangerous as a name from outside.
  if Result.unwrapOr(Query.operator(">="), "") == ">=" { held = held + 1 }
  if Result.unwrapOr(Query.operator("LIKE"), "") == "like" { held = held + 1 }
  if let Err(BadOperator(_)) = Query.operator("= 1 or 1") { held = held + 1 }
  if let Err(_) = Query.matching(&byName, "name", "= 1 or 1", Some("x")) { held = held + 1 }

  // Named columns, and a count.
  let named = orEmpty(Query.selecting(&["id", "name"], "users"))
  if Query.textOf(&named) == "select id, name from users" { held = held + 1 }
  if let Err(_) = Query.selecting(&["id", "name); --"], "users") { held = held + 1 }
  if let Err(Empty) = Query.selecting(&[], "users") { held = held + 1 }
  if Query.textOf(&orEmpty(Query.counting("users"))) == "select count(*) as count from users" {
    held = held + 1
  }

  // A list of values is a list of parameters, however long, so a list from
  // outside cannot become part of the text.
  let among = orEmpty(
    Query.matchingOneOf(&orEmpty(Query.from("users")), "id", &[Some("1"), Some("2"), Some("3")])
  )
  if Query.textOf(&among) == "select * from users where id in ($1, $2, $3)" { held = held + 1 }
  if Query.valueCount(&among) == 3 { held = held + 1 }

  // Nothing is in an empty list, which is said rather than built into a
  // statement the database would refuse to parse.
  let none = orEmpty(Query.matchingOneOf(&orEmpty(Query.from("users")), "id", &[]))
  if Query.textOf(&none) == "select * from users where false" { held = held + 1 }
  if Query.valueCount(&none) == 0 { held = held + 1 }

  // A column that holds nothing is asked about without a parameter, because
  // there is no value to compare against.
  let missing = orEmpty(Query.matchingMissing(&orEmpty(Query.from("users")), "deleted_at"))
  if Query.textOf(&missing) == "select * from users where deleted_at is null" { held = held + 1 }
  if Query.valueCount(&missing) == 0 { held = held + 1 }

  // Ordering, a bound, and a starting point.
  let paged = Query.offset(&Query.limit(&orEmpty(Query.orderBy(&named, "name", false)), 10), 20)
  if Query.textOf(&paged) == "select id, name from users order by name asc limit 10 offset 20" {
    held = held + 1
  }
  if Query.textOf(&orEmpty(Query.orderBy(&named, "name", true))).contains("desc") {
    held = held + 1
  }
  if let Err(_) = Query.orderBy(&named, "name; drop table users", false) { held = held + 1 }

  // Adding a row: the columns are names and the values are parameters.
  let added = orEmpty(Query.insert("users", &["name", "age"], &[Some("ada"), Some("36")]))
  if Query.textOf(&added) == "insert into users (name, age) values ($1, $2)" { held = held + 1 }
  if Query.valuesOf(&added) == [Some("ada"), Some("36")] { held = held + 1 }

  // A column list and a value list that do not correspond is a mistake rather
  // than a statement with a hole in it.
  if let Err(Empty) = Query.insert("users", &["name", "age"], &[Some("ada")]) { held = held + 1 }
  if let Err(Empty) = Query.insert("users", &[], &[]) { held = held + 1 }

  // Changing rows, with the conditions numbered after the assignments.
  let changed = orEmpty(Query.insert("x", &["a"], &[Some("1")]))
  let edited = orEmpty(Query.update("users", &["name"], &[Some("grace")]))
  let edittedWhere = orEmpty(Query.matching(&edited, "id", "=", Some("7")))
  if Query.textOf(&edittedWhere) == "update users set name = $1 where id = $2" { held = held + 1 }
  if Query.valuesOf(&edittedWhere) == [Some("grace"), Some("7")] { held = held + 1 }
  if Query.valueCount(&changed) == 1 { held = held + 1 }

  // Removing rows.
  let removed = orEmpty(Query.matching(&orEmpty(Query.deleteFrom("users")), "id", "=", Some("7")))
  if Query.textOf(&removed) == "delete from users where id = $1" { held = held + 1 }

  // A statement that answers with what it changed.
  let answering = orEmpty(Query.returning(&added, &["id"]))
  if Query.textOf(&answering).contains("returning id") { held = held + 1 }
  if let Err(_) = Query.returning(&added, &["id; --"]) { held = held + 1 }

  // Two statements joined keep every value, and the second's placeholders
  // follow the first's rather than repeating them.
  let joined = Query.then(&byName, &Query.withValue(&Query.empty(), "and age >", Some("18")))
  if Query.textOf(&joined) == "select * from users where name = $1 and age > $2" { held = held + 1 }
  if Query.valueCount(&joined) == 2 { held = held + 1 }

  // Text the program wrote carries no values, which is what keeps the door
  // that takes finished statements from also taking values.
  if Query.valueCount(&Query.text("select 1")) == 0 { held = held + 1 }
  if Query.textOf(&Query.empty()).isEmpty() { held = held + 1 }

  // A refusal names what was wrong.
  if Query.explain(&BadName("a b")).contains("a b") { held = held + 1 }
  if Query.explain(&BadOperator("x")).contains("comparison") { held = held + 1 }

  held
}

fn orEmpty(outcome: Result[Query.Statement, Query.QueryError]) -> Query.Statement {
  Result.unwrapOr(outcome, Query.empty())
}
