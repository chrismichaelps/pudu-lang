module RejectsDuplicateForeignOwnership

foreign "c" {
  type Box
  fn pudu_ffi_cpp_box_shared() -> owned Box by pudu_ffi_cpp_box_shared_release
  fn pudu_ffi_cpp_box_shared_release(box: Box) -> ()
}

export fn main() -> () {
  unsafe(foreign) {
    let first = pudu_ffi_cpp_box_shared()
    let second = pudu_ffi_cpp_box_shared()
  }
}
