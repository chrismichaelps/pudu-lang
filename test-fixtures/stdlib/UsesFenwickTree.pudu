module UsesFenwickTree

import Std.FenwickTree as FenwickTree

fn addDelta(ft: FenwickTree, idx: Int, delta: Int) -> FenwickTree {
  match FenwickTree.add(&ft, idx, delta) {
    case Some(updated) => updated
    case None => ft
  }
}

fn setValue(ft: FenwickTree, idx: Int, val: Int) -> FenwickTree {
  match FenwickTree.set(&ft, idx, val) {
    case Some(updated) => updated
    case None => ft
  }
}

fn main() -> Int {
  var held = 0

  // 1. Empty tree initialization and boundary checks
  let emptyFt = FenwickTree.create(0)
  if FenwickTree.size(&emptyFt) == 0
    && FenwickTree.prefixSum(&emptyFt, 0) == Some(0)
    && FenwickTree.prefixSum(&emptyFt, 1) == None
    && FenwickTree.rangeSum(&emptyFt, 1, 1) == None {
    held = held + 1
  }

  // 2. Linear O(n) construction from array and prefix sums
  let raw = [1, 2, 3, 4, 5, 6, 7, 8]
  let ft = FenwickTree.fromArray(&raw)
  if FenwickTree.size(&ft) == 8
    && FenwickTree.prefixSum(&ft, 0) == Some(0)
    && FenwickTree.prefixSum(&ft, 1) == Some(1)
    && FenwickTree.prefixSum(&ft, 2) == Some(3)
    && FenwickTree.prefixSum(&ft, 3) == Some(6)
    && FenwickTree.prefixSum(&ft, 4) == Some(10)
    && FenwickTree.prefixSum(&ft, 8) == Some(36)
    && FenwickTree.prefixSum(&ft, 9) == None {
    held = held + 1
  }

  // 3. Range sum calculations across interior and full spans
  let r1 = FenwickTree.rangeSum(&ft, 2, 4)
  let r2 = FenwickTree.rangeSum(&ft, 1, 8)
  let r3 = FenwickTree.rangeSum(&ft, 5, 5)
  if r1 == Some(9) && r2 == Some(36) && r3 == Some(5) {
    held = held + 1
  }

  // 4. Invalid range sum inputs
  let inv1 = FenwickTree.rangeSum(&ft, 6, 5)
  let inv2 = FenwickTree.rangeSum(&ft, 0, 5)
  let inv3 = FenwickTree.rangeSum(&ft, 1, 10)
  let inv4 = FenwickTree.rangeSum(&ft, -1, 3)
  if inv1 == None && inv2 == None && inv3 == None && inv4 == None {
    held = held + 1
  }

  // 5. Point addition (add) updates subsequent prefix sums
  var ftMod = addDelta(ft, 3, 10)
  if FenwickTree.get(&ftMod, 3) == Some(13)
    && FenwickTree.prefixSum(&ftMod, 2) == Some(3)
    && FenwickTree.prefixSum(&ftMod, 3) == Some(16)
    && FenwickTree.prefixSum(&ftMod, 8) == Some(46)
    && FenwickTree.rangeSum(&ftMod, 3, 5) == Some(22) {
    held = held + 1
  }

  // 6. Point set replacement updates exact values
  ftMod = setValue(ftMod, 1, 100)
  if FenwickTree.get(&ftMod, 1) == Some(100)
    && FenwickTree.prefixSum(&ftMod, 1) == Some(100)
    && FenwickTree.prefixSum(&ftMod, 2) == Some(102)
    && FenwickTree.rangeSum(&ftMod, 1, 8) == Some(145) {
    held = held + 1
  }

  // 7. Binary lifting search (findPrefix) for exact cumulative thresholds
  let p1 = FenwickTree.findPrefix(&ft, 1)
  let p2 = FenwickTree.findPrefix(&ft, 3)
  let p3 = FenwickTree.findPrefix(&ft, 4)
  let p4 = FenwickTree.findPrefix(&ft, 10)
  let p5 = FenwickTree.findPrefix(&ft, 36)
  if p1 == Some(1) && p2 == Some(2) && p3 == Some(3) && p4 == Some(4) && p5 == Some(8) {
    held = held + 1
  }

  // 8. Binary lifting edge cases (target <= 0, target beyond total)
  let pZero = FenwickTree.findPrefix(&ft, 0)
  let pNeg = FenwickTree.findPrefix(&ft, -5)
  let pOob = FenwickTree.findPrefix(&ft, 37)
  if pZero == Some(1) && pNeg == Some(1) && pOob == None {
    held = held + 1
  }

  // 9. Materialization to array matches original contents
  let elements = FenwickTree.toArray(&ft)
  if elements.length() == 8
    && elements[0] == 1
    && elements[1] == 2
    && elements[2] == 3
    && elements[3] == 4
    && elements[4] == 5
    && elements[5] == 6
    && elements[6] == 7
    && elements[7] == 8 {
    held = held + 1
  }

  // 10. Out of bounds add and set return None
  let addOobLow = FenwickTree.add(&ft, 0, 5)
  let addOobHigh = FenwickTree.add(&ft, 9, 5)
  let setOobLow = FenwickTree.set(&ft, -1, 5)
  let setOobHigh = FenwickTree.set(&ft, 10, 5)
  if addOobLow == None && addOobHigh == None && setOobLow == None && setOobHigh == None {
    held = held + 1
  }

  held
}
