module RejectsForeignReleaseShape

foreign "c" {
  type Box
  type Other
  fn pudu_ffi_cpp_box_new(value: Int32) -> owned Box by pudu_ffi_cpp_box_read
  // A release answering a number is admitted, because that is what releasing
  // looks like in C — `sqlite3_close` and `fclose` both answer one — and the
  // value is discarded rather than handed back. A release answering a handle
  // is not: that is the library returning a resource nobody would claim.
  fn pudu_ffi_cpp_box_read(box: Box) -> Other
}

export fn main() -> Int { 0 }
