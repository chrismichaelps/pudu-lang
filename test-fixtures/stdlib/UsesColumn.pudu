module UsesColumn

import Std.Buffer as Buffer
import Std.Column as Column
import Std.Option as Option

fn testBasicColumnWorkflow() -> Option[Bool] {
  let col0 = Column.createU64(10)
  let col1 = Column.appendU64(&col0, 100u64) ?
  let col2 = Column.appendU64(&col1, 200u64) ?
  let col3 = Column.appendU64(&col2, 300u64) ?
  let col4 = Column.appendU64(&col3, 400u64) ?

  // Add null, then scalar, then another null
  let col5 = Column.appendNullU64(&col4) ?
  let col6 = Column.appendU64(&col5, 500u64) ?
  let col7 = Column.appendNullU64(&col6) ?

  let v0 = Column.getU64(&col7, 0) ?
  let v1 = Column.getU64(&col7, 1) ?
  let v2 = Column.getU64(&col7, 2) ?
  let v3 = Column.getU64(&col7, 3) ?
  let v5 = Column.getU64(&col7, 5) ?

  let isNull4 = Column.isNull(&col7, 4)
  let isNull6 = Column.isNull(&col7, 6)
  let isNull0 = Column.isNull(&col7, 0)

  let nullVal4 = Column.getU64(&col7, 4)
  let nullVal6 = Column.getU64(&col7, 6)

  // Vectorized aggregations across mixed valid and null rows
  let totalSum = Column.sum(&col7)
  let minVal = Column.min(&col7) ?
  let maxVal = Column.max(&col7) ?

  Some(Column.length(&col7) == 7
      && Column.nullCount(&col7) == 2
      && v0 == 100u64
      && v1 == 200u64
      && v2 == 300u64
      && v3 == 400u64
      && v5 == 500u64
      && isNull4
      && isNull6
      && !isNull0
      && Option.isNone(&nullVal4)
      && Option.isNone(&nullVal6)
      && totalSum == 1500u64
      && minVal == 100u64
      && maxVal == 500u64)
}

fn testFilterAndProject() -> Option[Bool] {
  let col0 = Column.createU64(8)
  let col1 = Column.appendU64(&col0, 10u64) ?
  let col2 = Column.appendU64(&col1, 50u64) ?
  let col3 = Column.appendNullU64(&col2) ?
  let col4 = Column.appendU64(&col3, 80u64) ?
  let col5 = Column.appendU64(&col4, 25u64) ?
  let col6 = Column.appendU64(&col5, 100u64) ?

  // Filter rows where value > 30u64: should match 50u64 (row 1), 80u64 (row 3), 100u64 (row 5)
  let sel = Column.filterGt(&col6, 30u64)
  let proj = Column.project(&col6, &sel)

  let p0 = Column.getU64(&proj, 0) ?
  let p1 = Column.getU64(&proj, 1) ?
  let p2 = Column.getU64(&proj, 2) ?

  let projSum = Column.sum(&proj)
  let projMin = Column.min(&proj) ?
  let projMax = Column.max(&proj) ?

  Some(Column.length(&proj) == 3
      && Column.nullCount(&proj) == 0
      && p0 == 50u64
      && p1 == 80u64
      && p2 == 100u64
      && projSum == 230u64
      && projMin == 50u64
      && projMax == 100u64)
}

fn testEmptyAndAllNullColumns() -> Option[Bool] {
  let emptyCol = Column.createU64(0)
  let emptySum = Column.sum(&emptyCol)
  let emptyMin = Column.min(&emptyCol)
  let emptyMax = Column.max(&emptyCol)

  let nullCol0 = Column.createU64(4)
  let nullCol1 = Column.appendNullU64(&nullCol0) ?
  let nullCol2 = Column.appendNullU64(&nullCol1) ?
  let allNullSum = Column.sum(&nullCol2)
  let allNullMin = Column.min(&nullCol2)
  let allNullMax = Column.max(&nullCol2)

  Some(emptySum == 0u64
      && Option.isNone(&emptyMin)
      && Option.isNone(&emptyMax)
      && allNullSum == 0u64
      && Option.isNone(&allNullMin)
      && Option.isNone(&allNullMax))
}

fn testFloatColumnWorkflow() -> Option[Bool] {
  let col0 = Column.createF64(10)
  let col1 = Column.appendF64(&col0, 1.5) ?
  let col2 = Column.appendF64(&col1, 2.5) ?
  let col3 = Column.appendF64(&col2, 3.5) ?
  let col4 = Column.appendF64(&col3, 4.5) ?

  // Add null, then scalar, then another null
  let col5 = Column.appendNullF64(&col4) ?
  let col6 = Column.appendF64(&col5, 5.5) ?
  let col7 = Column.appendNullF64(&col6) ?

  let v0 = Column.getF64(&col7, 0) ?
  let v1 = Column.getF64(&col7, 1) ?
  let v2 = Column.getF64(&col7, 2) ?
  let v3 = Column.getF64(&col7, 3) ?
  let v5 = Column.getF64(&col7, 5) ?

  let isNull4 = Column.isNullF64(&col7, 4)
  let isNull6 = Column.isNullF64(&col7, 6)
  let isNull0 = Column.isNullF64(&col7, 0)

  let nullVal4 = Column.getF64(&col7, 4)
  let nullVal6 = Column.getF64(&col7, 6)

  // Vectorized float aggregations
  let totalSum = Column.sumF64(&col7)
  let minVal = Column.minF64(&col7) ?
  let maxVal = Column.maxF64(&col7) ?

  Some(Column.lengthF64(&col7) == 7
      && Column.nullCountF64(&col7) == 2
      && v0 == 1.5
      && v1 == 2.5
      && v2 == 3.5
      && v3 == 4.5
      && v5 == 5.5
      && isNull4
      && isNull6
      && !isNull0
      && Option.isNone(&nullVal4)
      && Option.isNone(&nullVal6)
      && totalSum == 17.5
      && minVal == 1.5
      && maxVal == 5.5)
}

fn testFloatFilterAndProject() -> Option[Bool] {
  let col0 = Column.createF64(8)
  let col1 = Column.appendF64(&col0, 1.0) ?
  let col2 = Column.appendF64(&col1, 5.0) ?
  let col3 = Column.appendNullF64(&col2) ?
  let col4 = Column.appendF64(&col3, 8.0) ?
  let col5 = Column.appendF64(&col4, 2.5) ?
  let col6 = Column.appendF64(&col5, 10.0) ?

  // Filter rows where value > 3.0: rows 1 (5.0), 3 (8.0), 5 (10.0)
  let selGt = Column.filterGtF64(&col6, 3.0)
  let projGt = Column.projectF64(&col6, &selGt)

  let p0 = Column.getF64(&projGt, 0) ?
  let p1 = Column.getF64(&projGt, 1) ?
  let p2 = Column.getF64(&projGt, 2) ?

  let projSum = Column.sumF64(&projGt)
  let projMin = Column.minF64(&projGt) ?
  let projMax = Column.maxF64(&projGt) ?

  // Filter rows where value < 3.0: rows 0 (1.0), 4 (2.5)
  let selLt = Column.filterLtF64(&col6, 3.0)
  let projLt = Column.projectF64(&col6, &selLt)

  let lt0 = Column.getF64(&projLt, 0) ?
  let lt1 = Column.getF64(&projLt, 1) ?

  Some(Column.lengthF64(&projGt) == 3
      && Column.nullCountF64(&projGt) == 0
      && p0 == 5.0
      && p1 == 8.0
      && p2 == 10.0
      && projSum == 23.0
      && projMin == 5.0
      && projMax == 10.0
      && Column.lengthF64(&projLt) == 2
      && lt0 == 1.0
      && lt1 == 2.5)
}

fn testFloatVectorAddition() -> Option[Bool] {
  let colA0 = Column.createF64(4)
  let colA1 = Column.appendF64(&colA0, 10.5) ?
  let colA2 = Column.appendNullF64(&colA1) ?
  let colA3 = Column.appendF64(&colA2, 30.0) ?
  let colA4 = Column.appendF64(&colA3, 40.25) ?

  let colB0 = Column.createF64(4)
  let colB1 = Column.appendF64(&colB0, 5.5) ?
  let colB2 = Column.appendF64(&colB1, 15.0) ?
  let colB3 = Column.appendNullF64(&colB2) ?
  let colB4 = Column.appendF64(&colB3, 10.75) ?

  let sumCol = Column.addF64(&colA4, &colB4) ?

  let r0 = Column.getF64(&sumCol, 0) ?
  let isNull1 = Column.isNullF64(&sumCol, 1)
  let isNull2 = Column.isNullF64(&sumCol, 2)
  let r3 = Column.getF64(&sumCol, 3) ?

  let totalSum = Column.sumF64(&sumCol)

  Some(Column.lengthF64(&sumCol) == 4
      && Column.nullCountF64(&sumCol) == 2
      && r0 == 16.0
      && isNull1
      && isNull2
      && r3 == 51.0
      && totalSum == 67.0)
}

fn testBitmapAlgebra() -> Option[Bool] {
  let col0 = Column.createF64(6)
  let col1 = Column.appendF64(&col0, 10.0) ?
  let col2 = Column.appendF64(&col1, 20.0) ?
  let col3 = Column.appendF64(&col2, 30.0) ?
  let col4 = Column.appendF64(&col3, 40.0) ?
  let col5 = Column.appendF64(&col4, 50.0) ?
  let col6 = Column.appendF64(&col5, 60.0) ?

  // Mask 1: value > 15.0 (rows 1, 2, 3, 4, 5) -> count 5
  let mask1 = Column.filterGtF64(&col6, 15.0)
  let count1 = Column.bitmapCount(&mask1, 6)

  // Mask 2: value < 45.0 (rows 0, 1, 2, 3) -> count 4
  let mask2 = Column.filterLtF64(&col6, 45.0)
  let count2 = Column.bitmapCount(&mask2, 6)

  // AND: (15.0 < val < 45.0) -> rows 1, 2, 3 -> count 3
  let andMask = Column.bitmapAnd(&mask1, &mask2, 6)
  let andCount = Column.bitmapCount(&andMask, 6)
  let andProj = Column.projectF64(&col6, &andMask)

  // OR: (val > 15.0 || val < 45.0) -> rows 0, 1, 2, 3, 4, 5 -> count 6
  let orMask = Column.bitmapOr(&mask1, &mask2, 6)
  let orCount = Column.bitmapCount(&orMask, 6)

  // NOT: !(andMask) -> rows 0, 4, 5 -> count 3
  let notMask = Column.bitmapNot(&andMask, 6)
  let notCount = Column.bitmapCount(&notMask, 6)
  let notProj = Column.projectF64(&col6, &notMask)

  let ap0 = Column.getF64(&andProj, 0) ?
  let ap1 = Column.getF64(&andProj, 1) ?
  let ap2 = Column.getF64(&andProj, 2) ?

  let np0 = Column.getF64(&notProj, 0) ?
  let np1 = Column.getF64(&notProj, 1) ?
  let np2 = Column.getF64(&notProj, 2) ?

  Some(count1 == 5
      && count2 == 4
      && andCount == 3
      && orCount == 6
      && notCount == 3
      && Column.lengthF64(&andProj) == 3
      && ap0 == 20.0
      && ap1 == 30.0
      && ap2 == 40.0
      && Column.lengthF64(&notProj) == 3
      && np0 == 10.0
      && np1 == 50.0
      && np2 == 60.0)
}

fn testEmptyAndAllNullFloatColumns() -> Option[Bool] {
  let emptyCol = Column.createF64(0)
  let emptySum = Column.sumF64(&emptyCol)
  let emptyMin = Column.minF64(&emptyCol)
  let emptyMax = Column.maxF64(&emptyCol)

  let nullCol0 = Column.createF64(4)
  let nullCol1 = Column.appendNullF64(&nullCol0) ?
  let nullCol2 = Column.appendNullF64(&nullCol1) ?
  let allNullSum = Column.sumF64(&nullCol2)
  let allNullMin = Column.minF64(&nullCol2)
  let allNullMax = Column.maxF64(&nullCol2)

  Some(emptySum == 0.0
      && Option.isNone(&emptyMin)
      && Option.isNone(&emptyMax)
      && allNullSum == 0.0
      && Option.isNone(&allNullMin)
      && Option.isNone(&allNullMax))
}

fn testIntegerSortingAndBinarySearch() -> Option[Bool] {
  let col0 = Column.createU64(7)
  let col1 = Column.appendU64(&col0, 40u64) ?
  let col2 = Column.appendU64(&col1, 10u64) ?
  let col3 = Column.appendNullU64(&col2) ?
  let col4 = Column.appendU64(&col3, 30u64) ?
  let col5 = Column.appendU64(&col4, 20u64) ?
  let col6 = Column.appendNullU64(&col5) ?
  let col7 = Column.appendU64(&col6, 50u64) ?

  // Compute sorted permutation indices (ASC NULLS LAST)
  let perm = Column.sortIndices(&col7)
  let s0 = Buffer.readU64(&perm, 0) ?
  let s1 = Buffer.readU64(&perm, 8) ?
  let s2 = Buffer.readU64(&perm, 16) ?
  let s3 = Buffer.readU64(&perm, 24) ?
  let s4 = Buffer.readU64(&perm, 32) ?

  // Binary search over valid portion
  let found30 = Column.binarySearch(&col7, &perm, 30u64) ?
  let found10 = Column.binarySearch(&col7, &perm, 10u64) ?
  let found50 = Column.binarySearch(&col7, &perm, 50u64) ?
  let notFound = Column.binarySearch(&col7, &perm, 99u64)

  // Gather rows in sorted permutation order
  let sortedCol = Column.gather(&col7, &perm)
  let g0 = Column.getU64(&sortedCol, 0) ?
  let g1 = Column.getU64(&sortedCol, 1) ?
  let g2 = Column.getU64(&sortedCol, 2) ?
  let g3 = Column.getU64(&sortedCol, 3) ?
  let g4 = Column.getU64(&sortedCol, 4) ?
  let gNull5 = Column.isNull(&sortedCol, 5)
  let gNull6 = Column.isNull(&sortedCol, 6)
  let gatheredSum = Column.sum(&sortedCol)

  Some(s0 == 1u64
      && s1 == 4u64
      && s2 == 3u64
      && s3 == 0u64
      && s4 == 6u64
      && found30 == 3
      && found10 == 1
      && found50 == 6
      && Option.isNone(&notFound)
      && Column.length(&sortedCol) == 7
      && Column.nullCount(&sortedCol) == 2
      && g0 == 10u64
      && g1 == 20u64
      && g2 == 30u64
      && g3 == 40u64
      && g4 == 50u64
      && gNull5
      && gNull6
      && gatheredSum == 150u64)
}

fn testFloatSortingAndBinarySearch() -> Option[Bool] {
  let col0 = Column.createF64(7)
  let col1 = Column.appendF64(&col0, 40.5) ?
  let col2 = Column.appendF64(&col1, 10.25) ?
  let col3 = Column.appendNullF64(&col2) ?
  let col4 = Column.appendF64(&col3, 30.0) ?
  let col5 = Column.appendF64(&col4, 20.75) ?
  let col6 = Column.appendNullF64(&col5) ?
  let col7 = Column.appendF64(&col6, 50.125) ?

  // Compute sorted permutation indices (ASC NULLS LAST)
  let perm = Column.sortIndicesF64(&col7)
  let s0 = Buffer.readU64(&perm, 0) ?
  let s1 = Buffer.readU64(&perm, 8) ?
  let s2 = Buffer.readU64(&perm, 16) ?
  let s3 = Buffer.readU64(&perm, 24) ?
  let s4 = Buffer.readU64(&perm, 32) ?

  // Binary search over valid portion
  let found30 = Column.binarySearchF64(&col7, &perm, 30.0) ?
  let found10 = Column.binarySearchF64(&col7, &perm, 10.25) ?
  let found50 = Column.binarySearchF64(&col7, &perm, 50.125) ?
  let notFound = Column.binarySearchF64(&col7, &perm, 99.9)

  // Gather rows in sorted permutation order
  let sortedCol = Column.gatherF64(&col7, &perm)
  let g0 = Column.getF64(&sortedCol, 0) ?
  let g1 = Column.getF64(&sortedCol, 1) ?
  let g2 = Column.getF64(&sortedCol, 2) ?
  let g3 = Column.getF64(&sortedCol, 3) ?
  let g4 = Column.getF64(&sortedCol, 4) ?
  let gNull5 = Column.isNullF64(&sortedCol, 5)
  let gNull6 = Column.isNullF64(&sortedCol, 6)
  let gatheredSum = Column.sumF64(&sortedCol)

  Some(s0 == 1u64
      && s1 == 4u64
      && s2 == 3u64
      && s3 == 0u64
      && s4 == 6u64
      && found30 == 3
      && found10 == 1
      && found50 == 6
      && Option.isNone(&notFound)
      && Column.lengthF64(&sortedCol) == 7
      && Column.nullCountF64(&sortedCol) == 2
      && g0 == 10.25
      && g1 == 20.75
      && g2 == 30.0
      && g3 == 40.5
      && g4 == 50.125
      && gNull5
      && gNull6
      && gatheredSum == 151.625)
}

export fn main() -> Int {
  var held = 0

  // 1. Empty column initialization
  let col = Column.createU64(16)
  if Column.length(&col) == 0 { held = held + 1 }
  if Column.nullCount(&col) == 0 { held = held + 1 }

  // 2. Out of bounds queries
  if Column.isNull(&col, -1) { held = held + 1 }
  if Column.isNull(&col, 0) { held = held + 1 }
  if Option.isNone(&Column.getU64(&col, -1)) { held = held + 1 }
  if Option.isNone(&Column.getU64(&col, 0)) { held = held + 1 }

  // 3. Basic column workflow (appends, nulls, reads, aggregations)
  if Option.unwrapOr(testBasicColumnWorkflow(), false) { held = held + 1 }

  // 4. Vectorized filter predicate scan and column projection
  if Option.unwrapOr(testFilterAndProject(), false) { held = held + 1 }

  // 5. Empty and all-null column edge cases
  if Option.unwrapOr(testEmptyAndAllNullColumns(), false) { held = held + 1 }

  // 6. Float column initialization & out of bounds queries
  let fcol = Column.createF64(16)
  if Column.lengthF64(&fcol) == 0 { held = held + 1 }
  if Column.nullCountF64(&fcol) == 0 { held = held + 1 }
  if Column.isNullF64(&fcol, -1) { held = held + 1 }
  if Column.isNullF64(&fcol, 0) { held = held + 1 }
  if Option.isNone(&Column.getF64(&fcol, -1)) { held = held + 1 }
  if Option.isNone(&Column.getF64(&fcol, 0)) { held = held + 1 }

  // 7. Basic float column workflow (appends, nulls, reads, aggregations)
  if Option.unwrapOr(testFloatColumnWorkflow(), false) { held = held + 1 }

  // 8. Vectorized float filter predicate scans and projections
  if Option.unwrapOr(testFloatFilterAndProject(), false) { held = held + 1 }

  // 9. Vectorized element-wise float addition
  if Option.unwrapOr(testFloatVectorAddition(), false) { held = held + 1 }

  // 10. SIMD/SWAR bitmap query algebra (AND, OR, NOT, popcount)
  if Option.unwrapOr(testBitmapAlgebra(), false) { held = held + 1 }

  // 11. Empty and all-null float columns
  if Option.unwrapOr(testEmptyAndAllNullFloatColumns(), false) { held = held + 1 }

  // 12. Integer column sorting, binary search, and gather
  if Option.unwrapOr(testIntegerSortingAndBinarySearch(), false) { held = held + 1 }

  // 13. Float column sorting, binary search, and gather
  if Option.unwrapOr(testFloatSortingAndBinarySearch(), false) { held = held + 1 }

  held
}
