module UsesColumn

import Std.Buffer as Buffer
import Std.Column as Column
import Std.Option as Option

fn testBasicColumnWorkflow() -> Option[Bool] {
  let col0 = Column.createU64(10)
  let col1 = Column.appendU64(&col0, 100u64) ?
  let col2 = Column.appendU64(&col1, 200u64) ?
  let col3 = Column.appendU64(&col2, 300u64) ?
  let col4 = Column.appendU64(&col3, 400u64) ?

  // Add null, then scalar, then another null
  let col5 = Column.appendNullU64(&col4) ?
  let col6 = Column.appendU64(&col5, 500u64) ?
  let col7 = Column.appendNullU64(&col6) ?

  let v0 = Column.getU64(&col7, 0) ?
  let v1 = Column.getU64(&col7, 1) ?
  let v2 = Column.getU64(&col7, 2) ?
  let v3 = Column.getU64(&col7, 3) ?
  let v5 = Column.getU64(&col7, 5) ?

  let isNull4 = Column.isNull(&col7, 4)
  let isNull6 = Column.isNull(&col7, 6)
  let isNull0 = Column.isNull(&col7, 0)

  let nullVal4 = Column.getU64(&col7, 4)
  let nullVal6 = Column.getU64(&col7, 6)

  // Vectorized aggregations across mixed valid and null rows
  let totalSum = Column.sum(&col7)
  let minVal = Column.min(&col7) ?
  let maxVal = Column.max(&col7) ?

  Some(Column.length(&col7) == 7
      && Column.nullCount(&col7) == 2
      && v0 == 100u64
      && v1 == 200u64
      && v2 == 300u64
      && v3 == 400u64
      && v5 == 500u64
      && isNull4
      && isNull6
      && !isNull0
      && Option.isNone(&nullVal4)
      && Option.isNone(&nullVal6)
      && totalSum == 1500u64
      && minVal == 100u64
      && maxVal == 500u64)
}

fn testFilterAndProject() -> Option[Bool] {
  let col0 = Column.createU64(8)
  let col1 = Column.appendU64(&col0, 10u64) ?
  let col2 = Column.appendU64(&col1, 50u64) ?
  let col3 = Column.appendNullU64(&col2) ?
  let col4 = Column.appendU64(&col3, 80u64) ?
  let col5 = Column.appendU64(&col4, 25u64) ?
  let col6 = Column.appendU64(&col5, 100u64) ?

  // Filter rows where value > 30u64: should match 50u64 (row 1), 80u64 (row 3), 100u64 (row 5)
  let sel = Column.filterGt(&col6, 30u64)
  let proj = Column.project(&col6, &sel)

  let p0 = Column.getU64(&proj, 0) ?
  let p1 = Column.getU64(&proj, 1) ?
  let p2 = Column.getU64(&proj, 2) ?

  let projSum = Column.sum(&proj)
  let projMin = Column.min(&proj) ?
  let projMax = Column.max(&proj) ?

  Some(Column.length(&proj) == 3
      && Column.nullCount(&proj) == 0
      && p0 == 50u64
      && p1 == 80u64
      && p2 == 100u64
      && projSum == 230u64
      && projMin == 50u64
      && projMax == 100u64)
}

fn testEmptyAndAllNullColumns() -> Option[Bool] {
  let emptyCol = Column.createU64(0)
  let emptySum = Column.sum(&emptyCol)
  let emptyMin = Column.min(&emptyCol)
  let emptyMax = Column.max(&emptyCol)

  let nullCol0 = Column.createU64(4)
  let nullCol1 = Column.appendNullU64(&nullCol0) ?
  let nullCol2 = Column.appendNullU64(&nullCol1) ?
  let allNullSum = Column.sum(&nullCol2)
  let allNullMin = Column.min(&nullCol2)
  let allNullMax = Column.max(&nullCol2)

  Some(emptySum == 0u64
      && Option.isNone(&emptyMin)
      && Option.isNone(&emptyMax)
      && allNullSum == 0u64
      && Option.isNone(&allNullMin)
      && Option.isNone(&allNullMax))
}

export fn main() -> Int {
  var held = 0

  // 1. Empty column initialization
  let col = Column.createU64(16)
  if Column.length(&col) == 0 { held = held + 1 }
  if Column.nullCount(&col) == 0 { held = held + 1 }

  // 2. Out of bounds queries
  if Column.isNull(&col, -1) { held = held + 1 }
  if Column.isNull(&col, 0) { held = held + 1 }
  if Option.isNone(&Column.getU64(&col, -1)) { held = held + 1 }
  if Option.isNone(&Column.getU64(&col, 0)) { held = held + 1 }

  // 3. Basic column workflow (appends, nulls, reads, aggregations)
  if Option.unwrapOr(testBasicColumnWorkflow(), false) { held = held + 1 }

  // 4. Vectorized filter predicate scan and column projection
  if Option.unwrapOr(testFilterAndProject(), false) { held = held + 1 }

  // 5. Empty and all-null column edge cases
  if Option.unwrapOr(testEmptyAndAllNullColumns(), false) { held = held + 1 }

  held
}
