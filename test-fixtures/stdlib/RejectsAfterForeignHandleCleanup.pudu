module RejectsAfterForeignHandleCleanup

foreign "c" {
  type Box
  fn pudu_ffi_cpp_box_new(value: Int32) -> owned Box by pudu_ffi_cpp_box_delete
  fn pudu_ffi_cpp_box_delete(box: Box) -> ()
}

export fn main() -> Int {
  unsafe(foreign) {
    let box = pudu_ffi_cpp_box_new(29i32)
    panic("stop after allocation")
  }
}
