module UsesIo

import Std.Env as Env
import Std.Fs as Fs
import Std.Io as Io

export fn main() -> Int {
  // Where this machine puts what a program does not intend to keep, rather than
  // one machine's spelling of it. A fixture that wrote `/tmp` would not run
  // where that path does not exist.
  // A directory of this run alone, so runs at the same time never meet.
  let Ok(scratch) = Fs.temporaryDirectoryIn(Env.temporaryDirectory(), "pudu-fixture-") else { return 0 }
  let target = Io.join(scratch, "pudu-fixture-io")
  var total = 0
  match Io.makeDirectory(target) {
    case Ok(_) => { total = total + 1 }
    case Err(_) => {}
  }
  let file = Io.join(target, "note.txt")
  match Io.write(file, "one\ntwo\n") {
    case Ok(_) => { total = total + 1 }
    case Err(_) => {}
  }
  match Io.readLines(file) {
    case Ok(lines) => { total = total + lines.length() }
    case Err(_) => {}
  }
  match Io.list(target) {
    case Ok(names) => { total = total + names.length() }
    case Err(_) => {}
  }
  if Io.exists(file) { total = total + 1 }
  match Io.extensionOf(file) {
    case Some(extension) => { total = total + extension.length() }
    case None => {}
  }
  total = total + Io.nameOf(file).length()
  if Env.isSet("PATH") { total = total + 1 }
  match Io.removeIfPresent(file) {
    case Ok(_) => { total = total + 1 }
    case Err(_) => {}
  }
  let _scratchGone = Fs.removeTree(scratch)
  total
}
