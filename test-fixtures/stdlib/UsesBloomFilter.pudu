module UsesBloomFilter

import Std.BloomFilter as BloomFilter
import Std.Bytes as Bytes

export fn main() -> Int {
  var held = 0

  // 1. Raw constructor and empty inspection
  let bf = BloomFilter.create(256, 4)
  if BloomFilter.bitCount(&bf) == 256
    && BloomFilter.hashCount(&bf) == 4
    && BloomFilter.estimatedCount(&bf) == 0
    && !BloomFilter.contains(&bf, "hello") {
    held = held + 1
  }

  // 2. Optimal constructor calculation
  let opt = BloomFilter.optimal(100, 0.01)
  if BloomFilter.bitCount(&opt) >= 900
    && BloomFilter.hashCount(&opt) == 7
    && BloomFilter.estimatedCount(&opt) == 0 {
    held = held + 1
  }

  // 3. String insertions and 100% recall (zero false negatives)
  var filter = BloomFilter.optimal(50, 0.01)
  filter = BloomFilter.insert(&filter, "alpha")
  filter = BloomFilter.insert(&filter, "beta")
  filter = BloomFilter.insert(&filter, "gamma")
  filter = BloomFilter.insert(&filter, "delta")
  filter = BloomFilter.insert(&filter, "epsilon")
  if BloomFilter.contains(&filter, "alpha")
    && BloomFilter.contains(&filter, "beta")
    && BloomFilter.contains(&filter, "gamma")
    && BloomFilter.contains(&filter, "delta")
    && BloomFilter.contains(&filter, "epsilon") {
    held = held + 1
  }

  // 4. Definitely absent items return false
  let absent1 = BloomFilter.contains(&filter, "zeta_not_present")
  let absent2 = BloomFilter.contains(&filter, "omega_not_present")
  let absent3 = BloomFilter.contains(&filter, "theta_not_present")
  if !absent1 && !absent2 && !absent3 {
    held = held + 1
  }

  // 5. Raw bytes insertions and queries
  let b1 = Bytes.fromArray(&[1u8, 2u8, 3u8, 4u8])
  let b2 = Bytes.fromArray(&[255u8, 254u8, 253u8])
  let bAbsent = Bytes.fromArray(&[42u8, 99u8])
  var byteFilter = BloomFilter.create(512, 5)
  byteFilter = BloomFilter.insertBytes(&byteFilter, &b1)
  byteFilter = BloomFilter.insertBytes(&byteFilter, &b2)
  if BloomFilter.containsBytes(&byteFilter, &b1)
    && BloomFilter.containsBytes(&byteFilter, &b2)
    && !BloomFilter.containsBytes(&byteFilter, &bAbsent) {
    held = held + 1
  }

  // 6. Set union (merge) of two filters via bitwise OR
  var fA = BloomFilter.create(256, 3)
  fA = BloomFilter.insert(&fA, "itemA1")
  fA = BloomFilter.insert(&fA, "itemA2")

  var fB = BloomFilter.create(256, 3)
  fB = BloomFilter.insert(&fB, "itemB1")
  fB = BloomFilter.insert(&fB, "itemB2")

  let mergedOpt = BloomFilter.merge(&fA, &fB)
  match mergedOpt {
    case Some(fMerged) => {
      if BloomFilter.contains(&fMerged, "itemA1")
        && BloomFilter.contains(&fMerged, "itemA2")
        && BloomFilter.contains(&fMerged, "itemB1")
        && BloomFilter.contains(&fMerged, "itemB2")
        && !BloomFilter.contains(&fMerged, "never_added") {
        held = held + 1
      }
    }
    case None => {}
  }

  // 7. Incompatible dimension merge refusal
  let fIncompat = BloomFilter.create(512, 3)
  let badMerge = BloomFilter.merge(&fA, &fIncompat)
  if badMerge == None {
    held = held + 1
  }

  // 8. Set intersection of two filters via bitwise AND
  var fX = BloomFilter.create(256, 3)
  fX = BloomFilter.insert(&fX, "common")
  fX = BloomFilter.insert(&fX, "onlyX")

  var fY = BloomFilter.create(256, 3)
  fY = BloomFilter.insert(&fY, "common")
  fY = BloomFilter.insert(&fY, "onlyY")

  let interOpt = BloomFilter.intersect(&fX, &fY)
  match interOpt {
    case Some(fInter) => {
      if BloomFilter.contains(&fInter, "common")
        && !BloomFilter.contains(&fInter, "onlyX")
        && !BloomFilter.contains(&fInter, "onlyY") {
        held = held + 1
      }
    }
    case None => {}
  }

  // 9. Incompatible dimension intersect refusal
  let badInter = BloomFilter.intersect(&fX, &fIncompat)
  if badInter == None {
    held = held + 1
  }

  // 10. Estimated count estimation
  var denseFilter = BloomFilter.create(1024, 4)
  denseFilter = BloomFilter.insert(&denseFilter, "k1")
  denseFilter = BloomFilter.insert(&denseFilter, "k2")
  denseFilter = BloomFilter.insert(&denseFilter, "k3")
  denseFilter = BloomFilter.insert(&denseFilter, "k4")
  denseFilter = BloomFilter.insert(&denseFilter, "k5")
  denseFilter = BloomFilter.insert(&denseFilter, "k6")
  denseFilter = BloomFilter.insert(&denseFilter, "k7")
  denseFilter = BloomFilter.insert(&denseFilter, "k8")
  let est = BloomFilter.estimatedCount(&denseFilter)
  if est >= 6 && est <= 10 {
    held = held + 1
  }

  held
}
