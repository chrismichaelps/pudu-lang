module UsesArgs

import Std.Args as Args
import Std.Args {Missing, MissingValue, NotANumber, Unknown}
import Std.Option as Option

/// The options a plausible tool takes: a flag, a value, a required value, a
/// repeated one, and short forms for each.
fn tool() -> Args.Spec {
  let base = Args.spec("build", "compile a project")
  let withVerbose = Args.flag(&base, "verbose", "v", "say more about what is happening")
  let withQuiet = Args.flag(&withVerbose, "quiet", "q", "say less")
  let withOut = Args.value(&withQuiet, "out", "o", "where to write the result")
  let withJobs = Args.value(&withOut, "jobs", "j", "how many at once")
  let withInclude = Args.repeated(&withJobs, "include", "I", "a directory to search")
  Args.required(&withInclude, "target", "t", "what to build")
}

fn parsed(given: &Array[Str]) -> Result[Args.Args, Args.ArgsError] {
  Args.parse(&tool(), given)
}

/// A parse that is expected to succeed, so a check reads as what it asserts.
fn ok(given: &Array[Str]) -> Args.Args {
  match parsed(given) {
    case Ok(found) => found
    case Err(_) => Args.Args{flags: setOf([]), values: mapOf([]), lists: mapOf([]), rest: []}
  }
}

fn main() -> Int {
  var held = 0

  // 1. A long flag and a long value, written the plainest way
  let plain = ok(&["--target", "app", "--verbose", "--out", "build/app"])
  if Args.isSet(&plain, "verbose") && Args.valueOf(&plain, "out") == Some("build/app") {
    held = held + 1
  }

  // 2. A flag nobody gave is not set
  if !Args.isSet(&plain, "quiet") {
    held = held + 1
  }

  // 3. `--name=value`, which is the other way people write it
  let joined = ok(&["--target=app", "--out=build/app"])
  if Args.valueOf(&joined, "target") == Some("app")
    && Args.valueOf(&joined, "out") == Some("build/app") {
    held = held + 1
  }

  // 4. Short forms, with the value in the next argument
  let short = ok(&["-t", "app", "-o", "build/app"])
  if Args.valueOf(&short, "target") == Some("app")
    && Args.valueOf(&short, "out") == Some("build/app") {
    held = held + 1
  }

  // 5. A short option's value attached to it
  let attached = ok(&["-tapp", "-obuild/app"])
  if Args.valueOf(&attached, "target") == Some("app")
    && Args.valueOf(&attached, "out") == Some("build/app") {
    held = held + 1
  }

  // 6. Several short flags in one argument
  let clustered = ok(&["-vq", "--target", "app"])
  if Args.isSet(&clustered, "verbose") && Args.isSet(&clustered, "quiet") {
    held = held + 1
  }

  // 7. A cluster ending in a value option takes the rest as its value
  let mixed = ok(&["-vtapp"])
  if Args.isSet(&mixed, "verbose") && Args.valueOf(&mixed, "target") == Some("app") {
    held = held + 1
  }

  // 8. A repeated option keeps every value, in the order written
  let searched = ok(&["--target", "app", "-I", "one", "--include", "two", "-Ithree"])
  let directories = Args.allOf(&searched, "include")
  if directories.length() == 3 && directories[0] == "one" && directories[2] == "three" {
    held = held + 1
  }

  // 9. A value option given twice keeps the last, which is what a later
  //    argument on a command line means
  let repeated = ok(&["--target", "first", "--target", "second"])
  if Args.valueOf(&repeated, "target") == Some("second") {
    held = held + 1
  }

  // 10. What is not an option is kept in order
  let positional = ok(&["--target", "app", "one", "two"])
  let leftover = Args.rest(&positional)
  if leftover.length() == 2 && leftover[0] == "one" && leftover[1] == "two" {
    held = held + 1
  }

  // 11. After `--`, nothing is an option — which is how a value that looks
  //     like one is given at all
  let ended = ok(&["--target", "app", "--", "--verbose", "-x"])
  let after = Args.rest(&ended)
  if !Args.isSet(&ended, "verbose") && after.length() == 2 && after[0] == "--verbose" {
    held = held + 1
  }

  // 12. A lone dash is a value, because it means standard input to nearly
  //     every program that takes a file
  let dash = ok(&["--target", "app", "-"])
  if Args.rest(&dash) == ["-"] {
    held = held + 1
  }

  // 13. An option the program does not take is refused, naming what was written
  match parsed(&["--target", "app", "--nonsense"]) {
    case Err(Unknown(written)) => {
      if written == "--nonsense" {
        held = held + 1
      }
    }
    case _ => {}
  }

  // 14. So is a short one
  match parsed(&["--target", "app", "-z"]) {
    case Err(Unknown(written)) => {
      if written == "-z" {
        held = held + 1
      }
    }
    case _ => {}
  }

  // 15. A value option at the very end with nothing after it is refused
  //     rather than read as absent
  match parsed(&["--target", "app", "--out"]) {
    case Err(MissingValue(name)) => {
      if name == "out" {
        held = held + 1
      }
    }
    case _ => {}
  }

  // 16. A required option nobody gave is refused
  match parsed(&["--verbose"]) {
    case Err(Missing(name)) => {
      if name == "target" {
        held = held + 1
      }
    }
    case _ => {}
  }

  // 17. A value read as a number
  let counted = ok(&["--target", "app", "--jobs", "8"])
  if Args.numberOf(&counted, "jobs") == Some(8) {
    held = held + 1
  }

  // 18. And text that is not one is refused where a caller asks it to be
  let wrong = ok(&["--target", "app", "--jobs", "many"])
  match Args.numberChecked(&wrong, "jobs") {
    case Err(NotANumber(name, given)) => {
      if name == "jobs" && given == "many" {
        held = held + 1
      }
    }
    case _ => {}
  }

  // 19. A fallback is used where an option was not given
  if Args.valueOr(&plain, "jobs", "1") == "1" && Args.valueOr(&counted, "jobs", "1") == "8" {
    held = held + 1
  }

  // 20. The usage text is built from the same spec the parsing reads, so a
  //     program cannot document an option it does not accept
  let written = Args.usage(&tool())
  if written.contains("--include") && written.contains("a directory to search")
    && written.contains("-v, --verbose") {
    held = held + 1
  }

  held
}
