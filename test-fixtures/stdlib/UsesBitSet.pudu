module UsesBitSet

import Std.BitSet as BitSet

export fn main() -> Int {
  var held = 0

  // 1. Empty BitSet invariants
  let empty = BitSet.empty()
  if BitSet.isEmpty(&empty) { held = held + 1 }
  if BitSet.size(&empty) == 0u128 { held = held + 1 }
  if BitSet.toArray(&empty) == [] { held = held + 1 }
  if !BitSet.contains(&empty, 0u64) { held = held + 1 }
  if !BitSet.contains(&empty, 100u64) { held = held + 1 }

  // 2. Singleton BitSet
  let single = BitSet.singleton(42u64)
  if !BitSet.isEmpty(&single) { held = held + 1 }
  if BitSet.size(&single) == 1u128 { held = held + 1 }
  if BitSet.contains(&single, 42u64) { held = held + 1 }
  if !BitSet.contains(&single, 41u64) { held = held + 1 }
  if BitSet.toArray(&single) == [42u64] { held = held + 1 }

  // 3. Multi-block insertion and removal (across boundary words)
  let items: Array[UInt64] = [0u64, 1u64, 63u64, 64u64, 127u64, 1000u64, 5000u64]
  let multi = BitSet.fromArray(&items)
  if BitSet.size(&multi) == 7u128 { held = held + 1 }
  if BitSet.contains(&multi, 0u64) { held = held + 1 }
  if BitSet.contains(&multi, 63u64) { held = held + 1 }
  if BitSet.contains(&multi, 64u64) { held = held + 1 }
  if BitSet.contains(&multi, 127u64) { held = held + 1 }
  if BitSet.contains(&multi, 1000u64) { held = held + 1 }
  if BitSet.contains(&multi, 5000u64) { held = held + 1 }
  if !BitSet.contains(&multi, 2u64) { held = held + 1 }
  if !BitSet.contains(&multi, 65u64) { held = held + 1 }
  if BitSet.toArray(&multi) == items { held = held + 1 }

  // Removal
  let removed = BitSet.remove(&multi, 64u64)
  if BitSet.size(&removed) == 6u128 { held = held + 1 }
  if !BitSet.contains(&removed, 64u64) { held = held + 1 }
  if BitSet.toArray(&removed) == [0u64, 1u64, 63u64, 127u64, 1000u64, 5000u64] { held = held + 1 }

  // 4. fromBlocks validation
  let validMap = mapOf([(0u64, 1u64), (1u64, 0u64)])
  match BitSet.fromBlocks(&validMap) {
    case Ok(bs) => {
      if BitSet.size(&bs) == 1u128 { held = held + 1 }
    }
    case Err(_) => {}
  }
  let invalidMap = mapOf([(0x0400000000000000u64, 1u64)])
  match BitSet.fromBlocks(&invalidMap) {
    case Ok(_) => {}
    case Err(badBlock) => {
      if badBlock == 0x0400000000000000u64 { held = held + 1 }
    }
  }

  // 5. Set algebra
  let left = BitSet.fromArray(&[1u64, 2u64, 64u64])
  let right = BitSet.fromArray(&[2u64, 64u64, 128u64])

  let u = BitSet.union(&left, &right)
  if BitSet.size(&u) == 4u128 { held = held + 1 }
  if BitSet.toArray(&u) == [1u64, 2u64, 64u64, 128u64] { held = held + 1 }

  let inter = BitSet.intersection(&left, &right)
  if BitSet.size(&inter) == 2u128 { held = held + 1 }
  if BitSet.toArray(&inter) == [2u64, 64u64] { held = held + 1 }

  let diff = BitSet.difference(&left, &right)
  if BitSet.size(&diff) == 1u128 { held = held + 1 }
  if BitSet.toArray(&diff) == [1u64] { held = held + 1 }

  let symDiff = BitSet.symmetricDifference(&left, &right)
  if BitSet.size(&symDiff) == 2u128 { held = held + 1 }
  if BitSet.toArray(&symDiff) == [1u64, 128u64] { held = held + 1 }

  // 6. Predicates
  if BitSet.isSubsetOf(&inter, &left) { held = held + 1 }
  if !BitSet.isSubsetOf(&left, &inter) { held = held + 1 }
  if BitSet.isSubsetOf(&empty, &left) { held = held + 1 }

  let disjointA = BitSet.fromArray(&[1u64])
  let disjointB = BitSet.fromArray(&[128u64])
  if BitSet.isDisjointFrom(&disjointA, &disjointB) { held = held + 1 }
  if !BitSet.isDisjointFrom(&left, &right) { held = held + 1 }
  if BitSet.isDisjointFrom(&empty, &left) { held = held + 1 }

  held
}
