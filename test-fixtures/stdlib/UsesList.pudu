module UsesList

import Std.List as List

export fn main() -> Int {
  let items = [5, 3, 9, 1, 7, 3]
  let ordered = List.sorted(&items)
  let evens = List.filter(&items, fn(n: Int) -> Bool => n % 2 == 0)
  let doubled = List.map(&items, fn(n: Int) -> Int => n * 2)
  let joined = List.concat(&ordered, &doubled)
  ordered[0] + List.sum(&items) + List.length(&evens) + List.length(&joined)
}
