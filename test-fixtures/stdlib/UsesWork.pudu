module UsesWork

import Std.App.Work {After, EveryFromEnd, EveryFromStart}
import Std.App.Work as Work
import Std.Option as Option
import Std.Result as Result
import Std.Sync as Sync

/// What a schedule promises.
///
/// Every check here is a comparison of values at a stated moment. Nothing
/// waits: an hourly job is checked in a millisecond, which is only possible
/// because the clock is given rather than read.
export fn main() -> Int {
  var held = 0

  let counter = Sync.cell(0)

  // A schedule is jobs, and can be read before it runs.
  let plan: Work.Schedule = Work.schedule(&[
      Work.job("sweep", EveryFromEnd(100), counting(counter)),
      Work.job("report", EveryFromStart(1000), counting(counter)),
      Work.job("warm", After(50), counting(counter))
    ])
  if Work.names(&plan) == ["sweep", "report", "warm"] { held = held + 1 }
  if Work.jobsOf(&plan).length() == 3 { held = held + 1 }
  if Work.names(&Work.nothing()) == [] { held = held + 1 }
  if Work.names(&Work.nothing().also(Work.job("x", After(1), counting(counter)))) == ["x"] {
    held = held + 1
  }
  // Added one at a time rather than given at once, through a bound naming the
  // scheduling trait alone, which is what checks it is usable as one. Added
  // rather than set: a service whose modules each schedule their own work must
  // not have the last one replace the rest.
  let assembled: Work.Schedule = everything(&Work.nothing(), counter)
  if Work.names(&assembled) == ["nightly", "hourly"] { held = held + 1 }

  // Which jobs are due is a pure function of the schedule and the moment.
  if Work.dueAt(&plan, 0) == [] { held = held + 1 }
  if Work.dueAt(&plan, 60) == ["warm"] { held = held + 1 }
  if Work.dueAt(&plan, 120) == ["sweep", "warm"] { held = held + 1 }
  if Work.dueAt(&plan, 1200) == ["sweep", "report", "warm"] { held = held + 1 }

  // Running what is due records what happened, and the schedule that follows
  // is a new value — the one before is still there to compare against.
  let after = Work.runDue(&plan, 120, at(200))
  if Option.unwrapOr(Work.recordOf(&after, "sweep"), Work.nothingYet()).runs == 1 {
    held = held + 1
  }
  if Option.unwrapOr(Work.recordOf(&after, "warm"), Work.nothingYet()).runs == 1 {
    held = held + 1
  }
  if Option.unwrapOr(Work.recordOf(&after, "report"), Work.nothingYet()).runs == 0 {
    held = held + 1
  }
  if Option.unwrapOr(Work.recordOf(&plan, "sweep"), Work.nothingYet()).runs == 0 {
    held = held + 1
  }

  // And how long it took, from the clock the caller gave.
  if Option.unwrapOr(Work.recordOf(&after, "sweep"), Work.nothingYet()).lastTook == 80 {
    held = held + 1
  }

  // A job that runs once does not run again.
  if !Work.dueAt(&after, 5000).contains("warm") { held = held + 1 }

  // Where the interval is measured from is stated per job, because the two are
  // different. Measured from the end, a job that overran runs less often.
  let overran = Work.runDue(
      &Work.schedule(&[Work.job("slow", EveryFromEnd(100), counting(counter))]),
    100,
    at(500)
  )
  if !Work.dueAt(&overran, 550).contains("slow") { held = held + 1 }
  if Work.dueAt(&overran, 600).contains("slow") { held = held + 1 }

  // Measured from the start, it keeps its cadence.
  let paced = Work.runDue(
      &Work.schedule(&[Work.job("paced", EveryFromStart(100), counting(counter))]),
    100,
    at(500)
  )
  if Work.dueAt(&paced, 200).contains("paced") { held = held + 1 }

  // A job still running when its next turn arrives does not start a second:
  // two runs of a job that writes is a race nobody designed, and it shows up
  // as duplicated work rather than as an error.
  let busy = Work.schedule(&[Work.job("busy", EveryFromEnd(10), counting(counter))])
    .started("busy")
  let skippedOnce = Work.runDue(&busy, 100, at(100))
  if Option.unwrapOr(Work.recordOf(&skippedOnce, "busy"), Work.nothingYet()).runs == 0 {
    held = held + 1
  }

  // And the skip is counted, so a job that never finishes in time is visible
  // rather than merely slow.
  if Option.unwrapOr(Work.recordOf(&skippedOnce, "busy"), Work.nothingYet()).skips == 1 {
    held = held + 1
  }

  // Once it has finished, it runs again.
  let freed = Work.runDue(&skippedOnce.ended("busy"), 200, at(210))
  if Option.unwrapOr(Work.recordOf(&freed, "busy"), Work.nothingYet()).runs == 1 {
    held = held + 1
  }

  // A job that fails is recorded and stays scheduled. One bad night is not a
  // reason for a nightly job to be silently dead until somebody notices its
  // output stopped.
  let failing = Work.schedule(&[Work.job("fragile", EveryFromEnd(100), refusing)])
  let once = Work.runDue(&failing, 100, at(110))
  let record = Option.unwrapOr(Work.recordOf(&once, "fragile"), Work.nothingYet())
  if record.runs == 1 { held = held + 1 }
  if Work.failuresOf(&record) == 1 { held = held + 1 }
  if Work.everFailed(&record) { held = held + 1 }
  if Option.unwrapOr(Work.lastFailureOf(&record), "") == "the database was restarting" {
    held = held + 1
  }

  // Still scheduled, and it runs again at its next turn rather than being
  // retried immediately — which would turn one failing dependency into a tight
  // loop against it.
  if !Work.dueAt(&once, 150).contains("fragile") { held = held + 1 }
  if Work.dueAt(&once, 250).contains("fragile") { held = held + 1 }
  let twice = Work.runDue(&once, 250, at(260))
  if Option.unwrapOr(Work.recordOf(&twice, "fragile"), Work.nothingYet()).runs == 2 {
    held = held + 1
  }
  if Option.unwrapOr(Work.recordOf(&twice, "fragile"), Work.nothingYet()).failures == 2 {
    held = held + 1
  }

  // A job that has not failed says so rather than saying it failed with
  // nothing.
  if Option.isNone(&Work.lastFailureOf(&Work.nothingYet())) { held = held + 1 }
  if !Work.everFailed(&Work.nothingYet()) { held = held + 1 }

  // The work really ran, which is what the counter is for.
  if Sync.get(&counter) != Ok(0) { held = held + 1 }

  // A schedule reports what it has been doing, one line per job.
  let written = Work.render(&twice)
  if written.contains("fragile: ran 2, failed 2") { held = held + 1 }
  if written.contains("the database was restarting") { held = held + 1 }
  if Work.render(&Work.nothing()).isEmpty() { held = held + 1 }
  if Work.render(&plan).split("\n").length() == 3 { held = held + 1 }

  // Marking a name no job carries marks nothing rather than refusing. The
  // schedule is what says which jobs exist, and a caller driving jobs on its
  // own workers asks `names` rather than being told one at a time.
  if Work.names(&plan.started("absent")) == Work.names(&plan) { held = held + 1 }
  if Work.dueAt(&plan.ended("absent"), 1200) == Work.dueAt(&plan, 1200) { held = held + 1 }

  // One job asked on its own, rather than through the schedule holding it. A
  // scheduler deciding which jobs to hand to a worker asks this of each.
  let one: Work.Job = Work.jobsOf(&plan)[2]
  if one.name == "warm" && !Work.isDue(&one, 49) && Work.isDue(&one, 50) { held = held + 1 }
  // A job that runs once is due at its delay and not again after it has run,
  // which is the difference between a delay and an interval.
  let due: Work.Due = one.due
  match due { case After(delay) => { if delay == 50 { held = held + 1 } } case _ => {} }
  if !Work.isDue(&Work.jobsOf(&after)[2], 5000) { held = held + 1 }

  // What one job has done, read through the record rather than its fields, so a
  // caller reporting a schedule need not know how a record is shaped.
  let sweeping: Work.Record = Option.unwrapOr(Work.recordOf(&after, "sweep"), Work.nothingYet())
  if Work.runsOf(&sweeping) == 1 && Work.lastTookOf(&sweeping) == 80 { held = held + 1 }
  if Work.skipsOf(&sweeping) == 0 { held = held + 1 }
  if Work.skipsOf(&Option.unwrapOr(Work.recordOf(&skippedOnce, "busy"), Work.nothingYet())) == 1 {
    held = held + 1
  }
  // Nothing recorded yet is nothing on every count, not merely on the one a
  // caller happened to ask about.
  if Work.runsOf(&Work.nothingYet()) == 0 && Work.skipsOf(&Work.nothingYet()) == 0
    && Work.lastTookOf(&Work.nothingYet()) == 0 {
    held = held + 1
  }

  held
}

/// Two jobs added one at a time through a bound naming the scheduling trait and
/// nothing else, the way a service whose modules each schedule their own work
/// puts a schedule together.
fn everything[S: Work.Scheduling](base: &S, into: Sync.Cell[Int]) -> S {
  base.also(Work.job("nightly", EveryFromStart(86400), counting(into)))
    .also(Work.job("hourly", EveryFromEnd(3600), counting(into)))
}

/// A job that records that it ran.
fn counting(into: Sync.Cell[Int]) -> fn() -> Result[(), Str] {
  fn() -> Result[(), Str] {
    let _kept = Sync.set(&into, Result.unwrapOr(Sync.get(&into), 0) + 1)
    Ok(())
  }
}

/// A job that fails the way a real one does: for a reason, and not forever.
fn refusing() -> Result[(), Str] { Err("the database was restarting") }

/// A clock that says the work ended at a stated moment, so a duration is a
/// comparison rather than a wait.
fn at(moment: Int) -> fn() -> Int { fn() -> Int { moment } }
