module UsesHtmlServer

import Std.Bytes as ByteSeq
import Std.Html.Buffer as HtmlBuffer
import Std.Html.Compose as Compose
import Std.Html as Html
import Std.Html.Ssr as Ssr
import Std.Map as Map
import Std.Result as Result

/// What rendering a page on the server promises.
///
/// A plan is prepared once and filled many times, which is the whole reason
/// the module exists: the fixed parts of a page are rendered when it is
/// prepared, and a request pays only for the holes. So what is checked here is
/// that the two halves agree — that a plan filled with values says exactly
/// what the same markup written out in one piece would say.
///
/// Checked hardest at the edges a page meets under load: a hole nobody filled,
/// a page longer than the caller will accept, and text that must not be
/// allowed to become markup. The last is the one that matters most, because
/// getting it wrong is not a rendering fault but a way into the page.
fn plan() -> Ssr.Plan {
  Ssr.prepare(
      &[
      Ssr.Fixed(Html.element("h1", &[], &[Html.text("Orders")])),
      Ssr.Slot("body"),
      Ssr.Fixed(Html.element("footer", &[], &[Html.text("end")]))
    ]
  )
}

fn filled(name: Str, view: Html.Html) -> Map[Str, Html.Html] {
  Map.insert(&mapOf([]), name, view)
}

fn chunksFit(chunks: &Array[Bytes], maximum: Int) -> Bool {
  for chunk in chunks {
    if chunk.length() > maximum { return false }
  }
  true
}

export fn main() -> Int {
  var held = 0
  let prepared = plan()

  // A filled plan says what the same page written in one piece says.
  let body = Html.element("p", &[], &[Html.text("two orders")])
  let rendered = Result.unwrapOr(Ssr.render(&prepared, &filled("body", body)), "")
  if rendered == "<h1>Orders</h1><p>two orders</p><footer>end</footer>" { held = held + 1 }

  // The fixed parts survive a hole filled with nothing at all.
  let bare = Result.unwrapOr(Ssr.render(&prepared, &filled("body", Html.text(""))), "")
  if bare == "<h1>Orders</h1><footer>end</footer>" { held = held + 1 }

  // A hole nobody filled is refused rather than rendered as a gap. A page
  // missing a section is a page that lies about what it shows.
  if Result.isErr(&Ssr.render(&prepared, &mapOf([]))) { held = held + 1 }

  // A value offered for a hole that does not exist changes nothing.
  let spare = Map.insert(&filled("body", body), "nowhere", Html.text("x"))
  if Result.unwrapOr(Ssr.render(&prepared, &spare), "") == rendered { held = held + 1 }

  // Text is text wherever it is put. A value carrying markup must arrive as
  // the characters it is made of, because a page that renders what a visitor
  // typed is a page that runs what a visitor typed.
  let hostile = Html.text("<script>alert(1)</script>")
  let escaped = Result.unwrapOr(Ssr.render(&prepared, &filled("body", hostile)), "")
  if escaped.contains("&lt;script&gt;") { held = held + 1 }
  if !escaped.contains("<script>") { held = held + 1 }

  // The pieces are the page, in order, so a caller may write them out as they
  // are produced rather than holding the whole page in memory.
  let pieces = Result.unwrapOr(Ssr.chunks(&prepared, &filled("body", body)), [])
  if pieces.length() > 0 { held = held + 1 }
  if pieces.join("") == rendered { held = held + 1 }

  // A finished page states its own length, and states it in bytes rather than
  // characters, because that is what a response header has to say.
  let finished = Ssr.finish(&prepared, &filled("body", body))
  if Result.isOk(&finished) { held = held + 1 }
  if let Ok(whole) = finished {
    if whole.body == rendered { held = held + 1 }
    if whole.byteLength == rendered.toBytes().length() { held = held + 1 }
  }

  // A page over the caller's limit is refused rather than cut. Half a page is
  // not a smaller page, it is a broken one.
  if Result.isErr(&Ssr.renderWithin(&prepared, &filled("body", body), 4)) { held = held + 1 }
  if Result.isOk(&Ssr.renderWithin(&prepared, &filled("body", body), 4096)) { held = held + 1 }

  // A limit that cannot be met by any page is refused as a mistake in the
  // asking rather than answered with an empty page.
  if Result.isErr(&Ssr.renderWithin(&prepared, &filled("body", body), 0 - 1)) { held = held + 1 }

  // A document is a whole page: a root, a head carrying the title, and the
  // body it was given.
  let page = Html.render(
      &Compose.document("Orders", Compose.content().paragraph("one line"))
  )
  if page.contains("<title>Orders</title>") { held = held + 1 }
  if page.contains("one line") { held = held + 1 }
  if page.startsWith("<!DOCTYPE html>") || page.startsWith("<html") { held = held + 1 }

  // A document says what language it is in when it is told, because a reader
  // whose browser reads pages aloud depends on it.
  let spoken = Html.render(
      &Compose.documentIn("fr", "Commandes", Compose.content().paragraph("une ligne"))
  )
  if spoken.contains("fr") { held = held + 1 }

  let shell = Compose.documentShell("Orders", "body")
  let shellPlan = Ssr.prepareShell(&shell)
  let shellBody = Compose.content().paragraph("two < orders").fragment()
  let ordinaryPage = Html.render(&Compose.document("Orders", Compose.content().paragraph("two < orders")))
  if Ssr.render(&shellPlan, &filled("body", shellBody)) == Ok(ordinaryPage) {
    held = held + 1
  }

  let frenchShell = Compose.documentShellIn("fr", "Commandes", "body")
  let frenchPlan = Ssr.prepareShell(&frenchShell)
  let frenchBody = Compose.content().paragraph("une ligne").fragment()
  if Ssr.render(&frenchPlan, &filled("body", frenchBody)) == Ok(spoken) { held = held + 1 }

  let attributed = Ssr.ShellElement("div", [
      ("z", "<"),
      ("onclick", "run()"),
      ("a", "&")
    ], [Ssr.ShellSlot("body")])
  let attributedPlan = Ssr.prepareShell(&attributed)
  if Ssr.render(&attributedPlan, &filled("body", Html.text("<x>")))
    == Ok("<div z=\"&lt;\" a=\"&amp;\">&lt;x&gt;</div>") {
    held = held + 1
  }
  if Ssr.render(&attributedPlan, &filled("body", Html.trusted("<em>x</em>")))
    == Ok("<div z=\"&lt;\" a=\"&amp;\"><em>x</em></div>") {
    held = held + 1
  }

  let repeatedShell = Ssr.ShellFragment([
      Ssr.ShellElement("section", [], [Ssr.ShellSlot("item")]),
      Ssr.ShellElement("section", [], [Ssr.ShellSlot("item")])
    ])
  let repeatedPlan = Ssr.prepareShell(&repeatedShell)
  if Ssr.render(&repeatedPlan, &filled("item", Html.text("x")))
    == Ok("<section>x</section><section>x</section>") {
    held = held + 1
  }

  let missingShell = Ssr.ShellFragment([Ssr.ShellSlot("first"), Ssr.ShellSlot("second")])
  let missingPlan = Ssr.prepareShell(&missingShell)
  if let Err(Ssr.MissingSlot("first")) = Ssr.render(&missingPlan, &mapOf([])) {
    held = held + 1
  }

  let voidShell = Ssr.ShellElement("img", [
      ("alt", "x"),
      ("onclick", "run()")
    ], [Ssr.ShellSlot("ignored")])
  let voidPlan = Ssr.prepareShell(&voidShell)
  if Ssr.render(&voidPlan, &mapOf([])) == Ok("<img alt=\"x\" />") { held = held + 1 }

  var deepShell = Ssr.ShellSlot("leaf")
  var depth = 0
  while depth < 1600 {
    deepShell = Ssr.ShellElement("div", [], [deepShell])
    depth = depth + 1
  }
  let deepPlan = Ssr.prepareShell(&deepShell)
  match Ssr.render(&deepPlan, &filled("leaf", Html.text("end"))) {
    case Ok(output) => { if output.length() == 17603 { held = held + 1 } }
    case Err(_) => {}
  }

  let mixedShell = Ssr.ShellElement("main", [], [
      Ssr.ShellFixed(Html.element("h1", &[], &[Html.text("Title")])),
      Ssr.ShellFragment([Ssr.ShellFixed(Html.text(" ")), Ssr.ShellSlot("body")])
    ])
  let mixedPlan = Ssr.prepareShell(&mixedShell)
  if Ssr.render(&mixedPlan, &filled("body", Html.text("done")))
    == Ok("<main><h1>Title</h1> done</main>") {
    held = held + 1
  }

  let exactBytes = rendered.toBytes().length()
  match Ssr.renderWithin(&prepared, &filled("body", body), exactBytes) {
    case Ok(output) => {
      if output.body == rendered && output.byteLength == exactBytes { held = held + 1 }
    }
    case Err(_) => {}
  }
  if let Err(Ssr.TooLarge(limit))
    = Ssr.renderWithin(&prepared, &filled("body", body), exactBytes - 1) {
    if limit == exactBytes - 1 { held = held + 1 }
  }

  let emptyPlan = Ssr.prepare(&[Ssr.Slot("body")])
  match Ssr.renderWithin(&emptyPlan, &filled("body", Html.text("")), 0) {
    case Ok(output) => {
      if output.body.isEmpty() && output.byteLength == 0 { held = held + 1 }
    }
    case Err(_) => {}
  }
  if let Err(Ssr.InvalidLimit(-1))
    = Ssr.renderWithin(&emptyPlan, &filled("body", Html.text("")), 0 - 1) {
    held = held + 1
  }

  match Ssr.renderWithin(&emptyPlan, &filled("body", Html.text("é")), 2) {
    case Ok(output) => { if output.body == "é" && output.byteLength == 2 { held = held + 1 } }
    case Err(_) => {}
  }
  if let Err(Ssr.TooLarge(1))
    = Ssr.renderWithin(&emptyPlan, &filled("body", Html.text("é")), 1) {
    held = held + 1
  }
  match Ssr.renderWithin(&emptyPlan, &filled("body", Html.text("<")), 4) {
    case Ok(output) => {
      if output.body == "&lt;" && output.byteLength == 4 { held = held + 1 }
    }
    case Err(_) => {}
  }
  if let Err(Ssr.TooLarge(3))
    = Ssr.renderWithin(&emptyPlan, &filled("body", Html.text("<")), 3) {
    held = held + 1
  }

  if HtmlBuffer.coalesceBounded(&[], 4) == Ok([]) { held = held + 1 }
  if let Err(error) = HtmlBuffer.coalesceBounded(&[], 0) {
    if error.maximum == 0 { held = held + 1 }
  }
  if let Err(error) = HtmlBuffer.coalesceBounded(&[], 0 - 2) {
    if error.maximum == 0 - 2 { held = held + 1 }
  }

  let exactChunks = Result.unwrapOr(
    HtmlBuffer.coalesceBounded(&[
        ByteSeq.empty(), ByteSeq.fromText("abcd"), ByteSeq.empty()
      ], 4),
    []
  )
  if exactChunks.length() == 1
    && exactChunks[0].length() == 4
    && ByteSeq.toText(&exactChunks[0]) == Ok("abcd") {
    held = held + 1
  }

  let oversized = Result.unwrapOr(
    HtmlBuffer.coalesceBounded(&[ByteSeq.fromText("abcdefghij")], 4),
    []
  )
  if oversized.length() == 3
    && chunksFit(&oversized, 4)
    && ByteSeq.toText(&ByteSeq.join(&oversized)) == Ok("abcdefghij") {
    held = held + 1
  }

  let mixed = Result.unwrapOr(
    HtmlBuffer.coalesceBounded(&[
        ByteSeq.fromText("ab"),
        ByteSeq.fromText("cdefgh"),
        ByteSeq.empty(),
        ByteSeq.fromText("ijklmno")
      ], 5),
    []
  )
  if chunksFit(&mixed, 5)
    && ByteSeq.toText(&ByteSeq.join(&mixed)) == Ok("abcdefghijklmno") {
    held = held + 1
  }

  let legacyOversized = HtmlBuffer.coalesceToMss(&[ByteSeq.fromText("abcdef")], 4)
  if legacyOversized.length() == 1 && legacyOversized[0].length() == 6 {
    held = held + 1
  }

  let repeatedBudget = Ssr.prepare(&[Ssr.Slot("body"), Ssr.Slot("body")])
  match Ssr.renderWithin(&repeatedBudget, &filled("body", Html.text("é")), 4) {
    case Ok(output) => { if output.body == "éé" && output.byteLength == 4 { held = held + 1 } }
    case Err(_) => {}
  }
  if let Err(Ssr.TooLarge(3))
    = Ssr.renderWithin(&repeatedBudget, &filled("body", Html.text("é")), 3) {
    held = held + 1
  }

  let missingFirst = Ssr.prepare(&[Ssr.Slot("missing"), Ssr.Fixed(Html.text("x"))])
  if let Err(Ssr.MissingSlot("missing")) = Ssr.renderWithin(&missingFirst, &mapOf([]), 0) {
    held = held + 1
  }
  let overflowFirst = Ssr.prepare(&[Ssr.Fixed(Html.text("x")), Ssr.Slot("missing")])
  if let Err(Ssr.TooLarge(0)) = Ssr.renderWithin(&overflowFirst, &mapOf([]), 0) {
    held = held + 1
  }

  let huge = Html.fragment(&[
      Html.text("<".repeat(100000)),
      Html.element("p", &[], &[Html.text("unreached")])
    ])
  if let Err(Ssr.TooLarge(3)) = Ssr.renderWithin(&emptyPlan, &filled("body", huge), 3) {
    held = held + 1
  }

  let boundedElement = Html.element("div", &[
      ("b", "<&\"'"),
      ("onclick", "run()"),
      ("a", "é")
    ], &[Html.trusted("雪")])
  let boundedExpected = Html.render(&boundedElement)
  let boundedBytes = boundedExpected.toBytes().length()
  match Ssr.renderWithin(&emptyPlan, &filled("body", boundedElement), boundedBytes) {
    case Ok(output) => {
      if output.body == boundedExpected && output.byteLength == boundedBytes { held = held + 1 }
    }
    case Err(_) => {}
  }

  held
}
