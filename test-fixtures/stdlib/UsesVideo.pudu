module UsesVideo

import Std.Audio as Audio
import Std.Ui.Canvas as Canvas
import Std.Video as Video

fn at(ticks: Int, scale: Int) -> Video.Timestamp { Video.Timestamp{ticks: ticks, scale: scale} }

fn picture(ticks: Int, length: Int, scale: Int, surface: &Canvas.Surface) -> Video.Picture {
  Video.Picture{presentation: at(ticks, scale), duration: at(length, scale), surface: *surface}
}

/// Exact rational timing, ordered tracks, and audio alignment.
export fn main() -> Int {
  var held = 0

  if let Err(Video.InvalidRate(0, 1)) = Video.rate(0, 1) { held = held + 1 }
  if let Err(Video.InvalidTimestamp(-1, 30)) = Video.timestamp(-1, 30) { held = held + 1 }
  if let Err(Video.InvalidTimestamp(1, 0)) = Video.timestamp(1, 0) { held = held + 1 }

  if Video.rate(60, 2) == Ok(Video.Rate{frames: 30, seconds: 1}) { held = held + 1 }

  let unreduced = Video.Rate{frames: 0, seconds: 1}
  if Video.frameAt(&unreduced, &at(1, 1)) == Err(Video.InvalidRate(0, 1)) &&
  Video.timeOfFrame(&Video.Rate{frames: 0, seconds: 0}, 0) == Err(Video.InvalidRate(0, 0))
  {
    held = held + 1
  }

  if let Ok(ntsc) = Video.rate(30000, 1001) {
    if Video.timeOfFrame(&ntsc, 30) == Ok(at(1001, 1000)) &&
    Video.timeOfFrame(&ntsc, 0) == Ok(at(0, 1))
    {
      held = held + 1
    }
    if Video.frameAt(&ntsc, &at(1, 1)) == Ok(29) &&
    Video.frameAt(&ntsc, &at(1001, 1000)) == Ok(30) &&
    Video.frameAt(&ntsc, &at(3600, 1)) == Ok(107892)
    {
      held = held + 1
    }
    if let Ok(hour) = Video.timeOfFrame(&ntsc, 107892) {
      if hour == at(8999991, 2500) && Video.frameAt(&ntsc, &hour) == Ok(107892) { held = held + 1 }
    }
    if let Err(Video.NegativeFrame(-1)) = Video.timeOfFrame(&ntsc, -1) { held = held + 1 }
  }

  if Video.add(&at(1, 3), &at(1, 6)) == Ok(at(1, 2)) && Video.add(&at(0, 7), &at(0, 9)) == Ok(at(0, 1)) {
    held = held + 1
  }
  if Video.compare(&at(1, 3), &at(2, 6)) == 0 && Video.compare(&at(1, 3), &at(1, 2)) == -1 &&
  Video.compare(&at(3, 4), &at(2, 3)) == 1
  {
    held = held + 1
  }

  if let Ok(stereo) = Audio.format(48000, 2) {
    if Video.audioFrameAt(&at(1001, 1000), &stereo) == Ok(48048) &&
    Video.audioFrameAt(&at(1, 30), &stereo) == Ok(1600)
    {
      held = held + 1
    }
  }

  if let Ok(small) = Canvas.canvas(2, 2, Canvas.rgb(0u8, 0u8, 0u8)) {
    if let Ok(larger) = Canvas.canvas(3, 2, Canvas.rgb(0u8, 0u8, 0u8)) {
      if let Ok(frame) = Canvas.render(&small) {
        if let Ok(wide) = Canvas.render(&larger) {
          if let Ok(thirty) = Video.rate(30, 1) {
            let empty = Video.track(thirty)
            if Video.pictureAt(&empty, &at(0, 1)) == None { held = held + 1 }

            if let Ok(one) = Video.appended(&empty, picture(0, 1, 30, &frame)) {
              if let Ok(two) = Video.appended(&one, picture(1, 1, 30, &frame)) {
                if let Ok(three) = Video.appended(&two, picture(3, 2, 30, &frame)) {
                  if Video.pictureAt(&three, &at(1, 20)) == Some(1) &&
                  Video.pictureAt(&three, &at(1, 30)) == Some(1) &&
                  Video.pictureAt(&three, &at(0, 1)) == Some(0)
                  {
                    held = held + 1
                  }
                  if Video.pictureAt(&three, &at(2, 30)) == None &&
                  Video.pictureAt(&three, &at(4, 30)) == Some(2) &&
                  Video.pictureAt(&three, &at(5, 30)) == None
                  {
                    held = held + 1
                  }
                  if let Err(Video.Overlapping(3)) =
                  Video.appended(&three, picture(9, 60, 1800, &frame))
                  {
                    held = held + 1
                  }
                  if let Ok(later) = Video.appended(&three, picture(5, 1, 30, &frame)) {
                    if Video.pictureAt(&later, &at(5, 30)) == Some(3) { held = held + 1 }
                  }
                }
              }
              if let Err(Video.EmptyDuration(1)) = Video.appended(&one, picture(1, 0, 30, &frame)) {
                held = held + 1
              }
              if let Err(Video.SizeMismatch(1)) = Video.appended(&one, picture(1, 1, 30, &wide)) {
                held = held + 1
              }
            }
            if let Err(Video.InvalidTimestamp(0, 0)) =
            Video.appended(&empty, Video.Picture{presentation: at(0, 0), duration: at(1, 30), surface: frame})
            {
              held = held + 1
            }
          }
        }
      }
    }
  }

  held
}
