module UsesMobileCapabilities

import Std.ByteOrder {readU32LE}
import Std.Mobile.Access as Access
import Std.Mobile.Feedback as Feedback
import Std.Mobile.Gesture as Gesture
import Std.Mobile.Scene as Scene
import Std.Mobile.View as View

// The words at `offset` onward, read as little-endian 32-bit values.
fn wordsAt(bytes: &Array[UInt8], offset: Int, count: Int) -> Array[UInt32] {
  var found = []
  for index in 0..count {
    match readU32LE(bytes, offset + index * 4) {
      case Some(word) => { found = found.push(word) }
      case None => { return [] }
    }
  }
  found
}

fn built(view: &View.View) -> Array[UInt8] {
  let (_, stream) = View.mount(view)
  stream.toArray()
}

fn changed(shown: &View.View, next: &View.View) -> Array[UInt8] {
  let (mounted, _) = View.mount(shown)
  let (_, stream) = View.update(&mounted, next)
  stream.toArray()
}

fn access(value: Str) -> Access.Access { Access.Access{traits: [Access.Header, Access.Button], hint: "h", value: value} }

fn menu() -> Array[Feedback.Choice] {
  [Feedback.Choice{label: "Copy", role: Feedback.Plain}, Feedback.Choice{label: "Delete", role: Feedback.Destructive}]
}

export fn main() -> Int {
  var held = 0

  // Indicators: a progress bar with its value, a running activity indicator.
  if wordsAt(&built(&View.Progress(250u32)), 0, 6) == [1u32, 0u32, 10u32, 29u32, 0u32, 250u32] { held = held + 1 }
  if wordsAt(&built(&View.Activity(true)), 0, 6) == [1u32, 0u32, 11u32, 7u32, 0u32, 1u32] { held = held + 1 }
  let advanced = changed(&View.Progress(250u32), &View.Progress(750u32))
  if advanced.length() == 12 && wordsAt(&advanced, 0, 3) == [29u32, 0u32, 750u32] { held = held + 1 }

  // Gestures: the recognizers' mask and tag on the label; a new mask is one GESTURES.
  let recognizing = View.Recognizing(5u32, [Gesture.Pan, Gesture.Swipe], View.Label("g"))
  if wordsAt(&built(&recognizing), 25, 4) == [27u32, 0u32, 5u32, 18u32] { held = held + 1 }
  let repanned = changed(&recognizing, &View.Recognizing(5u32, [Gesture.Pan], View.Label("g")))
  if changed(&recognizing, &recognizing).length() == 0 && repanned.length() == 16 && wordsAt(&repanned, 0, 4) == [27u32, 0u32, 5u32, 2u32] {
    held = held + 1
  }

  // Accessibility: traits, hint and value on the label; a new value alone is one ACCESS_VALUE.
  let described = built(&View.Accessible(access("v"), View.Label("a")))
  if wordsAt(&described, 25, 3) == [31u32, 0u32, 5u32] && wordsAt(&described, 37, 3) == [32u32, 0u32, 1u32] && wordsAt(&described, 50, 3) == [33u32, 0u32, 1u32] {
    held = held + 1
  }
  let revalued = changed(&View.Accessible(access("v"), View.Label("a")), &View.Accessible(access("v2"), View.Label("a")))
  if revalued.length() == 14 && wordsAt(&revalued, 0, 3) == [33u32, 0u32, 2u32] { held = held + 1 }

  // A context menu: its tag, then each choice's role and label.
  let menued = built(&View.Menu(7u32, menu(), View.Label("m")))
  if wordsAt(&menued, 25, 6) == [34u32, 0u32, 7u32, 2u32, 0u32, 4u32] && wordsAt(&menued, 53, 2) == [2u32, 6u32] { held = held + 1 }

  // An animated group marks the group itself.
  if wordsAt(&built(&View.Animated(View.Column([]))), 0, 6) == [1u32, 0u32, 3u32, 35u32, 0u32, 1u32] { held = held + 1 }

  // Commands: an action sheet with one cancel choice; a success haptic.
  let sheet = Feedback.alert(&Feedback.Alert{tag: 9u32, style: Feedback.Sheet, title: "T", message: "M", choices: [Feedback.Choice{label: "OK", role: Feedback.Cancel}]}).toArray()
  if sheet.length() == 36 && wordsAt(&sheet, 0, 4) == [28u32, 9u32, 1u32, 1u32] && wordsAt(&sheet, 22, 3) == [1u32, 1u32, 2u32] { held = held + 1 }
  if wordsAt(&Feedback.haptic(Feedback.Success).toArray(), 0, 2) == [30u32, 5u32] { held = held + 1 }

  // Gesture events decode their bit and signed words.
  if View.eventWithWords((9u64 << 32) | 1u64, "", 2u32, [2i32, 12i32, -7i32]) == View.Gestured(1u32, Gesture.Panned(Gesture.Changed, 12i32, -7i32))
    && View.eventWithWords((9u64 << 32) | 1u64, "", 16u32, [2i32]) == View.Gestured(1u32, Gesture.Swiped(Gesture.Right))
    && View.carriesWords(9u64 << 32)
    && !View.carriesWords(10u64 << 32)
    && View.carriesDetail(10u64 << 32) {
    held = held + 1
  }

  // Choices, picks and lifecycle phases arrive as details; an unknown phase stops.
  if View.eventWithWords((10u64 << 32) | 4u64, "", 1u32, []) == View.Chose(4u32, 1u32)
    && View.eventWithWords((13u64 << 32) | 2u64, "", 1u32, []) == View.Picked(2u32, 1u32)
    && View.eventWithWords(12u64 << 32, "", 2u32, []) == View.Lifecycle(Scene.Inactive)
    && View.eventWithWords(12u64 << 32, "", 9u32, []) == View.Stopped {
    held = held + 1
  }

  // A resize carries the scene's size and classes; malformed words stop.
  let resized = View.eventWithWords(11u64 << 32, "", 0u32, [402i32, 874i32, 1i32, 2i32])
  if resized == View.Resized(Scene.Size{width: 402i32, height: 874i32, horizontal: Scene.Compact, vertical: Scene.Regular})
    && View.eventWithWords(11u64 << 32, "", 0u32, [1i32]) == View.Stopped {
    held = held + 1
  }

  // Host words are two's complement.
  if View.signed(0xfffffff9u32) == -7i32 && View.signed(12u32) == 12i32 { held = held + 1 }

  // Every trait and every recognizer has its own bit.
  let everyTrait = [
    Access.Button, Access.Link, Access.Header, Access.SearchField, Access.Image, Access.Selected, Access.PlaysSound,
    Access.KeyboardKey, Access.StaticText, Access.SummaryElement, Access.NotEnabled, Access.UpdatesFrequently,
    Access.StartsMediaSession, Access.Adjustable, Access.AllowsDirectInteraction, Access.CausesPageTurn, Access.TabBar,
    Access.ToggleButton, Access.SupportsZoom
  ]
  let everyGesture = [Gesture.LongPress, Gesture.Pan, Gesture.Pinch, Gesture.Rotation, Gesture.Swipe]
  if Access.mask(&everyTrait) == 524287u32 && Gesture.mask(&everyGesture) == 31u32 { held = held + 1 }
  held
}
