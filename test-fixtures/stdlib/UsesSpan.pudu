module UsesSpan

import Std.Iter {Sequence}
import Std.Span as Span
import Std.Span {Window}

fn narrowing() -> Bool {
  let whole: Span.Span[Int] = Span.of([10, 20, 30, 40, 50])
  let middle = whole.subspan(1, 3)
  middle.toArray() == [20, 30, 40]
    && middle.size() == 3
    && middle.prefix(2).toArray() == [20, 30]
    && middle.suffix(1).toArray() == [40]
    && middle.subspan(1, 1).toArray() == [30]
}

/// Every narrowing clamps, so out-of-range requests answer a smaller span.
fn clamping() -> Bool {
  let whole = Span.of([1, 2, 3])
  whole.prefix(10).toArray() == [1, 2, 3]
    && whole.prefix(-1).isEmpty()
    && whole.suffix(9).toArray() == [1, 2, 3]
    && whole.suffix(0).isEmpty()
    && whole.subspan(9, 2).isEmpty()
    && whole.subspan(-3, 2).toArray() == [1, 2]
    && whole.subspan(2, 9).toArray() == [3]
}

fn reading() -> Bool {
  let middle = Span.of([4, 5, 6, 7]).subspan(1, 2)
  middle.get(0) == Some(5)
    && middle.get(1) == Some(6)
    && middle.get(2) == None
    && middle.get(-1) == None
    && middle.first() == Some(5)
    && middle.last() == Some(6)
    && Span.of([]).first() == None
    && Span.of([]).last() == None
    && middle.count() == 2
}

fn within() -> Bool {
  Span.within([1, 2, 3], 1, 2) == Some(Span.of([1, 2, 3]).subspan(1, 2))
    && Span.within([1, 2, 3], 3, 0) != None
    && Span.within([1, 2, 3], 2, 5) == None
    && Span.within([1, 2, 3], -1, 1) == None
    && Span.within([1, 2, 3], 0, -1) == None
}

/// A span is a sequence: it walks in a `for` and takes every adapter.
fn walking() -> Bool {
  let middle = Span.of([1, 2, 3, 4, 5]).subspan(1, 3)
  var total = 0
  for value in middle { total = total + value }
  total == 9
    && middle.map(|n| n * 10).toArray() == [20, 30, 40]
    && middle.filter(|n| n % 2 == 0).count() == 2
    && middle.fold(0, |sum, n| sum + n) == 9
}

/// Narrowing a view leaves the array it views unchanged.
fn viewsShareTheArray() -> Bool {
  let values = ["a", "b", "c"]
  let tail = Span.of(values).suffix(2)
  tail.toArray() == ["b", "c"] && values == ["a", "b", "c"] && tail.source == values
}

export fn main() -> Int {
  let checks = [narrowing(), clamping(), reading(), within(), walking(), viewsShareTheArray()]
  var held = 0
  for passed in checks {
    if passed { held = held + 1 }
  }
  held
}
