module UsesPassword

import Std.App.Password {NoEntropy, Unreadable, UnknownAlgorithm}
import Std.App.Password as Password
import Std.Result as Result

/// What storing a password promises.
///
/// The claim under test is that a stored form proves a password later without
/// holding it, and that it carries the settings it was made with — so raising
/// the work factor does not lock anybody out.
export fn main() -> Int {
  var held = 0

  let stored = orNothing(Password.store("correct horse battery staple"))

  // The password it was made from proves it; nothing else does.
  if Password.matches("correct horse battery staple", &stored) { held = held + 1 }
  if !Password.matches("correct horse battery stapl", &stored) { held = held + 1 }
  if !Password.matches("", &stored) { held = held + 1 }
  if !Password.matches("CORRECT HORSE BATTERY STAPLE", &stored) { held = held + 1 }

  // The stored form does not hold the password.
  if !Password.render(&stored).contains("correct") { held = held + 1 }
  if !Password.render(&stored).contains("horse") { held = held + 1 }
  if !stored.digest.contains("correct") { held = held + 1 }

  // Every password gets its own salt, so two people who chose the same one do
  // not have the same digest — which would turn one guess into a list of
  // accounts.
  let again = orNothing(Password.store("correct horse battery staple"))
  if again.salt != stored.salt { held = held + 1 }
  if again.digest != stored.digest { held = held + 1 }
  if Password.matches("correct horse battery staple", &again) { held = held + 1 }

  // The stored form carries what it was made with.
  if Password.algorithmOf(&stored) == "pbkdf2-sha256" { held = held + 1 }
  if Password.roundsOf(&stored) == Password.currentRounds() { held = held + 1 }
  if Password.currentRounds() >= 210000 { held = held + 1 }
  if !stored.salt.isEmpty() { held = held + 1 }

  // Which is what lets an older password still verify against its own settings
  // rather than being invalidated when the work factor rises.
  let older = Password.storeWith("hunter2", stored.salt, 1000)
  if Password.matches("hunter2", &older) { held = held + 1 }
  if !Password.matches("hunter3", &older) { held = held + 1 }
  if Password.roundsOf(&older) == 1000 { held = held + 1 }

  // And an older one says it should be remade — asked after the password has
  // been proved, because that is the only moment it is in hand to remake with.
  if Password.needsRemaking(&older) { held = held + 1 }
  if !Password.needsRemaking(&stored) { held = held + 1 }

  // The same password, salt, and work factor give the same digest, which is
  // what verifying is.
  let repeated = Password.storeWith("hunter2", stored.salt, 1000)
  if repeated.digest == older.digest { held = held + 1 }

  // A different work factor gives a different digest, so the number is really
  // part of what was stored.
  if Password.storeWith("hunter2", stored.salt, 2000).digest != older.digest { held = held + 1 }

  // A different salt does too.
  if Password.storeWith("hunter2", again.salt, 1000).digest != older.digest { held = held + 1 }

  // A stored form is one piece of text, and reads back as what it was.
  let written = Password.render(&stored)
  if written.split("$").length() == 4 { held = held + 1 }
  if written.startsWith("pbkdf2-sha256$") { held = held + 1 }
  let read = orNothing(Password.parse(written))
  if read.algorithm == stored.algorithm { held = held + 1 }
  if read.rounds == stored.rounds { held = held + 1 }
  if read.salt == stored.salt { held = held + 1 }
  if read.digest == stored.digest { held = held + 1 }
  if Password.matches("correct horse battery staple", &read) { held = held + 1 }

  // A form that cannot be read is a failure rather than one that matches
  // nothing: a password that silently never verifies looks exactly like a
  // person who forgot theirs, and the two need different answers.
  if let Err(Unreadable(_)) = Password.parse("nonsense") { held = held + 1 }
  if let Err(Unreadable(_)) = Password.parse("pbkdf2-sha256$1000$salt") { held = held + 1 }
  if let Err(Unreadable(_)) = Password.parse("pbkdf2-sha256$notanumber$salt$digest") {
    held = held + 1
  }
  if let Err(Unreadable(_)) = Password.parse("pbkdf2-sha256$0$salt$digest") { held = held + 1 }
  if let Err(Unreadable(_)) = Password.parse("pbkdf2-sha256$1000$$digest") { held = held + 1 }

  // An algorithm this does not write is named rather than silently refused, so
  // a store carrying an older one can be recognised.
  if let Err(UnknownAlgorithm(named)) = Password.parse("md5$1$a$b") {
    if named == "md5" { held = held + 1 }
  }

  // A stored form made by another algorithm proves nothing here.
  let foreign = Password.Stored{algorithm: "md5", rounds: 1, salt: "a", digest: "b"}
  if !Password.matches("anything", &foreign) { held = held + 1 }
  if Password.needsRemaking(&foreign) { held = held + 1 }

  // A refusal says what was wrong.
  if Password.explain(&NoEntropy).contains("randomness") { held = held + 1 }
  if Password.explain(&UnknownAlgorithm("md5")).contains("md5") { held = held + 1 }

  // And a refusal never repeats the password it was given.
  if !Password.explain(&Unreadable("hunter2")).contains("hunter2") { held = held + 1 }

  held
}

fn orNothing(outcome: Result[Password.Stored, Password.PasswordError]) -> Password.Stored {
  Result.unwrapOr(outcome, Password.Stored{algorithm: "", rounds: 0, salt: "", digest: ""})
}
