module RejectsBorrowedForeignRelease

/// A result cannot be both kept by the library and released by the program.
foreign "c" {
  type Box

  fn shared symbol "pudu_ffi_cpp_box_shared" () -> borrowed Box by deleteBox
  fn deleteBox symbol "pudu_ffi_cpp_box_delete" (box: Box) -> ()
}

export fn main() -> Int { 0 }
