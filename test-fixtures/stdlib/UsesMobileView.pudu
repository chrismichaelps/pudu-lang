module UsesMobileView

import Std.ByteOrder {readU32LE}
import Std.Mobile.Navigation as Navigation
import Std.Mobile.Stream as Stream
import Std.Mobile.View as View
import Std.Ui.Navigation as Stack

fn counter(count: Int) -> View.View {
  View.Column([View.Label("Count: {count}"), View.Button("Add one", 1u32)])
}

// The words at `offset` onward, read as little-endian 32-bit values.
fn wordsAt(bytes: &Array[UInt8], offset: Int, count: Int) -> Array[UInt32] {
  var found = []
  for index in 0..count {
    match readU32LE(bytes, offset + index * 4) {
      case Some(word) => { found = found.push(word) }
      case None => { return [] }
    }
  }
  found
}

fn textAt(bytes: &Array[UInt8], offset: Int, length: Int) -> Option[Str] {
  bytesOf(bytes.slice(offset, offset + length)).toText()
}

// The stream that builds a view from nothing.
fn built(view: &View.View) -> Array[UInt8] {
  let (_, stream) = View.mount(view)
  stream.toArray()
}

// The stream that turns a freshly mounted `shown` into `next`.
fn changed(shown: &View.View, next: &View.View) -> Array[UInt8] {
  let (mounted, _) = View.mount(shown)
  let (_, stream) = View.update(&mounted, next)
  stream.toArray()
}

fn row(key: Str) -> (Str, View.View) { (key, View.Label(key)) }

fn duplicatesRetired() -> Bool {
  let repeated = View.Keyed([row("aa"), row("aa")])
  let (mounted, _) = View.mount(&repeated)
  let (updated, rebuilt) = View.update(&mounted, &repeated)
  let single = View.Keyed([row("aa")])
  let (shrunk, removed) = View.update(&updated, &single)
  let (_, still) = View.update(&shrunk, &single)
  rebuilt.length() == 58
    && wordsAt(&rebuilt.toArray(), 26, 8) == [10u32, 0u32, 3u32, 1u32, 11u32, 2u32, 1u32, 2u32]
    && updated.free == [2u32]
    && removed.length() == 16
    && wordsAt(&removed.toArray(), 0, 4) == [11u32, 3u32, 1u32, 3u32]
    && shrunk.free == [2u32, 3u32]
    && shrunk.root.children[0].id == 1u32
    && still.length() == 0
}

fn scrollKeepsViewport() -> Bool {
  let (mounted, stream) = View.mount(&View.Scroll(View.Label("")))
  let (updated, replaced) = View.update(&mounted, &View.Scroll(View.Column([])))
  wordsAt(&stream.toArray(), 0, 14) == [1u32, 0u32, 7u32, 1u32, 1u32, 1u32, 2u32, 1u32, 0u32, 3u32, 0u32, 1u32, 4u32, 0u32]
    && stream.length() == 56
    && wordsAt(&replaced.toArray(), 0, 11) == [1u32, 2u32, 3u32, 10u32, 0u32, 2u32, 0u32, 11u32, 1u32, 1u32, 1u32]
    && replaced.length() == 44
    && updated.root.id == mounted.root.id
}

fn route(id: UInt32, title: Str) -> Navigation.Route {
  Navigation.Route{id: id, title: title, body: View.Label(title)}
}

fn navigationChecks() -> Bool {
  let root = Stack.stack(route(10u32, "Café"))
  let first = Stack.push(&root, route(20u32, "Detail"))
  let shown = Stack.push(&first, route(30u32, "Editor"))
  let duplicate = Stack.push(&shown, route(10u32, "Duplicate"))
  let toRoot = Navigation.Pop{from: 30u32, destination: 10u32}
  let toDetail = Navigation.Pop{from: 30u32, destination: 20u32}
  let Some(retainedRoot) = Navigation.afterPop(&shown, toRoot) else { return false }
  let Some(retainedDetail) = Navigation.afterPop(&shown, toDetail) else { return false }
  let wire = Stream.navigation([], &[(10u32, 42u32, "Café"), (20u32, 84u32, "")])
  Navigation.validate(&shown) == Ok(())
    && Navigation.validate(&duplicate) == Err(Navigation.DuplicateRoute(10u32))
    && Stack.depth(&retainedRoot) == 1 && Stack.top(&retainedRoot).id == 10u32
    && Stack.depth(&retainedDetail) == 2 && Stack.top(&retainedDetail).id == 20u32
    && Navigation.afterPop(&first, toRoot) == None
    && Navigation.afterPop(&shown, Navigation.Pop{from: 30u32, destination: 99u32}) == None
    && Navigation.afterPop(&shown, Navigation.Pop{from: 30u32, destination: 30u32}) == None
    && wordsAt(&wire, 0, 5) == [13u32, 2u32, 10u32, 42u32, 5u32]
    && textAt(&wire, 20, 5) == Some("Café")
    && wordsAt(&wire, 25, 3) == [20u32, 84u32, 0u32] && wire.length() == 37
}

export fn main() -> Int {
  var held = 0
  let zero = counter(0)
  let builtZero = built(&zero)

  // The whole counter: 26 words and 15 bytes of text.
  if builtZero.length() == 119 { held = held + 1 }
  // Column 0, label 1 with its text, appended; button 2 tagged 1 with its text, appended; root 0.
  if wordsAt(&builtZero, 0, 9) == [1u32, 0u32, 3u32, 1u32, 1u32, 1u32, 2u32, 1u32, 8u32] { held = held + 1 }
  if textAt(&builtZero, 36, 8) == Some("Count: 0") { held = held + 1 }
  if wordsAt(&builtZero, 44, 12) == [3u32, 0u32, 1u32, 1u32, 2u32, 2u32, 5u32, 2u32, 1u32, 2u32, 2u32, 7u32] { held = held + 1 }
  if textAt(&builtZero, 92, 7) == Some("Add one") { held = held + 1 }
  if wordsAt(&builtZero, 99, 5) == [3u32, 0u32, 2u32, 4u32, 0u32] { held = held + 1 }

  // A count change is one TEXT instruction for the label.
  let one = counter(1)
  let counted = changed(&zero, &one)
  if counted.length() == 20 && wordsAt(&counted, 0, 3) == [2u32, 1u32, 8u32] { held = held + 1 }
  if textAt(&counted, 12, 8) == Some("Count: 1") { held = held + 1 }

  // The same tree changes nothing.
  if changed(&one, &one).length() == 0 { held = held + 1 }

  // A shorter column keeps its first child and removes the rest.
  let other = View.Column([View.Label("only")])
  let shortened = changed(&zero, &other)
  if wordsAt(&shortened, 0, 3) == [2u32, 1u32, 4u32] && textAt(&shortened, 12, 4) == Some("only") && wordsAt(&shortened, 16, 4) == [11u32, 2u32, 1u32, 2u32] { held = held + 1 }

  // A changed button tag replaces only that button: built, inserted, the old one removed.
  let retagged = View.Column([View.Label("Count: 0"), View.Button("Add one", 2u32)])
  let replaced = changed(&zero, &retagged)
  if wordsAt(&replaced, 0, 6) == [1u32, 3u32, 2u32, 5u32, 3u32, 2u32] && wordsAt(&replaced, 43, 8) == [10u32, 0u32, 3u32, 1u32, 11u32, 2u32, 1u32, 2u32] { held = held + 1 }

  // Events: kind above, tag below, text from the host; an unknown kind stops.
  if View.event((1u64 << 32) | 7u64, "") == View.Tapped(7u32) { held = held + 1 }
  if View.event(2u64 << 32, "") == View.Stopped { held = held + 1 }
  if View.event(9u64 << 32, "") == View.Stopped { held = held + 1 }
  if View.event((3u64 << 32) | 2u64, "Ada") == View.Changed(2u32, "Ada") { held = held + 1 }
  if View.event((4u64 << 32) | 5u64, "") == View.Toggled(5u32, true) && View.event((5u64 << 32) | 5u64, "") == View.Toggled(5u32, false) { held = held + 1 }
  if View.carriesText(3u64 << 32) && !View.carriesText(1u64 << 32) { held = held + 1 }

  // A named field: created with its tag, placeholder, empty text and name.
  let form = View.Column([View.Named("Your name", View.Field("Name", "", 1u32))])
  let formed = built(&form)
  if wordsAt(&formed, 12, 6) == [1u32, 1u32, 5u32, 5u32, 1u32, 1u32] && wordsAt(&formed, 36, 3) == [8u32, 1u32, 4u32] { held = held + 1 }
  if textAt(&formed, 48, 4) == Some("Name") && wordsAt(&formed, 52, 6) == [2u32, 1u32, 0u32, 9u32, 1u32, 9u32] { held = held + 1 }
  if textAt(&formed, 76, 9) == Some("Your name") && wordsAt(&formed, 85, 5) == [3u32, 0u32, 1u32, 4u32, 0u32] { held = held + 1 }

  // A row is kind 4.
  let rowed = View.Row([View.Label("x")])
  if wordsAt(&built(&rowed), 0, 3) == [1u32, 0u32, 4u32] { held = held + 1 }

  // In-place changes: a toggle's state, a field's placeholder and text, a name.
  let off = View.Toggle("Subscribe", false, 2u32)
  let on = View.Toggle("Subscribe", true, 2u32)
  if wordsAt(&changed(&off, &on), 0, 3) == [7u32, 0u32, 1u32] && changed(&off, &on).length() == 12 { held = held + 1 }
  let hinted = changed(&View.Field("Name", "", 1u32), &View.Field("Full name", "Ada", 1u32))
  if wordsAt(&hinted, 0, 3) == [8u32, 0u32, 9u32] && wordsAt(&hinted, 21, 3) == [2u32, 0u32, 3u32] && textAt(&hinted, 33, 3) == Some("Ada") { held = held + 1 }
  let renamed = changed(&View.Named("A", View.Label("x")), &View.Named("B", View.Label("x")))
  if wordsAt(&renamed, 0, 3) == [9u32, 0u32, 1u32] && textAt(&renamed, 12, 1) == Some("B") { held = held + 1 }

  // A root with another tag is replaced: built, shown, the old one removed.
  let retoggled = changed(&off, &View.Toggle("Subscribe", false, 3u32))
  if wordsAt(&retoggled, 0, 6) == [1u32, 1u32, 6u32, 5u32, 1u32, 3u32] && wordsAt(&retoggled, 45, 9) == [7u32, 1u32, 0u32, 4u32, 1u32, 11u32, 0u32, 1u32, 0u32] { held = held + 1 }

  // Keyed rows: a reorder is one move, an insertion one built row, a removal frees its ids for reuse.
  let (listed, _) = View.mount(&View.Keyed([row("aa"), row("bb"), row("cc")]))
  let (reordered, moved) = View.update(&listed, &View.Keyed([row("cc"), row("aa"), row("bb")]))
  if wordsAt(&moved.toArray(), 0, 4) == [12u32, 0u32, 3u32, 0u32] && moved.length() == 16 { held = held + 1 }
  let (grown, inserted) = View.update(&reordered, &View.Keyed([row("cc"), row("xx"), row("aa"), row("bb")]))
  if wordsAt(&inserted.toArray(), 0, 6) == [1u32, 4u32, 1u32, 2u32, 4u32, 2u32] && wordsAt(&inserted.toArray(), 26, 4) == [10u32, 0u32, 4u32, 1u32] { held = held + 1 }
  let (shrunk, dropped) = View.update(&grown, &View.Keyed([row("cc"), row("aa"), row("bb")]))
  if wordsAt(&dropped.toArray(), 0, 4) == [11u32, 4u32, 1u32, 4u32] && shrunk.free == [4u32] { held = held + 1 }
  let (_, reused) = View.update(&shrunk, &View.Keyed([row("cc"), row("aa"), row("bb"), row("yy")]))
  if wordsAt(&reused.toArray(), 0, 3) == [1u32, 4u32, 1u32] && wordsAt(&reused.toArray(), 26, 4) == [10u32, 0u32, 4u32, 3u32] { held = held + 1 }
  // Unique keys are a no-op when unchanged. Old repeated rows must be retired.
  let (_, still) = View.update(&shrunk, &View.Keyed([row("cc"), row("aa"), row("bb")]))
  if still.length() == 0 && duplicatesRetired() && scrollKeepsViewport() { held = held + 1 }
  if navigationChecks() { held } else { -1 }
}
