module UsesDynamic

/// A value whose concrete type is not known where it is used.
///
/// Every design pattern that needs one — Observer over listeners of different
/// types, a factory returning "some Shape", a composite with mixed children,
/// a registry of handlers — is the same missing feature. A sum type closes the
/// set, and a bound names one type per call site; neither expresses a
/// collection whose members were written by someone else.
trait Listener {
  fn notify(self: &Self, event: Str) -> Int
}

type Logger = { weight: Int }
type Counter = { weight: Int }
type Silent = {}

impl Listener for Logger {
  fn notify(self: &Self, event: Str) -> Int { self.weight }
}

impl Listener for Counter {
  fn notify(self: &Self, event: Str) -> Int { self.weight * 2 }
}

impl Listener for Silent {
  fn notify(self: &Self, event: Str) -> Int { 0 }
}

trait Shape {
  fn area(self: &Self) -> Int
}

type Circle = { r: Int }
type Square = { s: Int }

impl Shape for Circle {
  fn area(self: &Self) -> Int { 3 * self.r * self.r }
}

impl Shape for Square {
  fn area(self: &Self) -> Int { self.s * self.s }
}

/// The Observer pattern: one collection, several implementing types.
fn observersOfDifferentTypes() -> Bool {
  let listeners: Array[dynamic Listener] =
  [Logger{weight: 1}, Counter{weight: 5}, Silent{}]
  var total = 0
  for listener in listeners {
    total = total + listener.notify("tick")
  }
  total == 11
}

/// The Factory pattern: a return type that names behaviour, not a type. The
/// branches have different types and both widen where the signature asks.
fn make(kind: Str) -> dynamic Shape {
  if kind == "circle" {
    Circle{r: 2}
  } else {
    Square{s: 3}
  }
}

fn factoryReturnsEither() -> Bool {
  make("circle").area() == 12 && make("square").area() == 9
}

/// A match arm widens the same way a branch does.
fn fromCode(code: Int) -> dynamic Shape {
  match code {
    case 0 => Circle{r: 1}
    case _ => Square{s: 4}
  }
}

fn matchArmsWiden() -> Bool {
  fromCode(0).area() == 3 && fromCode(1).area() == 16
}

/// A dynamic value is an ordinary value: it goes in a record, comes back out,
/// and is passed to a function.
type Registry = { primary: dynamic Listener, weight: Int }

fn ring(registry: &Registry) -> Int {
  registry.primary.notify("ring") + registry.weight
}

fn dynamicValuesAreOrdinary() -> Bool {
  let registry = Registry{primary: Counter{weight: 3}, weight: 4}
  ring(&registry) == 10
}

/// A function taking a dynamic argument accepts every implementation, and
/// takes them without a type parameter per call.
fn loudest(left: dynamic Listener, right: dynamic Listener) -> Int {
  let a = left.notify("x")
  let b = right.notify("x")
  if a > b { a } else { b }
}

fn dynamicParametersAccentAnyImplementation() -> Bool {
  loudest(Logger{weight: 9}, Counter{weight: 2}) == 9
}

/// The point of a dynamic type over a sum: this array holds three types, and
/// adding a fourth needs no edit here or anywhere else that walks it.
fn theSetIsOpen() -> Bool {
  let shapes: Array[dynamic Shape] = [Circle{r: 1}, Square{s: 2}, Circle{r: 3}]
  var total = 0
  for shape in shapes {
    total = total + shape.area()
  }
  total == 34
}

/// Composite: children of mixed types, and the tree itself is dynamic.
trait Node {
  fn total(self: &Self) -> Int
}

type Leaf = { value: Int }
type Group = { children: Array[dynamic Node] }

impl Node for Leaf {
  fn total(self: &Self) -> Int { self.value }
}

impl Node for Group {
  fn total(self: &Self) -> Int {
    var sum = 0
    for child in self.children {
      sum = sum + child.total()
    }
    sum
  }
}

/// A record field's declared type is an expectation too, so a field declared
/// `Array[dynamic Node]` takes a literal of mixed implementations.
fn compositeNestsHeterogeneously() -> Bool {
  let tree: dynamic Node = Group{children: [
      Leaf{value: 1},
      Group{children: [Leaf{value: 2}, Leaf{value: 3}]}
    ] }
  tree.total() == 6
}

/// Chain of Responsibility: an open set of handlers, first answer wins.
trait Handler {
  fn handle(self: &Self, value: Int) -> Option[Int]
}

type Small = {}
type Large = {}

impl Handler for Small {
  fn handle(self: &Self, value: Int) -> Option[Int] {
    if value < 10 { Some(1) } else { None }
  }
}

impl Handler for Large {
  fn handle(self: &Self, value: Int) -> Option[Int] {
    if value >= 10 { Some(2) } else { None }
  }
}

fn firstHandlerThatAnswers(handlers: &Array[dynamic Handler], value: Int) -> Int {
  for handler in handlers {
    match handler.handle(value) {
      case Some(answer) => { return answer }
      case None => {}
    }
  }
  0
}

fn chainOfResponsibility() -> Bool {
  let handlers: Array[dynamic Handler] = [Small{}, Large{}]
  firstHandlerThatAnswers(&handlers, 5) == 1 &&
  firstHandlerThatAnswers(&handlers, 50) == 2 &&
  firstHandlerThatAnswers(&handlers, 0 - 1) == 1
}

/// Abstract Factory: the factory is dynamic and what it makes is dynamic too.
trait Widget {
  fn draw(self: &Self) -> Int
}

trait Maker {
  fn create(self: &Self) -> dynamic Widget
}

type Button = {}
type Slider = {}
type ButtonMaker = {}
type SliderMaker = {}

impl Widget for Button {
  fn draw(self: &Self) -> Int { 1 }
}

impl Widget for Slider {
  fn draw(self: &Self) -> Int { 2 }
}

impl Maker for ButtonMaker {
  fn create(self: &Self) -> dynamic Widget { Button{} }
}

impl Maker for SliderMaker {
  fn create(self: &Self) -> dynamic Widget { Slider{} }
}

fn abstractFactory() -> Bool {
  let makers: Array[dynamic Maker] = [ButtonMaker{}, SliderMaker{}]
  var total = 0
  for maker in makers {
    total = total + maker.create().draw()
  }
  total == 3
}

export fn main() -> Int {
  var passed = 0
  if observersOfDifferentTypes() { passed = passed + 1 }
  if factoryReturnsEither() { passed = passed + 1 }
  if matchArmsWiden() { passed = passed + 1 }
  if dynamicValuesAreOrdinary() { passed = passed + 1 }
  if dynamicParametersAccentAnyImplementation() { passed = passed + 1 }
  if theSetIsOpen() { passed = passed + 1 }
  if compositeNestsHeterogeneously() { passed = passed + 1 }
  if chainOfResponsibility() { passed = passed + 1 }
  if abstractFactory() { passed = passed + 1 }
  passed
}
