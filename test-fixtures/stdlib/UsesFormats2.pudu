module UsesFormats2

import Std.Text.Parse as P
import Std.Time as T

/// Formats a program actually meets: a date, a record file, a delimited row.
///
/// Each of these needs something the combinators could not say before. A date
/// needs "exactly four digits", because a shape that resembles the format is
/// not the format. A record file needs line endings both ways a file writes
/// them, and a last line that may have none. A delimited row needs a run
/// scanned against a set rather than a character at a time.
type Record = { name: Str, sequence: Str }

/// FASTQ is positional: four lines per record. The quality line may itself
/// begin with `@`, so a reader that finds records by looking for `@` at the
/// start of a line is wrong on real data.
type Read = { name: Str, bases: Str, quality: Str }

fn digits(width: Int) -> P.Parser[Int] {
  P.map(P.count(width, P.digit()), fn(found: Array[Char]) -> Int => {
      var total = 0
      for one in found {
        total = total * 10 + (one.code() - '0'.code())
      }
      total
    })
}

fn isoDate() -> P.Parser[T.Date] {
  P.label("an ISO-8601 date",
    P.map(
      P.both(
        P.keepFirst(digits(4), P.character('-')),
        P.both(P.keepFirst(digits(2), P.character('-')), digits(2))
      ),
      fn(parts: (Int, (Int, Int))) -> T.Date =>
      T.Date{year: parts[0], month: parts[1][0], day: parts[1][1]}
    ))
}

fn header() -> P.Parser[Str] { P.keepSecond(P.character('>'), P.line()) }

fn residues() -> P.Parser[Str] {
  P.keepFirst(P.takeOf1("sequence residues", "ACGTUNacgtun"), P.lineEnd())
}

fn record() -> P.Parser[Record] {
  P.map(P.both(header(), P.some(residues())),
    fn(parts: (Str, Array[Str])) -> Record => {
      var joined = ""
      for piece in parts[1] {
        joined = joined + piece
      }
      Record{name: parts[0], sequence: joined}
    })
}

fn records() -> P.Parser[Array[Record]] { P.many(record()) }

fn row() -> P.Parser[Array[Str]] {
  P.keepFirst(P.separatedBy(P.takeNotOf("\t\n\r"), P.character('\t')), P.lineEnd())
}

fn fastqRecord() -> P.Parser[Read] {
  P.map(
    P.both(
      P.keepSecond(P.character('@'), P.line()),
      P.both(
        P.keepFirst(P.takeOf1("bases", "ACGTUNacgtun"), P.lineEnd()),
        P.keepSecond(
          P.keepFirst(P.keepSecond(P.character('+'), P.restOfLine()), P.lineEnd()),
          P.keepFirst(P.takeNotOf("\n\r"), P.lineEnd())
        )
      )
    ),
    fn(parts: (Str, (Str, Str))) -> Read =>
    Read{name: parts[0], bases: parts[1][0], quality: parts[1][1]}
  )
}

/// A quoted field may hold commas, and a doubled quote standing for one.
fn quotedField() -> P.Parser[Str] {
  P.map(
    P.between(
      P.character('"'),
      P.many(P.orElse(
          P.map(P.attempt(P.literal("\"\"")), fn(_d: Str) -> Str => "\""),
          P.takeNotOf1("field text", "\"")
        )),
      P.character('"')
    ),
    fn(pieces: Array[Str]) -> Str => {
      var joined = ""
      for piece in pieces {
        joined = joined + piece
      }
      joined
    }
  )
}

fn csvRow() -> P.Parser[Array[Str]] {
  P.keepFirst(
    P.separatedBy(P.orElse(quotedField(), P.takeNotOf(",\n\r")), P.character(',')),
    P.lineEnd()
  )
}

export fn main() -> Int {
  var total = 0

  match P.run(isoDate(), "2026-08-26") {
    case Ok(found) => {
      if found.year == 2026 && found.month == 8 && found.day == 26 {
        total = total + 1
      }
    }
    case Err(_e) => {}
  }

  // one digit short is a different thing wearing the same punctuation
  match P.run(isoDate(), "2026-8-26") {
    case Ok(_f) => {}
    case Err(_e) => { total = total + 2 }
  }

  match P.run(records(), ">seq1 first\nACGT\nTTGA\n>seq2 second\nGGCC\n") {
    case Ok(found) => {
      if found.length() == 2 {
        total = total + 4
      }
      if found[0].name == "seq1 first" && found[0].sequence == "ACGTTTGA" {
        total = total + 8
      }
    }
    case Err(_e) => {}
  }

  // a file written on another system, and a last line with no ending
  match P.run(records(), ">a\r\nACGT\r\n>b\nGG") {
    case Ok(found) => {
      if found.length() == 2 && found[0].sequence == "ACGT" && found[1].sequence == "GG" {
        total = total + 16
      }
    }
    case Err(_e) => {}
  }

  match P.run(row(), "chr1\t1000\tA\tG\n") {
    case Ok(cells) => {
      if cells.length() == 4 && cells[1] == "1000" && cells[3] == "G" {
        total = total + 32
      }
    }
    case Err(_e) => {}
  }

  // a problem a reader can act on names the line, not the character count
  match P.run(P.many(row()), "chr1\tA\nchr2\tB\n") {
    case Ok(_c) => { total = total + 64 }
    case Err(_e) => {}
  }

  match P.run(P.keepSecond(P.literal("x"), P.hexadecimal()), "xff") {
    case Ok(value) => {
      if value == 255 {
        total = total + 128
      }
    }
    case Err(_e) => {}
  }

  match P.run(P.signed(P.integer()), "-42") {
    case Ok(value) => {
      if value == 0 - 42 {
        total = total + 256
      }
    }
    case Err(_e) => {}
  }

  match P.lineAndColumn("one\ntwo\nthree", 8) {
    case place => {
      if place[0] == 3 && place[1] == 1 {
        total = total + 512
      }
    }
  }

  let fastq = "@read1 first\nACGTACGT\n+\n@@@BBBFF\n@read2\nTTTT\n+again\n!!!!\n"
  match P.run(P.many(fastqRecord()), fastq) {
    case Ok(reads) => {
      // the quality line begins with '@' and is not the next record
      if reads.length() == 2 && reads[0].quality == "@@@BBBFF" {
        total = total + 1024
      }
      if reads[1].name == "read2" && reads[1].quality == "!!!!" {
        total = total + 2048
      }
    }
    case Err(_e) => {}
  }

  match P.run(P.many(csvRow()), "plain,\"has,comma\",\"says \"\"hi\"\"\"\na,b,c\n") {
    case Ok(rows) => {
      if rows.length() == 2 && rows[0][1] == "has,comma" {
        total = total + 4096
      }
      if rows[0][2] == "says \"hi\"" {
        total = total + 8192
      }
    }
    case Err(_e) => {}
  }

  total
}
